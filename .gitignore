# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.eggs/
*.egg-info/
build/
dist/
# The shared BIG-IP report front-end is committed as a generated artifact: the
# Rust generator embeds shared/dist/*.js via include_str! at compile time, so it
# must exist in a fresh checkout without running Node (same precedent as the
# vendored wasm). Re-include it despite the blanket dist/ rule above.
!rust/bigip-report-gen/frontend/dist/
!rust/bigip-report-gen/frontend/dist/**

# Sphinx HTML output for the f5q Python API reference
# (built by ``make docs``; Read the Docs builds from source).
docs/sphinx/_build/
docs/sphinx/_autosummary/

.venv/
venv/
env/
pip-wheel-metadata/

# Node / TypeScript
node_modules/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Project tool outputs
editors/vscode/out/
editors/vscode/.vscode-test/
.vscode-test/
shared/_build_info.py
server/_version.py
tooling/explorer/static/build_info.json
uv.lock
editors/vscode/uv.lock
# Scratch fixtures the multi-root suite materialises at launch
# (src/test/runMultiFolderTest.ts) — every test rewrites their contents.
editors/vscode/testFixtureMultiFolder/proj-*/extra.tcl
editors/vscode/testFixtureMultiFolder/proj-*/race.tcl
.claude/settings.local.json
.claude/worktrees/
docs/screenshots/.shell-ready
docs/screenshots/.ai-done
docs/screenshots/.ai-started
docs/screenshots/.ai-success

# NB: editor/IDE/OS cruft (.idea/, .vscode/, *.swp, *~, .DS_Store,
# *.sublime-workspace, .codex, …) is intentionally NOT listed here — it
# belongs in a personal global gitignore (core.excludesfile), not the repo.

# JetBrains plugin build artifacts
editors/jetbrains/build/
editors/jetbrains/.gradle/
editors/jetbrains/server/
editors/jetbrains/src/main/resources/compilerExplorer.html
editors/jetbrains/src/main/resources/tcl-lsp-server.pyz


# KCS help database (generated by scripts/build/kcs_db.py)
core/help/kcs_help.db
shared/help/kcs_help.db

# Local build artefacts
tmp/
editors/jetbrains/.intellijPlatform/
perf_history.sqlite3

# Ephemeral debug/test output files
var*.txt
# ... but the committed variable-resolution conformance vectors are project
# source, not debug output.
!rust/tcl-syntax/tests/data/variable_resolution_vectors.txt
# Tcl encoding.test artefacts — encoding.test writes per-charset
# byte/output files into the cwd when sourced through the VM tcltest
# runner.  These are transient test fixtures, not project sources.
*.chars
*.tcltestout

# Rust workspace (editors/zed keeps its own local .gitignore for its target/)
/target/
rust/tcl-lsp-rust/.venv/
iso2022.txt

# Zig runtime build outputs / fetched deps — regenerable, never source.
.zig-cache/
zig-out/
/runtime/zig/vendor/

# Compiler-explorer screenshot debug snapshot — written by the webview
# when SCREENSHOT_OUTPUT_DIR is set, captures the live HTML for offline
# inspection.  Not a source artefact and historically tripped CodeQL
# js/xss on the helper functions it imports from explorer-core.js.
docs/screenshots/compiler-explorer-debug.html

# Auto-generated VSCode test-fixture workspace config — written by the
# extension's test runner each time tests execute; not a source artefact.
editors/vscode/testFixture/.vscode/

# tclsh reference disassembly captured by scripts/capture/bytecode.sh, consumed
# by the bytecode-compare skill. Regenerated on demand from a local tclsh; the
# exact bytes depend on the interpreter's patchlevel, so it is not checked in.
/tests/bytecode_reference/

# Typecheck environment built by `make typecheck-py`: installs f5report (which
# maturin-compiles the native `_engine`) plus pytest so ty and pyright can
# resolve every import for real, rather than suppressing them.
/.venv-typecheck/

# Zed dev-extension build outputs. `zed: install dev extension` compiles the
# extension in place, writing extension.wasm and the tree-sitter grammar into
# the source tree.
/editors/zed/extension.wasm
/editors/zed/grammars/
editors/vscode/testFixture/specPackTortureScratch/
editors/vscode/testFixture/packExtensionScratch/
