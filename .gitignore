# Override global gitignore rules that conflict with project structure
!/lsp/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.eggs/
*.egg-info/
build/
dist/
.venv/
venv/
env/
pip-wheel-metadata/

# Node / TypeScript
node_modules/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Project tool outputs
editors/vscode/out/
editors/vscode/.vscode-test/
.vscode-test/
lsp/_build_info.py
explorer/static/build_info.json
uv.lock
editors/vscode/uv.lock
editors/vscode/package-lock.json
.claude/settings.local.json
.claude/worktrees/
docs/screenshots/.shell-ready
docs/screenshots/.ai-done
docs/screenshots/.ai-started
docs/screenshots/.ai-success
.vscode/

# JetBrains plugin build artifacts
editors/jetbrains/build/
editors/jetbrains/.gradle/
editors/jetbrains/src/main/resources/tcl-lsp-server.pyz
editors/jetbrains/src/main/resources/compilerExplorer.html


# KCS help database (generated by scripts/build_kcs_db.py)
core/help/kcs_help.db

# Local build artefacts
tmp/
editors/jetbrains/.intellijPlatform/
perf_history.sqlite3

# Zig build cache (the built tcl_runtime.wasm is checked in)
runtime/zig/.zig-cache/
runtime/zig/zig-out/lib/
# Stray build artifacts in the zig root (should be in zig-out/bin/)
runtime/zig/tcl_runtime.wasm
# WASM explorer HTML (large debug artifact generated by zig build explore)
runtime/zig/zig-out/bin/*.html
# Ephemeral debug/test output files
var*.txt
runtime/zig/tcl_runtime.wasm.o

# Fetched Tcl regex sources — downloaded by scripts/fetch_tcl_regex.sh
# on demand (see runtime/zig/build.zig).  Not vendored in the repo.
runtime/zig/vendor/

# Rust workspace (editors/zed keeps its own local .gitignore for its target/)
/target/
rust/tcl-lsp-rust/.venv/
iso2022.txt
