+/// [`normal_transfer_invocation_with_metadata_context`] for semantic advice:
+/// a conditionally reached invocation is described by its closed selected
+/// target's ordinary transfer. Never a strict-lattice or rewrite input.
+pub(crate) fn advisory_normal_transfer_invocation_with_metadata_context(
+    registry: &CommandRegistry,
+    context: Option<InvocationMetadataContext<'_>>,
+    tokens: &CommandTokens,
+) -> Option<NormalTransferInvocation> {
+    if let Some(normal) = normal_transfer_invocation_with_metadata_context(registry, context, tokens)
+    {
+        return Some(normal);
+    }
+    let invocation =
+        super::advisory_tokens_invocation_with_metadata_context(registry, context, tokens)?;
+    Some(NormalTransferInvocation {
+        invocation,
+        compilation: normal_output_compilation(tokens),
+        alias_frame: normal_alias_frame(tokens),
+        captured_outputs: false,
+        original_operands: tokens
+            .source_binding
+            .as_ref()
+            .and_then(|binding| binding.original_variable_operands_for_tokens(tokens))
+            .cloned(),
+    })
+}
