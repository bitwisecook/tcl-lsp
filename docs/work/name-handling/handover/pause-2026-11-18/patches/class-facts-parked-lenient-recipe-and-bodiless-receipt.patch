From 9d3c1b6fe33b809332182cd4b5441bf55417447f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 18:48:41 +0000
Subject: [PATCH 1/2] class facts: a command substituted into a root head keeps
 its lenient navigation recipe

Under the lenient tcl environment only root commands recorded their
document navigation candidates, so the constructor in `[::C new] ping`
had none and a project class declared in another file could not type the
receiver. A whole command substitution in a root command's head runs
first in the same frame and command world, so it takes the same recipe.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017u5g3Kgho1C9zZ3yZYrK8P
---
 .../source_transition_advice/tape_preparation.rs         | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/rust/tcl-compiler/src/command_binding/source_transition_advice/tape_preparation.rs b/rust/tcl-compiler/src/command_binding/source_transition_advice/tape_preparation.rs
index e9cae9942f..163fc6bc56 100644
--- a/rust/tcl-compiler/src/command_binding/source_transition_advice/tape_preparation.rs
+++ b/rust/tcl-compiler/src/command_binding/source_transition_advice/tape_preparation.rs
@@ -496,6 +496,15 @@ impl OriginalSourceTransitionSeed {
                 // supplies this conditional Document recipe. Nested bodies keep
                 // their independent source scope, and no runtime frame follows.
                 tape.retain_logical_document_navigation(&graph, &invocation.words, origin);
+                // A command substituted whole into the head runs first, in the
+                // same frame and command world, so it takes the same recipe.
+                if let Some(child) = invocation
+                    .words
+                    .first()
+                    .and_then(super::super::original_single_command_substitution_words)
+                {
+                    tape.retain_logical_document_navigation(&graph, &child.command().words, origin);
+                }
             }
             advice_context.retain_original_invocation(
                 &mut graph,
