+#[test]
+fn probe_lower() {
+    let Ok(path) = std::env::var("TCL_PROBE_LOWER") else {
+        return;
+    };
+    let src = std::fs::read_to_string(path).unwrap();
+    use tcl_compiler::lowering::{Lowerer, lower_to_ir, lower_to_ir_with};
+    let kinds = |m: &tcl_compiler::Module| {
+        m.top_level
+            .statements
+            .iter()
+            .map(|s| {
+                format!("{s:?}")
+                    .split([' ', '('])
+                    .next()
+                    .unwrap()
+                    .to_owned()
+            })
+            .collect::<Vec<_>>()
+    };
+    for dialect in ["tcl8.6", "tcl9.0"] {
+        let registry = tcl_registry::model::ingress::static_context_for(dialect).commands();
+        let profile = registry.profile();
+        let config = tcl_lexer::LexerConfig::for_profile(profile);
+        let lowered = lower_to_ir(&src, registry);
+        println!("{dialect} lower_to_ir {:?}", kinds(&lowered));
+        for p in lowered.procedures.values() {
+            println!(
+                "{dialect} proc {} {:?}",
+                p.qualified_name,
+                p.body
+                    .statements
+                    .iter()
+                    .map(|s| format!("{s:?}")
+                        .split([' ', '('])
+                        .next()
+                        .unwrap()
+                        .to_owned())
+                    .collect::<Vec<_>>()
+            );
+        }
+        println!(
+            "{dialect} dialect-only {:?}",
+            kinds(&lower_to_ir_with(
+                Lowerer::with_config(registry, config).with_dialect(profile),
+                &src
+            ))
+        );
+        println!(
+            "{dialect} extensible-only {:?}",
+            kinds(&lower_to_ir_with(
+                Lowerer::with_config(registry, config).with_host_extensible_command_table(),
+                &src
+            ))
+        );
+        println!(
+            "{dialect} plain {:?}",
+            kinds(&lower_to_ir_with(
+                Lowerer::with_config(registry, config),
+                &src
+            ))
+        );
+    }
+}
