+#[test]
+fn probe_cards() {
+    if std::env::var("TCL_PROBE_CARDS").is_err() {
+        return;
+    }
+    let lib = "oo::class create ::C {method ping {} {}}; ::C create ::obj";
+    for caller in ["[::C new] ping", "::obj ping"] {
+        for dialect in ["tcl", "tcl8.6"] {
+            let l = Analyser::new().analyse(lib, dialect);
+            let cards = tcl_compiler::registry_invocation::source_structure::OriginalProjectClassCards::capture(&l);
+            let c = Analyser::new().analyse(caller, dialect);
+            let config = tcl_lexer::LexerConfig::default();
+            let segs =
+                tcl_compiler::segmenter::segment_commands_with_offset_and_config(caller, 0, config);
+            let found = cards.as_ref().and_then(|cards| {
+                tcl_compiler::registry_invocation::source_structure::original_project_receiver_class_with_sources(
+                    caller,
+                    &c,
+                    &segs[0],
+                    std::slice::from_ref(cards),
+                    None,
+                )
+            });
+            println!(
+                "{dialect} {caller}: cards={} found={}",
+                cards.is_some(),
+                found.is_some()
+            );
+        }
+    }
+}
