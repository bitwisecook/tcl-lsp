+    /// The clause walk of the admitted invocation's own words, as the release's
+    /// command it was admitted for reads them: the proof that the head is that
+    /// command is the admission, so no logical source input is needed.
+    #[must_use]
+    pub fn clause_walk(
+        &self,
+        registry: &CommandRegistry,
+    ) -> Option<
+        Result<
+            tcl_registry::clause_grammar::ClausePlan,
+            tcl_registry::clause_grammar::ClauseAbstention,
+        >,
+    > {
+        self.with_argument_words(|words| {
+            registry
+                .resolve_structured_invocation(words, None)
+                .resolved()?
+                .clause_walk()
+        })
+    }
