+#[test]
+fn zz_probe_source_flow() {
+    let (cu, context) = source_unit("when HTTP_REQUEST { catch { HTTP::respond 200 content ok }; HTTP::header insert X y }");
+    let registry = context.commands();
+    let module = &cu.ir_module;
+    eprintln!("P doc-match {}", module.source == tcl_lexer::SourceImage::document(&cu.source));
+    eprintln!("P standalone {} smi {}", module.source_entry.metadata_context.is_standalone(), module.source_metadata_input.is_some());
+    eprintln!("P meta {}", crate::registry_invocation::InvocationMetadataContext::for_module(registry, module).is_some());
+    if let Some(input) = module.source_metadata_input.as_ref() {
+        eprintln!("P lexer-eq {}", input.lexer_config() == module.lexer_config);
+    }
+    eprintln!("P realm {}", crate::realm::document_realm_bindings_for_module(module, registry).is_some());
+    let Some(source) = super::IrulesSourceQuery::capture(&cu, registry) else { eprintln!("P capture none"); return; };
+    for fu in cu.analysable_functions() {
+        eprintln!("P fn {:?} event {:?}", fu.name, source.event(fu).map(|e| matches!(e, super::OriginalEventPresence::Event(_))));
+    }
+    let state = super::collect_flow_state(&source);
+    eprintln!("P state {}", state.is_some());
+    if let Some((state, _)) = state {
+        eprintln!("P advice {}", source.conditional_pairing_advice(&state).is_some());
+    }
+}
