+// along with this program.  If not, see <https://www.gnu.org/licenses/>.
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! A private scratch directory for a unit test, deleted when it drops, on every path
+//! out of a test (a failed assertion included).
+
+use std::path::PathBuf;
+
+pub(crate) struct Scratch(PathBuf);
+
+impl Scratch {
+    /// Create `dir` empty and own it: it is removed again when this drops.
+    pub(crate) fn create(dir: PathBuf) -> Self {
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).expect("scratch dir");
+        Self(dir)
+    }
+}
+
+impl Scratch {
+    /// Own `dir` without creating it: the test makes it, this removes it.
+    pub(crate) fn guard(dir: PathBuf) -> Self {
+        Self(dir)
+    }
+}
+
+impl std::ops::Deref for Scratch {
+    type Target = PathBuf;
+
+    fn deref(&self) -> &PathBuf {
+        &self.0
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
