+//! A private scratch directory that is deleted when it drops, on every path
+//! out of a test (a failed assertion included).
+
+use std::path::PathBuf;
+
+pub struct Scratch(PathBuf);
+
+impl Scratch {
+    /// Create `dir` empty and own it: it is removed again when this drops.
+    pub fn create(dir: PathBuf) -> Self {
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).expect("scratch dir");
+        Self(dir)
+    }
+}
+
+impl std::ops::Deref for Scratch {
+    type Target = PathBuf;
+
+    fn deref(&self) -> &PathBuf {
+        &self.0
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
