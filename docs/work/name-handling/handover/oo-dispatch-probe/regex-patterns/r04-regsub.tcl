# regsub substitution specs, -all, count variable and return value forms
puts [regsub {(b)} "abc" {[\1]} ]
puts [regsub -all {a} "banana" {<&>}]
puts [regsub -all {a} "banana" {\&}]
puts [regsub -all {a} "banana" {\\&}]
puts [regsub {(a)(n)} "banana" {\2\1\0}]
puts [regsub -all {x*} "abc" {-}]
set n [regsub -all {a} "banana" o out]
puts [list $n $out]
puts [regsub -nocase -all {A} "aAa" z]
puts [regsub -start 3 -all {a} "banana" X]
puts [regsub -all {(\w+)@(\w+)} "a@b c@d" {\2 at \1}]
puts [regsub {\d} "a1" {\9}]
puts [regsub -all -line {^} "a\nb" >]
puts [regsub -all {} "abc" -]
