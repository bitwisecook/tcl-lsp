# Formatter, minifier (default and compact tiers), folding ranges: server target/release/tcl-lsp-server (2026-11-22).
# behaviour = the formatted / minified source run under tclsh9.0 compared with the original's output.
c01-hash-mid-command.tcl	folding=[]	format=edited	minify_refusals=[]	minified='puts [catch {eval {set x 1 # not a comment}} r]:$r;set y 2;puts y=$y'
c02-semicolon-hash-forms.tcl	folding=[]	format=edited	minify_refusals=[]	minified='set a 1;set b 2;set c 3;puts "$a $b $c"'
c03-switch-body-comment-odd.tcl	folding=[[2, 7, 'region']]	format=edited	minify_refusals=[]	minified='proc f {v} {switch $v {\n        # a comment\n        a {return A}\n        default {return D}\n    }};puts [catch {f a} r]:'
c04-switch-body-comment-even.tcl	folding=[[2, 7, 'region'], [3, 6, 'region']]	format=edited	minify_refusals=[]	minified='proc f {v} {switch -- $v {\n        # puts\n        a {return A}\n        default {return D}\n    }};puts [f a]:[f b];puts ['
c05-unbalanced-brace-in-comment.tcl	folding=[]	format=no edits	minify_refusals=['incomplete-original-syntax']	minified='# A brace in a comment still counts when the enclosing braces are matched\nputs [catch {eval {proc p {} {\n    # unbalance'
c06-balanced-braces-in-comment.tcl	folding=[[1, 3, 'region']]	format=edited	minify_refusals=[]	minified='proc p {} {return ok};puts [p]'
c07-comment-backslash-continuation.tcl	folding=[]	format=no edits	minify_refusals=[]	minified='puts start;puts shown'
c08-continuation-in-braces.tcl	folding=[]	format=no edits	minify_refusals=[]	minified='set a {x\\\n      y};puts [string length $a]:$a;set b {x\\\\\ny};puts [string length $b]'
c09-continuation-in-quotes.tcl	folding=[]	format=edited	minify_refusals=[]	minified='set a "x\\\n      y";puts [string length $a]:$a'
c10-continuation-bare.tcl	folding=[]	format=edited	minify_refusals=[]	minified='puts [catch {eval {set b x y}} r]:$r;puts [list a b]'
c11-semicolon-in-quotes-braces.tcl	folding=[]	format=edited	minify_refusals=[]	minified='puts "a;b";puts {c;d};set l [list x;y];puts $l'
c12-if-implicit-else-comment.tcl	folding=[]	format=no edits	minify_refusals=['source-correspondence-changed']	minified="# '#' after an if body is the implicit else body, not a comment\nputs [catch {eval {if 0 {puts then} # comment}} r]:$r\npu"
c13-comment-in-if-proc-bodies.tcl	folding=[[1, 9, 'region'], [3, 5, 'region'], [6, 8, 'region']]	format=edited	minify_refusals=[]	minified='proc p {x} {if {$x} {return yes} else {return no}};puts [p 1][p 0]'
c14-expand-with-comment.tcl	folding=[]	format=edited	minify_refusals=[]	minified='set l [list {*}{a # b\n  c}];puts [llength $l]:$l;{*}{puts expanded}'
c15-hash-in-data-lists.tcl	folding=[]	format=no edits	minify_refusals=[]	minified='array set a {\n    # not-a-comment\n    k 1\n};puts [lsort [array names a]];set d [dict create {*}{\n    # x\n    k v\n}];puts'
c16-quote-brace-in-body.tcl	folding=[]	format=no edits	minify_refusals=['incomplete-original-syntax']	minified='# A brace inside quotes inside a braced body is still counted\nputs [catch {eval {proc q {} { puts "{" }}} r]:$r\nproc q2 '
c17-hash-in-quoted-string.tcl	folding=[]	format=edited	minify_refusals=[]	minified='proc q {} {puts "# not a comment";puts {# nor this}};q'
c18-expr-continuation-and-comment.tcl	folding=[]	format=no edits	minify_refusals=[]	minified='puts [expr {1 +\\\n  2}];puts [catch {expr {1 + 2 # trailing\n}} r]:$r'
c19-comment-body-continuation.tcl	folding=[[1, 5, 'region']]	format=edited	minify_refusals=[]	minified='proc p {} {set r 1;return $r};puts [p]'
c20-backslash-space-vs-newline.tcl	folding=[]	format=no edits	minify_refusals=[]	minified='puts [list a\\ ;b];puts [list c\\\\;d]'
c21-crlf-continuation.tcl	folding=[[1, 2, 'region']]	format=edited	minify_refusals=[]	minified='set a 1 puts [catch {eval {set b x\\\r\n}} r]:[string length $r];puts [string length "p\\\r\nq"]'
c22-trailing-hash-in-namespace-eval.tcl	folding=[[1, 4, 'region']]	format=edited	minify_refusals=[]	minified='namespace eval ns {variable v 1;proc shown {} {return shown}};puts [info commands ::ns::*]'
c23-hash-word-in-list.tcl	folding=[]	format=edited	minify_refusals=[]	minified='proc h {#} {return [set #]};puts [h x];puts [lindex {# a} 0]'
c24-comment-in-dict-for-and-foreach.tcl	folding=[]	format=edited	minify_refusals=[]	minified='foreach {k v} {\n    a 1\n    # 2\n} {puts "$k=$v"}'
c25-docstring-continuation.tcl	folding=[[3, 4, 'region']]	format=edited	minify_refusals=[]	minified='proc add1 {x} {return [expr {$x+1}]};proc dbl {x} {expr {$x*2}};puts [add1 1]:[dbl 2]:[info commands hidden]'
c26-switch-body-comment-words.tcl	folding=[[2, 7, 'region'], [3, 6, 'region']]	format=edited	minify_refusals=[]	minified='proc f {v} {switch $v {\n        # this is not a comment\n        a {return A}\n        default {return D}\n    }};puts [cat'
c27-comment-even-backslashes.tcl	folding=[]	format=no edits	minify_refusals=[]	minified='puts shown'
# Every formatted and minified output printed the same as the original under tclsh9.0 (bcheck: SAME-OUTPUT for all 27).
