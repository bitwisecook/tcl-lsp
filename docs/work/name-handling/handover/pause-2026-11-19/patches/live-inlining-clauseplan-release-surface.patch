 rust/tcl-compiler/src/registry_invocation.rs  |  2 +
 .../registry_invocation/native_compilation.rs | 22 +++++----
 3 files changed, 61 insertions(+), 10 deletions(-)

diff --git a/rust/tcl-compiler/src/lowering/tests/structured_hooks.rs b/rust/tcl-compiler/src/lowering/tests/structured_hooks.rs
index 8f25df0cd772536ab421d3cbf8713123da505e3f..5627eb7fc4ec52de5689f46fc9a9862eef9fba60 100644
--- a/rust/tcl-compiler/src/lowering/tests/structured_hooks.rs
+++ b/rust/tcl-compiler/src/lowering/tests/structured_hooks.rs
@@ -526,3 +526,50 @@ fn registry_dispatch_foreach_line_wrong_arity_falls_through_to_default() {
         other => panic!("expected Call via lower_default, got {other:?}"),
     }
 }
+
+/// The body a pack's reference body lowers to under a caller's live entry of
+/// `release`: what [`crate::command_binding::StructuredControlReading::ReferenceBody`]
+/// reads as structured control there.
+fn reference_body_under_live_entry(release: &str, body: &str) -> Vec<Statement> {
+    let profile = tcl_dialect::DialectProfile::find(release).unwrap();
+    let registry = tcl_registry::model::ingress::static_context_for_profile(profile).commands();
+    let captured = crate::environment_ingress::captured_native_entry(profile);
+    let mut options = crate::command_binding::native_entry_options(captured.as_entry());
+    options.structured_control = crate::command_binding::StructuredControlReading::ReferenceBody;
+    crate::lowering::lower_procedure_target_module_for_bytecode_with_options(
+        tcl_runtime_api::ProcedureCompileTarget {
+            source: body,
+            parameters: &["x".to_owned()],
+            namespace: "",
+        },
+        registry,
+        tcl_lexer::LexerConfig::for_file_grammar(profile.grammar),
+        Some(profile),
+        false,
+        Some(options),
+    )
+    .top_level
+    .statements
+}
+
+/// A reference body under a live entry reads a structured-control command
+/// with the grammar of the release the entry admitted it for: `if` is
+/// structured control under 9.0, and `try`, which 8.5 does not have (tclsh
+/// 8.5.19: `invalid command name "try"`), stays a call under 8.5 rather than
+/// borrowing another release's clause grammar.
+#[test]
+fn a_reference_body_reads_structured_control_with_its_release_grammar() {
+    let statements =
+        reference_body_under_live_entry("tcl9.0", "if {$x < 0} {set r neg} else {set r pos}");
+    assert!(
+        matches!(statements.as_slice(), [Statement::If { .. }]),
+        "{statements:?}"
+    );
+    let statements = reference_body_under_live_entry("tcl8.5", "try {set r $x} on error {} {}");
+    assert!(
+        !statements
+            .iter()
+            .any(|statement| matches!(statement, Statement::Try { .. })),
+        "{statements:?}"
+    );
+}
