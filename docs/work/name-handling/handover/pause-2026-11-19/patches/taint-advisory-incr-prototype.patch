+#[test]
+fn hosted_increment_advice_does_not_rewrite_the_rule_procedure() {
+    let source =
+        "proc p {} {set n 1; incr n; incr n 2; log local0. $n}\nwhen HTTP_REQUEST {call p}\n";
+    let (rewritten, applied) = optimise(source, "f5-irules");
+    assert_eq!(rewritten, source, "applied {applied:?}");
+    assert!(applied.is_empty());
+}
