+/// Conditional selected source target under the same retained metadata as
+/// an executed call. Only the rule-procedure diagnostic projection consumes it.
+pub(crate) fn advisory_tokens_invocation_with_metadata_context(
+    registry: &CommandRegistry,
+    context: Option<InvocationMetadataContext<'_>>,
+    tokens: &CommandTokens,
+) -> Option<ResolvedStatementInvocation> {
+    if tokens.synthetic.is_some() {
+        return None;
+    }
+    let binding = tokens.source_binding.as_ref()?;
+    let effective = effective_words_for_target(tokens, binding.advisory_execution_target()?)?;
+    let dialect = selected_dialect(registry, context, tokens);
+    let selected = word_resolution::resolve_effective_tokens_with_metadata_context_and_case(
+        registry, context, tokens, &effective, dialect,
+    )
+    .ok()?;
+    selected_statement_invocation(tokens, effective, dialect, selected)
