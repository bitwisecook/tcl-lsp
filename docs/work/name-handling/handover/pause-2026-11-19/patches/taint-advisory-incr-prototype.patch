+    /// The closed selected target of an invocation that is reached only
+    /// conditionally (a declaration preview: a rule procedure or handler body
+    /// whose entry is advice). For advice only: a caller must not let it
+    /// prove execution, feed the strict lattice or license a rewrite.
+    pub(crate) fn advisory_execution_target(&self) -> Option<&SourceCommandTarget> {
+        if self.runtime_reachability != super::super::SourceRuntimeReachability::Conditional {
+            return None;
+        }
+        self.closed_selected_execution_target()
+            .filter(|target| target.registry_backed)
+    }
