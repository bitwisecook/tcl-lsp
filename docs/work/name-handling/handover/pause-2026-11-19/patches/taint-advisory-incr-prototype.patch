+
+struct Erasure;
+struct Diagnostic;
+struct RuleAdvice;
+
+impl Resolution for Erasure {
+    type Output = SccpResult;
+    const PURPOSE: SolverPurpose = SolverPurpose::ExecutionErasure;
+
+    fn project(solved: SolvedValueFacts) -> Self::Output {
+        solved.result
+    }
+}
+
+impl Resolution for Diagnostic {
+    type Output = SemanticValueFacts;
+    const PURPOSE: SolverPurpose = SolverPurpose::SemanticAnalysis;
+
+    fn project(solved: SolvedValueFacts) -> Self::Output {
+        SemanticValueFacts {
+            result: solved.result,
+            expressions: solved.expressions,
+            loops: solved.loops,
+        }
+    }
+}
+
+impl Resolution for RuleAdvice {
+    type Output = SemanticValueFacts;
+    const PURPOSE: SolverPurpose = SolverPurpose::SemanticAnalysis;
+
+    fn project(solved: SolvedValueFacts) -> Self::Output {
+        Diagnostic::project(solved)
+    }
+
+    fn conditional_store(
+        driver: &crate::value_transfer::LatticeDriver<'_>,
+        statement: &crate::ssa::SsaStatement,
+        ssa: &SsaFunction,
+        values: &HashMap<ValueKey, LatticeValue>,
+    ) -> Option<super::DefValues> {
+        driver.rule_increment_advice(statement, ssa, values)
     }
 }
 
