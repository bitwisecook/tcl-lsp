+    /// The selected conditional iRule call delegates to the same registry store
+    /// evaluator as a typed increment. Its caller exposes only semantic advice.
+    pub(crate) fn rule_increment_advice(
+        &self,
+        statement: &SsaStatement,
+        ssa: &SsaFunction,
+        values: &HashMap<ValueKey, LatticeValue>,
+    ) -> Option<DefValues> {
+        let tokens = statement.statement.tokens()?;
+        let context = self.metadata_context?.context()?;
+        let invocation =
+            crate::registry_invocation::advisory_tokens_invocation_with_metadata_context(
+                self.registry,
+                Some(context),
+                tokens,
+            )?;
+        if invocation.facts.operation
+            != tcl_registry::SemanticOperationId::StructuredLowering(LoweringHookId::Incr)
+            || !invocation.facts.arg_roles_complete
+        {
+            return None;
+        }
+        let defs = named_defs(statement, ssa);
+        let [(name, _)] = defs.as_slice() else {
+            return None;
+        };
+        if invocation.argument_literal(0).as_deref() != Some(name.as_str()) {
+            return None;
+        }
+        // Only the literal amount (or its documented default) is in the prototype.
+        match invocation.arguments.len() {
+            1 => {}
+            2 => {
+                invocation.argument_literal(1)?;
+            }
+            _ => return None,
+        }
+        let realm = tokens.source_binding.as_ref()?.invocation_realm()?;
+        let cooked = self.operation_arguments(&invocation)?;
+        let written = (0..cooked.len())
+            .map(|index| invocation.effective.written_argument(index))
+            .collect();
+        invocation.with_metadata_schema(self.registry, context, realm, |schema| {
+            Some(self.evaluate_resolved_source_call(
+                &invocation.facts.canonical_command,
+                schema,
+                (&cooked, written, Some(tokens)),
+                &defs,
+                (&statement.uses, values, ssa),
+                false,
+            ))
+        })
+    }
+
