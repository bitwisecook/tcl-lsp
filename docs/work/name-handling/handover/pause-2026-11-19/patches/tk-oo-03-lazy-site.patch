From 56504b14cdbe9095cec8862ab19a2ae7563ec87a Mon Sep 17 00:00:00 2001
From: None None <openai@bragi0.com>
Date: Thu, 19 Nov 2026 13:42:55 +0000
Subject: [PATCH] Acquire reached source locations only for package-owned
 instance factories

---
 .../registry_invocation/source_publication.rs | 21 ++++++++++++++++---
 .../source_structure/advice_queries.rs        | 14 +++++++------
 2 files changed, 26 insertions(+), 9 deletions(-)

diff --git a/rust/tcl-compiler/src/registry_invocation/source_publication.rs b/rust/tcl-compiler/src/registry_invocation/source_publication.rs
index deae30dd1b..372c9392ec 100644
--- a/rust/tcl-compiler/src/registry_invocation/source_publication.rs
+++ b/rust/tcl-compiler/src/registry_invocation/source_publication.rs
@@ -38,17 +38,32 @@ impl OriginalSourceCommandPublication {
     pub(super) fn capture(
         words: OriginalRegistryWords,
         context: &ContextRegistry,
-        site: Option<crate::command_binding::CommandAllocationSite>,
+        invocation_site: impl FnOnce() -> Option<crate::command_binding::CommandAllocationSite>,
     ) -> Option<Self> {
         // naming.source.original-command-name-publications
         // docs/design/analysis/name-resolution-proofs/original-command-name-publications.md
-        let naming = words.with_source_schema(context, |schema| {
-            schema.authored_source_command_publication()
+        let (naming, package) = words.with_source_schema(context, |schema| {
+            Some((
+                schema.authored_source_command_publication()?,
+                schema
+                    .authored_source_descriptors()
+                    .command
+                    .owning_package(),
+            ))
         })??;
         let operand = words.operands().get(naming.argument)?.as_ref()?;
         let original = operand.word()?.clone();
         let bytes = Arc::from(words.arguments().get(naming.argument)?.literal_bytes()?);
         let input = operand.input().cloned();
+        let site = if package.is_some()
+            && matches!(
+                naming.kind,
+                tcl_registry::AuthoredSourceCommandPublicationKind::Instance { .. }
+            ) {
+            invocation_site()
+        } else {
+            None
+        };
         Some(Self {
             words,
             site,
diff --git a/rust/tcl-compiler/src/registry_invocation/source_structure/advice_queries.rs b/rust/tcl-compiler/src/registry_invocation/source_structure/advice_queries.rs
index 1d59f597a9..378c58a48c 100644
--- a/rust/tcl-compiler/src/registry_invocation/source_structure/advice_queries.rs
+++ b/rust/tcl-compiler/src/registry_invocation/source_structure/advice_queries.rs
@@ -98,12 +98,14 @@ pub fn source_command_publication_at(
 ) -> Option<super::super::OriginalSourceCommandPublication> {
     let words = source_registry_words_at(source, analysis, offset)?;
     let context = analysis.resolved_input.as_ref()?.context_registry();
-    let site = analysis.retained_command_realm().and_then(|realm| {
-        realm
-            .invocation_at_source("", offset)
-            .invocation_site()
-            .cloned()
-    });
+    let site = || {
+        analysis.retained_command_realm().and_then(|realm| {
+            realm
+                .invocation_at_source("", offset)
+                .invocation_site()
+                .cloned()
+        })
+    };
     super::super::source_publication::OriginalSourceCommandPublication::capture(
         words, &context, site,
     )
-- 
