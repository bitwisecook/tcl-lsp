-            if command.is_empty() || command.contains(['$', '[']) {
+            // A synthetic empty command carries no original callee.
+            if command.is_empty() {
                 continue;
             }
             let marked_unseen = block.statements[index + 1..]
@@ -307,7 +393,20 @@ pub fn collect_executable_opaque_callee_name_args(
             if resolvable(stmt) && !marked_unseen {
