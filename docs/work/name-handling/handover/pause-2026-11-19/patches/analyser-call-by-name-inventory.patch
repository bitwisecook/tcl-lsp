             }
-            out.extend(args.iter().filter(|a| is_literal_var_name(a)).cloned());
+            if let Some(tokens) = stmt.tokens() {
+                let config = cfg.metadata_context.source_analysis_input().map_or_else(
+                    || tcl_lexer::LexerConfig::for_profile(None),
+                    crate::analyser::ResolvedAnalysisInput::lexer_config,
+                );
+                out.extend(
+                    literal_word_values(tokens, tokens.native_lexer_config(config))
