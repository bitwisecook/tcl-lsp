From: None None <openai@bragi0.com>
Date: Thu, 19 Nov 2026 13:22:14 +0000
Subject: [PATCH] Match factory evidence to its original invocation and
 installed package provider

---
 .../src/analyser/commands/instance_classes.rs | 17 +++++++-------
 .../src/analyser/commands/tests.rs            | 23 +++++++++++++++++++
 .../src/command_binding/site_queries.rs       | 18 ++++-----------
 .../source_transition_advice/class_advice.rs  | 10 ++------
 .../registry_invocation/source_publication.rs | 12 +++++++++-
 .../source_structure/advice_queries.rs        | 10 +++++++-
 6 files changed, 59 insertions(+), 31 deletions(-)

diff --git a/rust/tcl-compiler/src/analyser/commands/instance_classes.rs b/rust/tcl-compiler/src/analyser/commands/instance_classes.rs
index 43589781ab..00082bd2e3 100644
--- a/rust/tcl-compiler/src/analyser/commands/instance_classes.rs
+++ b/rust/tcl-compiler/src/analyser/commands/instance_classes.rs
@@ -144,7 +144,7 @@ impl Analyser {
             let Instance { class_name } = publication.kind() else {
                 return None;
             };
-            Self::factory_package_proved(&self.result, publication.original_invocation())?;
+            Self::factory_package_proved(&self.result, &publication)?;
             let name = std::str::from_utf8(publication.name_bytes()).ok()?;
             Some((name.to_owned(), class_name.to_owned()))
         });
@@ -161,7 +161,7 @@ impl Analyser {
             let Instance { class_name } = binding.factory().kind() else {
                 return None;
             };
-            Self::factory_package_proved(&self.result, binding.factory().original_invocation())?;
+            Self::factory_package_proved(&self.result, binding.factory())?;
             Some((
                 std::str::from_utf8(binding.variable_bytes())
                     .ok()?
@@ -179,20 +179,21 @@ impl Analyser {
     /// A factory whose owning package is not proved present names no instance.
     fn factory_package_proved(
         analysis: &super::super::types::AnalysisResult,
-        factory: &crate::registry_invocation::source_structure::OriginalRegistryWords,
+        factory: &crate::registry_invocation::OriginalSourceCommandPublication,
     ) -> Option<()> {
         let context = analysis
             .resolved_input
             .as_ref()?
             .borrowed_context_registry();
-        let head = factory.head_source()?.word()?;
-        let descriptor = factory.with_source_schema(context, |schema| {
-            schema.authored_source_descriptors().command
-        })?;
+        let descriptor = factory
+            .original_invocation()
+            .with_source_schema(context, |schema| {
+                schema.authored_source_descriptors().command
+            })?;
         analysis
             .retained_command_realm()?
             .source_bindings_ref()
-            .package_factory_is_proved_at(head, descriptor, context)
+            .package_factory_is_proved_at(factory.invocation_site(), descriptor)
             .then_some(())
     }
 
diff --git a/rust/tcl-compiler/src/analyser/commands/tests.rs b/rust/tcl-compiler/src/analyser/commands/tests.rs
index 81be07c166..a0889f917c 100644
--- a/rust/tcl-compiler/src/analyser/commands/tests.rs
+++ b/rust/tcl-compiler/src/analyser/commands/tests.rs
@@ -440,8 +440,10 @@ fn a_widget_constructor_publishes_where_tk_is_present() {
 fn a_widget_constructor_in_a_sourced_document_uses_its_actual_entry() {
     use crate::registry_invocation::source_structure::original_project_source_load_at;
     let child = "ttk::treeview .t";
+    let mut previous_site = None;
     for (prefix, expected) in [
         ("package require Tk", true),
+        ("set before 1; package require Tk", true),
         ("package provide Tk 8.6; package require Tk", false),
         (
             "package require Tk; rename ttk::treeview {}; proc ttk::treeview args {}",
@@ -462,6 +464,27 @@ fn a_widget_constructor_in_a_sourced_document_uses_its_actual_entry() {
             expected,
             "{prefix}"
         );
+        if expected {
+            let context = child
+                .resolved_input
+                .as_ref()
+                .unwrap()
+                .borrowed_context_registry();
+            let descriptor = context
+                .context()
+                .resolve_spec(context.commands(), "ttk::treeview")
+                .unwrap();
+            let realm = child.retained_command_realm().unwrap();
+            let binding = realm.invocation_at_source("", 0);
+            let site = binding.invocation_site().expect("reached child factory");
+            let bindings = realm.source_bindings_ref();
+            assert!(bindings.package_factory_is_proved_at(Some(site), descriptor));
+            if let Some(other) = &previous_site {
+                assert_ne!(site, other);
+                assert!(!bindings.package_factory_is_proved_at(Some(other), descriptor));
+            }
+            previous_site = Some(site.clone());
+        }
     }
 }
 
diff --git a/rust/tcl-compiler/src/command_binding/site_queries.rs b/rust/tcl-compiler/src/command_binding/site_queries.rs
index 735f1cedbc..7b83c3d5a8 100644
--- a/rust/tcl-compiler/src/command_binding/site_queries.rs
+++ b/rust/tcl-compiler/src/command_binding/site_queries.rs
@@ -338,21 +338,19 @@ impl SourceCommandBindings {
     /// dispatch carries that provider. A provided version alone is insufficient.
     pub(crate) fn package_factory_is_proved_at(
         &self,
-        head: &tcl_lexer::NativeWord,
+        site: Option<&super::CommandAllocationSite>,
         descriptor: &tcl_registry::CommandSpec,
-        context: &tcl_registry::model::ContextRegistry,
     ) -> bool {
         let Some(package) = descriptor.owning_package() else {
             return true;
         };
-        let Some(origin) = self.source_origin() else {
+        let Some(site) = site else {
             return false;
         };
-        if head.image() != origin.source_image() {
+        let binding = self.invocation_at_source("", site.offset);
+        if binding.invocation_site() != Some(site) {
             return false;
         }
-        let offset = head.span().start();
-        let binding = self.invocation_at_source("", offset);
         if binding
             .proved_execution_target()
             .and_then(super::SourceCommandTarget::registry_identity)
@@ -363,16 +361,10 @@ impl SourceCommandBindings {
             return false;
         }
         let slot = tcl_registry::rooted_command_descriptor_label(descriptor.name);
-        let mut points = self.dispatch_points_at(offset).peekable();
+        let mut points = self.dispatch_points_at(site.offset).peekable();
         points.peek().is_some()
             && points.all(|point| {
                 let state = &point.state;
-                if context.context().ambient_package(package)
-                    && state.baseline.native_entry.is_some()
-                    && !state.has_opaque_domain()
-                {
-                    return true;
-                }
                 if state.has_opaque_domain() {
                     return false;
                 }
diff --git a/rust/tcl-compiler/src/realm/source_transition_advice/class_advice.rs b/rust/tcl-compiler/src/realm/source_transition_advice/class_advice.rs
index 90dcedd18b..c808603601 100644
--- a/rust/tcl-compiler/src/realm/source_transition_advice/class_advice.rs
+++ b/rust/tcl-compiler/src/realm/source_transition_advice/class_advice.rs
@@ -30,14 +30,8 @@ impl super::super::CommandBindingRealm {
         let Some(spec) = instance.descriptor(context) else {
             return false;
         };
-        instance
-            .factory()
-            .original_words()
-            .first()
-            .is_some_and(|head| {
-                self.bindings
-                    .package_factory_is_proved_at(head, spec, context)
-            })
+        self.bindings
+            .package_factory_is_proved_at(Some(instance.factory().site()), spec)
     }
 
     /// Conditional instance method source syntax, with its own actual factory.
