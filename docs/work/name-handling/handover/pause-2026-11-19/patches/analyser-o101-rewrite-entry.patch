diff --git a/rust/tcl-compiler/src/existence_query.rs b/rust/tcl-compiler/src/existence_query.rs
index d2fb0f21f0..a98a8f2d94 100644
--- a/rust/tcl-compiler/src/existence_query.rs
+++ b/rust/tcl-compiler/src/existence_query.rs
@@ -45,6 +45,44 @@ pub(crate) struct ExistenceQuery {
     pub(crate) kind: ExistenceKind,
 }
 
+impl ExistenceQuery {
+    /// Answer only from the selected invocation's physical variable context.
+    pub(crate) fn value_in(
+        &self,
+        context: &crate::var_resolve::ResolveContext,
+        params: &[String],
+        registry: &tcl_registry::CommandRegistry,
+    ) -> Option<bool> {
+        let place = crate::var_resolve::resolve_literal_place(&self.var, context, false, registry);
+        let exists = match context.contents_presence(&place) {
+            crate::var_resolve::ContentsPresence::Undefined => false,
+            crate::var_resolve::ContentsPresence::Defined => match self.kind {
+                crate::existence_query::ExistenceKind::AnyVariable => true,
+                crate::existence_query::ExistenceKind::Array => {
+                    // Literal scalar contents and untouched own formal cells
+                    // prove scalar storage. Other defined cells may be arrays.
+                    let formal = params.contains(&self.var)
+                        && context.contents_origin(&place)
+                            == crate::var_resolve::ContentsOrigin::Incoming
+                        && place.cell.as_ref().is_some_and(|cell| {
+                            matches!(
+                                &cell.owner, crate::place::CellOwner::Activation(owner)
+                                    if context.activation.as_ref() == Some(owner)
+                            )
+                        });
+                    if !formal && context.literal_contents_at(&place, registry).is_none() {
+                        return None;
+                    }
+                    false
+                }
+            },
+            crate::var_resolve::ContentsPresence::Unknown
+            | crate::var_resolve::ContentsPresence::DefinedOrUndefined => return None,
+        };
+        Some(exists ^ self.negated)
+    }
+}
