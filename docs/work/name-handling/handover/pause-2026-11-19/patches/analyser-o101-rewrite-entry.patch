+/// A fact about an invoked activation is sufficient for that run's successors.
+/// An edit to a declared procedure is valid for its other activations as well.
+fn declared_existence_matches(
+    ctx: &PassContext<'_>,
+    fu: &FunctionUnit,
+    block: crate::cfg::BlockId,
+    condition: &ExprNode,
+    base: Option<u32>,
+    condition_span: tcl_lexer::Span,
+    expected: bool,
+) -> bool {
+    let (Some(module), Some(registry), Some(id)) = (ctx.ir_module, ctx.registry, fu.body_id) else {
+        return true;
+    };
+    let Some(procedure) = module.procedures.get(&id) else {
+        return true;
+    };
+    let parent = fu
+        .ssa
+        .point_contexts
+        .as_ref()
+        .and_then(|points| points.source_tokens_at(block, usize::MAX));
+    let reading = crate::existence_query::QueryReading::for_cfg(
+        &fu.cfg,
+        registry,
+        fu.source_config,
+        parent,
+        base,
+    );
+    let Some(reached) = reading.in_expr(condition) else {
+        return true;
+    };
+    let in_declared_frame = || {
+        let input = module.source_metadata_input.as_ref()?;
+        let frame = crate::command_binding::SourceOriginalVariableFrame::from_authored_procedure(
+            procedure, input,
+        )?;
+        let host = crate::math_function_binding::ExpressionMathBindings::for_module_statement(
+            module,
+            condition_span,
+        )?;
+        let (tokens, base) = host.original_expression_host()?;
+        if &tokens.source_binding.as_ref()?.variable_frame != frame.frame() {
+            return None;
+        }
+        let metadata = crate::registry_invocation::InvocationMetadataContext::for_analysis_input(
+            registry, input,
+        )?;
+        let (query, context) = crate::existence_query::in_expr_at_with_metadata_context(
+            condition,
+            base,
+            tokens,
+            registry,
+            fu.source_config,
+            Some(metadata),
+        )?;
+        (query == reached).then_some(())?;
+        query.value_in(&context, &procedure.params, registry)
+    };
+    in_declared_frame() == Some(expected)
+}
