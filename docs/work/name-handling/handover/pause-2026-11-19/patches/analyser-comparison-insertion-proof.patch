+/// The literal and computed words that a comparison rewrite proposes to insert.
+#[derive(Debug, Clone, Copy)]
+pub enum ComparisonRewriteCommand<'a> {
+    /// Rooted switch with an explicit option terminator and one literal case table.
+    ExactSwitch { table: &'a str },
+    /// Rooted dictionary lookup after the caller proves its key domain.
+    DictionaryGet { dictionary: &'a str },
+    /// Rooted dictionary lookup with an explicit literal fallback.
+    DictionaryGetWithDefault {
+        dictionary: &'a str,
+        fallback: &'a str,
+    },
+    /// Return the single computed value.
+    ReturnValue,
+    /// Store the computed value under the supplied literal variable name.
+    SetValue { name: &'a str },
+}
+
+/// The authored rooted head at the original reached site. The caller separately
+/// proves word evaluation, variable cells, branch results and insertion position.
+#[derive(Debug, Clone)]
+pub struct OriginalComparisonRewriteCommand {
+    source_word: String,
+}
+impl OriginalComparisonRewriteCommand {
+    #[must_use]
+    pub fn source_word(&self) -> &str {
+        &self.source_word
+    }
+}
+
+impl SourceInvocationBinding {
+    /// Select the proposed exact argv against the original point's present,
+    /// unobserved implementation and the selected grammar and realm.
+    #[must_use]
+    pub fn original_comparison_rewrite_command(
+        &self,
+        tokens: &crate::ir::CommandTokens,
+        registry: &CommandRegistry,
+        proposed: ComparisonRewriteCommand<'_>,
+    ) -> Option<OriginalComparisonRewriteCommand> {
+        if tokens.source_binding.as_ref() != Some(self)
+            || self.runtime_reachability() != super::SourceRuntimeReachability::Reached
+            || self.entered_execution_observer.observed()
+        {
+            return None;
+        }
+        let config = self.original_lexer_config_for_tokens(tokens)?;
+        self.lookup_state.as_ref()?.comparison_rewrite_at(
+            self.invocation_site()?,
+            &self.lookup_namespace_key,
+            config,
+            registry,
+            proposed,
+        )
+    }
+}
+
+impl SourceLookupSnapshot {
+    fn comparison_rewrite_at(
+        &self,
+        site: &CommandAllocationSite,
+        namespace: &SourceNamespaceKey,
+        config: LexerConfig,
+        registry: &CommandRegistry,
+        proposed: ComparisonRewriteCommand<'_>,
+    ) -> Option<OriginalComparisonRewriteCommand> {
+        use ComparisonRewriteCommand::{
+            DictionaryGet, DictionaryGetWithDefault, ExactSwitch, ReturnValue, SetValue,
+        };
+        use InvocationWord::{Dynamic, Literal};
+        use tcl_registry::{hooks::LoweringHookId, native_dictionary::NativeDictionaryCommand};
+        let (dialect, policy) = self.insertion_policy(site, namespace, config, registry)?;
+        let state = &self.state;
+        let (head, arguments) = match proposed {
+            ExactSwitch { table } => (
+                "::switch",
+                vec![Literal("-exact"), Literal("--"), Dynamic, Literal(table)],
+            ),
+            DictionaryGet { dictionary } => {
+                ("::dict", vec![Literal("get"), Literal(dictionary), Dynamic])
+            }
+            DictionaryGetWithDefault {
+                dictionary,
+                fallback,
+            } => (
+                "::dict",
+                vec![
+                    Literal("getwithdefault"),
+                    Literal(dictionary),
+                    Dynamic,
+                    Literal(fallback),
+                ],
+            ),
+            ReturnValue => ("::return", vec![Dynamic]),
+            SetValue { name } => ("::set", vec![Literal(name), Dynamic]),
+        };
+        let context = state
+            .baseline
+            .metadata_context
+            .metadata_context(registry)?
+            .context()?;
+        let resolution =
+            tcl_registry::model::assembly::resolve_structured_invocation_in_resolved_context(
+                registry,
+                Some(context.context()),
+                InvocationWords::structured(Literal(head), &arguments).with_dialect(dialect),
+                self.realm,
+            );
+        let selected = resolution.resolved()?;
+        let descriptor = selected.authored_source_descriptors().command;
+        let (source_word, _, _) =
+            self.insertion_head(site, namespace, config, registry, descriptor, head, policy)?;
+        let facts = selected.facts();
+        let count = facts.arity_argument_count?;
+        if !facts.arity.accepts(count) {
+            return None;
+        }
+        match proposed {
+            ExactSwitch { table } => {
+                let case = selected.authored_source_case_invocation()?.1;
+                let fields = tcl_syntax::word_rules::WordValueRules::from_config(&config)
+                    .split_list(table)
+                    .ok()?;
+                if facts.operation
+                    != SemanticOperationId::StructuredLowering(LoweringHookId::Switch)
+                    || case.mode != tcl_registry::spec::CaseMatchMode::Exact
+                    || case.subject_index != Some(2)
+                    || case.clause_list_index != Some(3)
+                    || fields.len() < 4
+                    || !fields.len().is_multiple_of(2)
+                {
+                    return None;
+                }
+            }
+            DictionaryGet { .. } | DictionaryGetWithDefault { .. } => {
+                let command = if matches!(proposed, DictionaryGet { .. }) {
+                    NativeDictionaryCommand::Get
+                } else {
+                    NativeDictionaryCommand::GetWithDefault
+                };
+                let lookup = command.lookup();
+                let selected_member = selected.authored_source_descriptors().subcommand?;
+                if selected_member.name != lookup.member {
+                    return None;
+                }
+                match dialect.family()? {
+                    tcl_dialect::model::Family::Tcl => {
+                        let public_binding = super::source_binding(state, head, namespace);
+                        let public = public_binding.proved_target()?;
+                        if !state.original_ensemble_mapping_holds(public, &lookup) {
+                            return None;
+                        }
+                        let worker = state.original_registry_metadata_target(
+                            namespace,
+                            lookup.slot,
+                            policy,
+                        )?;
+                        if worker.kind != BindingKind::Builtin
+                            || worker.implementation_generation != 0
+                            || worker.implementation_allocation.is_some()
+                            || worker.token.is_none()
+                            || !tcl_registry::command_descriptor_labels_match(
+                                &worker.command,
+                                lookup.slot,
+                            )
+                            || state.source_execution_observed(worker.token.as_ref())
+                            || state.runtime_execution_observed(worker.token.as_ref())
+                        {
+                            return None;
+                        }
+                    }
+                    tcl_dialect::model::Family::Jim => {}
+                    _ => return None,
+                }
+            }
+            ReturnValue
+                if facts.operation
+                    != SemanticOperationId::StructuredLowering(LoweringHookId::Return) =>
+            {
+                return None;
+            }
+            SetValue { .. }
+                if facts.operation
+                    != SemanticOperationId::StructuredLowering(LoweringHookId::Set) =>
+            {
+                return None;
+            }
+            _ => {}
+        }
+        Some(OriginalComparisonRewriteCommand { source_word })
+    }
+}
