+
+/// Whether an operator can raise once its operands are evaluated. Comparisons
+/// never do; arithmetic, bitwise, logical and list operators raise on an
+/// operand they cannot read (tclsh 8.4.20 to 9.1.0: `expr {$x + 1}` with
+/// `x` = `abc` raises, `expr {$x == 1}` gives 0). An operation over constants
+/// raises only if its evaluation does.
+fn operation_may_raise_binary(
+    op: crate::expr_ast::BinOp,
+    left: &crate::expr_ast::ExprNode,
+    right: &crate::expr_ast::ExprNode,
+) -> bool {
+    use crate::expr_ast::BinOp;
+    !matches!(
+        op,
+        BinOp::Eq
+            | BinOp::Ne
+            | BinOp::Lt
+            | BinOp::Le
+            | BinOp::Gt
+            | BinOp::Ge
+            | BinOp::StrEq
+            | BinOp::StrNe
+            | BinOp::StrLt
+            | BinOp::StrLe
+            | BinOp::StrGt
+            | BinOp::StrGe
+            | BinOp::Contains
+            | BinOp::StartsWith
+            | BinOp::EndsWith
+            | BinOp::StrEquals
+            | BinOp::MatchesGlob
+    ) && !(left.is_constant()
+        && right.is_constant()
+        && crate::tcl_expr_eval::eval_tcl_expr(
+            &crate::expr_ast::ExprNode::Binary {
+                op,
+                left: Box::new(left.clone()),
+                right: Box::new(right.clone()),
+            },
+            &crate::tcl_expr_eval::Env::default(),
+        )
+        .is_some())
+}
+
+fn operation_may_raise(expression: &crate::expr_ast::ExprNode) -> bool {
+    !(expression.is_constant()
+        && crate::tcl_expr_eval::eval_tcl_expr(expression, &crate::tcl_expr_eval::Env::default())
+            .is_some())
+}
+
+/// Add the operator's error completion from the state its operands left.
+fn raise_from(
+    outcomes: &mut SourceOutcomes,
+    state: &ModuleCommandBindings,
+    registry: &CommandRegistry,
+) {
+    let mut raised = super::boxed_source_branch(state);
+    super::super::compiled_preflight::materialise_error_storage(&mut raised, registry);
+    outcomes.join(&SourceOutcomes::invocation(
+        &raised,
+        tcl_registry::completion_route::InvocationCompletionRoute::Tcl(
+            tcl_registry::completion::CompletionCode::Error,
+        ),
+    ));
+}
+
+fn raise_from_normal(outcomes: &mut SourceOutcomes, registry: &CommandRegistry) {
+    if let Some(normal) = outcomes.normal.clone() {
+        raise_from(outcomes, &normal, registry);
+    }
+}
