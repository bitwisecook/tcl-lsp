+++ b/rust/tcl-compiler/tests/it_2/var_escape_cfg.rs
@@ -860,6 +860,25 @@ fn ir_upvar_in_try_handler_escapes() {
     assert!(p.upvar_source_names.contains("cv"));
 }
 
+/// tclsh 8.6.18, 9.0.4, 9.1.0: `p 0` raises `divide by zero` inside the `try`
+/// body, so the handler links `cv` in the caller (`info exists cv` is 1).
+/// An operator that may raise reaches the handler: `/`, a unary `-` and a
+/// non-boolean `&&` operand, but not a comparison, which never raises.
+#[test]
+fn an_operator_that_may_raise_reaches_the_try_handler() {
+    for body in ["expr {1/$d}", "expr {-$d}", "expr {$d && 1}"] {
+        let s = escape_ir(&format!(
+            "proc ::p {{d}} {{ try {{ {body} }} on error {{e}} {{ upvar 1 cv v\n set v 1 }} }}"
+        ));
+        let p = summary(&s, "::p");
+        assert!(p.upvar_source_names.contains("cv"), "{body}: {p:?}");
+    }
+    let s = escape_ir(
+        "proc ::p {d} { try { expr {$d == 1} } on error {e} { upvar 1 cv v\n set v 1 } }",
+    );
+    assert!(!summary(&s, "::p").upvar_source_names.contains("cv"));
+}
