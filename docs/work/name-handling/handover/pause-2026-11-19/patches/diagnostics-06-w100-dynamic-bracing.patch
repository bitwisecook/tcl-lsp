 2 files changed, 66 insertions(+), 12 deletions(-)

diff --git a/rust/tcl-compiler/src/analyser/diagnostics/tests/usage.rs b/rust/tcl-compiler/src/analyser/diagnostics/tests/usage.rs
index 4d96e25480..c838d65a64 100644
--- a/rust/tcl-compiler/src/analyser/diagnostics/tests/usage.rs
+++ b/rust/tcl-compiler/src/analyser/diagnostics/tests/usage.rs
@@ -555,6 +555,38 @@ fn w100_flags_unbraced_expr_with_substitution() {
     assert_eq!(w100_sev("for {set i 0} $i<10 {incr i} {}\n"), vec!["Error"]);
 }
 
+#[test]
+fn w100_checks_the_proposed_braced_expression() {
+    for dialect in ["tcl8.4", "tcl8.5", "tcl8.6", "tcl9.0", "tcl9.1", "jimtcl"] {
+        for (expression, replacement) in [
+            ("1${op}2", None),
+            ("1${digits}", None),
+            ("$n+1", Some("{$n+1}")),
+        ] {
+            let source = format!("set op +; set digits 1; set n 2; puts [expr {expression}]");
+            let result = crate::analyser::Analyser::new().analyse(&source, dialect);
+            let warning = result
+                .diagnostics
+                .iter()
+                .find(|d| d.code == DiagCode::W100)
+                .expect("unbraced expression with an outer substitution");
+            assert_eq!(
+                warning
+                    .fixes
+                    .iter()
+                    .map(|fix| fix.new_text.as_str())
+                    .collect::<Vec<_>>(),
+                replacement.into_iter().collect::<Vec<_>>(),
+                "{dialect} {expression}"
+            );
+            if replacement.is_none() {
+                assert!(!warning.message.contains("Use braces"));
+                assert!(!warning.message.contains("Use expr"));
+            }
+        }
+    }
+}
+
 #[test]
