+
+#[test]
+fn a_declared_body_keeps_its_own_local_and_remote_frame_evidence() {
+    // The same program returns "first second shared" under each C Tcl and Jim.
+    let source = "set globalValue shared\nproc check {arg} {set local $arg; uplevel #0 {set globalSeen $globalValue}; return $local}\nset first [check first]\nset second [check second]";
+    let bindings = allocation_source(source);
+    let offset = |fragment: &str| u32::try_from(source.find(fragment).unwrap()).unwrap();
+    let local = offset("set local");
+    let remote = offset("set globalSeen");
+    let collected = bindings.declared_frame_walk.as_ref().unwrap();
+    let root = collected
+        .collected_declared_owners
+        .iter()
+        .find(|entry| entry.body.start() <= local && local < entry.body.end())
+        .unwrap();
+    let view = bindings
+        .declared_frame_view(&root.frame, root.body)
+        .unwrap();
+    let local_points = view.dispatch_points_at(local).collect::<Vec<_>>();
+    assert!(!local_points.is_empty());
+    assert!(
+        local_points
+            .iter()
+            .all(|point| point.state.variable_frame == root.frame)
+    );
+    let remote_points = view.dispatch_points_at(remote).collect::<Vec<_>>();
+    assert!(!remote_points.is_empty());
+    assert!(
+        remote_points
+            .iter()
+            .all(|point| point.state.source_variables.global_frame())
+    );
+    assert!(
+        local_points
+            .iter()
+            .chain(&remote_points)
+            .all(|point| point.declared_owner.as_deref() == Some(root))
+    );
+    // Actual callers remain in the ordinary interpretation.
+    assert!(
+        bindings
+            .dispatch_points_at(local)
+            .all(|point| point.declared_owner.is_none())
+    );
+}
