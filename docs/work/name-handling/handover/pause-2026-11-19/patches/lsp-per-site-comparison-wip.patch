+/// A document-level reached command can use its actual straight-line input.
+/// A callable can still be entered by other scripts; a body rewrite needs a
+/// separate generic-entry proof and cannot borrow its observed call sites.
+pub(super) fn document_comparison(
+    walk: &FrameWalk<'_>,
+    source: &str,
+    command: &SegmentedCommand,
+) -> bool {
+    walk.segment_document(source)
+        .iter()
+        .any(|top| top.span == command.span)
+}
+
+/// Actual original handler and observer state at a comparison command.
+pub(super) fn comparison_tokens(
+    walk: &FrameWalk<'_>,
+    source: &str,
+    command: &SegmentedCommand,
+    hook: LoweringHookId,
+) -> Option<tcl_compiler::ir::CommandTokens> {
+    use tcl_compiler::command_binding::BindingKind;
+    let tokens = walk.tokens(source, command);
+    let binding = tokens.source_binding.as_ref()?;
+    let target = binding.proved_execution_target()?;
+    let selected = walk.structure_of_tokens(&tokens)?;
+    (target.registry_backed
+        && target.kind == BindingKind::Builtin
+        && target.prepended.is_empty()
+        && target.implementation_generation == 0
+        && target.implementation_allocation.is_none()
+        && binding.unobserved_native_dispatch()
+        && selected.facts.operation == tcl_registry::SemanticOperationId::StructuredLowering(hook))
+    .then_some(tokens)
+}
+
+/// Closed literal alternatives at the actual scalar read in this operand.
+/// An observed, missing, transformed or dynamically selected read declines.
+pub(super) fn scalar_read_values<'a>(
+    source: &str,
+    tokens: &'a tcl_compiler::ir::CommandTokens,
+    word: &tcl_lexer::NativeWord,
+    scalar: &str,
+    registry: &tcl_registry::CommandRegistry,
+) -> Option<Vec<&'a str>> {
+    let span = word.span();
+    let mut reads = tokens.variable_accesses.iter().filter(|read| {
+        span.start() <= read.source.span.start() && read.source.span.end() <= span.end()
+    });
+    let read = reads.next()?;
+    if reads.next().is_some()
+        || read.context_residual()
+            != tcl_compiler::command_binding::SourceVariableReadResidual::Closed
+        || read.context_alternatives().is_empty()
+        || source.get(read.source.span.as_range())? != read.original_spelling
+        || tcl_syntax::naming::variable_reference_root_bytes(
+            read.original_spelling.as_bytes(),
+            word.config(),
+        )
+        .ok()??
+            != scalar.as_bytes()
+    {
+        return None;
+    }
+    read.context_alternatives()
+        .iter()
+        .map(|context| {
+            let place = tcl_compiler::var_resolve::resolve_substitution_access(
+                &read.original_spelling,
+                context,
+                registry,
+                tcl_registry::TraceOperation::Read,
+            );
+            if place.dynamic
+                || place.observed
+                || place.kind != tcl_compiler::place::PlaceKind::Scalar
+                || place.cell.is_none()
+            {
+                return None;
+            }
+            context
+                .literal_contents_at(&place, registry)
+                .filter(|value| value.is_ascii() && !value.as_bytes().contains(&0))
+        })
+        .collect()
 }
 
