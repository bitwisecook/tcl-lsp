+
+impl<'a> EqualityChain<'a> {
+    fn read(
+        original: &'a crate::original_invocation::OriginalRegistryWords,
+        plan: &tcl_registry::clause_grammar::ClausePlan,
+        config: LexerConfig,
+        expression: &tcl_syntax::expr::parser::ExprParseContext,
+    ) -> Option<Self> {
+        if plan.defect.is_some() {
+            return None;
+        }
+        let mut subject: Option<ScalarVariableSourceSyntax> = None;
+        let mut branches = Vec::new();
+        let mut conditions = Vec::new();
+        let mut else_body = None;
+        for clause in &plan.clauses {
+            let literal = |role| {
+                let index = clause.operand(role)?;
+                std::str::from_utf8(original.arguments.get(index)?.literal_bytes()?).ok()
+            };
+            let body = literal(ArgRole::Body)?.to_owned();
+            if clause.is_default {
+                else_body = Some(body);
+                continue;
+            }
+            let test = parse_eq_test(literal(ArgRole::Expr)?, config, expression)?;
+            if test.negated
+                || subject
+                    .as_ref()
+                    .is_some_and(|previous| previous.name() != test.subject.name())
+            {
+                return None;
+            }
+            subject.get_or_insert(test.subject);
+            let word = original
+                .operands
+                .get(clause.operand(ArgRole::Expr)?)?
+                .as_ref()?
+                .word
+                .as_ref()?;
+            conditions.push(word);
+            branches.push((test.value, body));
+        }
+        if branches.len() < 2 {
+            return None;
+        }
+        Some(Self {
+            subject: subject?,
+            conditions,
+            branches,
+            else_body,
+        })
+    }
+}
