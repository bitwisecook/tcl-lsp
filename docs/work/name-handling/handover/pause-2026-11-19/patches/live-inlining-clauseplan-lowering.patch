diff --git a/rust/tcl-compiler/src/lowering/structured.rs b/rust/tcl-compiler/src/lowering/structured.rs
index cb387f6a5f41a33c1158cfa210e03bcc57523e61..87fc130765b154138b276fc2f5c42fe38c3f8e3d 100644
--- a/rust/tcl-compiler/src/lowering/structured.rs
+++ b/rust/tcl-compiler/src/lowering/structured.rs
@@ -403,7 +403,21 @@ impl Lowerer<'_> {
     ) -> Option<Result<ClausePlan, ClauseAbstention>> {
         let tokens = self.cmd_tokens(seg);
         let context = self.invocation_metadata_context();
-        let invocation = self.logical_structured_invocation(&tokens)?;
+        let Some(invocation) = self.logical_structured_invocation(&tokens) else {
+            // A reference body under a caller's live entry: the entry admitted
+            // the release's command, and its own words give the clause walk.
+            if self.structured_control
+                != crate::command_binding::StructuredControlReading::ReferenceBody
+            {
+                return None;
+            }
+            return crate::registry_invocation::admitted_native_compiler_invocation(
+                self.registry,
+                None,
+                &tokens,
+            )?
+            .clause_walk(self.registry);
+        };
         let realm = tokens
             .source_binding
             .as_ref()
diff --git a/rust/tcl-compiler/src/registry_invocation/native_compilation.rs b/rust/tcl-compiler/src/registry_invocation/native_compilation.rs
index c615c3d41b21e1d5b70079de2f58af2ac7830c85..9dbc8ba244b2772b7933805d28a336c59c550412 100644
