diff --git a/rust/tcl-compiler/src/command_binding/source_analysis_entry.rs b/rust/tcl-compiler/src/command_binding/source_analysis_entry.rs
index ae2311e7e4c8886518acf0444f8f25a728177078..a84b11d493d680a8898ca8529ea51d8256766d2e 100644
--- a/rust/tcl-compiler/src/command_binding/source_analysis_entry.rs
+++ b/rust/tcl-compiler/src/command_binding/source_analysis_entry.rs
@@ -154,6 +154,22 @@ pub struct SourceAnalysisOptions<'a> {
     pub expression_parser: Option<tcl_registry::invocation_words::LogicalExpressionParseProvider>,
     /// Native script evaluation protocol and compiler frame supplied by the entry owner.
     pub native_compilation: tcl_registry::native_compilation::NativeCompilationContext,
+    /// How a structured-control command is read under a live entry.
+    pub structured_control: StructuredControlReading,
+}
+
+/// How a structured-control command (`if` and its kin) is read when the
+/// source is lowered under a live native entry.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub enum StructuredControlReading {
+    /// Kept as a call: the selected compiler owns the command's emission.
+    #[default]
+    Call,
+    /// The source is a pack's reference body lowered under a caller's live
+    /// entry: a command whose head the entry proves to be the release's
+    /// builtin is read as structured control, as tclsh 8.5 to 9.1 compile it,
+    /// so the body can align with its fresh reading.
+    ReferenceBody,
 }
 
 pub(super) fn native_compilation_dialect(
@@ -613,6 +629,7 @@ impl SourceAnalysisEntry {
             compiled_variable_provider: self.compiled_variable_provider,
             expression_parser: self.expression_parser,
             native_compilation: self.native_compilation,
+            structured_control: StructuredControlReading::Call,
         }
     }
 }
