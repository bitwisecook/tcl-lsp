-    ctx.close_splice();
 }
 
 /// Emit the owning command boundary for a structured block that CFG lowering
@@ -982,6 +981,8 @@ fn open_branch_command(
 
 /// Emit the trailing `DONE` / proc-exit machinery after all blocks.
 fn emit_function_tail(ctx: &mut CodegenCtx, cfg: &CfgFunction) {
+    // A splice whose body ends the function closes before its exit.
+    ctx.close_splice();
     // Empty proc body: push "" as the implicit return value.
     if ctx.is_proc && ctx.instructions.is_empty() {
         ctx.push_lit("");
diff --git a/rust/tcl-codegen/src/inlining/live.rs b/rust/tcl-codegen/src/inlining/live.rs
index 861899e04b6f854f0dbe77354315850b5c807dd4..8a528b0c9e304448250f01c13c521db5161a58d4 100644
--- a/rust/tcl-codegen/src/inlining/live.rs
+++ b/rust/tcl-codegen/src/inlining/live.rs
@@ -69,6 +69,8 @@ impl Lowering<'_> {
         // The definition's own formals, not the caller's.
         let mut options = self.options;
         options.incoming_formals = &[];
+        options.structured_control =
+            tcl_compiler::command_binding::StructuredControlReading::ReferenceBody;
         tcl_compiler::lowering::lower_procedure_target_module_for_bytecode_with_options(
             tcl_runtime_api::ProcedureCompileTarget {
                 source: body,
@@ -167,8 +169,14 @@ impl LiveBodies<'_> {
         // through its binding site.
         tcl_compiler::ir::for_each_script_mut(&mut lowered, &mut |script| {
             for statement in &mut script.statements {
-                if let Statement::Return { expr_base, .. } = statement {
-                    *expr_base = None;
+                match statement {
+                    Statement::Return { expr_base, .. } => *expr_base = None,
+                    Statement::If { clauses, .. } => {
+                        for clause in clauses {
+                            clause.condition_base = None;
+                        }
+                    }
+                    _ => {}
                 }
             }
         });
