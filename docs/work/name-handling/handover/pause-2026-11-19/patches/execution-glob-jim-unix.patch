+//! Unix filesystem grammar of the installed Jim glob library.
+use std::ops::Range;
+
+use super::{GlobBraceError, unix_pattern::host_path};
+use crate::CmdError;
+use tcl_core_types::c_string_extent;
+use tcl_platform::Filesystem;
+use tcl_syntax::raw_string::RawString;
+
+/// Filesystem-layer syntax offsets. Remaining component syntax uses the
+/// original Jim object matcher.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum JimGlobToken {
+    OpenBrace,
+    CloseBrace,
+    Comma,
+    Slash,
+    Escape,
+}
+
+/// Read exactly the library's quote-map pairs. Other backslashes are left
+/// for the component matcher. Control code collisions are retained as in
+/// the original Jim `string map` calls.
+fn quote(pattern: &[u8], mut token: impl FnMut(JimGlobToken, Range<usize>)) -> Vec<(u8, usize)> {
+    let mut encoded = Vec::with_capacity(pattern.len());
+    let mut i = 0;
+    while i < pattern.len() {
+        let mut byte = pattern[i];
+        let start = i;
+        if byte == b'\\'
+            && let Some(&next) = pattern.get(i + 1)
+        {
+            let escaped = match next {
+                b'\\' => Some(1),
+                b'{' => Some(2),
+                b'}' => Some(3),
+                b',' => Some(4),
+                _ => None,
+            };
+            if let Some(escaped) = escaped {
+                byte = escaped;
+                i += 1;
+                token(JimGlobToken::Escape, start..i + 1);
+            }
+        }
+        encoded.push((byte, start));
+        i += 1;
+    }
+    encoded
+}
+
+/// Parse original source once, with a separate consumer for semantic brace
+/// boundaries. A lone open brace is literal when there is no close brace
+/// ahead; a close brace at top level raises.
+fn scan(
+    encoded: &[(u8, usize)],
+    mut visit: impl FnMut(Option<JimGlobToken>, u8, usize),
+) -> Result<(), GlobBraceError> {
+    let last_close = encoded.iter().rposition(|(byte, _)| *byte == b'}');
+    let mut opens = Vec::new();
+    for (index, &(byte, offset)) in encoded.iter().enumerate() {
+        let token = match byte {
+            b'{' if last_close.is_some_and(|close| index < close) => {
+                opens.push(offset);
+                Some(JimGlobToken::OpenBrace)
+            }
+            b'}' => {
+                if opens.pop().is_none() {
+                    return Err(GlobBraceError {
+                        offset,
+                        opening: false,
+                    });
+                }
+                Some(JimGlobToken::CloseBrace)
+            }
+            b',' if !opens.is_empty() => Some(JimGlobToken::Comma),
+            b'/' => Some(JimGlobToken::Slash),
+            _ => None,
+        };
+        visit(token, byte, offset);
+    }
+    if let Some(offset) = opens.pop() {
+        return Err(GlobBraceError {
+            offset,
+            opening: true,
+        });
+    }
+    Ok(())
+}
+
+/// The complete view does no filesystem I/O and does not expand the alternatives.
+pub fn jim_glob_tokens(
+    pattern: &[u8],
+) -> Result<Vec<(JimGlobToken, Range<usize>)>, GlobBraceError> {
+    let mut tokens = Vec::new();
+    let encoded = quote(pattern, |kind, span| tokens.push((kind, span)));
+    scan(&encoded, |kind, _, i| {
+        if let Some(kind) = kind {
+            tokens.push((kind, i..i + 1));
+        }
+    })?;
+    tokens.sort_unstable_by_key(|(_, range)| range.start);
+    Ok(tokens)
+}
+
+fn expand(pattern: &[u8]) -> Result<Vec<Vec<u8>>, CmdError> {
+    let encoded = quote(pattern, |_, _| {});
+    let mut prefix = vec![Vec::new()];
+    let mut parents = Vec::new();
+    scan(&encoded, |token, byte, _| match token {
+        Some(JimGlobToken::OpenBrace) => {
+            parents.push(std::mem::replace(&mut prefix, vec![Vec::new()]));
+        }
+        Some(JimGlobToken::CloseBrace) => {
+            let outer = parents.pop().expect("matched Jim glob brace");
+            let inner = std::mem::take(&mut prefix);
+            for word in inner.into_iter().filter(|word| !word.is_empty()) {
+                for alternative in word.split(|b| *b == b',') {
+                    for old in &outer {
+                        let mut next = old.clone();
+                        next.extend_from_slice(alternative);
+                        prefix.push(next);
+                    }
+                }
+            }
+        }
+        _ => {
+            for old in &mut prefix {
+                old.push(byte);
+            }
+        }
+    })
+    .map_err(|error| {
+        CmdError::new(if error.opening {
+            "unmatched open brace in glob pattern"
+        } else {
+            "unmatched close brace in glob pattern"
+        })
+    })?;
+    Ok(prefix
+        .into_iter()
+        .map(|word| {
+            let mut original = Vec::new();
+            for b in word {
+                match b {
+                    1 => original.extend_from_slice(b"\\\\"),
+                    2 => original.push(b'{'),
+                    3 => original.push(b'}'),
+                    4 => original.push(b','),
+                    _ => original.push(b),
+                }
+            }
+            original
+        })
+        .collect())
+}
+
+pub(super) fn matches(
+    fs: &dyn Filesystem,
+    base: &[u8],
+    pattern: &[u8],
+    tails: bool,
+) -> Result<Vec<Vec<u8>>, CmdError> {
+    let mut hits = Vec::new();
+    for expanded in expand(pattern)? {
+        let mut path = expanded.as_slice();
+        let mut components = Vec::new();
+        loop {
+            let (parent, tail) = dirname_tail(path);
+            if path == parent || path.is_empty() {
+                break;
+            }
+            components.push(tail);
+            path = if path == tail { b"" } else { parent };
+        }
+        let mut paths = vec![(
+            join(base, dirname_tail(path).0, fs.native_path_limit())?,
+            path.to_vec(),
+        )];
+        for component in components.into_iter().rev() {
+            let mut next = Vec::new();
+            for (real, shown) in paths {
+                if !fs.metadata(host_path(&real)?).is_ok_and(|m| m.is_dir) {
+                    continue;
+                }
+                let joined = join(&real, component, fs.native_path_limit())?;
+                let names = if fs.exists(host_path(&joined)?) {
+                    vec![component.to_vec()]
+                } else {
+                    component_matches(fs, &real, component)?
+                };
+                for name in names {
+                    let mut display = shown.clone();
+                    if !display.is_empty() && !display.ends_with(b"/") {
+                        display.push(b'/');
+                    }
+                    display.extend_from_slice(&name);
+                    next.push((join(&real, &name, fs.native_path_limit())?, display));
+                }
+            }
+            paths = next;
+        }
+        for (_, shown) in paths {
+            hits.push(if tails {
+                shown
+            } else {
+                join(base, &shown, fs.native_path_limit())?
+            });
+        }
+    }
+    Ok(hits)
+}
+
+fn component_matches(
+    fs: &dyn Filesystem,
+    real: &[u8],
+    component: &[u8],
+) -> Result<Vec<Vec<u8>>, CmdError> {
+    let mut names = fs
+        .read_dir(host_path(real)?)
+        .map_err(|error| CmdError::new(error.reason()))?;
+    names.extend([".".to_owned(), "..".to_owned()]);
+    let pattern = RawString::from_bytes(component);
+    let mut hits = Vec::new();
+    for name in names {
+        let name = name.into_bytes();
+        if name.starts_with(b".") && !component.starts_with(b".") {
+            continue;
+        }
+        if RawString::from_bytes(name.as_slice()).jim084_matches(&pattern, false)? {
+            hits.push(name);
+        }
+    }
+    Ok(hits)
+}
+
+/// The Unix Jim `file dirname` and `file tail` share this original trailing
+/// slash removal and C-string separator search.
+fn dirname_tail(mut path: &[u8]) -> (&[u8], &[u8]) {
+    while path.len() > 1 && path.ends_with(b"/") {
+        path = &path[..path.len() - 1];
+    }
+    let extent = c_string_extent(path);
+    let Some(at) = extent.iter().rposition(|b| *b == b'/') else {
+        return (b".", path);
+    };
+    let tail = &extent[at + 1..];
+    let mut parent = if tail.is_empty() {
+        path
+    } else if at == 0 {
+        b"/"
+    } else {
+        &path[..at]
+    };
+    while parent.len() > 1 && parent.ends_with(b"/") {
+        parent = &parent[..parent.len() - 1];
+    }
+    (parent, tail)
+}
+
+/// The installed Linux Jim `file join` drops one leading `./` and one
+/// trailing slash per argument; internal separators remain ordinary bytes.
+fn join(base: &[u8], name: &[u8], limit: Option<usize>) -> Result<Vec<u8>, CmdError> {
+    let mut result = Vec::new();
+    for mut part in [base, name] {
+        if part.starts_with(b"/") {
+            result.clear();
+        } else if let Some(rest) = part.strip_prefix(b"./") {
+            part = rest;
+        } else if c_string_extent(part) == b"." && !result.is_empty() {
+            continue;
+        }
+        if !result.is_empty() && !result.ends_with(b"/") {
+            result.push(b'/');
+        }
+        if !part.is_empty() && limit.is_some_and(|limit| result.len() + part.len() >= limit) {
+            return Err(CmdError::new("Path too long"));
+        }
+        result.extend_from_slice(part);
+        if result.len() > 1 && result.ends_with(b"/") {
+            result.pop();
+        }
+    }
+    Ok(result)
+}
