From 0d4a4950f4d3ff28fb7dce949ad3b822e7f98f8e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 16 Nov 2026 11:22:50 +0000
Subject: [PATCH] Seed the startup variables under the key the walk reads them
 by

LOCAL, NOT PUSHED (pause). A fresh world listed argv, env, tcl_version
and the rest under authored string keys; the walk addresses a global by
its namespace-cell key, so each read was a proved error at file level.
Probe-verified; the whole-crate run was stopped before it finished.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017u5g3J3rxgBLfx8ijRxPu9
---
 .../src/analyser/diagnostics/unresolved.rs    | 39 +++++++++++++++++++
 .../src/variable_bindings/namespace_cells.rs  | 15 ++++++-
 2 files changed, 53 insertions(+), 1 deletion(-)

diff --git a/rust/tcl-compiler/src/analyser/diagnostics/unresolved.rs b/rust/tcl-compiler/src/analyser/diagnostics/unresolved.rs
index b7c3b5c7..998632e0 100644
--- a/rust/tcl-compiler/src/analyser/diagnostics/unresolved.rs
+++ b/rust/tcl-compiler/src/analyser/diagnostics/unresolved.rs
@@ -901,6 +901,45 @@ mod require_ordering_tests {
         }
     }
 
+    /// The interpreter creates its startup variables before the document
+    /// runs, so reading one at file level does not raise and what follows is
+    /// reached.
+    ///
+    /// tclsh 8.4.20, 8.6.18, 9.0.4 and 9.1.0 print `1 1 1 1 1 1` for
+    /// `puts [list [info exists argv] [info exists argv0] [info exists env]
+    /// [info exists tcl_version] [info exists tcl_platform] [info exists
+    /// auto_path]]`.
+    #[test]
+    fn a_startup_variable_read_at_file_level_reaches_what_follows() {
+        let unresolved = |source: &str, release: &str| {
+            crate::analyser::Analyser::new()
+                .analyse(source, release)
+                .diagnostics
+                .iter()
+                .filter(|diagnostic| diagnostic.code == tcl_core_types::DiagCode::W123)
+                .count()
+        };
+        for release in ["tcl8.4", "tcl8.6", "tcl9.0", "tcl9.1"] {
+            for read in [
+                "$argv",
+                "$argv0",
+                "$env(HOME)",
+                "$tcl_version",
+                "$tcl_platform(os)",
+                "$auto_path",
+            ] {
+                let source = format!("set seen {read}\nnosuch\n");
+                assert_eq!(unresolved(&source, release), 1, "{release}: {read}");
+            }
+            // A name the interpreter never created still ends the script.
+            assert_eq!(
+                unresolved("set seen $never_created\nnosuch\n", release),
+                0,
+                "{release}"
+            );
+        }
+    }
+
     /// Absence advice survives a channel read stored and incremented, and a
     /// clock reading compiled inside a procedure body.
     ///
diff --git a/rust/tcl-compiler/src/variable_bindings/namespace_cells.rs b/rust/tcl-compiler/src/variable_bindings/namespace_cells.rs
index 22ba14ec..60ff29fa 100644
--- a/rust/tcl-compiler/src/variable_bindings/namespace_cells.rs
+++ b/rust/tcl-compiler/src/variable_bindings/namespace_cells.rs
@@ -505,7 +505,20 @@ pub fn fresh_namespace_cells(
     let present = tcl_registry::special_vars::SPECIAL_VARS
         .iter()
         .filter(|variable| variable.readable_at_startup_in(query))
-        .map(|variable| tcl_syntax::naming::qualify("::", variable.name))
+        // A global is addressed by its authored spelling or by its cell in
+        // the root namespace table; the interpreter creates one variable.
+        .flat_map(|variable| {
+            [
+                crate::var_resolve::VariableCellKey::Authored(tcl_syntax::naming::qualify(
+                    "::",
+                    variable.name,
+                )),
+                crate::var_resolve::VariableCellKey::Namespace {
+                    identity: crate::command_binding::SourceNamespaceKey::authored("::"),
+                    simple: tcl_core_types::NameBytes::from(variable.name.as_bytes()),
+                },
+            ]
+        })
         .collect();
     crate::var_resolve::NamespaceCellPresence {
         present,
