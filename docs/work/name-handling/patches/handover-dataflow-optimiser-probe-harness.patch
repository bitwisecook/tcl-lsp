+#[test]
+fn zz_expr_env() {
+    let Ok(exprs) = std::env::var("PROBE_EXPR_ENV") else {
+        return;
+    };
+    let profile = std::env::var("PROBE_PROFILE").unwrap_or_default();
+    let mut env = tcl_compiler::Env::new();
+    for pair in std::env::var("PROBE_ENV").unwrap_or_default().split(";;") {
+        if let Some((name, value)) = pair.split_once('=') {
+            env.insert(
+                name.to_owned(),
+                tcl_compiler::EnvValue::Str(value.to_owned()),
+            );
+        }
+    }
+    let dialect = tcl_registry::model::ingress::resolve_environment(&profile).analyser_profile();
+    for expr in exprs.split(";;") {
+        let node = tcl_compiler::expr_parser::parse_expr(expr, Some(&profile));
+        let strict = tcl_compiler::tcl_expr_eval::eval_tcl_expr_in_dialect(&node, &env, dialect);
+        let analysed = tcl_compiler::tcl_expr_eval::analyse_tcl_expr_with_resolved_math_bindings(
+            &node,
+            &env,
+            tcl_compiler::tcl_expr_eval::FoldPolicy::for_profile(
+                tcl_compiler::tcl_expr_eval::leading_zero_is_octal(dialect),
+                Some(dialect),
+            ),
+            &|_, _| None,
+            None,
+        );
+        println!(
+            "  exprenv[{profile}] {expr} => strict {strict:?} analysed {:?} coercions {:?}",
+            analysed.as_ref().map(|e| &e.value),
+            analysed.as_ref().map(|e| e.coercions.len())
+        );
+    }
+}
