+// Local probe harness. Not committed.
+use tcl_compiler::compilation_unit::{CompilationUnit, FunctionUnit};
+use tcl_registry::model::ingress::static_context_for;
+
+fn dump(fu: &FunctionUnit) {
+    println!("== function {} blocks={}", fu.name, fu.cfg.blocks.len());
+    if let Ok(var) = std::env::var("PROBE_VAR") {
+        println!("  var_symbol({var}) = {:?}", fu.ssa.var_symbol(&var));
+    }
+    let mut values: Vec<String> = fu
+        .sccp
+        .values
+        .iter()
+        .map(|((sym, ver), v)| format!("{}#{ver} = {v:?}", fu.ssa.var_name(*sym)))
+        .collect();
+    values.sort();
+    for v in values {
+        println!("  sccp {}", &v[..v.len().min(200)]);
+    }
+    let mut types: Vec<String> = fu
+        .types
+        .iter()
+        .map(|((sym, ver), t)| format!("{}#{ver} : {t}", fu.ssa.var_name(*sym)))
+        .collect();
+    types.sort();
+    for t in types {
+        println!("  type {t}");
+    }
+    if std::env::var_os("PROBE_WHY").is_some() {
+        for explanation in &fu.sccp.explanations {
+            let text = format!("{explanation:?}");
+            println!("  why {}", &text[..text.len().min(600)]);
+        }
+    }
+    if std::env::var_os("PROBE_CFG").is_some() {
+        for (id, block) in &fu.cfg.blocks {
+            println!("  block {id:?}");
+            for statement in &block.statements {
+                let text = format!("{statement:?}");
+                println!("    {}", &text[..text.len().min(300)]);
+            }
+        }
+    }
+}
+
+#[test]
+fn zz_probe() {
+    let Ok(src) = std::env::var("PROBE_SRC") else {
+        return;
+    };
+    let src = src.replace("\\n", "\n");
+    let profile = std::env::var("PROBE_PROFILE").unwrap_or_default();
+    println!("profile={profile:?} src={src:?}");
+    let owned;
+    let registry = if profile.is_empty() {
+        owned = tcl_registry::CommandRegistry::build_default();
+        &owned
+    } else {
+        static_context_for(&profile).commands()
+    };
+    let cu = if std::env::var_os("PROBE_DIALECT_BUILD").is_some() {
+        CompilationUnit::build_for_dialect(&src, registry, false, &profile)
+    } else {
+        CompilationUnit::build_for(&src, registry, false)
+    };
+    dump(&cu.top_level);
+    for (id, fu) in &cu.procedures {
+        println!("-- id {id:?}");
+        dump(fu);
+    }
+    if std::env::var_os("PROBE_OBJ").is_some() {
+        let mut classes: Vec<_> = tcl_compiler::object_types::object_handle_classes(&cu, registry)
+            .into_iter()
+            .collect();
+        classes.sort_by(|a, b| a.0.cmp(&b.0));
+        println!("  objects {classes:?}");
+        let mut collections: Vec<_> = tcl_compiler::object_types::object_collection_classes(&cu)
+            .into_iter()
+            .collect();
+        collections.sort_by(|a, b| a.0.cmp(&b.0));
+        println!("  collections {collections:?}");
+    }
+    for (id, fu) in &cu.methods {
+        println!("-- method {id:?}");
+        dump(fu);
+    }
+    if std::env::var_os("PROBE_ESC").is_some() {
+        for fu in cu.procedures.values() {
+            let context = fu.invocation_metadata_context(registry);
+            let mut names: Vec<String> =
+                tcl_compiler::var_observability::analyse_var_observability_with_metadata_context(
+                    &fu.cfg, registry, context,
+                )
+                .escaping_var_names()
+                .into_iter()
+                .collect();
+            names.sort();
+            println!("  escaping {} context={} {names:?}", fu.name, context.is_some());
+        }
+    }
+    let dialect = (!profile.is_empty())
+        .then(|| tcl_registry::model::ingress::resolve_environment(&profile).analyser_profile());
+    let opts = tcl_compiler::optimiser::optimise_with_dialect(&src, registry, dialect);
+    for o in &opts {
+        println!(
+            "  opt {} {:?} -> {:?} hint={}",
+            o.code.as_str(),
+            o.span,
+            o.replacement,
+            o.hint_only
+        );
+    }
+    println!(
+        "  optimised: {:?}",
+        tcl_compiler::optimiser::apply_optimisations(&src, &opts)
+    );
+    for w in tcl_compiler::taint::find_taint_warnings_for_cu(&cu, registry, dialect) {
+        println!(
+            "  taint {} var={} sink={}",
+            w.code, w.variable, w.sink_command
+        );
+    }
+}
