+#[test]
+fn zz_bytecode() {
+    let Ok(src) = std::env::var("PROBE_BC") else {
+        return;
+    };
+    let src = src.replace("\\n", "\n");
+    let profile = std::env::var("PROBE_PROFILE").unwrap_or_default();
+    let registry = static_context_for(&profile).commands();
+    let dialect = tcl_registry::model::ingress::resolve_environment(&profile).analyser_profile();
+    let module = tcl_compiler::lowering::lower_script_module_for_bytecode(
+        &src,
+        "::",
+        registry,
+        tcl_lexer::LexerConfig::for_profile(Some(dialect)),
+        Some(dialect),
+        false,
+    );
+    for statement in &module.top_level.statements {
+        let text = format!("{statement:?}");
+        println!("  top {}", &text[..text.len().min(120)]);
+    }
+    for (id, procedure) in &module.procedures {
+        for statement in &procedure.body.statements {
+            let text = format!("{statement:?}");
+            println!("  proc {id:?} {}", &text[..text.len().min(120)]);
+        }
+    }
+}
