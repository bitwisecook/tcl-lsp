+#[test]
+fn zz_expr() {
+    let Ok(exprs) = std::env::var("PROBE_EXPR") else {
+        return;
+    };
+    let profile = std::env::var("PROBE_PROFILE").unwrap_or_default();
+    for expr in exprs.split(";;") {
+        let value = if profile.is_empty() {
+            tcl_compiler::tcl_expr_eval::eval_tcl_expr(
+                &tcl_compiler::expr_parser::parse_expr(expr, None),
+                &tcl_compiler::Env::new(),
+            )
+        } else {
+            tcl_compiler::tcl_expr_eval::eval_tcl_expr_in_dialect(
+                &tcl_compiler::expr_parser::parse_expr(expr, Some(&profile)),
+                &tcl_compiler::Env::new(),
+                tcl_registry::model::ingress::resolve_environment(&profile).analyser_profile(),
+            )
+        };
+        println!("  expr[{profile}] {expr} => {value:?}");
+    }
+}
