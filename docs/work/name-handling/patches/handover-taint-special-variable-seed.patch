+    /// The root-global address in a supplied document, which starts from a
+    /// fresh interpreter and so carries no captured entry to compare with.
+    pub(crate) fn supplied_root_global(&self) -> Option<IncomingRootGlobalCell<'_>> {
+        let mut root = self;
+        while let Self::Element { cell, .. } = root {
+            root = cell;
+        }
+        match root {
+            Self::Namespace {
+                identity: SourceNamespaceKey::Authored(namespace),
+                simple,
+            } if namespace == "::" => Some(IncomingRootGlobalCell {
+                cell: self,
+                name: simple,
+            }),
+            _ => None,
+        }
+    }
