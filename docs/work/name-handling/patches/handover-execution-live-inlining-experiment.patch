+#[test]
+fn zz_probe_verbatim_live() {
+    let pack = Spliced::new("probe-verbatim", &[("vthree", 0, "proc vthree {} {expr {1 + 2}}")]);
+    let caller = "proc caller {} {vthree}";
+    eprintln!("PROBE bindings={}", pack.bindings(caller, "::caller"));
+    let out = pack.inlined(&[caller], "caller");
+    eprintln!("PROBE inlined={out:?}");
+    let pack2 = Spliced::new("probe-param", &[("vdouble", 1, "proc vdouble {x} {expr {$x * 2}}")]);
+    let caller2 = "proc caller {n} {vdouble $n}";
+    eprintln!("PROBE param inlined={:?}", pack2.inlined(&[caller2], "caller 21"));
