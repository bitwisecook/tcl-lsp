+/// `proc` with its body lowered as the procedure target the live `entry`
+/// compiles, at the offsets of the definition's own lowering.
+fn with_live_body(
+    mut proc: Procedure,
+    registry: &CommandRegistry,
+    config: LexerConfig,
+    profile: Option<&'static tcl_dialect::DialectProfile>,
+    entry: &tcl_runtime_api::NativeCompilationEntry,
+) -> Option<Procedure> {
+    let source = proc.body_source.clone()?;
+    let mut entry = entry.clone();
+    entry.compiled_local_layout = None;
+    let entry = &entry;
+    let (holder, _) = tcl_syntax::naming::key_holder_and_tail(&proc.qualified_name);
+    let namespace = tcl_syntax::naming::unroot_rooted_key(holder)?;
+    let mut live = tcl_compiler::lowering::lower_procedure_target_module_for_bytecode_with_options(
+        tcl_runtime_api::ProcedureCompileTarget {
+            source: &source,
+            parameters: &proc.params,
+            namespace,
+        },
+        registry,
+        config,
+        profile,
+        false,
+        Some(tcl_compiler::command_binding::native_entry_options(entry)),
+    );
+    let mut body = std::mem::take(&mut live.top_level);
+    tcl_compiler::lattice_rebase::rebase_script(&mut body, i64::from(proc.body_offset));
+    if std::env::var_os("REFDBG").is_some() { eprintln!("REFDBG live ns={:?} sim ns={:?}\nLIVE {:?}\nSIM {:?}", body.namespace_context, proc.body.namespace_context, body.statements, proc.body.statements); }
+    body.namespace_context = proc.body.namespace_context.take();
+    proc.body = body;
+    Some(proc)
+}
