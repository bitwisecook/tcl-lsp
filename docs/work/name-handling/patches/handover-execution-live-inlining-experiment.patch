+/// The candidates of a module lowered under a live runtime entry, which has no
+/// catalogue metadata: each call whose proved execution target the registry
+/// describes, reached with exactly its written words.
+fn live_called_descriptors(
+    module: &Module,
+    registry: &CommandRegistry,
+) -> HashMap<String, Vec<SiteKey>> {
+    let mut labels: HashMap<String, Vec<SiteKey>> = HashMap::new();
+    if module.source_entry.native_entry.is_none() {
+        return labels;
+    }
+    let mut note = |statement: &Statement| {
+        if !matches!(statement, Statement::Call { .. }) {
+            return;
+        }
+        let Some(tokens) = statement.tokens() else {
+            return;
+        };
+        let Some(target) = tokens
+            .source_binding
+            .as_ref()
+            .and_then(tcl_compiler::command_binding::SourceInvocationBinding::proved_execution_target)
+        else {
+            return;
+        };
+        if !target.prepended.is_empty() {
+            return;
+        }
+        let (Some(spec), Some(site)) = (registry.get(&target.command), site_key(tokens)) else {
+            return;
+        };
+        labels.entry(spec.name.to_owned()).or_default().push(site);
+    };
+    tcl_compiler::ir::for_each_statement(&module.top_level, &mut note);
+    for proc in module.procedures.values() {
+        tcl_compiler::ir::for_each_statement(&proc.body, &mut note);
+    }
+    labels
+}
