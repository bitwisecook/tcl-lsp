+    /// Rerun the isolated body's original issuers against the document realm,
+    /// at the body's real offsets and in the shell's scope tree.
+    fn replay_body_issuers(&mut self, db: &DeferredBody, frag: &mut BodyFragment, delta: u32) {
+        let shell_path = |path: &[usize]| -> Option<Vec<usize>> {
+            let rest = path.strip_prefix(frag.proc_path.as_slice())?;
+            Some(db.scope_path.iter().chain(rest).copied().collect())
+        };
+        let shift_tokens = |tokens: Vec<tcl_lexer::Token>| -> Vec<tcl_lexer::Token> {
+            tokens
+                .into_iter()
+                .map(|mut token| {
+                    token.span = super::rebase::shift(token.span, delta);
+                    token
+                })
+                .collect()
+        };
+        for replay in std::mem::take(&mut frag.issuer_replays) {
+            match replay {
+                super::IssuerReplay::CommandPrologue { tokens, scope_path } => {
+                    let Some(scope_path) = shell_path(&scope_path) else {
+                        continue;
+                    };
+                    let tokens = shift_tokens(tokens);
+                    let Some((head, arguments)) = tokens.split_first() else {
+                        continue;
+                    };
+                    self.retain_original_static_source_names(&tokens);
+                    self.record_original_scoped_body_advice(
+                        head.span.start(),
+                        arguments,
+                        &scope_path,
+                    );
+                }
+                super::IssuerReplay::VariableReceivers {
+                    offset,
+                    argument_tokens,
+                    scope_path,
+                    body_depth,
+                } => {
+                    let Some(scope_path) = shell_path(&scope_path) else {
+                        continue;
+                    };
+                    let shell_depth = std::mem::replace(&mut self.body_depth, body_depth);
+                    self.record_original_variable_receivers(
+                        offset + delta,
+                        &shift_tokens(argument_tokens),
+                        &scope_path,
+                    );
+                    self.body_depth = shell_depth;
+                }
+            }
+        }
+    }
