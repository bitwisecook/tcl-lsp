+
+#[test]
+fn zz_probe_owner_diff() {
+    let sources = [
+        "proc a {} { set x 11111 }\nproc b {} { set y 22222 }\n",
+        "proc a {} { set x 1; puts $x }\n",
+        "proc a {} { b 1 }\nproc b {x} { return $x }\n",
+        "namespace eval ns { proc a {} { set x [string length abc]; return $x } }\n",
+        "oo::class create C { method m {} { set x 1; return $x } }\n",
+        "proc a {} { lsort -command cb {3 1 2} }\nproc cb {l r} { return 0 }\n",
+        "proc a {} { foreach i {1 2} { if {$i} { puts $i } } }\n",
+    ];
+    for src in sources {
+        for d in ["tcl8.6"] {
+            let mut a = Analyser::new();
+            let got = a.analyse_per_item(src, d);
+            let want = Analyser::new().analyse(src, d);
+            eprintln!("=== {src:?} gate={:?} eq={}", a.per_item_fallback, got == want);
+            if got != want {
+                let mut gk: Vec<_> = got.original_conditional_registry_metadata.iter().map(|(k, v)| (*k, v.is_some())).collect();
+                let mut wk: Vec<_> = want.original_conditional_registry_metadata.iter().map(|(k, v)| (*k, v.is_some())).collect();
+                gk.sort(); wk.sort();
+                eprintln!("CRM got={gk:?} want={wk:?}");
+                eprintln!("VSYM got={:?} want={:?}", got.original_variable_symbols.iter().map(|s| s.span()).collect::<Vec<_>>(), want.original_variable_symbols.iter().map(|s| s.span()).collect::<Vec<_>>());
+                if std::env::var_os("PROBE_FULLDIFF").is_some() { eprintln!("{}", got.bounded_mismatch_summary(&want)); }
+            }
+        }
+    }
+}
