+/// Open an iRule and return the diagnostics the server published for `code`.
+/// A quick fix answers only for a diagnostic the server issued for the
+/// current document, so the tests hand back what was published.
+fn open_irule_with(lsp: &mut Lsp, source: &str, code: &str) -> (String, Vec<Value>) {
+    let uri = unique_uri("irule");
+    let published = lsp
+        .open_ready_lang(&uri, source, "tcl-irule")
+        .into_iter()
+        .filter(|d| d.get("code").and_then(Value::as_str) == Some(code))
+        .collect::<Vec<_>>();
+    assert!(!published.is_empty(), "no {code} published for {source:?}");
+    (uri, published)
+}
