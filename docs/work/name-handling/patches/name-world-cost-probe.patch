+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::fmt::Write;
+use std::hint::black_box;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering::Relaxed};
+use std::time::Instant;
+use tcl_compiler::analyser::{Analyser, ResolvedAnalysisInput};
+use tcl_compiler::command_binding::{
+    item92_clear_source_cache, item92_omit_point_states, item92_point_work,
+};
+use tcl_registry::CommandRegistry;
+
+struct CountingAllocator;
+
+static TRACK: AtomicBool = AtomicBool::new(false);
+static LIVE: AtomicUsize = AtomicUsize::new(0);
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+// The allocator forwards the same layouts and pointers to System. Each
+// measured process enables counting before constructing its inputs.
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() && TRACK.load(Relaxed) {
+            LIVE.fetch_add(layout.size(), Relaxed);
+        }
+        ptr
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        if !ptr.is_null() && TRACK.load(Relaxed) {
+            LIVE.fetch_add(layout.size(), Relaxed);
+        }
+        ptr
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        let new_ptr = unsafe { System.realloc(ptr, layout, new_size) };
+        if !new_ptr.is_null() && TRACK.load(Relaxed) {
+            LIVE.fetch_add(new_size.wrapping_sub(layout.size()), Relaxed);
+        }
+        new_ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        if TRACK.load(Relaxed) {
+            LIVE.fetch_sub(layout.size(), Relaxed);
+        }
+        unsafe { System.dealloc(ptr, layout) }
+    }
+}
+
+fn heap() -> usize {
+    LIVE.load(Relaxed)
+}
+
+fn generated(n: usize) -> String {
+    let mut script = String::from("namespace eval ::bench {\n    variable counter 0\n}\n\n");
+    for i in 0..n {
+        write!(
+            script,
+            "# proc number {i}\nproc ::bench::step{i} {{a b}} {{\n    set v{i} [expr {{$a + $b}}]\n    set msg \"step {i} = $v{i}\"\n    if {{$v{i} > 10}} {{\n        set v{i} [expr {{$v{i} + 1}}]\n    }}\n    return $v{i}\n}}\n\n"
+        )
+        .unwrap();
+    }
+    script
+}
+
+fn main() {
+    // Library/runtime setup may have allocated before main. All results are
+    // differences between readings after warm-up, so that startup cancels.
+    TRACK.store(true, Relaxed);
+    let mut args = std::env::args().skip(1);
+    let mode = args.next().unwrap();
+    let workload = args.next().unwrap();
+    let memory = mode.ends_with("memory");
+    if !memory {
+        TRACK.store(false, Relaxed);
+    }
+    let source = if let Ok(n) = workload.parse() {
+        generated(n)
+    } else {
+        let source = std::fs::read_to_string(&workload).unwrap();
+        assert_eq!(source.lines().count(), 687);
+        source
+    };
+    assert!(args.next().is_none());
+    let dialect = if workload.parse::<usize>().is_ok() {
+        "tcl8.6"
+    } else {
+        "tcl9.0"
+    };
+    let profile = tcl_registry::model::ingress::resolve_environment(dialect).analyser_profile();
+    let registry = CommandRegistry::build_default().project_for_profile(profile);
+    let context = tcl_registry::model::context_for_profile(profile);
+    let context = Arc::new(context.with_command_store(registry.snapshot().shared_registry()));
+    let input = ResolvedAnalysisInput::new(
+        profile,
+        profile,
+        context,
+        tcl_lexer::LexerConfig::for_file_grammar(profile.grammar),
+    );
+    let structure = std::env::var_os("ITEM92_STRUCTURE").is_some();
+    let analyse = |source: &str| {
+        let mut analyser = if dialect == "tcl9.0" {
+            Analyser::new()
+        } else {
+            Analyser::new().with_resolved_input(input.clone())
+        };
+        if structure {
+            analyser.structure_only().analyse(source, dialect)
+        } else {
+            analyser.analyse(source, dialect)
+        }
+    };
+    drop(analyse("set init 1\n"));
+    item92_clear_source_cache();
+    let _ = item92_point_work();
+    if mode.starts_with("without") {
+        item92_omit_point_states();
+    }
+    let before = heap();
+    let start = Instant::now();
+    let result = analyse(&source);
+    let elapsed = start.elapsed();
+    let (clones, joins, direct_ns) = item92_point_work();
+    let diagnostics = result.diagnostics.len();
+    if mode != "memory" && memory {
+        item92_clear_source_cache();
+        println!(
+            "RESULT {workload} lines={} mode={mode} diag={diagnostics} retained_result={}",
+            source.lines().count(),
+            heap().wrapping_sub(before)
+        );
+    } else if memory {
+        item92_clear_source_cache();
+        let retained_result = heap().wrapping_sub(before);
+        let mut bindings = result
+            .retained_command_realm()
+            .unwrap()
+            .source_bindings_ref()
+            .clone();
+        drop(result);
+        item92_clear_source_cache();
+        let (count, inline, heap_before, heap_after, shared) =
+            bindings.item92_strip_point_states(heap);
+        assert!(count > 0);
+        println!(
+            "RESULT {workload} lines={} mode={mode} diag={diagnostics} points={count} inline={inline} shared={shared} retained_result={retained_result} retained_with={} retained_without={} heap_delta={}",
+            source.lines().count(),
+            heap_before.wrapping_sub(before),
+            heap_after.wrapping_sub(before) - inline,
+            heap_before.wrapping_sub(heap_after)
+        );
+        black_box(bindings);
+        return;
+    } else {
+        println!(
+            "RESULT {workload} lines={} mode={mode} diag={diagnostics} clones={clones} joins={joins} full_ns={} direct_ns={direct_ns}",
+            source.lines().count(),
+            elapsed.as_nanos(),
+        );
+    }
+    if std::env::var_os("ITEM92_DIAGNOSTICS").is_some() {
+        eprintln!("{:?}", result.diagnostics);
+    }
+    black_box(result);
+}
