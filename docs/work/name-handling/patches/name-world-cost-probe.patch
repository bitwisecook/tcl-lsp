index 0000000000..f7483f5b0c
--- /dev/null
+++ b/.probe-92/link.py
@@ -0,0 +1,28 @@
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+deps = {}
+directories = set()
+for line in Path(sys.argv[1] if len(sys.argv) > 1 else ".probe-92/build.jsonl").read_text().splitlines():
+    if not line.startswith("{"):
+        continue
+    event = json.loads(line)
+    if event["reason"] != "compiler-artifact":
+        continue
+    name = event["target"]["name"]
+    files = [Path(path) for path in event["filenames"]]
+    directories.update(path.parent for path in files if path.suffix in {".rlib", ".so"})
+    rlibs = [path for path in files if path.suffix == ".rlib"]
+    if rlibs:
+        deps[name] = max(rlibs, key=lambda path: len(path.parts))
+
+args = ["rustc", "--edition", "2024", "-C", "opt-level=1", "-C", "link-arg=-fuse-ld=lld"]
+for directory in sorted(directories):
+    args.extend(["-L", f"dependency={directory}"])
+for name in ("tcl_compiler", "tcl_registry", "tcl_lexer"):
+    args.extend(["--extern", f"{name}={deps[name]}"])
+
+output = sys.argv[2] if len(sys.argv) > 2 else ".probe-92/run"
+subprocess.run([*args, ".probe-92/driver.rs", "-o", output], check=True)
