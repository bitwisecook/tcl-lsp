+++ b/rust/tcl-compiler/src/command_binding.rs
@@ -1873,3 +1873,127 @@ mod standalone_document_layout_tests;

 #[cfg(test)]
 mod compiled_range_selection_tests;
+
+thread_local! {
+    static ITEM92_EMPTY_POINT: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    static ITEM92_EMPTY_WORLD: ModuleCommandBindings = ModuleCommandBindings::default();
+    static ITEM92_POINT_WORK: std::cell::Cell<(u64, u64, u128)> = const {
+        std::cell::Cell::new((0, 0, 0))
+    };
+}
+
+/// Disable point-world capture for the timing control.
+pub fn item92_omit_point_states() {
+    ITEM92_EMPTY_WORLD.with(|_| {});
+    ITEM92_EMPTY_POINT.with(|enabled| enabled.set(true));
+}
+
+/// Return and reset the timing counters for point-world capture.
+pub fn item92_point_work() -> (u64, u64, u128) {
+    ITEM92_POINT_WORK.with(|work| work.replace((0, 0, 0)))
+}
+
+/// Release source analysis memos before measuring retained state.
+pub fn item92_clear_source_cache() {
+    source_analysis_cache::item92_clear();
+}
+
+impl ModuleCommandBindings {
+    fn item92_point_clone(&self) -> Self {
+        let start = std::time::Instant::now();
+        let value = if ITEM92_EMPTY_POINT.with(std::cell::Cell::get) {
+            ITEM92_EMPTY_WORLD.with(|empty| Self {
+                current_source_origin: self.current_source_origin.clone(),
+                variable_frame: self.variable_frame.clone(),
+                baseline: self.baseline.clone(),
+                ..empty.clone()
+            })
+        } else {
+            self.clone()
+        };
+        let ns = start.elapsed().as_nanos();
+        ITEM92_POINT_WORK.with(|work| {
+            let (clones, joins, time) = work.get();
+            work.set((clones + 1, joins, time + ns));
+        });
+        value
+    }
+
+    fn item92_point_join(&mut self, other: &Self) {
+        let start = std::time::Instant::now();
+        if !ITEM92_EMPTY_POINT.with(std::cell::Cell::get) {
+            self.join(other);
+        }
+        let ns = start.elapsed().as_nanos();
+        ITEM92_POINT_WORK.with(|work| {
+            let (clones, joins, time) = work.get();
+            work.set((clones, joins + 1, time + ns));
+        });
+    }
+}
+
+impl SourceCommandBindings {
+    /// Remove measured state from this temporary probe's retained source realm.
+    pub fn item92_strip_point_states(
+        &mut self,
+        meter: impl Fn() -> usize,
+    ) -> (usize, usize, usize, usize, usize) {
+        let empty = ModuleCommandBindings::default();
+        let clone_before = meter();
+        let cloned = empty.clone();
+        assert_eq!(meter(), clone_before, "replacement allocated extra heap");
+        drop(cloned);
+
+        let before = meter();
+        let mut count = 0;
+        let mut capacity = 0;
+        let mut shared = 0;
+        self.item92_strip(&empty, &mut count, &mut capacity, &mut shared);
+        let after = meter();
+        (count, capacity * size_of::<ModuleCommandBindings>(), before, after, shared)
+    }
+
+    fn item92_strip(
+        &mut self,
+        empty: &ModuleCommandBindings,
+        count: &mut usize,
+        capacity: &mut usize,
+        shared: &mut usize,
+    ) {
+        fn unique<T>(inventory: &SharedSourceInventory<T>, shared: &mut usize) -> bool {
+            let unique = Arc::strong_count(&inventory.shared()) == 2;
+            *shared += usize::from(!unique);
+            unique
+        }
+        if !self.points.is_empty() && unique(&self.points, shared) {
+            *capacity += self.points.capacity();
+            *count += self.points.len();
+            for point in self.points.iter_mut() {
+                point.state = empty.clone();
+            }
+        }
+        if !self.origin_points.is_empty() && unique(&self.origin_points, shared) {
+            for points in self.origin_points.values_mut() {
+                *capacity += points.capacity();
+                *count += points.len();
+                for point in points {
+                    point.state = empty.clone();
+                }
+            }
+        }
+        if !self.phases.is_empty() && unique(&self.phases, shared) {
+            *capacity += self.phases.capacity();
+            *count += self.phases.len();
+            for phase in self.phases.iter_mut() {
+                phase.point.state = empty.clone();
+            }
+        }
+        if let Some(walk) = &mut self.declared_frame_walk {
+            if Arc::strong_count(walk) == 1 {
+                Arc::make_mut(walk).item92_strip(empty, count, capacity, shared);
+            } else {
+                *shared += 1;
+            }
+        }
+    }
+}
