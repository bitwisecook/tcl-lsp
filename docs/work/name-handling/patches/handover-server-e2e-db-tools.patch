+++ b/tmp/server-e2e-db-tools/classify.py
@@ -0,0 +1,7 @@
+import re, sys
+log = open(sys.argv[1], errors='replace').read()
+out = {}
+for m in re.finditer(r"thread '([^']+)' \(\d+\) (panicked at .*?)(?=\n\s+note: run with|\n\s+(?:FAIL|TIMEOUT) \[)", log, re.S):
+    out.setdefault(m.group(1), ' '.join(m.group(2).split())[:int(sys.argv[2])])
+for k in sorted(out):
+    print(k, '||', out[k].replace('panicked at rust/tcl-lsp-server/tests/e2e/', ''))
diff --git a/tmp/server-e2e-db-tools/body.py b/tmp/server-e2e-db-tools/body.py
new file mode 100644
index 00000000..a999350b
--- /dev/null
+++ b/tmp/server-e2e-db-tools/body.py
@@ -0,0 +1,13 @@
+import sys,re,os
+# usage: body.py module::test ...  -> prints function bodies (comments stripped)
+root='/home/user/tcl-lsp/rust/tcl-lsp-server/tests/e2e/'
+for t in sys.argv[1:]:
+    parts=t.split('::'); mod=parts[0]; fn=parts[-1]
+    path=root+mod+'.rs'
+    if len(parts)>2 and os.path.exists(root+mod+'/'+parts[1]+'.rs'): path=root+mod+'/'+parts[1]+'.rs'
+    s=open(path).read()
+    m=re.search(r'\nfn '+re.escape(fn)+r'\(\)[^{]*\{\n(.*?)\n\}\n', s, re.S)
+    print('=== '+t)
+    if m:
+        body='\n'.join(l for l in m.group(1).split('\n') if not l.strip().startswith('//'))
+        print(body[:int(os.environ.get('MAXB','900'))])
