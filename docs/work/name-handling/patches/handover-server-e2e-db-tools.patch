+#!/bin/bash
+# usage: e2e.sh '<nextest filter expr body>' [extra args]
+cd /home/user/tcl-lsp
+source scripts/dev/agent-build-env.sh; export CARGO_BUILD_JOBS=2 CARGO_PROFILE_TEST_OPT_LEVEL=1 RUST_BACKTRACE=0
+F=$1; shift
+cargo nextest run -p tcl-compiler -p tcl-irules -p tcl-lsp-core -p tcl-lsp-server --test e2e -E "package(tcl-lsp-server) and ($F)" --no-fail-fast --status-level fail --final-status-level none --failure-output final "$@" 2>&1 | grep -vE '^\s*$|running 1 test|^\s+failures:|test result|RUST_BACKTRACE|stdout ───|stderr ───|FAILED$' | cut -c1-${COLS:-900}
