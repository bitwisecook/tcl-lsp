+/// The complete lowering inputs of one document build, by value.
+#[salsa::interned]
+pub struct ModuleLoweringKey<'db> {
+    #[returns(ref)]
+    pub inputs: tcl_compiler::compilation_unit::ModuleLoweringInputs,
+}
+
+/// One document's lowered module, shared by every build with equal lowering
+/// inputs, so an unchanged document rebuilt under a revisited configuration
+/// keeps its procedure identities and source proofs and every lattice key
+/// built from them recurs (#2543). `None` when lowering reported a body-cache
+/// integrity failure; the build then lowers for itself.
+// LRU-capped: per-file key, see the crate docs' "Deep-memo eviction".
+#[salsa::tracked(lru = 64, returns(clone))]
+pub fn lowered_module<'db>(
+    db: &'db dyn TclDb,
+    key: ModuleLoweringKey<'db>,
+) -> Option<Arc<tcl_compiler::compilation_unit::LoweredModule>> {
+    let inputs = key.inputs(db);
+    let (body_memo, source_body_memo) = lowering_body_memos(
+        db,
+        inputs.dialect(),
+        inputs.registry(),
+        inputs.config().normalized(),
+    );
+    tcl_compiler::compilation_unit::LoweredModule::lower(inputs, &body_memo, &source_body_memo)
+        .map(Arc::new)
+}
