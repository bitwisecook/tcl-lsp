+            std::fs::write(root.join("root.tcl"), &parent_text).expect("physical parent");
+            std::fs::write(root.join("shared.tcl"), CHILD).expect("physical child");
+            Self {
+                parent: uri(&root.join("root.tcl")),
+                child: uri(&root.join("shared.tcl")),
