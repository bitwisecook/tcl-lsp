+            .is_none()
+        );
+        let mut changed = tokens.clone();
+        changed.argv_texts[1] = "-exact".to_owned();
+        assert!(
+            logical_structured_invocation_with_metadata_context(registry, context, &changed, None)
+                .is_none()
+        );
+        changed = tokens.clone();
+        changed.source_binding = None;
+        assert!(
+            logical_structured_invocation_with_metadata_context(registry, context, &changed, None)
