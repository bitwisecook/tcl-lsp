+            changed.body_lexer_config = None;
+            assert!(!cut.matches_parent_analysis(&changed));
+            changed = parent.clone();
+            changed.resolved_input = None;
+            assert!(!cut.matches_parent_analysis(&changed));
+            assert_eq!(
+                load.frontier(&parent),
+                OriginalProjectSourceFrontier::CurrentCut(cut)
