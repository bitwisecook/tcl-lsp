+
+    fn allocated_empty_body(module: &crate::ir::Module) -> ReportBodyOwner {
+        let (&id, _) = module
+            .original_declaration_body_units
+            .iter()
+            .find(|(id, _)| {
+                module
+                    .body_units
+                    .get(id)
+                    .is_some_and(|body| body.span.is_empty())
+            })
+            .expect("actual allocated empty declaration");
+        ReportBodyInventory::procedure(
+            module,
+            id,
+            module.body_units.get(&id).unwrap(),
+            ReportBodyRole::Unit(ProcedureBodyKind::OriginalDeclaration),
+        )
+        .unwrap()
+    }
+
+    #[test]
+    fn empty_allocated_body_requires_the_current_complete_source_card() {
+        let left = allocated_empty();
+        let right = allocated_empty();
+        assert_eq!(
+            left.compare(&right),
+            super::super::AnalysisReportComparison::Equal
+        );
+        let module = &left
+            .current_capture()
+            .unwrap()
+            .bodies
+            .prepared
+            .unit()
+            .ir_module;
+        let registry = left.analysis.resolved_registry().unwrap();
+        let body = allocated_empty_body(module);
+        let id = body.id;
+        assert!(
+            body.declaration_purpose == Some(ReportDeclarationPurpose::Allocated),
+            "actual allocated declaration purpose"
+        );
+        assert!(
+            ReportBodyInventory::empty_allocated_declaration_body(module, registry, id, &body)
+                .is_some()
+        );
+        let mut missing = module.clone();
+        missing.original_declaration_body_units.remove(&id);
+        assert!(
+            ReportBodyInventory::empty_allocated_declaration_body(&missing, registry, id, &body)
+                .is_none()
+        );
+        let mut no_owner = module.clone();
+        no_owner.retained_source_bindings = None;
+        assert!(
+            ReportBodyInventory::empty_allocated_declaration_body(&no_owner, registry, id, &body)
+                .is_none()
+        );
+        let foreign = &right
+            .current_capture()
+            .unwrap()
+            .bodies
+            .prepared
+            .unit()
+            .ir_module;
+        assert!(
+            ReportBodyInventory::empty_allocated_declaration_body(foreign, registry, id, &body)
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn empty_allocated_body_rejects_wrong_roles_geometry_and_duplicates() {
+        let report = allocated_empty();
+        let module = &report
+            .current_capture()
+            .unwrap()
+            .bodies
+            .prepared
+            .unit()
+            .ir_module;
+        let registry = report.analysis.resolved_registry().unwrap();
+        let body = allocated_empty_body(module);
+        let id = body.id;
+        let mut wrong_role = allocated_empty_body(module);
+        wrong_role.role = ReportBodyRole::Unit(ProcedureBodyKind::Installed);
+        assert!(
+            ReportBodyInventory::empty_allocated_declaration_body(
+                module,
+                registry,
+                id,
+                &wrong_role
+            )
+            .is_none()
+        );
+        let mut wrong_purpose = allocated_empty_body(module);
+        wrong_purpose.declaration_purpose = Some(ReportDeclarationPurpose::Native);
+        assert!(
+            ReportBodyInventory::empty_allocated_declaration_body(
+                module,
+                registry,
+                id,
+                &wrong_purpose
+            )
+            .is_none()
+        );
+        let mut wrong_span = allocated_empty_body(module);
+        wrong_span.declaration = Span::empty(0);
+        assert!(
+            ReportBodyInventory::empty_allocated_declaration_body(
+                module,
+                registry,
+                id,
+                &wrong_span
+            )
+            .is_none()
+        );
+        let mut changed = module.clone();
+        changed.body_units.get_mut(&id).unwrap().body_offset += 1;
+        assert!(
+            ReportBodyInventory::empty_allocated_declaration_body(
+                &changed,
+                registry,
+                id,
+                &allocated_empty_body(&changed)
+            )
+            .is_none()
+        );
+        let mut out_of_range = allocated_empty_body(module);
+        out_of_range.declaration =
+            Span::empty(u32::try_from(module.source.bytes().len() + 1).unwrap());
+        assert!(
+            ReportBodyInventory::push(&mut Vec::new(), module, registry, id, out_of_range)
+                .is_none()
+        );
+        let mut bodies = Vec::new();
+        assert!(
+            ReportBodyInventory::push(
+                &mut bodies,
+                module,
+                registry,
+                id,
+                allocated_empty_body(module)
+            )
+            .is_some()
+        );
+        assert!(
+            ReportBodyInventory::push(
+                &mut bodies,
+                module,
+                registry,
+                id,
+                allocated_empty_body(module)
+            )
+            .is_none()
+        );
+        assert_eq!(bodies.len(), 1);
+    }
