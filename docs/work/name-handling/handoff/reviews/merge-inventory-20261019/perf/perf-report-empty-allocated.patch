+    fn allocated_empty() -> super::super::AuthenticatedAnalysisReport {
+        let source = r"proc fib {n} {
+    if {$n < 2} { return $n }
+    return [expr {[fib [expr {$n - 1}]] + [fib [expr {$n - 2}]]}]
