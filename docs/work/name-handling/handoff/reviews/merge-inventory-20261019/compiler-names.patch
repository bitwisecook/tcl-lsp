+                "if {0} {} elseif {1} {my ping $k}",
+                "if {0} {} else {my ping $k}",
+                "set i 0; while {$i < 1} {incr i; my ping $k}",
+                "for {set i 0} {$i < 1} {incr i} {my ping $k}",
+                "foreach i {1} {my ping $k}",
+                "catch {my ping $k}",
+                "try {my ping $k} finally {}",
+                "eval {my ping $k}",
