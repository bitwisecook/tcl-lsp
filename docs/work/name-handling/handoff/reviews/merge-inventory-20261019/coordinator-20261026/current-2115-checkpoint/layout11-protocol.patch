+          test "$GITHUB_SHA" = "$EXPECTED_WORK_SHA"
+          make ensure-tcl-deps
+          bash scripts/dev/ensure-jim-oracle.sh
+          . scripts/dev/tcl-reference-toolchains.sh
+          tcl_reference_load_toolchains "$PWD"
+          for release in $(tcl_reference_releases); do
+            reference="$(tcl_reference_resolve_tclsh "$release")"
