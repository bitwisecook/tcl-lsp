+        assert!(!analysis.allows_lexical_declaration_advice());
+        let result =
+            super::minify_with_analysis(source, &analysis, super::MinifyOptions::default());
+        assert_eq!(
+            result.source,
+            "switch -regexp $x {{^a} {puts 1} default {puts 2}}"
+        );
+        for (source, retained_container) in [
+            (
+                "list {\n  {^a} {puts 1}\n  default {puts 2}\n}",
+                "{\n  {^a} {puts 1}\n  default {puts 2}\n}",
+            ),
+            ("switch -- x {\n a\n}", "{\n a\n}"),
+            (
+                "proc switch args {return $args};switch -regexp $x {\n  {^a} {puts 1}\n  default {puts 2}\n}",
