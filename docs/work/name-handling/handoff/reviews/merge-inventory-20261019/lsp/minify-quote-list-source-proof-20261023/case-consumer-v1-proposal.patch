+            (
+                "trace add execution switch enter callback;switch -regexp $x {\n  {^a} {puts 1}\n  default {puts 2}\n}",
+                "{\n  {^a} {puts 1}\n  default {puts 2}\n}",
+            ),
+            (
+                "choose -regexp $x {\n  {^a} {puts 1}\n  default {puts 2}\n}",
+                "{\n  {^a} {puts 1}\n  default {puts 2}\n}",
+            ),
+            (
+                "switch -regexp $x {*}{\n  {^a} {puts 1}\n  default {puts 2}\n}",
+                "{\n  {^a} {puts 1}\n  default {puts 2}\n}",
+            ),
+        ] {
+            let analysis = super::analysis_for_profile(source, profile, &registry);
+            let result =
+                super::minify_with_analysis(source, &analysis, super::MinifyOptions::default());
+            assert!(
+                result.source.contains(retained_container),
+                "{source} -> {}",
+                result.source
+            );
+        }
+    }
