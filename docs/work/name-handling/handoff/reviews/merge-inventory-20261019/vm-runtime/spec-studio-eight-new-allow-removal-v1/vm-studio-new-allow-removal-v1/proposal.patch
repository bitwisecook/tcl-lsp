+            let prefixes = hint.get("prefixes")?.as_array()?;
+            if !values.iter().all(Value::is_string)
+                || !prefixes
+                    .iter()
+                    .all(|value| value.as_str().is_some_and(|prefix| !prefix.is_empty()))
+            {
+                return None;
+            }
+            format!(
+                "Some(crate::definer::BareWordConstructionSourceHint {{ values: {}, prefixes: {} }})",
+                str_slice(values),
+                str_slice(prefixes)
+            )
