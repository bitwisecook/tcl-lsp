     permissions:
@@ -602,3 +602,167 @@
           path: ${{ runner.temp }}/runtime-fulltom-output
           if-no-files-found: error
           retention-days: 30
+
+  # Temporary WORK-only census; final strict all-packages gate remains required.
+  scoped-lsp-clippy-diagnostics:
+    if: github.event_name == 'workflow_dispatch' && inputs.mode == 'scoped-lsp-clippy-diagnostics' && github.ref == 'refs/heads/work'
+    runs-on: ubuntu-26.04
+    timeout-minutes: 60
+    permissions:
+      contents: read
+    env:
+      CARGO_INCREMENTAL: "0"
+      CARGO_PROFILE_DEV_DEBUG: "0"
+      CARGO_BUILD_JOBS: "2"
+      CARGO_TERM_COLOR: never
+      RUST_BACKTRACE: short
+    steps:
+      - name: Checkout exact work revision
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ inputs.runtime_sha }}
+          fetch-depth: 1
+          persist-credentials: false
+      - name: Install Rust and Clippy
+        uses: actions-rust-lang/setup-rust-toolchain@ecabd13d1c56bd1345c230e542e9144811ad706f # v2.0.0
+        with:
+          toolchain: stable
+          components: clippy
+          build-warnings: deny
+          cache: false
+      - name: Validate revision and record source and tools
+        env:
+          EXPECTED_WORK_SHA: ${{ inputs.runtime_sha }}
+          OUT: ${{ runner.temp }}/scoped-lsp-clippy-output
+        run: |
+          set -euo pipefail
+          mkdir "$OUT"
+          [[ "$EXPECTED_WORK_SHA" =~ ^[0-9a-fA-F]{40}$ ]]
+          test "$(git rev-parse HEAD)" = "${EXPECTED_WORK_SHA,,}"
+          test "${EXPECTED_WORK_SHA,,}" = "$GITHUB_SHA"
+          test -z "$(git status --porcelain)"
+          git rev-parse HEAD > "$OUT/source-commit.txt"
+          git status --porcelain > "$OUT/git-before.txt"
+          git ls-files -z | sort -z | xargs -0 sha256sum > "$OUT/tracked-source-before.sha256"
+          cargo --version > "$OUT/cargo-version.txt"
+          cargo clippy --version > "$OUT/clippy-version.txt"
+          rustc -vV > "$OUT/rustc-version.txt"
+          sha256sum "$(rustup which cargo)" "$(rustup which rustc)" "$(rustup which clippy-driver)" > "$OUT/tools.sha256"
+          printf '%s\n' '${{ github.run_id }}' '${{ github.run_attempt }}' '${{ runner.os }}' '${{ runner.arch }}' > "$OUT/job.txt"
+          printf '%s\n' 'DIAGNOSTIC ONLY: three independent scoped Clippy invocations after crate allows removal. No static estimate is a measured census. Final all-packages strict gate and complete allow audit remain required.' > "$OUT/coverage.txt"
+      - name: Capture all three strict scoped Clippy outcomes
+        env:
+          CARGO_TARGET_DIR: ${{ runner.temp }}/scoped-lsp-clippy-target
+          OUT: ${{ runner.temp }}/scoped-lsp-clippy-output
+        run: |
+          set -euo pipefail
+          test ! -e "$CARGO_TARGET_DIR"
+          set +e
+          python3 - <<'CAPTURE'
+          import json
+          import os
+          import shutil
+          import subprocess
+          import sys
+          import time
+          from pathlib import Path
+          from typing import TypedDict
+
+
+          class Outcome(TypedDict, total=False):
+              package: str
+              state: str
+              disk_before: dict[str, int]
+              disk_after: dict[str, int]
+              argv: list[str]
+              started: float
+              ended: float
+              pid: int
+              exit_code: int
+              log_truncated: bool
+
+
+          out = Path(os.environ["OUT"])
+          root = Path.cwd()
+          mounts = (root, Path(os.environ["RUNNER_TEMP"]))
+          packages = ("tcl-lsp-core", "tcl-lsp-db", "tcl-lsp-server")
+          rows: list[Outcome] = [
+              {"package": package, "state": "UNREACHED"} for package in packages
+          ]
+          remaining = 20 * 1024 * 1024
+          incomplete = False
+
+
+          def save() -> None:
+              (out / "outcomes.json").write_text(json.dumps(rows, indent=2) + "\n")
+
+
+          save()
+          for package, row in zip(packages, rows):
+              floor = {str(path): shutil.disk_usage(path).free for path in mounts}
+              row["disk_before"] = floor
+              if min(floor.values()) < 2 * 1024**3:
+                  row["state"] = "REFUSED_DISK_FLOOR"
+                  incomplete = True
+                  save()
+                  continue
+              argv = [
+                  "cargo",
+                  "clippy",
+                  "--locked",
+                  "--no-deps",
+                  "-p",
+                  package,
+                  "--all-targets",
+                  "--all-features",
+                  "--",
+                  "-Dwarnings",
+              ]
+              row.update(argv=argv, state="RUNNING", started=time.time())
+              save()
+              with (out / (package + ".log.txt")).open("wb") as log:
+                  process = subprocess.Popen(
+                      argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
+                  )
+                  row["pid"] = process.pid
+                  save()
+                  if process.stdout is None:
+                      raise RuntimeError("owned Cargo stdout pipe unavailable")
+                  truncated = False
+                  while data := process.stdout.read(65536):
+                      kept = data[:remaining]
+                      log.write(kept)
+                      sys.stdout.buffer.write(kept)
+                      sys.stdout.buffer.flush()
+                      remaining -= len(kept)
+                      truncated |= len(kept) != len(data)
+                  code = process.wait()
+              floor = {str(path): shutil.disk_usage(path).free for path in mounts}
+              row.update(
+                  state="CLOSED",
+                  exit_code=code,
+                  ended=time.time(),
+                  log_truncated=truncated,
+                  disk_after=floor,
+              )
+              incomplete |= truncated or code < 0 or min(floor.values()) < 2 * 1024**3
+              save()
+          (out / "capture-incomplete.txt").write_text(str(int(incomplete)) + "\n")
+          sys.exit(125 if incomplete else int(any(row.get("exit_code") != 0 for row in rows)))
+          CAPTURE
+          result=$?
+          set -e
+          printf '%s\n' "$result" > "$OUT/capture-exit.txt"
+          sha256sum -c "$OUT/tracked-source-before.sha256" > "$OUT/source-after.txt"
+          sha256sum -c "$OUT/tools.sha256" > "$OUT/tools-after.txt"
+          git status --porcelain > "$OUT/git-after.txt"
+          test ! -s "$OUT/git-after.txt"
+          exit "$result"
+      - name: Upload scoped Clippy diagnostic evidence
+        if: always()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: scoped-lsp-clippy-${{ inputs.runtime_sha }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/scoped-lsp-clippy-output
+          if-no-files-found: error
+          retention-days: 30
