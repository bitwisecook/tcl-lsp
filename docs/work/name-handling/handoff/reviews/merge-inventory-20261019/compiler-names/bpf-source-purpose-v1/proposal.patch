+#[cfg(test)]
+mod source_bpf_cfg_tests {
+    use super::*;
+
+    #[test]
+    fn checked_source_bpf_scope_preserves_selection_and_refuses_missing_or_foreign_owners() {
+        let registry = tcl_registry::model::ingress::static_context_for("bpf").commands();
+        let config = tcl_lexer::LexerConfig::for_profile(registry.profile());
+        let module =
+            crate::lowering::lower_to_ir_with_dialect("pass", registry, config, registry.profile());
+        let context = module.source_bpf_module_context(registry).unwrap();
+        let mut script = module.top_level.clone();
+        let Statement::Call {
+            args,
+            tokens: Some(tokens),
+            ..
+        } = &mut script.statements[0]
+        else {
+            panic!("actual source command");
+        };
+        assert!(tokens.install_source_bpf_command(
+            module.source.clone(),
+            Span::new(0, 4),
+            config,
+            tcl_lexer::SourceSegmentationPurpose::WholeInput,
+            args,
+            registry,
+        ));
+        let function = build_source_bpf_cfg_function("label", &script, &module, &context, registry)
+            .expect("actual selected source operation");
+        assert!(
+            function
+                .blocks
+                .values()
+                .flat_map(|block| &block.statements)
+                .all(|statement| {
+                    matches!(statement, Statement::Call { tokens: Some(tokens), .. }
+                if tokens.source_bpf_command.is_some() && tokens.synthetic.is_none())
+                })
+        );
+        let mut missing = script.clone();
+        let Statement::Call { tokens, .. } = &mut missing.statements[0] else {
+            unreachable!()
+        };
+        *tokens = None;
+        assert!(
+            build_source_bpf_cfg_function("label", &missing, &module, &context, registry).is_none()
+        );
+        let mut changed = module.clone();
+        changed.lexer_config.strict_quoting = !changed.lexer_config.strict_quoting;
+        assert!(
+            build_source_bpf_cfg_function("label", &script, &changed, &context, registry).is_none()
+        );
+        let mut changed = module.clone();
+        changed.source = tcl_lexer::SourceImage::native(module.source.bytes());
+        assert!(
+            build_source_bpf_cfg_function("label", &script, &changed, &context, registry).is_none()
+        );
+        let mut marker = script.clone();
+        marker
+            .statements
+            .push(Statement::unseen_call_marker(Span::empty(0)));
+        assert!(
+            build_source_bpf_cfg_function("label", &marker, &module, &context, registry).is_none()
+        );
+        assert!(
+            build_source_bpf_cfg_function(
+                "label",
+                &script,
+                &module,
+                &context,
+                &CommandRegistry::build_default()
+            )
+            .is_none()
+        );
+    }
+}
