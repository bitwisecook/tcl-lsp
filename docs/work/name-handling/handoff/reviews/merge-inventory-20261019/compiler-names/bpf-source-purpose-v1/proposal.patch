+/// Build a source-only closed BPF phase from its genuine current module.
+/// The private BPF phase issuer remains responsible for complete transformation
+/// coverage. This does not issue Tcl invocation, frame, or Native advice.
+#[must_use]
+pub fn build_source_bpf_cfg_function(
+    name: &str,
+    script: &Script,
+    module: &Module,
+    context: &crate::ir::SourceBpfModuleContext,
+    registry: &CommandRegistry,
+) -> Option<Function> {
+    if !context.matches_module(module, registry) {
+        return None;
+    }
+    let mut commands = Vec::new();
+    let mut pending = vec![script];
+    while let Some(script) = pending.pop() {
+        for statement in &script.statements {
+            match statement {
+                Statement::Call {
+                    args,
+                    tokens: Some(tokens),
+                    ..
+                }
+                | Statement::Barrier {
+                    args,
+                    tokens: Some(tokens),
+                    ..
+                } => {
+                    let receipt = tokens.source_bpf_command.as_ref()?;
+                    receipt.descriptor(tokens, args, registry)??.bpf_op?;
+                    if let Some(words) = receipt.original_words(tokens, args, registry)
+                        && words.iter().any(|word| word.image() != &module.source)
+                    {
+                        return None;
+                    }
+                    commands.push(receipt.clone());
+                }
+                Statement::If { .. } => {}
+                _ => return None,
+            }
+            pending.extend(statement.child_scripts());
+        }
+    }
+    let mut builder = CfgBuilder::new(false, registry)
+        .with_lexer_config(module.native_lexer_config())
+        .with_invocation_namespace(crate::ir::ExecutionNamespace::RuntimeSelected);
+    builder.source_bpf_commands = commands;
+    Some(builder.build_function(name, script))
+}
