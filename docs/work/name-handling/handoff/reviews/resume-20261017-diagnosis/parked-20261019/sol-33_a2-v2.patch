+    /// Work budget: a logical call request captures each declaration
+    /// document through its readonly owner and reads no database analysis.
+    #[tokio::test]
+    async fn logical_call_documents_read_no_database_analysis() {
+        let backend = crate::tests::test_backend();
+        let caller: Uri = "file:///tmp/selection-caller.tcl".parse().unwrap();
+        let target: Uri = "file:///tmp/selection-target.tcl".parse().unwrap();
+        register(&backend, &caller, "proc caller {} { helper }\n").await;
+        register(&backend, &target, "proc helper {} {}\n").await;
+        crate::reset_analysis_for_calls();
+        let documents = backend
+            .logical_call_documents(&caller)
+            .await
+            .unwrap()
+            .expect("both declaration documents are current");
+        assert_eq!(crate::analysis_for_calls(), 0);
+        let captured = documents
+            .iter()
+            .map(|document| document.uri.as_str().to_owned())
+            .collect::<Vec<_>>();
+        let declared = backend
+            .original_declaration_documents(&caller)
+            .await
+            .unwrap()
+            .into_iter()
+            .map(|(uri, _, _)| uri)
+            .collect::<Vec<_>>();
+        assert_eq!(captured, declared);
+        assert_eq!(
+            captured,
+            [caller.as_str().to_owned(), target.as_str().to_owned()]
+        );
+    }
