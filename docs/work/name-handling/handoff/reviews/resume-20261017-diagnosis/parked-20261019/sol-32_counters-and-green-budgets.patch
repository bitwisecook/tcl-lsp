+                use std::fmt::Write as _;
+                let _ = writeln!(source, "proc p{n} {{x}} {{return $x}}");
+                source
+            });
+            let before = crate::sccp::solve_count();
+            let _ = summaries(&source, "tcl8.6");
+            crate::sccp::solve_count() - before
+        };
+        let (two, four, eight) = (solves(2), solves(4), solves(8));
+        assert!(
+            two < four && four <= eight,
+            "added procedures are solved: 2, 4 and 8 procedures cost {two}, {four}, {eight}"
+        );
+        assert!(
+            (eight - four) * 10 <= (four - two) * 22,
+            "SCCP solves grew super-linearly: 2, 4 and 8 procedures cost {two}, {four}, {eight}"
+        );
+    }
