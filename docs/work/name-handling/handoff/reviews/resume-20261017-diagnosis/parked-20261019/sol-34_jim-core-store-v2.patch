+/// Heads only `jimsh` has, which no other shipped surface declares under the
+/// same name, so a store either resolves each to its jim row or not at all.
+const JIM_ONLY: &[&str] = &[
+    "local",
+    "upcall",
+    "stackdump",
+    "getref",
+    "setref",
+    "ref",
+    "finalize",
