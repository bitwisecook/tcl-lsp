+    supplied_input: Option<tcl_compiler::analyser::ResolvedAnalysisInput>,
+    structure_only: bool,
+}
+
+impl PartialEq for FreshDriverInputs {
+    fn eq(&self, other: &Self) -> bool {
+        // The published factory index is compared by allocation: an equal
+        // allocation is the same index, and a republished one is a miss.
+        let factories = match (
+            &self.workspace_class_factories,
+            &other.workspace_class_factories,
+        ) {
+            (Some(left), Some(right)) => Arc::ptr_eq(left, right),
+            (None, None) => true,
+            _ => false,
+        };
+        factories
+            && self.disabled == other.disabled
+            && self.non_ascii == other.non_ascii
+            && self.extra_commands == other.extra_commands
+            && self.pack_key == other.pack_key
+            && self.resource == other.resource
+            && self.file_path == other.file_path
+            && self.supplied_input == other.supplied_input
+            && self.structure_only == other.structure_only
+    }
+}
