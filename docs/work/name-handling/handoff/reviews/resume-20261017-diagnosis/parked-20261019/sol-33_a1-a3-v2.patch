+
+    fn key(text: &str) -> FreshAnalysisKey {
+        FreshAnalysisKey {
+            text: Arc::from(text),
+            dialect: "tcl8.6".to_owned(),
+            inputs: super::super::FreshDriverInputs::default(),
+            analyser_inputs_epoch: 0,
+            class_factory_generation: 0,
+            uri_generation: 0,
+            stub_names: BTreeSet::new(),
+            sidecars: SidecarStubFingerprint(Vec::new()),
+        }
+    }
+
+    fn slot(name: &str) -> Slot {
+        (
+            format!("file:///memo/{name}.tcl").parse().unwrap(),
+            ReadonlyAnalysisKind::Fresh,
+        )
+    }
+
+    fn analysis() -> Arc<AnalysisResult> {
+        Arc::new(AnalysisResult::default())
+    }
+
+    #[test]
+    fn closed_entries_are_evicted_least_recently_used_first() {
+        let memo = ReadonlyAnalysisMemo::new(ReadonlyAnalysisMemoLimits {
+            closed_entries: 2,
+            closed_bytes: usize::MAX,
+        });
+        memo.insert(slot("a"), key("a"), analysis());
+        memo.insert(slot("b"), key("b"), analysis());
+        assert!(memo.lookup(&slot("a"), &key("a")).is_some());
+        memo.insert(slot("c"), key("c"), analysis());
+        assert!(memo.lookup(&slot("a"), &key("a")).is_some());
+        assert!(memo.lookup(&slot("b"), &key("b")).is_none());
+        assert!(memo.lookup(&slot("c"), &key("c")).is_some());
+        assert_eq!(memo.retained().1, 2);
+    }
+
+    #[test]
+    fn closed_entries_are_bounded_by_estimated_bytes() {
+        let one = estimated_bytes("a");
+        let memo = ReadonlyAnalysisMemo::new(ReadonlyAnalysisMemoLimits {
+            closed_entries: usize::MAX,
+            closed_bytes: one * 2,
+        });
+        for name in ["a", "b", "c"] {
+            memo.insert(slot(name), key(name), analysis());
+        }
+        let (_, closed, bytes) = memo.retained();
+        assert_eq!(closed, 2);
+        assert!(bytes <= one * 2);
+        let large = "x".repeat(one * 2);
+        memo.insert(slot("large"), key(&large), analysis());
+        assert!(memo.lookup(&slot("large"), &key(&large)).is_none());
+    }
+
+    #[test]
+    fn the_open_set_selects_the_tier_and_close_demotes() {
+        let memo = ReadonlyAnalysisMemo::new(ReadonlyAnalysisMemoLimits {
+            closed_entries: 1,
+            closed_bytes: usize::MAX,
+        });
+        for name in ["a", "b", "c"] {
+            memo.promote(&slot(name).0);
+            memo.insert(slot(name), key(name), analysis());
+        }
+        assert_eq!(memo.retained().0, 3);
+        for name in ["a", "b"] {
+            memo.demote(&slot(name).0);
+        }
+        assert_eq!(memo.retained(), (1, 1, estimated_bytes("b")));
+        assert!(memo.lookup(&slot("a"), &key("a")).is_none());
+        assert!(memo.lookup(&slot("b"), &key("b")).is_some());
+        // A run that started while `a` was open and finishes after its close
+        // joins the bounded tier.
+        memo.insert(slot("a"), key("a"), analysis());
+        assert_eq!(memo.retained(), (1, 1, estimated_bytes("a")));
+        memo.promote(&slot("a").0);
+        assert_eq!(memo.retained(), (2, 0, 0));
+        memo.forget(&[slot("a").0, slot("c").0]);
+        assert_eq!(memo.retained(), (0, 0, 0));
+    }
+
+    #[test]
+    fn any_changed_input_is_a_miss_and_replaces_the_slot() {
+        let memo = ReadonlyAnalysisMemo::new(ReadonlyAnalysisMemoLimits::default());
+        memo.promote(&slot("a").0);
+        memo.insert(slot("a"), key("a"), analysis());
+        let mut epoch = key("a");
+        epoch.analyser_inputs_epoch = 1;
+        let mut uri_generation = key("a");
+        uri_generation.uri_generation = 1;
+        let mut stubs = key("a");
+        stubs.sidecars = SidecarStubFingerprint(vec![(PathBuf::from("/s.tcl.stubs"), false, None)]);
+        let mut structure = key("a");
+        structure.inputs.structure_only = true;
+        for changed in [key("b"), epoch, uri_generation, stubs, structure] {
+            assert!(memo.lookup(&slot("a"), &changed).is_none());
+        }
+        memo.insert(slot("a"), key("b"), analysis());
+        assert!(memo.lookup(&slot("a"), &key("a")).is_none());
+        assert_eq!(memo.retained().0, 1);
+    }
+
+    #[test]
+    fn superseded_generations_are_never_retained() {
+        let memo = ReadonlyAnalysisMemo::new(ReadonlyAnalysisMemoLimits::default());
+        memo.promote(&slot("open").0);
+        memo.insert(slot("open"), key("open"), analysis());
+        memo.insert(slot("closed"), key("closed"), analysis());
+        assert_eq!(memo.retained(), (1, 1, estimated_bytes("closed")));
+        let mut newer = key("new");
+        newer.class_factory_generation = 1;
+        memo.insert(slot("new"), newer.clone(), analysis());
+        assert_eq!(memo.retained(), (0, 1, estimated_bytes("new")));
+        // A run that read the older generation arrives late and is dropped.
+        memo.insert(slot("open"), key("open"), analysis());
+        assert!(memo.lookup(&slot("open"), &key("open")).is_none());
+        assert!(memo.lookup(&slot("new"), &newer).is_some());
+        memo.clear(1);
+        assert_eq!(memo.retained(), (0, 0, 0));
+        // A run from before the epoch moved is refused.
+        memo.insert(slot("new"), newer, analysis());
+        assert_eq!(memo.retained(), (0, 0, 0));
+    }
+
+    fn scratch_dir(tag: &str) -> PathBuf {
+        let nanos = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let dir = std::env::temp_dir().join(format!(
+            "tcl-lsp-readonly-memo-{tag}-{}-{nanos}",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        dir
+    }
+
+    #[test]
+    fn sidecar_fingerprint_probes_exactly_the_candidate_names() {
+        let root = scratch_dir("sidecars");
+        let nested = root.join("nested");
+        std::fs::create_dir_all(&nested).unwrap();
+        let document = nested.join("main.tcl");
+        let path = document.to_str().unwrap();
+        let names = sidecar_stub_names("tcl8.6", None);
+        assert!(names.contains("tcl8.6"));
+        let empty = SidecarStubFingerprint::capture(Some(path), &names);
+        std::fs::write(root.join("unrelated.tcl.stubs"), "proc other {}\n").unwrap();
+        assert_eq!(empty, SidecarStubFingerprint::capture(Some(path), &names));
+        std::fs::write(root.join("tcl8.6.tcl.stubs"), "proc stubbed {}\n").unwrap();
+        let outer = SidecarStubFingerprint::capture(Some(path), &names);
+        assert_ne!(empty, outer);
+        std::fs::write(root.join("tcl8.6.tcl.stubs"), "proc changed {}\n").unwrap();
+        let changed = SidecarStubFingerprint::capture(Some(path), &names);
+        assert_ne!(outer, changed);
+        assert_eq!(changed, SidecarStubFingerprint::capture(Some(path), &names));
+        // A candidate that is not a readable file has no content, as the
+        // analyser's lookup skips it, but is still observed.
+        std::fs::create_dir_all(nested.join("tcl8.6.tcl.stubs")).unwrap();
+        let directory = SidecarStubFingerprint::capture(Some(path), &names);
+        assert_eq!(directory, changed);
+        assert_eq!(
+            SidecarStubFingerprint::capture(None, &names),
+            SidecarStubFingerprint(Vec::new())
+        );
+        std::fs::remove_dir_all(&root).ok();
+    }
+
+    async fn register_open(backend: &Backend, uri: &Uri, source: &str) {
+        backend.documents.lock("readonly memo test").await.insert(
+            uri.clone(),
+            DocumentState::new(source.to_owned(), "tcl8.6".to_owned()),
+        );
+        // `did_open` records the open document for the memo.
+        backend.readonly_analysis_memo.promote(uri);
+        backend
+            .db_set_source(uri, source, "tcl8.6".to_owned())
+            .await
+            .unwrap();
+        let analysis = backend
+            .analysis_for(uri, Arc::from(source), "tcl8.6".to_owned())
+            .await
+            .unwrap();
+        backend
+            .workspace_index
+            .write()
+            .await
+            .replace_document(uri.as_str(), &analysis);
+    }
+
+    async fn symbols(
+        backend: &Backend,
+    ) -> Option<tower_lsp_server::ls_types::WorkspaceSymbolResponse> {
+        backend
+            .symbol(WorkspaceSymbolParams {
+                query: "memo_helper".to_owned(),
+                work_done_progress_params: WorkDoneProgressParams::default(),
+                partial_result_params: PartialResultParams::default(),
+            })
+            .await
+            .unwrap()
+    }
+
+    async fn index_closed(backend: &Backend, root: &Path) {
+        let on_disk = root.join("closed.tcl");
+        let closed_source = "proc memo_helper_closed {} {}\n";
+        std::fs::write(&on_disk, closed_source).unwrap();
+        let closed = Uri::from_file_path(&on_disk).unwrap();
+        let indexed = tcl_compiler::analyser::Analyser::new().analyse(closed_source, "tcl8.6");
+        backend
+            .workspace_index
+            .write()
+            .await
+            .add_document(closed.as_str(), &indexed);
+    }
+
+    /// Work budget: a repeated workspace-symbol request analyses no warm
+    /// document again, open or closed.
+    #[tokio::test]
+    async fn repeated_workspace_symbol_requests_analyse_nothing_again() {
+        let backend = crate::tests::test_backend();
+        let open: Uri = "file:///memo/open.tcl".parse().unwrap();
+        register_open(&backend, &open, "proc memo_helper_open {} {}\n").await;
+        let root = scratch_dir("closed");
+        index_closed(&backend, &root).await;
+
+        let first = symbols(&backend).await;
+        let Some(tower_lsp_server::ls_types::WorkspaceSymbolResponse::Flat(found)) = &first else {
+            panic!("expected a flat symbol list, got {first:?}");
+        };
+        assert_eq!(found.len(), 2, "{found:?}");
+        let warmed = backend.readonly_analysis_memo.runs();
+        assert_eq!(warmed, 2);
+        assert_eq!(symbols(&backend).await, first);
+        assert_eq!(backend.readonly_analysis_memo.runs(), warmed);
+        assert_eq!(backend.readonly_analysis_memo.hits(), 2);
+
+        // A configuration change clears every entry.
+        backend.invalidate_diag_inputs();
+        assert_eq!(backend.readonly_analysis_memo.retained(), (0, 0, 0));
+        assert_eq!(symbols(&backend).await, first);
+        assert_eq!(backend.readonly_analysis_memo.runs(), warmed + 2);
+        std::fs::remove_dir_all(&root).ok();
+    }
+
+    /// Work budget for the closed-tier bound: with no closed tier a closed
+    /// document is analysed on every request, while the open document stays
+    /// warm.
+    #[tokio::test]
+    async fn closed_documents_follow_the_closed_tier_bound() {
+        let mut backend = crate::tests::test_backend();
+        backend.readonly_analysis_memo =
+            Arc::new(ReadonlyAnalysisMemo::new(ReadonlyAnalysisMemoLimits {
+                closed_entries: 0,
+                closed_bytes: 0,
+            }));
+        let open: Uri = "file:///memo/bounded-open.tcl".parse().unwrap();
+        register_open(&backend, &open, "proc memo_helper_open {} {}\n").await;
+        let root = scratch_dir("bounded");
+        index_closed(&backend, &root).await;
+
+        let first = symbols(&backend).await;
+        assert!(first.is_some());
+        assert_eq!(backend.readonly_analysis_memo.runs(), 2);
+        assert_eq!(symbols(&backend).await, first);
+        assert_eq!(backend.readonly_analysis_memo.runs(), 3);
+        std::fs::remove_dir_all(&root).ok();
+    }
+
+    /// An edit to an open document is a miss for that document only.
+    #[tokio::test]
+    async fn an_edited_open_document_is_analysed_once_more() {
+        let backend = crate::tests::test_backend();
+        let edited: Uri = "file:///memo/edited.tcl".parse().unwrap();
+        let steady: Uri = "file:///memo/steady.tcl".parse().unwrap();
+        register_open(&backend, &edited, "proc memo_helper_a {} {}\n").await;
+        register_open(&backend, &steady, "proc memo_helper_b {} {}\n").await;
+        assert!(symbols(&backend).await.is_some());
+        assert_eq!(backend.readonly_analysis_memo.runs(), 2);
+        register_open(&backend, &edited, "proc memo_helper_c {} {}\n").await;
+        assert!(symbols(&backend).await.is_some());
+        assert_eq!(backend.readonly_analysis_memo.runs(), 3);
+    }
