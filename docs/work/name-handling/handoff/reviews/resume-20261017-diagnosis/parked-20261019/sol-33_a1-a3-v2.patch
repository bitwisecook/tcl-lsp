diff --git a/rust/tcl-lsp-server/src/readonly_analysis_memo.rs b/rust/tcl-lsp-server/src/readonly_analysis_memo.rs
new file mode 100644
--- /dev/null
+++ b/rust/tcl-lsp-server/src/readonly_analysis_memo.rs
@@ -0,0 +1,713 @@
+// tcl-lsp — a language server and toolchain for Tcl
+// Copyright (C) 2026 James Deucker (bitwisecook)
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+//! Reuse of the read-only fresh analysis driver's own output.
+//!
+//! Read-only requests (workspace symbols, readonly reference reports, call
+//! hierarchy, logical lenses, coarse semantic tokens) analyse through
+//! [`FreshAnalysisDriver`] rather than the Salsa memo: the driver holds no
+//! database snapshot, so it never delays a live edit's publication, and it
+//! never enters `file_analysis_incremental`'s LRU. Its product differs from
+//! the Salsa memo's (no subclass-method, per-file factory or cross-file call
+//! site inputs), so the Salsa memo cannot stand in for it.
+//!
+//! This memo keeps the driver's own product under a key holding every input
+//! the driver reads, so a hit returns exactly what a fresh run would. Open
+//! documents keep one entry per URI and purpose; closed documents share a
+//! least-recently-used tier bounded by entry count and estimated bytes. Only
+//! entries of the current analyser-input epoch and factory generation are
+//! retained, so no superseded registry or factory generation outlives its
+//! epoch here. The memo takes no database snapshot, spawns no work of its own
+//! and only replaces the producer call: every currency check the request makes
+//! still runs on the request's own captured state.
+
+use super::{Backend, DocumentSourceResult, FreshAnalysisDriver, FreshAnalysisSeed};
+use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use tcl_compiler::analyser::{AnalysisResult, ResolvedAnalysisInput};
+use tower_lsp_server::ls_types::Uri;
+
+/// Which read-only producer an entry belongs to. Each keeps its own slot, so a
+/// document read through more than one purpose does not evict itself.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub(super) enum ReadonlyAnalysisKind {
+    /// The driver over the document's supplied database analysis input.
+    Database,
+    /// The driver resolving its own input.
+    Fresh,
+    /// The structure-only driver of coarse semantic tokens.
+    Structure,
+}
+
+const KINDS: [ReadonlyAnalysisKind; 3] = [
+    ReadonlyAnalysisKind::Database,
+    ReadonlyAnalysisKind::Fresh,
+    ReadonlyAnalysisKind::Structure,
+];
+
+/// Bounds of the closed-document tier. Open documents are bounded by the open
+/// set: one entry per URI and [`ReadonlyAnalysisKind`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) struct ReadonlyAnalysisMemoLimits {
+    /// Most closed-document analyses retained.
+    pub(super) closed_entries: usize,
+    /// Most estimated bytes the closed-document analyses retain.
+    pub(super) closed_bytes: usize,
+}
+
+impl Default for ReadonlyAnalysisMemoLimits {
+    fn default() -> Self {
+        Self {
+            closed_entries: 256,
+            closed_bytes: 512 * 1024 * 1024,
+        }
+    }
+}
+
+/// Estimated retained bytes of one analysis per source byte. This is an
+/// unmeasured estimate, not a measurement: analyses carry scope, symbol,
+/// invocation and diagnostic tables that grow with the source, and the byte
+/// bound applies to this estimate only.
+const ESTIMATED_ANALYSIS_BYTES_PER_SOURCE_BYTE: usize = 64;
+/// Estimated fixed cost of one retained analysis; unmeasured, like the factor.
+const ESTIMATED_ANALYSIS_ENTRY_OVERHEAD_BYTES: usize = 16 * 1024;
+
+fn estimated_bytes(text: &str) -> usize {
+    text.len()
+        .saturating_mul(ESTIMATED_ANALYSIS_BYTES_PER_SOURCE_BYTE + 1)
+        .saturating_add(ESTIMATED_ANALYSIS_ENTRY_OVERHEAD_BYTES)
+}
+
+/// Every sidecar name the analyser can look up for one run: the dialect it is
+/// given (`scan_sidecar_stubs`), the analyser and unit profile names of that
+/// dialect's environment (`has_sidecar_stubs`), and those of any supplied
+/// input (the declared-command contracts).
+pub(super) fn sidecar_stub_names(
+    dialect: &str,
+    supplied: Option<&ResolvedAnalysisInput>,
+) -> BTreeSet<String> {
+    let environment = tcl_registry::model::ingress::resolve_environment(dialect);
+    let mut names: BTreeSet<String> = [
+        dialect,
+        environment.analyser_profile().name,
+        environment.unit_profile().name,
+    ]
+    .into_iter()
+    .map(str::to_owned)
+    .collect();
+    if let Some(input) = supplied {
+        names.insert(input.analyser_profile().name.to_owned());
+        names.insert(input.unit_profile().name.to_owned());
+    }
+    names
+}
+
+/// The sidecar names a finished run's own retained input can have read. A run
+/// whose names fall outside the probed set is never reused.
+fn analysis_stub_names(analysis: &AnalysisResult) -> Vec<&'static str> {
+    analysis
+        .resolved_input
+        .as_ref()
+        .map(|input| vec![input.analyser_profile().name, input.unit_profile().name])
+        .unwrap_or_default()
+}
+
+/// What the analyser observes of each candidate sidecar `<name>.tcl.stubs` in
+/// each ancestor directory of a document: whether it is a file
+/// (`has_sidecar_stubs`) and its UTF-8 content (`scan_sidecar_stubs`). A
+/// missing, unreadable or non-UTF-8 file has no content, exactly as the
+/// analyser skips it. Each candidate is probed by name, never by listing a
+/// directory, so the probe sees what the analyser's own lookups see on a
+/// case-insensitive file system or under an unlistable ancestor.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct SidecarStubFingerprint(Vec<(PathBuf, bool, Option<String>)>);
+
+impl SidecarStubFingerprint {
+    pub(super) fn capture(file_path: Option<&str>, names: &BTreeSet<String>) -> Self {
+        let mut probes = Vec::new();
+        let mut directory = file_path.and_then(|path| Path::new(path).parent());
+        while let Some(current) = directory {
+            for name in names {
+                let path = current.join(format!("{name}.tcl.stubs"));
+                let is_file = path.is_file();
+                let content = std::fs::read_to_string(&path).ok();
+                probes.push((path, is_file, content));
+            }
+            directory = current.parent();
+        }
+        Self(probes)
+    }
+}
+
+/// Every input of one fresh driver run on a whole document.
+#[derive(Clone, PartialEq)]
+pub(super) struct FreshAnalysisKey {
+    pub(super) text: Arc<str>,
+    pub(super) dialect: String,
+    pub(super) inputs: super::FreshDriverInputs,
+    pub(super) analyser_inputs_epoch: u64,
+    pub(super) class_factory_generation: u64,
+    pub(super) uri_generation: u64,
+    pub(super) stub_names: BTreeSet<String>,
+    pub(super) sidecars: SidecarStubFingerprint,
+}
+
+impl FreshAnalysisKey {
+    const fn generation(&self) -> (u64, u64) {
+        (self.analyser_inputs_epoch, self.class_factory_generation)
+    }
+}
+
+type Slot = (Uri, ReadonlyAnalysisKind);
+
+struct Entry {
+    key: FreshAnalysisKey,
+    analysis: Arc<AnalysisResult>,
+    bytes: usize,
+}
+
+#[derive(Default)]
+struct MemoState {
+    /// Documents open now, maintained by `didOpen` and `didClose`. The tier
+    /// an insertion joins is read here, never from the request's snapshot.
+    open_uris: HashSet<Uri>,
+    open: HashMap<Slot, Entry>,
+    closed: HashMap<Slot, (Entry, u64)>,
+    recency: BTreeMap<u64, Slot>,
+    next_use: u64,
+    closed_bytes: usize,
+    /// The analyser-input epoch and factory generation of every entry.
+    generation: Option<(u64, u64)>,
+    /// The current analyser-input epoch at the last clear; a run from an
+    /// earlier epoch is never retained.
+    epoch_floor: u64,
+}
+
+impl MemoState {
+    fn clear_entries(&mut self) {
+        self.open.clear();
+        self.closed.clear();
+        self.recency.clear();
+        self.closed_bytes = 0;
+        self.generation = None;
+    }
+
+    fn remove(&mut self, slot: &Slot) {
+        self.open.remove(slot);
+        if let Some((entry, used)) = self.closed.remove(slot) {
+            self.recency.remove(&used);
+            self.closed_bytes -= entry.bytes;
+        }
+    }
+
+    fn touch(&mut self, slot: &Slot) {
+        self.next_use += 1;
+        let next = self.next_use;
+        if let Some((_, used)) = self.closed.get_mut(slot) {
+            self.recency.remove(used);
+            *used = next;
+            self.recency.insert(next, slot.clone());
+        }
+    }
+
+    fn insert_closed(&mut self, slot: Slot, entry: Entry, limits: ReadonlyAnalysisMemoLimits) {
+        if limits.closed_entries == 0 || entry.bytes > limits.closed_bytes {
+            return;
+        }
+        while self.closed.len() >= limits.closed_entries
+            || self.closed_bytes + entry.bytes > limits.closed_bytes
+        {
+            let Some((_, evicted)) = self.recency.pop_first() else {
+                break;
+            };
+            if let Some((old, _)) = self.closed.remove(&evicted) {
+                self.closed_bytes -= old.bytes;
+            }
+        }
+        self.next_use += 1;
+        self.closed_bytes += entry.bytes;
+        self.recency.insert(self.next_use, slot.clone());
+        self.closed.insert(slot, (entry, self.next_use));
+    }
+}
+
+/// Backend-owned memo of read-only fresh analyses. Its lock is a leaf: it is
+/// never held across an `.await` or while another lock is taken.
+pub(super) struct ReadonlyAnalysisMemo {
+    limits: ReadonlyAnalysisMemoLimits,
+    state: std::sync::Mutex<MemoState>,
+    #[cfg(test)]
+    runs: std::sync::atomic::AtomicUsize,
+    #[cfg(test)]
+    hits: std::sync::atomic::AtomicUsize,
+}
+
+impl ReadonlyAnalysisMemo {
+    pub(super) fn new(limits: ReadonlyAnalysisMemoLimits) -> Self {
+        Self {
+            limits,
+            state: std::sync::Mutex::default(),
+            #[cfg(test)]
+            runs: std::sync::atomic::AtomicUsize::new(0),
+            #[cfg(test)]
+            hits: std::sync::atomic::AtomicUsize::new(0),
+        }
+    }
+
+    fn state(&self) -> std::sync::MutexGuard<'_, MemoState> {
+        self.state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+
+    fn lookup(&self, slot: &Slot, key: &FreshAnalysisKey) -> Option<Arc<AnalysisResult>> {
+        let mut state = self.state();
+        if let Some(entry) = state.open.get(slot).filter(|entry| entry.key == *key) {
+            return Some(Arc::clone(&entry.analysis));
+        }
+        let analysis = state
+            .closed
+            .get(slot)
+            .filter(|(entry, _)| entry.key == *key)
+            .map(|(entry, _)| Arc::clone(&entry.analysis))?;
+        state.touch(slot);
+        Some(analysis)
+    }
+
+    /// Retain a run. A run from an older epoch or factory generation than the
+    /// retained entries is dropped; a run from a newer one first drops every
+    /// retained entry, so superseded generations never outlive the bound.
+    fn insert(&self, slot: Slot, key: FreshAnalysisKey, analysis: Arc<AnalysisResult>) {
+        let generation = key.generation();
+        let bytes = estimated_bytes(&key.text);
+        let entry = Entry {
+            key,
+            analysis,
+            bytes,
+        };
+        let mut state = self.state();
+        if generation.0 < state.epoch_floor {
+            return;
+        }
+        let retained = state.generation;
+        match retained {
+            Some(current) if current == generation => {}
+            Some(current) if generation.0 < current.0 || generation.1 < current.1 => return,
+            _ => {
+                state.clear_entries();
+                state.generation = Some(generation);
+            }
+        }
+        state.remove(&slot);
+        if state.open_uris.contains(&slot.0) {
+            state.open.insert(slot, entry);
+        } else {
+            state.insert_closed(slot, entry, self.limits);
+        }
+    }
+
+    /// Drop every entry: the analyser-input epoch moved to `epoch`, so none
+    /// can hit, and a run still finishing under an earlier epoch is refused.
+    pub(super) fn clear(&self, epoch: u64) {
+        let mut state = self.state();
+        state.clear_entries();
+        state.epoch_floor = state.epoch_floor.max(epoch);
+    }
+
+    /// An opened document's entries leave the bounded tier.
+    pub(super) fn promote(&self, uri: &Uri) {
+        let mut state = self.state();
+        state.open_uris.insert(uri.clone());
+        for kind in KINDS {
+            let slot = (uri.clone(), kind);
+            if let Some((entry, used)) = state.closed.remove(&slot) {
+                state.recency.remove(&used);
+                state.closed_bytes -= entry.bytes;
+                state.open.insert(slot, entry);
+            }
+        }
+    }
+
+    /// A closed document's entries join the bounded tier, and later runs for
+    /// it insert there.
+    pub(super) fn demote(&self, uri: &Uri) {
+        let mut state = self.state();
+        state.open_uris.remove(uri);
+        for kind in KINDS {
+            let slot = (uri.clone(), kind);
+            if let Some(entry) = state.open.remove(&slot) {
+                state.insert_closed(slot, entry, self.limits);
+            }
+        }
+    }
+
+    /// Drop every entry of retired URIs.
+    pub(super) fn forget(&self, uris: &[Uri]) {
+        let mut state = self.state();
+        for uri in uris {
+            for kind in KINDS {
+                state.remove(&(uri.clone(), kind));
+            }
+        }
+    }
+
+    #[cfg(test)]
+    pub(super) fn runs(&self) -> usize {
+        self.runs.load(std::sync::atomic::Ordering::SeqCst)
+    }
+
+    #[cfg(test)]
+    pub(super) fn hits(&self) -> usize {
+        self.hits.load(std::sync::atomic::Ordering::SeqCst)
+    }
+
+    #[cfg(test)]
+    fn retained(&self) -> (usize, usize, usize) {
+        let state = self.state();
+        (state.open.len(), state.closed.len(), state.closed_bytes)
+    }
+}
+
+impl Backend {
+    /// The read-only driver's analysis of `text`, reused when every input the
+    /// driver reads is unchanged. The lookup, any run and the insertion happen
+    /// on the request's own blocking worker, exactly where the uncached run
+    /// happened.
+    pub(super) async fn readonly_analysis_seed(
+        &self,
+        uri: &Uri,
+        driver: FreshAnalysisDriver,
+        text: Arc<str>,
+        dialect: String,
+    ) -> DocumentSourceResult<FreshAnalysisSeed> {
+        let slot = (uri.clone(), driver.readonly_kind());
+        let uri_generation = self.live_publication_uri_generation(uri);
+        let memo = Arc::clone(&self.readonly_analysis_memo);
+        let original_uri = uri.clone();
+        crate::rt::spawn_blocking(move || {
+            let key = driver.readonly_key(&text, &dialect, uri_generation);
+            if let Some(analysis) = memo.lookup(&slot, &key) {
+                #[cfg(test)]
+                memo.hits.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                return driver.reuse(analysis);
+            }
+            #[cfg(test)]
+            memo.runs.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            let file_path = driver.file_path().map(str::to_owned);
+            let seed = driver.analyse(&text, &dialect, None)?;
+            // The run's own input names must be probed ones, and the probed
+            // sidecars must be unchanged across the run.
+            if analysis_stub_names(&seed.analysis)
+                .into_iter()
+                .all(|name| key.stub_names.contains(name))
+                && SidecarStubFingerprint::capture(file_path.as_deref(), &key.stub_names)
+                    == key.sidecars
+            {
+                memo.insert(slot, key, Arc::clone(&seed.analysis));
+            }
+            Ok(seed)
+        })
+        .await
+        .map_err(|_| super::DocumentSourceUnavailable::Worker { uri: original_uri })?
+    }
+}
