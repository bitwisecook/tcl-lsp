+
+/// This module's own analysis of `source` under `input`: a default analyser
+/// over that complete input, exactly what [`analysis_with_input`] produces.
+/// Only this module constructs one, so no caller-supplied analysis with an
+/// unknown producer can stand in for it.
+pub(super) struct LexicalSeed<'s> {
+    source: &'s str,
+    input: &'s ResolvedAnalysisInput,
+    analysis: Rc<AnalysisResult>,
+}
+
+impl<'s> LexicalSeed<'s> {
+    #[must_use]
+    pub(super) fn analyse(source: &'s str, input: &'s ResolvedAnalysisInput) -> Self {
+        Self {
+            source,
+            input,
+            analysis: Rc::new(analysis_with_input(source, input)),
+        }
+    }
+}
+
+/// The analyses of one lexical minify call. Every pass analyses its text with
+/// [`analysis_with_input`] under the same complete input, a pure function of
+/// that text and input, so a pass whose text equals the latest analysed text
+/// reuses that analysis. Only the latest text is held.
+pub(super) struct LexicalAnalyses<'i> {
+    input: &'i ResolvedAnalysisInput,
+    latest: Option<(String, Rc<AnalysisResult>)>,
+}
+
+impl<'i> LexicalAnalyses<'i> {
+    /// A seed is kept only when it was produced under this exact input.
+    #[must_use]
+    pub(super) fn new(input: &'i ResolvedAnalysisInput, seed: Option<LexicalSeed<'_>>) -> Self {
+        let latest = seed
+            .filter(|seed| seed.input == input)
+            .map(|seed| (seed.source.to_owned(), seed.analysis));
+        Self { input, latest }
+    }
+
+    pub(super) const fn input(&self) -> &'i ResolvedAnalysisInput {
+        self.input
+    }
+
+    pub(super) fn of(&mut self, source: &str) -> Rc<AnalysisResult> {
+        if let Some((text, analysis)) = &self.latest
+            && text == source
+        {
+            return Rc::clone(analysis);
+        }
+        let analysis = Rc::new(analysis_with_input(source, self.input));
+        self.latest = Some((source.to_owned(), Rc::clone(&analysis)));
+        analysis
+    }
+}
