+        let registry = CommandRegistry::build_default();
+        let input = profile_input(lexical_profile(), &registry);
+        let other = profile_input(lexical_profile(), &registry);
+        reset_lexical_analysis_count();
+        let mut analyses =
+            LexicalAnalyses::new(&other, Some(LexicalSeed::analyse(REUSE_SOURCE, &input)));
+        let reused = analyses.of(REUSE_SOURCE);
+        assert_eq!(lexical_analysis_count(), 2);
+        assert_eq!(reused.resolved_input.as_ref(), Some(&other));
+        let again = analyses.of(REUSE_SOURCE);
+        assert!(Rc::ptr_eq(&reused, &again));
+    }
 }
