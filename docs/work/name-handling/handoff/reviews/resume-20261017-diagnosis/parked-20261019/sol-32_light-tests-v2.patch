+    /// Light companion of `deeply_nested_namespaces_produce_a_symbol_tree`:
+    /// the outline walk itself, without the analyser, over a synthetic
+    /// namespace tree two levels deeper than `MAX_SCOPE_WALK_DEPTH`. The walk
+    /// returns and its own cap truncates the outline.
+    #[test]
+    fn deeply_nested_namespaces_produce_a_symbol_tree_light() {
+        const STACK_SIZE: usize = 64 * 1024 * 1024;
+        let depth = usize::try_from(crate::MAX_SCOPE_WALK_DEPTH.0).unwrap() + 2;
+        let mut source = String::new();
+        let mut body_starts = Vec::with_capacity(depth);
+        for level in 0..depth {
+            let _ = writeln!(source, "namespace eval ns{level} {{");
+            body_starts.push(source.len());
+        }
+        let mut body_ends = vec![0; depth];
+        for end in body_ends.iter_mut().rev() {
+            *end = source.len();
+            source.push_str("}\n");
+        }
+        let offset = |at: usize| u32::try_from(at).unwrap();
+        let mut nested: Option<Scope> = None;
+        for level in (0..depth).rev() {
+            let mut scope = Scope::new(ScopeKind::Namespace, format!("ns{level}"));
+            scope.body_span = Some(Span::new(
+                offset(body_starts[level]),
+                offset(body_ends[level]),
+            ));
+            scope.children.extend(nested.take());
+            nested = Some(scope);
+        }
+        let mut global = Scope::new(ScopeKind::Global, "::");
+        global.children.extend(nested);
+        std::thread::Builder::new()
+            .stack_size(STACK_SIZE)
+            .spawn(move || {
+                let line_index = LineIndex::new(&source);
+                let mut rehomed = Vec::new();
+                let symbols = scope_symbols(
+                    &source,
+                    &global,
+                    &line_index,
+                    ScopePos {
+                        depth: 0,
+                        namespace: "::",
+                    },
+                    &mut SymbolCtx {
+                        rehomed: &mut rehomed,
+                    },
+                );
+                assert!(!symbols.is_empty());
+                let mut levels = 0;
+                let mut node = symbols.first();
+                while let Some(symbol) = node {
+                    levels += 1;
+                    node = symbol.children.first();
+                }
+                assert!(
+                    levels < depth,
+                    "the walk's cap truncates the outline: {levels} of {depth} levels"
+                );
+            })
+            .unwrap()
+            .join()
+            .unwrap();
+    }
