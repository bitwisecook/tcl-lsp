+        const { std::cell::Cell::new(0) };
+}
+
+#[cfg(test)]
+fn reset_instance_class_site_transfers() {
+    INSTANCE_CLASS_SITE_TRANSFERS.with(|count| count.set(0));
+}
+
+#[cfg(test)]
+fn instance_class_site_transfers() -> usize {
+    INSTANCE_CLASS_SITE_TRANSFERS.with(std::cell::Cell::get)
