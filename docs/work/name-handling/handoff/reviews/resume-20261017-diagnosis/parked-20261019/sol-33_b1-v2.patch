+#[cfg(test)]
+mod instance_class_fold_tests {
+    use super::selected_global_option_taint_tests::build_tk_module;
+    use super::*;
+
+    /// The per-procedure fold the prefix fold replaces, kept as the oracle.
+    fn per_procedure_fold(
+        module: &crate::ir::Module,
+        registry: &tcl_registry::CommandRegistry,
+    ) -> HashMap<ProcedureId, crate::taint::InstanceClassState> {
+        let invocations = EagerInvocations::of(module, registry);
+        let source = crate::taint::TaintSourceContext::for_module(registry, module);
+        let sites = instance_class_sites(module);
+        summary_procedure_bodies(module, registry)
+            .iter()
+            .map(|(id, procedure)| {
+                let eager = if module.procedures.contains_key(id) {
+                    invocations.named(id)
+                } else {
+                    Some(procedure.span.start())
+                };
+                let mut classes = crate::taint::InstanceClassState::new();
+                for &(statement, tokens, direct) in &sites {
+                    if eager.is_some_and(|cut| statement.span().start() >= cut) {
+                        continue;
+                    }
+                    transfer_instance_class_site(&mut classes, registry, source, tokens, direct);
+                }
+                (*id, classes)
+            })
+            .collect()
+    }
+
+    fn procedure_named(module: &crate::ir::Module, qualified_name: &str) -> ProcedureId {
+        *module
+            .procedures
+            .iter()
+            .find(|(_, procedure)| procedure.qualified_name == qualified_name)
+            .map(|(id, _)| id)
+            .expect(qualified_name)
+    }
+
+    /// `callable` runs at the top level between the two constructors, so its
+    /// cut keeps `.before` and drops `.after`; nothing runs `idle`, so it reads
+    /// the whole fold.
+    const SOURCE: &str = "proc callable {} {return OK}; proc idle {} {return OK}; \
+                          entry .before; callable; entry .after";
+
+    #[test]
+    fn one_prefix_fold_equals_a_fold_per_procedure() {
+        let (context, module) = build_tk_module(SOURCE);
+        let registry = context.commands();
+        let classes = global_instance_classes(&module, registry);
+        assert_eq!(classes, per_procedure_fold(&module, registry));
+        let invocations = EagerInvocations::of(&module, registry);
+        let callable = procedure_named(&module, "::callable");
+        let idle = procedure_named(&module, "::idle");
+        assert!(invocations.named(&callable).is_some());
+        assert!(invocations.named(&idle).is_none());
+        assert!(classes[&callable].contains_key(".before"));
+        assert!(!classes[&callable].contains_key(".after"));
+        assert!(classes[&idle].contains_key(".after"));
+    }
+
+    /// Work budget: each site is transferred once per module, however many
+    /// procedures read the fold.
+    #[test]
+    fn the_instance_class_fold_transfers_each_site_once() {
+        for source in ["entry .a; proc p {} {return OK}; entry .b", SOURCE] {
+            let (context, module) = build_tk_module(source);
+            let registry = context.commands();
+            reset_instance_class_site_transfers();
+            let classes = global_instance_classes(&module, registry);
+            assert!(!classes.is_empty(), "{source}");
+            assert_eq!(
+                instance_class_site_transfers(),
+                instance_class_sites(&module).len(),
+                "{source}"
+            );
+        }
+    }
+}
