+
+/// One site of the fold. Nested source effects only withdraw candidates; they
+/// do not prove that a conditional factory, mutation or teardown actually ran.
+fn transfer_instance_class_site(
+    classes: &mut crate::taint::InstanceClassState,
+    registry: &tcl_registry::CommandRegistry,
+    source: crate::taint::TaintSourceContext<'_>,
+    tokens: Option<&crate::ir::CommandTokens>,
+    direct: bool,
+) {
+    #[cfg(test)]
+    INSTANCE_CLASS_SITE_TRANSFERS.with(|count| count.set(count.get() + 1));
+    if direct {
+        crate::taint::transfer_instance_command(classes, registry, source, tokens);
+    } else {
+        let mut candidate = classes.clone();
+        crate::taint::transfer_instance_command(&mut candidate, registry, source, tokens);
+        classes.retain(|name, class| candidate.get(name) == Some(class));
+    }
+}
