+//! The quick tier's deep-only manifest and its drift gate.
+//!
+//! `scripts/dev/deep-only-tests.tsv` names the deep tests that the local,
+//! non-gating quick tier (`make test-quick`, nextest `[profile.quick]`)
+//! leaves out. `sync` writes the quick profile's `default-filter` from it.
+//! `check` holds the manifest and the tier to
+//! `docs/design/contracts/test-tiers-and-ci-gates.md`:
+//!
+//! - every row names a `#[test]` that its Cargo target declares, found by
+//!   walking the target's module tree, so a renamed or deleted test fails;
+//! - the quick profile's filter is the one the manifest generates;
+//! - the default profile, which CI and `make test-rust` run, sets no
+//!   `default-filter` in its table or in any override (per-platform ones
+//!   included), no `default-filter` outside the quick profile names a row
+//!   (an override's plain `filter` only chooses settings, so it may), the
+//!   quick profile's overrides add no second filter, and no profile inherits
+//!   from `quick`;
+//! - neither the default nor the quick profile sets `terminate-after`, so a
+//!   slow-timeout there is only a warning;
+//! - the default profile sets no `run-extra-args` and no list or run
+//!   wrapper, and its overrides carry only settings that cannot stop a
+//!   selected test from running;
+//! - nothing tracked under `.github/` or `scripts/` selects the quick profile
+//!   (`--profile`, `-P`, or `NEXTEST_PROFILE`, inline or as an argument
+//!   list), hands nextest another config file, or reads the manifest, and in
+//!   the Makefile only the `test-quick` recipe selects it and no other target
+//!   reaches `test-quick`.
+
+use std::collections::hash_map::Entry;
+use std::collections::{BTreeSet, HashMap, HashSet};
+use std::fmt::Write as _;
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::{Command, ExitCode};
+use std::sync::LazyLock;
+
+use anyhow::{Context, Result, bail};
+use regex::Regex;
+use serde::Deserialize;
+use syn::ext::IdentExt;
+
+use crate::cargo_smoke::{
+    canonical_target_kinds, default_true, has_test_attribute, inline_module_directories,
+    is_builtin_include_macro, lexically_normalise, module_sources,
+};
+use crate::util::{replace_generated_region, repo_root, write_if_changed};
+
+const MANIFEST: &str = "scripts/dev/deep-only-tests.tsv";
+const NEXTEST_CONFIG: &str = ".config/nextest.toml";
+const MAKEFILE: &str = "Makefile";
+const QUICK_PROFILE: &str = "quick";
+/// The profile CI and `make test-rust` run: the deep tier.
+const GATE_PROFILE: &str = "default";
+const QUICK_TARGET: &str = "test-quick";
+const GENERATED_REGION: &str = "deep-only-tests";
+/// Tracked trees that drive CI.
+const GATE_TREES: &[&str] = &[".github", "scripts"];
+const ROW_KINDS: &[&str] = &["lib", "bin", "test"];
+
+/// Selecting the quick profile on a nextest command line (`--profile quick`,
+/// `--profile=quick`, `-P quick`, `-P=quick`, `-Pquick`, or an argument list
+/// such as `["-P", "quick"]`) or through the environment
+/// (`NEXTEST_PROFILE=quick`, `NEXTEST_PROFILE: quick`,
+/// `.env("NEXTEST_PROFILE", "quick")`, ...).
+static QUICK_PROFILE_SELECTION: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(concat!(
+        r#"(?:--profile|(?:^|[^A-Za-z0-9_-])-P|NEXTEST_PROFILE["']?\]?\s*(?::|[?+:]?=|,))"#,
+        r#"(?:["']?\s*,|\s+|=)?\s*["']?quick(?:$|[^A-Za-z0-9_-])"#,
+    ))
+    .expect("quick-profile selection pattern")
+});
+
+/// Pointing nextest at another config file, whose `default-filter` (nextest
+/// 0.9.145 and later) would apply to the default profile.
+static CONFIG_FILE_FLAG: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"(?:^|[^A-Za-z0-9_-])--(?:tool-)?config-file(?:$|[^A-Za-z0-9_-])")
+        .expect("nextest config-file flag pattern")
+});
+
+/// What a `[[profile.default.overrides]]` entry may set: the tests it applies
+/// to, and settings that schedule, retry, time, or report a test without
+/// stopping it from running. `run-extra-args` (`--skip`, `--ignored`) is not
+/// one of them: it can pass a selected test without running its body.
+const GATE_OVERRIDE_SETTINGS: &[&str] = &[
+    "filter",
+    "platform",
+    "priority",
+    "retries",
+    "flaky-result",
+    "threads-required",
+    "test-group",
+    "slow-timeout",
+    "leak-timeout",
+    "success-output",
+    "failure-output",
+    "junit",
+];
+
+/// Script settings that replace how a test is listed or run, so a wrapper
+/// could hide a test or pass it without running it.
+const WRAPPER_SETTINGS: &[&str] = &["list-wrapper", "run-wrapper"];
+
+/// The `test-quick` make target as a whole word.
+static QUICK_TARGET_WORD: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"(?:^|[^A-Za-z0-9_-])test-quick(?:[^A-Za-z0-9_-]|$)")
+        .expect("test-quick target pattern")
+});
+
+static CARGO_NAME: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"^[A-Za-z0-9_-]+$").expect("Cargo name pattern"));
+
+static TEST_PATH: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*$").expect("test path pattern")
+});
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Row {
+    line: usize,
+    package: String,
+    kind: String,
+    target: String,
+    test: String,
+}
+
+impl Row {
+    /// The nextest binary id of the harness that runs this row's test.
+    fn binary_id(&self) -> String {
+        match self.kind.as_str() {
+            "lib" => self.package.clone(),
+            "bin" => format!("{}::bin/{}", self.package, self.target),
+            _ => format!("{}::{}", self.package, self.target),
+        }
+    }
+
+    fn selector(&self) -> String {
+        format!("(binary_id(={}) & test(={}))", self.binary_id(), self.test)
+    }
+}
+
+fn row_problem(
+    package: &str,
+    kind: &str,
+    target: &str,
+    test: &str,
+    reason: &str,
+) -> Option<String> {
+    if !CARGO_NAME.is_match(package) {
+        return Some(format!("invalid Cargo package name {package:?}"));
+    }
+    if !ROW_KINDS.contains(&kind) {
+        return Some(format!("target kind {kind:?} is not lib, bin, or test"));
+    }
+    if !CARGO_NAME.is_match(target) {
+        return Some(format!("invalid Cargo target name {target:?}"));
+    }
+    if !TEST_PATH.is_match(test) {
+        return Some(format!("{test:?} is not an exact Rust test path"));
+    }
+    if reason.trim().is_empty() {
+        return Some("a row needs a reason".to_owned());
+    }
+    None
+}
+
+fn parse_manifest(text: &str) -> Result<Vec<Row>> {
+    let mut rows = Vec::new();
+    let mut errors = Vec::new();
+    let mut seen = HashMap::new();
+    for (index, line) in text.lines().enumerate() {
+        let line_number = index + 1;
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let fields: Vec<&str> = line.split('\t').collect();
+        let &[package, kind, target, test, reason] = fields.as_slice() else {
+            errors.push(format!(
+                "{MANIFEST}:{line_number}: expected five tab-separated fields"
+            ));
+            continue;
+        };
+        if let Some(problem) = row_problem(package, kind, target, test, reason) {
+            errors.push(format!("{MANIFEST}:{line_number}: {problem}"));
+            continue;
+        }
+        if let Some(first) = seen.insert((package, kind, target, test), line_number) {
+            errors.push(format!(
+                "{MANIFEST}:{line_number}: duplicate row (first at line {first})"
+            ));
+            continue;
+        }
+        rows.push(Row {
+            line: line_number,
+            package: package.to_owned(),
+            kind: kind.to_owned(),
+            target: target.to_owned(),
+            test: test.to_owned(),
+        });
+    }
+    if errors.is_empty() {
+        Ok(rows)
+    } else {
+        bail!("{}", errors.join("\n"))
+    }
+}
+
+/// The quick profile's `default-filter`: every test except the rows.
+fn filter_expression(rows: &[Row]) -> String {
+    if rows.is_empty() {
+        return "all()\n".to_owned();
+    }
+    let mut expression = String::from("not (\n");
+    for (index, row) in rows.iter().enumerate() {
+        let joiner = if index == 0 { "    " } else { "  | " };
+        let _ = writeln!(expression, "{joiner}{}", row.selector());
+    }
+    expression.push_str(")\n");
+    expression
+}
+
+/// The generated region of `.config/nextest.toml`.
+fn generated_region(rows: &[Row]) -> String {
+    format!("default-filter = '''\n{}'''\n", filter_expression(rows))
+}
+
+fn check_nextest_config(text: &str, rows: &[Row]) -> Vec<String> {
+    let mut errors = Vec::new();
+    match replace_generated_region(text, GENERATED_REGION, &generated_region(rows)) {
+        Ok(rendered) if rendered == text => {}
+        Ok(_) => errors.push(format!(
+            "{NEXTEST_CONFIG}: the quick filter is stale; run `cargo xtask deep-only-tests sync`"
+        )),
+        Err(error) => errors.push(format!("{NEXTEST_CONFIG}: {error:#}")),
+    }
+    let config: toml::Table = match toml::from_str(text) {
+        Ok(config) => config,
+        Err(error) => {
+            errors.push(format!("{NEXTEST_CONFIG}: {error}"));
+            return errors;
+        }
+    };
+    let Some(profiles) = config.get("profile").and_then(toml::Value::as_table) else {
+        errors.push(format!("{NEXTEST_CONFIG}: no [profile] tables"));
+        return errors;
+    };
+    let quick_filter = profiles
+        .get(QUICK_PROFILE)
+        .and_then(|profile| profile.get("default-filter"))
+        .and_then(toml::Value::as_str);
+    if quick_filter != Some(filter_expression(rows).as_str()) {
+        errors.push(format!(
+            "{NEXTEST_CONFIG}: [profile.{QUICK_PROFILE}] default-filter must be the filter generated in its `<generated: {GENERATED_REGION}>` region"
+        ));
+    }
+    for (name, profile) in profiles {
+        errors.extend(profile_problems(name, profile, rows));
+        if name == GATE_PROFILE {
+            errors.extend(gate_wrapper_problems(profile));
+        }
+        if inherits_quick(name, profiles) {
+            errors.push(format!(
+                "{NEXTEST_CONFIG}: [profile.{name}] inherits from {QUICK_PROFILE}, so it would carry the quick filter; only `make test-quick` may run it"
+            ));
+        }
+    }
+    errors
+}
+
+/// A profile's own table and each of its `[[profile.<name>.overrides]]`,
+/// labelled for messages.
+fn profile_settings<'a>(name: &str, profile: &'a toml::Value) -> Vec<(String, &'a toml::Value)> {
+    let mut settings = vec![(format!("[profile.{name}]"), profile)];
+    if let Some(overrides) = profile.get("overrides").and_then(toml::Value::as_array) {
+        for (index, setting) in overrides.iter().enumerate() {
+            settings.push((
+                format!("[[profile.{name}.overrides]] #{}", index + 1),
+                setting,
+            ));
+        }
+    }
+    settings
+}
+
+/// Whether `filter` names `test` as a whole path, whatever the matcher.
+fn names_test(filter: &str, test: &str) -> bool {
+    let continues_path = |c: char| c.is_ascii_alphanumeric() || c == '_' || c == ':';
+    filter.match_indices(test).any(|(start, _)| {
+        !filter[..start].ends_with(continues_path)
+            && !filter[start + test.len()..].starts_with(continues_path)
+    })
+}
+
+/// What `name`'s table and overrides may not set: anything
+/// [`gate_setting_problems`] rejects in the gate profile, a second quick
+/// filter, a terminating slow-timeout in either
+/// profile, or a default-filter outside the quick profile that names a
+/// deep-only test. An override's plain `filter` only picks the tests its
+/// settings (test-group, retries, slow-timeout, ...) apply to and never drops
+/// one, so it may name a deep-only test.
+fn profile_problems(name: &str, profile: &toml::Value, rows: &[Row]) -> Vec<String> {
+    let mut errors = Vec::new();
+    for (index, (place, setting)) in profile_settings(name, profile).into_iter().enumerate() {
+        let is_override = index > 0;
+        if name == GATE_PROFILE {
+            errors.extend(gate_setting_problems(&place, setting, is_override));
+        }
+        if name == QUICK_PROFILE && is_override && setting.get("default-filter").is_some() {
+            errors.push(format!(
+                "{NEXTEST_CONFIG}: {place} sets default-filter; the quick filter comes only from its `<generated: {GENERATED_REGION}>` region"
+            ));
+        }
+        if (name == GATE_PROFILE || name == QUICK_PROFILE)
+            && setting
+                .get("slow-timeout")
+                .and_then(|timeout| timeout.get("terminate-after"))
+                .is_some()
+        {
+            errors.push(format!(
+                "{NEXTEST_CONFIG}: {place} slow-timeout sets terminate-after; a slow test there is a warning, never a failure"
+            ));
+        }
+        if name == QUICK_PROFILE {
+            continue;
+        }
+        if let Some(filter) = setting.get("default-filter").and_then(toml::Value::as_str)
+            && let Some(row) = rows.iter().find(|row| names_test(filter, &row.test))
+        {
+            errors.push(format!(
+                "{NEXTEST_CONFIG}: {place} default-filter names deep-only test {}; only the quick filter may leave one out",
+                row.test
+            ));
+        }
+    }
+    errors
+}
+
+/// What the gate profile's table or one of its overrides may not set: a
+/// `default-filter`, `run-extra-args`, or (in an override) any setting outside
+/// [`GATE_OVERRIDE_SETTINGS`].
+fn gate_setting_problems(place: &str, setting: &toml::Value, is_override: bool) -> Vec<String> {
+    let mut errors = Vec::new();
+    if setting.get("default-filter").is_some() {
+        errors.push(format!(
+            "{NEXTEST_CONFIG}: {place} sets default-filter; [profile.{GATE_PROFILE}] runs the deep tier for CI and `make test-rust` on every platform"
+        ));
+    }
+    if setting.get("run-extra-args").is_some() {
+        errors.push(format!(
+            "{NEXTEST_CONFIG}: {place} sets run-extra-args; arguments such as --skip or --ignored pass a deep-tier test without running it"
+        ));
+    }
+    if is_override && let Some(table) = setting.as_table() {
+        for key in table.keys().filter(|key| {
+            !GATE_OVERRIDE_SETTINGS.contains(&key.as_str())
+                && !matches!(key.as_str(), "default-filter" | "run-extra-args")
+        }) {
+            errors.push(format!(
+                "{NEXTEST_CONFIG}: {place} sets {key}; a [profile.{GATE_PROFILE}] override may set only {}",
+                GATE_OVERRIDE_SETTINGS.join(", ")
+            ));
+        }
+    }
+    errors
+}
+
+/// Every `[[profile.default.scripts]]` entry that wraps how a test is listed
+/// or run.
+fn gate_wrapper_problems(profile: &toml::Value) -> Vec<String> {
+    let Some(scripts) = profile.get("scripts").and_then(toml::Value::as_array) else {
+        return Vec::new();
+    };
+    let mut errors = Vec::new();
+    for (index, script) in scripts.iter().enumerate() {
+        for key in WRAPPER_SETTINGS {
+            if script.get(*key).is_some() {
+                errors.push(format!(
+                    "{NEXTEST_CONFIG}: [[profile.{GATE_PROFILE}.scripts]] #{} sets {key}; a wrapper could hide a deep-tier test or pass it without running it",
+                    index + 1
+                ));
+            }
+        }
+    }
+    errors
+}
+
+/// Whether `name`'s `inherits` chain reaches the quick profile.
+fn inherits_quick(name: &str, profiles: &toml::Table) -> bool {
+    let mut seen = HashSet::from([name]);
+    let mut current = name;
+    while let Some(parent) = profiles
+        .get(current)
+        .and_then(|profile| profile.get("inherits"))
+        .and_then(toml::Value::as_str)
+    {
+        if parent == QUICK_PROFILE {
+            return true;
+        }
+        if !seen.insert(parent) {
+            // nextest rejects the cycle itself.
+            return false;
+        }
+        current = parent;
+    }
+    false
+}
+
+fn is_quick_rule(line: &str) -> bool {
+    line.strip_prefix(QUICK_TARGET).is_some_and(|rest| {
+        let rest = rest.trim_start();
+        rest.starts_with(':') && !rest.starts_with(":=") && !rest.starts_with("::=")
+    })
+}
+
+/// Only the `test-quick` recipe may select the quick profile, and no other
+/// line may name `test-quick` except `.PHONY` and comments.
+fn check_makefile(text: &str) -> Vec<String> {
+    let mut errors = Vec::new();
+    let mut in_quick_recipe = false;
+    let mut saw_quick_rule = false;
+    let mut quick_recipe_selects_profile = false;
+    for (index, line) in text.lines().enumerate() {
+        let recipe = line.starts_with('\t');
+        if recipe && in_quick_recipe {
+            quick_recipe_selects_profile |= QUICK_PROFILE_SELECTION.is_match(line);
+            continue;
+        }
+        if !recipe {
+            let trimmed = line.trim_start();
+            if trimmed.is_empty() || trimmed.starts_with('#') || line.starts_with(".PHONY:") {
+                continue;
+            }
+            in_quick_recipe = is_quick_rule(line);
+            if in_quick_recipe {
+                saw_quick_rule = true;
+                continue;
+            }
+        }
+        if QUICK_TARGET_WORD.is_match(line) || QUICK_PROFILE_SELECTION.is_match(line) {
+            errors.push(format!(
+                "{MAKEFILE}:{}: only the `{QUICK_TARGET}` recipe may select the quick profile, and no other target may reach `{QUICK_TARGET}`",
+                index + 1
+            ));
+        }
+    }
+    if !(saw_quick_rule && quick_recipe_selects_profile) {
+        errors.push(format!(
+            "{MAKEFILE}: the `{QUICK_TARGET}` target must run the quick nextest profile"
+        ));
+    }
+    errors
+}
+
+/// Lines of a CI source that select the quick tier, hand nextest another
+/// config file, or read the manifest.
+fn gate_source_problems(path: &str, text: &str) -> Vec<String> {
+    text.lines()
+        .enumerate()
+        .filter(|(_, line)| {
+            QUICK_PROFILE_SELECTION.is_match(line)
+                || QUICK_TARGET_WORD.is_match(line)
+                || CONFIG_FILE_FLAG.is_match(line)
+                || line.contains("deep-only-tests.tsv")
+        })
+        .map(|(index, _)| {
+            format!(
+                "{path}:{}: CI runs the deep tier only; it may not select the quick tier, hand nextest another config file, or read the quick manifest",
+                index + 1
+            )
+        })
+        .collect()
+}
+
+fn check_gate_sources(root: &Path) -> Result<Vec<String>> {
+    let output = Command::new("git")
+        .args(["ls-files", "-z", "--"])
+        .args(GATE_TREES)
+        .current_dir(root)
+        .output()
+        .context("listing tracked CI sources")?;
+    if !output.status.success() {
+        bail!(
+            "git ls-files failed: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+    }
+    let mut errors = Vec::new();
+    for relative in output.stdout.split(|byte| *byte == 0) {
+        let relative = String::from_utf8_lossy(relative);
+        if relative.is_empty() || relative == MANIFEST {
+            continue;
+        }
+        // A binary or deleted tracked file cannot name a profile.
+        let Ok(text) = fs::read_to_string(root.join(&*relative)) else {
+            continue;
+        };
+        errors.extend(gate_source_problems(&relative, &text));
+    }
+    Ok(errors)
+}
