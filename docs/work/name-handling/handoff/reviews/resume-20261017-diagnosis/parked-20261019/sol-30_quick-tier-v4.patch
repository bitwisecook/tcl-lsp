+/// The libtest paths of the `#[test]` functions in a target's module tree.
+#[derive(Default)]
+struct TestWalk {
+    visited: HashSet<(PathBuf, String)>,
+    found: BTreeSet<String>,
+}
+
+fn child_path(prefix: &str, name: &str) -> String {
+    if prefix.is_empty() {
+        name.to_owned()
+    } else {
+        format!("{prefix}::{name}")
+    }
+}
+
+impl TestWalk {
+    fn file(&mut self, source: &Path, directory: &Path, prefix: &str) -> Result<()> {
+        if !self
+            .visited
+            .insert((source.to_path_buf(), prefix.to_owned()))
+        {
+            return Ok(());
+        }
+        let text = fs::read_to_string(source)
+            .with_context(|| format!("reading Rust module {}", source.display()))?;
+        let parsed = syn::parse_file(&text)
+            .with_context(|| format!("parsing Rust module {}", source.display()))?;
+        self.items(source, directory, prefix, &parsed.items)
+    }
+
+    fn items(
+        &mut self,
+        source: &Path,
+        directory: &Path,
+        prefix: &str,
+        items: &[syn::Item],
+    ) -> Result<()> {
+        for item in items {
+            match item {
+                syn::Item::Fn(function) if has_test_attribute(&function.attrs) => {
+                    self.found
+                        .insert(child_path(prefix, &function.sig.ident.unraw().to_string()));
+                }
+                syn::Item::Mod(module) => {
+                    let module_path = child_path(prefix, &module.ident.unraw().to_string());
+                    if let Some((_, items)) = &module.content {
+                        for child_directory in inline_module_directories(module, directory) {
+                            self.items(source, &child_directory, &module_path, items)?;
+                        }
+                    } else {
+                        for (child, child_directory) in module_sources(module, directory) {
+                            self.file(&child, &child_directory, &module_path)?;
+                        }
+                    }
+                }
+                syn::Item::Macro(item_macro) if is_builtin_include_macro(&item_macro.mac.path) => {
+                    if let Ok(literal) = syn::parse2::<syn::LitStr>(item_macro.mac.tokens.clone()) {
+                        self.include(source, &literal.value(), prefix)?;
+                    }
+                }
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+
+    fn include(&mut self, source: &Path, path: &str, prefix: &str) -> Result<()> {
+        let parent = source
+            .parent()
+            .with_context(|| format!("Rust source has no parent: {}", source.display()))?;
+        let included = lexically_normalise(&parent.join(path));
+        if !included.is_file() {
+            return Ok(());
+        }
+        let text = fs::read_to_string(&included)
+            .with_context(|| format!("reading Rust include {}", included.display()))?;
+        // An expression- or statement-only include cannot declare a test.
+        let Ok(parsed) = syn::parse_file(&text) else {
+            return Ok(());
+        };
+        if !self.visited.insert((included.clone(), prefix.to_owned())) {
+            return Ok(());
+        }
+        let directory = included
+            .parent()
+            .map_or_else(|| parent.to_path_buf(), Path::to_path_buf);
+        self.items(&included, &directory, prefix, &parsed.items)
+    }
+}
+
+fn target_tests(source: &Path) -> Result<BTreeSet<String>> {
+    let directory = source
+        .parent()
+        .with_context(|| format!("Cargo target source has no parent: {}", source.display()))?;
+    let mut walk = TestWalk::default();
+    walk.file(source, directory, "")?;
+    Ok(walk.found)
+}
+
+fn check_rows_exist(packages: &[Package], rows: &[Row]) -> Result<Vec<String>> {
+    let mut errors = Vec::new();
+    let mut inventories: HashMap<PathBuf, BTreeSet<String>> = HashMap::new();
+    for row in rows {
+        let Some(package) = packages.iter().find(|package| package.name == row.package) else {
+            errors.push(format!(
+                "{MANIFEST}:{}: no workspace package {}",
+                row.line, row.package
+            ));
+            continue;
+        };
+        let Some(target) = package
+            .targets
+            .iter()
+            .find(|target| target.name == row.target && target.has_kind(&row.kind))
+        else {
+            errors.push(format!(
+                "{MANIFEST}:{}: {} has no {} target {}",
+                row.line, row.package, row.kind, row.target
+            ));
+            continue;
+        };
+        if !target.test {
+            errors.push(format!(
+                "{MANIFEST}:{}: {} target {} sets test = false, so no harness runs it",
+                row.line, row.kind, row.target
+            ));
+            continue;
+        }
+        let tests = match inventories.entry(target.src_path.clone()) {
+            Entry::Occupied(entry) => entry.into_mut(),
+            Entry::Vacant(entry) => entry.insert(target_tests(&target.src_path)?),
+        };
+        if !tests.contains(&row.test) {
+            errors.push(format!(
+                "{MANIFEST}:{}: {} declares no #[test] {}; update or remove the row",
+                row.line,
+                row.binary_id(),
+                row.test
+            ));
+        }
+    }
+    Ok(errors)
+}
+
+/// Check the deep-only manifest contract, or regenerate the quick filter.
+pub fn run(operation: &str) -> Result<ExitCode> {
+    let root = repo_root();
+    let manifest =
+        fs::read_to_string(root.join(MANIFEST)).with_context(|| format!("reading {MANIFEST}"))?;
+    let rows = parse_manifest(&manifest)?;
+    let config_path = root.join(NEXTEST_CONFIG);
+    let config =
+        fs::read_to_string(&config_path).with_context(|| format!("reading {NEXTEST_CONFIG}"))?;
+    match operation {
+        "sync" => {
+            let rendered =
+                replace_generated_region(&config, GENERATED_REGION, &generated_region(&rows))?;
+            if write_if_changed(&config_path, rendered)? {
+                println!("updated the quick filter in {NEXTEST_CONFIG}");
+            } else {
+                println!("the quick filter in {NEXTEST_CONFIG} is current");
+            }
+        }
+        "check" => {
+            let mut errors = check_rows_exist(&workspace_packages(&root)?, &rows)?;
+            errors.extend(check_nextest_config(&config, &rows));
+            let makefile = fs::read_to_string(root.join(MAKEFILE))
+                .with_context(|| format!("reading {MAKEFILE}"))?;
+            errors.extend(check_makefile(&makefile));
+            errors.extend(check_gate_sources(&root)?);
+            if !errors.is_empty() {
+                bail!("deep-only manifest contract failed:\n{}", errors.join("\n"));
+            }
+            println!(
+                "deep-only manifest: {} rows name existing tests, the quick filter is current, and no gate selects the quick tier",
+                rows.len()
+            );
+        }
+        _ => bail!("unknown deep-only-tests operation '{operation}'; expected check or sync"),
+    }
+    Ok(ExitCode::SUCCESS)
+}
