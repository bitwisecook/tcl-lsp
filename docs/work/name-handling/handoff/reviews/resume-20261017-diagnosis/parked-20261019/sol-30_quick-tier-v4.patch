+            "#[cfg(test)] mod tests { #[test] fn a() {} #[tokio::test] async fn b() {} fn helper() {} mod inner { #[test] fn c() {} } }\n#[test] fn top() {}\n",
+        )
+        .unwrap();
+        let mut walk = TestWalk::default();
+        walk.items(
+            Path::new("lib.rs"),
+            Path::new("missing-directory"),
+            "",
+            &parsed.items,
+        )
+        .unwrap();
+        assert_eq!(
+            walk.found.into_iter().collect::<Vec<_>>(),
+            ["tests::a", "tests::b", "tests::inner::c", "top"]
+        );
+    }
+}
