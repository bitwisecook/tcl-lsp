+/// `wrappers` levels of `outer`, then `proc p {} {…}` whose body nests
+/// `depth` levels of `inner` around `set x 1`.
+fn nested_proc_source(outer: &str, wrappers: usize, inner: &str, depth: usize) -> String {
+    let mut source = String::new();
+    for _ in 0..wrappers {
+        source.push_str(outer);
+        source.push('\n');
+    }
+    source.push_str("proc p {} {\n");
+    for _ in 0..depth {
+        source.push_str(inner);
+        source.push('\n');
+    }
+    source.push_str("set x 1\n");
+    // The inner levels, the proc body, then the wrappers.
+    for _ in 0..depth + 1 + wrappers {
+        source.push_str("}\n");
+    }
+    source
+}
+
+/// Depth of the deepest scope below `scope` (0 for a leaf).
+fn scope_depth(scope: &tcl_compiler::analyser::types::Scope) -> usize {
+    scope
+        .children
+        .iter()
+        .map(|child| 1 + scope_depth(child))
+        .max()
+        .unwrap_or(0)
+}
+
+/// The braced-body cap must trip at the same *document* depth on both paths.
+/// The per-item shell defers every proc body and analyses it in a separate
+/// walk, which therefore starts from the depth the shell found the body at
+/// (`DeferredBody::body_depth`). Restarting at 0 let a proc nested part-way
+/// down the cap analyse its body in full, without the `E207` the whole-file
+/// walk reports, and graft a scope tree deeper than one whole-file walk can
+/// build.
+///
+/// Each case nests a `proc` part-way down the cap and its body the rest of
+/// the way past it, so neither half reaches the cap alone. The shapes cover
+/// plain control flow and the two scope-opening body walks a proc body can
+/// chain (`uplevel`, `namespace eval`), under `if` and `namespace eval`
+/// wrappers. Runs on a 64 MiB thread like the production entry points: the
+/// subject is per-item ≡ whole-file, not the stack budget, which
+/// `depth_guard` owns.
+#[test]
+fn per_item_matches_analyse_past_the_nesting_cap_inside_a_proc() {
+    std::thread::Builder::new()
+        .stack_size(64 * 1024 * 1024)
+        .spawn(|| {
+            let dialect = "tcl8.6";
+            let cap = usize::try_from(tcl_compiler::MAX_SOURCE_NEST_DEPTH.0)
+                .expect("the cap fits a usize");
+            let half = cap / 2 + 4;
+
+            // Control: the same body with the proc at the top level stays
+            // under the cap and on the per-item fast path, so the deep cases
+            // below are decided by the depth seed and not by another
+            // fallback.
+            let shallow = nested_proc_source("if {1} {", 0, "if {1} {", half);
+            let mut analyser = Analyser::new();
+            let got = analyser.analyse_per_item(&shallow, dialect);
+            assert!(
+                analyser.per_item_fallback.is_none(),
+                "the control fixture must stay on the per-item fast path, or this test \
+                 cannot see the depth seed: {:?}",
+                analyser.per_item_fallback
+            );
+            assert!(!got.diagnostics.iter().any(|d| d.code == DiagCode::E207));
+
+            for (name, outer, inner) in [
+                ("if inside a proc inside if", "if {1} {", "if {1} {"),
+                (
+                    "uplevel inside a proc inside namespace eval",
+                    "namespace eval n {",
+                    "uplevel 1 {",
+                ),
+                (
+                    "namespace eval inside a proc inside if",
+                    "if {1} {",
+                    "namespace eval m {",
+                ),
+            ] {
+                let source = nested_proc_source(outer, half, inner, half);
+                let want = Analyser::new().analyse(&source, dialect);
+                let got = Analyser::new().analyse_per_item(&source, dialect);
+                assert!(
+                    want.diagnostics.iter().any(|d| d.code == DiagCode::E207),
+                    "{name}: the whole-file walk must pass the cap"
+                );
+                assert!(
+                    got.diagnostics.iter().any(|d| d.code == DiagCode::E207),
+                    "{name}: the per-item walk must report the same E207"
+                );
+                assert_eq!(
+                    scope_depth(&got.global_scope),
+                    scope_depth(&want.global_scope),
+                    "{name}: scope tree depth"
+                );
+                assert!(
+                    scope_depth(&want.global_scope) <= cap + 1,
+                    "{name}: one whole-file walk stops one scope past the cap"
+                );
+                assert!(
+                    got == want,
+                    "{}",
+                    describe_analysis_divergence(name, &got, &want)
+                );
+            }
+        })
+        .expect("spawn the test thread")
+        .join()
+        .expect("the test thread panicked");
+}
