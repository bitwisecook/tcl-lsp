+            HostTclInputs::fixed(vec![core_tcl_install::TclInstallation {
+                version: "8.6".to_owned(),
+                tcl_library: lib_root.join("tcl8.6"),
+                auto_path: vec![lib_root.clone()],
+            }]),
+        );
+        let last_rebuild = || {
+            backend
+                .index_surveys
