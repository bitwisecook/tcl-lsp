+/// One rebuild's record, exactly: every visited directory surveyed afresh when
+/// the rebuild dropped the kept surveys, otherwise `fresh` of them afresh and
+/// the rest reused.
+fn assert_rebuild(stats: RebuildSurveys, visited: u64, fresh: u64) {
+    let expected = if stats.cleared_for_registries {
+        (visited, 0)
+    } else {
+        (fresh, visited - fresh)
+    };
+    assert_eq!((stats.fresh, stats.reused), expected, "{stats:?}");
+}
+
+#[test]
+fn an_unchanged_rescan_surveys_no_directory_again() {
+    tcl_spectcl::core_surfaces::ensure();
+    let store = host_library_store();
+    let lib = Path::new(HOST_LIBRARY);
+    let mut surveys = IndexSurveyCache::new();
+
+    // The library directory and its two subdirectories.
+    rebuild_reusing(&store, &mut surveys);
+    assert_eq!(
+        surveys.last_rebuild(),
+        RebuildSurveys {
+            cleared_for_registries: true,
+            fresh: 3,
+            reused: 0,
+        }
+    );
+    rebuild_reusing(&store, &mut surveys);
+    assert_rebuild(surveys.last_rebuild(), 3, 0);
+
+    assert!(store.remove(&lib.join("autolib/autolib.tcl")));
+    rebuild_reusing(&store, &mut surveys);
+    assert_rebuild(surveys.last_rebuild(), 3, 1);
+
+    store.upsert(
+        lib.join("hostpkg/pkgIndex.tcl"),
+        "package ifneeded hostpkg 2.0 [list source [file join $dir hostpkg.tcl]]\n",
+    );
+    rebuild_reusing(&store, &mut surveys);
+    assert_rebuild(surveys.last_rebuild(), 3, 1);
