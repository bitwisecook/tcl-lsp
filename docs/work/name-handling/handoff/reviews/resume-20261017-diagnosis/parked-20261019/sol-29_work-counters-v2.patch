+    /// Deep tier only: it evaluates every shipped pack, about 18 s per process
+    /// unoptimised. The probe test below carries the same contract quickly.
+    #[test]
+    fn a_reload_evaluates_each_shipped_pack_once_per_process() {
+        let _cache = cache_guard();
+        let files = discover(&DiscoveryOptions {
+            bundled_dir: Some(PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../specs")),
+            skip_user_tier: true,
+            ..DiscoveryOptions::default()
+        });
+        let shipped = files
+            .iter()
+            .filter(|file| file.tier == Tier::Bundled)
+            .count();
+        assert!(shipped > 0, "the repository ships bundled packs");
+
+        let (cold, cold_evaluations) =
+            crate::cache::count_fresh_bundled_evaluations(|| load_discovered(&files));
+        let (warm, warm_evaluations) =
+            crate::cache::count_fresh_bundled_evaluations(|| load_discovered(&files));
+
+        if crate::cache::disabled() {
+            assert_eq!((cold_evaluations, warm_evaluations), (shipped, shipped));
+        } else {
+            // An earlier test in this process may already have memoised a
+            // shipped pack; none is ever evaluated twice.
+            assert!(
+                cold_evaluations <= shipped,
+                "the first load evaluates each shipped pack at most once"
+            );
+            assert_eq!(
+                warm_evaluations, 0,
+                "a reload of unchanged shipped packs evaluates none of them again"
+            );
+        }
+        assert_eq!(whole(&cold), whole(&warm));
+    }
+
+    #[test]
+    fn a_bundled_pack_is_evaluated_again_only_when_its_bytes_change() {
+        let _cache = cache_guard();
+        let probe = ProbeDir::new();
+        probe.write(1);
+        let files = probe.files();
+
+        let (_, cold) = crate::cache::count_fresh_bundled_evaluations(|| load_discovered(&files));
+        let (_, warm) = crate::cache::count_fresh_bundled_evaluations(|| load_discovered(&files));
+        probe.write(2);
+        let (_, edited) = crate::cache::count_fresh_bundled_evaluations(|| load_discovered(&files));
+
+        let expected = if crate::cache::disabled() {
+            (1, 1, 1)
+        } else {
+            (1, 0, 1)
+        };
+        assert_eq!((cold, warm, edited), expected);
+    }
 }
