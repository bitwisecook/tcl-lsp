+        sys.write(
+            "lib/hostpkg/pkgIndex.tcl",
+            "package ifneeded hostpkg 1.0 [list source [file join $dir hostpkg.tcl]]\n",
+        );
+        sys.write("lib/hostpkg/hostpkg.tcl", "package provide hostpkg 1.0\n");
