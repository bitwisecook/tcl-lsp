+            let stats = last_rebuild();
+            let expected = if stats.cleared_for_registries {
+                (visited, 0)
+            } else {
+                (fresh_when_kept, visited - fresh_when_kept)
+            };
+            assert_eq!((stats.fresh, stats.reused), expected, "{stats:?}");
+        };
+
+        backend.scan_workspace_folders().await.unwrap();
