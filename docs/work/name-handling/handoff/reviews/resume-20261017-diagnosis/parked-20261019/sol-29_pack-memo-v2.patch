+                .find_map(|pack| pack.command(&command))
+                .map(|command| command.spec.arity.min)
+        }
+    }
+
+    impl Drop for ProbeDir {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_dir_all(&self.root);
+        }
+    }
+
+    #[test]
+    fn a_reloaded_bundled_pack_is_the_pack_a_fresh_evaluation_gives() {
+        let _cache = cache_guard();
+        let probe = ProbeDir::new();
+        probe.write(1);
+        let files = probe.files();
+
+        let first = load_discovered(&files);
+        let source = std::fs::read_to_string(&files[0].path).unwrap();
+        if let Some(key) =
+            crate::cache::bundled_snapshot_key(&source, Tier::Bundled, WorkspaceTrust::Trusted)
+        {
+            assert!(
+                crate::cache::bundled_snapshot(&key, &source).is_some(),
+                "a bundled pack that asked for no include is memoised"
+            );
+        }
+        let memoised = load_discovered(&files);
+        let fresh = {
+            let _off = CacheOff::new(probe.root.join("cache"));
+            load_discovered(&files)
+        };
+        assert_eq!(whole(&first), whole(&memoised));
+        assert_eq!(whole(&memoised), whole(&fresh));
+
+        probe.write(2);
+        let edited = load_discovered(&files);
+        assert_eq!(
+            (probe.arity(&memoised), probe.arity(&edited)),
+            (Some(1), Some(2)),
+            "edited bytes are evaluated again"
+        );
+    }
+
+    #[test]
+    fn a_failed_bundled_load_is_never_memoised() {
+        let _cache = cache_guard();
