+/// The in-memory tier for bundled-tier packs loaded through an `include`
+/// resolver, which is how [`crate::pack`]'s merge loads every file and so how
+/// every LSP reload loads the shipped loadables: each finished [`Pack`] with
+/// the exact source it was evaluated from, by snapshot identity.
+///
+/// [`evaluate_pack_including`] bypasses [`SNAPSHOT`] because an included file
+/// can change under an unchanged root. A pack whose evaluation never asked its
+/// resolver read nothing but its own bytes, so it is the same pure function
+/// of `(source, tier, trust)` that [`SNAPSHOT`] memoises, and only such a pack
+/// is kept. Only the bundled tier is kept: its bytes do not change under a
+/// running server, yet every configuration change, trust push and Studio
+/// publication reloads it, so the tier stays bounded by the packs that ship.
+/// A hit also compares the source byte for byte, so a hash collision cannot
+/// answer for another pack.
+static BUNDLED_SNAPSHOT: LazyLock<Mutex<HashMap<EvalSnapshotKey, (Box<str>, Pack)>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+/// The identity a bundled-tier pack loaded through an `include` resolver is
+/// memoised under, or `None` when [`BUNDLED_SNAPSHOT`] may not answer for it:
+/// another tier, or the cache switched off.
+pub(crate) fn bundled_snapshot_key(
+    source: &str,
+    tier: Tier,
+    trust: WorkspaceTrust,
+) -> Option<EvalSnapshotKey> {
+    (tier == Tier::Bundled && !disabled())
+        .then(|| eval_snapshot_key(source, &options_for(tier, trust)))
+}
+
+/// The bundled pack memoised under `key` for exactly `source`, if one is.
+pub(crate) fn bundled_snapshot(key: &EvalSnapshotKey, source: &str) -> Option<Pack> {
+    let snapshots = BUNDLED_SNAPSHOT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let (held, pack) = snapshots.get(key)?;
+    (&**held == source).then(|| pack.clone())
+}
+
+/// Memoise a bundled pack freshly evaluated from `source` that asked for no
+/// `include`. A target-dependent pack (design E-R1) is never kept, and nor is
+/// one whose load failed: the wall-clock budget is not a function of the
+/// source, so the next reload must evaluate it again.
+pub(crate) fn retain_bundled_snapshot(key: EvalSnapshotKey, source: &str, pack: &Pack) {
+    if pack.target_dependent || pack.load_error.is_some() {
+        return;
+    }
+    BUNDLED_SNAPSHOT
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .insert(key, (source.into(), pack.clone()));
+}
