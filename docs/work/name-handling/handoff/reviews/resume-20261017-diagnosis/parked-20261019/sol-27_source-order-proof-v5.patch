+    // Proof-grade source order (import-order-source-graph.md §8.2). tclsh
+    // 8.4.20–9.1.0, with `main.tcl` importing and calling the command: a
+    // loader that sources the export first gives SRC; a conditional, caught
+    // or procedure-local source, a possible early exit before the export, a
+    // `namespace eval` around the source, sourcing `main.tcl` before the
+    // export, running `main.tcl` alone and a relative path run from another
+    // directory holding a different `exports.tcl` give LOCAL. A file entered
+    // from two sites has no single position and is never ranked.
+
+    /// The export every proof test below places.
+    const PROOF_EXPORTS: &str = "namespace eval ::src {namespace export helper}\n";
+
+    /// The import every proof test below places.
+    const PROOF_IMPORTS: &str = "namespace eval ::app {namespace import ::src::*}\n";
+
+    /// `source` of `file` beside the sourcing document, in the anchored form
+    /// the decided working-directory premise admits.
+    fn source_beside(file: &str) -> String {
+        format!("source [file join [file dirname [info script]] {file}]")
+    }
+
+    /// The plain loader: `exports.tcl`, then `main.tcl`, both anchored.
+    fn plain_loader() -> String {
+        format!(
+            "{}\n{}\n",
+            source_beside("exports.tcl"),
+            source_beside("main.tcl")
+        )
+    }
+
+    /// What the run order proves about `exports`' `namespace export` against
+    /// `main.tcl`'s `namespace import`, with `loaders` indexed beside them.
+    fn proven_order(exports: &str, loaders: &[(&str, &str)]) -> Option<bool> {
+        proven_order_with(exports, PROOF_IMPORTS, loaders)
+    }
+
+    /// [`proven_order`] with `imports` as `main.tcl`. The navigation relation
+    /// stays conditional whatever the proof says, and no foreign pair is
+    /// ever proven the other way round.
+    fn proven_order_with(exports: &str, imports: &str, loaders: &[(&str, &str)]) -> Option<bool> {
+        proven_order_in(
+            "tcl8.6",
+            exports,
+            imports,
+            loaders,
+            &crate::source_graph::SourceOrderConfiguration::default(),
+        )
+    }
+
+    /// [`proven_order_with`] analysed under `environment`, with the host's
+    /// entry-script `configuration` installed.
+    fn proven_order_in(
+        environment: &str,
+        exports: &str,
+        imports: &str,
+        loaders: &[(&str, &str)],
+        configuration: &crate::source_graph::SourceOrderConfiguration,
+    ) -> Option<bool> {
+        let profile =
+            tcl_registry::model::ingress::resolve_environment(environment).analyser_profile();
+        let exported = analyse_as(exports, profile);
+        let imported = analyse_as(imports, profile);
+        let loaders = loaders
+            .iter()
+            .map(|(uri, source)| (*uri, analyse_as(source, profile)))
+            .collect::<Vec<_>>();
+        let mut index = sourced_index(
+            [
+                ("file:///p/exports.tcl", &exported),
+                ("file:///p/main.tcl", &imported),
+            ]
+            .into_iter()
+            .chain(loaders.iter().map(|(uri, analysis)| (*uri, analysis))),
+        );
+        index.set_source_order_configuration(configuration.clone());
+        let point = |uri, source: &str, needle: &str| RunPoint {
+            uri,
+            at: u32::try_from(source.find(needle).expect("needle present"))
+                .expect("tiny test source"),
+            enclosing_body: None,
+        };
+        let export = point("file:///p/exports.tcl", exports, "namespace export");
+        let import = point("file:///p/main.tcl", imports, "namespace import");
+        let order = index.run_order();
+        assert!(
+            order
+                .navigation_precedence(export, import)
+                .is_none_or(|relation| relation.modeled_source_exclusion().is_none())
+        );
+        assert_eq!(order.proven_precedes(import, export), None);
+        order.proven_precedes(export, import)
+    }
