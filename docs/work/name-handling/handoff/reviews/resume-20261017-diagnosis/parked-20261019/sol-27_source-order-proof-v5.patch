+/// What the proof-grade source order needs to know about every command of
+/// one document, definition bodies and callbacks included
+/// ([`RunOrder::with_entry_proof`]). Commands are classified from their
+/// selected Registry facts, never their spelling.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+struct ProofInventory {
+    /// Start of every command whose transitions may delete a namespace.
+    namespace_deletions: Vec<u32>,
+    /// Every command that may enter another file: its body execution
+    /// evaluates a file, it loads an external unit, or it requires a package.
+    entering_commands: Vec<tcl_lexer::Span>,
+    /// Some command may evaluate code this inventory does not retain: a
+    /// dynamic command word, a script operand that is not one retained
+    /// literal script, a concatenated script of several words, a command
+    /// prefix or retained callback, an alias, a command binding or rename
+    /// whose operands are dynamic, a change of the working directory, or
+    /// Registry words whose schema cannot be read.
+    opaque: bool,
+    /// Literal command-word tails of commands with selected Registry words.
+    registry_heads: Vec<Vec<u8>>,
+    /// Literal command-word tails of every other command. Each must name a
+    /// procedure or class some indexed document declares.
+    other_heads: Vec<Vec<u8>>,
+    /// Tails a rename may move a command to.
+    moved_to: Vec<Vec<u8>>,
+    /// Tails of the procedures and classes this document declares.
+    declared: Vec<Vec<u8>>,
+    /// The document may be run as a script of its own: a `#!` line, or a
+    /// read of the variable the interpreter binds to the script name
+    /// (`[info script] eq $argv0`).
+    entry_script_marker: bool,
+    /// Retained script regions by start, outermost first; dropped once the
+    /// document is classified.
+    regions: Vec<tcl_lexer::Span>,
+}
+
+/// One command's selected Registry facts, as [`ProofInventory`] reads them.
+#[derive(Debug, Default)]
+struct ProofEffects {
+    deletes_namespace: bool,
+    enters_file: bool,
+    opaque: bool,
+    moved_to: Vec<Vec<u8>>,
+}
+
+impl ProofEffects {
+    /// A schema that cannot be borrowed may do anything.
+    fn unknown() -> Self {
+        Self {
+            deletes_namespace: true,
+            enters_file: true,
+            opaque: true,
+            moved_to: Vec::new(),
+        }
+    }
+
+    fn note(&mut self, transition: &tcl_registry::StateTransition) {
+        use tcl_registry::model::binding::{PackageResolverDependency, PackageTransition};
+        use tcl_registry::{
+            CommandBindingTransition, NamespaceTransition, StateTransition, StateTransitionDomain,
+        };
+        match transition {
+            StateTransition::Namespace(NamespaceTransition::Delete { .. }) => {
+                self.deletes_namespace = true;
+            }
+            StateTransition::Widen(widening) => {
+                self.deletes_namespace |= widening
+                    .domains
+                    .contains(&StateTransitionDomain::Namespaces);
+                self.opaque |= widening
+                    .domains
+                    .contains(&StateTransitionDomain::CommandBindings);
+            }
+            StateTransition::CommandBinding(
+                CommandBindingTransition::Alias { .. } | CommandBindingTransition::Unknown { .. },
+            )
+            | StateTransition::Package(PackageTransition::DiscoveryDependencyChanged {
+                dependency:
+                    PackageResolverDependency::WorkingDirectory | PackageResolverDependency::ScriptPath,
+            }) => self.opaque = true,
+            StateTransition::CommandBinding(CommandBindingTransition::Move { to, .. }) => {
+                match ProofInventory::subject_tail(to) {
+                    Some(tail) => self.moved_to.push(tail),
+                    None => self.opaque = true,
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+impl ProofInventory {
+    fn new(
+        source: &str,
+        analysis: &tcl_compiler::analyser::AnalysisResult,
+        input: &tcl_compiler::analyser::ResolvedAnalysisInput,
+        structure: &crate::source_structure::SourceStructure,
+    ) -> Self {
+        let mut regions = structure
+            .scripts
+            .iter()
+            .map(|(span, _)| *span)
+            .collect::<Vec<_>>();
+        regions.sort_by_key(|span| (span.start(), std::cmp::Reverse(span.end())));
+        Self {
+            declared: analysis
+                .original_procedure_declarations()
+                .map(|record| record.name().slot().simple.as_bytes().to_vec())
+                .chain(
+                    analysis
+                        .original_class_declarations()
+                        .map(|record| record.name().slot().simple.as_bytes().to_vec()),
+                )
+                .collect(),
+            entry_script_marker: source.starts_with("#!")
+                || Self::reads_script_name(analysis, input),
+            regions,
+            ..Self::default()
+        }
+    }
+
+    /// Whether the document names the variable the interpreter binds to the
+    /// script name (`argv0`, the `[info script] eq $argv0` guard). Where an
+    /// unqualified namespace variable falls back to the global one (C Tcl
+    /// before 9.0), its name in any namespace counts.
+    fn reads_script_name(
+        analysis: &tcl_compiler::analyser::AnalysisResult,
+        input: &tcl_compiler::analyser::ResolvedAnalysisInput,
+    ) -> bool {
