+            .and_then(|context| context.load_command(query.at))
+        else {
+            return false;
+        };
+        let mut earlier = event_command;
+        for (depth, document) in event_path[..event_depth].iter().enumerate() {
+            let entering = depth > 0;
+            if !contexts
+                .get(*document)
+                .is_some_and(|context| context.completes_through(earlier, entering))
+            {
+                return false;
+            }
+            earlier = entries[*document].command;
+        }
+        let later = query_path[..query_depth]
+            .last()
+            .map_or(query_command, |document| entries[*document].command);
+        common.sequence_position(earlier.start())
+            && common.sequence_position(later.start())
+            && earlier.end() <= later.start()
