+            .iter()
+            .map(|(uri, source)| (*uri, analyse(source)))
+            .collect::<Vec<_>>();
+        let index = sourced_index(
+            std::iter::once((main_uri, &main))
+                .chain(others.iter().map(|(uri, analysis)| (*uri, analysis))),
+        );
+        let main = analyse_with_index_facts(&index, main_uri, main_source);
+        let call = u32::try_from(main_source.rfind("    helper\n").expect("call present") + 4)
