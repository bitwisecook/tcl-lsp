+/// `info script filename` overrides what `[info script]` returns for the
+/// rest of the active evaluation (tclsh 8.4–9.1), re-pointing every path a
+/// script then builds from `[file dirname [info script]]`. The bare form
+/// only reads it.
+fn script_path_changed(arguments: InvocationArguments<'_>) -> StateTransitions {
+    let mut transitions = StateTransitions::default();
+    if arguments.len() > 1 {
+        transitions.push(StateTransition::Package(
+            crate::model::binding::PackageTransition::DiscoveryDependencyChanged {
+                dependency: crate::model::binding::PackageResolverDependency::ScriptPath,
+            },
+        ));
+    }
+    transitions
+}
