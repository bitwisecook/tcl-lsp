+    /// `uri` and the documents that provably entered it, nearest first, up
+    /// to the first one with no proven entry. None on a cycle.
+    fn proof_path<'a>(entries: &'a UriMap<ProofEntry>, uri: &'a str) -> Option<Vec<&'a str>> {
+        let mut path = vec![uri];
+        let mut cursor = uri;
+        while let Some(entry) = entries.get(cursor) {
+            cursor = entry.parent.as_str();
+            if path.contains(&cursor) {
+                return None;
+            }
+            path.push(cursor);
+        }
+        Some(path)
+    }
