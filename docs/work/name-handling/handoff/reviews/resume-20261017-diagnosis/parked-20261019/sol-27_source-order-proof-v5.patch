+/// Every workspace folder with its configured `[project] entryPoints`, as
+/// the workspace index's proof-grade source order starts from them. An entry
+/// the server cannot map to a document stays in the list unplaced, so that
+/// folder proves nothing.
+fn source_order_configuration(
+    folders: &[(Uri, FolderConfig)],
+) -> tcl_lsp_core::source_graph::SourceOrderConfiguration {
+    folders.iter().fold(
+        tcl_lsp_core::source_graph::SourceOrderConfiguration::default(),
+        |configuration, (folder, fc)| {
+            let root = folder.to_file_path();
+            let entries = fc
+                .entry_points
+                .as_ref()
+                .filter(|entries| !entries.is_empty())
+                .map(|entries| {
+                    entries
+                        .iter()
+                        .map(|entry| entry_point_uri(entry, root.as_deref()))
+                        .collect()
+                });
+            configuration.with_folder(folder.as_str(), entries)
+        },
+    )
+}
