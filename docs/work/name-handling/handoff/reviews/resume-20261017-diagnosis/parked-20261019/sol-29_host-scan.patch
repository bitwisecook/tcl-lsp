+//! One directory's index survey, and the cache that carries surveys from one
+//! package-database rebuild to the next.
+//!
+//! Surveying a `pkgIndex.tcl` or `tclIndex` analyses it once plainly and once
+//! per C Tcl release, which makes it the costliest part of building the
+//! database. A rebuild after a configuration change or a watched index edit
+//! still visits every installed library on `auto_path`, nearly all of it
+//! unchanged. [`IndexSurveyCache`] keeps each directory's survey together with
+//! every store answer the survey depended on, and reuses it only when the store
+//! gives every one of those answers again.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use super::original_names::{
+    OriginalAutoIndexRow, original_pkg_index_entries, original_tcl_index_rows,
+};
+use super::{
+    AutoIndexEntry, OriginalPackageInfo, PackageInfo, PackageResolver, list_tcl_files,
+    parse_pkg_index, parse_tcl_index,
+};
+use crate::vfs::SourceStore;
+
+/// What one directory's index files contribute to a [`PackageResolver`].
+#[derive(Debug, Clone)]
+pub(super) struct DirectorySurvey {
+    pkg_index: Option<IndexSurvey<OriginalPackageInfo, PackageInfo>>,
+    tcl_indexes: Vec<IndexSurvey<OriginalAutoIndexRow, AutoIndexEntry>>,
+}
+
+/// One index file's original registrations and its authored entries.
+#[derive(Debug, Clone)]
+struct IndexSurvey<Original, Authored> {
+    original: Vec<Original>,
+    authored: Vec<Authored>,
+}
+
+impl DirectorySurvey {
+    /// Survey `dir` through `probe`: its `pkgIndex.tcl`, then each `tclIndex`
+    /// (matched case-insensitively) in the order the store lists them.
+    fn take(probe: &SurveyProbe<'_>, dir: &Path) -> Self {
+        let exists = |path: &Path| probe.is_file(path);
+        let list_files = |dir: &Path| probe.tcl_files(dir);
+        let pkg_index_path = dir.join("pkgIndex.tcl");
+        let pkg_index = if probe.is_file(&pkg_index_path)
+            && let Some(content) = probe.text(&pkg_index_path)
+        {
+            Some(IndexSurvey {
+                original: original_pkg_index_entries(
+                    &content,
+                    dir,
+                    &pkg_index_path,
+                    &exists,
+                    &list_files,
+                ),
+                authored: parse_pkg_index(&content, dir, &pkg_index_path, &exists, &list_files),
+            })
+        } else {
+            None
+        };
+        let tcl_indexes = probe
+            .tcl_indexes(dir)
+            .into_iter()
+            .flatten()
+            .filter_map(|index| {
+                let content = probe.text(&index)?;
+                let index_dir = index.parent().unwrap_or(dir);
+                Some(IndexSurvey {
+                    original: original_tcl_index_rows(&content, index_dir, &exists),
+                    authored: parse_tcl_index(&content, index_dir, &exists),
+                })
+            })
+            .collect();
+        Self {
+            pkg_index,
+            tcl_indexes,
+        }
+    }
+
+    /// Survey `dir` with nothing kept for reuse.
+    pub(super) fn of(store: &dyn SourceStore, dir: &Path) -> Self {
+        Self::take(&SurveyProbe::new(store, false), dir)
+    }
+}
+
+impl PackageResolver {
+    /// Record a directory's survey in the order a scan always has: each
+    /// index's original registrations before its authored entries.
+    pub(super) fn apply_survey(&mut self, survey: DirectorySurvey) {
+        if let Some(index) = survey.pkg_index {
+            self.insert_original_packages(index.original);
+            self.add_pkg_index(index.authored);
+        }
+        for index in survey.tcl_indexes {
+            self.insert_original_auto_index(index.original);
+            self.add_tcl_index(index.authored);
+        }
+    }
+}
+
+/// One store answer a survey depended on.
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
+enum SurveyInput {
+    /// [`SourceStore::is_file`].
+    IsFile(PathBuf, bool),
+    /// [`SourceStore::read_to_string`], `None` when it failed.
+    Text(PathBuf, Option<String>),
+    /// The `*.tcl` files listed directly in a directory.
+    TclFiles(PathBuf, Vec<PathBuf>),
+    /// A directory's `tclIndex` entries in listing order, `None` when it could
+    /// not be listed.
+    TclIndexes(PathBuf, Option<Vec<PathBuf>>),
+}
+
+impl SurveyInput {
+    /// Whether `store` still gives this answer.
+    fn holds(&self, store: &dyn SourceStore) -> bool {
+        match self {
+            Self::IsFile(path, answer) => store.is_file(path) == *answer,
+            Self::Text(path, answer) => store.read_to_string(path).ok() == *answer,
+            Self::TclFiles(dir, answer) => list_tcl_files(store, dir) == *answer,
+            Self::TclIndexes(dir, answer) => tcl_index_files(store, dir) == *answer,
+        }
+    }
+}
+
+/// The `tclIndex` entries of `dir` (`tclIndex` / `tclindex`), in the store's
+/// listing order.
+fn tcl_index_files(store: &dyn SourceStore, dir: &Path) -> Option<Vec<PathBuf>> {
+    let entries = store.read_dir(dir).ok()?;
+    Some(
+        entries
+            .into_iter()
+            .filter(|entry| {
+                entry
+                    .path
+                    .file_name()
+                    .is_some_and(|name| name.to_string_lossy().eq_ignore_ascii_case("tclindex"))
+            })
+            .map(|entry| entry.path)
+            .collect(),
+    )
+}
+
+/// The store as a survey asks it, recording each answer when asked to.
+struct SurveyProbe<'a> {
+    store: &'a dyn SourceStore,
+    inputs: Option<RefCell<Vec<SurveyInput>>>,
+}
+
+impl<'a> SurveyProbe<'a> {
+    fn new(store: &'a dyn SourceStore, record: bool) -> Self {
+        Self {
+            store,
+            inputs: record.then(|| RefCell::new(Vec::new())),
+        }
+    }
+
+    fn record(&self, input: SurveyInput) {
+        if let Some(inputs) = &self.inputs {
+            inputs.borrow_mut().push(input);
+        }
+    }
+
+    fn is_file(&self, path: &Path) -> bool {
+        let answer = self.store.is_file(path);
+        self.record(SurveyInput::IsFile(path.to_path_buf(), answer));
+        answer
+    }
+
+    fn text(&self, path: &Path) -> Option<String> {
+        let answer = self.store.read_to_string(path).ok();
+        self.record(SurveyInput::Text(path.to_path_buf(), answer.clone()));
+        answer
+    }
+
+    fn tcl_files(&self, dir: &Path) -> Vec<PathBuf> {
+        let answer = list_tcl_files(self.store, dir);
+        self.record(SurveyInput::TclFiles(dir.to_path_buf(), answer.clone()));
+        answer
+    }
+
+    fn tcl_indexes(&self, dir: &Path) -> Option<Vec<PathBuf>> {
+        let answer = tcl_index_files(self.store, dir);
+        self.record(SurveyInput::TclIndexes(dir.to_path_buf(), answer.clone()));
+        answer
+    }
+
+    /// Every distinct answer given, in a stable order.
+    fn into_inputs(self) -> Vec<SurveyInput> {
+        let mut inputs = self.inputs.map(RefCell::into_inner).unwrap_or_default();
+        inputs.sort();
+        inputs.dedup();
+        inputs
+    }
+}
+
+/// The command registries a survey analyses index files against, by identity.
+///
+/// Each is a `&'static` promoted once per registry generation and never freed,
+/// so an unchanged address is an unchanged generation; a pack reload that
+/// re-registers an environment moves it.
+#[derive(Debug, Default, PartialEq, Eq)]
+struct SurveyRegistries(Vec<usize>);
+
+impl SurveyRegistries {
+    fn current() -> Self {
+        use tcl_registry::model::ingress::{static_context_for, static_context_for_profile};
+        let mut addresses = vec![std::ptr::from_ref(static_context_for("tcl")).addr()];
+        for version in tcl_dialect::TclVersion::ALL {
+            addresses.push(std::ptr::from_ref(static_context_for(version.dialect_name())).addr());
+            if let Some(profile) = tcl_dialect::DialectProfile::find(version.dialect_name()) {
+                addresses.push(std::ptr::from_ref(static_context_for_profile(profile)).addr());
+            }
+        }
+        Self(addresses)
+    }
+}
+
+/// Directory index surveys carried from one package-database rebuild to the
+/// next.
+///
+/// Owned by whoever rebuilds the database; the language server keeps one per
+/// session. A survey is reused only when the same store gives every answer it
+/// was derived from again: the index files' exact text, each file the indexes
+/// name existing or not, and each directory listing they consulted. Any
+/// changed answer, an unreadable file included, means a fresh survey. The C
+/// Tcl releases a survey covers are fixed by the build; a change to the
+/// command registries it analyses against drops every kept survey.
+#[derive(Debug, Default)]
+pub struct IndexSurveyCache {
+    entries: HashMap<PathBuf, CachedSurvey>,
+    registries: SurveyRegistries,
+    rebuild: u64,
+}
+
+#[derive(Debug)]
+struct CachedSurvey {
+    inputs: Vec<SurveyInput>,
+    survey: DirectorySurvey,
+    rebuild: u64,
+}
+
+impl IndexSurveyCache {
+    /// An empty cache.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Start a rebuild. A directory not visited before
+    /// [`Self::finish_rebuild`] leaves the cache then, and every survey leaves
+    /// it now when the registries surveys analyse against have changed.
+    pub fn begin_rebuild(&mut self) {
+        self.rebuild += 1;
+        let registries = SurveyRegistries::current();
+        if registries != self.registries {
+            self.entries.clear();
+            self.registries = registries;
+        }
+    }
+
+    /// Drop every survey the rebuild since [`Self::begin_rebuild`] did not
+    /// visit.
+    pub fn finish_rebuild(&mut self) {
+        let rebuild = self.rebuild;
+        self.entries.retain(|_, entry| entry.rebuild == rebuild);
+    }
+
+    /// `dir`'s survey: the kept one when `store` still gives every answer it
+    /// was derived from, a fresh one otherwise. Called between
+    /// [`Self::begin_rebuild`] and [`Self::finish_rebuild`].
+    pub(super) fn survey(&mut self, store: &dyn SourceStore, dir: &Path) -> DirectorySurvey {
+        if let Some(entry) = self.entries.get_mut(dir)
+            && entry.inputs.iter().all(|input| input.holds(store))
+        {
+            entry.rebuild = self.rebuild;
+            return entry.survey.clone();
+        }
+        let probe = SurveyProbe::new(store, true);
+        let survey = DirectorySurvey::take(&probe, dir);
+        self.entries.insert(
+            dir.to_path_buf(),
+            CachedSurvey {
+                inputs: probe.into_inputs(),
+                survey: survey.clone(),
+                rebuild: self.rebuild,
+            },
+        );
+        survey
+    }
+}
