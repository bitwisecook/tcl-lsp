+/// Everything a scan put in the database except its revision, in a stable order.
+fn database_contents(resolver: &PackageResolver) -> Vec<String> {
+    fn rows<K: std::fmt::Debug, V: std::fmt::Debug>(
+        table: &str,
+        map: &std::collections::HashMap<K, V>,
+    ) -> impl Iterator<Item = String> {
+        map.iter()
+            .map(move |(key, value)| format!("{table} {key:?} {value:?}"))
+    }
+    let mut out: Vec<String> = rows("packages", &resolver.packages)
+        .chain(rows("auto_index", &resolver.auto_index))
+        .chain(rows("source_auto_index", &resolver.source_auto_index))
+        .chain(rows("original_packages", &resolver.original_packages))
+        .chain(rows("original_auto_index", &resolver.original_auto_index))
+        .collect();
+    out.sort();
+    out.push(format!("scanned {:?}", resolver.scanned_dirs));
+    out
+}
+
+const HOST_LIBRARY: &str = "/host/lib";
+
+/// An installed library: one package directory and one auto-load directory.
+fn host_library_store() -> crate::vfs::MemoryStore {
+    let store = crate::vfs::MemoryStore::new();
+    let lib = Path::new(HOST_LIBRARY);
+    store.upsert(
+        lib.join("hostpkg/pkgIndex.tcl"),
+        "package ifneeded hostpkg 1.0 [list source [file join $dir hostpkg.tcl]]\n",
+    );
+    store.upsert(
+        lib.join("hostpkg/hostpkg.tcl"),
+        "package provide hostpkg 1.0\n",
+    );
+    store.upsert(
+        lib.join("autolib/tclIndex"),
+        "# Tcl autoload index file: each line identifies a Tcl\nhostcmd autolib.tcl\n",
+    );
+    store.upsert(lib.join("autolib/autolib.tcl"), "proc hostcmd {} {}\n");
+    store
+}
+
+fn rebuild_reusing(
+    store: &dyn crate::vfs::SourceStore,
+    surveys: &mut IndexSurveyCache,
+) -> PackageResolver {
+    surveys.begin_rebuild();
+    let mut resolver = PackageResolver::new();
+    resolver.scan_path_reusing(store, Path::new(HOST_LIBRARY), surveys);
+    surveys.finish_rebuild();
+    resolver
+}
+
+#[test]
+fn a_rescan_reusing_surveys_builds_the_database_a_fresh_scan_does() {
+    let store = host_library_store();
+    let lib = Path::new(HOST_LIBRARY);
+    let fresh = |store: &dyn crate::vfs::SourceStore| {
+        let mut resolver = PackageResolver::new();
+        resolver.scan_path_in(store, lib);
+        database_contents(&resolver)
+    };
+    let mut surveys = IndexSurveyCache::new();
+
+    let first = rebuild_reusing(&store, &mut surveys);
+    let second = rebuild_reusing(&store, &mut surveys);
+    assert_eq!(database_contents(&first), fresh(&store));
+    assert_eq!(database_contents(&second), fresh(&store));
+    assert!(second.provides("hostpkg"));
+    assert!(second.auto_command_names().contains(&"hostcmd"));
+
+    // A file an index names disappearing changes that index's survey.
+    assert!(store.remove(&lib.join("autolib/autolib.tcl")));
+    let third = rebuild_reusing(&store, &mut surveys);
+    assert_eq!(database_contents(&third), fresh(&store));
+    assert!(!third.auto_command_names().contains(&"hostcmd"));
+
+    // So does an edited index.
+    store.upsert(
+        lib.join("hostpkg/pkgIndex.tcl"),
+        "package ifneeded hostpkg 2.0 [list source [file join $dir hostpkg.tcl]]\n",
+    );
+    let fourth = rebuild_reusing(&store, &mut surveys);
+    assert_eq!(database_contents(&fourth), fresh(&store));
+    assert!(!fourth.resolve("hostpkg", Some("2.0")).is_empty());
+}
