+    Exported,
+    NotExported,
+    /// The command may or may not be exported, so the destination keeps both
+    /// its prior binding and the imported one.
+    Undecided,
+}
+
+/// Export evidence for one import's source namespace beyond the positioned
+/// export alternatives in the command table.
+struct SourceExportEvidence {
+    facts: Option<Arc<OriginalImportExportFacts>>,
+    path: Option<tcl_core_types::ByteNamespacePath>,
+    documented: bool,
+}
+
+impl SourceExportEvidence {
+    fn of(
+        state: &ModuleCommandBindings,
+        source: &SourceNamespaceKey,
+        policy: NamePolicyProtocol,
+    ) -> Self {
+        Self {
+            facts: state.baseline.import_exports.clone(),
+            path: match state.original_namespace_geometry(source, policy) {
+                Some(SignatureNamespaceScope::C(path)) => Some(path),
+                _ => None,
+            },
+            documented: state.namespace_exports.get(source).is_some(),
+        }
+    }
+
+    /// Decide one command from how many of the table's `alternatives` export
+    /// it. Without a whole-program view, a namespace with no export statement
+    /// yet is undecided rather than empty: its export list may be written in
+    /// another file.
+    fn decide(&self, simple: &NameBytes, exported: usize, alternatives: usize) -> ImportExport {
+        if exported == alternatives {
+            return ImportExport::Exported;
+        }
+        if exported > 0 {
+            return ImportExport::Undecided;
+        }
+        let verdict = match (&self.facts, &self.path) {
+            (Some(facts), Some(path)) => facts.verdict(&tcl_core_types::ByteCommandSlot::new(
+                path.clone(),
+                simple.clone(),
+            )),
+            (Some(_), None) => OriginalExportVerdict::Unknown,
+            (None, _) if self.documented => OriginalExportVerdict::NotExported,
+            (None, _) => OriginalExportVerdict::Unknown,
+        };
+        match verdict {
+            OriginalExportVerdict::Exported => ImportExport::Exported,
+            OriginalExportVerdict::NotExported => ImportExport::NotExported,
+            OriginalExportVerdict::Unknown => ImportExport::Undecided,
+        }
+    }
+}
