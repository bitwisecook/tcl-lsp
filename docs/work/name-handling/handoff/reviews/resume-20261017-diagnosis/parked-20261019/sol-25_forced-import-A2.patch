+
+/// The shared fold behind [`original_import_export_facts`] and
+/// `WorkspaceIndex::import_export_facts`: one verdict per import site and
+/// importable declaration, combined per slot.
+pub(crate) fn import_export_facts_for<'a>(
+    imports: impl Iterator<
+        Item = (
+            &'a tcl_compiler::signature_scan::original_name::SourceNamespacePattern,
+            RunPoint<'a>,
+        ),
+    >,
+    declarations: impl Iterator<Item = &'a tcl_compiler::signature_scan::scope::SignatureSourceCommand>,
+    oracle: &dyn NamespaceExportOracle,
+) -> tcl_compiler::command_binding::OriginalImportExportFacts {
+    use tcl_compiler::command_binding::OriginalExportVerdict;
+    let declarations = declarations.collect::<Vec<_>>();
+    let mut facts = tcl_compiler::command_binding::OriginalImportExportFacts::default();
+    for (pattern, site) in imports {
+        if pattern.purpose() != tcl_syntax::naming::NativeNamePurpose::NamespaceImportPattern {
+            continue;
+        }
+        for name in &declarations {
+            let Some(slot) = pattern.source_slot_for_command_slot(name.slot(), name.policy())
+            else {
+                continue;
+            };
+            if &slot != name.slot()
+                || pattern.matches_imported_command(&slot, name.policy()) != Some(true)
+            {
+                continue;
+            }
+            let verdict = match oracle.proven_export_at_original(&slot, name.policy(), site) {
+                ExportVerdict::Exported => OriginalExportVerdict::Exported,
+                ExportVerdict::NotExported => OriginalExportVerdict::NotExported,
+                ExportVerdict::Unknown => OriginalExportVerdict::Unknown,
+            };
+            facts.record(slot, verdict);
+        }
+    }
+    facts
