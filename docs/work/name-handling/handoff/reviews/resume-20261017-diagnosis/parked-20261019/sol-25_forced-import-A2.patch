+/// Whole-program export verdicts for the imports `analysis` makes, for the
+/// compiler's own import seal ([`tcl_compiler::analyser::Analyser::with_import_exports`]).
+///
+/// Each import pattern is judged by `oracle` at its own position in `uri`,
+/// for every procedure or class this document declares in the pattern's
+/// source namespace that the pattern can import. A slot no declaration here
+/// names is not listed, which the compiler reads as unknown.
+#[must_use]
+pub fn original_import_export_facts(
+    analysis: &tcl_compiler::analyser::AnalysisResult,
+    uri: &str,
+    oracle: &dyn NamespaceExportOracle,
+) -> tcl_compiler::command_binding::OriginalImportExportFacts {
+    import_export_facts_for(
+        analysis.original_namespace_patterns().map(|pattern| {
+            let at = pattern.span().start();
+            (
+                pattern,
+                RunPoint {
+                    uri,
+                    at,
+                    enclosing_body: analysis.original_definition_body_span(at),
+                },
+            )
+        }),
+        analysis
+            .original_procedure_declarations()
+            .map(|row| row.name())
+            .chain(analysis.original_class_declarations().map(|row| row.name())),
+        oracle,
+    )
