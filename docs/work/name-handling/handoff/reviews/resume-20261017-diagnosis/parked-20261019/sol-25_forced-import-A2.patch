+/// Whole-program verdict on whether one source command is exported when an
+/// import of this document runs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum OriginalExportVerdict {
+    /// An export covers the command when the import runs.
+    Exported,
+    /// The program's export lists are known and none covers the command.
+    NotExported,
+    /// Nothing available decides it.
+    Unknown,
+}
+
+/// Export verdicts for the source commands this document's imports can bind,
+/// keyed by each command's exact slot. A host with a whole-program view
+/// supplies them as an analysis input; a slot it does not list is
+/// [`OriginalExportVerdict::Unknown`].
+///
+/// The document's own `namespace export` statements stay positioned in the
+/// command table and are read first. These verdicts decide only what those
+/// statements leave open.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Hash)]
+pub struct OriginalImportExportFacts {
+    verdicts: std::collections::BTreeMap<tcl_core_types::ByteCommandSlot, OriginalExportVerdict>,
+}
+
+impl OriginalImportExportFacts {
+    /// Record one import site's verdict for `slot`. The table carries no
+    /// import position, so two import sites that judge the same slot
+    /// differently leave it [`OriginalExportVerdict::Unknown`].
+    pub fn record(
+        &mut self,
+        slot: tcl_core_types::ByteCommandSlot,
+        verdict: OriginalExportVerdict,
+    ) {
+        self.verdicts
+            .entry(slot)
+            .and_modify(|previous| {
+                if *previous != verdict {
+                    *previous = OriginalExportVerdict::Unknown;
+                }
+            })
+            .or_insert(verdict);
+    }
+
+    /// The verdict for `slot`; an unlisted slot is unknown.
+    #[must_use]
+    pub fn verdict(&self, slot: &tcl_core_types::ByteCommandSlot) -> OriginalExportVerdict {
+        self.verdicts
+            .get(slot)
+            .copied()
+            .unwrap_or(OriginalExportVerdict::Unknown)
+    }
+
+    /// Whether no slot is listed.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.verdicts.is_empty()
+    }
+}
+
+/// What one import does with one matched source command.
