+/// Refresh every file's [`tcl_lsp_db::SourceFile::import_export_facts`] — the
+/// whole-program export verdicts its compiler import seal reads — and report
+/// the URIs whose stored verdicts actually moved.
+///
+/// One round suffices: the verdicts come from the workspace index's import,
+/// declaration and export records, none of which the verdicts change. Each
+/// file stores only the slots its own imports can bind, so an export edit
+/// invalidates only the files importing from that namespace. A file with no
+/// such slot stores `None`.
+///
+/// Lock discipline as [`sync_workspace_subclass_methods`]: the index read
+/// completes and drops before the `db` lock is taken.
+async fn sync_import_export_facts(handles: &EvidenceHandles) -> Vec<Uri> {
+    use salsa::Setter as _;
+    let uris = handles
+        .db_files
+        .lock()
+        .await
+        .keys()
+        .cloned()
+        .collect::<Vec<_>>();
+    let wanted = {
+        let index = handles.workspace_index.read().await;
+        uris.into_iter()
+            .map(|uri| {
+                let facts = index.import_export_facts(uri.as_str()).map(Arc::new);
+                (uri, facts)
+            })
+            .collect::<Vec<_>>()
+    };
+    let mut db = handles.db.lock().await;
+    let db_files = handles.db_files.lock().await;
+    let mut changed = Vec::new();
+    for (uri, want) in wanted {
+        let Some(&file) = db_files.get(&uri) else {
+            continue;
+        };
+        let have = file.import_export_facts(&*db);
+        let matches = match (have.as_ref(), want.as_ref()) {
+            (Some(have), Some(want)) => Arc::ptr_eq(have, want) || **have == **want,
+            (None, None) => true,
+            _ => false,
+        };
+        if matches {
+            continue;
+        }
+        file.set_import_export_facts(&mut *db).to(want);
+        changed.push(uri);
+    }
+    changed
+}
