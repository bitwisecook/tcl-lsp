3408:                         // that body is *called*, not at its lexical position
3409:                         // — `set dir /a; proc load {} {source child.tcl};
3410:                         // set dir /b; load` reaches the child with `/b`.
3411:                         // The position gate below reads lexical order, so a
3412:                         // body-local route instead contributes an **empty**
3413:                         // candidate: it still reaches the child, and
3414:                         // intersecting the agreement with an empty map
3415:                         // correctly drops every name for it.
3416:                         if s.enclosing_body.is_some() {
3417:                             candidates.entry(child.as_str()).or_default().push(
