3419:                                     self.path_constant_assignments(&s.uri).naming_policy(),
3420:                                 ),
3421:                             );
3422:                             continue;
3423:                         }
3424:                         let before = self
3425:                             .path_constant_assignments(&s.uri)
3426:                             .before(s.range.start());
3427:                         // From `next` only — never the previous round's map:
3428:                         // the inner iteration is a fixpoint **from below**
3429:                         // over this round's fixed edge set, and seeding it
3430:                         // with values the current agreement may drop would
3431:                         // break exactly the monotonicity that makes it
3432:                         // terminate.
3433:                         let parent_imports = next.get(&s.uri).unwrap_or(&empty);
3434:                         candidates.entry(child.as_str()).or_default().push(fold(
3435:                             &s.uri,
3436:                             &before,
3437:                             parent_imports,
3438:                         ));
