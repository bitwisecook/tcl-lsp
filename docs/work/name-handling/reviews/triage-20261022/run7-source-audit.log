28847:             let desired = match desired {
28848:                 Some(desired) => desired,
28849:                 None if recorded.is_empty() => return Ok(()),
28850:                 None => HashMap::new(),
28851:             };
28852:             let mut work: Vec<(String, Vec<String>)> = Vec::new();
28853:             for (uri, seeds) in &desired {
28854:                 let seeds: Vec<String> = seeds.iter().cloned().collect();
