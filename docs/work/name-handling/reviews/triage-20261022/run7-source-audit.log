233: fn hierarchy_components(
234:     classes: &[&str],
235:     module: &IrModule,
236:     registry: &CommandRegistry,
237: ) -> Option<HashMap<String, usize>> {
238:     let mut parent: Vec<usize> = (0..classes.len()).collect();
239:     let index: HashMap<&str, usize> = classes.iter().enumerate().map(|(i, c)| (*c, i)).collect();
240:     for relation in &module.class_relations {
241:         let (declaring, candidates) = module
242:             .retained_source_bindings
243:             .as_deref()?
244:             .positioned_for_module(module, registry)?
245:             .original_class_relation_candidates(module, registry, relation)?;
246:         if declaring.command != relation.declaring_class {
247:             return None;
248:         }
249:         let ci = *index.get(declaring.command.as_str())?;
250:         for other in candidates {
251:             let oi = *index.get(other.command.as_str())?;
252:             let (a, b) = (uf_find(&mut parent, ci), uf_find(&mut parent, oi));
253:             if a != b {
254:                 parent[a] = b;
255:             }
256:         }
257:     }
258:     let mut roots: HashMap<usize, usize> = HashMap::new();
259:     let mut out = HashMap::new();
260:     for (i, class) in classes.iter().enumerate() {
261:         let root = uf_find(&mut parent, i);
262:         let next_id = roots.len();
263:         let id = *roots.entry(root).or_insert(next_id);
264:         out.insert((*class).to_owned(), id);
265:     }
266:     Some(out)
267: }
