17862:         // workspace scan already did this for every file it read from disk,
17863:         // but an **open** document is deliberately skipped by that scan (its
17864:         // buffer, not the disk copy, is authoritative), and a document opened
17865:         // after the scan was never seen at all.  Bounded by this one
17866:         // document's entries, and a directory the resolver has already
17867:         // scanned costs nothing, so this stays a miss-path lookup rather than
17868:         // a rescan.
17869:         {
17870:             let dirs = document_auto_path_dirs(uri, analysis);
17871:             if !dirs.is_empty() {
17872:                 let mut resolver = self.package_resolver.write().await;
17873:                 for dir in &dirs {
17874:                     resolver.scan_path_in(self.store.as_ref(), dir);
17875:                 }
17876:             }
17877:         }
17878:         // The interpreter's `package prefer` state on entry to this document:
17879:         // the mode a file that (transitively) `source`s it already latched.
17880:         // The state is interpreter-global, and along the `source` graph "ran
17881:         // first" is a static fact, so a `package prefer latest` in the entry
17882:         // file really is in force here.
17883:         let inherited_prefer = {
17884:             let index = self.workspace_index.read().await;
17885:             if index.source_ancestor_prefers_latest_from_resolved(uri.as_str()) {
17886:                 tcl_lsp_core::package_resolver::PackagePrefer::Latest
17887:             } else {
17888:                 self.default_package_prefer().await
17889:             }
17890:         };
17891: 
17892:         {
17893:             let resolver = self.package_resolver.read().await;
17894:             let mut files: Vec<PathBuf> = Vec::new();
17895:             for req in &analysis.package_requires {
17896:                 // The document's own constraint decides which release is
17897:                 // indexed: `package require widget 2.0` against a workspace
17898:                 // holding 1.5 and 2.3 must navigate into 2.3 (C Tcl's
17899:                 // `SelectPackage` rule — see
17900:                 // `PackageResolver::resolve_require`), not whichever directory
