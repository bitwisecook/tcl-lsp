269: /// Path-compressing union-find lookup over the flat `parent` table
270: /// ([`hierarchy_components`]).
271: fn uf_find(parent: &mut [usize], i: usize) -> usize {
272:     let mut root = i;
273:     while parent[root] != root {
274:         root = parent[root];
275:     }
276:     let mut cur = i;
277:     while parent[cur] != root {
278:         let next = parent[cur];
279:         parent[cur] = root;
280:         cur = next;
281:     }
282:     root
283: }
