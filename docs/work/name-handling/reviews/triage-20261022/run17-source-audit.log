7532:     /// The set of `::`-stripped qualified names of every indexed proc and
7533:     /// class, for O(1) membership in the candidate-resolution loop of
7534:     /// [`Self::invocations_of`].  With `include_links`, the names an import /
7535:     /// alias / rename introduces join the set, so a call reaching one of them
7536:     /// settles (and is then chased to its ultimate target).
7537:     ///
7538:     /// A [`Derived`] view rather than a fresh walk: it
7539:     /// is `O(procs + classes + links)` to build, and
7540:     /// [`Self::workspace_command_exists`] asks for it *per candidate* inside
7541:     /// [`Self::follow_import_chain`]'s loop — and
7542:     /// [`Self::settled_sites`] once per settling pass — so rebuilding it per
7543:     /// ask would turn an existence test into a workspace-wide scan. Owned (`String`,
7544:     /// not `&str`) so the view is independent of any one call's borrow. The
7545:     /// two `include_links` readings are two separate views because a consumer
7546:     /// wants exactly one of them: the direct-only set is what rename relies
7547:     /// on, and folding the link names into it would let a call spelling an
7548:     /// imported name be text-rewritten.
7549:     fn defined_command_names(&self, include_links: bool) -> Arc<HashSet<String>> {
7550:         self.defined_names[usize::from(include_links)].get_or_build(|| {
7551:             let mut names: HashSet<String> = self
7552:                 .live_procs()
7553:                 .map(|p| {
7554:                     unroot_rooted_key(&p.qualified_name)
7555:                         .unwrap_or(&p.qualified_name)
7556:                         .to_owned()
7557:                 })
7558:                 .chain(self.live_classes().map(|c| {
7559:                     unroot_rooted_key(&c.qualified_name)
7560:                         .unwrap_or(&c.qualified_name)
7561:                         .to_owned()
7562:                 }))
7563:                 .collect();
7564:             if include_links {
7565:                 names.extend(self.live_command_links().into_iter().map(|l| {
7566:                     unroot_rooted_key(&l.linked_qname)
7567:                         .unwrap_or(&l.linked_qname)
7568:                         .to_owned()
7569:                 }));
7570:             }
7571:             names
7572:         })
7573:     }
