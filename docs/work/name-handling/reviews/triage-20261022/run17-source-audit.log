4319: /// Simple-name reporting assistance, separate from actual source call targets.
4320: /// Retained Logical candidates are genuine headers from the current image;
4321: /// their deterministic order grants no lookup, allocation or edit authority.
4322: ///
4323: /// The separate legacy deterministic tail match considers
4324: /// every proc whose simple name equals `word`, prefer one defined in this
4325: /// document ([`name_token_in_document`]), then the lexicographically
4326: /// smallest qualified name.  `HashMap` iteration order never decides the
4327: /// result.
4328: ///
4329: /// A proc living in a `tcl::mathfunc` namespace is excluded: real Tcl reaches
4330: /// it only through `expr`'s function-call production or its own fully-
4331: /// qualified name, never as a bare command word (`li {10 20 30} 1` →
4332: /// `invalid command name "li"` on tclsh 8.6 and 9.0), so without the
4333: /// exclusion this lenient tail match resolves a guaranteed-to-crash bare call
4334: /// to the mathfunc proc.  The namespace fact
4335: /// is the registry's ([`tcl_registry::mathfunc::is_in_mathfunc_namespace`]),
4336: /// not a name test written here.
4337: pub(crate) fn fallback_proc_by_simple_name<'a>(
4338:     analysis: &'a AnalysisResult,
4339:     source: &str,
4340:     word: &str,
4341: ) -> Option<&'a tcl_compiler::analyser::ProcDef> {
4342:     if analysis.allows_retained_logical_declaration_advice() {
4343:         crate::original_context::CurrentSourceContext::capture(source, analysis)?;
4344:         // Reporting assistance only: actual call/target selection is terminal
4345:         // through its independent original source receipt before this path.
4346:         return analysis
4347:             .logical_source_procedure_declarations()
4348:             .filter(|header| header.name() == Some(word))
4349:             .filter(|header| {
4350:                 !tcl_registry::mathfunc::is_in_mathfunc_namespace(&header.metadata().qualified_name)
4351:             })
4352:             .min_by(|left, right| {
4353:                 left.metadata()
4354:                     .qualified_name
4355:                     .cmp(&right.metadata().qualified_name)
4356:                     .then_with(|| {
4357:                         left.metadata()
4358:                             .name_span
4359:                             .start()
4360:                             .cmp(&right.metadata().name_span.start())
4361:                     })
4362:             })
4363:             .map(tcl_compiler::analyser::types::LogicalSourceProcedureDeclaration::metadata);
4364:     }

