
speclib edge 2.0 {
    command edge::test {
        arity 1
        world_effects none
        arg 0 -role Value
        const_fold -inputs {words} {words ctx} {
            set a x
            set a:b BAD
            set arr(x:b) good
            set arr(BAD) bad
            fold $arr($a:b)
        }
    }
}
