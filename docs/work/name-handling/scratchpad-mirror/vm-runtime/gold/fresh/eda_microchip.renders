import_files	CommandSpec { name: "import_files", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 0, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Import design source files and constraint files into the project.", synopsis: ["import_files ?-schematic file...? ?-symbol file...? ?-smartgen_core file...? ?-ccp file...? ?-stimulus file...? ?-hdl_source file...? ?-io_pdc file? ?-fp_pdc file? ?-edif file...? ?-can_convert_EDN_to_HDL value? ?-sdc file...? ?-pin file...? ?-dcf file...? ?-pdc file...? ?-gcf file...? ?-vcd file...? ?-saif file...? ?-crt file...? ?-constraint_sdc file...? ?-constraint_pin file...? ?-constraint_dcf file...? ?-constraint_pdc file...? ?-constraint_gcf file...? ?-constraint_vcd file...? ?-constraint_saif file...? ?-constraint_crt file...? ?-simulation file...? ?-profiles file...? ?-cxf file...? ?-templates file? ?-ccz file? ?-wf_stimulus file? ?-modelsim_ini file? ?-library file?"], snippet: "Imports design source and constraint files, with each option naming one file type and being repeated once per file. For SmartFusion2, IGLOO2 and RTG4 the -pdc parameter is retired: physical design constraints must be split between I/O attribute and pin information, imported with -io_pdc, and floorplanning and timing constraints, imported with -fp_pdc, and using -pdc with those families causes an error. Paths may be absolute or relative but must be enclosed in curly braces. Use -can_convert_EDN_to_HDL to convert an EDIF file to HDL and import the converted HDL; the EDIF file itself is not imported.", source: "Libero SoC v11.8 Tcl Command Reference", examples: "import_files -hdl_source file1.vhd -hdl_source file2.vhd", return_value: "The guide does not document a return value." }), forms: [FormSpec { kind: Default, synopsis: "import_files ?-schematic file...? ?-symbol file...? ?-smartgen_core file...? ?-ccp file...? ?-stimulus file...? ?-hdl_source file...? ?-io_pdc file? ?-fp_pdc file? ?-edif file...? ?-can_convert_EDN_to_HDL value? ?-sdc file...? ?-pin file...? ?-dcf file...? ?-pdc file...? ?-gcf file...? ?-vcd file...? ?-saif file...? ?-crt file...? ?-constraint_sdc file...? ?-constraint_pin file...? ?-constraint_dcf file...? ?-constraint_pdc file...? ?-constraint_gcf file...? ?-constraint_vcd file...? ?-constraint_saif file...? ?-constraint_crt file...? ?-simulation file...? ?-profiles file...? ?-cxf file...? ?-templates file? ?-ccz file? ?-wf_stimulus file? ?-modelsim_ini file? ?-library file?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, 