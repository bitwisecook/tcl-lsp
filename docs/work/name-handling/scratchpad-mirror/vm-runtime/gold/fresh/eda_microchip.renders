sample_analog_channel	CommandSpec { name: "sample_analog_channel", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 0, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Perform analog-to-digital conversion of a selected analog channel.", synopsis: ["sample_analog_channel ?-name name...? ?-resolution 8|10|12? ?-clock_periods int_value? ?-clock_divider int_value? ?-num_samples int_value? ?-filtering_factor real_value? ?-initial_value int_value? ?-show_details yes|no? ?-file filename?"], snippet: "SmartDebug command used when debugging the analog subsystem: it samples a pre-configured analog channel with user-supplied ADC conversion parameters and can apply a single-pole low-pass digital filter. A single sample prints one result, and with -show_details yes the detailed ADC register content; multiple samples print a table that also carries the filtered results when filtering is enabled. The maximum number of channels depends on the device type. (SmartFusion and Fusion only.)", source: "Libero SoC v11.8 Tcl Command Reference", examples: "sample_analog_channel -name AV0 -resolution 10 -clock_periods 4  -clock_divider 4 -num_samples 10 -filtering_factor 2.5", return_value: "The empty string." }), forms: [FormSpec { kind: Default, synopsis: "sample_analog_channel ?-name name...? ?-resolution 8|10|12? ?-clock_periods int_value? ?-clock_divider int_value? ?-num_samples int_value? ?-filtering_factor real_value? ?-initial_value int_value? ?-show_details yes|no? ?-file filename?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("libero"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-name", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [], closed: false, integer: None, hint: "name", appended_arity: Unknown }), detail: "Specifies the analog channel to be sampled, a channel type followed by a channel index such as AV0, AT0