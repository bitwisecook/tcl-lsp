smartpower_import_vcd	CommandSpec { name: "smartpower_import_vcd", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 0, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Import a simulator-generated VCD file into SmartPower.", synopsis: ["smartpower_import_vcd -file value ?-opmode value? ?-with_vectorless value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name value? ?-glitch_filtering value? ?-glitch_threshold value? ?-stop_time value?"], snippet: "Imports a VCD file generated by a simulation tool, from which SmartPower extracts the frequency and probability information for the annotated signals. The import can be restricted to a window of the simulation with -partial_parse together with -start_time and -end_time, targeted at one operating mode with -opmode, pointed at the design instance with -auto_detect_top_level_name or -top_level_name, and cleaned of short pulses with -glitch_filtering and -glitch_threshold.", source: "Libero SoC v11.8 Tcl Command Reference", examples: "smartpower_import_vcd -file \"../../simulation/power.vcd\"\nsmartpower_import_vcd -file \"../../simulation/power.vcd\" -partial_parse TRUE  -start_time 1000000 -end_time 2000000 -opmode \"power_1ms_to_2ms\"", return_value: "This command does not return a value." }), forms: [FormSpec { kind: Default, synopsis: "smartpower_import_vcd -file value ?-opmode value? ?-with_vectorless value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name value? ?-glitch_filtering value? ?-glitch_threshold value? ?-stop_time value?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [SideEffect { target: FileIo, reads: true, writes: false, connection_side: None, surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("libero"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-file", value: Takes(OptionArg { arity: One, role: Value, also_ro