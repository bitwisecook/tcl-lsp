smartpower_report_power_peak_analyzer	CommandSpec { name: "smartpower_report_power_peak_analyzer", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 1, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Create a cycle accurate power report from a VCD file.", synopsis: ["smartpower_report_power_peak_analyzer ?-type power_cycle_accurate? ?-vcd_file path? ?-style value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name name? ?-glitch_filtering value? ?-glitch_threshold value? ?-power_summary value? ?-auto_detect_sampling_period value? ?-sampling_clock value? ?-sampling_rate_per_period value? ?-sampling_offset value? ?-sampling_period value? ?-use_only_local_extrema value? ?-use_power_threshold value? ?-power_threshold value? ?-opmode value? filename"], snippet: "Writes to the named file a power waveform carrying one power value per clock period or half-period, instead of a single average power for the whole simulation read from -vcd_file. The sampling grid comes either from -auto_detect_sampling_period or from -sampling_clock with -sampling_rate_per_period, -sampling_offset and -sampling_period, and the recorded history can be trimmed with -use_only_local_extrema or -use_power_threshold together with -power_threshold.", source: "Libero SoC v11.8 Tcl Command Reference", examples: "smartpower_report_power_peak_analyzer -partial_parse \"TRUE\" -vcd_file \"power.vcd\"  -style \"Text\" -start_time \"0.05\" -end_time \"1.00\"  -auto_detect_top_level_name \"TRUE\" -glitch_filtering \"FALSE\"  -glitch_threshold \"100\" -auto_detect_sampling_period \"TRUE\"  -sampling_clock \"clk\" -sampling_rate_per_period \"TRUE\" -sampling_offset \"0.00\"  -sampling_period \"10000.00\" -use_only_local_extrema \"TRUE\"  -use_power_threshold \"TRUE\" -power_threshold \"0.00\" -opmode \"Active\"  \"report_power_cycle_based.txt\"", return_value: "The empty string." }), forms: [FormSpec { kind: Default, synopsis: "smartpower_report_power_peak_analyzer ?-type power_cycle_accurate? ?-vcd_file path? ?-style value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name name? ?-glitch_filtering value? ?-glitch_threshold value? ?-power_summary value? ?-auto_detect_sampling_period value? ?-sampling_clock value? ?-sampling_rate_per_period value? ?-sampling_offset value? ?-sampling_period value? ?-use_only_local_extrema value? ?-use_power_threshold value? ?-power_threshold value? ?-opmode value? filename", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_ho