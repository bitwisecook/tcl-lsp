ases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-elements", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [], closed: false, integer: None, hint: "element_list", appended_arity: Unknown }), detail: "The list of instance names to add.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-exclude_elements", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [], closed: false, integer: None, hint: "exclude_list", appended_arity: Unknown }), detail: "The list of instances to exclude from the effective_element_list.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-transitive", value: Takes(OptionArg { arity: Hook(fn), role: Value, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [ArgValue { value: "TRUE", detail: "", min_tcl: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, code: None }, ArgValue { value: "FALSE", detail: "", min_tcl: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, code: None }], closed: true, integer: None, hint: "boolean", appended_arity: Unknown }), detail: "Whether the connection is transitive, defaulting to TRUE both when the option is omitted and when