ODE -to NORMAL_MODE}  -transition {suspend -from NORMAL_MODE -to SLEEP_MODE}  -transition {resume -from SLEEP_MODE -to NORMAL_MODE}  -transition {turn_off -from NORMAL_MODE -to OFF_MODE}", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "add_state_transition object_name ?-supply|-domain|-group|-model|-instance? ?-update? ?-transition {transition_name ?-from from_list -to to_list? ?-paired {{from_state to_state}...}? ?-legal|-illegal?}...? ?-complete?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-supply", value: Flag, detail: "Apply the command to a supply set or supply set handle of this name.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, eff