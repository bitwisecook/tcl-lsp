apply_power_model	CommandSpec { name: "apply_power_model", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 1, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Bind power models to instances in the design and connect the interface supply set handles, logic ports, and supply ports of a previously loaded power model.", synopsis: ["apply_power_model power_model_name ?-elements instance_name_list? ?-supply_map {{instance_scope_supply_set current_scope_supply_set}...}? ?-port_map {{instance_scope_port current_scope_net}...}? ?-parameters {{param_name param_value}...}? ?-update?"], snippet: "Binds a previously defined power model to the cell instances named by -elements, either binding design objects to the model's parameters via -parameters for system-level IP power modeling, or executing the named power model's commands once per instance and wiring its interface supply set handles, logic ports, and supply ports to the instantiation scope via -supply_map and -port_map. Each -supply_map pair implies an associate_supply_set command and each -port_map pair implies a connect_logic_net or connect_supply_net command, which must be legal for the given pair; -update extends previously applied bindings with additional external connection information.", source: "IEEE 1801-2024 §6.9", examples: "apply_power_model upf_model -elements {I1 I2}  -supply_map {{PD.ssh1 ss1} {PD.ssh2 ss2}}  -port_map {{isolate_n iso}}", return_value: "1 if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "apply_power_model power_model_name ?-elements instance_name_list? ?-supply_map {{instance_scope_supply_set current_scope_supply_set}...}? ?-port_map {{instance_scope_port current_scope_net}...}? ?-parameters {{param_name param_value}...}? ?-update?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-elements", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, variab