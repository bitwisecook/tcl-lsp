, precedence resolution (5.7.3.3) picks the winner.", source: "IEEE 1801-2024 §6.52", examples: "set_repeater feedthrough_buffer1 -domain PD3 -applies_to outputs -repeater_supply ss1", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "set_repeater strategy_name -domain domain_name -repeater_supply supply_set_ref ?-elements element_list? ?-exclude_elements exclude_list? ?-source source_domain_name|source_supply_ref? ?-sink sink_domain_name|sink_supply_ref? ?-use_functional_equivalence ?TRUE|FALSE?? ?-applies_to inputs|outputs|both? ?-applies_to_boundary lower|upper|both? ?-name_prefix string? ?-name_suffix string? ?-instance {{instance_name port_name}...}? ?-update?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-domain", value: Takes(OptionArg 