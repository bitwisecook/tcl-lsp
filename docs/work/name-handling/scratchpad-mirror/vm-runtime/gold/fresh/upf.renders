create_vcm	CommandSpec { name: "create_vcm", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 1, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Describe a Value Conversion Method for connecting a UPF supply net type to an HDL port.", synopsis: ["create_vcm vcm_name ?-table {{from_value to_value}...}? ?-hdl_type {vhdl|sv ?HDL_typename?}? ?-conversion_direction hdl2upf|upf2hdl? ?-field field_name? ?-function hdl_package::function_name? ?-model model_name? ?-parameters {{param_name param_value}...}? ?-vcms ext_vcm_list?"], snippet: "Defines a named Value Conversion Method used to mediate connections between UPF supply nets and HDL ports, using exactly one of four mechanisms: a value-mapping table (-table, with required -hdl_type and -conversion_direction and optional -field), a conversion function (-function), an HDL module or entity (-model, optionally parameterized via -parameters), or a bundle of previously defined VCMs (-vcms). VCMs are global unless created inside a UPF library's -contents, and are referenced later by connect_supply_net or by name inside another create_vcm bundle.", source: "IEEE 1801-2024 §6.30", examples: "create_vcm VCTH2U -hdl_type { sv real } -conversion_direction hdl2upf -table {  {{1.2 *}   {FULL_ON    1.2}}  {{0.5 1.2} {PARTIAL_ON 1.0}}  {{* 0.5}   {OFF           }} }\ncreate_vcm VCTHSNAP  -function my_function_pkg::func_h2u_snap", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "create_vcm vcm_name ?-table {{from_value to_value}...}? ?-hdl_type {vhdl|sv ?HDL_typename?}? ?-conversion_direction hdl2upf|upf2hdl? ?-field field_name? ?-function hdl_package::function_name? ?-model model_name? ?-parameters {{param_name param_value}...}? ?-vcms ext_vcm_list?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-table", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, vari