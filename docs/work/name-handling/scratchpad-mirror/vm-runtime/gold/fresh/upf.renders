connect_supply_net	CommandSpec { name: "connect_supply_net", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 1, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Connect a supply net to supply ports.", synopsis: ["connect_supply_net net_name ?-elements element_list? ?-ports port_list? ?-pg_type pg_type_list...? ?-vcm vcm_name? ?-cells cell_list? ?-domain domain_name? ?-vct vct_name?"], snippet: "Connects a supply net to the specified supply ports, propagating it through implicitly and automatically created ports and nets across the descendant subtree of the current scope, or of the -domain scope when one is given; this explicit connection has higher precedence than implicit and automatic connection semantics. Target ports are selected either explicitly with -ports or indirectly with -pg_type combined with the -cells, -domain, and -elements filters, while -vcm and the legacy -vct control HDL to UPF value conversion. It shall be an error if neither -ports nor -pg_type is specified, and if -ports is not specified then -pg_type and one or more of -cells, -domain, and -elements shall be.", source: "IEEE 1801-2024 §6.14", examples: "connect_supply_net fb -ports {jk jb}\nconnect_supply_net mc -ports {rl} -vcm SV_TIED_HI", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "connect_supply_net net_name ?-elements element_list? ?-ports port_list? ?-pg_type pg_type_list...? ?-vcm vcm_name? ?-cells cell_list? ?-domain domain_name? ?-vct vct_name?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-elements", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [], closed: false, integer: None, hint: "element_list", appended_arity: Unknown }), detail: "A list of instance names to use for -pg_type, c