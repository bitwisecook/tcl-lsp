ither on the first invocation or during a subsequent update.", source: "IEEE 1801-2024 §6.21", examples: "create_power_domain PD1 -elements {top/U1}  -supply {primary}  -supply {mem_array mem_ss}\ncreate_power_domain PD3 -elements {top/U1/U2}  -supply {primary}  -available_supplies {ss_rep}  -boundary_supplies {}", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "create_power_domain domain_name ?-atomic? ?-elements element_list? ?-subdomains domain_list? ?-exclude_elements exclude_list? ?-supply {supply_set_handle ?supply_set_ref?}...? ?-available_supplies supply_set_ref_list? ?-boundary_supplies supply_set_ref_list? ?-define_func_type {supply_function pg_type_list}...? ?-update?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-atomic", value: 