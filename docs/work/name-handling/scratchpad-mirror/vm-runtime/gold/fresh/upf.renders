set_level_shifter	CommandSpec { name: "set_level_shifter", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 1, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Specify a level-shifter strategy.", synopsis: ["set_level_shifter strategy_name -domain domain_name ?-elements element_list? ?-exclude_elements exclude_list? ?-source source_domain_name|source_supply_ref? ?-sink sink_domain_name|sink_supply_ref? ?-use_functional_equivalence ?TRUE|FALSE?? ?-applies_to inputs|outputs|both? ?-applies_to_boundary lower|upper|both? ?-rule low_to_high|high_to_low|both? ?-threshold value? ?-no_shift? ?-force_shift? ?-location self|other|parent|fanout? ?-input_supply supply_set_ref? ?-output_supply supply_set_ref? ?-internal_supply supply_set_ref? ?-name_prefix pattern? ?-name_suffix pattern? ?-instance {{instance_name port_name}...}? ?-update?"], snippet: "Defines a level-shifter strategy for ports on the interface of a power domain (see 6.21), applied per path at the domain boundary to correct voltage differences between the driving and receiving supplies. The filter options -source, -sink, -applies_to, -rule, -threshold and -applies_to_boundary compute the effective element list of ports to which the strategy applies, while -location, -input_supply, -output_supply, -internal_supply, -instance, -name_prefix and -name_suffix control insertion and naming. -no_shift suppresses insertion and -force_shift forces it, and -update adds elements to a prior strategy of the same name and domain in the same scope.", source: "IEEE 1801-2024 §6.49", examples: "set_level_shifter shift_up -domain PowerDomainZ  -applies_to inputs  -source PowerDomainX.ss1  -threshold 0.02  -rule both\nset_level_shifter TurnOffDefaultLS -domain PD -no_shift", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "set_level_shifter strategy_name -domain domain_name ?-elements element_list? ?-exclude_elements exclude_list? ?-source source_domain_name|source_supply_ref? ?-sink sink_domain_name|sink_supply_ref? ?-use_functional_equivalence ?TRUE|FALSE?? ?-applies_to inputs|outputs|both? ?-applies_to_boundary lower|upper|both? ?-rule low_to_high|high_to_low|both? ?-threshold value? ?-no_shift? ?-force_shift? ?-location self|other|parent|fanout? ?-input_supply supply_set_ref? ?-output_supply supply_set_ref? ?-internal_supply supply_set_ref? ?-name_prefix pattern? ?-name_suffix pattern? ?-instance {{instance_name port_name}...}? ?-update?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effe