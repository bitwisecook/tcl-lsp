create_abstract_power_source	CommandSpec { name: "create_abstract_power_source", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 1, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Define abstract power source for supply sets.", synopsis: ["create_abstract_power_source power_source_name ?-output_supply_set {output_ss_handle ?supply_set_ref?}? ?-input_supply_set {input_ss_handle ?supply_set_ref?}...? ?-control_port {port_name ?net_name?}...? ?-on_state {state_name input_supply_set {boolean_expression}}...? ?-off_state {state_name {boolean_expression}}? ?-supply_set supply_set_ref? ?-ack_port {port_name net_name}...? ?-ack_delay {port_name delay}...? ?-ack_polarity {port_name active_high|active_low}...? ?-power_switch power_switch_list? ?-update?"], snippet: "Defines an abstract, supply set based model of a power source that controls the predefined ON and OFF states on its output supply set handle, intended to be refined into concrete power switches during implementation. -input_supply_set and -output_supply_set create the power source's supply set handles, -control_port creates the control inputs used in the -on_state and -off_state Boolean expressions that drive the ON and OFF trigger logic, -ack_port, -ack_delay, and -ack_polarity model acknowledge signaling, and -power_switch with -update refines the abstract source into one or more real power switches. If neither the -off_state nor an -on_state is active, or both are active at the same time, the predefined ERROR state is the current power state.", source: "IEEE 1801-2024 §6.16", examples: "create_abstract_power_source PSW  -input_supply_set {input PDTop.primary}  -output_supply_set {output PD1.primary}  -supply_set PDTop.primary  -control_port {en IP_FET_EN}  -on_state {PSON input {!en}}  -off_state {PSOFF en}\ncreate_abstract_power_source PSW  -update  -power_switch {SoCPSW_1}", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "create_abstract_power_source power_source_name ?-output_supply_set {output_ss_handle ?supply_set_ref?}? ?-input_supply_set {input_ss_handle ?supply_set_ref?}...? ?-control_port {port_name ?net_name?}...? ?-on_state {state_name input_supply_set {boolean_expression}}...? ?-off_state {state_name {boolean_expression}}? ?-supply_set supply_set_ref? ?-ack_port {port_name net_name}...? ?-ack_delay {port_name delay}...? ?-ack_polarity {port_name active_high|active_low}...? ?-power_switch power_switch_list? ?-update?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_