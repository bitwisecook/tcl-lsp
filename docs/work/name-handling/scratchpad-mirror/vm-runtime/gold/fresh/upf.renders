ame polarity or edge sensitivity, or if the conditions specified in -save_check, -restore_check, or -retention_check conflict with -hold_check.", source: "IEEE 1801-2024 §7.7", examples: "", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "define_retention_cell -cells cell_list -power power_pin -ground ground_pin ?-cell_type string? ?-always_on_pins pin_list? ?-restore_function {pin high|low|posedge|negedge}? ?-save_function {pin high|low|posedge|negedge}? ?-restore_check expression? ?-save_check expression? ?-retention_check expression? ?-hold_check pin_list? ?-always_on_components component_list? ?-power_switchable power_pin? ?-ground_switchable ground_pin?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-cells", value: Takes(OptionArg { arit