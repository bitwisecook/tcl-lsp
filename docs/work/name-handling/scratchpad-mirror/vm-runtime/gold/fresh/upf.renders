UPT_STATE_ON_ACTIVITY, CORRUPT_ON_ACTIVITY, CORRUPT, and NOT_NORMAL.", source: "IEEE 1801-2024 §6.5", examples: "add_power_state PD.primary -supply  -state {ON.TURBO}    ;# a refinement of the predefined ON state\nadd_power_state CPU -model  -state {ACTIVE  -power_expr {UPF::power_functions::cpu  {voltage frequency temperature IPC L1DAccess}}}  -state {DORMANT  -power_expr {0.01mW 0.0mW}}", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "add_power_state object_name ?-supply|-domain|-group|-model|-instance? ?-update? ?-state {state_name ?-logic_expr {boolean_expression}? ?-supply_expr {boolean_expression}? ?-power_expr {power_expression}? ?-simstate simstate? ?-legal|-illegal?}...? ?-complete?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-su