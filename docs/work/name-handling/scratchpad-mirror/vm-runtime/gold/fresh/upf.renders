set_isolation	CommandSpec { name: "set_isolation", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 1, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Specify an isolation strategy.", synopsis: ["set_isolation strategy_name -domain domain_name ?-elements element_list? ?-exclude_elements exclude_list? ?-source source_domain_name|source_supply_ref? ?-sink sink_domain_name|sink_supply_ref? ?-diff_supply_only ?TRUE|FALSE?? ?-use_functional_equivalence ?TRUE|FALSE?? ?-applies_to inputs|outputs|both? ?-applies_to_boundary lower|upper|both? ?-applies_to_clamp 0|1|Z|latch|any|value? ?-no_isolation? ?-force_isolation? ?-location self|other|parent|fanout? ?-clamp_value clamp_value? ?-isolation_signal signal_list ?-isolation_sense high|low?? ?-isolation_supply supply_set_list? ?-name_prefix pattern? ?-name_suffix pattern? ?-instance {{instance_name port_name}...}? ?-async_set_reset {net_name high|low}? ?-async_clamp_value 0|1? ?-update? ?-isolation_power_net net_name? ?-isolation_ground_net net_name? ?-applies_to_sink_off_clamp 0|1|any|Z|latch|value? ?-applies_to_source_off_clamp 0|1|any|Z|latch|value?"], snippet: "Defines an isolation strategy for ports on the interface of a power domain (see 6.21), applied per path at the domain boundary so that correct electrical and logical function is preserved across differing power states. The filter options -elements, -exclude_elements, -source, -sink, -diff_supply_only, -applies_to, -applies_to_clamp and -applies_to_boundary compute the effective element list of ports the strategy applies to, while -location, -clamp_value, -isolation_signal and -isolation_sense, -isolation_supply, -instance, -name_prefix, -name_suffix, -async_set_reset and -async_clamp_value control how and where the isolation cell is inferred and connected. -no_isolation suppresses isolation and -force_isolation forces it, and -update lets a later command add elements to a prior strategy of the same name and domain in the same scope.", source: "IEEE 1801-2024 §6.48", examples: "set_isolation parent_strategy  -domain pda  -elements {a b c d}  -isolation_supply {pda_isolation_supply}  -clamp_value {1}  -applies_to outputs -sink pdb\nset_isolation parent_strategy -update  -domain pda  -isolation_signal cpu_iso  -isolation_sense low -location parent", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "set_isolation strategy_name -domain domain_name ?-elements element_list? ?-exclude_elements exclude_list? ?-source source_domain_name|source_supply_ref? ?-sink sink_domain_name|sink_supply_ref? ?-diff_supply_only ?TRUE|FALSE?? ?-use_functional_equivalence ?TRUE|FALSE?? ?-applies_to inputs|outputs|both? ?-applies_to_boundary lower|upper|both? ?-applies_to_clamp 0|1|Z|latch|any|value? ?-no_isolation? ?-force_isolation? ?-location self|other|parent|fanout? ?-clamp_value clamp_value? ?-isolation_signal signal_list ?-isolation_sense high|low?? ?-isolation_supply supply_set_list? ?-name_prefix pattern? ?-name_suffix pattern? ?-instance {{instance_name port_name}...}? ?-async_set_reset {net_name high|low}? ?-async_clamp_value 0|1? ?-update? ?-isolation_power_net net_name? ?-isolation_ground_net net_name? ?-applies_to_sink_off_clamp 0|1|any|Z|latch|value? ?-applies_to_source_off_clamp 0|1|any|Z|latch|value?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-domain", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [], closed: false, integer: None, hint: "domain_name", appended_arity: Unknown }), detail: "The power domain for which this strategy is defined (required).", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-elements