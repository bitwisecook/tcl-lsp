map_retention_cell	CommandSpec { name: "map_retention_cell", pack_source_sandbox_helper: false, traits: Traits(0), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }]), arity: Arity { count: Arguments, min: 1, max: 65535, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: None, substitution_resolver: None, callback_taint_inputs: [], return_type: None, return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Constrain implementation alternatives, or specify a functional model, for retention strategies.", synopsis: ["map_retention_cell retention_name_list -domain domain_name ?-elements element_list? ?-exclude_elements exclude_list? ?-lib_cells lib_cell_list? ?-lib_cell_type lib_cell_type? ?-lib_model_name name -port_map {{port_name net_ref}...}?"], snippet: "Constrains which library cells, or which named behavioral or library model, may implement the retention registers inferred for the given retention strategies in a domain, and -- when -lib_model_name and -port_map are used -- substitutes an explicit verification model wired through -port_map in place of the default RTL-plus-retention-behavior verification semantic. When -lib_cells and -lib_cell_type are both specified, a cell from lib_cell_list that is also defined with the same type string in define_retention_cell -cell_type shall be used. It shall be an error if none of -lib_cells, -lib_cell_type, and -lib_model_name is specified. Manual mapping may make the implementation diverge from the RTL specification, potentially defeating logical-equivalence checking.", source: "IEEE 1801-2024 §6.39", examples: "map_retention_cell {my_PDA_ret_strat_1  my_PDA_ret_strat_2  my_PDA_ret_strat_3}  -domain PowerDomainA  -elements {foo/U1 foo/U2}  -lib_cells {RETFFIMP1 RETFFIMP2}  -lib_cell_type FF_CKLO", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "map_retention_cell retention_name_list -domain domain_name ?-elements element_list? ?-exclude_elements exclude_list? ?-lib_cells lib_cell_list? ?-lib_cell_type lib_cell_type? ?-lib_model_name name -port_map {{port_name net_ref}...}?", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-domain",