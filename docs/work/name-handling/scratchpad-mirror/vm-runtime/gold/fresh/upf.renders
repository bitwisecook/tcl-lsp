le {{OFF 'X'} {FULL_ON '1'} {PARTIAL_ON 'H'}}", return_value: "The empty string if successful; otherwise a TCL_ERROR is raised." }), forms: [FormSpec { kind: Default, synopsis: "create_upf2hdl_vct vct_name -hdl_type {vhdl|sv ?typename?} -table {{from_value to_value}...}", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: None, required_package: Some("upf"), tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-hdl_type", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [], closed: false, integer: None, hint: "hdl_type", appended_arity: Unknown }), detail: "The HDL type for which the value conversions are defined, given as a braced list of the language word vhdl or sv and an optional type name (required).", surface: None, aliases: [], lifecycle: Lifecycle { intro