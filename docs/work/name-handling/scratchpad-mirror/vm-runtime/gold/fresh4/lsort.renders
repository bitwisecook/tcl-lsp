lsort	CommandSpec { name: "lsort", pack_source_sandbox_helper: false, traits: Traits(1407374883553280), surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.4", Some("9.2"))] }, SpecSurface { provider: Core(F5Irules), windows: [] }]), arity: Arity { count: Positionals, min: 1, max: 1, step: 0, also_exact: None }, arity_windows: [], arg_roles: [], arg_role_resolver: None, arg_role_count_resolver: None, arg_role_layout_resolver: None, arg_role_resolver_roles: [], clause_grammar: None, arg_presentation: [], repeated_args: [], frame_effect: None, clause_shape_check: None, command_prefixes: [], command_prefix_resolver: None, script_timing_resolver: None, script_lookup_scope: Some(InvokingFrame), substitution_resolver: None, callback_taint_inputs: [], return_type: Some(List), return_type_hook: None, var_write_typing: ReturnValue, variable_write_min_args: None, return_elements: None, var_elements_effect: None, representation_effect: None, arg_types: [], subcommands: [], prefix_matching: Enabled, allow_unknown_subcommands: false, default_form_first_word: None, hover: Some(HoverSnippet { summary: "Sort the elements of a list.", synopsis: ["lsort ?options? list"], snippet: "Sorts using a stable merge sort (O(n log n)); equal elements keep their relative input order, except that -unique discards all but the last of each run of duplicates. -ascii (Unicode code-point order) and -increasing are the defaults; -dictionary, -integer, -real, or -command select an alternate comparison. -nocase (Tcl 8.5+) folds case, but only affects -ascii comparisons — it has no effect combined with -dictionary, -integer, or -real. -index sorts by a sub-element instead of the whole list element — since Tcl 8.5 it may itself be a list of indices for nested access — and, combined with -stride (Tcl 8.6+), is relative to each fixed-size group rather than the whole element. -indices (Tcl 8.5+) returns element positions instead of the elements themselves. lsort is reentrant, so a -command comparator may itself call lsort.", source: "Tcl lsort(n)", examples: "lsort {b a c}\nlsort -integer -unique {3 1 4 1 5 9 2 6}\nlsort -integer -index 1 {{First 24} {Second 18} {Third 30}}\nlsort -stride 2 -index 1 -integer {carrot 10 apple 50 banana 25}", return_value: "A new list containing the same elements as list, permuted into sorted order (or, with -indices, the list of indices that would produce that order)." }), forms: [FormSpec { kind: Default, synopsis: "lsort ?options? list", surface: None, lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None } }], command_forms: [], semantic_operation: None, semantic_operation_windows: [], completion: None, result_stability: None, native_result: None, assigns_variable_at: None, safe_on_uninit: None, const_fold: None, const_fold_versioned: None, lowering_hook: None, bpf_op: None, codegen_hook: None, codegen_hook_windows: [], inline_codegen_hook: None, inline_codegen_hook_windows: [], native_lowering: None, native_lowering_windows: [], semantics: Inherited, analyser_hook: None, command_table_effect: None, side_effects: [], world_effects: None, state_transitions: None, dispatch_dependencies: None, literal_argument_validator: None, source_index_bounds: None, inferred_storage_type: Some(List), required_package: None, tk_geometry: None, excluded_events: [], unsafe_command: false, closed_value_args: [], arg_values_accept_prefix: false, event_requires: None, event_requirement_forms: [], event_emits: None, event_emission_forms: [], data_collection: None, irules_source_flow: None, side_switch_target: None, event_handler_priority: None, irules_top_level_effect: None, options: [OptionSpec { name: "-ascii", value: Flag, detail: "Compare using Unicode code-point (raw string) order — the default. The flag name is a holdover from Tcl's original ASCII-only implementation; it is not restricted to ASCII text.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-dictionary", value: Flag, detail: "Dictionary-style comparison: like -ascii but case-insensitive except as a tie-breaker, and embedded numbers compare as integers rather than character-by-character (bigBoy sorts between bigbang and bigboy; x10y sorts between x9y and x11y). Takes precedence over -nocase.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-integer", value: Flag, detail: "Convert each element to an integer and compare numerically; an element that doesn't convert is an error.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-real", value: Flag, detail: "Convert each element to a floating-point value and compare numerically; an element that doesn't convert is an error.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-nocase", value: Flag, detail: "Case-insensitive comparison. Only affects -ascii comparisons — has no effect combined with -dictionary, -integer, or -real.", surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.5", Some("9.2"))] }]), aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-increasing", value: Flag, detail: "Sort in increasing order, smallest items first (the default).", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-decreasing", value: Flag, detail: "Sort in decreasing order, largest items first.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-indices", value: Flag, detail: "Return the sorted positions (indices) into list instead of the elements themselves.", surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.5", Some("9.2"))] }]), aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-unique", value: Flag, detail: "Retain only the last element of each run of duplicates in the sorted result. Duplicates are determined by the comparison in use — e.g. with -index 0, {1 a} and {1 b} count as duplicates and only {1 b} is kept.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-command", value: Takes(OptionArg { arity: One, role: CommandPrefix, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [], closed: false, integer: None, hint: "cmdPrefix", appended_arity: Exactly(2) }), detail: "Use cmdPrefix as the comparator: invoked with the two elements being compared appended as additional arguments, and must return an integer less than, equal to, or greater than zero if the first is respectively less than, equal to, or greater than the second. lsort is reentrant, so cmdPrefix may itself call lsort.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-index", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [], closed: false, integer: None, hint: "indexList", appended_arity: Unknown }), detail: "Sort by the sub-element at indexList within each list element (itself treated as a sublist, unless -stride is also given) instead of the whole element; indexList accepts end/end-N and, since Tcl 8.5, may itself be a list of indices for nested sublist access (as if passed to lindex). Combined with -stride, the index is relative to each group. Much more efficient than an equivalent -command comparator.", surface: None, aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }, OptionSpec { name: "-stride", value: Takes(OptionArg { arity: One, role: Value, also_role: None, taints_var_write: false, variable_scope: CurrentFrame, body_kind: Plain, script_timing: SameInvocation, callback_taint_inputs: [], values: [], closed: false, integer: Some(Range(2, 9223372036854775807)), hint: "strideLength", appended_arity: Unknown }), detail: "Treat list as consecutive groups of strideLength elements (strideLength must be at least 2, and list's length a multiple of it), keeping each group's element order fixed while sorting whole groups by their first element, or by the -index'th element within each group when -index is also given.", surface: Some([SpecSurface { provider: Core(Tcl), windows: [("8.6", Some("9.2"))] }]), aliases: [], lifecycle: Lifecycle { introduced: None, deprecated: None, retired: None, deprecation_fix: None }, min_abbrev: None, effect: None }], option_prefix_words: 0, option_relations: [], option_effect_families: [], constraints: None, option_placement: Leading, reserved_trailing_words: 1, arg_values: [], versioned_arg_values: [], body_kind: Plain, body_execution: None, procedure_definition: None, native_compilation: None, successful_handler: None, variable_receivers: None, body_interpreter: Current, body_arg_implicit_args: 0, taint_output_sink: None, taint_output_sink_subcom