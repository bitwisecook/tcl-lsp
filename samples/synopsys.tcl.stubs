# Synopsys Design Compiler / PrimeTime dialect stubs
#
# This file defines command signatures for Synopsys EDA tools so the
# Tcl LSP can understand them for completion, diagnostics, and analysis.
#
# Stub syntax:
#   stub <command> {arg1:role arg2 ?optArg:role?} ?flags?
#
# Argument roles:
#   body      - Tcl script body (recursively analysed)
#   expr      - Expression (expr sub-language)
#   var       - Variable name written by the command
#   var_read  - Variable name read without modification
#   name      - Symbolic name (proc, namespace, design name)
#   pattern   - Pattern or regex
#   channel   - Channel identifier
#   value     - Generic value (default when no role given)
#
# Flags:
#   -barrier      - Creates a dynamic analysis barrier (like eval)
#   -loop         - Has a loop body (foreach-like)
#   -pure         - Side-effect-free
#   -mutator      - Mutates state
#   -unsafe       - Unsafe command
#   -scope_alias  - Creates variable alias (like upvar)

# Collection iteration -- the most important EDA pattern
stub foreach_in_collection {varName:var collection body:body} -loop

# Design queries (pure, no side effects)
stub get_cells {?-hierarchical? ?-filter? pattern:pattern} -pure
stub get_ports {?-filter? pattern:pattern} -pure
stub get_nets {?-hierarchical? ?-filter? pattern:pattern} -pure
stub get_pins {?-hierarchical? ?-filter? pattern:pattern} -pure
stub get_clocks {?-filter? pattern:pattern} -pure
stub get_libs {?-filter? pattern:pattern} -pure
stub sizeof_collection {collection} -pure
stub filter_collection {collection filterExpr:expr} -pure
stub sort_collection {collection sortKeys} -pure
stub index_collection {collection index} -pure
stub add_to_collection {collection objects} -pure
stub remove_from_collection {collection objects} -pure
stub compare_collections {col1 col2} -pure
stub query_objects {objects ?-class?} -pure

# Attribute access (pure reads)
stub get_attribute {object attrName:name} -pure
stub get_object_name {object} -pure

# Attribute mutation
stub set_attribute {object attrName:name value} -mutator

# I/O redirection
stub redirect {?-variable? ?-file? target body:body}

# Design manipulation (mutators)
stub current_design {?designName:name?}
stub set_dont_touch {objects}
stub remove_dont_touch {objects}
stub set_ideal_network {objects}
stub set_max_delay {value ?-from? ?-to?}
stub set_min_delay {value ?-from? ?-to?}
stub create_clock {?-name? clockName:name ?-period? period ?-waveform? waveform portPin}
stub create_generated_clock {?-name? clockName:name ?-source? source ?-divide_by? divisor portPin}
stub set_clock_uncertainty {value ?-setup? ?-hold? clocks}

# Reporting (side effects: output)
stub report_timing {?-from? ?-to? ?-delay_type? ?-max_paths? ?-nworst?}
stub report_area {?-hierarchy?}
stub report_power {?-hierarchy?}
stub report_constraint {?-all_violators?}

# Expression functions available in Synopsys Tcl
stub expr-func sizeof 1
stub expr-func object_class 1
