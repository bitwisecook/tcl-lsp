## After: iRule uses class match against data-group
when HTTP_REQUEST {
    set host [HTTP::host]
    if { [class match $host equals host_whitelist] } {
        pool app_pool
    }
}

## tmsh data-group definition:
# ltm data-group internal host_whitelist {
#     records {
#         app.example.com { }
#         api.example.com { }
#         web.example.com { }
#         cdn.example.com { }
#     }
#     type string
# }
