# T2: the string core.
set s "  Hello, World  "
set t [string trim $s]
puts [string length $t]
puts [string toupper $t]
puts [string tolower $t]
puts [string index $t 0]
puts [string range $t 7 end]
puts [string first o $t]
puts [string last o $t]
puts [string map {World Tcl} $t]
puts [string equal -nocase hello [string range $t 0 4]]
puts [string compare abc abd]
puts [string match "H*d" $t]
puts [string repeat ab 3]
puts [string is integer 42]
puts [string is integer 4x2]
puts [split a,b,c ,]
puts [string reverse abc]
puts [format "%05d|%-4s|%.2f|%x" 42 ab 3.14159 255]
