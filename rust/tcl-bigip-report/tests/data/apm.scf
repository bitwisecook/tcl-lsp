apm policy access-policy /Common/mycave {
    caption general
    default-ending /Common/mycave_end_deny
    items {
        /Common/mycave_act_active_directory {
            priority 2
        }
        /Common/mycave_act_logon_page {
            priority 1
        }
        /Common/mycave_act_resource_assign {
            priority 3
        }
        /Common/mycave_end_allow {
            priority 5
        }
        /Common/mycave_end_deny {
            priority 4
        }
        /Common/mycave_ent_in { }
    }
    start-item /Common/mycave_ent_in
}
