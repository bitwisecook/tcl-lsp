apm policy image-file /Common/login_icon_small.png {
    cache-path /config/filestore/files_d/Common_d/customization_image_d/:Common:login_icon_small.png_160323_1
    revision 1
}
apm policy policy-item /Common/mycave_act_active_directory {
    agents {
        /Common/mycave_act_active_directory_ag {
            type aaa-active-directory
        }
    }
    caption "AD Auth"
    color 1
    item-type action
    rules {
        {
            caption Successful
            expression "expr {[mcget {session.ad.last.authresult}] == 1}"
            next-item /Common/mycave_act_resource_assign
        }
        {
            caption fallback
            next-item /Common/mycave_end_deny
        }
    }
}
apm policy policy-item /Common/mycave_act_logon_page {
    agents {
        /Common/mycave_act_logon_page_ag {
            type logon-page
        }
    }
    caption "Logon Page"
    color 1
    item-type action
    rules {
        {
            caption fallback
            next-item /Common/mycave_act_active_directory
        }
    }
}
apm policy policy-item /Common/mycave_act_resource_assign {
    agents {
        /Common/mycave_act_resource_assign_ag {
            type resource-assign
        }
    }
    caption "Full Resource Assign"
    color 1
    item-type action
    rules {
        {
            caption fallback
            next-item /Common/mycave_end_allow
        }
    }
}
apm policy policy-item /Common/mycave_end_allow {
    agents {
        /Common/mycave_end_allow_ag {
            type ending-allow
        }
    }
    caption Allow
    color 1
    item-type ending
}
apm policy policy-item /Common/mycave_end_deny {
    agents {
        /Common/mycave_end_deny_ag {
            type ending-deny
        }
    }
    caption Deny
    color 2
    item-type ending
}
apm policy policy-item /Common/mycave_ent_in {
    caption Start
    color 1
    rules {
        {
            caption fallback
            next-item /Common/mycave_act_logon_page
        }
    }
}
apm policy agent aaa-active-directory /Common/mycave_act_active_directory_ag {
    server /Common/mycave_aaa_srvr
    type auth
}
apm policy agent ending-allow /Common/mycave_end_allow_ag { }
apm policy agent ending-deny /Common/mycave_end_deny_ag {
    customization-group /Common/mycave_end_deny_ag
}
apm policy agent logon-page /Common/mycave_act_logon_page_ag {
    customization-group /Common/mycave_act_logon_page_ag
}
apm policy agent resource-assign /Common/mycave_act_resource_assign_ag {
    rules {
        {
            network-access-resources { /Common/mycave_na_res }
            remote-desktop-resources { /Common/JB-JC /Common/JB-NC }
            webtop /Common/mycave_rdp
        }
    }
}
apm profile access /Common/mycave {
    accept-languages { de en es fr ja ko zh-cn zh-tw }
    access-policy /Common/mycave
    app-service none
    customization-group /Common/mycave_logout
    default-language en
    defaults-from /Common/access
    eps-group /Common/mycave_eps
    errormap-group /Common/mycave_errormap
    exchange-profile none
    framework-installation-group /Common/mycave_frameworkinstallation
    general-ui-group /Common/mycave_general_ui
    generation 8
    generation-action noop
    logout-uri-include none
    logout-uri-timeout 5
    max-failure-delay 0
    min-failure-delay 0
    modified-since-last-policy-sync true
    user-identity-method http
}
apm profile connectivity /Common/mycave_cp {
    app-service none
    client-policy {
        mycave_cp_clientPolicy { }
    }
    defaults-from /Common/connectivity
    tunnel-name /Common/mycave_cp
}
apm report favorite-report {
    report-name "/Common/Session Details"
    source sessionReports/sessionDetails
    user admin
}
apm resource leasepool /Common/mycave_lp {
    members {
        192.168.1.80-192.168.1.85 { }
    }
}
apm resource network-access /Common/mycave_na_res {
    address-space-local-subnets-excluded true
    address-space-protect true
    compression gzip
    customization-group /Common/mycave_na_res_resource_network_access_customization
    dns-primary 192.168.1.6
    dns-secondary 192.168.1.2
    dns-suffix "localhost wirelessravens.org"
    leasepool-name /Common/mycave_lp
    wins-primary 192.168.1.6
}
apm resource webtop /Common/mycave_rdp {
    customization-group /Common/mycave_rdp_customization
    webtop-type full
}
apm resource webtop /Common/mycave_webtop {
    customization-group /Common/mycave_webtop_customization
    webtop-type network-access
}
apm resource remote-desktop citrix-client-bundle /Common/default-citrix-client-bundle { }
apm resource remote-desktop rdp /Common/JB-JC {
    color-depth 16-bit
    customization-group /Common/JB-JC_resource_remote_desktop_customization
    description "JumpBox JavaClient"
    ip 192.168.1.16
    java-client enabled
    port 3389
    window-height 1024
    window-width 1280
}
apm resource remote-desktop rdp /Common/JB-NC {
    acl-order 1
    color-depth 16-bit
    customization-group /Common/JB-NC_resource_remote_desktop_customization
    description "JumpBox NativeClient"
    ip 192.168.1.16
    port 3389
    window-height 1024
    window-size full-screen
    window-width 1280
}
apm sso saml-sp-connector /Common/saml_office365 {
    assertion-consumer-uri https://login.microsoftonline.com/login.srf
    description "Predefined SP connector object for Office 365"
    entity-id urn:federation:MicrosoftOnline
}
auth user admin {
    description "Admin User"
    encrypted-password $1$AQfobfQF$1TEtmU1MPAyu37dXgR.i0/
    partition-access {
        all-partitions {
            role admin
        }
    }
    shell none
}
auth user root {
    description none
    encrypted-password $1$o/2j5FSo$YhvFZn.0k85.tx0XQ9dDd1
    shell bash
}
