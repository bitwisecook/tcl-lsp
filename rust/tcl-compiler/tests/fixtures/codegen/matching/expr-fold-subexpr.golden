ByteCode ::top, 6 instructions, 11 bytes, 4 literals, 0 variables
  Literals:
    0: "proc"
    1: "f"
    2: ""
    3: "set x [expr {$y + (1+2)}]"
  Instructions:
    (0) push1 0	# "proc"
    (2) push1 1	# "f"
    (4) push1 2	# ""
    (6) push1 3	# "set x [expr {$y + (1+2)}]"
    (8) invokeStk1 4	# proc
    (10) done

ByteCode ::f, 6 instructions, 17 bytes, 1 literals, 2 variables
  Literals:
    0: "3"
  Local variables:
    %v0: "y"
    %v1: "x"
  Instructions:
    (0) startCommand +14 1	# next cmd at pc 14, 1 cmds start here
    (9) loadScalar1 %v0	# var "y"
