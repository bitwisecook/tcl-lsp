+
+fn conditional_statement(
+    source: &str,
+    dialect: &str,
+    selected: &str,
+) -> (Analyser, crate::ir::Statement) {
+    let mut analyser = Analyser::new();
+    analyser.analyse_and_retain_result_for_test(source, dialect);
+    let input = analyser.resolved_analysis_input();
+    let settings = analyser.source_compilation_settings();
+    let unit =
+        crate::compilation_unit::CompilationUnit::build_with_analysis_input_and_source_settings(
+            source,
+            crate::compilation_unit::UnitBuildOptions {
+                registry: input.borrowed_context_registry().commands(),
+                defer_top_level: false,
+                config: input.lexer_config(),
+                dialect: Some(input.unit_profile()),
+                external_call_sites: None,
+                declared_commands: None,
+            },
+            None,
+            &input,
+            &settings,
+        );
+    assert!(unit.ir_module.source_entry.native_entry.is_none());
+    let offset = u32::try_from(source.rfind(selected).unwrap()).unwrap();
+    let mut statements = unit
+        .analysable_body_function_units()
+        .flat_map(|function| function.cfg.blocks.values())
+        .flat_map(|block| &block.statements)
+        .filter(|statement| statement.is_executable_invocation())
+        .filter(|statement| {
+            statement.tokens().is_some_and(|tokens| {
+                tokens.synthetic.is_none()
+                    && tokens
+                        .words()
+                        .first()
+                        .is_some_and(|head| head.source().span.start() == offset)
+            })
+        })
+        .cloned()
+        .collect::<Vec<_>>();
+    assert_eq!(statements.len(), 1, "one original call: {source}");
+    (analyser, statements.pop().unwrap())
+}
