+    /// Original handler availability for the opaque-name warning heuristic.
+    /// Conditional source advice grants no executed target or Native effects.
+    fn diagnostic_callee_available(&self, statement: &crate::ir::Statement) -> bool {
+        self.resolves(statement) || self.authored_registry_callee_available(statement).is_some()
+    }
+
+    fn authored_registry_callee_available(&self, statement: &crate::ir::Statement) -> Option<()> {
+        let input = self.source_input.as_ref()?;
+        let realm = self.source_realm.as_ref()?;
+        realm.matches_resolved_analysis_input(input).then_some(())?;
+        let tokens = statement.tokens()?;
+        (tokens.synthetic.is_none() && tokens.original_words_match_argv_text()).then_some(())?;
+        let binding = tokens.source_binding.as_ref()?;
+        (binding.runtime_reachability()
+            == crate::command_binding::SourceRuntimeReachability::Conditional)
+            .then_some(())?;
+        let site = binding.invocation_site()?;
+        realm
+            .matches_original_source_image(site.source.source_image(), input.lexer_config())
+            .then_some(())?;
+        let metadata =
+            binding.original_invocation_metadata_for_input(tokens, input, self.registry)?;
+        (metadata.context() == self.generation.context()
+            && binding.original_invocation_source_purpose(tokens, metadata, self.registry)?
+                == crate::command_binding::OriginalInvocationSourcePurpose::AuthoredSimulation)
+            .then_some(())?;
+        let advice = binding.declaration_operand_layout_advice(tokens)?;
+        (advice.closed_lookup() && !advice.has_opaque_handler_alternatives()).then_some(())?;
+        let target = binding.proved_target()?;
+        (target.registry_backed && advice.targets() == std::slice::from_ref(target))
+            .then_some(())?;
+        metadata
+            .context()
+            .resolve_spec(self.registry, target.registry_identity()?)
+            .is_some()
+            .then_some(())
+    }
