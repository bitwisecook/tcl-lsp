+#[test]
+fn authored_conditional_registry_availability_is_diagnostic_only() {
+    let source = "proc p {} {foreach x {} {}; if {[info exists x]} {puts yes}; puts $x}; foreach y {} {}; puts $y";
+    for dialect in ["tcl8.4", "tcl8.5", "tcl8.6", "tcl9.0", "tcl9.1"] {
+        let (analyser, statement) = conditional_statement(source, dialect, "foreach x {} {}");
+        let context = analyser.analysis_context();
+        let resolver = analyser.unit_command_resolver(context.commands());
+        let binding = statement.tokens().unwrap().source_binding.as_ref().unwrap();
+        assert_eq!(
+            binding.runtime_reachability(),
+            crate::command_binding::SourceRuntimeReachability::Conditional,
+        );
+        assert!(!resolver.resolves(&statement), "{dialect}");
+        assert!(
+            resolver.diagnostic_callee_available(&statement),
+            "{dialect}"
+        );
+        assert!(binding.proved_execution_target().is_none());
+        assert!(binding.admitted_inline_invocation().is_none());
+        assert!(binding.admitted_named_invocation().is_none());
+    }
+}
+
+#[test]
+fn conditional_registry_availability_requires_its_original_source_owner() {
+    let source = "proc p {} {foreach x {} {}; puts $x}; error fail";
+    let (analyser, statement) = conditional_statement(source, "tcl8.6", "foreach x {} {}");
+    let context = analyser.analysis_context();
+    let mut resolver = analyser.unit_command_resolver(context.commands());
+    assert!(resolver.diagnostic_callee_available(&statement));
+    let input = resolver.source_input.take().unwrap();
+    assert!(!resolver.diagnostic_callee_available(&statement));
+    resolver.source_input = Some(input);
+    let realm = resolver.source_realm.take().unwrap();
+    assert!(!resolver.diagnostic_callee_available(&statement));
+    resolver.source_realm = Some(realm);
+    let mut changed = statement.clone();
+    changed.tokens_mut().unwrap().argv_texts[1] = "different".into();
+    assert!(!resolver.diagnostic_callee_available(&changed));
+    for name in ["foreach", "puts", "operation"] {
+        assert!(!resolver.diagnostic_callee_available(&unproved_call(name)));
+    }
+    let mut foreign = Analyser::new();
+    foreign.analyse_and_retain_result_for_test(source, "tcl9.1");
+    foreign
+        .result
+        .resolved_input
+        .clone_into(&mut resolver.source_input);
+    assert!(!resolver.diagnostic_callee_available(&statement));
+}
+
+#[test]
+fn conditional_registry_availability_keeps_shadowed_and_unknown_calls_opaque() {
+    for source in [
+        "proc foreach args {}; proc p {} {foreach x {} {}; puts $x}; error fail",
+        "proc p {} {operation; foreach x {} {}; puts $x}; error fail",
+    ] {
+        let (analyser, statement) = conditional_statement(source, "tcl8.6", "foreach x {} {}");
+        let context = analyser.analysis_context();
+        let resolver = analyser.unit_command_resolver(context.commands());
+        assert!(
+            resolver
+                .authored_registry_callee_available(&statement)
+                .is_none()
+        );
+        assert!(!resolver.resolves(&statement));
+    }
+}
