+/// Only a command expression, optionally negated, owns these completed bytes.
+fn source_completed_expression_truth(
+    expression: &crate::expr_ast::ExprNode,
+    value: Option<&native_result::EvaluatedSourceValue>,
+    dialect: Option<tcl_registry::InvocationDialect>,
+) -> Option<bool> {
+    let value = value?;
+    let mut expression = expression;
+    let mut negated = false;
+    while let crate::expr_ast::ExprNode::Unary {
+        op: crate::expr_ast::UnaryOp::Not,
+        operand,
+    } = expression
+    {
+        expression = operand;
+        negated = !negated;
+    }
+    if !matches!(expression, crate::expr_ast::ExprNode::Command { .. }) {
+        return None;
+    }
+    let truth = dialect.map_or_else(
+        || tcl_syntax::boolean::truthiness_in_every_release(&value.text),
+        |dialect| tcl_syntax::boolean::truthiness_with(&value.text, dialect.numbers),
+    )?;
+    Some(truth ^ negated)
