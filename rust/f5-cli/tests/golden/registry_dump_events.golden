    "tcp_clientssl_serverssl_http_collect": {
      "chain_id": "tcp_clientssl_serverssl_http_collect",
      "description": "Full HTTPS with HTTP::collect (request + response body)",
      "notes": "Both HTTP_REQUEST_DATA and HTTP_RESPONSE_DATA fire because the iRule calls HTTP::collect in the respective request/response events.  Client sends a POST with body.",
      "profiles": [
        "CLIENTSSL",
        "HTTP",
        "SERVERSSL",
        "TCP"
      ],
      "steps": [
        {
          "condition_note": "",
