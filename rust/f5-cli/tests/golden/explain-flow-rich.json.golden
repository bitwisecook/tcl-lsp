        {
          "rule": "/Common/rule_rich",
          "event": "CLIENT_ACCEPTED",
          "body": "\n    log local0. \"accepted [IP::client_addr]:[TCP::client_port] -> [IP::local_addr]:[TCP::local_port]\"\n"
        },
        {
          "rule": "/Common/rule_rich",
          "event": "CLIENTSSL_CLIENTHELLO",
          "body": "\n    set sni [SSL::extensions servername]\n    log local0. \"sni=[SNI]\"\n"
        },
        {
          "rule": "/Common/rule_rich",
          "event": "HTTP_REQUEST",
          "body": "\n    if { [HTTP::host] equals \"old.example.com\" } {\n        HTTP::redirect \"https://new.example.com[HTTP::uri]\"\n    }\n    set ua [HTTP::header User-Agent]\n    log local0. \"method=[HTTP::method] path=[HTTP::path] q=[HTTP::query] v=[HTTP::version]\"\n"
        },
        {
          "rule": "/Common/rule_rich",
          "event": "LB_SELECTED",
          "body": "\n    log local0. \"picked [LB::server]\"\n"
        },
        {
          "rule": "/Common/rule_rich",
          "event": "MY_CUSTOM_EVENT",
          "body": "\n    log local0. \"custom\"\n"
        }
