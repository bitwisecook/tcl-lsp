{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "f5-validate",
          "rules": [
            {
              "id": "orphan-monitor",
              "shortDescription": {
                "text": "orphan monitor"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "virtual-without-pool",
              "shortDescription": {
                "text": "virtual without pool"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "pool-without-monitor",
              "shortDescription": {
                "text": "pool without monitor"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "irule-deprecated-command",
              "shortDescription": {
                "text": "irule deprecated command"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "irule-empty-when",
              "shortDescription": {
                "text": "irule empty when"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "irule-unknown-event",
              "shortDescription": {
                "text": "irule unknown event"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "orphan-monitor",
          "level": "note",
          "message": {
            "text": "monitor not referenced by any pool in this config"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/factory_mon"
                }
              }
            }
          ]
        },
        {
          "ruleId": "orphan-monitor",
          "level": "warning",
          "message": {
            "text": "monitor not referenced by any pool"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Partition2/orphan_mon"
                }
              }
            }
          ]
        },
        {
          "ruleId": "virtual-without-pool",
          "level": "note",
          "message": {
            "text": "virtual has no default pool and no iRules attached"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/vs_no_pool"
                }
              }
            }
          ]
        },
        {
          "ruleId": "pool-without-monitor",
          "level": "warning",
          "message": {
            "text": "pool has no health monitor (pool-level or per-member)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/no_monitor_pool"
                }
              }
            }
          ]
        },
        {
          "ruleId": "irule-deprecated-command",
          "level": "warning",
          "message": {
            "text": "X509::extensions is deprecated; use X509::extensions_count + X509::extensions_get"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/deprecated_rule"
                }
              }
            }
          ]
        },
        {
          "ruleId": "irule-deprecated-command",
          "level": "warning",
          "message": {
            "text": "use 'log local0.<facility> ...' (no underscore form)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/deprecated_rule"
                }
              }
            }
          ]
        },
        {
          "ruleId": "irule-empty-when",
          "level": "note",
          "message": {
            "text": "iRule contains a `when` block with no statements"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/empty_when_rule"
                }
              }
            }
          ]
        },
        {
          "ruleId": "irule-unknown-event",
          "level": "warning",
          "message": {
            "text": "iRule references unknown event 'TOTALLY_FAKE_EVENT'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/unknown_event_rule"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
