{
  "class": "AS3",
  "declaration": {
    "class": "ADC",
    "schemaVersion": "3.45.0",
    "Common": {
      "class": "Tenant",
      "app": {
        "class": "Application",
        "template": "generic",
        "web_pool": {
          "class": "Pool",
          "members": [
            {
              "servicePort": 80,
              "serverAddresses": [
                "10.0.1.10"
              ]
            },
            {
              "servicePort": 80,
              "serverAddresses": [
                "10.0.1.11"
              ]
            }
          ],
          "loadBalancingMode": "round-robin",
          "monitors": [
            {
              "use": "my_http_monitor"
            }
          ]
        },
        "api_pool": {
          "class": "Pool",
          "members": [
            {
              "servicePort": 8080,
              "serverAddresses": [
                "10.0.1.11"
              ]
            },
            {
              "servicePort": 8080,
              "serverAddresses": [
                "10.0.1.12"
              ]
            }
          ],
          "loadBalancingMode": "least-connections-member",
          "monitors": [
            {
              "use": "my_http_monitor"
            }
          ]
        },
        "empty_pool": {
          "class": "Pool",
          "members": [],
          "monitors": [
            {
              "use": "my_http_monitor"
            }
          ]
        },
        "www_vs": {
          "class": "Service_HTTP",
          "virtualAddresses": [
            "10.0.0.1"
          ],
          "virtualPort": 443,
          "pool": "web_pool",
          "iRules": [
            "route_by_host",
            "ip_blocklist",
            "uri_rewrite"
          ],
          "persistenceMethods": [
            "my_cookie_persist"
          ]
        },
        "api_vs": {
          "class": "Service_HTTP",
          "virtualAddresses": [
            "10.0.0.2"
          ],
          "virtualPort": 443,
          "pool": "api_pool",
          "iRules": [
            "route_by_host"
          ]
        },
        "ssl_only_vs": {
          "class": "Service_HTTPS",
          "virtualAddresses": [
            "10.0.0.3"
          ],
          "virtualPort": 443,
          "pool": "web_pool",
          "iRules": [
            "ssl_info",
            "route_by_host"
          ]
        },
        "bad_vs": {
          "class": "Service_TCP",
          "virtualAddresses": [
            "10.0.0.4"
          ],
          "virtualPort": 80,
          "pool": "nonexistent_pool",
          "iRules": [
            "nonexistent_rule",
            "bad_references",
            "bad_references"
          ]
        },
        "route_by_host": {
          "class": "iRule",
          "iRule": "when HTTP_REQUEST {\n        if { [class match [HTTP::host] equals allowed_hosts] } {\n            switch -glob [HTTP::uri] {\n                \"/api/*\" {\n                    pool /Common/api_pool\n                }\n                default {\n                    pool /Common/web_pool\n                }\n            }\n        } else {\n            reject\n        }\n    }"
        },
        "ip_blocklist": {
          "class": "iRule",
          "iRule": "when CLIENT_ACCEPTED {\n        if { [class match [IP::remote_addr] equals blocked_ips] } {\n            drop\n        }\n    }"
        },
        "uri_rewrite": {
          "class": "iRule",
          "iRule": "when HTTP_REQUEST priority 100 {\n        set redirect_target [class lookup [HTTP::uri] uri_redirect_map]\n        if { $redirect_target ne \"\" } {\n            HTTP::redirect \"https://[HTTP::host]$redirect_target\"\n        }\n    }"
        },
        "ssl_info": {
          "class": "iRule",
          "iRule": "when CLIENTSSL_HANDSHAKE {\n        log local0. \"Client SSL: [SSL::cipher name] [SSL::cipher version]\"\n    }"
        },
        "bad_references": {
          "class": "iRule",
          "iRule": "when HTTP_REQUEST {\n        # This references a data-group that does not exist\n        if { [class match [HTTP::host] equals nonexistent_datagroup] } {\n            drop\n        }\n        # This references a pool that does not exist\n        pool /Common/missing_pool\n        # This references a SNAT pool that does not exist\n        snatpool /Common/missing_snatpool\n    }"
        },
        "my_http_monitor": {
          "class": "Monitor",
          "monitorType": "http"
        }
      }
    }
  }
}
