[
  {
    "www_vs": {
      "kind": "ltm virtual",
      "full-path": "/Common/www_vs",
      "fields": {
        "name": "www_vs",
        "full-path": "/Common/www_vs",
        "destination": "/Common/10.0.0.1:443",
        "pool": "/Common/web_pool",
        "rules": [
          "/Common/route_by_host",
          "/Common/ip_blocklist",
          "/Common/uri_rewrite"
        ],
        "profiles": [
          "/Common/my_http_profile { context all }",
          "/Common/my_tcp_profile { context all }",
