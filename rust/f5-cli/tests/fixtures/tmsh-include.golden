tmsh create ltm pool /Common/web_pool { load-balancing-mode round-robin monitor /Common/my_http_monitor members replace-all-with { /Common/web1:80 { address 10.0.1.10 } /Common/web2:80 { address 10.0.1.11 } } }
tmsh create ltm pool /Common/api_pool { load-balancing-mode least-connections-member monitor /Common/my_http_monitor members replace-all-with { /Common/web2:8080 { address 10.0.1.11 } /Common/web3:8080 { address 10.0.1.12 } } }
tmsh create ltm pool /Common/empty_pool { monitor /Common/my_http_monitor }
tmsh create ltm virtual /Common/www_vs { destination /Common/10.0.0.1:443 pool /Common/web_pool profiles replace-all-with { /Common/my_http_profile { } /Common/my_tcp_profile { } /Common/my_clientssl { } /Common/my_serverssl { } /Common/my_oneconnect { } } rules replace-all-with { /Common/route_by_host /Common/ip_blocklist /Common/uri_rewrite } persist replace-all-with { /Common/my_cookie_persist { } } snatpool /Common/my_snatpool source-address-translation { type snat } }
tmsh create ltm virtual /Common/api_vs { destination /Common/10.0.0.2:443 pool /Common/api_pool profiles replace-all-with { /Common/my_http_profile { } /Common/my_tcp_profile { } /Common/my_clientssl { } } rules replace-all-with { /Common/route_by_host } }
tmsh create ltm virtual /Common/ssl_only_vs { destination /Common/10.0.0.3:443 pool /Common/web_pool profiles replace-all-with { /Common/my_tcp_profile { } /Common/my_clientssl { } } rules replace-all-with { /Common/ssl_info /Common/route_by_host } }
tmsh create ltm virtual /Common/bad_vs { destination /Common/10.0.0.4:80 pool /Common/nonexistent_pool profiles replace-all-with { /Common/my_tcp_profile { } } rules replace-all-with { /Common/nonexistent_rule /Common/bad_references /Common/bad_references } }
