{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "f5-validate",
          "rules": [
            {
              "id": "empty-pool",
              "shortDescription": {
                "text": "empty pool"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "irule-missing-data-group",
              "shortDescription": {
                "text": "irule missing data group"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "irule-missing-pool",
              "shortDescription": {
                "text": "irule missing pool"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "irule-missing-snat-pool",
              "shortDescription": {
                "text": "irule missing snat pool"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "empty-pool",
          "level": "warning",
          "message": {
            "text": "pool has no members"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/empty_pool"
                }
              }
            }
          ]
        },
        {
          "ruleId": "irule-missing-data-group",
          "level": "warning",
          "message": {
            "text": "iRule references data-group 'nonexistent_datagroup' (via `class`) but no such object exists"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/bad_references"
                }
              }
            }
          ]
        },
        {
          "ruleId": "irule-missing-pool",
          "level": "warning",
          "message": {
            "text": "iRule references pool '/Common/missing_pool' (via `pool`) but no such object exists"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/bad_references"
                }
              }
            }
          ]
        },
        {
          "ruleId": "irule-missing-snat-pool",
          "level": "warning",
          "message": {
            "text": "iRule references snat-pool '/Common/missing_snatpool' (via `snatpool`) but no such object exists"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/Common/bad_references"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
