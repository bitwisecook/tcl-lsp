{
  "bundles": [
    {
      "rule": {
        "fullPath": "/Common/full_ctx_rule",
        "name": "full_ctx_rule",
        "source": "when HTTP_REQUEST {\n        pool /Common/web_pool\n        persist /Common/src_persist\n        snatpool /Common/my_snatpool\n        SSL::profile /Common/clientssl_profile\n        if { [class match [HTTP::host] equals host_dg] } {\n            node /Common/n1\n        }\n        pool /Common/ghost_pool\n        persist /Common/ghost_persist\n    }"
      },
      "pools": [
        {
          "fullPath": "/Common/web_pool",
          "monitor": "/Common/http_mon",
          "loadBalancingMode": null,
          "members": [
            {
              "name": "/Common/n1:80",
              "address": "10.0.0.1",
              "port": null,
              "monitor": null
            }
          ]
        }
      ],
      "dataGroups": [
        {
          "fullPath": "/Common/host_dg",
          "kind": "internal",
          "valueType": "string",
          "recordCount": 1,
          "records": [
            "www.example.com"
          ]
        }
      ],
      "persistence": [
        {
          "fullPath": "/Common/src_persist",
          "type": "source-addr"
        }
      ],
      "snatPools": [
        {
          "fullPath": "/Common/my_snatpool",
          "members": [
            "/Common/snat1"
          ]
        }
      ],
      "profiles": [
        {
          "fullPath": "/Common/clientssl_profile",
          "type": "client_ssl"
        }
      ],
      "monitors": [
        {
          "fullPath": "/Common/http_mon",
          "type": "http"
        }
      ],
      "nodes": [
        {
          "fullPath": "/Common/n1",
          "address": "10.0.0.1"
        }
      ],
      "rules": [],
      "unresolved": {
        "pool": [
          "/Common/ghost_pool"
        ],
        "persistence": [
          "/Common/ghost_persist"
        ]
      },
      "sourceSlices": {
        "/Common/full_ctx_rule": "ltm rule /Common/full_ctx_rule {\n    when HTTP_REQUEST {\n        pool /Common/web_pool\n        persist /Common/src_persist\n        snatpool /Common/my_snatpool\n        SSL::profile /Common/clientssl_profile\n        if { [class match [HTTP::host] equals host_dg] } {\n            node /Common/n1\n        }\n        pool /Common/ghost_pool\n        persist /Common/ghost_persist\n    }\n}\n",
        "/Common/web_pool": "ltm pool /Common/web_pool {\n    members {\n        /Common/n1:80 {\n            address 10.0.0.1\n        }\n    }\n    monitor /Common/http_mon\n}\n",
        "/Common/src_persist": "ltm persistence source-addr /Common/src_persist {\n    timeout 180\n}\n",
        "/Common/my_snatpool": "ltm snatpool /Common/my_snatpool {\n    members {\n        /Common/snat1\n    }\n}\n",
        "/Common/clientssl_profile": "ltm profile client-ssl /Common/clientssl_profile {\n    cert /Common/default.crt\n}\n",
        "/Common/host_dg": "ltm data-group internal /Common/host_dg {\n    type string\n    records {\n        www.example.com { }\n    }\n}\n",
        "/Common/n1": "ltm node /Common/n1 {\n    address 10.0.0.1\n}\n",
        "/Common/http_mon": "ltm monitor http /Common/http_mon {\n    interval 5\n}\n"
      }
    }
  ]
}
