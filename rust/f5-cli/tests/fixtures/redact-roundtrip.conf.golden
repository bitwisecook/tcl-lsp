# Redact test fixture: public IPv4/IPv6, secrets, and a PEM block.

ltm node /Common/edge1 {
    address 93.184.216.34
}

ltm node /Common/edge2 {
    address 93.184.216.35
}

ltm node /Common/dns1 {
    address 8.8.8.8
}

ltm node /Common/dns2 {
    address 1.1.1.1
}

ltm node /Common/v6host {
    address 2001:4860:4860::8888
}

ltm node /Common/internal {
    address 8.8.8.10
}

ltm pool /Common/edge_pool {
    members {
        /Common/edge1:443 {
            address 93.184.216.34
        }
        /Common/edge2:443 {
            address 93.184.216.35
        }
    }
}

ltm monitor http /Common/mon {
    recv "200 OK"
    password <REDACTED>
}

ltm profile client-ssl /Common/csl {
    passphrase <REDACTED>
    cert-key-chain {
        default {
            key "-----BEGIN RSA PRIVATE KEY-----<REDACTED>-----END RSA PRIVATE KEY-----"
        }
    }
}

sys snmp {
    communities {
        comm1 {
            community <REDACTED>
        }
    }
}

ltm virtual /Common/vs1 {
    destination /Common/93.184.216.34:443
    pool /Common/edge_pool
}
