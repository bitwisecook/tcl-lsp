# ===== iRule /Common/full_ctx_rule =====
ltm rule /Common/full_ctx_rule {
    when HTTP_REQUEST {
        pool /Common/web_pool
        persist /Common/src_persist
        snatpool /Common/my_snatpool
        SSL::profile /Common/clientssl_profile
        if { [class match [HTTP::host] equals host_dg] } {
            node /Common/n1
        }
        pool /Common/ghost_pool
        persist /Common/ghost_persist
    }
}

# ===== referenced pool /Common/web_pool =====
ltm pool /Common/web_pool {
    members {
        /Common/n1:80 {
            address 10.0.0.1
        }
    }
    monitor /Common/http_mon
}

# ===== referenced data-group /Common/host_dg =====
ltm data-group internal /Common/host_dg {
    type string
    records {
        www.example.com { }
    }
}

# ===== referenced persistence /Common/src_persist =====
ltm persistence source-addr /Common/src_persist {
    timeout 180
}

# ===== referenced snat-pool /Common/my_snatpool =====
ltm snatpool /Common/my_snatpool {
    members {
        /Common/snat1
    }
}

# ===== referenced profile /Common/clientssl_profile =====
ltm profile client-ssl /Common/clientssl_profile {
    cert /Common/default.crt
}

# ===== referenced monitor /Common/http_mon =====
ltm monitor http /Common/http_mon {
    interval 5
}

# ===== referenced node /Common/n1 =====
ltm node /Common/n1 {
    address 10.0.0.1
}

# ===== unresolved =====
# persistence: /Common/ghost_persist
# pool: /Common/ghost_pool
