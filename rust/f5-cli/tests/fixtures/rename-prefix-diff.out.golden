--- __FIXTURES__/bigip.conf
+++ __FIXTURES__/bigip.conf (modified)
@@ -44,15 +44,15 @@
     type string
 }
 
-ltm node /Common/web1 {
+ltm node /Tenant_A/web1 {
     address 10.0.1.10
 }
 
-ltm node /Common/web2 {
+ltm node /Tenant_A/web2 {
     address 10.0.1.11
 }
 
-ltm node /Common/web3 {
+ltm node /Tenant_A/web3 {
     address 10.0.1.12
 }
 
@@ -64,12 +64,12 @@
     recv "200 OK"
 }
 
-ltm pool /Common/web_pool {
+ltm pool /Tenant_A/web_pool {
     members {
-        /Common/web1:80 {
+        /Tenant_A/web1:80 {
             address 10.0.1.10
         }
-        /Common/web2:80 {
+        /Tenant_A/web2:80 {
             address 10.0.1.11
         }
     }
@@ -79,10 +79,10 @@
 
 ltm pool /Common/api_pool {
     members {
-        /Common/web2:8080 {
+        /Tenant_A/web2:8080 {
             address 10.0.1.11
         }
-        /Common/web3:8080 {
+        /Tenant_A/web3:8080 {
             address 10.0.1.12
         }
     }
@@ -143,7 +143,7 @@
                     pool /Common/api_pool
                 }
                 default {
-                    pool /Common/web_pool
+                    pool /Tenant_A/web_pool
                 }
             }
         } else {
@@ -190,7 +190,7 @@
 
 ltm virtual /Common/www_vs {
     destination /Common/10.0.0.1:443
-    pool /Common/web_pool
+    pool /Tenant_A/web_pool
     profiles {
         /Common/my_http_profile {
             context all
@@ -237,7 +237,7 @@
 
 ltm virtual /Common/ssl_only_vs {
     destination /Common/10.0.0.3:443
-    pool /Common/web_pool
+    pool /Tenant_A/web_pool
     profiles {
         /Common/my_tcp_profile { }
         /Common/my_clientssl { }
