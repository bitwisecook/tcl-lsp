command grid {
    available {tcl 8.4-} {package Tk}
    traits TK_GEOMETRY_MANAGER
    arity 1..
    required_package Tk
    tk_geometry Exclusive -container-option -in -direct-form -placement-subcommand configure -release-subcommands {forget remove}
    warn_missing_import no

    side_effect InterpState -writes

    option -row -takes n \
        -detail {Insert the slave so that it occupies the nth row in the grid.}
    option -column -takes n \
        -detail {Insert the slave so that it occupies the nth column in the grid.}
    option -rowspan -takes n \
        -detail {Insert the slave so that it occupies n rows in the grid.}
    option -columnspan -takes n \
        -detail {Insert the slave so that it occupies n columns in the grid.}
    option -sticky -takes nsew \
        -detail {Specifies which edges of the cell the slave sticks to (combination of n, s, e, w).}
    option -padx -takes amount \
        -detail {Specifies external horizontal padding for the slave.}
    option -pady -takes amount -detail {Specifies external vertical padding for the slave.}
    option -ipadx -takes amount \
        -detail {Specifies internal horizontal padding for the slave.}
    option -ipady -takes amount -detail {Specifies internal vertical padding for the slave.}
    option -in -takes master -detail {Insert the slave into the specified master window.}
    option -weight -takes int \
        -detail {Relative weight for apportioning extra space (columnconfigure/rowconfigure).}
    option -minsize -takes amount \
        -detail {Minimum size of the column or row (columnconfigure/rowconfigure).}
    option -pad -takes amount \
        -detail {Extra padding for the largest slave (columnconfigure/rowconfigure).}
    option -uniform -takes group \
        -detail {Group columns/rows for uniform sizing (columnconfigure/rowconfigure).}

    form Default {grid option arg ?arg ...?}

    hover {
        summary {Geometry manager that arranges widgets in a grid.}
        synopsis {grid slave ?slave ...? ?option value ...?}
        synopsis {grid configure slave ?slave ...? ?option value ...?}
        synopsis {grid columnconfigure master index ?-option value ...?}
        synopsis {grid rowconfigure master index ?-option value ...?}
        synopsis {grid bbox master ?column row? ?column2 row2?}
        synopsis {grid forget slave ?slave ...?}
        synopsis {grid info slave}
        synopsis {grid location master x y}
        synopsis {grid propagate master ?boolean?}
        synopsis {grid size master}
        synopsis {grid slaves master ?-option value?}
        source {Tk man page grid.n}
    }

    subcommand anchor {
        arity 1..2
        detail {Set the anchor point for the grid within the master window.}
        synopsis {grid anchor master ?anchor?}
    }

    subcommand bbox {
        arity 1..5
        detail {Return the bounding box of a cell or group of cells.}
        synopsis {grid bbox master ?column row? ?column2 row2?}
    }

    subcommand columnconfigure {
        arity 2..
        detail {Query or set column properties of the grid.}
        synopsis {grid columnconfigure master index ?-option value ...?}

        option -weight -takes int \
            -detail {Relative weight for apportioning extra space (columnconfigure/rowconfigure).}
        option -minsize -takes amount \
            -detail {Minimum size of the column or row (columnconfigure/rowconfigure).}
        option -pad -takes amount \
            -detail {Extra padding for the largest slave (columnconfigure/rowconfigure).}
        option -uniform -takes group \
            -detail {Group columns/rows for uniform sizing (columnconfigure/rowconfigure).}
    }

    subcommand configure {
        arity 1..
        detail {Set or query the grid options for one or more slaves.}
        synopsis {grid configure slave ?slave ...? ?option value ...?}

        option -row -takes n \
            -detail {Insert the slave so that it occupies the nth row in the grid.}
        option -column -takes n \
            -detail {Insert the slave so that it occupies the nth column in the grid.}
        option -rowspan -takes n \
            -detail {Insert the slave so that it occupies n rows in the grid.}
        option -columnspan -takes n \
            -detail {Insert the slave so that it occupies n columns in the grid.}
        option -sticky -takes nsew \
            -detail {Specifies which edges of the cell the slave sticks to (combination of n, s, e, w).}
        option -padx -takes amount \
            -detail {Specifies external horizontal padding for the slave.}
        option -pady -takes amount \
            -detail {Specifies external vertical padding for the slave.}
        option -ipadx -takes amount \
            -detail {Specifies internal horizontal padding for the slave.}
        option -ipady -takes amount \
            -detail {Specifies internal vertical padding for the slave.}
        option -in -takes master \
            -detail {Insert the slave into the specified master window.}
    }

    subcommand content {
        arity 1..
        detail {Return a list of all slaves in the grid for the master (9.0+ name for `slaves`).}
        synopsis {grid content master ?-option value?}
        available {tcl 9.0-}
    }

    subcommand forget { arity 1.. ; detail {Remove each slave from the grid for its master.} ; synopsis {grid forget slave ?slave ...?} }
    subcommand info { arity 1 ; detail {Return a list of the current grid configuration for the slave.} ; synopsis {grid info slave} }
    subcommand location { arity 3 ; detail {Return the column and row containing the screen point x, y.} ; synopsis {grid location master x y} }

    subcommand propagate {
        arity 1..2
        detail {Control whether the master computes its geometry from slaves.}
        synopsis {grid propagate master ?boolean?}
    }

    subcommand remove {
        arity 1..
        detail {Remove each slave from the grid, but remember its configuration.}
        synopsis {grid remove slave ?slave ...?}
    }

    subcommand rowconfigure {
        arity 2..
        detail {Query or set row properties of the grid.}
        synopsis {grid rowconfigure master index ?-option value ...?}

        option -weight -takes int \
            -detail {Relative weight for apportioning extra space (columnconfigure/rowconfigure).}
        option -minsize -takes amount \
            -detail {Minimum size of the column or row (columnconfigure/rowconfigure).}
        option -pad -takes amount \
            -detail {Extra padding for the largest slave (columnconfigure/rowconfigure).}
        option -uniform -takes group \
            -detail {Group columns/rows for uniform sizing (columnconfigure/rowconfigure).}
    }

    subcommand size { arity 1 ; detail {Return the size of the grid as a list of two elements (columns, rows).} ; synopsis {grid size master} }

    subcommand slaves {
        arity 1..
        detail {Return a list of all slaves in the grid for the master.}
        synopsis {grid slaves master ?-option value?}

        option -row -takes n \
            -detail {Insert the slave so that it occupies the nth row in the grid.}
        option -column -takes n \
            -detail {Insert the slave so that it occupies the nth column in the grid.}
    }
}

command history {
    available {tcl 8.4-}
    traits {UNSAFE OVERRIDABLE_LIBRARY_PROC}
    unsafe_command

    side_effect InterpState -reads -writes

    form Default {history subcommand ?arg ...?}

    hover {
        summary {Manipulate the history list of previously executed commands.}
        synopsis {history}
        synopsis {history add command ?exec?}
        synopsis {history change newValue ?event?}
        synopsis {history clear}
        synopsis {history event ?event?}
        synopsis {history info ?count?}
        synopsis {history keep ?count?}
        synopsis {history nextid}
        synopsis {history redo ?event?}
        source {Tcl stdlib history command}
    }

    subcommand add { arity 1..2 ; detail {Add a command to the history list.} ; synopsis {history add command ?exec?} }
    subcommand change { arity 1..2 ; detail {Replace a history event.} ; synopsis {history change newValue ?event?} }
    subcommand clear { arity 0 ; detail {Clear the history list.} ; synopsis {history clear} }
    subcommand event { arity ..1 ; detail {Return a history event by number or pattern.} ; synopsis {history event ?event?} }
    subcommand info { arity ..1 ; detail {Return a formatted history list.} ; synopsis {history info ?count?} }
    subcommand keep { arity ..1 ; detail {Get or set the size of the history list.} ; synopsis {history keep ?count?} }
    subcommand nextid { arity 0 ; detail {Return the next event number.} ; synopsis {history nextid} }
    subcommand redo { arity ..1 ; detail {Re-evaluate a history event.} ; synopsis {history redo ?event?} }
}

command hook {
    available {tcl 8.5-}
    arity 1..
    required_package hook
    tcllib_package hook

    hover {
        summary {Publish/subscribe hook points between decoupled components.}
        synopsis {hook subcommand ?arg ...?}
        source {tcllib hook package}
    }

    subcommand bind {
        detail {This subcommand is used to create, update, delete, and query hook bindings.}
        synopsis {hook bind ?subject? ?hook? ?observer? ?binding?}
        command_prefix_resolver -native hook::bind::command_prefix_resolver
        script_timing_resolver -native hook::bind::script_timing_resolver
    }

    subcommand call {
        arity 2..
        detail {This command is called when the named subject wishes to call the named hook.}
        synopsis {hook call subject hook}
    }

    subcommand forget {
        arity 1
        detail {This command deletes any existing bindings in which the named object appears as either the subject or the observer.}
        synopsis {hook forget object}
    }

    subcommand cget {
        arity 1
        detail {This command returns the value of one of the hook command's configuration options.}
        synopsis {hook cget option}
    }

    subcommand configure {
        arity 1..
        detail {This command sets the value of one or more of the hook command's configuration options: If the value of this option}
        synopsis {hook configure option value ...}
    }
}

