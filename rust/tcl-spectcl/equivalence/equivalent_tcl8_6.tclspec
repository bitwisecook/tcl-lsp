command ttk::style {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    introduced_version 8.5
    warn_missing_import no

    side_effect InterpState -writes

    form Default {ttk::style subcommand ?arg ...?}

    hover {
        summary {Manipulate ttk styles and themes.}
        synopsis {ttk::style subcommand ?arg ...?}
        source {Tk man page ttk_style.n}
    }

    subcommand configure { arity 1.. ; detail {Set or query style options.} ; synopsis {ttk::style configure style ?-option ?value ...??} }

    subcommand element {
        arity 1..
        detail {Manage style elements.}
        synopsis {ttk::style element subcommand ?args?}
        arg 0 -values-from ttk-style-element-arg0
    }

    subcommand layout { arity 1..2 ; detail {Define or query the layout of a style.} ; synopsis {ttk::style layout style ?layoutSpec?} }
    subcommand lookup { arity 2..4 ; detail {Look up a style option value.} ; synopsis {ttk::style lookup style -option ?state? ?default?} }

    subcommand map {
        arity 1..
        detail {Set dynamic (state-dependent) style options.}
        synopsis {ttk::style map style ?-option {statespec value ...} ...?}
    }

    subcommand theme {
        arity 1..
        detail {Manage and query themes.}
        synopsis {ttk::style theme subcommand ?args?}
        arg 0 -values-from ttk-style-theme-arg0
    }
}

