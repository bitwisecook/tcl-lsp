    arity 2
    required_package md4
    tcllib_package md4

    hover {
        summary {Add data to an in-progress MD4 digest identified by its token.}
        synopsis {md4::MD4Update token data}
        source {tcllib md4 package}
    }
}

command md4::hmac {
    available {tcl 8.5-}
    traits PURE
    arity 2..
    required_package md4
    tcllib_package md4

    side_effect Unknown -reads

    option -hex -detail {Return the MAC as a hexadecimal string.}
    option -key -takes key -detail {The secret key for the keyed MAC.}
    option -channel -takes channel -role Channel \
        -detail {Read the message from an open channel.}
    option -file -takes filename -detail {Read the message from a named file.}

    hover {
        summary {Compute an MD4 keyed hash-based message authentication code.}
        synopsis {md4::hmac ?-hex? -key key ?-channel channel | -file filename? ?--? ?string?}
        source {tcllib md4 package}
        returns {The HMAC-MD4 value (binary, or hex with -hex).}
    }
}

command md4::md4 {
    available {tcl 8.5-}
    traits PURE
    arity 1..
    required_package md4
    tcllib_package md4

    side_effect Unknown -reads

    option -hex -detail {Return the digest as a hexadecimal string.}
    option -channel -takes channel -role Channel \
        -detail {Read the message from an open channel.}
    option -file -takes filename -detail {Read the message from a named file.}

    hover {
        summary {Compute the MD4 message-digest of a string, file, or channel.}
        synopsis {md4::md4 ?-hex? ?-channel channel | -file filename? ?--? ?string?}
        source {tcllib md4 package}
        returns {The 16-byte MD4 digest (binary, or hex with -hex).}
    }
}

command md5::HMACFinal {
    available {tcl 8.5-}
    arity 1
    required_package md5
    tcllib_package md5

    hover {
        summary {These commands are identical to the MD5 equivalent commands.}
        synopsis {md5::HMACFinal token}
        source {tcllib package}
    }
}

command md5::HMACInit {
    available {tcl 8.5-}
    arity 1
    required_package md5
    tcllib_package md5

    hover {
        summary {This is equivalent to the ::md5::MD5Init command except that it requires the key that will be included in the HMA}
        synopsis {md5::HMACInit key}
        source {tcllib package}
    }
}

command md5::HMACUpdate {
    available {tcl 8.5-}
    arity 2
    required_package md5
    tcllib_package md5

    hover {
        summary {tcllib command.}
        synopsis {md5::HMACUpdate token data}
        source {tcllib package}
    }
}

command md5::MD5Final {
    available {tcl 8.5-}
    arity 1
    required_package md5
    tcllib_package md5

    hover {
        summary {Returns the hash value and releases any resources held by this token.}
        synopsis {md5::MD5Final token}
        source {tcllib package}
    }
}

command md5::MD5Init {
    available {tcl 8.5-}
    arity 0
    required_package md5
    tcllib_package md5

    hover {
        summary {Begins a new MD5 hash.}
        synopsis {md5::MD5Init}
        source {tcllib package}
    }
}

command md5::MD5Update {
    available {tcl 8.5-}
    arity 2
    required_package md5
    tcllib_package md5

    hover {
        summary {Add data to the hash identified by token.}
        synopsis {md5::MD5Update token data}
        source {tcllib package}
    }
}

command md5::md5 {
    available {tcl 8.5-}
    traits PURE
    arity 1..
    required_package md5
    tcllib_package md5

    side_effect Unknown -reads

    form Default {md5::md5 ?options? ?--? string}

    hover {
        summary {Compute the MD5 hash of a string or file.}
        synopsis {md5::md5 ?-hex|-bin? ?-channel channel | -file filename | ?--? string?}
        source {tcllib md5 package}
        returns {The MD5 hash as a hex or binary string.}
    }
}

command md5crypt::aprcrypt {
    available {tcl 8.5-}
    traits PURE
    arity 2
    required_package md5crypt
    tcllib_package md5crypt

    hover {
        summary {Encrypt a password using the Apache-variant MD5 crypt algorithm.}
        synopsis {md5crypt::aprcrypt password salt}
        source {tcllib md5crypt package}
        returns {The encrypted password string in crypt(3) format.}
    }
}

command md5crypt::md5crypt {
    available {tcl 8.5-}
    traits PURE
    arity 2
    required_package md5crypt
    tcllib_package md5crypt

    hover {
        summary {Encrypt a password using the MD5-based crypt algorithm.}
        synopsis {md5crypt::md5crypt password salt}
        source {tcllib md5crypt package}
        returns {The encrypted password string in crypt(3) format.}
    }
}

command md5crypt::salt {
    available {tcl 8.5-}
    arity ..1
    required_package md5crypt
    tcllib_package md5crypt

    hover {
        summary {Generate a random salt string for md5crypt.}
        synopsis {md5crypt::salt ?length?}
        source {tcllib md5crypt package}
        returns {A random salt string of the requested length (default 8).}
    }
}

command memory {
    available {tcl 8.4-}
    arity 1..

    return_type String

    side_effect InterpState -writes

    form Default {memory option ?arg arg ...?}

    hover {
        summary {Control Tcl's memory-debugging capabilities (debug builds only).}
        synopsis {memory option ?arg arg ...?}
        description {Available only when Tcl was compiled with memory debugging enabled (TCL_MEM_DEBUG defined at compile time) and after Tcl_InitMemory has run; the command does not exist at all in an ordinary release build. Backs the allocator's built-in leak- and overwrite-detection tooling (ckalloc/ckfree through Tcl 8.6, renamed Tcl_Alloc/Tcl_Free from Tcl 9.0 -- a documentation rename only, not a Tcl-level behaviour change), used mainly during Tcl's own core development. The objs subcommand was added in Tcl 8.5. The init/trace/validate on|off argument is matched literally against "on" only through Tcl 9.0 -- any other word, including "off" itself, silently means off and is never an error; Tcl 9.1 switches that argument to the general boolean parser, accepting the full true/false/yes/no/0/1 vocabulary and raising an error for anything else. Every other subcommand is unchanged across 8.4-9.1.}
        source {Tcl man page memory.n}
        example {memory tag start
memory trace on
set data [someProc]
memory trace off
puts [memory info]}
        returns {The empty string, except memory info, which returns a multi-line allocation-statistics report.}
    }

    subcommand active {
        arity 1
        detail {Write a list of every currently allocated memory block to file.}
        synopsis {memory active file}
        side_effect FileIo -writes
    }

    subcommand break_on_malloc {
        arity 1
        detail {After count further allocations, print a message and send the process SIGINT in an attempt to enter a C debugger.}
        synopsis {memory break_on_malloc count}
    }

    subcommand info {
        arity 0
        detail {Return a report of the total allocations and frees since Tcl started, the current packets and bytes allocated, and their historical maximums.}
        synopsis {memory info}
        return_type String
        pure
    }

    subcommand init {
        arity 1
        detail {Turn preinitialization of newly allocated memory with bogus bytes on or off, to help catch use of uninitialized values.}
        synopsis {memory init on|off}
        arg 0 -values-from memory-init-arg0
    }

    subcommand objs {
        arity 1
        detail {Write every currently allocated Tcl_Obj value, together with its allocation site, to file -- useful for finding Tcl_Obj leaks.}
        synopsis {memory objs file}
        available {tcl 8.5-}
        side_effect FileIo -writes
    }

    subcommand onexit {
        arity 1
        detail {Write a list of all still-allocated memory to file while the memory subsystem finalizes, to help confirm memory is cleaned up at process exit.}
        synopsis {memory onexit file}
        side_effect FileIo -writes
    }

    subcommand tag {
        arity 1
        detail {Set the tag string attached to subsequent allocations; the tag is printed alongside each packet in memory active and memory onexit output.}
        synopsis {memory tag string}
    }

    subcommand trace {
        arity 1
        detail {Turn tracing of every allocation and free to stderr on or off.}
        synopsis {memory trace on|off}
        arg 0 -values-from memory-init-arg0
    }

    subcommand trace_on_at_malloc {
        arity 1
        detail {Enable memory tracing starting after count allocations have occurred, to skip past startup noise before a suspected problem.}
        synopsis {memory trace_on_at_malloc count}
    }

    subcommand validate {
        arity 1
        detail {Turn guard-zone validation of every allocated block on or off on every allocation and free; detects an overwrite immediately, at a significant performance cost.}
        synopsis {memory validate on|off}
        arg 0 -values-from memory-init-arg0
    }
}

command menu {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class menu -method-prefix-matching Enabled {
        method activate { arity 1 ; detail {Activate (highlight) the menu entry at the given index.} ; synopsis {pathName activate index} }

        method add {
            arity 1..
            detail {Add a new entry to the bottom of the menu.}
            synopsis {pathName add type ?option value ...?}
            arg 0 -values-from menu-menu-add-arg0

            option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
                -detail {Tcl command to invoke when the menu entry is invoked.}
            option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
                -detail {Global variable tied to a checkbutton or radiobutton entry.}
            option -label -takes string -detail {Text displayed in the menu entry.}
            option -state -takes state \
                -detail {State of the entry: normal, active, or disabled.}
            option -value -takes value \
                -detail {Value stored in the variable when a radiobutton entry is selected.}
            option -onvalue -takes value \
                -detail {Value stored in the variable when a checkbutton entry is on.}
            option -offvalue -takes value \
                -detail {Value stored in the variable when a checkbutton entry is off.}
            option -accelerator -takes string \
                -detail {Accelerator key text displayed at the right of the entry.}
            option -menu -takes menu -detail {Submenu posted by a cascade entry.}
        }

        method clone { arity 1..2 ; detail {Create a clone of this menu.} ; synopsis {pathName clone newPathname ?cloneType?} }

        method delete {
            arity 1..2
            detail {Delete menu entries between index1 and index2 inclusive.}
            synopsis {pathName delete index1 ?index2?}
        }

        method entrycget {
            arity 2
            detail {Return the value of a configuration option for a menu entry.}
            synopsis {pathName entrycget index option}
        }

        method entryconfigure {
            arity 1..
            detail {Query or modify options of a menu entry.}
            synopsis {pathName entryconfigure index ?option value ...?}

            option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
                -detail {Tcl command to invoke when the menu entry is invoked.}
            option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
                -detail {Global variable tied to a checkbutton or radiobutton entry.}
            option -label -takes string -detail {Text displayed in the menu entry.}
            option -state -takes state \
                -detail {State of the entry: normal, active, or disabled.}
            option -value -takes value \
                -detail {Value stored in the variable when a radiobutton entry is selected.}
            option -onvalue -takes value \
                -detail {Value stored in the variable when a checkbutton entry is on.}
            option -offvalue -takes value \
                -detail {Value stored in the variable when a checkbutton entry is off.}
            option -accelerator -takes string \
                -detail {Accelerator key text displayed at the right of the entry.}
            option -menu -takes menu -detail {Submenu posted by a cascade entry.}
        }

        method index { arity 1 ; detail {Return the numerical index corresponding to the given index.} ; synopsis {pathName index index} }

        method insert {
            arity 2..
            detail {Insert a new entry before the entry at the given index.}
            synopsis {pathName insert index type ?option value ...?}
            arg 1 -values-from menu-menu-add-arg0

            option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
                -detail {Tcl command to invoke when the menu entry is invoked.}
            option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
                -detail {Global variable tied to a checkbutton or radiobutton entry.}
            option -label -takes string -detail {Text displayed in the menu entry.}
            option -state -takes state \
                -detail {State of the entry: normal, active, or disabled.}
            option -value -takes value \
                -detail {Value stored in the variable when a radiobutton entry is selected.}
            option -onvalue -takes value \
                -detail {Value stored in the variable when a checkbutton entry is on.}
            option -offvalue -takes value \
                -detail {Value stored in the variable when a checkbutton entry is off.}
            option -accelerator -takes string \
                -detail {Accelerator key text displayed at the right of the entry.}
            option -menu -takes menu -detail {Submenu posted by a cascade entry.}
        }

        method invoke { arity 1 ; detail {Invoke the action of the menu entry at the given index.} ; synopsis {pathName invoke index} }
        method post { arity 2 ; detail {Display the menu at the given screen coordinates.} ; synopsis {pathName post x y} }

        method postcascade {
            arity 1
            detail {Post the submenu associated with the cascade entry at the given index.}
            synopsis {pathName postcascade index}
        }

        method type { arity 1 ; detail {Return the type of the menu entry at the given index.} ; synopsis {pathName type index} }
        method unpost { arity 0 ; detail {Unmap the menu so it is no longer displayed.} ; synopsis {pathName unpost} }

        method xposition {
            arity 1
            detail {Return the x-coordinate of the leftmost pixel of the entry at index.}
            synopsis {pathName xposition index}
        }

        method yposition {
            arity 1
            detail {Return the y-coordinate of the topmost pixel of the entry at the given index.}
            synopsis {pathName yposition index}
        }
    }

    option -tearoff -takes {} \
        -detail {Whether the menu should include a tear-off entry at the top.}
    option -title -takes {} -detail {Title string for the tear-off menu window.}
    option -type -takes {} -detail {Type of the menu: menubar, tearoff, or normal.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -background -takes {} -detail {Background colour of the menu.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -foreground -takes {} -detail {Foreground colour for menu entries.}
    option -font -takes {} -detail {Font to use for text in the menu.}
    option -activebackground -takes {} \
        -detail {Background colour for the active menu entry.}
    option -activeforeground -takes {} \
        -detail {Foreground colour for the active menu entry.}
    option -activeborderwidth -takes {} \
        -detail {Width of the border drawn around active entries.}
    option -disabledforeground -takes {} \
        -detail {Foreground colour for disabled menu entries.}
    option -selectcolor -takes {} \
        -detail {Colour of the indicator for checkbutton and radiobutton entries.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -borderwidth -takes {} -detail {Width of the border around the menu.}
    option -postcommand -takes {} -role Body -body-kind Structural -script-timing Deferred \
        -detail {Tcl command to invoke just before the menu is posted.}
    option -tearoffcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix invoked when the menu is torn off (the parent menu path and the torn-off menu path are appended).}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the menu.}
    option -takefocus -takes {} \
        -detail {Whether the menu accepts focus during keyboard traversal.}

    form Default {menu pathName ?option value ...?}

    hover {
        summary {Create and manipulate a menu widget.}
        synopsis {menu pathName ?option value ...?}
        description {Displays a menu of commands, each of which may be a cascade, checkbutton, command, radiobutton, or separator entry.}
        source {Tk man page menu.n}
    }

    subcommand activate { arity 1 ; detail {Activate (highlight) the menu entry at the given index.} ; synopsis {pathName activate index} }

    subcommand add {
        arity 1..
        detail {Add a new entry to the bottom of the menu.}
        synopsis {pathName add type ?option value ...?}
        arg 0 -values-from menu-menu-add-arg0

        option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
            -detail {Tcl command to invoke when the menu entry is invoked.}
        option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
            -detail {Global variable tied to a checkbutton or radiobutton entry.}
        option -label -takes string -detail {Text displayed in the menu entry.}
        option -state -takes state \
            -detail {State of the entry: normal, active, or disabled.}
        option -value -takes value \
            -detail {Value stored in the variable when a radiobutton entry is selected.}
        option -onvalue -takes value \
            -detail {Value stored in the variable when a checkbutton entry is on.}
        option -offvalue -takes value \
            -detail {Value stored in the variable when a checkbutton entry is off.}
        option -accelerator -takes string \
            -detail {Accelerator key text displayed at the right of the entry.}
        option -menu -takes menu -detail {Submenu posted by a cascade entry.}
    }

    subcommand clone { arity 1..2 ; detail {Create a clone of this menu.} ; synopsis {pathName clone newPathname ?cloneType?} }

    subcommand delete {
        arity 1..2
        detail {Delete menu entries between index1 and index2 inclusive.}
        synopsis {pathName delete index1 ?index2?}
    }

    subcommand entrycget {
        arity 2
        detail {Return the value of a configuration option for a menu entry.}
        synopsis {pathName entrycget index option}
    }

    subcommand entryconfigure {
        arity 1..
        detail {Query or modify options of a menu entry.}
        synopsis {pathName entryconfigure index ?option value ...?}

        option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
            -detail {Tcl command to invoke when the menu entry is invoked.}
        option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
            -detail {Global variable tied to a checkbutton or radiobutton entry.}
        option -label -takes string -detail {Text displayed in the menu entry.}
        option -state -takes state \
            -detail {State of the entry: normal, active, or disabled.}
        option -value -takes value \
            -detail {Value stored in the variable when a radiobutton entry is selected.}
        option -onvalue -takes value \
            -detail {Value stored in the variable when a checkbutton entry is on.}
        option -offvalue -takes value \
            -detail {Value stored in the variable when a checkbutton entry is off.}
        option -accelerator -takes string \
            -detail {Accelerator key text displayed at the right of the entry.}
        option -menu -takes menu -detail {Submenu posted by a cascade entry.}
    }

    subcommand index { arity 1 ; detail {Return the numerical index corresponding to the given index.} ; synopsis {pathName index index} }

    subcommand insert {
        arity 2..
        detail {Insert a new entry before the entry at the given index.}
        synopsis {pathName insert index type ?option value ...?}
        arg 1 -values-from menu-menu-add-arg0

        option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
            -detail {Tcl command to invoke when the menu entry is invoked.}
        option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
            -detail {Global variable tied to a checkbutton or radiobutton entry.}
        option -label -takes string -detail {Text displayed in the menu entry.}
        option -state -takes state \
            -detail {State of the entry: normal, active, or disabled.}
        option -value -takes value \
            -detail {Value stored in the variable when a radiobutton entry is selected.}
        option -onvalue -takes value \
            -detail {Value stored in the variable when a checkbutton entry is on.}
        option -offvalue -takes value \
            -detail {Value stored in the variable when a checkbutton entry is off.}
        option -accelerator -takes string \
            -detail {Accelerator key text displayed at the right of the entry.}
        option -menu -takes menu -detail {Submenu posted by a cascade entry.}
    }

    subcommand invoke { arity 1 ; detail {Invoke the action of the menu entry at the given index.} ; synopsis {pathName invoke index} }
    subcommand post { arity 2 ; detail {Display the menu at the given screen coordinates.} ; synopsis {pathName post x y} }

    subcommand postcascade {
        arity 1
        detail {Post the submenu associated with the cascade entry at the given index.}
        synopsis {pathName postcascade index}
    }

    subcommand type { arity 1 ; detail {Return the type of the menu entry at the given index.} ; synopsis {pathName type index} }
    subcommand unpost { arity 0 ; detail {Unmap the menu so it is no longer displayed.} ; synopsis {pathName unpost} }

    subcommand xposition {
        arity 1
        detail {Return the x-coordinate of the leftmost pixel of the entry at index.}
        synopsis {pathName xposition index}
    }

    subcommand yposition {
        arity 1
        detail {Return the y-coordinate of the topmost pixel of the entry at the given index.}
        synopsis {pathName yposition index}
    }
}

command menubutton {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class menubutton -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }
    }

    option -text -takes {} -detail {Text to display in the menubutton.}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Name of a variable whose value will be used as the menubutton text.}
    option -menu -takes {} \
        -detail {Path name of the menu widget to post when the menubutton is pressed.}
    option -direction -takes {} \
        -detail {Direction to post the menu: above, below, flush, left, or right.}
    option -image -takes {} -detail {Image to display in the menubutton.}
    option -bitmap -takes {} -detail {Bitmap to display in the menubutton.}
    option -compound -takes {} \
        -detail {Whether to display both image and text: none, bottom, top, left, right, or center.}
    option -width -takes {} \
        -detail {Desired width of the menubutton in characters (text) or pixels (image).}
    option -height -takes {} \
        -detail {Desired height of the menubutton in lines (text) or pixels (image).}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {How information is positioned: n, ne, e, se, s, sw, w, nw, or center.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of multi-line text: left, center, or right.}
    option -wraplength -takes {} \
        -detail {Maximum line length for word wrapping, in screen units.}
    option -underline -takes {} \
        -detail {Index of character to underline for keyboard traversal (0-based).}
    option -state -takes {} -detail {State of the menubutton: normal, active, or disabled.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -font -takes {} -detail {Font to use for the menubutton text.}
    option -padx -takes {} -detail {Extra horizontal padding inside the menubutton.}
    option -pady -takes {} -detail {Extra vertical padding inside the menubutton.}
    option -activebackground -takes {} \
        -detail {Background colour when the menubutton is active (mouse over).}
    option -activeforeground -takes {} \
        -detail {Foreground colour when the menubutton is active.}
    option -disabledforeground -takes {} \
        -detail {Foreground colour when the menubutton is disabled.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the menubutton does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the menubutton has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the menubutton.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the menubutton.}
    option -takefocus -takes {} \
        -detail {Whether the menubutton accepts focus during keyboard traversal.}
    option -indicatoron -takes {} \
        -detail {Whether to display a small indicator showing the menu direction.}

    form Default {menubutton pathName ?option value ...?}

    hover {
        summary {Create and manipulate a menubutton widget.}
        synopsis {menubutton pathName ?option value ...?}
        description {Displays a textual string, bitmap, or image. When pressed, posts an associated menu widget.}
        source {Tk man page menubutton.n}
    }
}

command message {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class message -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }
    }

    option -text -takes {} -detail {Text string to be displayed in the message.}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Name of a variable whose value will be used as the message text.}
    option -width -takes {} -detail {Maximum line length for the message in screen units.}
    option -aspect -takes {} \
        -detail {Aspect ratio (100*width/height) for line wrapping; default is 150.}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {How information is positioned: n, ne, e, se, s, sw, w, nw, or center.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of multi-line text: left, center, or right.}
    option -font -takes {} -detail {Font to use for the message text.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -padx -takes {} -detail {Extra horizontal padding inside the message widget.}
    option -pady -takes {} -detail {Extra vertical padding inside the message widget.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the message.}
    option -takefocus -takes {} \
        -detail {Whether the message accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the message does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the message has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the message.}

    form Default {message pathName ?option value ...?}

    hover {
        summary {Create and manipulate a message widget.}
        synopsis {message pathName ?option value ...?}
        description {Displays a multi-line text string using a single font. Similar to a label but automatically wraps text to fit a given aspect ratio or width.}
        source {Tk man page message.n}
    }
}

