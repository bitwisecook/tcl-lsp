        arity 1..
        detail {Return text contents in a parseable form, or call -command once per dumped segment.}
        synopsis {pathName dump ?-all -image -mark -tag -text -window? ?-command commandPrefix? index1 ?index2?}
        traits {EVALUATES_CODE TAINT_SOURCE}
        return_type List
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes

        option -all -detail {Include text, marks, tags, images, and embedded windows.}
        option -command -takes command -role CommandPrefix -appends {Exactly 3} \
            -detail {Invoke this command prefix for each element with key, value, and index appended.}
        option -image -detail {Include embedded images.}
        option -mark -detail {Include marks.}
        option -tag -detail {Include tag transitions.}
        option -text -detail {Include text segments.}
        option -window -detail {Include embedded windows.}
    }

