command font {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    side_effect InterpState -reads -writes

    option -family -takes name -detail {Font family name (e.g. Courier, Times, Helvetica).}
    option -size -takes size \
        -detail {Desired size of the font in points (positive) or pixels (negative).}
    option -weight -takes normal|bold -detail {Weight of the font: normal or bold.}
    option -slant -takes roman|italic -detail {Slant of the font: roman or italic.}
    option -underline -takes boolean -role Boolean \
        -detail {Whether to draw an underline beneath the text.}
    option -overstrike -takes boolean -role Boolean \
        -detail {Whether to draw a horizontal line through the text.}
    option -displayof -takes window -detail {Specifies the display for the font query.}

    form Default {font option ?arg ...?}

    hover {
        summary {Create and inspect fonts.}
        synopsis {font actual font ?-displayof window? ?option? ?--? ?char?}
        synopsis {font configure fontname ?option? ?value option value ...?}
        synopsis {font create ?fontname? ?option value ...?}
        synopsis {font delete fontname ?fontname ...?}
        synopsis {font families ?-displayof window?}
        synopsis {font measure font ?-displayof window? text}
        synopsis {font metrics font ?-displayof window? ?option?}
        synopsis {font names}
        source {Tk man page font.n}
    }

    subcommand actual {
        arity 1..
        detail {Return the actual attributes of a font on the display.}
        synopsis {font actual font ?-displayof window? ?option? ?--? ?char?}

        option -displayof -takes window -detail {Specifies the display for the font query.}
        option -family -takes name \
            -detail {Font family name (e.g. Courier, Times, Helvetica).}
        option -size -takes size \
            -detail {Desired size of the font in points (positive) or pixels (negative).}
        option -weight -takes normal|bold -detail {Weight of the font: normal or bold.}
        option -slant -takes roman|italic -detail {Slant of the font: roman or italic.}
        option -underline -takes boolean -role Boolean \
            -detail {Whether to draw an underline beneath the text.}
        option -overstrike -takes boolean -role Boolean \
            -detail {Whether to draw a horizontal line through the text.}
    }

    subcommand configure {
        arity 1..
        detail {Query or modify the desired attributes of a named font.}
        synopsis {font configure fontname ?option? ?value option value ...?}

        option -family -takes name \
            -detail {Font family name (e.g. Courier, Times, Helvetica).}
        option -size -takes size \
            -detail {Desired size of the font in points (positive) or pixels (negative).}
        option -weight -takes normal|bold -detail {Weight of the font: normal or bold.}
        option -slant -takes roman|italic -detail {Slant of the font: roman or italic.}
        option -underline -takes boolean -role Boolean \
            -detail {Whether to draw an underline beneath the text.}
        option -overstrike -takes boolean -role Boolean \
            -detail {Whether to draw a horizontal line through the text.}
    }

    subcommand create {
        detail {Create a new named font with the given options.}
        synopsis {font create ?fontname? ?option value ...?}

        option -family -takes name \
            -detail {Font family name (e.g. Courier, Times, Helvetica).}
        option -size -takes size \
            -detail {Desired size of the font in points (positive) or pixels (negative).}
        option -weight -takes normal|bold -detail {Weight of the font: normal or bold.}
        option -slant -takes roman|italic -detail {Slant of the font: roman or italic.}
        option -underline -takes boolean -role Boolean \
            -detail {Whether to draw an underline beneath the text.}
        option -overstrike -takes boolean -role Boolean \
            -detail {Whether to draw a horizontal line through the text.}
    }

    subcommand delete { arity 1.. ; detail {Delete one or more named fonts.} ; synopsis {font delete fontname ?fontname ...?} }

    subcommand families {
        arity ..2
        detail {Return a list of all font families available on the display.}
        synopsis {font families ?-displayof window?}

        option -displayof -takes window -detail {Specifies the display for the font query.}
    }

    subcommand measure {
        arity 2..
        detail {Measure the width of the text string when rendered in the given font.}
        synopsis {font measure font ?-displayof window? text}

        option -displayof -takes window -detail {Specifies the display for the font query.}
    }

    subcommand metrics {
        arity 1..
        detail {Return metric information for the given font.}
        synopsis {font metrics font ?-displayof window? ?option?}

        option -displayof -takes window -detail {Specifies the display for the font query.}
    }

    subcommand names { arity 0 ; detail {Return a list of all named fonts currently defined.} ; synopsis {font names} }
}

command for {
    available {tcl 8.4-} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD HAS_BOOLEAN_COND HAS_LOOP_BODY NEVER_INLINE_BODY BYTE_COMPILED NOT_PROC_FACTORY}
    arity 4

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Body -layout InlineScript
    arg 1 -role Expr -type Boolean -shimmers
    arg 2 -role Body -layout InlineScript
    arg 3 -role Body

    clause_grammar {
        head Body -timing init
        once Expr
        once Body -timing next
        tail Body -timing per-iteration
        selection all
    }

    lowering_hook -native For

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin for

    form Default {for start test next body}

    hover {
        summary {C-style loop with init, test, and next scripts.}
        synopsis {for start test next body}
        description {`start` (a Tcl script) runs once before the loop begins. Before each pass, `test` is evaluated as an expression; the loop continues while it is non-zero. After `body` runs, `next` runs, then `test` is re-evaluated. `continue` inside `body` skips the rest of that pass and jumps straight to `next` and the next `test` check; `break` inside `body` or `next` ends the loop immediately. Either way `for` itself returns an empty string. `test` should almost always be written in braces (e.g. `{$i < 10}`): an unbraced `test` is substituted once, before the loop starts, so it never sees changes `next` or `body` make and typically runs forever.}
        source {Tcl for(n)}
        example {for {set i 0} {$i < 10} {incr i} {
    puts $i
}}
        returns {An empty string.}
    }
}

command foreach {
    available {tcl 8.4-} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD HAS_LOOP_BODY NEVER_INLINE_BODY LOOP_LIST_HEADER BYTE_COMPILED NOT_PROC_FACTORY}
    arity 3.. -step 2

    return_type String
    var_write_typing {ElementsOf 0}
    representation_effect {CoerceOrdinaryListPairs 0}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -type List -shimmers
    repeat LoopVarList -stride 2 -exclude-trailing 1

    clause_grammar {
        group 0 -timing per-iteration
        tail Body -timing per-iteration
        selection all
    }

    arg_role_count_resolver -native foreach::arg_role_count_resolver
    arg_role_resolver_roles Body
    lowering_hook -native Foreach
    analyser_hook -native Foreach

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin foreach

    form Default {foreach varlist1 list1 ?varlist2 list2 ...? body}

    hover {
        summary {Iterate over one or more lists, assigning loop variables from each.}
        synopsis {foreach varname list body}
        synopsis {foreach varlist1 list1 ?varlist2 list2 ...? body}
        description {In the simple form, varname takes on each value of list in turn and body runs once per value. In the general form, each varlist/list pair is handled independently: on every iteration, the variables of each varlist are assigned consecutive values from its corresponding list, as if by lindex. Iteration continues until every value from every list has been used exactly once — enough passes to exhaust the longest list — and a list too short for its varlist supplies empty strings for the missing elements on later passes. break and continue inside body behave exactly as they do in for. foreach itself always returns an empty string, regardless of what body does.}
        source {Tcl foreach(n)}
        example {foreach x {a b c} {
    puts $x
}
foreach {name value} {height 6 width 8} {
    puts "$name = $value"
}
foreach x {1 2 3} y {a b} {
    puts "$x $y"
}}
        returns {An empty string.}
    }
}

command format {
    available {tcl 8.4-} {f5-irules}
    traits {PURE CSE_CANDIDATE BYTE_COMPILED FRAMELESS_RUNTIME}
    arity 1..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    byte_array_effect Coerces
    format_string_type Sprintf
    arg 0 -role FormatString

    const_fold_versioned -native format::const_fold_versioned
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.
    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.
    # TODO(spectcl): `result_stability` is set on the source spec. The DSL
    #   spells it `result_stability
    #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
    #   …}}`, but a draft records only that the field is set, never the
    #   expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin format

    form Default {format formatString ?arg arg ...?}

    hover {
        summary {Format a string in the style of C's sprintf.}
        synopsis {format formatString ?arg arg ...?}
        description {Scans formatString left to right, copying text through unchanged except where a % introduces a conversion specifier that consumes the next arg (or, with an %n$ position, an explicit one — once any specifier in the string is positional, every specifier must be). A specifier is %[n$][flags][width][.precision][size]verb: the flags are - (left-justify instead of the default right-justify), + (always show a sign), space (a leading space on a non-negative number), 0 (zero-pad instead of space-pad), and # (alternate form: on every version it forces a decimal point on a float and preserves %g's trailing zeros; for the integer verbs, before Tcl 9.0 it adds a leading 0 on octal or 0x/0X on hex (matching the verb's case) or, from Tcl 8.6, 0b on binary, while from Tcl 9.0 octal instead gets an 0o prefix, hex always gets a lowercase 0x prefix, and decimal gains a new 0d prefix). width and precision may each be a literal number or * to take the value from the next argument; precision means digits after the point for e/f, total significant digits for g, a minimum digit count (zero-padded) for the integer verbs, and a maximum character count for s. Conversion verbs: d/i (signed decimal), u (unsigned decimal), o (unsigned octal), x/X (unsigned hex), b (unsigned binary — Tcl 8.6 and later only), c (integer codepoint to character), s (string, unconverted), f (fixed-point), e/E (scientific notation), g/G (the shorter of f or e, with trailing zeros stripped), and %% for a literal percent. Tcl 9.0 and later also accept a/A (hexadecimal floating-point) and p (shorthand for 0x%zx). An optional size modifier before the verb (h or l; also ll from Tcl 8.5, and I, I32, I64, z, t, L, j, or q from Tcl 9.0) controls the integer conversion's truncation width but is ignored for the float verbs and for %c/%s. Two widths depend on the build's C ABI: before Tcl 9.0 an unmodified integer conversion is C long wide, and from 9.0 z, t and p are pointer wide; tcl-lsp evaluates both as 64 bits, as a 64-bit Unix (LP64) build does, where 64-bit Windows and 32-bit builds may differ. Too few arguments, or a malformed specifier, raises an error; unused trailing arguments are ignored.}
        source {Tcl man page format.n}
        example {format {Hello, %s! You are %d years old.} $name $age
format %05.2f $pi
format {%#x} 255
format {%-10s|} $label}
        returns {The formatted string.}
    }
}

command frame {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class frame -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }
    }

    option -width -takes {} -detail {Desired width of the frame in screen units.}
    option -height -takes {} -detail {Desired height of the frame in screen units.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -borderwidth -takes {} -detail {Width of the border around the frame.}
    option -bd -takes {} -detail {Shorthand for -borderwidth.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -background -takes {} -detail {Background colour of the frame.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the frame.}
    option -takefocus -takes {} \
        -detail {Whether the frame accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the frame does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the frame has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the frame.}
    option -padx -takes {} -detail {Extra horizontal padding inside the frame.}
    option -pady -takes {} -detail {Extra vertical padding inside the frame.}
    option -class -takes {} \
        -detail {Class name for the frame, used in option database lookups.}
    option -colormap -takes {} \
        -detail {Colourmap to use for the frame: new or inherited from a window.}
    option -container -takes {} \
        -detail {Whether the frame will be a container for an embedded application.}
    option -visual -takes {} -detail {Visual information for the frame.}

    form Default {frame pathName ?option value ...?}

    hover {
        summary {Create and manipulate a frame widget.}
        synopsis {frame pathName ?option value ...?}
        description {A frame is a simple container widget used primarily to group and organise other widgets.}
        source {Tk man page frame.n}
    }
}

