command grab {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    side_effect InterpState -reads -writes

    option -global -detail {Make the grab global (applies to all displays).}

    form Default {grab option ?arg ...?}

    hover {
        summary {Confine pointer and keyboard events to a window sub-tree.}
        synopsis {grab ?-global? window}
        synopsis {grab current ?window?}
        synopsis {grab release window}
        synopsis {grab set ?-global? window}
        synopsis {grab status window}
        source {Tk man page grab.n}
    }

    subcommand current { arity ..1 ; detail {Return the path name of the current grab window, if any.} ; synopsis {grab current ?window?} }
    subcommand release { arity 1 ; detail {Release the grab on the window.} ; synopsis {grab release window} }
    subcommand set { arity 1..2 ; detail {Set a grab on the window, optionally global.} ; synopsis {grab set ?-global? window} }
    subcommand status { arity 1 ; detail {Return the grab status of the window (none, local, or global).} ; synopsis {grab status window} }
}

