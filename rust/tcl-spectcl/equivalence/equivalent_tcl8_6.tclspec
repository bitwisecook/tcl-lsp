command ::tcl::unsupported::corotype {
    available {tcl 8.6-}
    traits FRAMELESS_RUNTIME
    arity 1

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect InterpState -reads

    runtime_backing shipped-builtin ::tcl::unsupported::corotype

    form Default {::tcl::unsupported::corotype coroName}

    hover {
        summary {Report whether a coroutine is active, or how it last suspended.}
        synopsis {::tcl::unsupported::corotype coroName}
        description {coroName must currently name a live coroutine — one created by coroutine and not yet finished; an ordinary command, a nonexistent name, or a coroutine that has already returned all raise "can only get coroutine type of a coroutine". The result is active while the coroutine is actually running — including when corotype is called on the current coroutine from inside its own body via [info coroutine], since there is no way to know what a running coroutine will do next. Once the coroutine is parked, the result instead names whichever command it is suspended at: yield or yieldto. This is the type-classifying half of the coroutine probe/inject machinery: coroprobe and coroinject both use it to decide how a resumption value should be delivered. It performs no I/O and touches no filesystem or process state, so — despite living in the ::tcl::unsupported namespace — it works unrestricted inside a safe interpreter.}
        source {Tcl ::tcl::unsupported::corotype (undocumented; no manual page)}
        example {coroutine demo eval {
    yield
    yield "phase 1"
    yieldto string cat "phase 2"
    ::tcl::unsupported::corotype [info coroutine]
}
puts [demo]                              ;# -> phase 1
puts [::tcl::unsupported::corotype demo] ;# -> yield (parked at the 2nd yield)
puts [demo]                              ;# -> phase 2
puts [::tcl::unsupported::corotype demo] ;# -> yieldto (parked at yieldto)
puts [demo]                              ;# -> active (corotype ran on itself, mid-execution)}
        returns {active if coroName is currently running; otherwise yield or yieldto, naming whichever command it is suspended at.}
    }
}

command ::tcl::unsupported::representation {
    available {tcl 8.6-}
    traits FRAMELESS_RUNTIME
    arity 1

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect InterpState -reads

    runtime_backing shipped-builtin ::tcl::unsupported::representation

    form Default {::tcl::unsupported::representation value}

    hover {
        summary {Describe a value's internal representation, for debugging shimmering.}
        synopsis {::tcl::unsupported::representation value}
        description {Reports the type the value currently holds (pure string, int, double, list, dict, …), its reference count, its address, its internal representation and the first bytes of its string representation, if it has one. Reading a value can give it a string representation or change its type, so the answer describes the value at the moment of the call; addresses and counts are the engine's own and differ from run to run. Use it to check whether a command shimmered a value.}
        source {Tcl ::tcl::unsupported::representation (undocumented; no manual page)}
        example {set d [dict create a 1]
puts [::tcl::unsupported::representation $d]
;# -> value is a dict with a refcount of …, object pointer at …, internal representation …, no string representation}
        returns {A sentence naming the value's type, reference count, address, internal representation and string representation.}
    }
}

