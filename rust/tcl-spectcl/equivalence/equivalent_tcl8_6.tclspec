command scale {
    available {tcl 8.4-} {package Tk}
    traits TAINTS_VAR_WRITES
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class scale -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a scale option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change scale options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method coords {
            arity ..1
            detail {Return the coordinates corresponding to a scale value.}
            synopsis {pathName coords ?value?}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method get {
            arity ..2
            detail {Return the user-controlled scale value, optionally at coordinates x y.}
            synopsis {pathName get ?x y?}
            traits TAINT_SOURCE_ZERO_ARGS
            return_type Double
            pure
            side_effect InterpState -reads
        }

        method identify {
            arity 2
            detail {Identify the scale element at coordinates x y.}
            synopsis {pathName identify x y}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method set {
            arity 1
            detail {Set the scale value.}
            synopsis {pathName set value}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }
    }

    option -from -takes {} -detail {Starting value of the range (a real number).}
    option -to -takes {} -detail {Ending value of the range (a real number).}
    option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global -taints-var-write \
        -detail {Name of a variable linked to the scale's current value.}
    option -orient -takes {} -detail {Orientation of the scale: horizontal or vertical.}
    option -resolution -takes {} -detail {Resolution (step size) for the scale value.}
    option -tickinterval -takes {} \
        -detail {Spacing between numerical tick marks displayed along the scale.}
    option -label -takes {} -detail {Text label to display alongside the scale.}
    option -length -takes {} -detail {Desired long dimension of the scale in screen units.}
    option -width -takes {} \
        -detail {Desired narrow dimension of the trough in screen units.}
    option -sliderlength -takes {} \
        -detail {Length of the slider along the long dimension in screen units.}
    option -sliderrelief -takes {} \
        -detail {Relief of the slider: flat, groove, raised, ridge, solid, or sunken.}
    option -showvalue -takes {} \
        -detail {Whether to display the current value next to the slider.}
    option -digits -takes {} -detail {Number of significant digits for the scale value.}
    option -bigincrement -takes {} \
        -detail {Large increment used for Control-arrow key bindings.}
    option -command -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 1} \
        -detail {Tcl command prefix invoked when the scale value changes (the new value is appended).}
    option -state -takes {} -detail {State of the scale: normal, active, or disabled.}
    option -font -takes {} -detail {Font to use for the label and value display.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -troughcolor -takes {} -detail {Colour of the trough area.}
    option -activebackground -takes {} \
        -detail {Background colour when the slider is active (mouse over).}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the scale does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the scale has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the scale.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -borderwidth -takes {} -detail {Width of the border around the scale.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the scale.}
    option -takefocus -takes {} \
        -detail {Whether the scale accepts focus during keyboard traversal.}
    option -repeatdelay -takes {} \
        -detail {Milliseconds before auto-repeat begins when trough is held.}
    option -repeatinterval -takes {} -detail {Milliseconds between auto-repeat invocations.}

    form Default {scale pathName ?option value ...?}

    hover {
        summary {Create and manipulate a scale (slider) widget.}
        synopsis {scale pathName ?option value ...?}
        description {Displays a slider that allows the user to select a numerical value from a specified range.}
        source {Tk man page scale.n}
    }

    subcommand cget {
        arity 1
        detail {Return the current value of a scale option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change scale options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand coords {
        arity ..1
        detail {Return the coordinates corresponding to a scale value.}
        synopsis {pathName coords ?value?}
        return_type List
        pure
        side_effect InterpState -reads
    }

    subcommand get {
        arity ..2
        detail {Return the user-controlled scale value, optionally at coordinates x y.}
        synopsis {pathName get ?x y?}
        traits TAINT_SOURCE_ZERO_ARGS
        return_type Double
        pure
        side_effect InterpState -reads
    }

    subcommand identify {
        arity 2
        detail {Identify the scale element at coordinates x y.}
        synopsis {pathName identify x y}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand set {
        arity 1
        detail {Set the scale value.}
        synopsis {pathName set value}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }
}

command scan {
    available {tcl 8.4-} {f5-irules}
    traits {CONDITIONAL_VARIABLE_WRITE BYTE_COMPILED FRAME_HASH_BUILTIN}
    arity 2..

    return_type Int
    var_write_typing Destructured
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    format_string_type Sprintf

    arg_role_count_resolver -native scan::arg_role_count_resolver
    arg_role_resolver_roles {ScanFormat VarWrite}
    const_fold -native scan::const_fold
    return_type_hook -native Scan
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -writes

    runtime_backing shipped-builtin scan

    form Default {scan string format ?varName varName ...?}

    hover {
        summary {Parse string using conversion specifiers in the style of sscanf}
        synopsis {scan string format ?varName varName ...?}
        description {Skips whitespace in string before each conversion, except %c and %[chars]/%[^chars], which do not. A %n$ positional specifier sends that conversion's result to argument n (1-based) instead of the next varName in sequence; once one specifier in format is positional, every specifier must be. Integer conversions (%d, %o, %x/%X, %b, %u, %i) take an optional size modifier that bounds the stored range: h or no modifier limits it to 32 bits, l limits it to the wide()/64-bit range, and ll removes the limit entirely (arbitrary precision). L is a synonym for ll (unlimited) on Tcl 9.0 and later, but on Tcl 8.5 and 8.6 it instead meant the same 64-bit range as l; Tcl 8.4 has neither ll nor an unlimited range, only a plain l or L meaning "at least 64 bits". Tcl 9.0 and later also accept q and j as synonyms for l (wide/64-bit range) and z and t as platform-pointerSize-dependent (matching h's 32-bit range or l's wide range depending on the tcl_platform(pointerSize) value); none of these four size modifiers are recognized before 9.0. %b (binary integer) needs Tcl 8.6 or later. With one or more varName arguments the command writes each converted value and returns the count of conversions performed, or -1 if string runs out before the first conversion completes; with no varName arguments it returns the converted values as a list instead, or the empty string on that same end-of-input failure.}
        source {Tcl scan(n)}
        example {scan $string {#%2x%2x%2x} r g b
scan $string {%d:%d} hours minutes
set count [scan $string {%d %d} x y]
set values [scan $string {%d %d}]}
        returns {The number of successful conversions, or -1 if the end of string is reached before any conversion completes. With no varName arguments, returns the converted values as a list instead, or the empty string on that same end-of-input failure.}
    }
}

command scrollbar {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class scrollbar -method-prefix-matching Enabled {
        method activate {
            arity ..1
            detail {Return the active element, or mark the named element active.}
            synopsis {pathName activate ?element?}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method delta {
            arity 2
            detail {Return the fraction corresponding to a pixel displacement.}
            synopsis {pathName delta deltaX deltaY}
            return_type Double
            pure
            side_effect InterpState -reads
        }

        method fraction {
            arity 2
            detail {Return the fraction corresponding to a point in the trough.}
            synopsis {pathName fraction x y}
            return_type Double
            pure
            side_effect InterpState -reads
        }

        method get {
            arity 0
            detail {Return the scrollbar's current view fractions.}
            synopsis {pathName get}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method identify {
            arity 2
            detail {Return the scrollbar element at the given coordinates.}
            synopsis {pathName identify x y}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method set {
            arity 2
            detail {Set the scrollbar's first and last view fractions.}
            synopsis {pathName set first last}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }
    }

    option -orient -takes {} -detail {Orientation of the scrollbar: horizontal or vertical.}
    option -command -takes prefix -role CommandPrefix -script-timing Deferred \
        -detail {Command prefix to invoke when the scrollbar is moved (`moveto frac` appends 2, `scroll n units|pages` appends 3).}
    option -width -takes {} \
        -detail {Desired narrow dimension of the scrollbar in screen units.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -background -takes {} -detail {Background colour of the scrollbar.}
    option -activebackground -takes {} \
        -detail {Background colour when the mouse is over the scrollbar elements.}
    option -troughcolor -takes {} -detail {Colour of the trough area behind the slider.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -borderwidth -takes {} -detail {Width of the border around the scrollbar.}
    option -elementborderwidth -takes {} \
        -detail {Width of the borders around the internal elements of the scrollbar.}
    option -jump -takes {} \
        -detail {Whether to delay updates until the mouse button is released.}
    option -activerelief -takes {} \
        -detail {Relief to use for the active element of the scrollbar.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the scrollbar.}
    option -takefocus -takes {} \
        -detail {Whether the scrollbar accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the scrollbar does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the scrollbar has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the scrollbar.}
    option -repeatdelay -takes {} \
        -detail {Milliseconds before auto-repeat begins when an arrow is held.}
    option -repeatinterval -takes {} -detail {Milliseconds between auto-repeat invocations.}

    form Default {scrollbar pathName ?option value ...?}

    hover {
        summary {Create and manipulate a scrollbar widget.}
        synopsis {scrollbar pathName ?option value ...?}
        description {Displays a scrollbar and allows the user to control the viewing area of an associated widget.}
        source {Tk man page scrollbar.n}
    }
}

command seek {
    available {tcl 8.4-}
    traits BYTE_COMPILED
    arity 2..3

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Channel
    arg 2 -values-from seek-arg2

    side_effect FileIo -writes

    runtime_backing shipped-builtin seek

    form Default {seek channelId offset ?origin?}

    hover {
        summary {Change the access position for an open channel.}
        synopsis {seek channelId offset ?origin?}
        description {channelId identifies an already-open channel: a Tcl standard channel (stdin, stdout, stderr), the result of open or socket, or a channel created by an extension. offset is an integer (which may be negative) counted in bytes, not characters — like tell, seek always operates in bytes, unlike read.

origin selects what offset is relative to: start (the default) counts from the beginning of the file or device; current counts from the current access position, with a negative offset moving backwards; end counts from the end, with a negative offset landing before EOF and a positive offset after it. Any unique abbreviation of start/current/end down to a single letter is also accepted.

Before repositioning, seek flushes all buffered output for the channel — even in nonblocking mode — and discards any buffered, unread input. Applying seek to a channel whose underlying file or device does not support seeking (a pipe, and most sockets) is an error.

From Tcl 9.0 the seek manual page documents itself purely as an alias for chan seek ("has been superceded by the chan seek command which supports the same syntax and options"), though seek keeps working exactly as described above in every version through 9.1. The chan ensemble's chan seek subcommand, added in Tcl 8.5, offers identical behaviour under a different spelling.}
        source {Tcl seek(n)}
        example {# Get a file's size using seek + tell
set f [open report.log r]
seek $f 0 end
set fileSize [tell $f]
close $f

# Read just the last 10 bytes of a file
set f [open data.bin r]
fconfigure $f -translation binary
seek $f -10 end
set tail [read $f 10]
close $f}
        returns {Empty string.}
    }
}

command selection {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    side_effect InterpState -reads -writes

    option -displayof -takes window \
        -detail {Specifies the display for the selection operation.}
    option -selection -takes selection \
        -detail {Specifies which named selection to operate on (default: PRIMARY).}
    option -type -takes type \
        -detail {Specifies the form in which the selection is to be returned.}
    option -format -takes format \
        -detail {Specifies the representation format for the selection data.}
    option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
        -detail {Specifies a Tcl script to run when the selection is claimed by another window.}

    form Default {selection option ?arg ...?}

    hover {
        summary {Manipulate the X selection.}
        synopsis {selection clear ?-displayof window? ?-selection selection?}
        synopsis {selection get ?-displayof window? ?-selection selection? ?-type type?}
        synopsis {selection handle ?-selection selection? ?-type type? ?-format format? window command}
        synopsis {selection own ?-displayof window? ?-selection selection?}
        synopsis {selection own ?-command command? ?-selection selection? window}
        source {Tk man page selection.n}
    }

    subcommand clear {
        detail {Clear the selection so that no window owns it.}
        synopsis {selection clear ?-displayof window? ?-selection selection?}

        option -displayof -takes window \
            -detail {Specifies the display for the selection operation.}
        option -selection -takes selection \
            -detail {Specifies which named selection to operate on (default: PRIMARY).}
    }

    subcommand get {
        detail {Retrieve the selection and return it as a string.}
        synopsis {selection get ?-displayof window? ?-selection selection? ?-type type?}
        traits TAINT_SOURCE
        return_type String
        side_effect InterpState -reads

        option -displayof -takes window \
            -detail {Specifies the display for the selection operation.}
        option -selection -takes selection \
            -detail {Specifies which named selection to operate on (default: PRIMARY).}
        option -type -takes type \
            -detail {Specifies the form in which the selection is to be returned.}
    }

    subcommand handle {
        arity 2..
        detail {Register a handler to provide the selection data.}
        synopsis {selection handle ?-selection sel? ?-type type? ?-format fmt? window command}
        command_prefix_resolver -native selection::handle::command_prefix_resolver
        script_timing_resolver -native selection::handle::script_timing_resolver

        option -selection -takes selection \
            -detail {Specifies which named selection to operate on (default: PRIMARY).}
        option -type -takes type \
            -detail {Specifies the form in which the selection is to be returned.}
        option -format -takes format \
            -detail {Specifies the representation format for the selection data.}
    }

    subcommand own {
        detail {Query or set the owner of the selection.}
        synopsis {selection own ?-command command? ?-selection selection? window}

        option -displayof -takes window \
            -detail {Specifies the display for the selection operation.}
        option -selection -takes selection \
            -detail {Specifies which named selection to operate on (default: PRIMARY).}
        option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
            -detail {Specifies a Tcl script to run when the selection is claimed by another window.}
    }
}

command self {
    available {tcl 8.6-}
    traits {LANGUAGE_KEYWORD PURE TCLOO_INTROSPECTION TCLOO_METHOD_CONTEXT TCLOO_REQUIRES_METHOD_FRAME}
    arity ..1

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -values-from oo-helpers-self-arg0 -closed
    self_receiver_words object

    runtime_backing shipped-builtin ::oo::Helpers::self

    oo_context_fact class DefiningClass

    form Default {self ?subcommand?}

    hover {
        summary {query information about the current method invocation}
        synopsis {self ?subcommand?}
        description {The self command is used within the body of a method, constructor, or destructor to introspect how it is currently being called; used anywhere else, self is simply not a defined command. Called with no subcommand it behaves like self object. self object, self method, self class, and self namespace return the current object, the running method's name, the class that defined it, and the object's instance namespace respectively; self class fails when the implementation was defined directly on an object rather than a class. self call and self next describe the method's position in its call chain — the sequence of implementations built from the object's mixins, class, and superclasses that next walks along — while self filter and self target are meaningful only inside a filter implementation, and self caller only when the method was itself invoked from inside another object's method.}
        source {Tcl man page self.n}
        example {oo::class create Greeter {
    method hello {} {
        puts "[self] ([self class]) running [self method]"
    }
}
Greeter create g
g hello                    ;# -> ::g (::Greeter) running hello}
        returns {Depends on the subcommand: self object, self method, self class, and self namespace each return a single name; self call, self caller, self filter, self next, and self target each return a two- or three-element list (self next returns the empty string once the chain is exhausted). Omitting the subcommand returns the same value as self object.}
    }
}

command send {
    available {tcl 8.4-} {package Tk}
    traits {EVALUATES_CODE TAINT_SINK CREATES_DYNAMIC_BARRIER DYNAMIC_EVAL_BODY SCRIPT_CONCATENATES_ARGS}
    arity 2..
    required_package Tk
    warn_missing_import no

    return_type String
    body_kind Structural

    arg_role_resolver -native send::arg_role_resolver
    arg_role_resolver_roles {Name Body}
    script_timing_resolver -native send::script_timing_resolver

    side_effect InterpState -writes
    side_effect NetworkIo -writes

    taint_sink_safe_colour LIST_CANONICAL

    option -async \
        -detail {Invoke the command asynchronously and return without waiting for its result.}
    option -displayof -takes window \
        -detail {Select the display containing the target application's main window.}
    option -- -detail {End option processing before the target application name.}

    form Default {send ?options? app cmd ?arg ...?}

    hover {
        summary {Execute a command in a different Tk application.}
        synopsis {send ?options? app cmd ?arg ...?}
        description {The command words are concatenated and evaluated in the named Tk application's interpreter, not in the sender's frame. Without `-async`, the remote result or error is returned synchronously. With `-async`, send returns immediately with an empty result and remote errors are not reported to the sender. Because remotely evaluated text is code, untrusted command words are a code-injection sink; construct them with `list` rather than string concatenation.}
        source {Tk man page send.n}
        returns {Without -async, the remote command's result or error. With -async, an empty result after queueing the request.}
    }
}

command set {
    available {tcl 8.4-} {f5-irules}
    traits {BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME FIRST_ARG_VARNAME}
    arity 1..2

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role VarRead
    assigns_variable_at 0

    lowering_hook -native Set
    codegen_hook -native Set
    inline_codegen_hook -native Set
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -reads -writes
    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    runtime_backing shipped-builtin set

    binds_handle {-name-from {Word 0} -class-from {ConstructionValue 1}}

    form Default {set varName ?value?}

    hover {
        summary {Read the value of a variable, or set it to a new value.}
        synopsis {set varName ?value?}
        description {With one argument, returns varName's current value — an error if it has never been set. With two, assigns value to varName, creating the variable if it doesn't already exist, and returns that same value. varName names an array element when written as arrayName(index); the index may itself come from variable or command substitution. varName can also be produced by substitution itself, so `set out [set $vbl]` reads whichever variable vbl currently names — Tcl's own documentation notes arrays are usually the cleaner alternative to this kind of double-dereferencing. Scope resolution depends on context: inside a procedure, an unqualified varName is a local or parameter unless previously declared via global, variable, or upvar; outside a procedure, or when varName is namespace-qualified, it resolves as a namespace variable instead. At namespace scope, Tcl 8.4 through 8.6 fall back to a same-named variable in the global namespace (never an intermediate enclosing namespace) when the current namespace has none; Tcl 9.0 and later require an exact match in the current namespace, with no global fallback.}
        source {Tcl set(n)}
        example {set r [expr {rand()}]
set anAry(msg) "Hello, World!"

# Array element addressed by a variable-held index
set elemName "msg"
set anAry($elemName) "Hello, World!"

# Indirection: read the variable named by the current value of vbl
set in0 "small random"
set in1 "large random"
set vbl in[expr {rand() >= 0.5}]
set out [set $vbl]}
        returns {varName's new value when value is given, otherwise its current value.}
    }

    refine read {
        arity 1
        arg 0 -role VarRead
        side_effect Variable -reads
    }

    refine write {
        arity 2
        arg 0 -role VarWrite
        side_effect Variable -writes
    }
}

