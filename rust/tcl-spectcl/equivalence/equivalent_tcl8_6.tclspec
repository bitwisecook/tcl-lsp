command tie::info {
    available {tcl 8.5-}
    arity 1..
    required_package tie
    tcllib_package tie

    arg 0 -values-from tie-info-arg0 -closed

    hover {
        summary {Query the tie subsystem (ties / types / type).}
        synopsis {tie::info ties arrayvarname | tie::info types | tie::info type dstype}
        source {tcllib tie package}
    }
}

