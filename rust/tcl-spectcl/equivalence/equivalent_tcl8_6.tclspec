command while {
    available {tcl 8.4-} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD HAS_BOOLEAN_COND HAS_LOOP_BODY NEVER_INLINE_BODY BYTE_COMPILED NOT_PROC_FACTORY}
    arity 2

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Expr -type Boolean -shimmers
    arg 1 -role Body

    clause_grammar {
        head Expr
        tail Body -timing per-iteration
        selection all
    }

    lowering_hook -native While

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin while

    form Default {while test body}

    hover {
        summary {Execute script repeatedly as long as a condition is met.}
        synopsis {while test body}
        description {test is evaluated as an expression, the same way expr evaluates its argument, and the result must be a proper boolean value. While it is true, body is executed by passing it to the Tcl interpreter; once body finishes, test is evaluated again, and the cycle repeats until test becomes false. continue inside body terminates the current iteration and jumps straight to the next test check; break inside body causes immediate termination of the whole loop. Either way while itself always returns an empty string. test should almost always be enclosed in braces, e.g. {$x < 10}: an unbraced test is substituted once, before the loop starts, so it never sees changes body makes to the variables involved and this is likely to result in an infinite loop. Enclosing test in braces delays variable substitution until the expression is evaluated before each iteration, so changes body makes are visible on the next check.}
        source {Tcl while(n)}
        example {set x 0
while {$x < 10} {
    puts "x is $x"
    incr x
}

set lineCount 0
while {[gets $chan line] >= 0} {
    puts "[incr lineCount]: $line"
}}
        returns {An empty string.}
    }
}

command winfo {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    side_effect InterpState -reads

    form Default {winfo option ?arg ...?}

    hover {
        summary {Return window-related information.}
        synopsis {winfo atom ?-displayof window? name}
        synopsis {winfo atomname ?-displayof window? id}
        synopsis {winfo cells window}
        synopsis {winfo children window}
        synopsis {winfo class window}
        synopsis {winfo colormapfull window}
        synopsis {winfo containing ?-displayof window? rootX rootY}
        synopsis {winfo depth window}
        synopsis {winfo exists window}
        synopsis {winfo geometry window}
        synopsis {winfo height window}
        synopsis {winfo id window}
        synopsis {winfo ismapped window}
        synopsis {winfo manager window}
        synopsis {winfo name window}
        synopsis {winfo parent window}
        synopsis {winfo pathname ?-displayof window? id}
        synopsis {winfo pixels window number}
        synopsis {winfo reqheight window}
        synopsis {winfo reqwidth window}
        synopsis {winfo rootx window}
        synopsis {winfo rooty window}
        synopsis {winfo screen window}
        synopsis {winfo screenheight window}
        synopsis {winfo screenwidth window}
        synopsis {winfo toplevel window}
        synopsis {winfo viewable window}
        synopsis {winfo visual window}
        synopsis {winfo width window}
        synopsis {winfo x window}
        synopsis {winfo y window}
        source {Tk man page winfo.n}
    }

    subcommand atom {
        arity 1..3
        detail {Return the integer identifier for the atom given by name.}
        synopsis {winfo atom ?-displayof window? name}
    }

    subcommand atomname {
        arity 1..3
        detail {Return the textual name for the atom given by integer id.}
        synopsis {winfo atomname ?-displayof window? id}
    }

    subcommand cells { arity 1 ; detail {Return the number of cells in the colour map for the window.} ; synopsis {winfo cells window} }
    subcommand children { arity 1 ; detail {Return a list of the path names of the window's children.} ; synopsis {winfo children window} }
    subcommand class { arity 1 ; detail {Return the class name of the window.} ; synopsis {winfo class window} }

    subcommand colormapfull {
        arity 1
        detail {Return 1 if the colour map for the window is full, 0 otherwise.}
        synopsis {winfo colormapfull window}
    }

    subcommand containing {
        arity 2..4
        detail {Return the path name of the window containing the point.}
        synopsis {winfo containing ?-displayof window? rootX rootY}
        traits TAINT_SOURCE
    }

    subcommand depth { arity 1 ; detail {Return the number of bits per pixel in the window.} ; synopsis {winfo depth window} }
    subcommand exists { arity 1 ; detail {Return 1 if the window exists, 0 otherwise.} ; synopsis {winfo exists window} }

    subcommand fpixels {
        arity 2
        detail {Return the number of pixels corresponding to the distance as a float.}
        synopsis {winfo fpixels window number}
    }

    subcommand geometry { arity 1 ; detail {Return the geometry of the window in WxH+X+Y format.} ; synopsis {winfo geometry window} }
    subcommand height { arity 1 ; detail {Return the height of the window in pixels.} ; synopsis {winfo height window} }
    subcommand id { arity 1 ; detail {Return the platform-specific window identifier.} ; synopsis {winfo id window} }

    subcommand interps {
        arity ..2
        detail {Return a list of all Tcl interpreters on the display.}
        synopsis {winfo interps ?-displayof window?}
    }

    subcommand isdark {
        arity 1
        detail {Return whether the window uses the platform dark appearance.}
        synopsis {winfo isdark window}
        introduced_version 9.1
        return_type Boolean
    }

    subcommand ismapped { arity 1 ; detail {Return 1 if the window is currently mapped, 0 otherwise.} ; synopsis {winfo ismapped window} }
    subcommand manager { arity 1 ; detail {Return the name of the geometry manager for the window.} ; synopsis {winfo manager window} }
    subcommand name { arity 1 ; detail {Return the window's name (last component of its path).} ; synopsis {winfo name window} }
    subcommand parent { arity 1 ; detail {Return the path name of the window's parent.} ; synopsis {winfo parent window} }

    subcommand pathname {
        arity 1..3
        detail {Return the path name of the window whose identifier is id.}
        synopsis {winfo pathname ?-displayof window? id}
    }

    subcommand pixels { arity 2 ; detail {Return the number of pixels corresponding to the distance.} ; synopsis {winfo pixels window number} }

    subcommand pointerx {
        arity 1
        detail {Return the x-coordinate of the mouse pointer on the screen.}
        synopsis {winfo pointerx window}
        traits TAINT_SOURCE
    }

    subcommand pointerxy {
        arity 1
        detail {Return the x and y coordinates of the mouse pointer.}
        synopsis {winfo pointerxy window}
        traits TAINT_SOURCE
    }

    subcommand pointery {
        arity 1
        detail {Return the y-coordinate of the mouse pointer on the screen.}
        synopsis {winfo pointery window}
        traits TAINT_SOURCE
    }

    subcommand reqheight { arity 1 ; detail {Return the requested height of the window in pixels.} ; synopsis {winfo reqheight window} }
    subcommand reqwidth { arity 1 ; detail {Return the requested width of the window in pixels.} ; synopsis {winfo reqwidth window} }
    subcommand rgb { arity 2 ; detail {Return the RGB values for a colour in the window.} ; synopsis {winfo rgb window color} }
    subcommand rootx { arity 1 ; detail {Return the x-coordinate of the upper-left corner in the root window.} ; synopsis {winfo rootx window} }
    subcommand rooty { arity 1 ; detail {Return the y-coordinate of the upper-left corner in the root window.} ; synopsis {winfo rooty window} }
    subcommand screen { arity 1 ; detail {Return the display and screen of the window.} ; synopsis {winfo screen window} }

    subcommand screencells {
        arity 1
        detail {Return the number of cells in the default colour map for the screen.}
        synopsis {winfo screencells window}
    }

    subcommand screendepth { arity 1 ; detail {Return the number of bits per pixel on the screen.} ; synopsis {winfo screendepth window} }
    subcommand screenheight { arity 1 ; detail {Return the height of the screen in pixels.} ; synopsis {winfo screenheight window} }
    subcommand screenmmheight { arity 1 ; detail {Return the height of the screen in millimetres.} ; synopsis {winfo screenmmheight window} }
    subcommand screenmmwidth { arity 1 ; detail {Return the width of the screen in millimetres.} ; synopsis {winfo screenmmwidth window} }
    subcommand screenvisual { arity 1 ; detail {Return the visual class of the screen.} ; synopsis {winfo screenvisual window} }
    subcommand screenwidth { arity 1 ; detail {Return the width of the screen in pixels.} ; synopsis {winfo screenwidth window} }
    subcommand server { arity 1 ; detail {Return information about the display server.} ; synopsis {winfo server window} }

    subcommand toplevel {
        arity 1
        detail {Return the path name of the top-level window containing the window.}
        synopsis {winfo toplevel window}
    }

    subcommand viewable { arity 1 ; detail {Return 1 if the window and all ancestors are mapped.} ; synopsis {winfo viewable window} }
    subcommand visual { arity 1 ; detail {Return the visual class of the window.} ; synopsis {winfo visual window} }
    subcommand visualid { arity 1 ; detail {Return the X identifier for the visual of the window.} ; synopsis {winfo visualid window} }

    subcommand visualsavailable {
        arity 1..2
        detail {Return a list of available visual classes for the screen.}
        synopsis {winfo visualsavailable window ?includeids?}
    }

    subcommand vrootheight { arity 1 ; detail {Return the height of the virtual root window.} ; synopsis {winfo vrootheight window} }
    subcommand vrootwidth { arity 1 ; detail {Return the width of the virtual root window.} ; synopsis {winfo vrootwidth window} }
    subcommand vrootx { arity 1 ; detail {Return the x offset of the virtual root window.} ; synopsis {winfo vrootx window} }
    subcommand vrooty { arity 1 ; detail {Return the y offset of the virtual root window.} ; synopsis {winfo vrooty window} }
    subcommand width { arity 1 ; detail {Return the width of the window in pixels.} ; synopsis {winfo width window} }
    subcommand x { arity 1 ; detail {Return the x-coordinate of the upper-left corner of the window.} ; synopsis {winfo x window} }
    subcommand y { arity 1 ; detail {Return the y-coordinate of the upper-left corner of the window.} ; synopsis {winfo y window} }
}

command wm {
    available {tcl 8.4-} {package Tk}
    arity 2..
    required_package Tk
    warn_missing_import no

    side_effect InterpState -reads -writes

    form Default {wm option window ?arg ...?}

    hover {
        summary {Communicate with the window manager.}
        synopsis {wm aspect window ?minNumer minDenom maxNumer maxDenom?}
        synopsis {wm attributes window ?option? ?value ...?}
        synopsis {wm client window ?name?}
        synopsis {wm colormapwindows window ?windowList?}
        synopsis {wm command window ?value?}
        synopsis {wm deiconify window}
        synopsis {wm focusmodel window ?active|passive?}
        synopsis {wm forget window}
        synopsis {wm frame window}
        synopsis {wm geometry window ?newGeometry?}
        synopsis {wm grid window ?baseWidth baseHeight widthInc heightInc?}
        synopsis {wm group window ?pathName?}
        synopsis {wm iconbitmap window ?bitmap?}
        synopsis {wm iconify window}
        synopsis {wm iconmask window ?bitmap?}
        synopsis {wm iconname window ?newName?}
        synopsis {wm iconphoto window ?-default? image1 ?image2 ...?}
        synopsis {wm iconposition window ?x y?}
        synopsis {wm iconwindow window ?pathName?}
        synopsis {wm manage window}
        synopsis {wm maxsize window ?width height?}
        synopsis {wm minsize window ?width height?}
        synopsis {wm overrideredirect window ?boolean?}
        synopsis {wm positionfrom window ?who?}
        synopsis {wm protocol window ?name? ?command?}
        synopsis {wm resizable window ?width height?}
        synopsis {wm sizefrom window ?who?}
        synopsis {wm stackorder window ?isabove|isbelow window?}
        synopsis {wm state window ?newstate?}
        synopsis {wm title window ?string?}
        synopsis {wm transient window ?master?}
        synopsis {wm withdraw window}
        source {Tk man page wm.n}
    }

    subcommand aspect {
        arity 1..5
        detail {Set or query the desired aspect ratio for the window.}
        synopsis {wm aspect window ?minNumer minDenom maxNumer maxDenom?}
    }

    subcommand attributes {
        arity 1..
        detail {Set or query platform-specific window attributes.}
        synopsis {wm attributes window ?option? ?value ...?}
    }

    subcommand client { arity 1..2 ; detail {Set or query the WM_CLIENT_MACHINE property.} ; synopsis {wm client window ?name?} }

    subcommand colormapwindows {
        arity 1..2
        detail {Set or query the WM_COLORMAP_WINDOWS property.}
        synopsis {wm colormapwindows window ?windowList?}
    }

    subcommand command { arity 1..2 ; detail {Set or query the WM_COMMAND property.} ; synopsis {wm command window ?value?} }
    subcommand deiconify { arity 1 ; detail {Arrange for the window to be displayed in normal form.} ; synopsis {wm deiconify window} }

    subcommand focusmodel {
        arity 1..2
        detail {Set or query the focus model for the window.}
        synopsis {wm focusmodel window ?active|passive?}
    }

    subcommand forget { arity 1 ; detail {Make the window no longer managed by wm.} ; synopsis {wm forget window} }
    subcommand frame { arity 1 ; detail {Return the platform-specific window identifier of the outermost frame.} ; synopsis {wm frame window} }
    subcommand geometry { arity 1..2 ; detail {Set or query the geometry of the window.} ; synopsis {wm geometry window ?newGeometry?} }

    subcommand grid {
        arity 1..5
        detail {Set or query the gridding information for the window.}
        synopsis {wm grid window ?baseWidth baseHeight widthInc heightInc?}
    }

    subcommand group { arity 1..2 ; detail {Set or query the group leader for the window.} ; synopsis {wm group window ?pathName?} }

    subcommand iconbadge {
        arity 2
        detail {Set a badge (a short overlay label) on the window's taskbar/dock icon.}
        synopsis {wm iconbadge window badge}
        available {tcl 9.0-}
    }

    subcommand iconbitmap {
        arity 1..2
        detail {Set or query the bitmap for when the window is iconified.}
        synopsis {wm iconbitmap window ?bitmap?}
    }

    subcommand iconify { arity 1 ; detail {Arrange for the window to be iconified.} ; synopsis {wm iconify window} }
    subcommand iconmask { arity 1..2 ; detail {Set or query the icon mask bitmap.} ; synopsis {wm iconmask window ?bitmap?} }
    subcommand iconname { arity 1..2 ; detail {Set or query the icon name for the window.} ; synopsis {wm iconname window ?newName?} }

    subcommand iconphoto {
        arity 2..
        detail {Set the window icon from one or more photo images.}
        synopsis {wm iconphoto window ?-default? image1 ?image2 ...?}
    }

    subcommand iconposition { arity 1..3 ; detail {Set or query the icon position hint.} ; synopsis {wm iconposition window ?x y?} }
    subcommand iconwindow { arity 1..2 ; detail {Set or query the icon window for the window.} ; synopsis {wm iconwindow window ?pathName?} }
    subcommand manage { arity 1 ; detail {Make the window managed by wm.} ; synopsis {wm manage window} }
    subcommand maxsize { arity 1..3 ; detail {Set or query the maximum size for the window.} ; synopsis {wm maxsize window ?width height?} }
    subcommand minsize { arity 1..3 ; detail {Set or query the minimum size for the window.} ; synopsis {wm minsize window ?width height?} }

    subcommand overrideredirect {
        arity 1..2
        detail {Set or query the override-redirect flag.}
        synopsis {wm overrideredirect window ?boolean?}
    }

    subcommand positionfrom { arity 1..2 ; detail {Set or query who specified the window position.} ; synopsis {wm positionfrom window ?who?} }

    subcommand protocol {
        arity 1..3
        detail {Register a handler for a window manager protocol.}
        synopsis {wm protocol window ?name? ?command?}
        body_kind Structural
        arg_role_resolver -native wm::protocol::arg_role_resolver
        arg_role_resolver_roles Body
        script_timing_resolver -native wm::protocol::script_timing_resolver
    }

    subcommand resizable { arity 1..3 ; detail {Set or query whether the window is resizable.} ; synopsis {wm resizable window ?width height?} }
    subcommand sizefrom { arity 1..2 ; detail {Set or query who specified the window size.} ; synopsis {wm sizefrom window ?who?} }

    subcommand stackorder {
        arity 1..3
        detail {Return the stacking order or compare two windows.}
        synopsis {wm stackorder window ?isabove|isbelow window?}
    }

    subcommand state { arity 1..2 ; detail {Set or query the current state of the window.} ; synopsis {wm state window ?newstate?} }
    subcommand title { arity 1..2 ; detail {Set or query the title of the window.} ; synopsis {wm title window ?string?} }
    subcommand transient { arity 1..2 ; detail {Set or query the transient master for the window.} ; synopsis {wm transient window ?master?} }
    subcommand withdraw { arity 1 ; detail {Withdraw the window so it is no longer mapped.} ; synopsis {wm withdraw window} }
}

