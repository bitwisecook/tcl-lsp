command generator {
    available {tcl 8.6-}
    arity 1..
    required_package generator
    tcllib_package generator

    hover {
        summary {Create and drive lazy generator procedures (streams).}
        synopsis {generator subcommand ?arg ...?}
        source {tcllib generator package}
    }

    subcommand define {
        arity 3
        detail {Creates a new generator procedure.}
        synopsis {generator define name params body}
        arg 1 -role ParamList
        arg 2 -role Body
    }

    subcommand yield {
        arity 1..
        detail {Used in the definition of a generator, this command returns the next set of values to the consumer.}
        synopsis {generator yield arg}
    }

    subcommand foreach {
        arity 3..
        detail {Loops through one or more generators, assigning the next values to variables and then executing the loop body.}
        synopsis {generator foreach varList generator ?varList generator ...? body}
    }

    subcommand next { arity 1.. ; detail {Manually retrieves the next values from a generator.} ; synopsis {generator next generator} }
    subcommand exists { arity 1 ; detail {Returns 1 if the generator (still) exists, or 0 otherwise.} ; synopsis {generator exists generator} }
    subcommand names { arity 0 ; detail {Returns a list of all currently existing generator commands.} ; synopsis {generator names} }
    subcommand destroy { detail {Destroys one or more generators, freeing any associated resources.} ; synopsis {generator destroy} }

    subcommand finally {
        arity 1..
        detail {Used in the definition of a generator procedure, this command arranges for a resource to be cleaned up whenever the}
        synopsis {generator finally cmd}
    }

    subcommand from { arity 2 ; detail {Creates a generator from a data structure.} ; synopsis {generator from format value} }
    subcommand to { arity 2 ; detail {Converts a generator into a data structure.} ; synopsis {generator to format generator} }

    subcommand map {
        arity 2
        detail {Apply a function to every element of a generator, returning a new generator of the results.}
        synopsis {generator map function generator}
        arg 0 -appends Unknown
        script_timing_resolver -native generator::map::script_timing_resolver
    }

    subcommand filter {
        arity 2
        detail {Another classic functional programming gem.}
        synopsis {generator filter predicate generator}
        arg 0 -appends Unknown
        script_timing_resolver -native generator::filter::script_timing_resolver
    }

    subcommand reduce {
        arity 3
        detail {This is the classic left-fold operation.}
        synopsis {generator reduce function zero generator}
        arg 0 -appends Unknown
    }

    subcommand foldl {
        arity 3
        detail {This is an alias for the reduce command.}
        synopsis {generator foldl function zero generator}
        arg 0 -appends Unknown
    }

    subcommand foldr {
        arity 3
        detail {This is the right-associative version of reduce.}
        synopsis {generator foldr function zero generator}
        arg 0 -appends Unknown
    }

    subcommand all {
        arity 2
        detail {Returns true if all elements of the generator satisfy the given predicate.}
        synopsis {generator all predicate generator}
        arg 0 -appends Unknown
    }

    subcommand and {
        arity 1
        detail {Returns true if all elements of the generator are true (i.e., takes the logical conjunction of the elements).}
        synopsis {generator and generator}
    }

    subcommand any {
        arity 1
        detail {Returns true if any of the elements of the generator are true (i.e., logical disjunction).}
        synopsis {generator any generator}
    }

    subcommand concat {
        arity 1..
        detail {Returns a generator which is the concatenation of each of the argument generators.}
        synopsis {generator concat generator}
    }

    subcommand concatMap {
        arity 2
        detail {Given a function which maps a value to a series of values, and a generator of values of that type, returns a genera}
        synopsis {generator concatMap function generator}
        arg 0 -appends Unknown
        script_timing_resolver -native generator::concatMap::script_timing_resolver
    }

    subcommand drop {
        arity 2
        detail {Removes the given number of elements from the front of the generator and returns the resulting generator with those}
        synopsis {generator drop n generator}
    }

    subcommand dropWhile {
        arity 2
        detail {Removes all elements from the front of the generator that satisfy the predicate.}
        synopsis {generator dropWhile predicate generator}
        arg 0 -appends Unknown
        script_timing_resolver -native generator::dropWhile::script_timing_resolver
    }

    subcommand contains {
        arity 2
        detail {Returns true if the generator contains the given element.}
        synopsis {generator contains element generator}
    }

    subcommand foldl1 {
        arity 2
        detail {A version of foldl that takes the zero argument from the first element of the generator.}
        synopsis {generator foldl1 function generator}
        arg 0 -appends Unknown
    }

    subcommand foldli {
        arity 3
        detail {A version of foldl that supplies the integer index of each element as the first argument to the function.}
        synopsis {generator foldli function zero generator}
        arg 0 -appends Unknown
    }

    subcommand foldri {
        arity 3
        detail {Right-associative version of foldli.}
        synopsis {generator foldri function zero generator}
        arg 0 -appends Unknown
    }

    subcommand head { arity 1 ; detail {Returns the first element of the generator.} ; synopsis {generator head generator} }
    subcommand tail { arity 1 ; detail {Removes the first element of the generator, returning the rest.} ; synopsis {generator tail generator} }

    subcommand init {
        arity 1
        detail {Returns a new generator consisting of all elements except the last of the argument generator.}
        synopsis {generator init generator}
    }

    subcommand takeList {
        arity 2
        detail {Returns the next n elements of the generator as a list.}
        synopsis {generator takeList n generator}
    }

    subcommand take {
        arity 2
        detail {Returns the next n elements of the generator as a new generator.}
        synopsis {generator take n generator}
    }

    subcommand iterate {
        arity 2
        detail {Returns an infinite generator formed by repeatedly applying the function to the initial argument.}
        synopsis {generator iterate function init}
        arg 0 -appends Unknown
        script_timing_resolver -native generator::iterate::script_timing_resolver
    }

    subcommand last { arity 1 ; detail {Returns the last element of the generator (if it exists).} ; synopsis {generator last generator} }

    subcommand length {
        arity 1
        detail {Returns the length of the generator, destroying it in the process.}
        synopsis {generator length generator}
    }

    subcommand or {
        arity 2
        detail {Returns 1 if any of the elements of the generator satisfy the predicate.}
        synopsis {generator or predicate generator}
        arg 0 -appends Unknown
    }

    subcommand product { arity 1 ; detail {Returns the product of the numbers in a generator.} ; synopsis {generator product generator} }

    subcommand repeat {
        arity 2..
        detail {Returns a generator that consists of n copies of the given elements.}
        synopsis {generator repeat n value ?value ...?}
    }

    subcommand sum { arity 1 ; detail {Returns the sum of the values in the generator.} ; synopsis {generator sum generator} }

    subcommand takeWhile {
        arity 2
        detail {Returns a generator of the first elements in the argument generator that satisfy the predicate.}
        synopsis {generator takeWhile predicate generator}
        arg 0 -appends Unknown
        script_timing_resolver -native generator::takeWhile::script_timing_resolver
    }

    subcommand splitWhen {
        arity 2
        detail {Splits the generator into lists of elements using the predicate to identify delimiters.}
        synopsis {generator splitWhen predicate generator}
        arg 0 -appends Unknown
        script_timing_resolver -native generator::splitWhen::script_timing_resolver
    }

    subcommand scanl {
        arity 3
        detail {Similar to foldl, but returns a generator of all of the intermediate values for the accumulator argument.}
        synopsis {generator scanl function zero generator}
        arg 0 -appends Unknown
        script_timing_resolver -native generator::scanl::script_timing_resolver
    }
}

command gets {
    available {tcl 8.4-}
    traits {UNCONDITIONAL_VARIABLE_WRITE TAINT_SOURCE BYTE_COMPILED}
    arity 1..2

    return_type String
    var_write_typing {Fixed String}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Channel
    arg 1 -role VarWrite
    assigns_variable_at 1

    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect FileIo -reads
    side_effect Variable -writes

    runtime_backing shipped-builtin gets

    form Default {gets channelId ?varName?}

    hover {
        summary {Read a line from a channel.}
        synopsis {gets channelId ?varName?}
        description {Reads the next line from channelId — every character up to (but not including) the end-of-line sequence — and discards the end-of-line sequence itself. channelId must identify an open, readable channel: stdin, the result of open or socket, or a channel created by a Tcl extension. Without varName, the line read is returned as the command's result. With varName, the line is stored in that variable instead and the result is the character count read. If end-of-file is reached partway through a line, whatever was read so far is still returned (or stored) as a partial line. On a nonblocking channel with no complete line yet available, gets consumes no input and returns early: an empty string when varName is omitted, or -1 (leaving varName empty) when it is given. Because a genuinely blank line, end-of-file, and this nonblocking not-yet-available case can all read as an empty string when varName is omitted, use eof and fblocked to tell them apart. Since Tcl 8.5, chan gets offers the identical functionality through the chan ensemble, and from Tcl 9.0 the gets manual page itself just redirects there — though gets remains a fully supported, independent command in every version. Starting in Tcl 9.0, if the channel's encoding profile is strict (the default), gets raises a POSIX EILSEQ error instead of silently passing through malformed encoding data; the channel's read position is left unchanged, so the encoding can be adjusted and the read retried.}
        source {Tcl gets(n)}
        example {set chan [open some.file.txt]
set lineNumber 0
while {[gets $chan line] >= 0} {
    puts "[incr lineNumber]: $line"
}
close $chan}
        returns {Without varName: the line read, or an empty string at end-of-file or when no full line is yet available on a nonblocking channel. With varName: the character count of the line read, or -1 at end-of-file or on an incomplete nonblocking read.}
    }
}

command gettimes {
    available {tcl 8.4-}

    hover {
        summary {Get timing information for performance testing.}
        synopsis {gettimes}
        source {Tcl test binary (tclTest.c)}
    }
}

command glob {
    available {tcl 8.4-}
    traits {BYTE_COMPILED SAFE_INTERP_HIDDEN}

    return_type List
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    pattern_type Glob

    arg_role_layout_resolver -native glob::arg_role_layout_resolver
    arg_role_resolver_roles Pattern

    side_effect FileIo -reads

    runtime_backing shipped-builtin glob

    option -directory -takes dir \
        -detail {Search for files matching the patterns starting in the given directory, so a directory name containing glob-sensitive characters need not be quoted. Cannot be combined with -path.}
    option -join \
        -detail {Join the pattern arguments, after option processing, into a single pattern using directory separators, instead of matching each pattern independently.}
    option -nocomplain \
        -detail {Return an empty list instead of raising an error when no files match. In Tcl 8.4 through 8.6 this switch is required to avoid that error; from Tcl 9.0 (TIP 637) an empty result is never an error by default, so the switch is still accepted but has no effect.}
    option -path -takes pathPrefix \
        -detail {Search for files whose name begins with the given path prefix and whose remainder matches the patterns — useful for finding files that share a root name but differ in extension. Cannot be combined with -directory.}
    option -tails \
        -detail {Return only the part of each matched name that follows the last directory named by -directory or -path, instead of the full path.}
    option -types -takes typeList -values-from glob-types \
        -detail {Filter matches against typeList, a Tcl list combining two vocabularies: Unix find-style kind letters (b/c/d/f/l/p/s), of which a match need satisfy only one, and permission words (r/w/x/readonly/hidden), of which a match must satisfy all. From Tcl 8.5, legacy macOS type/creator codes are also accepted.}
    option -- \
        -detail {Marks the end of switches. The argument following this one will be treated as a pattern even if it starts with -.}
    option_conflict {-directory -path}

    form Default {glob ?switches? ?pattern ...?} -available {tcl 8.6-}
    form Default {glob ?switches? pattern ?pattern ...?} -available {tcl 8.4-8.6}

    hover {
        summary {Return names of files that match patterns.}
        synopsis {glob ?switches? ?pattern ...?}
        synopsis {glob ?switches? pattern ?pattern ...?}
        description {Performs file name globbing similar to csh or bash, matching each pattern against names that actually exist and returning the union of matches as a list; no order is guaranteed, so pipe the result through lsort if a sorted list is needed.

-directory and -path anchor the search elsewhere without needing to quote glob-sensitive characters in the anchor itself, and are mutually exclusive. -types filters the match set: kind letters (b/c/d/f/l/p/s) are OR'ed together, while permission words (r/w/x/readonly/hidden) must all be satisfied. On Unix a leading '.' in a name (or right after '/') is only matched by an explicit '.' or -types hidden.

In Tcl 8.4 and 8.5 at least one pattern is required; Tcl 8.6 (TIP 323) made the pattern list itself optional too. Without -nocomplain, a call whose result would be empty is an error in Tcl 8.4 through 8.6; from Tcl 9.0 (TIP 637) an empty result is never an error, so -nocomplain is still accepted but has no effect.}
        source {Tcl glob(n)}
        example {glob *.tcl
glob -directory [file home] *.tcl
glob -nocomplain -types d *
glob -types {f r} *.log}
        returns {A list of the matching file names, in no particular order.}
    }
}

command global {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD CREATES_SCOPE_ALIAS ALIASES_GLOBAL CREATES_BARRIER CREATES_DYNAMIC_BARRIER BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME FRAME_HASH_BUILTIN}

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `native_result` is set on the source spec. The DSL spells
    #   it `native_result -native CONTRACT`, but a draft records only that the
    #   field is set, never the expression that set it.
    arg 0 -role VarWrite
    repeat VarWrite
    assigns_variable_at 0

    lowering_hook -native Global
    codegen_hook -native Global
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -writes
    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin global

    form Default {global ?varname ...?} -dialects {tcl8.6+ expect}
    form Default {global varname ?varname ...?} -dialects {tcl8.4 tcl8.5 f5-iapps f5-irules f5-tmsh}

    hover {
        summary {Access global variables}
        synopsis {global ?varname ...?}
        description {Executing global outside a proc body has no effect there (a no-op), once its arity requirement, if any, is met. Inside a proc body it creates local variables linked to the corresponding global (::-namespace) variables; like upvar-created links, these do not appear in info locals. A namespace-qualified varname is linked under its unqualified tail name, per namespace tail. Tcl 8.4 and 8.5 require at least one varname — a bare global with none is a "wrong # args" error even outside a proc body; Tcl 8.6 dropped that requirement, making global alone a legal no-op in every context. Since Tcl 8.5, varname must be a plain scalar name: one that looks like an array element (e.g. a(b)) is rejected as an error.}
        source {Tcl global(n)}
        example {proc reset {} {
    global a::x
    set x 0
}}
        returns {The empty string.}
    }
}

