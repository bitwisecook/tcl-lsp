        synopsis {console eval script}
        synopsis {console hide}
        synopsis {console show}
        synopsis {console title ?newTitle?}
        description {Manages the Tk debugging console, a text-widget UI backed by its own Tcl interpreter distinct from the caller's. `console eval` runs script in that console interpreter, not the caller's.}
        source {Tk man page console.n}
    }

    subcommand eval {
        arity 1
        detail {Evaluate a script in the console's own interpreter.}
        synopsis {console eval script}
        traits EVALUATES_CODE
        return_type String
        arg 0 -role Body
    }

    subcommand hide { arity 0 ; detail {Hide (unmap) the console window.} ; synopsis {console hide} }

    subcommand show {
        arity 0
        detail {Show (map and raise) the console window, creating it if it does not yet exist.}
        synopsis {console show}
    }

