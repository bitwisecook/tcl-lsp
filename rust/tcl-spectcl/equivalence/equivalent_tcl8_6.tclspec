command tk::text {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    introduced_version 8.5
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class text -method-prefix-matching Enabled {
        method bbox {
            arity 1
            detail {Return the bounding box of the character at the given index.}
            synopsis {pathName bbox index}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method cget {
            arity 1
            detail {Return the current value of a text option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change text options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method compare {
            arity 3
            detail {Compare two indices according to a relational operator.}
            synopsis {pathName compare index1 op index2}
            return_type Boolean
            pure
            side_effect InterpState -reads
        }

        method count {
            arity 2..
            detail {Count the number of items between two indices.}
            synopsis {pathName count ?option ...? index1 index2}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method debug {
            arity ..1
            detail {Enable or query consistency checking of the B-tree code.}
            synopsis {pathName debug ?boolean?}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method delete {
            arity 1..
            detail {Delete a range of characters from the text.}
            synopsis {pathName delete index1 ?index2 ...?}
