command place {
    available {tcl 8.4-} {package Tk}
    traits TK_GEOMETRY_MANAGER
    arity 1..
    required_package Tk
    tk_geometry Independent -container-option -in -direct-form -placement-subcommand configure -release-subcommands forget
    warn_missing_import no

    side_effect InterpState -writes

    option -x -takes location \
        -detail {Specifies the x-coordinate of the anchor point in the master window.}
    option -y -takes location \
        -detail {Specifies the y-coordinate of the anchor point in the master window.}
    option -relx -takes location \
        -detail {Specifies the x-coordinate as a fraction of the master width (0.0 to 1.0).}
    option -rely -takes location \
        -detail {Specifies the y-coordinate as a fraction of the master height (0.0 to 1.0).}
    option -width -takes size -detail {Specifies the width of the slave in screen units.}
    option -height -takes size -detail {Specifies the height of the slave in screen units.}
    option -relwidth -takes size \
        -detail {Specifies the width as a fraction of the master width (0.0 to 1.0).}
    option -relheight -takes size \
        -detail {Specifies the height as a fraction of the master height (0.0 to 1.0).}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {Specifies which point of the slave is positioned at the (x,y) location.}
    option -bordermode -takes inside|outside|ignore \
        -detail {Determines the degree to which borders within the master are used.}
    option -in -takes master \
        -detail {Specifies the master window relative to which the slave is placed.}

    form Default {place option arg ?arg ...?}

    hover {
        summary {Geometry manager for fixed or rubber-sheet placement.}
        synopsis {place window option value ?option value ...?}
        synopsis {place configure window ?option? ?value option value ...?}
        synopsis {place forget window}
        synopsis {place info window}
        synopsis {place slaves window}
        source {Tk man page place.n}
    }

    subcommand configure {
        arity 1..
        detail {Set or query the placement options for a window.}
        synopsis {place configure window ?option? ?value option value ...?}

        option -x -takes location \
            -detail {Specifies the x-coordinate of the anchor point in the master window.}
        option -y -takes location \
            -detail {Specifies the y-coordinate of the anchor point in the master window.}
        option -relx -takes location \
            -detail {Specifies the x-coordinate as a fraction of the master width (0.0 to 1.0).}
        option -rely -takes location \
            -detail {Specifies the y-coordinate as a fraction of the master height (0.0 to 1.0).}
        option -width -takes size \
            -detail {Specifies the width of the slave in screen units.}
        option -height -takes size \
            -detail {Specifies the height of the slave in screen units.}
        option -relwidth -takes size \
            -detail {Specifies the width as a fraction of the master width (0.0 to 1.0).}
        option -relheight -takes size \
            -detail {Specifies the height as a fraction of the master height (0.0 to 1.0).}
        option -anchor -takes anchor -values-from button-anchor -closed \
            -detail {Specifies which point of the slave is positioned at the (x,y) location.}
        option -bordermode -takes inside|outside|ignore \
            -detail {Determines the degree to which borders within the master are used.}
        option -in -takes master \
            -detail {Specifies the master window relative to which the slave is placed.}
    }

    subcommand content {
        arity 1
        detail {Return a list of all slaves managed by the placer for the window (9.0+ name for `slaves`).}
        synopsis {place content window}
        available {tcl 9.0-}
    }

    subcommand forget { arity 1 ; detail {Cause the placer to stop managing the geometry of the window.} ; synopsis {place forget window} }
    subcommand info { arity 1 ; detail {Return a list of the current configuration for the window.} ; synopsis {place info window} }
    subcommand slaves { arity 1 ; detail {Return a list of all slaves managed by the placer for the window.} ; synopsis {place slaves window} }
}

