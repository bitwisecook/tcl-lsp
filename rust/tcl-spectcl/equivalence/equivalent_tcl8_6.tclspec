    value both -detail {visit a parent before and after its children}
}

values struct-tree-struct-tree-walk-type {
    value dfs -detail {depth-first (default)}
    value bfs -detail {breadth-first}
}

values tcltest-configure-verbose {
    value body -detail {display the body of failed tests}
    value pass -detail {display all passed tests}
    value skip -detail {display all skipped tests}
    value start -detail {display each test as it starts}
    value error -detail {display errorInfo for failed tests}
    value line -detail {display source file line of failed tests (tcltest 2.3+)}
    value msec -detail {display each test's execution time in milliseconds (tcltest 2.5+)}
    value usec -detail {display each test's execution time in microseconds (tcltest 2.5+)}
}

values tcltest-configure-debug {
    value 0 -detail {no debug output (default)}
    value 1 -detail {report tests skipped by match/skip patterns}
    value 2 -detail {also dump tcltest variables and flags}
    value 3 -detail {also report test-harness operations}
}

values tcltest-configure-preservecore {
    value 0 -detail {do not check for core files (default)}
    value 1 -detail {notify when a core file is created}
    value 2 -detail {also save core files in -tmpdir}
}

values tcltest-test-returncodes {
    value ok -detail {TCL_OK (0)}
    value error -detail {TCL_ERROR (1)}
    value return -detail {TCL_RETURN (2)}
    value break -detail {TCL_BREAK (3)}
    value continue -detail {TCL_CONTINUE (4)}
}

values tcltest-test-match {
    value exact -detail {actual result must equal the expected result exactly}
    value glob -detail {expected result is a glob pattern (string match)}
    value regexp -detail {expected result is a regular expression}
}

values ticklecharts-chart-ticklecharts-chart-xaxis-type {
    value value -detail {Numerical axis.}
    value category -detail {Category axis.}
    value time -detail {Time axis.}
    value log -detail {Logarithmic axis.}
}

values tie-info-arg0 {
    value ties -detail {List the tokens tied to an array variable.}
    value types -detail {List the registered data-source types.}
    value type -detail {Return the class command for a data-source type.}
}

values trace-add-arg0 {
    value command -detail {Trace renames and deletions of a command.}
    value execution \
        -detail {Trace invocation of a command, and optionally every command nested inside it.}
    value variable \
        -detail {Trace reads, writes, unsets, and array operations on a variable.}
}

values trace-add-arg2 {
    value array \
        -detail {variable type: fires when the variable is accessed via the array command, while it is not (yet) a scalar.}
    value read -detail {variable type: fires whenever the variable is read.}
    value write -detail {variable type: fires whenever the variable is written.}
    value unset \
        -detail {variable type: fires whenever the variable is unset, explicitly or via procedure return.}
    value rename \
        -detail {command type: fires when the traced command is renamed to a non-empty name.}
    value delete \
        -detail {command type: fires when the traced command is deleted (including a rename to the empty string).}
    value enter -detail {execution type: fires just before the traced command runs.}
    value leave -detail {execution type: fires just after the traced command runs.}
    value enterstep \
        -detail {execution type: fires just before every command executed inside the traced procedure.}
    value leavestep \
        -detail {execution type: fires just after every command executed inside the traced procedure.}
}

values trace-variable-arg1 {
    value a -detail {array: fires when the variable is accessed via the array command.}
    value r -detail {read: fires whenever the variable is read.}
    value w -detail {write: fires whenever the variable is written.}
    value u -detail {unset: fires whenever the variable is unset.}
}

values try-arg1 {
    value on \
        -detail {on code variableList script — matches an exact completion code: ok, error, return, break, continue, or an integer.}
    value trap \
        -detail {trap pattern variableList script — matches an error whose -errorcode has pattern as a leading prefix.}
    value finally \
        -detail {finally script — always runs last, whether body succeeded, errored, or was otherwise handled.}
}

values ttk-notebook-ttk-notebook-add-state {
    value normal -detail {The tab is selectable and displayed normally.}
    value disabled -detail {The tab is displayed but cannot be selected.}
    value hidden -detail {The tab is not displayed but remains managed.}
}

values ttk-scrollbar-orient {
    value horizontal -detail {Horizontal scrollbar.}
    value vertical -detail {Vertical scrollbar.}
}

values ttk-style-element-arg0 {
    value create -detail {Create a new element.}
    value names -detail {Return a list of all registered element names.}
    value options -detail {Return the list of options for an element.}
}

values ttk-style-theme-arg0 {
    value create -detail {Create a new theme.}
    value names -detail {Return a list of available theme names.}
    value settings -detail {Evaluate a script in the context of a theme.}
    value use -detail {Set the current theme.}
}

values ttk-toggleswitch-size {
    value 1 -detail {Small switch.}
    value 2 -detail {Medium switch.}
    value 3 -detail {Large switch.}
}

values ttk-treeview-selectmode {
    value none -detail {Do not change selection through the built-in bindings.}
    value single -introduced 9.1 \
        -detail {Select one item or cell at a time, with keyboard clearing allowed.}
    value browse -detail {Select one item or cell at a time and follow pointer traversal.}
    value extended -detail {Select ranges and multiple items or cells with modifier keys.}
    value multiple -introduced 9.1 \
        -detail {Toggle multiple independent item or cell selections.}
}

values ttk-treeview-selecttype {
    value item -detail {The built-in bindings focus and select complete items.}
    value cell -detail {The built-in bindings focus and select individual cells.}
}

values unicode-normalize-arg0 {
    value D -detail {Canonical decomposition (NFD).}
    value C -detail {Canonical decomposition then composition (NFC).}
    value KD -detail {Compatibility decomposition (NFKD).}
    value KC -detail {Compatibility decomposition then composition (NFKC).}
}

values update-arg0 {
    value idletasks \
        -detail {Service only idle callbacks — no new events or errors are processed — forcing operations that are normally deferred, such as display updates and window layout calculations, to run immediately.}
}

values zlib-push-arg0 {
    value compress \
        -detail {Compressing transformation producing zlib-format data on channel, which must be writable.}
    value decompress \
        -detail {Decompressing transformation reading zlib-format data from channel, which must be readable.}
    value deflate \
        -detail {Compressing transformation producing raw compressed data (no zlib/gzip framing) on channel, which must be writable.}
    value gunzip \
        -detail {Decompressing transformation reading gzip-format data from channel, which must be readable.}
    value gzip \
        -detail {Compressing transformation producing gzip-format data on channel, which must be writable.}
    value inflate \
        -detail {Decompressing transformation reading raw compressed data (no zlib/gzip framing expected) from channel, which must be readable.}
}

values zlib-stream-arg0 {
    value compress \
        -detail {Compressing stream producing zlib-format output. Accepts -dictionary and -level.}
    value decompress \
        -detail {Decompressing stream taking zlib-format input and producing uncompressed output. Accepts -dictionary only.}
    value deflate \
        -detail {Compressing stream producing raw output; the data carries no metadata about which compression dictionary, if any, was used. Accepts -dictionary and -level.}
    value gunzip \
        -detail {Decompressing stream taking gzip-format input and producing uncompressed output. Accepts no options at all.}
    value gzip \
        -detail {Compressing stream producing gzip-format output. Accepts -header and -level (not -dictionary).}
    value inflate \
        -detail {Decompressing stream taking raw compressed input and producing uncompressed output; does not check that a supplied -dictionary is actually the correct one. Accepts -dictionary only.}
}

command ! {
    available {tcl 8.5-}
    traits {PURE OPERATOR_COMMAND}
    arity 1

