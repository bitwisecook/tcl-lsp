command flush {
    available {tcl 8.4-}
    traits BYTE_COMPILED
    arity 1

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Channel

    side_effect FileIo -writes

    runtime_backing shipped-builtin flush

    form Default {flush channelId}

    hover {
        summary {Flush buffered output for a channel.}
        synopsis {flush channelId}
        description {channelId must identify an open channel that has been opened for writing — a Tcl standard channel (stdout or stderr), the result of open or socket, or a channel created by a Tcl extension. On a blocking channel, flush does not return until all buffered output has reached the channel; on a nonblocking channel, it may return before flushing completes, with the remainder flushed in the background as fast as the underlying file or device can absorb it. Since Tcl 8.5, chan flush offers the identical functionality through the chan ensemble; from Tcl 9.0 the flush manual page itself just redirects to chan flush, though flush remains a fully supported command in every version.}
        source {Tcl flush(n)}
        example {puts -nonewline "Please type your name: "
flush stdout
gets stdin name
puts "Hello there, $name!"}
        returns {Empty string on success.}
    }
}

