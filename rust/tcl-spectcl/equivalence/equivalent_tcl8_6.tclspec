command after {
    available {tcl 8.4-}
    traits {BYTE_COMPILED DEFERS_BODY}
    arity 1..

    return_type String
    body_kind Structural
    script_lookup_scope GlobalFrame
    # TODO(spectcl): `body_execution` is set on the source spec. The DSL spells
    #   it `body_execution -native CONTRACT`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    default_form_first_word Integer

    arg_role_count_resolver -native after::arg_role_count_resolver
    arg_role_resolver_roles Body

    side_effect InterpState -writes

    runtime_backing shipped-builtin after

    form Default {after ms ?script script script ...?}

    hover {
        summary {Delay execution, or schedule a script to run later.}
        synopsis {after ms}
        synopsis {after ms ?script script script ...?}
        synopsis {after cancel id}
        synopsis {after cancel script script script ...}
        synopsis {after idle ?script script script ...?}
        synopsis {after info ?id?}
        description {With ms alone, blocks the caller for ms milliseconds; the application does not respond to events meanwhile. With one or more script arguments, returns immediately and concatenates them (as concat would) into a command scheduled to run exactly once, ms milliseconds later, as a global-level event handler outside the context of any Tcl procedure — variables referenced inside it resolve against the global namespace, not the caller's local scope. A negative ms is treated as 0 (documented from Tcl 8.6 on; the 8.4/8.5 manpages are silent on the clamp). For the scheduling form specifically, a ms of zero or negative queues the event immediately, ahead of other pending events, unless after itself runs from within an event handler, in which case it waits for the next pass through the event loop (also documented from Tcl 8.6 on). after idle schedules the same way but runs at the next idle point — the next time the event loop is entered with no other events pending — instead of after a delay. Both forms return an identifier usable with after cancel. after cancel removes a still-pending timer or idle handler, matched either by that identifier (from Tcl 9.1, also an id returned by the timer command) or by the exact concatenated script text; canceling a handler that has already fired or does not exist is a silent no-op. after info lists the ids of every handler currently pending, or, given an id, returns a two-element list of that handler's script and its type (idle or timer; from Tcl 9.1, both after- and timer-scheduled events report as timer — use timer info to tell them apart). An error raised while a deferred script runs is reported through interp bgerror (Tcl 8.5+; via the global bgerror proc directly in Tcl 8.4, which predates the interp bgerror subcommand) rather than propagating to the caller. Delayed commands only fire once the event loop is entered — vwait or update is needed to process them in a non-event-driven application such as tclsh.}
        source {Tcl after(n)}
        example {set id [after 5000 {puts "5 seconds elapsed"}]
after cancel $id

after idle {puts "runs once the event loop goes idle"}

after info}
        returns {An empty string for the blocking after ms and after cancel forms; an identifier for after ms script and after idle; a list of ids, or a two-element {script type} list, for after info.}
    }

    subcommand cancel {
        arity 1..
        detail {Cancel a previously scheduled after ms or after idle handler (from Tcl 9.1, also a timer handler), matched either by the id returned when it was scheduled or by the exact concatenated script text used to schedule it. A no-op if the handler has already run or does not exist.}
        synopsis {after cancel id|script ?script script ...?}
        traits FIRE_AND_FORGET_TEARDOWN
        return_type String
        mutator
        destructive
    }

    subcommand idle {
        arity 1..
        detail {Concatenate the script arguments (as concat would) and arrange for the result to run exactly once, the next time the event loop is entered with no other events pending. Runs at global level, outside the context of any Tcl procedure.}
        synopsis {after idle script ?script script ...?}
        return_type String
        body_kind Structural
        # TODO(spectcl): `body_execution` is set on the source spec. The DSL
        #   spells it `body_execution -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        mutator
        arg_role_count_resolver -native after::idle::arg_role_count_resolver
        arg_role_resolver_roles Body
    }

    subcommand info {
        arity ..1
        detail {Without an id, return a list of the ids of every pending after/idle handler. With an id, return a two-element list of the handler's script and its type, idle or timer (from Tcl 9.1, both after- and timer-command handlers report as timer; use timer info to distinguish them).}
        synopsis {after info ?id?}
        return_type List
        pure
        side_effect InterpState -reads
    }
}

command append {
    available {tcl 8.4-} {f5-irules}
    traits {READS_BEFORE_WRITE UNCONDITIONAL_VARIABLE_WRITE BYTE_COMPILED FRAMELESS_RUNTIME FIRST_ARG_VARNAME}
    arity 1..
    safe_on_uninit {all-tcl f5-irules}

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    # TODO(spectcl): `form_value_effects` is set on the source spec. The DSL
    #   spells it `refine NAME
    #   {return_type|arg_types|byte_array_effect|var_elements_effect|safe_on_uninit
    #   OVERRIDE}`, but a pack may not author this field.
    byte_array_effect Coerces
    arg 0 -role VarWrite -type String -shimmers
    assigns_variable_at 0

    lowering_hook -native AppendOrLappend
    codegen_hook -native Append
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -reads -writes

    runtime_backing shipped-builtin append

    form Default {append varName ?value value value ...?}

    hover {
        summary {Append values to a variable, creating it if it does not already exist.}
        synopsis {append varName ?value value value ...?}
        description {Append all of the value arguments to the current value of variable varName. If varName does not exist and values are supplied, it is created with their concatenation. With no value arguments, append reads the existing variable and reports an error if it is missing. This is an efficient way to build up a long string incrementally: `append a $b` is much cheaper than `set a $a$b` once $a is already long. From Tcl 9.0, appending to a nonexistent element of an array that has a default value set (see `array default`) stores the concatenation of that default value and the value arguments, rather than just the value arguments.}
        source {Tcl man page append.n}
        example {set msg "Tcl"
append msg " is " "fun"

set out {}
foreach n {1 2 3 4 5} {
    append out $n ","
}
# out is now "1,2,3,4,5,"}
        returns {The new value stored in varName after the append.}
    }

    refine read {
        arity 1
        arg 0 -role VarRead
        traits {FRAMELESS_RUNTIME FIRST_ARG_VARNAME}
        side_effect Variable -reads
    }
}

command apply {
    available {tcl 8.5-}
    traits {LANGUAGE_KEYWORD TAINT_SINK BYTE_COMPILED NOT_PROC_FACTORY DYNAMIC_EVAL_BODY}
    arity 1..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role LambdaLiteral

    lowering_hook -native Apply
    analyser_hook -native Apply

    side_effect Unknown

    taint_code_sink_args {0}

    runtime_backing shipped-builtin apply

    form Default {apply func ?arg1 arg2 ...?}

    hover {
        summary {Invoke an anonymous function with the given arguments.}
        synopsis {apply func ?arg1 arg2 ...?}
        description {func is a two- or three-element list {args body ?namespace?}: args is a formal parameter list in the same form proc accepts (including a trailing args catch-all and default values), body is the script to run, and the optional namespace names the namespace the body's commands and variables resolve in (the global namespace when omitted). Each call builds a fresh, unnamed procedure, applies it to arg1 arg2 ..., and discards it afterwards — the formal parameters become local variables in a new call frame, so the body cannot see or modify the caller's locals without global, variable, or upvar. Raises an error if func is not a valid 2- or 3-element list.}
        source {Tcl apply(n)}
        example {set square {{x} {expr {$x * $x}}}
apply $square 5
apply {{a b {suffix ""}} {return "$a$b$suffix"}} foo bar}
        returns {The result of evaluating the function body.}
    }
}

command argparse {
    available {tcl 8.4-}
    arity 1..
    required_package argparse

    side_effect InterpState -writes
    # TODO(spectcl): `frame_effect` is set on the source spec. The DSL spells it
    #   `frame_effect -level-word W -layout L`, but a draft records only that
    #   the field is set, never the expression that set it.

    option -inline -detail {Return a result dict instead of setting caller variables.}
    option -exact -detail {Require exact switch names; disable prefix matching.}
    option -mixed -detail {Allow switches to appear after parameters.}
    option -long -detail {Accept a double-dash (`--switch`) spelling for each switch.}
    option -equalarg -detail {Accept `-switch=value` in addition to `-switch value`.}
    option -normalize -detail {Normalise switch spellings and omitted switches in output.}
    option -reciprocal -detail {Make each `-require` relationship symmetric.}
    option -boolean -detail {Treat every switch as boolean (no argument).}
    option -keep -detail {Do not unset caller variables for omitted switches/parameters.}
    option -pfirst -detail {Require parameters to precede switches.}
    option -helpret -detail {Return the help text instead of raising it as an error.}
    option -level -takes level \
        -detail {Frame level at which caller variables are set (default 1).}
    option -template -takes template \
        -detail {Template substituted into each output key name.}
    option -pass -takes name -detail {Collect unrecognised arguments into the named key.}
    option -validate -takes dict -detail {Named validation expressions shared by elements.}
    option -enum -takes dict -detail {Named enumeration lists shared by elements.}
    option -help -takes text -detail {Overall help text for the generated help message.}
    option -helplevel -takes level \
        -detail {Frame level used when generating the help message.}
    option -- \
        -detail {Marks the end of global switches; the next argument is the definition.}

    form Default {argparse ?switch ...? ?--? definition ?arguments?}

    hover {
        summary {Parse and validate switches and parameters from an argument list.}
        synopsis {argparse ?switch ...? ?--? definition ?arguments?}
        description {Processes an argument definition list, then reads the caller's `args` (or an explicit argument list) against it, setting a variable (or building an `-inline` dict) for each recognised switch and parameter.}
        source {argparse package (argparse.n)}
    }
}

command array {
    available {tcl 8.4-} {f5-irules}
    traits {BYTE_COMPILED NOT_PROC_FACTORY WHOLE_ARRAY_ARG}
    arity 1..

    inferred_storage_type Array
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    codegen_hook -native Array
    inline_codegen_hook -native Array

    side_effect Variable -reads -writes

    runtime_backing shipped-builtin array

    form Default {array option arrayName ?arg arg ...?}

    hover {
        summary {Manipulate array variables.}
        synopsis {array option arrayName ?arg arg ...?}
        description {Dispatches on option to one of anymore, default (Tcl 9.0+), donesearch, exists, for (Tcl 9.0+), get, names, nextelement, set, size, startsearch, statistics, or unset. Unless a subcommand says otherwise, arrayName must already be an array variable; exists, get, names, size, and unset instead tolerate a missing or non-array arrayName, returning 0, an empty list/string, or false rather than raising an error. array set merges an even-sized key/value list into arrayName, creating it if it does not already exist. array unset removes the elements matching pattern, or the entire array when pattern is omitted; it never raises an error, even when arrayName does not exist. startsearch/anymore/nextelement/donesearch step through elements one at a time via an opaque search identifier; modifying the array while a search is active invalidates that search. array default (9.0+) configures a value returned in place of an error when reading a missing element, and array for (9.0+) iterates {keyVariable valueVariable} pairs directly, without the intermediate list array names or array get would build.}
        source {Tcl array(n)}
        example {array set fruit {apple 3 banana 5 cherry 12}
foreach name [lsort [array names fruit]] {
    puts "$name: $fruit($name)"
}
if {[array exists fruit]} {
    puts "count: [array size fruit]"
}
array unset fruit banana}
        returns {Depends on the subcommand: a boolean (exists, anymore, default exists), a decimal count (size), a list (get, names), an element name or empty string (nextelement), a search identifier (startsearch), free-form statistics text (statistics), the current default value (default get), or an empty string (set, unset, donesearch, default set/unset, for).}
    }

    subcommand anymore {
        arity 2
        detail {Returns 1 if there are any more elements left to be processed in an array search, 0 if all elements have already been returned.}
        synopsis {array anymore arrayName searchId}
        available {tcl 8.4-}
        return_type Boolean
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 0 -role VarRead
        side_effect Variable -reads
    }

    subcommand default {
        arity 2..3
        detail {Manages the default value of the array.}
        synopsis {array default subcommand arrayName args...}
        available {tcl 9.0-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        mutator
        arg_values_accept_prefix
        arg 1 -role VarWrite
        arg 0 -values-from array-default-arg0 -closed
        side_effect Variable -reads -writes
    }

    subcommand donesearch {
        arity 2
        detail {Terminates an array search and destroys all the state associated with that search.}
        synopsis {array donesearch arrayName searchId}
        available {tcl 8.4-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 0 -role VarRead
        side_effect Variable -reads
    }

    subcommand exists {
        arity 1
        detail {Returns 1 if arrayName is an array variable, 0 if there is no variable by that name or if it is a scalar variable.}
        synopsis {array exists arrayName}
        return_type Boolean
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        variable_receivers {0}
        arg 0 -role VarRead
        semantic_operation {Intrinsic ArrayExists}
        side_effect Variable -reads
    }

    subcommand for {
        arity 3
        detail {Iterates over array entries. The first argument is a two-element list of variable names for the key and value of each entry.}
        synopsis {array for {keyVariable valueVariable} arrayName body}
        traits {CONTROL_FLOW HAS_LOOP_BODY}
        available {tcl 9.0-}
        return_type String
        # TODO(spectcl): `body_execution` is set on the source spec. The DSL
        #   spells it `body_execution -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
        #   spells it `successful_handler -native
        #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
        #   -direct-provider
        #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
        #   but a pack may not author this field.
        loop_list_header
        arg 0 -role LoopVarList
        arg 1 -role VarRead
        arg 2 -role Body

        clause_grammar {
            head {LoopVarList Value} -timing per-iteration
            tail Body -timing per-iteration
            selection all
        } -available {tcl 9.0-}
        lowering_hook -native ArrayFor
        side_effect Variable -reads
    }

    subcommand get {
        arity 1..2
        detail {Returns a list containing pairs of elements.}
        synopsis {array get arrayName ?pattern?}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        variable_receivers {0}
        arg 0 -role VarRead
        side_effect Variable -reads
    }

    subcommand names {
        arity 1..3
        detail {Returns a list containing the names of all of the elements in the array that match pattern.}
        synopsis {array names arrayName ?mode? ?pattern?}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        variable_receivers {0}
        arg 0 -role VarRead
        arg 1 -values-from array-names-arg1
        semantic_operation {Intrinsic ArrayNames}
        side_effect Variable -reads
    }

    subcommand nextelement {
        arity 2
        detail {Returns the name of the next element in arrayName, or an empty string if all elements have already been returned in this search.}
        synopsis {array nextelement arrayName searchId}
        available {tcl 8.4-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 0 -role VarRead
        side_effect Variable -reads
    }

    subcommand set {
        arity 2
        detail {Sets the values of one or more elements in arrayName.}
        synopsis {array set arrayName list}
        return_type String
        # TODO(spectcl): `var_elements_effect` is set on the source spec and has
        #   no DSL spelling.
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
        #   spells it `successful_handler -native
        #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
        #   -direct-provider
        #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
        #   but a pack may not author this field.
        variable_receivers {0}
        mutator
        arg 0 -role VarWrite
        codegen_hook -native ArraySet -introduced 8.6
        side_effect Variable -writes
    }

    subcommand size {
        arity 1
        detail {Returns a decimal string giving the number of elements in the array.}
        synopsis {array size arrayName}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 0 -role VarRead
        semantic_operation {Intrinsic ArraySize}
        side_effect Variable -reads
    }

    subcommand startsearch {
        arity 1
        detail {Initializes an element-by-element search through the array given by arrayName.}
        synopsis {array startsearch arrayName}
        available {tcl 8.4-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 0 -role VarRead
        side_effect Variable -reads
    }

    subcommand statistics {
        arity 1
        detail {Returns statistics about the distribution of data within the hashtable that represents the array.}
        synopsis {array statistics arrayName}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 0 -role VarRead
        side_effect Variable -reads
    }

    subcommand unset {
        arity 1..2
        detail {Unsets all of the elements in the array that match pattern.}
        synopsis {array unset arrayName ?pattern?}
        traits {DESTROYS_VARIABLE CONDITIONAL_VARIABLE_WRITE FIRE_AND_FORGET_TEARDOWN}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        variable_receivers {0}
        mutator
        destructive
        arg 0 -role VarWrite
        codegen_hook -native ArrayUnset -introduced 8.6
        side_effect Variable -writes
    }
}

