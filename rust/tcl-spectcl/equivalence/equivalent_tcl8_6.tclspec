command label {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class label -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }
    }

    option -text -takes {} -detail {Text string to be displayed in the label.}
    option -textangle -takes degrees -introduced 9.1 \
        -detail {Anticlockwise rotation of the displayed text in degrees (Tk 9.1+).}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Name of a variable whose value will be used as the label text.}
    option -image -takes {} -detail {Image to display in the label.}
    option -bitmap -takes {} -detail {Bitmap to display in the label.}
    option -compound -takes {} \
        -detail {Whether to display both image and text: none, bottom, top, left, right, or center.}
    option -width -takes {} \
        -detail {Desired width of the label in characters (text) or pixels (image).}
    option -height -takes {} \
        -detail {Desired height of the label in lines (text) or pixels (image).}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {How information is positioned: n, ne, e, se, s, sw, w, nw, or center.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of multi-line text: left, center, or right.}
    option -wraplength -takes {} \
        -detail {Maximum line length for word wrapping, in screen units.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -font -takes {} -detail {Font to use for the label text.}
    option -padx -takes {} -detail {Extra horizontal padding inside the label.}
    option -pady -takes {} -detail {Extra vertical padding inside the label.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the label.}
    option -takefocus -takes {} \
        -detail {Whether the label accepts focus during keyboard traversal.}
    option -underline -takes {} \
        -detail {Index of character to underline for keyboard traversal (0-based).}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the label does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the label has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the label.}
    option -activebackground -takes color \
        -detail {Background colour while the label is active.}
    option -disabledforeground -takes color \
        -detail {Foreground colour while disabled; empty uses a dimmed normal foreground.}
    option -activeforeground -takes color \
        -detail {Foreground colour while the label is active.}
    option -state -takes stateSpec -detail {Display state: normal, active, or disabled.}

    form Default {label pathName ?option value ...?}

    hover {
        summary {Create and manipulate a label widget.}
        synopsis {label pathName ?option value ...?}
        description {Displays a textual string, bitmap, or image. A label is a non-interactive widget.}
        source {Tk man page label.n}
    }
}

