    option -validatecommand -takes {} -role Body -body-kind Structural -script-timing Deferred -callback-taint-inputs {%P %s %S} \
        -detail {Script to evaluate when validation is triggered.}
    option -invalidcommand -takes {} -role Body -body-kind Structural -script-timing Deferred -callback-taint-inputs {%P %s %S} \
        -detail {Script to evaluate when validation fails.}
    option -font -takes {} -detail {Font to use for text in the spinbox.}
