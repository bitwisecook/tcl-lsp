    side_effect Unknown -reads -writes

    option -mode -takes mode -values-from aes-aes-mode -closed \
        -detail {Cipher mode of operation (default cbc).}
    option -dir -takes direction -values-from des-des-dir -closed \
        -detail {Whether to encrypt or decrypt (default encrypt).}
    option -key -takes keydata -detail {The variable-length binary key (required).}
    option -iv -takes vector -detail {The 8-byte initialisation vector for CBC mode.}
    option -hex -detail {Return the result as a hexadecimal string.}
    option -in -takes channel -role Channel -detail {Read the input data from a channel.}
    option -out -takes channel -role Channel -detail {Write the result to a channel.}

    hover {
        summary {Encrypt or decrypt data with the Blowfish block cipher.}
        synopsis {blowfish::blowfish ?-mode [ecb|cbc]? ?-dir [encrypt|decrypt]? -key keydata ?-iv vector? ?-hex? ?-out channel? ?-in channel | ?--? data?}
        source {tcllib block-cipher package}
        returns {The transformed data (binary, or hex with -hex).}
    }
}

command break {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD NEEDS_START_CMD BYTE_COMPILED FRAMELESS_RUNTIME TRANSFERS_CONTROL BREAKS_LOOP}
    arity 0

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    inline_codegen_hook -native Break
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin break

    form Default {break}

    hover {
        summary {Abort execution of the innermost enclosing loop.}
        synopsis {break}
        description {Typically invoked inside the body of a looping command such as for, foreach, or while. It raises a TCL_BREAK exception that aborts the current script out to the innermost containing loop, which then stops iterating and returns normally — execution resumes with the statement after the loop. The exception is also handled by catch, Tk event bindings, and the outermost script of a procedure body. Used anywhere else — outside a loop, catch, Tk binding, or a procedure's top level — it is an error: invoked "break" outside of a loop.}
        source {Tcl man page break.n}
        example {for {set i 0} {$i < 10} {incr i} {
    if {$i == 5} {
        break
    }
    puts $i
}}
        returns {None in normal use — control transfers to just past the innermost enclosing loop. Trapped with catch, the caught value is an empty string.}
    }
}

command button {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class button -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method flash {
            arity 0
            detail {Flash the button using its active and normal colours.}
            synopsis {pathName flash}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method invoke {
            arity 0
            detail {Invoke the button's associated command unless the button is disabled.}
            synopsis {pathName invoke}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }
    }

    option -text -takes {} -detail {Text to display in the button.}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Name of a variable whose value will be used as the button text.}
    option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
        -detail {Tcl command to invoke when the button is pressed.}
    option -state -takes {} -detail {State of the button: normal, active, or disabled.}
    option -width -takes {} \
        -detail {Desired width of the button in characters (text) or pixels (image).}
    option -height -takes {} \
        -detail {Desired height of the button in lines (text) or pixels (image).}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -background -takes {} -detail {Normal background colour of the button.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -foreground -takes {} -detail {Normal foreground colour of the button.}
    option -font -takes {} -detail {Font to use for the button text.}
    option -image -takes {} -detail {Image to display in the button.}
    option -bitmap -takes {} -detail {Bitmap to display in the button.}
    option -compound -takes {} \
        -detail {Whether to display both image and text: none, bottom, top, left, right, or center.}
    option -padx -takes {} -detail {Extra horizontal padding inside the button.}
    option -pady -takes {} -detail {Extra vertical padding inside the button.}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {How information is positioned: n, ne, e, se, s, sw, w, nw, or center.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of multi-line text: left, center, or right.}
    option -wraplength -takes {} \
        -detail {Maximum line length for word wrapping, in screen units.}
    option -underline -takes {} \
        -detail {Index of character to underline for keyboard traversal (0-based).}
    option -activebackground -takes {} \
        -detail {Background colour when the button is active (mouse over).}
    option -activeforeground -takes {} \
        -detail {Foreground colour when the button is active.}
    option -disabledforeground -takes {} \
        -detail {Foreground colour when the button is disabled.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the button does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the button has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the button.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the button.}
    option -takefocus -takes {} \
        -detail {Whether the button accepts focus during keyboard traversal.}
    option -repeatdelay -takes {} \
        -detail {Milliseconds before auto-repeat begins when button is held.}
    option -repeatinterval -takes {} -detail {Milliseconds between auto-repeat invocations.}
    option -overrelief -takes {} \
        -detail {Relief to use when the mouse cursor is over the button.}
    option -default -takes {} -detail {Default ring state: normal, active, or disabled.}

    form Default {button pathName ?option value ...?}

    hover {
        summary {Create and manipulate a button widget.}
        synopsis {button pathName ?option value ...?}
        description {Displays a textual string, bitmap, or image. When pressed, invokes a Tcl command.}
        source {Tk man page button.n}
    }
}

command canvas {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class canvas -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method addtag {
            arity 2..
            detail {Add a tag to items matching a search specification.}
            synopsis {pathName addtag tag searchCommand ?arg ...?}
        }

        method bbox {
            arity 1..
            detail {Return the bounding box of the items given by the tagOrIds.}
            synopsis {pathName bbox tagOrId ?tagOrId ...?}
        }

        method bind {
            arity 1..3
            detail {Associate a command with a canvas item event.}
            synopsis {pathName bind tagOrId ?sequence? ?command?}
            traits DEFERS_BODY
            body_kind Structural
            arg 2 -role Body
            callback_taint_inputs {{2 %A}}
        }

        method canvasx {
            arity 1..2
            detail {Convert a window x-coordinate to a canvas x-coordinate.}
            synopsis {pathName canvasx screenx ?gridspacing?}
        }

        method canvasy {
            arity 1..2
            detail {Convert a window y-coordinate to a canvas y-coordinate.}
            synopsis {pathName canvasy screeny ?gridspacing?}
        }

        method coords { arity 1.. ; detail {Query or set the coordinates of an item.} ; synopsis {pathName coords tagOrId ?x y ...?} }

        method create {
            arity 3..
            detail {Create a new canvas item of the specified type.}
            synopsis {pathName create type x y ?x y ...? ?option value ...?}
        }

        method dchars {
            arity 2..
            detail {Delete characters between the first and last positions in a text or line item.}
            synopsis {pathName dchars tagOrId first ?last?}
        }

        method delete { detail {Delete the items given by each tagOrId.} ; synopsis {pathName delete ?tagOrId ...?} }
        method dtag { arity 1..2 ; detail {Remove a tag from the items given by tagOrId.} ; synopsis {pathName dtag tagOrId ?tagToDelete?} }
        method find { arity 1.. ; detail {Return item IDs matching a search specification.} ; synopsis {pathName find searchCommand ?arg ...?} }
        method focus { arity ..1 ; detail {Set or query the focus item for the canvas.} ; synopsis {pathName focus ?tagOrId?} }
        method gettags { arity 1 ; detail {Return the tags associated with the item.} ; synopsis {pathName gettags tagOrId} }

        method icursor {
            arity 2
            detail {Set the insertion cursor of a text, line, or polygon item just before the given index.}
            synopsis {pathName icursor tagOrId index}
        }

        method index {
            arity 2
            detail {Return the numerical index within an item corresponding to the given index.}
            synopsis {pathName index tagOrId index}
        }

        method insert {
            arity 3
            detail {Insert a string into a text, line, or polygon item before the given index.}
            synopsis {pathName insert tagOrId beforeThis string}
        }

        method itemcget {
            arity 2
            detail {Return the value of a configuration option for a canvas item.}
            synopsis {pathName itemcget tagOrId option}
        }

        method itemconfigure {
            arity 1..
            detail {Query or modify configuration options of a canvas item.}
            synopsis {pathName itemconfigure tagOrId ?option? ?value option value ...?}
        }

        method lower {
            arity 1..2
            detail {Lower the items given by tagOrId in the display list.}
            synopsis {pathName lower tagOrId ?belowThis?}
        }

        method move { arity 3 ; detail {Move each item by the given distance.} ; synopsis {pathName move tagOrId xAmount yAmount} }

        method moveto {
            arity 3
            detail {Move the items so their top-left corner is at the given position.}
            synopsis {pathName moveto tagOrId x y}
        }

        method postscript { detail {Generate a Postscript representation of the canvas.} ; synopsis {pathName postscript ?option value ...?} }

        method raise {
            arity 1..2
            detail {Raise the items given by tagOrId in the display list.}
            synopsis {pathName raise tagOrId ?aboveThis?}
        }

        method rchars {
            arity 4
            detail {Replace the characters between first and last in a text or line item with the given string.}
            synopsis {pathName rchars tagOrId first last string}
        }

        method scale { arity 5 ; detail {Rescale the coordinates of items.} ; synopsis {pathName scale tagOrId xOrigin yOrigin xScale yScale} }

        method scan {
            arity 1..
            detail {Implement scanning for the canvas.}
            synopsis {pathName scan option args}
            mutator
            side_effect InterpState -reads -writes
        }

        method select {
            arity 1..
            detail {Manipulate the selection in text, line, or polygon items.}
            synopsis {pathName select option ?tagOrId arg?}
            mutator

            refine item {
                arity 1
                selector item
                traits PURE
                mutator no
                side_effect InterpState -reads
            }
            side_effect InterpState -reads -writes
        }

        method type { arity 1 ; detail {Return the type of the item given by tagOrId.} ; synopsis {pathName type tagOrId} }

        method xview {
            detail {Query or change the horizontal view position.}
            synopsis {pathName xview ?args?}
            mutator

            refine query {
                arity 0
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine move {
                arity 1..
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
            side_effect InterpState -reads -writes
        }

        method yview {
            detail {Query or change the vertical view position.}
            synopsis {pathName yview ?args?}
            mutator

            refine query {
                arity 0
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine move {
                arity 1..
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
            side_effect InterpState -reads -writes
        }
    }

    option -width -takes {} -detail {Desired width of the canvas in screen units.}
    option -height -takes {} -detail {Desired height of the canvas in screen units.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -background -takes {} -detail {Background colour of the canvas.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -borderwidth -takes {} -detail {Width of the border around the canvas.}
    option -bd -takes {} -detail {Shorthand for -borderwidth.}
    option -scrollregion -takes {} \
        -detail {Bounding box of the total scrollable area (left top right bottom).}
    option -xscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for communicating with horizontal scrollbars.}
    option -yscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for communicating with vertical scrollbars.}
    option -xscrollincrement -takes {} \
        -detail {Horizontal scrolling increment in screen units.}
    option -yscrollincrement -takes {} \
        -detail {Vertical scrolling increment in screen units.}
    option -confine -takes {} -detail {Whether scrolling is confined to the scroll region.}
    option -selectbackground -takes {} -detail {Background colour for selected items.}
    option -selectborderwidth -takes {} -detail {Width of the border around selected items.}
    option -selectforeground -takes {} -detail {Foreground colour for selected items.}
    option -insertbackground -takes {} -detail {Colour of the insertion cursor.}
    option -insertborderwidth -takes {} \
        -detail {Width of the border around the insertion cursor.}
    option -insertofftime -takes {} \
        -detail {Milliseconds the insertion cursor is off during blinking.}
    option -insertontime -takes {} \
        -detail {Milliseconds the insertion cursor is on during blinking.}
    option -insertwidth -takes {} -detail {Width of the insertion cursor in screen units.}
    option -closeenough -takes {} \
        -detail {Proximity threshold for mouse cursor to be considered over an item.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the canvas.}
    option -takefocus -takes {} \
        -detail {Whether the canvas accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the canvas does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the canvas has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the canvas.}
    option -state -takes stateSpec \
        -detail {Modifies the default state of the canvas where state may be set to one of: normal, disabled, or hidden.}

    form Default {canvas pathName ?option value ...?}

    hover {
        summary {Create and manipulate a canvas widget.}
        synopsis {canvas pathName ?option value ...?}
        description {Displays a rectangular area for drawing graphics, positioning widgets, and handling events on items.}
        source {Tk man page canvas.n}
    }

    subcommand cget {
        arity 1
        detail {Return the current value of a widget option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change widget options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand addtag {
        arity 2..
        detail {Add a tag to items matching a search specification.}
        synopsis {pathName addtag tag searchCommand ?arg ...?}
    }

    subcommand bbox {
        arity 1..
        detail {Return the bounding box of the items given by the tagOrIds.}
        synopsis {pathName bbox tagOrId ?tagOrId ...?}
    }

    subcommand bind {
        arity 1..3
        detail {Associate a command with a canvas item event.}
        synopsis {pathName bind tagOrId ?sequence? ?command?}
        traits DEFERS_BODY
        body_kind Structural
        arg 2 -role Body
        callback_taint_inputs {{2 %A}}
    }

    subcommand canvasx {
        arity 1..2
        detail {Convert a window x-coordinate to a canvas x-coordinate.}
        synopsis {pathName canvasx screenx ?gridspacing?}
    }

    subcommand canvasy {
        arity 1..2
        detail {Convert a window y-coordinate to a canvas y-coordinate.}
        synopsis {pathName canvasy screeny ?gridspacing?}
    }

    subcommand coords { arity 1.. ; detail {Query or set the coordinates of an item.} ; synopsis {pathName coords tagOrId ?x y ...?} }

    subcommand create {
        arity 3..
        detail {Create a new canvas item of the specified type.}
        synopsis {pathName create type x y ?x y ...? ?option value ...?}
    }

    subcommand dchars {
        arity 2..
        detail {Delete characters between the first and last positions in a text or line item.}
        synopsis {pathName dchars tagOrId first ?last?}
    }

    subcommand delete { detail {Delete the items given by each tagOrId.} ; synopsis {pathName delete ?tagOrId ...?} }
    subcommand dtag { arity 1..2 ; detail {Remove a tag from the items given by tagOrId.} ; synopsis {pathName dtag tagOrId ?tagToDelete?} }
    subcommand find { arity 1.. ; detail {Return item IDs matching a search specification.} ; synopsis {pathName find searchCommand ?arg ...?} }
    subcommand focus { arity ..1 ; detail {Set or query the focus item for the canvas.} ; synopsis {pathName focus ?tagOrId?} }
    subcommand gettags { arity 1 ; detail {Return the tags associated with the item.} ; synopsis {pathName gettags tagOrId} }

    subcommand icursor {
        arity 2
        detail {Set the insertion cursor of a text, line, or polygon item just before the given index.}
        synopsis {pathName icursor tagOrId index}
    }

    subcommand index {
        arity 2
        detail {Return the numerical index within an item corresponding to the given index.}
        synopsis {pathName index tagOrId index}
    }

    subcommand insert {
        arity 3
        detail {Insert a string into a text, line, or polygon item before the given index.}
        synopsis {pathName insert tagOrId beforeThis string}
    }

    subcommand itemcget {
        arity 2
        detail {Return the value of a configuration option for a canvas item.}
        synopsis {pathName itemcget tagOrId option}
    }

    subcommand itemconfigure {
        arity 1..
        detail {Query or modify configuration options of a canvas item.}
        synopsis {pathName itemconfigure tagOrId ?option? ?value option value ...?}
    }

    subcommand lower {
        arity 1..2
        detail {Lower the items given by tagOrId in the display list.}
        synopsis {pathName lower tagOrId ?belowThis?}
    }

    subcommand move { arity 3 ; detail {Move each item by the given distance.} ; synopsis {pathName move tagOrId xAmount yAmount} }

    subcommand moveto {
        arity 3
        detail {Move the items so their top-left corner is at the given position.}
        synopsis {pathName moveto tagOrId x y}
    }

    subcommand postscript { detail {Generate a Postscript representation of the canvas.} ; synopsis {pathName postscript ?option value ...?} }

    subcommand raise {
        arity 1..2
        detail {Raise the items given by tagOrId in the display list.}
        synopsis {pathName raise tagOrId ?aboveThis?}
    }

    subcommand rchars {
        arity 4
        detail {Replace the characters between first and last in a text or line item with the given string.}
        synopsis {pathName rchars tagOrId first last string}
    }

    subcommand scale { arity 5 ; detail {Rescale the coordinates of items.} ; synopsis {pathName scale tagOrId xOrigin yOrigin xScale yScale} }

    subcommand scan {
        arity 1..
        detail {Implement scanning for the canvas.}
        synopsis {pathName scan option args}
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand select {
        arity 1..
        detail {Manipulate the selection in text, line, or polygon items.}
        synopsis {pathName select option ?tagOrId arg?}
        mutator

        refine item {
            arity 1
            selector item
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }

    subcommand type { arity 1 ; detail {Return the type of the item given by tagOrId.} ; synopsis {pathName type tagOrId} }

    subcommand xview {
        detail {Query or change the horizontal view position.}
        synopsis {pathName xview ?args?}
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }

    subcommand yview {
        detail {Query or change the vertical view position.}
        synopsis {pathName yview ?args?}
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }
}

command case {
    available {tcl 8.4-9.0} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD NEVER_INLINE_BODY NOT_PROC_FACTORY}
    arity 2..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    arg_role_resolver -native case::arg_role_resolver
    arg_role_resolver_roles Body
    lowering_hook -native Switch
    analyser_hook -native Switch

    side_effect Unknown -reads -writes

    deprecated_replacement switch

    # TODO(spectcl): `case_list` is set on the source spec. The DSL spells it
    #   `case_list NAME|{ … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    form Default {case string ?in? patList body ?patList body ...?}
    form Default {case string ?in? {patList body ?patList body ...?}}

    hover {
        summary {Obsolete glob-pattern branching — use `switch` instead.}
        synopsis {case string ?in? patList body ?patList body ...?}
        synopsis {case string ?in? {patList body ?patList body ...?}}
        description {Matches string against each patList in turn and evaluates the body of the first one that matches, returning that body's result. Each patList is a single pattern or a list of patterns, and each pattern may use the wild-cards `string match` accepts. A patList of `default` matches unconditionally; with no match and no default, `case` returns the empty string. The patterns and bodies may be given as separate words, where substitutions apply normally, or grouped into one braced argument, which is convenient for multi-line commands but performs no command or variable substitution on the patterns — so the two forms can behave differently. An optional literal `in` may follow string. `case` is obsolete: it has been supported only for backward compatibility since Tcl 7.0 and was removed in Tcl 9.0. `switch` replaces it, but not as a plain rename — `switch` has no `in` word and takes `-exact`/`-glob`/`-regexp`/`--` options, so a subject that can begin with `-` needs `--` and glob matching needs `-glob`.}
        source {Tcl case(n)}
        example {case $x in {a  {puts one}  b  {puts two}}

case $x {
    a       { puts one }
    b       { puts two }
    default { puts other }
}

# The Tcl 8.5+/9.x replacement
switch -glob -- $x {
    a       { puts one }
    b       { puts two }
    default { puts other }
}}
        returns {The result of the matched body, or an empty string when no patList matches and there is no default clause.}
    }
}

command cat {
    available {tcl 8.5-}
    arity 1
    required_package nettool
    tcllib_package nettool

    hover {
        summary {Dump the contents of a file as a result.}
        synopsis {cat filename}
        source {tcllib package}
    }
}

command catch {
    available {tcl 8.4-} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD UNCONDITIONAL_VARIABLE_WRITE BYTE_COMPILED NOT_PROC_FACTORY}
    arity 1..3
    arity 1..2 -retired 8.5
    arity 1..3 -introduced 8.5

    return_type Int
    var_write_typing Destructured
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Body
    arg 1 -role VarWrite
    arg 2 -role VarWrite

    clause_grammar {
        head Body -timing protected
        tail {{LoopVarList optional} {LoopVarList optional}}
        selection all
    }

    lowering_hook -native Catch
    inline_codegen_hook -native Catch
    analyser_hook -native Catch

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin catch

    form Default {catch script ?resultVarName? ?optionsVarName?} -available {tcl 8.5-}
    form Default {catch script ?varName?} -available {{tcl 8.4} {f5-irules}}

    hover {
        summary {Evaluate script and trap exceptional returns}
        synopsis {catch script ?resultVarName? ?optionsVarName?}
        description {Evaluates script in the caller's own variable scope and always completes normally, even when script raises an error — a single unguarded error never aborts the surrounding script. The integer catch returns is script's completion code: 0 (TCL_OK) for normal completion, 1 (TCL_ERROR) for an error, 2 (TCL_RETURN) if script executed return, 3 (TCL_BREAK) for break, 4 (TCL_CONTINUE) for continue, or a larger custom code set via `return -code`. When resultVarName is given, it is set to script's result on success or to the error message on failure. From Tcl 8.5, an optional third word, optionsVarName, receives a dict of the return options: -code and -level are always present, and on an error -errorinfo, -errorcode, and -errorline are added too — joined by -errorstack from Tcl 8.6 onward. Tcl 8.4's catch takes only the single result variable (there named varName) and has no options dict; iRules' embedded Tcl 8.4.6 runtime follows that same two-argument form. Only run-time errors are trapped: a syntax error Tcl finds while compiling script itself (e.g. unmatched braces) is not caught.}
        source {Tcl man page catch.n}
        example {if {[catch {open $someFile w} fid]} {
    puts stderr "Could not open $someFile for writing\n$fid"
    exit 1
}
if {[catch {expr {1 / 0}} result options]} {
    puts "error: $result (code [dict get $options -code])"
}}
        returns {An integer completion code — 0 (TCL_OK) through 4 (TCL_CONTINUE) for the standard completion codes, or a larger custom code set via `return -code`.}
    }
}

command cd {
    available {tcl 8.4-}
    traits {TAINT_SINK BYTE_COMPILED SAFE_INTERP_HIDDEN}
    arity ..1

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect FileIo -writes
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin cd

    form Default {cd ?dirName?}

    hover {
        summary {Change the process's current working directory.}
        synopsis {cd ?dirName?}
        description {Changes the current working directory to dirName, or to the user's home directory (as given by the HOME environment variable) when dirName is omitted; returns the empty string. The working directory is a per-process resource: the change is visible to every interpreter and, in a threaded build, every thread, not just the one that called cd. Errors if dirName does not exist, is not a directory, or cannot be entered. Through Tcl 8.6, a dirName beginning with ~ underwent automatic tilde substitution to a home directory (e.g. cd ~fred); Tcl 9.0 removed this implicit tilde substitution from file-name processing, so a ~ path must now be expanded explicitly first, e.g. with `file home` or `file tildeexpand`.}
        source {Tcl cd(n)}
        example {cd /var/log
cd ..
cd ~fred              ;# Tcl 8.4-8.6: ~ expands automatically
cd [file home fred]    ;# Tcl 9.0+: ~ is no longer expanded implicitly}
        returns {The empty string.}
    }
}

command chan {
    available {tcl 8.5-}
    traits BYTE_COMPILED
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect FileIo -reads -writes

    runtime_backing shipped-builtin chan

    option -blocking -takes boolean -role Boolean -detail {Set blocking mode.}
    option -buffering -takes mode -detail {Set buffering mode (full, line, none).}
    option -buffersize -takes size -detail {Set buffer size in bytes.}
    option -encoding -takes encoding -detail {Set character encoding.}
    option -eofchar -takes chars -detail {Set end-of-file character(s).}
    option -profile -takes profile -available {tcl 9.0-} \
        -detail {Set encoding profile (strict, tcl8, replace).}
    option -translation -takes mode -detail {Set line-ending translation mode.}

    form Default {chan subcommand ?arg ...?}

    hover {
        summary {Read, write and manipulate channels.}
        synopsis {chan subcommand ?arg ...?}
        description {Unified interface for channel operations (blocked, close, configure, copy, create, eof, event, flush, gets, names, pending, pipe, pop, postevent, push, puts, read, seek, tell, truncate, isbinary), superseding the older standalone close/eof/fconfigure/fcopy/fileevent/flush/gets/puts/read/seek/tell commands, which remain as compatibility aliases. chan pipe/pop/push need Tcl 8.6+; chan isbinary and the -profile/-nodelay/-keepalive/-inputmode configure options need Tcl 9.0+.}
        source {Tcl chan(n)}
        example {chan configure stdout -buffering line
chan puts -nonewline $sock $payload
chan flush $sock
set line [chan gets $sock]
chan close $sock}
        returns {Depends on the subcommand — see each subcommand's detail.}
    }

    subcommand blocked {
        arity 1
        detail {Test whether the last input operation would have blocked; only ever true on a channel configured non-blocking.}
        synopsis {chan blocked channelId}
        return_type Boolean
        pure
        arg 0 -role Channel
        side_effect FileIo -reads
    }

    subcommand close {
        arity 1..2
        detail {Close a channel, or (Tcl 8.6+) half-close one direction of a bidirectional channel.}
        synopsis {chan close channelId ?direction?}
        traits FIRE_AND_FORGET_TEARDOWN
        return_type String
        destructive
        arg_values_accept_prefix
        arg 0 -role Channel
        arg 1 -values-from chan-close-arg1 -closed
        side_effect FileIo -writes
    }

    subcommand configure {
        arity 1..
        detail {Get or set channel configuration options; each channel type may add its own options beyond the generic set (see e.g. socket(n), open(n)).}
        synopsis {chan configure channelId ?-option value ...?}
        return_type String
        option_prefix_words 1
        arg 0 -role Channel
        side_effect FileIo -reads -writes
        channel_configuration EncodingTranslation

        option -blocking -takes boolean -role Boolean \
            -detail {Whether I/O on the channel may block the process indefinitely. Channels are blocking by default; nonblocking mode affects chan gets/read/puts/flush/close and requires the event loop (vwait/update) to drive it.}
        option -buffering -takes mode -values-from chan-configure-buffering -closed \
            -detail {full, line, or none — see the value list for the per-mode default.}
        option -buffersize -takes size \
            -detail {Buffer size in bytes for buffers subsequently allocated for this channel; capped at 1,000,000.}
        option -encoding -takes encoding \
            -detail {Character encoding used to convert the channel's bytes to/from Tcl's internal string representation; defaults to the platform/locale system encoding (encoding system). Use iso8859-1 for byte-transparent binary data (Tcl 8.5 instead used the pseudo-encoding "binary" for this; removed in Tcl 9.0).}
        option -eofchar -takes char \
            -detail {A single character (\x01-\x7f) that signals end-of-file on input; the empty string (the default) disables it. Tcl 8.5/8.6 additionally accepted a {inChar outChar} two-element list for a read-write channel and defaulted to Control-Z on Windows file reads; Tcl 9.0+ takes a single value only and always defaults to the empty string.}
        option -translation -takes mode -values-from chan-configure-translation \
            -detail {End-of-line translation mode; also accepts a {inTranslation outTranslation} list to set input/output independently. See the value list for per-mode behaviour and defaults.}
        option -profile -takes profile -values-from chan-configure-profile -closed -available {tcl 9.0-} \
            -detail {Encoding profile controlling how conversion errors on this channel are handled (see PROFILES in encoding(n)).}
        option -nodelay -takes boolean -role Boolean -available {tcl 9.0-} \
            -detail {TCP_NODELAY on a socket channel: disables Nagle's algorithm so small writes are sent immediately (Tcl 9.0+, TIP 344). Documented on socket(n).}
        option -keepalive -takes boolean -role Boolean -available {tcl 9.0-} \
            -detail {SO_KEEPALIVE on a socket channel (Tcl 9.0+, TIP 344). Documented on socket(n).}
        option -inputmode -takes mode -values-from chan-configure-inputmode -closed -available {tcl 9.0-} \
            -detail {Terminal input mode on a serial/console channel (Tcl 9.0+, TIP 160); Unix-only (Windows exposes the equivalent on console channels). Documented on open(n).}
    }

    subcommand copy {
        arity 2..
        detail {Copy data between channels, blocking until complete unless -command is given.}
        synopsis {chan copy inputChan outputChan ?-size size? ?-command callback?}
        return_type Int
        option_prefix_words 2
        arg 0 -role Channel
        arg 1 -role Channel
        side_effect FileIo -reads -writes

        option -size -takes size \
            -detail {Maximum number of bytes (or characters, if the channels' encodings differ) to copy before stopping. Without it, chan copy reads until end of file.}
        option -command -takes callback -role CommandPrefix -script-timing Deferred -appends {AtLeast 1} \
            -detail {Run the copy in the background and return immediately; callback is invoked on completion with the byte/character count appended, plus an error-message argument if the copy failed. inputChan/outputChan are switched to non-blocking automatically; an active event loop (vwait or Tk) is required to drive it.}
    }

    subcommand create {
        arity 2
        detail {Create a reflected channel implemented by a Tcl command handler (see refchan(n)).}
        synopsis {chan create mode cmdPrefix}
        return_type Channel
        arg 0 -values-from chan-create-arg0
        arg 1 -appends {AtLeast 2}
        side_effect InterpState -writes
    }

    subcommand eof {
        arity 1
        detail {Test for end of file.}
        synopsis {chan eof channelId}
        return_type Boolean
        pure
        arg 0 -role Channel
        side_effect FileIo -reads
    }

    subcommand event {
        arity 2..3
        detail {Set up a channel event handler for "readable" or "writable".}
        synopsis {chan event channelId event ?script?}
        traits DEFERS_BODY
        return_type String
        body_kind Structural
        arg 0 -role Channel
        arg 2 -role Body
        arg 1 -values-from chan-event-arg1 -closed
        side_effect FileIo -reads -writes
    }

    subcommand flush {
        arity 1
        detail {Flush buffered output.}
        synopsis {chan flush channelId}
        return_type String
        mutator
        arg 0 -role Channel
        side_effect FileIo -writes
    }

    subcommand gets {
        arity 1..2
        detail {Read a line.}
        synopsis {chan gets channelId ?varName?}
        traits {UNCONDITIONAL_VARIABLE_WRITE TAINT_SOURCE}
        return_type String
        arg 0 -role Channel
        arg 1 -role VarWrite
        side_effect FileIo -reads
        side_effect Variable -writes
    }

    subcommand names {
        arity ..1
        detail {List open channels, optionally filtered by a glob pattern.}
        synopsis {chan names ?pattern?}
        return_type List
        pattern_type Glob
        pure
        arg 0 -role Pattern
        side_effect InterpState -reads
    }

    subcommand pending {
        arity 2
        detail {Return the number of bytes currently buffered internally for input or output.}
        synopsis {chan pending mode channelId}
        return_type Int
        pure
        arg 1 -role Channel
        arg 0 -values-from chan-pending-arg0 -closed
        side_effect FileIo -reads
    }

    subcommand pipe {
        arity 0
        detail {Create a standalone connected pipe (Tcl 8.6+); returns its two channels.}
        synopsis {chan pipe}
        available {tcl 8.6-}
        return_type List
        side_effect FileIo -writes
    }

    subcommand pop {
        arity 1
        detail {Remove the topmost channel transformation (Tcl 8.6+); equivalent to chan close if none remain.}
        synopsis {chan pop channelId}
        available {tcl 8.6-}
        return_type String
        mutator
        arg 0 -role Channel
        side_effect FileIo -writes
    }

    subcommand push {
        arity 2
        detail {Add a channel transformation (Tcl 8.6+; see transchan(n)); returns a handle to it.}
        synopsis {chan push channelId cmdPrefix}
        available {tcl 8.6-}
        return_type Channel
        mutator
        arg 0 -role Channel
        arg 1 -appends {AtLeast 2}
        side_effect FileIo -writes
    }

    subcommand puts {
        arity 1..
        detail {Write to a channel (default stdout).}
        synopsis {chan puts ?-nonewline? ?channelId? string}
        return_type String
        mutator
        arg_role_layout_resolver -native chan::puts::arg_role_layout_resolver
        arg_role_resolver_roles Channel
        side_effect FileIo -writes

        option -nonewline \
            -detail {Suppress the trailing newline that chan puts otherwise appends.}
    }

    subcommand read {
        arity 1..2
        detail {Read from a channel.}
        synopsis {chan read channelId ?numChars?}
        traits TAINT_SOURCE
        return_type String
        side_effect FileIo -reads

        option -nonewline \
            -detail {Trim a trailing newline from the data read. Only meaningful when reading to end of file (i.e. without numChars).}
    }

    subcommand seek {
        arity 2..3
        detail {Set access position.}
        synopsis {chan seek channelId offset ?origin?}
        return_type String
        mutator
        arg_values_accept_prefix
        arg 0 -role Channel
        arg 2 -values-from chan-seek-arg2 -closed
        side_effect FileIo -writes
    }

    subcommand tell {
        arity 1
        detail {Return current position.}
        synopsis {chan tell channelId}
        return_type Int
        pure
        arg 0 -role Channel
        side_effect FileIo -reads
    }

    subcommand truncate {
        arity 1..2
        detail {Truncate a channel.}
        synopsis {chan truncate channelId ?length?}
        return_type String
        arg 0 -role Channel
        side_effect FileIo -writes
    }

    subcommand isbinary {
        arity 1
        detail {Test whether the channel is binary (iso8859-1 encoding, empty -eofchar, lf translation).}
        synopsis {chan isbinary channelId}
        available {tcl 9.0-}
        return_type Boolean
        pure
        arg 0 -role Channel
        side_effect FileIo -reads
    }

    subcommand postevent {
        arity 2
        detail {Post an event to a reflected channel created with chan create.}
        synopsis {chan postevent channelId eventSpec}
        return_type String
        arg 0 -role Channel
        arg 1 -values-from chan-postevent-arg1
        side_effect FileIo -writes
    }
}

command checkbutton {
    available {tcl 8.4-} {package Tk}
    traits TAINTS_VAR_WRITES
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class checkbutton -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a checkbutton option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change checkbutton options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method deselect {
            arity 0
            detail {Deselect the checkbutton and set its associated variable to -offvalue.}
            synopsis {pathName deselect}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method flash {
            arity 0
            detail {Flash the checkbutton using its active and normal colours.}
            synopsis {pathName flash}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method invoke {
            arity 0
            detail {Toggle the checkbutton and invoke its associated command.}
            synopsis {pathName invoke}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method select {
            arity 0
            detail {Select the checkbutton and set its associated variable to -onvalue.}
            synopsis {pathName select}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method toggle {
            arity 0
            detail {Toggle the checkbutton and update its associated variable.}
            synopsis {pathName toggle}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }
    }

    option -text -takes {} -detail {Text to display in the checkbutton.}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Name of a variable whose value will be used as the checkbutton text.}
    option -background -takes color -detail {Normal background colour of the checkbutton.}
    option -borderwidth -takes {screen units} \
        -detail {Width of the border around the checkbutton.}
    option -foreground -takes color -detail {Normal foreground colour of the checkbutton.}
    option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global -taints-var-write \
        -detail {Name of the global variable linked to the checkbutton state.}
    option -onvalue -takes {} \
        -detail {Value stored in the variable when the checkbutton is selected.}
    option -offvalue -takes {} \
        -detail {Value stored in the variable when the checkbutton is deselected.}
    option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
        -detail {Tcl command to invoke when the checkbutton is toggled.}
    option -state -takes {} -detail {State of the checkbutton: normal, active, or disabled.}
    option -indicatoron -takes {} -detail {Whether to display the selection indicator.}
    option -selectimage -takes {} \
        -detail {Image to display when the checkbutton is selected.}
    option -selectcolor -takes {} \
        -detail {Colour of the indicator when the checkbutton is selected.}
    option -image -takes {} -detail {Image to display in the checkbutton.}
    option -bitmap -takes {} -detail {Bitmap to display in the checkbutton.}
    option -compound -takes {} \
        -detail {Whether to display both image and text: none, bottom, top, left, right, or center.}
    option -width -takes {} \
        -detail {Desired width of the checkbutton in characters (text) or pixels (image).}
    option -height -takes {} \
        -detail {Desired height of the checkbutton in lines (text) or pixels (image).}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {How information is positioned: n, ne, e, se, s, sw, w, nw, or center.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of multi-line text: left, center, or right.}
    option -wraplength -takes {} \
        -detail {Maximum line length for word wrapping, in screen units.}
    option -underline -takes {} \
        -detail {Index of character to underline for keyboard traversal (0-based).}
    option -font -takes {} -detail {Font to use for the checkbutton text.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -activebackground -takes {} \
        -detail {Background colour when the checkbutton is active (mouse over).}
    option -activeforeground -takes {} \
        -detail {Foreground colour when the checkbutton is active.}
    option -disabledforeground -takes {} \
        -detail {Foreground colour when the checkbutton is disabled.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -padx -takes {} -detail {Extra horizontal padding inside the checkbutton.}
    option -pady -takes {} -detail {Extra vertical padding inside the checkbutton.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the checkbutton.}
    option -takefocus -takes {} \
        -detail {Whether the checkbutton accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the checkbutton does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the checkbutton has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the checkbutton.}
    option -overrelief -takes {} \
        -detail {Relief to use when the mouse cursor is over the checkbutton.}
    option -offrelief -takes relief \
        -detail {Relief while deselected when -indicatoron is false; defaults to raised.}
    option -tristateimage -takes image \
        -detail {Image shown in tri-state mode when -image is configured.}
    option -tristatevalue -takes value \
        -detail {Variable value that selects tri-state mode; defaults to the empty string.}

    form Default {checkbutton pathName ?option value ...?}

    hover {
        summary {Create and manipulate a checkbutton widget.}
        synopsis {checkbutton pathName ?option value ...?}
        description {Displays a textual string, bitmap, or image with a selection indicator that toggles between on and off states.}
        source {Tk man page checkbutton.n}
    }

    subcommand cget {
        arity 1
        detail {Return the current value of a checkbutton option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change checkbutton options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand deselect {
        arity 0
        detail {Deselect the checkbutton and set its associated variable to -offvalue.}
        synopsis {pathName deselect}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand flash {
        arity 0
        detail {Flash the checkbutton using its active and normal colours.}
        synopsis {pathName flash}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand invoke {
        arity 0
        detail {Toggle the checkbutton and invoke its associated command.}
        synopsis {pathName invoke}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand select {
        arity 0
        detail {Select the checkbutton and set its associated variable to -onvalue.}
        synopsis {pathName select}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand toggle {
        arity 0
        detail {Toggle the checkbutton and update its associated variable.}
        synopsis {pathName toggle}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }
}

command classvariable {
    available {tcl 8.6}
    traits {LANGUAGE_KEYWORD CREATES_SCOPE_ALIAS TCLOO_METHOD_CONTEXT TCLOO_REQUIRES_METHOD_FRAME}
    arity 1..
    required_package oo::util
    tcllib_package oo::util

    return_type String
    repeat VarWrite

    side_effect Variable -writes

    form Default {classvariable variableName ?...?}

    hover {
        summary {Link local variables to variables shared by every instance of a class.}
        synopsis {classvariable variableName ?...?}
        description {Valid only inside a method, constructor, or destructor body. Each variableName must be an unqualified scalar name — no :: namespace separator and no array-element syntax — and classvariable links it, in the calling scope, to the like-named variable in the namespace of the class that defined the running method, so its value is shared by every instance of that class. This is the class-level counterpart to the variable command, and is equivalent to the typevariable command that the snit package (tcllib) provides for approximately the same purpose. In a method defined directly on an object (e.g. through oo::objdefine), linking a name this way behaves like namespace upvar [namespace current] $var $var for each name listed.}
        source {Tcl classvariable(n)}
        example {oo::class create Counted {
    initialise {
        variable count 0
    }
    variable number
    constructor {} {
        classvariable count
        set number [incr count]
    }
    method report {} {
        classvariable count
        puts "This is instance $number of $count"
    }
}
set a [Counted new]
set b [Counted new]
$a report                 ;# This is instance 1 of 2
set c [Counted new]
$b report                 ;# This is instance 2 of 3
$c report                 ;# This is instance 3 of 3}
        returns {The empty string.}
    }
}

command clay::define {
    available {tcl 8.6-}
    traits {NEVER_INLINE_BODY CREATES_BARRIER CREATES_DYNAMIC_BARRIER}
    arity 1..
    required_package clay
    tcllib_package clay

    body_kind Structural

    side_effect InterpState -writes

    definition_body clay

    form Default {clay::define class definitionScript}
    form Default {clay::define class subcommand ?arg ...?}

    hover {
        summary {Create or extend a Clay class.}
        synopsis {clay::define class definitionScript}
        description {Creates or extends a Clay class using definition commands. The script may declare methods and configure Clay metadata.}
        source {Tcllib 2.0 Clay 0.8.8}
        example {clay::define Server {method connect {sock ip port} {}}}
    }

    refine definition-script {
        arity 2
        arg 0 -role Name
        arg 1 -role Body
    }
}

command clipboard {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    side_effect InterpState -reads -writes

    option -displayof -takes window \
        -detail {Specifies the display for the clipboard operation.}
    option -format -takes format \
        -detail {Specifies the representation format for the data (append).}
    option -type -takes type \
        -detail {Specifies the form in which the selection is to be returned.}

    form Default {clipboard option ?arg ...?}

    hover {
        summary {Manipulate the Tk clipboard.}
        synopsis {clipboard append ?-displayof window? ?-format format? ?-type type? data}
        synopsis {clipboard clear ?-displayof window?}
        synopsis {clipboard get ?-displayof window? ?-type type?}
        source {Tk man page clipboard.n}
    }

    subcommand append {
        arity 1..
        detail {Append data to the clipboard on the specified display.}
        synopsis {clipboard append ?-displayof window? ?-format format? ?-type type? data}

        option -displayof -takes window \
            -detail {Specifies the display for the clipboard operation.}
        option -format -takes format \
            -detail {Specifies the representation format for the data (append).}
        option -type -takes type \
            -detail {Specifies the form in which the selection is to be returned.}
    }

    subcommand clear {
        detail {Claim ownership of the clipboard and clear its contents.}
        synopsis {clipboard clear ?-displayof window?}

        option -displayof -takes window \
            -detail {Specifies the display for the clipboard operation.}
    }

    subcommand get {
        detail {Retrieve data from the clipboard on the specified display.}
        synopsis {clipboard get ?-displayof window? ?-type type?}
        traits TAINT_SOURCE
        return_type String
        side_effect InterpState -reads

        option -displayof -takes window \
            -detail {Specifies the display for the clipboard operation.}
        option -type -takes type \
            -detail {Specifies the form in which the selection is to be returned.}
    }
}

command clock {
    available {tcl 8.4-} {f5-irules}
    traits {CSE_CANDIDATE BYTE_COMPILED}
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    runtime_backing shipped-builtin clock

    option -base -takes timeVal -detail {Base time for relative scanning.}
    option -format -takes format -detail {strftime-style format string.}
    option -gmt -takes boolean -role Boolean -detail {Use GMT instead of local time.}
    option -locale -takes locale -available {tcl 8.5-} -detail {Locale for month/day names.}
    option -timezone -takes zone -available {tcl 8.5-} -detail {Time zone for conversion.}
    option -validate -takes boolean -role Boolean -available {tcl 9.0-} \
        -detail {Validate date fields strictly (Tcl 9.0+).}

    form Default {clock subcommand ?arg ...?}

    hover {
        summary {Obtain and manipulate dates and times.}
        synopsis {clock add timeVal ?count unit ...?}
        synopsis {clock clicks ?-milliseconds? ?-microseconds?}
        synopsis {clock format timeVal ?-option value ...?}
        synopsis {clock microseconds}
        synopsis {clock milliseconds}
        synopsis {clock monotonic}
        synopsis {clock scan inputString ?-option value ...?}
        synopsis {clock seconds}
        description {`clock seconds`, `clock milliseconds`, `clock microseconds`, and `clock clicks` read the current wall-clock time; `clock monotonic` (Tcl 9.1+) instead reads a clock guaranteed never to run backwards, unlike wall-clock time which can jump on an NTP correction. `clock format` converts a seconds-since-epoch value to text and `clock scan` parses text back into one; `clock add` performs calendar-aware arithmetic on a seconds value (day/week arithmetic preserves local time across DST transitions; month/year arithmetic clamps to the last day of a shorter target month). Before the Tcl 8.5 clock rewrite (TIP 173), `clock format` accepted only -format/-gmt and `clock scan` accepted only -base/-gmt, always via free-form parsing, and there was no `clock add`/`clock microseconds`/`clock milliseconds` at all — `-locale`, `-timezone`, and `clock scan`'s strict -format parsing all arrived with that rewrite. `-validate` (Tcl 9.0+, TIP 688) controls whether an out-of-range field during a strict `clock scan` raises an error (the default) or is clamped into range.}
        source {Tcl clock(n)}
        example {clock format [clock seconds] -format {%Y-%m-%d %H:%M:%S}
clock scan {2024-01-15} -format {%Y-%m-%d}
clock add [clock seconds] 1 day -timezone :UTC}
        returns {An integer for seconds, milliseconds, microseconds, clicks, monotonic, scan, and add; a formatted string for format.}
    }

    subcommand add {
        arity 1..
        detail {Add duration to a time.}
        synopsis {clock add timeVal ?count unit ...?}
        available {tcl 8.5-}
        return_type Int
        pure
        option_prefix_words 1
        arg 2 -values-from clock-add-arg2
        arg 4 -values-from clock-add-arg2
        arg 6 -values-from clock-add-arg2
        arg 8 -values-from clock-add-arg2
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.

        option -gmt -takes boolean -role Boolean \
            -detail {Do the arithmetic in UTC instead of the local time zone; superseded by -timezone :UTC but still accepted.}
        option -locale -takes locale -detail {Locale used to resolve month/weekday names.}
        option -timezone -takes tz \
            -detail {Time zone the calendar arithmetic (days/weekdays/weeks/months/years) is done in.}
    }

    subcommand clicks {
        arity ..1
        detail {Return hi-res clock value.}
        synopsis {clock clicks ?-milliseconds? ?-microseconds?}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.

        option -milliseconds \
            -detail {Return the same value as `clock milliseconds` instead of the raw high-resolution counter.}
        option -microseconds -available {tcl 8.5-} \
            -detail {Return the same value as `clock microseconds` instead of the raw high-resolution counter.}
    }

    subcommand format {
        arity 1..
        detail {Format a time value.}
        synopsis {clock format timeVal ?-option value ...?}
        return_type String
        format_string_type Clock
        pure
        option_prefix_words 1
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.

        option -format -takes format -role FormatString \
            -detail {strftime-style output format string (default "%a %b %d %H:%M:%S %Z %Y").}
        option -gmt -takes boolean -role Boolean \
            -detail {Format in UTC instead of the local time zone; superseded by -timezone :UTC but still accepted.}
        option -locale -takes locale -available {tcl 8.5-} \
            -detail {Locale for month / day-of-week names and the other locale-dependent format groups (%a, %c, ...).}
        option -timezone -takes tz -available {tcl 8.5-} \
            -detail {Time zone to format the value in.}
    }

    subcommand microseconds {
        arity 0
        detail {Return current time in microseconds.}
        synopsis {clock microseconds}
        available {tcl 8.5-}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
    }

    subcommand milliseconds {
        arity 0
        detail {Return current time in milliseconds.}
        synopsis {clock milliseconds}
        available {tcl 8.5-}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
    }

    subcommand monotonic {
        arity 0
        detail {Return current monotonic clock value in microseconds.}
        synopsis {clock monotonic}
        available {tcl 9.1}
        return_type Int
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
    }

    subcommand scan {
        arity 1..
        detail {Parse a date/time string.}
        synopsis {clock scan inputString ?-option value ...?}
        return_type Int
        format_string_type Clock
        option_prefix_words 1
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.

        option -base -takes seconds \
            -detail {Base date/time used to fill in fields the input string doesn't specify.}
        option -format -takes format -role ScanFormat -available {tcl 8.5-} \
            -detail {Explicit input format string for strict parsing; omitting it falls back to the deprecated free-form scanner.}
        option -gmt -takes boolean -role Boolean \
            -detail {Interpret the input as UTC instead of local time; superseded by -timezone :UTC but still accepted.}
        option -locale -takes locale -available {tcl 8.5-} \
            -detail {Locale for month / day-of-week names.}
        option -timezone -takes tz -available {tcl 8.5-} \
            -detail {Time zone for interpretation.}
        option -validate -takes boolean -role Boolean -available {tcl 9.0-} \
            -detail {When true (the default), an out-of-range field (e.g. day 31 in a 30-day month) raises an error; when false, it is clamped into range instead.}
    }

    subcommand seconds {
        arity 0
        detail {Return current time in seconds.}
        synopsis {clock seconds}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
    }
}

command close {
    available {tcl 8.4-}
    traits {BYTE_COMPILED FIRE_AND_FORGET_TEARDOWN}
    arity 1..2

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Channel
    arg 1 -values-from close-arg1

    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect FileIo -writes

    runtime_backing shipped-builtin close

    form Default {close channelId}
    form Default {close channelId ?r(ead)|w(rite)?} -available {tcl 8.6-}

    hover {
        summary {Close, or half-close, an open channel.}
        synopsis {close channelId}
        synopsis {close channelId ?r(ead)|w(rite)?}
        description {The single-argument form flushes all buffered output, discards buffered input, and closes the underlying file or device; channelId becomes unavailable for use. A blocking channel does not return until output is flushed; a nonblocking channel with unflushed output stays open and closes in the background once flushing completes. Closing a command-pipeline channel waits for its child process(es) and raises an error on an abnormal exit.

From Tcl 8.6, an optional direction (read or write, or any unique abbreviation) half-closes just that side of a bidirectional channel; currently only sockets and command pipelines support this. A later plain close on an already half-closed channel finishes the job; half-closing an already-closed side, or the wrong side of a unidirectional channel, is an error.

Also from 8.6 (TIP 398), a nonblocking channel with unflushed output is no longer forced back to blocking mode at process exit, so a stalled peer can no longer hang shutdown; set the environment variable TCL_FLUSH_NONBLOCKING_ON_EXIT to a nonzero value to restore the pre-8.6 behaviour.

From Tcl 9.0 the close manual page documents itself purely as an alias for chan close ("has been superceded by the chan close command which supports the same syntax and options"), though close keeps working exactly as described above in every version through 9.1.

A second close on an already-closed channelId is an error, which is why `catch {close $chan}` is the standard idiom for unconditional cleanup.}
        source {Tcl close(n)}
        example {proc withOpenFile {filename channelVar script} {
    upvar 1 $channelVar chan
    set chan [open $filename]
    catch {uplevel 1 $script} result options
    close $chan
    return -options $options $result
}

# Tcl 8.6+: half-close the write side of a pipe once the request is sent,
# then read the rest of the reply before finishing the close.
set p [open |[list somecmd] r+]
puts $p $request
close $p write
set reply [read $p]
close $p}
        returns {Empty string on success.}
    }
}

