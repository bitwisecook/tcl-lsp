    available {tcl 8.5-}
    arity 0
    required_package zipfile::decode
    tcllib_package zipfile::decode

    hover {
        summary {This command releases all state associated with the last call of ::zipfile::decode::open.}
        synopsis {zipfile::decode::close}
        source {tcllib package}
    }
}

