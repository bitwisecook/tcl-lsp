command uri::split {
    available {tcl 8.5-}
    arity 1..2
    required_package uri
    tcllib_package uri

    side_effect Unknown -reads

    form Default {uri::split url ?defaultScheme?}

    hover {
        summary {Split a URI into its component parts.}
        synopsis {uri::split url ?defaultScheme?}
        description {Parses the URI and returns a key-value list with scheme, host, port, path, query, fragment, etc.}
        source {tcllib uri package}
        example {array set parts [uri::split $url]}
        returns {A key-value list of URI components.}
    }
}

