command crc::buypass {
    available {tcl 8.5-}
    traits PURE
    arity 1..
    required_package crc16
    tcllib_package crc16

    side_effect Unknown -reads

    option -format -takes format \
        -detail {A printf-style format for the result (e.g. 0x%04X).}
    option -seed -takes value -detail {Override the initial CRC register value.}
    option -implementation -takes procname -role CommandPrefix \
        -detail {Use an alternate procedure to compute the CRC.}
    option -filename -takes file -detail {Compute the checksum over the contents of a file.}

    hover {
