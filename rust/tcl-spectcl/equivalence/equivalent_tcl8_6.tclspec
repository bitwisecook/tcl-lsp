            }

            refine remove {
                arity 3
                selector remove
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
            side_effect InterpState -reads -writes
            sub_subcommand add -detail {Add a tag to a list of items.} -synopsis {pathName tag add tagName itemList} {}
            sub_subcommand bind -detail {Query or install a deferred event binding script for a tag.} -synopsis {pathName tag bind tagName ?sequence? ?script?} {}
            sub_subcommand cell -detail {Add, test, or remove tags on individual cells.} -synopsis {pathName tag cell add|has|remove tagName ?cellList?} -introduced 9.0 {}
            sub_subcommand configure -detail {Query or modify a tag's display options.} -synopsis {pathName tag configure tagName ?option? ?value option value ...?} {
                option -foreground -takes color \
                    -detail {Text foreground colour for tagged items or cells.}
                option -background -takes color \
                    -detail {Background colour for tagged items or cells.}
                option -font -takes font -detail {Font used for tagged text.}
                option -image -takes imageName \
                    -detail {Image used for tagged items or cells.}
                option -imageanchor -takes anchor -values-from button-anchor -closed -introduced 9.0 \
                    -detail {Alignment of a tagged image.}
                option -padding -takes amount -introduced 9.0 \
                    -detail {Padding around tagged cell contents.}
                option -stripedbackground -takes color -introduced 9.0 \
                    -detail {Alternate-line background colour when -striped is enabled.}
