}

command linsert {
    available {tcl 8.4-} {f5-irules}
    traits {PURE CSE_CANDIDATE BYTE_COMPILED FRAMELESS_RUNTIME}
    arity 2..

    return_type List
    inferred_storage_type List
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -type List -shimmers
    arg 1 -type Int -shimmers

    codegen_hook -native Linsert
    inline_codegen_hook -native Linsert
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.
    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.
    # TODO(spectcl): `result_stability` is set on the source spec. The DSL
    #   spells it `result_stability
    #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
    #   …}}`, but a draft records only that the field is set, never the
    #   expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin linsert

    form Default {linsert list index ?element element ...?} -available {tcl 8.6-}
    form Default {linsert list index element ?element element ...?} -available {tcl 8.4-8.6}

    hover {
        summary {Insert elements into a list}
        synopsis {linsert list index ?element element ...?}
        synopsis {linsert list index element ?element element ...?}
        description {Produces a new list from list by inserting the element arguments as separate new elements just before the index'th element; list itself is left unmodified. If index is less than or equal to zero, the new elements go at the beginning of the list; if index is end, or is greater than or equal to the number of elements in list, they are appended to the end. index takes the same forms as string index: a plain integer, end, or end-integer/end+integer arithmetic. When index counts from the start, the first inserted element ends up at that index in the result; when index counts from the end (e.g. end-1), the last inserted element ends up at that index instead. Before Tcl 8.6, at least one element argument was required; Tcl 8.6 and later also accept linsert list index with no element arguments at all, which is a no-op that returns an unmodified copy of list.}
        source {Tcl linsert(n)}
        example {set oldList {the fox jumps over the dog}
set midList [linsert $oldList 1 quick]
set newList [linsert $midList end-1 lazy]}
        returns {A new list consisting of every element of list, with the element arguments inserted before index.}
    }
}

command list {
    available {tcl 8.4-} {f5-irules}
    traits {PURE PRODUCES_CANONICAL_LIST BUILDS_COMMAND_PREFIX BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME EXPANSION_ESCAPE_SAFE}

    return_type List
    return_elements {ListOfArgs 0}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    # TODO(spectcl): `native_result` is set on the source spec. The DSL spells
    #   it `native_result -native CONTRACT`, but a draft records only that the
    #   field is set, never the expression that set it.

    const_fold -native list::const_fold
    inline_codegen_hook -native List
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.
    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.
    # TODO(spectcl): `result_stability` is set on the source spec. The DSL
    #   spells it `result_stability
    #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
    #   …}}`, but a draft records only that the field is set, never the
    #   expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin list

    form Default {list ?arg arg ...?}

    hover {
        summary {Create a list}
        synopsis {list ?arg arg ...?}
        description {Every argument becomes exactly one element of the result, with braces or backslashes inserted wherever needed so that lindex can recover the original argument unchanged and eval can run the result as a command — the first element as the command name and the rest as its arguments. This is what distinguishes list from concat: concat removes one level of list structure before joining its arguments, while list always treats each argument as a single opaque element, even one containing embedded whitespace or list-special characters such as braces. Called with no arguments, list returns the empty string.}
        source {Tcl list(n)}
        example {list a b c
list a b "c d e  " "  f {g h}"
list}
        returns {A list containing one element per argument, in order, or the empty string when no arguments are given.}
    }
}

command listbox {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class listbox -method-prefix-matching Enabled {
        method activate {
            arity 1
            detail {Set the active element to the one at the given index.}
            synopsis {pathName activate index}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method cget {
            arity 1
            detail {Return the current value of a listbox option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change listbox options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method bbox {
            arity 1
            detail {Return the bounding box of the text of the element at the given index.}
            synopsis {pathName bbox index}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method curselection {
            arity 0
            detail {Return a list of the indices of all currently selected elements.}
            synopsis {pathName curselection}
            traits TAINT_SOURCE
            return_type List
            pure
            side_effect InterpState -reads
        }

        method delete {
            arity 1..2
            detail {Delete one or more elements in the range first through last inclusive.}
            synopsis {pathName delete first ?last?}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method get {
            arity 1..2
            detail {Return the contents of the elements in the range first through last inclusive.}
            synopsis {pathName get first ?last?}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method index {
            arity 1
            detail {Return the integer index value corresponding to the given index.}
            synopsis {pathName index index}
            return_type Int
            pure
            side_effect InterpState -reads
        }

        method insert {
            arity 1..
            detail {Insert zero or more new elements just before the element at the given index.}
            synopsis {pathName insert index ?element ...?}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method itemcget {
            arity 2
            detail {Return the current value of the given configuration option for an item.}
            synopsis {pathName itemcget index option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method itemconfigure {
            arity 1..
            detail {Query or modify the configuration options of an individual item.}
            synopsis {pathName itemconfigure index ?option? ?value option value ...?}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method nearest {
            arity 1
            detail {Return the index of the visible element nearest to the given y-coordinate.}
            synopsis {pathName nearest y}
            return_type Int
            pure
            side_effect InterpState -reads
        }

        method scan {
            arity 3
            detail {Implement scanning: record scan mark, or scroll relative to a mark.}
            synopsis {pathName scan mark|dragto x y}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method see {
            arity 1
            detail {Adjust the view so that the element at the given index is visible.}
            synopsis {pathName see index}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method selection {
            arity 1..
            detail {Adjust or query the selection: anchor, clear, includes, or set.}
            synopsis {pathName selection option first ?last?}
            return_type String
            mutator

            refine includes {
                arity 2
                selector includes
                traits PURE
                mutator no
                side_effect InterpState -reads
            }
            side_effect InterpState -reads -writes
        }

        method size {
            arity 0
            detail {Return the number of elements in the listbox.}
            synopsis {pathName size}
            return_type Int
            pure
            side_effect InterpState -reads
        }

        method xview {
            detail {Query or change the horizontal position of the listbox's view.}
            synopsis {pathName xview ?args?}
            return_type List
            mutator

            refine query {
                arity 0
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine move {
                arity 1..
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
            side_effect InterpState -reads -writes
        }

        method yview {
            detail {Query or change the vertical position of the listbox's view.}
            synopsis {pathName yview ?args?}
            return_type List
            mutator

            refine query {
                arity 0
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine move {
                arity 1..
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
            side_effect InterpState -reads -writes
        }
    }

    option -listvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Name of a variable containing the list of values to display.}
    option -background -takes color -detail {Normal background colour of the listbox.}
    option -borderwidth -takes {screen units} \
        -detail {Width of the border around the listbox.}
    option -foreground -takes color -detail {Normal foreground colour of the listbox.}
    option -inactiveselectbackground -takes color -introduced 9.1 \
        -detail {Background colour for selected items when the listbox lacks focus.}
    option -inactiveselectforeground -takes color -introduced 9.1 \
        -detail {Foreground colour for selected items when the listbox lacks focus.}
    option -selectmode -takes {} \
        -detail {Selection mode: single, browse, multiple, or extended.}
    option -width -takes {} -detail {Desired width of the listbox in characters.}
    option -height -takes {} -detail {Desired height of the listbox in lines.}
    option -font -takes {} -detail {Font to use for text in the listbox.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -selectbackground -takes {} -detail {Background colour for selected items.}
    option -selectborderwidth -takes {} -detail {Width of the border around selected items.}
    option -selectforeground -takes {} -detail {Foreground colour for selected items.}
    option -xscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for communicating with horizontal scrollbars.}
    option -yscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for communicating with vertical scrollbars.}
    option -exportselection -takes {} \
        -detail {Whether the selection is exported to the X selection.}
    option -setgrid -takes {} \
        -detail {Whether this widget controls the resizing grid for its toplevel.}
    option -activestyle -takes {} \
        -detail {Style for the active element: dotbox, none, or underline.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the listbox.}
    option -takefocus -takes {} \
        -detail {Whether the listbox accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the listbox does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the listbox has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the listbox.}
    option -disabledforeground -takes color \
        -detail {Foreground colour while disabled; empty uses a dimmed normal foreground.}
    option -justify -takes justify -detail {Text alignment: left, centre, or right.}
    option -state -takes stateSpec \
        -detail {State: normal or disabled; disabled prevents edits and selection changes.}

    form Default {listbox pathName ?option value ...?}

    hover {
        summary {Create and manipulate a listbox widget.}
        synopsis {listbox pathName ?option value ...?}
        description {Displays a list of strings, one per line, and allows the user to select one or more of them.}
        source {Tk man page listbox.n}
    }

    subcommand activate {
        arity 1
        detail {Set the active element to the one at the given index.}
        synopsis {pathName activate index}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand cget {
        arity 1
        detail {Return the current value of a listbox option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change listbox options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand bbox {
        arity 1
        detail {Return the bounding box of the text of the element at the given index.}
        synopsis {pathName bbox index}
        return_type List
        pure
        side_effect InterpState -reads
    }

    subcommand curselection {
        arity 0
        detail {Return a list of the indices of all currently selected elements.}
        synopsis {pathName curselection}
        traits TAINT_SOURCE
        return_type List
        pure
        side_effect InterpState -reads
    }

    subcommand delete {
        arity 1..2
        detail {Delete one or more elements in the range first through last inclusive.}
        synopsis {pathName delete first ?last?}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand get {
        arity 1..2
        detail {Return the contents of the elements in the range first through last inclusive.}
        synopsis {pathName get first ?last?}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand index {
        arity 1
        detail {Return the integer index value corresponding to the given index.}
        synopsis {pathName index index}
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand insert {
        arity 1..
        detail {Insert zero or more new elements just before the element at the given index.}
        synopsis {pathName insert index ?element ...?}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand itemcget {
        arity 2
        detail {Return the current value of the given configuration option for an item.}
        synopsis {pathName itemcget index option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand itemconfigure {
        arity 1..
        detail {Query or modify the configuration options of an individual item.}
        synopsis {pathName itemconfigure index ?option? ?value option value ...?}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand nearest {
        arity 1
        detail {Return the index of the visible element nearest to the given y-coordinate.}
        synopsis {pathName nearest y}
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand scan {
        arity 3
        detail {Implement scanning: record scan mark, or scroll relative to a mark.}
        synopsis {pathName scan mark|dragto x y}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand see {
        arity 1
        detail {Adjust the view so that the element at the given index is visible.}
        synopsis {pathName see index}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand selection {
        arity 1..
        detail {Adjust or query the selection: anchor, clear, includes, or set.}
        synopsis {pathName selection option first ?last?}
        return_type String
        mutator

        refine includes {
            arity 2
            selector includes
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }

    subcommand size {
        arity 0
        detail {Return the number of elements in the listbox.}
        synopsis {pathName size}
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand xview {
        detail {Query or change the horizontal position of the listbox's view.}
        synopsis {pathName xview ?args?}
        return_type List
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }

    subcommand yview {
        detail {Query or change the vertical position of the listbox's view.}
        synopsis {pathName yview ?args?}
        return_type List
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }
}

command llength {
    available {tcl 8.4-} {f5-irules}
    traits {PURE CSE_CANDIDATE BYTE_COMPILED FRAMELESS_RUNTIME}
    arity 1

    return_type Int
    representation_effect {CoerceOrdinaryList 0}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    # TODO(spectcl): `native_result` is set on the source spec. The DSL spells
    #   it `native_result -native CONTRACT`, but a draft records only that the
    #   field is set, never the expression that set it.
    arg 0 -type List -shimmers

    const_fold -native llength::const_fold
    codegen_hook -native Llength
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.
    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.
    # TODO(spectcl): `result_stability` is set on the source spec. The DSL
    #   spells it `result_stability
    #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
    #   …}}`, but a draft records only that the field is set, never the
    #   expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin llength

    form Default {llength list}

    hover {
        summary {Count the number of elements in a list}
        synopsis {llength list}
        description {Treats list as a Tcl list and returns the count of its top-level elements as a decimal string. An element grouped with braces or quotes — including a nested sublist — counts as a single element; llength does not descend into it. An empty list is not necessarily an empty string: a value containing only whitespace has list length 0 even though its string length is nonzero. list must be syntactically valid as a Tcl list — a malformed value, such as one with an unmatched open brace, raises an error rather than being treated as a single-element list.}
        source {Tcl man page llength.n}
        example {llength {a b c d e}      ;# 5
llength {a b {c d} e}    ;# 4 -- the braced {c d} sublist counts as one element
llength {}               ;# 0

set s { }
llength $s                ;# 0 -- a lone space is an empty list, though [string length $s] is 1

# common idiom: test whether a list is empty
if {[llength $items] == 0} {
    puts "no items"
}}
        returns {A decimal string giving the number of top-level elements in list.}
    }
}

command lmap {
    available {tcl 8.6-}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD HAS_LOOP_BODY NEVER_INLINE_BODY LOOP_LIST_HEADER BYTE_COMPILED NOT_PROC_FACTORY}
    arity 3.. -step 2

    return_type List
    var_write_typing {ElementsOf 0}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -type List -shimmers
    repeat LoopVarList -stride 2 -exclude-trailing 1

    clause_grammar {
        group 0 -timing per-iteration
        tail Body -timing per-iteration
        selection all
    }

    arg_role_resolver_roles Body
    lowering_hook -native Lmap

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin lmap

    form Default {lmap varlist1 list1 ?varlist2 list2 ...? body}

    hover {
        summary {Iterate over all elements in one or more lists and collect results}
        synopsis {lmap varname list body}
        synopsis {lmap varlist1 list1 ?varlist2 list2 ...? body}
        description {In the simple form, varname takes on each value of list in turn and body runs once per value. In the general form, each varlist/list pair is handled independently: on every iteration, the variables of each varlist are assigned consecutive values from its corresponding list, as if by lindex. Iteration continues until every value from every list has been used exactly once — enough passes to exhaust the longest list — and a list too short for its varlist supplies empty strings for the missing elements on later passes. Unlike foreach, the result of each iteration that completes normally is appended, in order, to an accumulator list that lmap returns; break and continue behave exactly as they do in foreach, except that the iteration they interrupt contributes nothing to the accumulator — continue is therefore a common way to filter values out of the result.}
        source {Tcl lmap(n)}
        example {lmap x {1 2 3} {expr {$x * 2}}
lmap x {1 2 3 4 5 6} {
    if {$x % 2} {continue}
    set x
}
lmap a {1 2 3} b {x y z} {
    list $a $b
}}
        returns {The accumulator list: one element per iteration of body that completed normally (break/continue iterations contribute nothing).}
    }
}

command load {
    available {tcl 8.4-}
    traits {TAINT_SINK BYTE_COMPILED SAFE_INTERP_HIDDEN LOADS_EXTERNAL_UNIT}
    arity 1..3

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    analyser_hook -native Load

    side_effect FileIo -reads
    side_effect InterpState -writes

    option -global -available {tcl 8.6-} \
        -detail {Exports every symbol in the shared library for global use by other loaded libraries, instead of resolving them privately to this library. Ignored (not an error) on platforms that don't support it.}
    option -lazy -available {tcl 8.6-} \
        -detail {Delays the actual loading of symbols in the library until they are first used, instead of resolving them all immediately. Ignored (not an error) on platforms that don't support it.}
    option -- -available {tcl 8.6-} \
        -detail {Marks the end of the options; needed if fileName begins with - and a prefix argument is also given.}

    form Default {load fileName ?packageName? ?interp?} -available {tcl 8.4-8.6}
    form Default {load ?-global? ?-lazy? ?--? fileName ?prefix? ?interp?} -available {tcl 8.6-}

    hover {
        summary {Load a shared library extension and initialize new commands in an interpreter.}
        synopsis {load ?-global? ?-lazy? ?--? fileName}
        synopsis {load ?-global? ?-lazy? ?--? fileName prefix}
        synopsis {load ?-global? ?-lazy? ?--? fileName prefix interp}
        description {Loads binary code from fileName — typically a shared library such as a .so or DLL — into the process, then calls an initialization procedure to register new commands with interp (the invoking interpreter, by default). The procedure name comes from prefix: prefix_Init normally, or prefix_SafeInit when interp is a safe interpreter. When prefix is omitted or empty, Tcl guesses it from the last path element of fileName — strip a leading "lib", and (from Tcl 9.0) a following "tcl9", then title-case the remaining word characters; load libxyz4.2.so guesses Xyz. fileName may be empty only when prefix names a package already registered as statically linked. A given fileName's code is loaded into the process at most once — loading it again, even into a different interp, just re-invokes the initialization procedure without reloading. Before Tcl 8.6, load took no options and called its second argument packageName rather than prefix; -global/-lazy/-- exist only from 8.6 on, and misusing either can crash the process later (a symbol conflict or a missing symbol) in a way load itself never detects or reports. Before Tcl 9.0 an explicitly-supplied prefix was itself title-cased before use, the same as a guessed one; from 9.0 an explicit prefix is used exactly as given, so its case now matters. Before Tcl 8.5 a load could never be undone; from 8.5 the unload command can remove a library that cooperates with Tcl's unloading protocol.}
        source {Tcl load(n)}
        example {load [file join [pwd] libfoo[info sharedlibextension]]
load -lazy [file join [pwd] libfoo[info sharedlibextension]] Foo ;# Tcl 8.6+: -global/-lazy/-- added in 8.6
load {} Tk ;# fileName empty: use a package already registered as statically linked}
        returns {The result returned by the library's initialization procedure — typically the empty string on success.}
    }
}

