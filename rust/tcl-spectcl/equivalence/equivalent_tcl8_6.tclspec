    form Default {consoleinterp subcommand script}

    hover {
        summary {Evaluate or record a script in the console's attached interpreter.}
        synopsis {consoleinterp eval script}
        synopsis {consoleinterp record script}
        description {Available inside the console interpreter. Both subcommands run script in the interpreter the console is attached to; `record` additionally adds it to the console's command history.}
        source {Tk source tkConsole.c (InterpreterObjCmd)}
    }

    subcommand eval {
        arity 1
