command pack {
    available {tcl 8.4-} {package Tk}
    traits TK_GEOMETRY_MANAGER
    arity 1..
    required_package Tk
    tk_geometry Exclusive -container-option -in -direct-form -placement-subcommand configure -release-subcommands forget
    warn_missing_import no

    side_effect InterpState -writes

    option -side -takes top|bottom|left|right \
        -detail {Specifies which side of the master the slave will be packed against.}
    option -fill -takes none|x|y|both \
        -detail {If a slave's parcel is larger than its requested dimensions, this option may be used to stretch the slave.}
    option -expand -takes boolean -role Boolean \
        -detail {Specifies whether the slave should be expanded to consume extra space in its master.}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {Anchor must be a valid anchor position: n, ne, e, se, s, sw, w, nw, or center.}
    option -padx -takes amount \
        -detail {Specifies how much external horizontal padding to leave on each side of the slave.}
    option -pady -takes amount \
        -detail {Specifies how much external vertical padding to leave on each side of the slave.}
    option -ipadx -takes amount \
        -detail {Specifies how much internal horizontal padding to leave on each side of the slave.}
    option -ipady -takes amount \
        -detail {Specifies how much internal vertical padding to leave on each side of the slave.}
    option -in -takes master \
        -detail {Insert the slave at the end of the packing order for the master window.}
    option -before -takes other \
        -detail {Insert the slave before the window given by other in the packing order.}
    option -after -takes other \
        -detail {Insert the slave after the window given by other in the packing order.}

    form Default {pack option arg ?arg ...?}

    hover {
        summary {Geometry manager that packs slaves around the edges of a cavity.}
        synopsis {pack slave ?slave ...? ?option value ...?}
        synopsis {pack configure slave ?slave ...? ?option value ...?}
        synopsis {pack forget slave ?slave ...?}
        synopsis {pack info slave}
        synopsis {pack propagate master ?boolean?}
        synopsis {pack slaves master}
        source {Tk man page pack.n}
    }

    subcommand configure {
        arity 1..
        detail {Set or query the packing options for one or more slaves.}
        synopsis {pack configure slave ?slave ...? ?option value ...?}

        option -side -takes top|bottom|left|right \
            -detail {Specifies which side of the master the slave will be packed against.}
        option -fill -takes none|x|y|both \
            -detail {If a slave's parcel is larger than its requested dimensions, this option may be used to stretch the slave.}
        option -expand -takes boolean -role Boolean \
            -detail {Specifies whether the slave should be expanded to consume extra space in its master.}
        option -anchor -takes anchor -values-from button-anchor -closed \
            -detail {Anchor must be a valid anchor position: n, ne, e, se, s, sw, w, nw, or center.}
        option -padx -takes amount \
            -detail {Specifies how much external horizontal padding to leave on each side of the slave.}
        option -pady -takes amount \
            -detail {Specifies how much external vertical padding to leave on each side of the slave.}
        option -ipadx -takes amount \
            -detail {Specifies how much internal horizontal padding to leave on each side of the slave.}
        option -ipady -takes amount \
            -detail {Specifies how much internal vertical padding to leave on each side of the slave.}
        option -in -takes master \
            -detail {Insert the slave at the end of the packing order for the master window.}
        option -before -takes other \
            -detail {Insert the slave before the window given by other in the packing order.}
        option -after -takes other \
            -detail {Insert the slave after the window given by other in the packing order.}
    }

    subcommand content {
        arity 1
        detail {Return a list of all slaves in the packing order for the master (9.0+ name for `slaves`).}
        synopsis {pack content master}
        available {tcl 9.0-}
    }

    subcommand forget {
        arity 1..
        detail {Remove each slave from the packing order for its master.}
        synopsis {pack forget slave ?slave ...?}
    }

    subcommand info { arity 1 ; detail {Return a list of the current configuration state of the slave.} ; synopsis {pack info slave} }

    subcommand propagate {
        arity 1..2
        detail {Control whether the master computes its geometry from slaves.}
        synopsis {pack propagate master ?boolean?}
    }

    subcommand slaves { arity 1 ; detail {Return a list of all slaves in the packing order for the master.} ; synopsis {pack slaves master} }
}

command package {
    available {tcl 8.4-}
    traits {LANGUAGE_KEYWORD BYTE_COMPILED NOT_PROC_FACTORY}
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect InterpState -reads -writes

    runtime_backing shipped-builtin package

    form Default {package option ?arg ...?} -available {tcl 8.6-}
    form Default {package option ?arg arg ...?} -available {tcl 8.4-8.6}

    hover {
        summary {Facilities for package loading and version control}
        synopsis {package files package}
        synopsis {package forget ?package package ...?}
        synopsis {package ifneeded package version ?script?}
        synopsis {package names}
        synopsis {package present ?-exact? package ?requirement...?}
        synopsis {package prefer ?latest|stable?}
        synopsis {package provide package ?version?}
        synopsis {package require ?-exact? package ?requirement...?}
        synopsis {package unknown ?command?}
        synopsis {package vcompare version1 version2}
        synopsis {package versions package}
        synopsis {package vsatisfies version requirement ?requirement ...?}
        description {This command keeps a simple database of the packages available for use by the current interpreter and how to load them into the interpreter — matching a suitable version to what an application needs and detecting version clashes. Only package require and package provide are typically invoked directly in application scripts; the rest are used by system scripts (commonly generated by pkg_mkIndex) that maintain the database. package files is Tcl 9.0+ only. Tcl 8.5 (TIP 268) added package prefer and reworked require/present/vsatisfies to take a variadic list of requirements (each a min, min-, or min-max version range) instead of a single plain version, and added alpha/beta ("a"/"b") version modifiers — package require now also picks between the highest stable and highest unstable acceptable version according to the package prefer mode.}
        source {Tcl package(n)}
        example {package require Tcl 8.6
package require http
if {[catch {package require Snack}]} {
    # optional package unavailable; continue without it
} else {
    # Snack is loaded
}
package provide mypkg 1.0}
        returns {Depends on the subcommand: require/present return the loaded/matching version (erroring if none is acceptable); provide returns the currently provided version, or an empty string if unset; ifneeded and unknown return the registered script/handler, or an empty string if none is registered (and an empty string otherwise for their setter forms, and for forget); files/names/versions return a list; vcompare returns -1, 0, or 1; vsatisfies returns a boolean; prefer returns "latest" or "stable".}
    }

    subcommand files {
        arity 1
        detail {Lists all files forming part of package, in the order they were sourced during package initialization; auto-loaded files are excluded.}
        synopsis {package files package}
        available {tcl 9.0-}
        return_type List
        pure
    }

    subcommand forget {
        detail {Removes all information about each specified package from this interpreter, clearing both its package ifneeded script(s) and its package provide record.}
        synopsis {package forget ?package package ...?}
        return_type String
        side_effect InterpState -writes
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand ifneeded {
        arity 2..3
        detail {Registers script to be evaluated (in the global namespace) the next time package require needs this version and it is not yet provided; replaces any script already registered for the same package/version pair. With script omitted, returns the currently registered script, or an empty string if none is registered.}
        synopsis {package ifneeded package version ?script?}
        traits {PROVIDES_PACKAGE DEFERS_BODY}
        return_type String
        body_kind Structural
        # TODO(spectcl): `body_execution` is set on the source spec. The DSL
        #   spells it `body_execution -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 0 -role Name
        arg 1 -role Value
        arg 2 -role Body
        analyser_hook -native PackageIfneeded
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand names {
        arity 0
        detail {Returns a list of the names of all packages in the interpreter for which a version has been provided (via package provide) or for which a package ifneeded script is available. The order of elements in the list is arbitrary.}
        synopsis {package names}
        return_type List
        pure
    }

    subcommand prefer {
        arity ..1
        detail {Returns or sets the current mode of selection logic used by package require/present: "stable" (the default) or "latest". Once set to latest, an attempt to set it back to stable is silently ineffective.}
        synopsis {package prefer ?latest|stable?}
        available {tcl 8.5-}
        return_type String
        arg 0 -values-from package-prefer-arg0 -closed
        analyser_hook -native PackagePrefer
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand present {
        arity 1..
        detail {Equivalent to package require, except it never attempts to load the package: it only succeeds when a version satisfying the given requirements has already been provided (via package provide) — it does not consult the package ifneeded database or invoke package unknown.}
        synopsis {package present ?-exact? package ?requirement...?}
        return_type String
        pure
        prefix_matching Strict

        option -exact \
            -detail {Restricts the match to exactly the given version — a single version word, not a requirement list. Equivalent to `package present package version-version`; since present never loads, an exact version that has not already been provided is a hard error, not an attempt to load it.}
    }

    subcommand provide {
        arity 1..2
        detail {Declares that version of package is now present in the interpreter; errors if a different version was already provided. With version omitted, returns the currently provided version, or an empty string if package has not been provided.}
        synopsis {package provide package ?version?}
        traits PROVIDES_PACKAGE
        return_type String
        arg 0 -role Name
        arg 1 -role Value
        analyser_hook -native PackageProvide

        refine query {
            arity 1
            arg 0 -role Name
            side_effect InterpState -reads
        }
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand require {
        arity 1..
        detail {Ensures a version of package satisfying the given requirements is loaded: if not already provided, evaluates the highest-acceptable package ifneeded script (in the global namespace), falling back to package unknown as a last resort. Returns the loaded version; raises an error if no acceptable version becomes available. The highest acceptable version is selected; from Tcl 8.5, this is subject to the package prefer mode (stable by default, preferring a stable version over an unstable one) — Tcl 8.4 has no package prefer and no stable/unstable distinction, so it always simply picks the highest acceptable version.}
        synopsis {package require ?-exact? package ?requirement...?}
        traits LOADS_EXTERNAL_UNIT
        return_type String
        prefix_matching Strict
        arg_role_layout_resolver -native package::require::arg_role_layout_resolver
        arg_role_resolver_roles {Name Value}
        analyser_hook -native PackageRequire
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.

        option -exact \
            -detail {Restricts the match to exactly the given version — a single version word, not a requirement list. Equivalent to `package require package version-version`; a different already-provided version is a hard error.}
    }

    subcommand unknown {
        arity ..1
        detail {Sets the last-resort command invoked by package require when no suitable version is found in the ifneeded database. With command omitted, returns the current handler, or an empty string if none is set; an empty-string command clears it.}
        synopsis {package unknown ?command?}
        return_type String
        script_lookup_scope GlobalFrame
        arg 0 -appends {AtLeast 2}
        script_timing_resolver -native package::unknown::script_timing_resolver
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand vcompare {
        arity 2
        detail {Compares the two version numbers given by version1 and version2: returns -1 if version1 is earlier, 0 if they are equal, or 1 if version1 is later.}
        synopsis {package vcompare version1 version2}
        return_type Int
        pure
    }

    subcommand versions {
        arity 1
        detail {Returns a list of all the version numbers of package for which information has been provided by package ifneeded commands — a package known only via package provide, with no matching ifneeded entry, is not included.}
        synopsis {package versions package}
        return_type List
        pure
    }

    subcommand vsatisfies {
        arity 2
        detail {Returns 1 if version satisfies at least one of the given requirements, 0 otherwise. From Tcl 8.5 (TIP 268) each requirement may be a bare min (min, or a later release with the same major version), min- (min or later, unbounded), or min-max (min inclusive, max exclusive); before 8.5 vsatisfies took exactly one plain version to compare against, under the same "later, same major version" rule.}
        synopsis {package vsatisfies version requirement ?requirement ...?}
        return_type Boolean
        pure

        refine tcl8.4 {
            arity 2
            available {tcl 8.4}
            side_effects none
        }

        refine tcl8.5+ {
            arity 2..
            available {tcl 8.5-}
            side_effects none
        }
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }
}

