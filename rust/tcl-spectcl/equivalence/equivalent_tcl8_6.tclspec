        #   only that the field is set, never the expression that set it.
        mutator
        side_effect FileIo -reads -writes
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.

        option -force \
            -detail {Overwrite an existing destination file, adjusting its permissions first if necessary.}
        option -- \
            -detail {Marks the end of switches; the following word is treated as source even if it starts with -.}
    }

    subcommand delete {
        detail {Removes the file or directory specified by each pathname argument. A non-empty directory is removed only with -force. Operates on a symbolic link itself, never its target. A non-existent pathname is not an error; a read-only file is still deleted regardless of -force.}
        synopsis {file delete ?-force? ?--? ?pathname ...?}
        traits FIRE_AND_FORGET_TEARDOWN
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
