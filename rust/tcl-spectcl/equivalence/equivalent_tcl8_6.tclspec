            option -command -takes prefix -role CommandPrefix -appends {Exactly 2} \
                -detail {Comparison command prefix invoked with the two values appended.}
            option -decreasing -detail {Sort from largest to smallest.}
            option -dictionary -detail {Use dictionary-style string ordering.}
            option -ignoreempty -detail {Permit empty values in integer or real sorts.}
            option -increasing -detail {Sort from smallest to largest (the default).}
            option -integer -detail {Sort values as integers.}
            option -nocase -detail {Ignore case for -ascii sorting.}
            option -real -detail {Sort values as floating-point numbers.}
            option -recurse -aliases -recursive -detail {Sort descendants recursively.}
            option -unicode -detail {Alias for -ascii.}
        }

