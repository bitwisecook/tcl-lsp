command throw {
    available {tcl 8.6-}
    traits {LANGUAGE_KEYWORD TERMINATES_BLOCK BYTE_COMPILED FRAMELESS_RUNTIME CATCHABLE_THROW}
    arity 2

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect InterpState -writes

    runtime_backing shipped-builtin throw

    form Default {throw type message}

    hover {
        summary {Generate a machine-readable error}
        synopsis {throw type message}
        description {Unwinds the current evaluation with an error, with the same effect as `return -code error -errorcode $type $message`. type must be a syntactically valid, non-empty Tcl list of words describing the error in machine-readable form; it becomes the -errorcode return option (and, once trapped, the errorCode global) of the resulting exception. By convention the words in type go from most general to most specific, e.g. {ARITH DIVZERO {divide by zero}}. message is free-form text meant for display to a human and becomes the exception's result string (and, once trapped, the caught value). The stack unwinds until the error is trapped by an enclosing catch or try; an untrapped error that reaches the event loop is reported through bgerror, and one that reaches the top level of tclsh is printed to the console before causing a non-interactive exit (behaviour elsewhere depends on how Tcl is embedded). throw takes no options and has only this one form; it was added in Tcl 8.6 alongside try and does not exist in Tcl 8.4 or 8.5.}
        source {Tcl throw(n)}
        example {# Raise an error identical to what expr produces for division by zero
throw {ARITH DIVZERO {divide by zero}} {divide by zero}

# Catch it and inspect the machine-readable type alongside errorCode
if {[catch {throw {MYAPP NOTFOUND} "widget not found"} msg]} {
    puts "error: $msg ($::errorCode)"
}}
        returns {Never returns to the caller: unconditionally completes with a TCL_ERROR whose result is message and whose -errorcode is type, catchable by an enclosing catch or try.}
    }
}

command ticklecharts::Gridlayout {
    available {tcl 8.4-}
    arity 1..
    required_package ticklecharts

    allow_unknown_subcommands

    manufacturer new -constructor-args-from 1
    manufacturer create -names-instance-at 1 -constructor-args-from 2

    object_class ticklecharts::Gridlayout {
        method Add { detail {Add a chart to the grid layout.} }

        method SetGlobalOptions {
            detail {Set global layout options.}

            option -backgroundColor -takes {} -detail {Chart background colour.}
            option -color -takes {} -detail {Default series colour palette.}
            option -title -takes {} -detail {Title component.}
            option -legend -takes {} -detail {Legend component.}
            option -grid -takes {} -detail {Cartesian grid component.}
            option -tooltip -takes {} -detail {Global tooltip component.}
            option -toolbox -takes {} -detail {Toolbox component.}
            option -dataZoom -takes {} -detail {Data-zoom component.}
            option -visualMap -takes {} -detail {Visual-map component.}
            option -dataset -takes {} -detail {Dataset component.}
            option -polar -takes {} -detail {Polar coordinate component.}
            option -radiusAxis -takes {} -detail {Radius axis (polar).}
            option -angleAxis -takes {} -detail {Angle axis (polar).}
            option -radar -takes {} -detail {Radar coordinate component.}
            option -parallel -takes {} -detail {Parallel coordinate component.}
            option -parallelAxis -takes {} -detail {Parallel axis component.}
            option -singleAxis -takes {} -detail {Single axis component.}
            option -brush -takes {} -detail {Brush (selection) component.}
            option -axisPointer -takes {} -detail {Global axis pointer component.}
            option -geo -takes {} -detail {Geographic coordinate component.}
            option -calendar -takes {} -detail {Calendar coordinate component.}
            option -aria -takes {} -detail {Accessibility (ARIA) component.}
            option -graphic -takes {} -detail {Graphic-element component.}
            option -textStyle -takes {} -detail {Global text style.}
            option -animation -takes {} -detail {Whether global animation is enabled.}
            option -darkMode -takes {} -detail {Whether dark mode is enabled.}
        }

        method Render { detail {Render the layout to an HTML file.} }
        method toHTML { detail {Return the layout as an HTML string.} }
        method toJSON { detail {Return the layout options as JSON.} }
    }

    hover {
        summary {Multi-chart grid layout.}
        synopsis {ticklecharts::CLASS new}
        synopsis {ticklecharts::CLASS create name}
        description {A ticklecharts (Apache ECharts) class. Instantiate with `new`, then configure the returned object handle with its methods.}
        source {ticklecharts (nico-robert)}
    }

    subcommand new { detail {Create a new object with an auto-generated command name.} ; synopsis {new} }
    subcommand create { detail {Create a new object with the given command name.} ; synopsis {create name} }
}

