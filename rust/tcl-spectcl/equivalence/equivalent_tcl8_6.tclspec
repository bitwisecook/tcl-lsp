command encoding {
    available {tcl 8.4-} {f5-irules}
    traits {BYTE_COMPILED SAFE_INTERP_HIDDEN}
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin encoding

    form Default {encoding subcommand ?arg ...?}

    hover {
        summary {Convert between character encodings, and manage encoding-related interpreter state.}
        synopsis {encoding convertfrom ?encoding? data}
        synopsis {encoding convertfrom ?-profile profile? ?-failindex var? encoding data}
        synopsis {encoding convertto ?encoding? data}
        synopsis {encoding convertto ?-profile profile? ?-failindex var? encoding data}
        synopsis {encoding dirs ?directoryList?}
        synopsis {encoding names}
        synopsis {encoding profiles}
        synopsis {encoding system ?encoding?}
        synopsis {encoding user}
        description {convertfrom/convertto move data between Tcl's internal string representation and an external encoding, defaulting to the current system encoding when encoding is omitted. names lists the available encodings (utf-8 and iso8859-1 are always present); system gets or sets the encoding used whenever Tcl passes strings to system calls. dirs (Tcl 8.5+) sets the search path for additional *.enc encoding data files. Tcl 9.0 added the profiles and user subcommands, plus a -profile/-failindex option pair on convertfrom/convertto (TIP 656): -profile picks how a conversion error is handled — strict (the default) raises an exception, tcl8 reproduces Tcl 8.6's lenient byte-mapping/'?'-substitution behaviour, and replace substitutes U+FFFD (or '?' on non-UTF convertto targets) — and -failindex var returns the successfully-converted prefix instead of raising, storing the index of the failing byte (convertfrom) or character (convertto) in var, or -1 if none failed. Code relying on Tcl 8.6's old silent lenient behaviour needs -profile tcl8 under Tcl 9.0+, since strict is now the default.}
        source {Tcl encoding(n)}
        example {encoding names
encoding system
set s [encoding convertfrom utf-8 $bytes]
set bytes [encoding convertto -profile strict iso8859-1 $s]
if {[catch {encoding convertfrom -profile strict -failindex idx ascii $data} result]} {
    puts "bad byte at $idx: $result"
}}
        returns {Depends on the subcommand: convertfrom returns the decoded string, convertto the encoded byte sequence; dirs/names/profiles return a list; system/user return an encoding name. dirs and system also act as setters, in which case they return the empty string.}
    }

    subcommand convertfrom {
        arity 1..6
        detail {Convert data from the specified encoding to a Tcl string; if encoding is omitted, uses the current system encoding.}
        synopsis {encoding convertfrom ?encoding? data}
        traits {UNCONDITIONAL_VARIABLE_WRITE TAINT_SOURCE}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        is_unescape
        side_effect Variable -writes -available {tcl 9.0-}

        option -profile -takes profile -values-from encoding-convertfrom-profile -closed -available {tcl 9.0-} \
            -detail {Encoding profile controlling how a conversion error is handled; defaults to strict.}
        option -failindex -takes var -role VarWrite -available {tcl 9.0-} \
            -detail {Variable to receive the index of the source byte that triggered a conversion error, or -1 if none did. When given, returns the successfully-converted prefix instead of raising an exception on failure.}
    }

    subcommand convertto {
        arity 1..6
        detail {Convert a Tcl string to the specified encoding, returning a byte sequence; if encoding is omitted, uses the current system encoding.}
        synopsis {encoding convertto ?encoding? data}
        traits UNCONDITIONAL_VARIABLE_WRITE
        return_type ByteArray
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        byte_array_effect Encodes

        refine value {
            arity 1..2
            traits FRAMELESS_RUNTIME
            side_effect InterpState -reads
        }
        side_effect Variable -writes -available {tcl 9.0-}

        option -profile -takes profile -values-from encoding-convertfrom-profile -closed -available {tcl 9.0-} \
            -detail {Encoding profile controlling how a conversion error is handled; defaults to strict.}
        option -failindex -takes var -role VarWrite -available {tcl 9.0-} \
            -detail {Variable to receive the index of the source character that triggered a conversion error, or -1 if none did. When given, returns the successfully-converted prefix instead of raising an exception on failure.}
    }

    subcommand dirs {
        arity ..1
        detail {Get or set the search path for *.enc encoding data files. It is an error for directoryList not to be a valid list; an unreadable/unsearchable directory in it is silently ignored when searching.}
        synopsis {encoding dirs ?directoryList?}
        available {tcl 8.5-}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        side_effect InterpState -reads -writes
    }

    subcommand names {
        arity 0
        detail {Return a list of the names of all currently available encodings. utf-8 and iso8859-1 are always present.}
        synopsis {encoding names}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }

    subcommand system {
        arity ..1
        detail {Get or set the system encoding, used whenever Tcl passes strings to system calls.}
        synopsis {encoding system ?encoding?}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        side_effect InterpState -reads -writes
    }

    subcommand profiles {
        arity 0
        detail {Return a list of the names of the available encoding profiles (strict, tcl8, replace).}
        synopsis {encoding profiles}
        available {tcl 9.0-}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }

    subcommand user {
        arity 0
        detail {Return the encoding matching the user's platform preferences: on Windows, derived from the user's code-page registry setting; on other platforms, the same value as encoding system.}
        synopsis {encoding user}
        available {tcl 9.0-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }
}

command entry {
    available {tcl 8.4-} {package Tk}
    traits TAINTS_VAR_WRITES
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class entry -method-prefix-matching Enabled {
        method bbox {
            arity 1
            detail {Return the bounding box of the character at the given index.}
            synopsis {pathName bbox index}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method cget {
            arity 1
            detail {Return the current value of an entry option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change entry options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method delete {
            arity 1..2
            detail {Delete characters from first through last (or just the character at first).}
            synopsis {pathName delete first ?last?}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method get {
            arity 0
            detail {Return the entry's current string contents.}
            synopsis {pathName get}
            traits TAINT_SOURCE
            return_type String
            pure
            side_effect InterpState -reads
        }

        method icursor {
            arity 1
            detail {Move the insertion cursor to just before the character at the given index.}
            synopsis {pathName icursor index}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method index {
            arity 1
            detail {Return the numerical index corresponding to the given index.}
            synopsis {pathName index index}
            return_type Int
            pure
            side_effect InterpState -reads
        }

        method insert {
            arity 2
            detail {Insert the string just before the character at the given index.}
            synopsis {pathName insert index string}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method scan {
            arity 2
            detail {Implement fast scanning/scrolling; option is mark or dragto.}
            synopsis {pathName scan option arg}
            mutator
            side_effect InterpState -reads -writes
        }

        method selection {
            arity 1..
            detail {Manipulate the selection; option is adjust, clear, from, present, range, or to.}
            synopsis {pathName selection option ?arg ...?}
            return_type String
            mutator

            refine present {
                arity 1
                selector present
                traits PURE
                mutator no
                side_effect InterpState -reads
            }
            side_effect InterpState -reads -writes
        }

        method validate {
            arity 0
            detail {Force revalidation of the entry using its -validatecommand.}
            synopsis {pathName validate}
            traits EVALUATES_CODE
            return_type Boolean
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method xview {
            detail {Query or change the horizontal position of the text visible in the entry.}
            synopsis {pathName xview ?args?}
            return_type List
            mutator

            refine query {
                arity 0
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine move {
                arity 1..
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
            side_effect InterpState -reads -writes
        }
    }

    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global -taints-var-write \
        -detail {Name of a variable linked to the entry's contents.}
    option -background -takes color -detail {Normal background colour of the entry.}
    option -borderwidth -takes {screen units} \
        -detail {Width of the border around the entry.}
    option -foreground -takes color -detail {Normal foreground colour of the entry.}
    option -locale -takes {locale name} -introduced 9.1 \
        -detail {Locale used to determine word and character boundaries (Tk 9.1+).}
    option -width -takes {} -detail {Desired width of the entry in average-size characters.}
    option -state -takes {} -detail {State of the entry: normal, disabled, or readonly.}
    option -show -takes {} \
        -detail {Character to display instead of actual contents (e.g. '*' for passwords).}
    option -font -takes {} -detail {Font to use for text in the entry.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -placeholder -takes text -introduced 8.7 \
        -detail {Help text shown when the entry is empty (Tk 8.7+).}
    option -placeholderforeground -takes color -introduced 8.7 \
        -detail {Foreground colour of the placeholder text (Tk 8.7+).}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of text within the entry: left, center, or right.}
    option -insertbackground -takes {} -detail {Colour of the insertion cursor.}
    option -insertborderwidth -takes {} \
        -detail {Width of the border around the insertion cursor.}
    option -insertofftime -takes {} \
        -detail {Milliseconds the insertion cursor is off during blinking.}
    option -insertontime -takes {} \
        -detail {Milliseconds the insertion cursor is on during blinking.}
    option -insertwidth -takes {} -detail {Width of the insertion cursor in screen units.}
    option -selectbackground -takes {} -detail {Background colour for selected text.}
    option -selectborderwidth -takes {} -detail {Width of the border around selected text.}
    option -selectforeground -takes {} -detail {Foreground colour for selected text.}
    option -xscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for communicating with horizontal scrollbars.}
    option -exportselection -takes {} \
        -detail {Whether the selection is exported to the X selection.}
    option -readonlybackground -takes {} \
        -detail {Background colour when the entry is in readonly state.}
    option -validate -takes {} \
        -detail {Validation mode: none, focus, focusin, focusout, key, or all.}
    option -validatecommand -takes {} -role Body -body-kind Structural -script-timing Deferred -callback-taint-inputs {%P %s %S} \
        -detail {Script to evaluate when validation is triggered.}
    option -invalidcommand -takes {} -role Body -body-kind Structural -script-timing Deferred -callback-taint-inputs {%P %s %S} \
        -detail {Script to evaluate when validation fails.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the entry.}
    option -takefocus -takes {} \
        -detail {Whether the entry accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the entry does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the entry has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the entry.}
    option -disabledbackground -takes color \
        -detail {Background colour while disabled; empty uses the normal background.}
    option -disabledforeground -takes color \
        -detail {Foreground colour while disabled; empty uses the normal foreground.}

    form Default {entry pathName ?option value ...?}

    hover {
        summary {Create and manipulate a single-line text entry widget.}
        synopsis {entry pathName ?option value ...?}
        description {Displays a one-line text string and allows the user to edit it using standard editing characters.}
        source {Tk man page entry.n}
    }

    subcommand bbox {
        arity 1
        detail {Return the bounding box of the character at the given index.}
        synopsis {pathName bbox index}
        return_type List
        pure
        side_effect InterpState -reads
    }

    subcommand cget {
        arity 1
        detail {Return the current value of an entry option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change entry options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand delete {
        arity 1..2
        detail {Delete characters from first through last (or just the character at first).}
        synopsis {pathName delete first ?last?}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand get {
        arity 0
        detail {Return the entry's current string contents.}
        synopsis {pathName get}
        traits TAINT_SOURCE
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand icursor {
        arity 1
        detail {Move the insertion cursor to just before the character at the given index.}
        synopsis {pathName icursor index}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand index {
        arity 1
        detail {Return the numerical index corresponding to the given index.}
        synopsis {pathName index index}
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand insert {
        arity 2
        detail {Insert the string just before the character at the given index.}
        synopsis {pathName insert index string}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand scan {
        arity 2
        detail {Implement fast scanning/scrolling; option is mark or dragto.}
        synopsis {pathName scan option arg}
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand selection {
        arity 1..
        detail {Manipulate the selection; option is adjust, clear, from, present, range, or to.}
        synopsis {pathName selection option ?arg ...?}
        return_type String
        mutator

        refine present {
            arity 1
            selector present
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }

    subcommand validate {
        arity 0
        detail {Force revalidation of the entry using its -validatecommand.}
        synopsis {pathName validate}
        traits EVALUATES_CODE
        return_type Boolean
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand xview {
        detail {Query or change the horizontal position of the text visible in the entry.}
        synopsis {pathName xview ?args?}
        return_type List
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }
}

command eof {
    available {tcl 8.4-}
    traits BYTE_COMPILED
    arity 1

    return_type Boolean
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Channel

    side_effect FileIo -reads

    runtime_backing shipped-builtin eof

    form Default {eof channel}

    hover {
        summary {Check for end of file condition on channel}
        synopsis {eof channel}
        description {Returns 1 if an end-of-file condition occurred during the most recent input operation on channel (such as gets or read), 0 otherwise. eof performs no I/O of its own; it only reports the outcome of the last read, so a later read that reaches new data (for example on a pipe or socket where more input arrives) can clear the condition again. Tcl 8.5 introduced chan eof, an equivalent command reached through the chan ensemble; from Tcl 9.0 the eof manual page documents itself purely as an alias for chan eof, though eof keeps working exactly as before in every version through 9.1.}
        source {Tcl eof(n)}
        example {set f [open somefile.txt]
while {1} {
    set line [gets $f]
    if {[eof $f]} {
        close $f
        break
    }
    puts "Read line: $line"
}}
        returns {1 if the channel is at end-of-file, 0 otherwise.}
    }
}

command eq {
    available {tcl 8.5-}
    traits {PURE OPERATOR_COMMAND}

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    form Default {eq ?arg ...?}

    hover {
        summary {string equality}
        synopsis {eq ?arg ...?}
        description {The eq operator command. Available via namespace import ::tcl::mathop::*.}
        source {Tcl man page mathop.n}
    }
}

command error {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD TERMINATES_BLOCK NEEDS_START_CMD BYTE_COMPILED FRAMELESS_RUNTIME CATCHABLE_THROW}
    arity 1..3

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    inline_codegen_hook -native Error
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect InterpState -writes

    runtime_backing shipped-builtin error

    form Default {error message ?info? ?code?}

    hover {
        summary {Generate an error}
        synopsis {error message ?info? ?code?}
        description {Returns a TCL_ERROR code that unwinds command interpretation, catchable with catch (or, from Tcl 8.6 on, try). message becomes the error result. The optional info, when given, seeds the -errorinfo return option (the errorInfo global in Tcl 8.4) and suppresses the interpreter's own first increment of stack-trace information — the command containing this error call is then omitted from the trace and info appears in its place, letting a catch handler graft a previously captured trace onto a re-thrown error. The optional code, when given, becomes the -errorcode return option (the errorCode global in Tcl 8.4), a machine-readable error identifier conventionally formatted as a list; when code is omitted, errorCode/-errorcode is reset to "NONE". From Tcl 8.5 on, prefer catching with the options-dictionary form and re-throwing via `return -options` over hand-copying errorInfo, since it preserves errorCode and every other return option too.}
        source {Tcl error(n)}
        example {if {$divisor == 0} {
    error "cannot divide by zero" "" {ARITH DIVZERO {divide by zero}}
}

# Re-throw with the original trace and error code intact (Tcl 8.5+)
if {[catch {doWork} result options]} {
    return -options $options $result
}}
        returns {Never returns to the caller: unconditionally completes with a TCL_ERROR whose result is message, catchable by an enclosing catch (or, from Tcl 8.6 on, try).}
    }
}

command eval {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD CREATES_BARRIER EVALUATES_CODE TAINT_SINK CREATES_DYNAMIC_BARRIER BYTE_COMPILED NOT_PROC_FACTORY DYNAMIC_EVAL_BODY SCRIPT_CONCATENATES_ARGS}
    arity 1..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Body

    lowering_hook -native Eval

    side_effect Unknown
    # TODO(spectcl): `frame_effect` is set on the source spec. The DSL spells it
    #   `frame_effect -level-word W -layout L`, but a draft records only that
    #   the field is set, never the expression that set it.

    taint_sink_safe_colour LIST_CANONICAL

    xc_translatable no
    runtime_backing shipped-builtin eval

    form Default {eval arg ?arg ...?}

    hover {
        summary {Evaluate one or more arguments as a Tcl script.}
        synopsis {eval arg ?arg ...?}
        description {Concatenates all of its arguments in the same fashion as `concat`, then passes the result to the Tcl interpreter recursively as a script, evaluated in the caller's own variable/procedure context — unlike `uplevel`, `eval` never changes stack frame.

Because the `list` command quotes words so that they are not further expanded by `eval`, `eval [list $a $b $c]` and `$a $b $c` are equivalent for any values of $a, $b, and $c; this is what makes it safe to rebuild and re-run a command from a `list`-built value.

**Security**: any argument built from unsanitised input becomes arbitrary code once concatenated and evaluated — `eval` is a taint sink. In the common case of expanding a pre-built word list, prefer `{*}$cmdList` (Tcl 8.5+) instead: it is less general than `eval` but, since it never re-parses the words as script text, far easier to keep safe.}
        source {Tcl eval(n)}
        example {set script {puts "logging now"}
eval $script

# Safe: list-quoted words are not re-split, so this is equivalent to
# calling the command directly.
set cmd [list string index $line 0]
eval $cmd

# Prefer {*} to expand a pre-built word list instead (Tcl 8.5+):
set argsList [list -nocase $pattern $line]
set matched [string match {*}$argsList]}
        returns {The result of evaluating the concatenated script, or the error it raises — propagated as eval's own result, including any -errorinfo/-errorcode/-level the script's error carried.}
    }
}

command event {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    side_effect InterpState -writes

    option -above -takes window \
        -detail {Specifies the above field for the event (generate).}
    option -borderwidth -takes size \
        -detail {Specifies the border width for the event (generate).}
    option -button -takes number \
        -detail {Specifies the button number for a ButtonPress or ButtonRelease event.}
    option -count -takes number -detail {Specifies the count field for the event.}
    option -data -takes string -detail {Specifies user data for a virtual event.}
    option -delta -takes number -detail {Specifies the delta field for a MouseWheel event.}
    option -detail -takes detail -detail {Specifies the detail field for the event.}
    option -focus -takes boolean -role Boolean \
        -detail {Specifies the focus field for the event.}
    option -height -takes size -detail {Specifies the height field for the event.}
    option -keycode -takes number -detail {Specifies the keycode field for the event.}
    option -keysym -takes name -detail {Specifies the keysym field for the event.}
    option -mode -takes notify -detail {Specifies the mode field for the event.}
    option -override -takes boolean -role Boolean \
        -detail {Specifies the override-redirect field.}
    option -place -takes where -detail {Specifies the place field for the event.}
    option -root -takes window -detail {Specifies the root field for the event.}
    option -rootx -takes coord \
        -detail {Specifies the x-coordinate relative to the root window.}
    option -rooty -takes coord \
        -detail {Specifies the y-coordinate relative to the root window.}
    option -sendevent -takes boolean -role Boolean -detail {Specifies the send-event field.}
    option -serial -takes number -detail {Specifies the serial number field.}
    option -state -takes state -detail {Specifies the state field for the event.}
    option -subwindow -takes window -detail {Specifies the sub-window field.}
    option -time -takes integer -detail {Specifies the time field for the event.}
    option -warp -takes boolean -role Boolean \
        -detail {Specifies whether the screen pointer should be warped.}
    option -width -takes size -detail {Specifies the width field for the event.}
    option -when -takes now|tail|head|mark -detail {Specifies when the event is processed.}
    option -x -takes coord -detail {Specifies the x field for the event.}
    option -y -takes coord -detail {Specifies the y field for the event.}

    form Default {event option ?arg ...?}

    hover {
        summary {Generate, manage, and inspect virtual events.}
        synopsis {event add <<virtual>> sequence ?sequence ...?}
        synopsis {event delete <<virtual>> ?sequence sequence ...?}
        synopsis {event generate window event ?option value ...?}
        synopsis {event info ?<<virtual>>?}
        source {Tk man page event.n}
    }

    subcommand add {
        arity 2..
        detail {Associate a virtual event with one or more physical event sequences.}
        synopsis {event add <<virtual>> sequence ?sequence ...?}
    }

    subcommand delete {
        arity 1..
        detail {Delete physical event sequences from a virtual event.}
        synopsis {event delete <<virtual>> ?sequence sequence ...?}
    }

    subcommand generate {
        arity 2..
        detail {Generate an event and arrange for it to be processed.}
        synopsis {event generate window event ?option value ...?}

        option -above -takes window \
            -detail {Specifies the above field for the event (generate).}
        option -borderwidth -takes size \
            -detail {Specifies the border width for the event (generate).}
        option -button -takes number \
            -detail {Specifies the button number for a ButtonPress or ButtonRelease event.}
        option -count -takes number -detail {Specifies the count field for the event.}
        option -data -takes string -detail {Specifies user data for a virtual event.}
        option -delta -takes number \
            -detail {Specifies the delta field for a MouseWheel event.}
        option -detail -takes detail -detail {Specifies the detail field for the event.}
        option -focus -takes boolean -role Boolean \
            -detail {Specifies the focus field for the event.}
        option -height -takes size -detail {Specifies the height field for the event.}
        option -keycode -takes number -detail {Specifies the keycode field for the event.}
        option -keysym -takes name -detail {Specifies the keysym field for the event.}
        option -mode -takes notify -detail {Specifies the mode field for the event.}
        option -override -takes boolean -role Boolean \
            -detail {Specifies the override-redirect field.}
        option -place -takes where -detail {Specifies the place field for the event.}
        option -root -takes window -detail {Specifies the root field for the event.}
        option -rootx -takes coord \
            -detail {Specifies the x-coordinate relative to the root window.}
        option -rooty -takes coord \
            -detail {Specifies the y-coordinate relative to the root window.}
        option -sendevent -takes boolean -role Boolean \
            -detail {Specifies the send-event field.}
        option -serial -takes number -detail {Specifies the serial number field.}
        option -state -takes state -detail {Specifies the state field for the event.}
        option -subwindow -takes window -detail {Specifies the sub-window field.}
        option -time -takes integer -detail {Specifies the time field for the event.}
        option -warp -takes boolean -role Boolean \
            -detail {Specifies whether the screen pointer should be warped.}
        option -width -takes size -detail {Specifies the width field for the event.}
        option -when -takes now|tail|head|mark \
            -detail {Specifies when the event is processed.}
        option -x -takes coord -detail {Specifies the x field for the event.}
        option -y -takes coord -detail {Specifies the y field for the event.}
    }

    subcommand info { arity ..1 ; detail {Return information about virtual events.} ; synopsis {event info ?<<virtual>>?} }
}

command exec {
    available {tcl 8.4-}
    traits {UNSAFE TAINT_SINK TAINT_SOURCE BYTE_COMPILED SAFE_INTERP_HIDDEN}
    arity 1..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect Process -reads -writes
    side_effect InterpState -writes

    taint_sink_safe_colour SHELL_ATOM

    option -encoding -takes encodingName -available {tcl 9.0-} \
        -detail {Encoding used to decode subprocess output captured by exec, defaulting to the interpreter's system encoding ([encoding system]). Added in Tcl 9.0; earlier Tcl always uses the system encoding, and other encodings (including raw binary) require opening and reading the pipeline explicitly.}
    option -ignorestderr -available {tcl 8.5-} \
        -detail {Stops exec from treating unredirected output on a subprocess's stderr as an error case. Added in Tcl 8.5; in 8.4 any unredirected stderr output always makes exec raise an error.}
    option -keepnewline \
        -detail {Retains a trailing newline in the pipeline's result or error message; normally a single trailing newline is deleted.}
    option -- \
        -detail {Marks the end of switches; the following argument is treated as the first pipeline word even if it begins with -.}

    form Default {exec ?switches? arg ?arg ...? ?&?}

    hover {
        summary {Invoke one or more subprocesses as a shell-style pipeline.}
        synopsis {exec ?switches? arg ?arg ...? ?&?}
        description {Non-switch words either become literal arguments of the current subprocess or are pipeline syntax that is stripped before exec'ing and never reaches it: | and |& start a new subprocess piped from the previous one's stdout (or stdout+stderr); <, <@, and << set the first subprocess's stdin from a file, an already-open channel, or a literal value; >, >>, 2>, 2>>, >&, >>&, >@, 2>@, and >&@ redirect a subprocess's stdout/stderr to a file or open channel, and 2>@1 (Tcl 8.5+) folds stderr into exec's own result instead of a file. The first word of each subprocess command is tilde-substituted in Tcl 8.4-8.6 only (that step was dropped in Tcl 9.0) and then, if it has no slash, a PATH search is performed; no glob expansion or other shell substitution is performed on any argument. Unredirected stderr output from any subprocess is treated as an error, as is an abnormal exit (killed, suspended, or nonzero status) — see -ignorestderr. A trailing bare & backgrounds the whole pipeline instead of waiting for it, returning subprocess identifiers rather than output.}
        source {Tcl exec(n)}
        example {exec ls -l /tmp
exec sort < in.txt | uniq -c > out.txt
set matches [exec grep -c foo $path 2>@1]
set pids [exec sleep 30 &]}
        returns {The standard output of the last subprocess in the pipeline, decoded with -encoding (Tcl 9.0+) or otherwise the system encoding, with one trailing newline stripped unless -keepnewline is given. With a trailing &, a list of the pipeline's subprocess process identifiers instead.}
    }
}

command exit {
    available {tcl 8.4-}
    traits {TERMINATES_BLOCK TERMINATES_PROCESS BYTE_COMPILED SAFE_INTERP_HIDDEN}
    arity ..1

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect InterpState -writes

    runtime_backing shipped-builtin exit

    form Default {exit ?returnCode?}

    hover {
        summary {End the application}
        synopsis {exit ?returnCode?}
        description {Terminates the process immediately, returning returnCode to the system as the exit status; nothing after the call runs, in this command or anywhere else in the process. returnCode must be an integer and defaults to 0 (success) when omitted. Non-zero codes are conventionally interpreted as error cases by the calling process, so exit is commonly used at the end of a top-level error handler to signal a fatal condition with a distinct status.}
        source {Tcl exit(n)}
        example {if {[catch {main} msg]} {
    puts stderr "unexpected script error: $msg"
    exit 2
}
exit 0}
        returns {Never returns: the process terminates immediately and no value comes back to the calling script.}
    }
}

command export {
    available {tcl 8.4-}
    arity 2
    required_package pt_export_api
    tcllib_package pt_export_api

    hover {
        summary {This command has to accept the canonical serialization of a parsing expression grammar and the configuration for }
        synopsis {export serial configuration}
        source {tcllib package}
    }
}

command expr {
    available {tcl 8.4-} {f5-irules}
    traits {PURE_EVALUATION NEEDS_START_CMD TAINT_SINK BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME EXPR_CONCATENATES_ARGS}
    arity 1..

    return_type Numeric
    representation_effect {CoerceExpressionValues 0}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Expr -type Numeric -shimmers

    lowering_hook -native Expr
    inline_codegen_hook -native Expr

    side_effect Unknown -reads

    runtime_backing shipped-builtin expr

    form Default {expr arg ?arg arg ...?}

    hover {
        summary {Evaluate a Tcl expression.}
        synopsis {expr arg ?arg arg ...?}
        description {**Always brace expressions**: `expr {$a + $b}`.

Without braces, `expr $x + 1` undergoes double substitution: the Tcl parser expands `$x` first, then `expr` evaluates the result. If `$x` contains `[dangerous_command]`, it executes. Bracing also enables bytecode compilation for better performance — and does not fully neutralise the risk, since a bracketed command inside a braced expression (`expr {[cmd]}`) is still executed as part of evaluating the operand.

Operands may be numbers, booleans (any form `string is boolean` accepts), `$variables`, double- or brace-quoted strings, bracketed commands, or `func(...)` calls into the `tcl::mathfunc` namespace (Tcl 8.5+; in 8.4 math functions exist only as expr syntax, with no namespace-command form).

The expression grammar has grown over releases. Tcl 8.5 added the exponentiation operator `**`, the list-membership operators `in`/`ni`, `Inf`/`NaN` floating-point literals, explicit `0b`/`0o` integer prefixes, and switched integer arithmetic to arbitrary precision (LibTomMath) — Tcl 8.4 computed integers with fixed-width C `long`/`wide` types. Tcl 9.0 added the always-UNICODE-string relational operators `lt`/`gt`/`le`/`ge`, an explicit `0d` decimal prefix, `_` digit separators (`1_000_000`), and removed the ambiguous "leading zero means octal" reading (`013` is decimal 13, not octal 11, as of 9.0).

In F5 iRules, `expr` runs on an embedded Tcl 8.4.6 core, so none of the 8.5+/9.0+ additions above are available: no `**`, `in`/`ni`, `lt`/`gt`/`le`/`ge`, `Inf`/`NaN`, or `0b`/`0o`/`0d` prefixes, and integers stay fixed-width.}
        source {Tcl expr(n)}
        example {expr {8.2 + 6}
expr {($x*$x - $y*$y) / exp($x*$x + $y*$y)}
expr {$a eq $b ? "equal" : "different"}
set randNum [expr {int(100 * rand())}]}
        returns {The value of the evaluated expression — typically numeric, but a bare operand (e.g. `expr {$x}`) or a ternary branch can pass through an arbitrary string or list value unchanged.}
    }
}

command fblocked {
    available {tcl 8.4-}
    traits BYTE_COMPILED
    arity 1

    return_type Boolean
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Channel

    side_effect FileIo -reads

    runtime_backing shipped-builtin fblocked

    form Default {fblocked channel}

    hover {
        summary {Test whether the last input operation on a channel was blocked by exhausted input.}
        synopsis {fblocked channel}
        description {Returns 1 if the most recent input operation on channel (gets, read, and similar) returned less data than requested because all available input was exhausted, and 0 otherwise. For example, if gets is called on a non-blocking channel that currently has only three characters available and no end-of-line sequence, gets returns an empty string and a following fblocked call returns 1. This lets network servers process input line by line on non-blocking channels without stalling other connections while a line is still incomplete. chan blocked (Tcl 8.5 and later) is the ensemble-style equivalent with identical syntax; from Tcl 9.0 onward it is the form Tcl's own documentation recommends, though fblocked keeps working unchanged.}
        source {Tcl fblocked(n)}
        example {fconfigure $chan -blocking 0 -buffering line
fileevent $chan readable [list onReadable $chan]

proc onReadable {chan} {
    gets $chan line
    if {[eof $chan]} {
        close $chan
    } elseif {![fblocked $chan]} {
        puts "got: $line"
    }
}}
        returns {1 if the last input operation was blocked by exhausted input, 0 otherwise.}
    }
}

command fconfigure {
    available {tcl 8.4-}
    traits {BYTE_COMPILED SAFE_INTERP_HIDDEN}
    arity 1..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Channel
    option_prefix_words 1

    side_effect FileIo -reads -writes

    channel_configuration EncodingTranslation

    runtime_backing shipped-builtin fconfigure

    option -blocking -takes boolean -role Boolean \
        -detail {Whether I/O on the channel may block the process indefinitely. Must be a proper boolean; channels are blocking by default. Placing a channel in nonblocking mode affects gets, read, puts, flush, and close, and requires an active Tcl event loop (vwait, or Tcl_DoOneEvent) to drive it.}
    option -buffering -takes mode -values-from fconfigure-buffering -closed \
        -detail {full, line, or none — see the value list for the per-mode default.}
    option -buffersize -takes size \
        -detail {Integer buffer size in bytes for buffers subsequently allocated for this channel. Tcl 8.4 and 8.5 require a value between 10 and 1,000,000; Tcl 8.6 lowers the minimum to 1; the Tcl 9.0/9.1 documentation states only the 1,000,000-byte ceiling, without restating a minimum.}
    option -encoding -takes encoding \
        -detail {Character encoding used to convert the channel's bytes to/from Tcl's internal string representation for reading and writing, e.g. shiftjis for a Japanese file. Defaults to the platform- and locale-dependent system encoding (see encoding system). Tcl 8.5/8.6's chan.n documents binary itself as a legal special encoding-name value for pure-binary data (matching fconfigure.n's own recommendation in every 8.4-8.6 source); Tcl 9.0's chan.n drops binary from its -encoding description (listing only "the named encodings returned by encoding names") and recommends iso8859-1 for binary data instead — see the binary -translation value below for the same shift.}
    option -eofchar -takes char \
        -detail {A character that signals end-of-file when encountered on input. Tcl 8.5 onward documents an acceptable range of \x01–\x7f (setting a value outside it is an error); Tcl 8.4's documentation states no such range restriction. Tcl 8.4 through 8.6 document that the character is also written on output when the channel closes, and that the default is the empty string everywhere except Windows file reads, where it defaults to Control-Z (\x1a); Tcl 9.0/9.1's chan.n (fconfigure.n itself is a stub for those two versions) narrows the description to input-signalling only, stating simply that the default is 'no special end of file character marker' without restating the output-write behaviour or the Windows exception. Tcl 8.4 through 8.6 additionally accept a {inChar outChar} two-element list to set independent input/output eofchars on a read-write channel, returned as a two-element list when queried; Tcl 9.0 removed the two-element form — only a single value is accepted and it applies to both directions.}
    option -profile -takes profile -values-from chan-configure-profile -closed -available {tcl 9.0-} \
        -detail {Encoding profile controlling how conversion errors on this channel's -encoding are handled (see PROFILES in encoding(n)). Defaults to strict.}
    option -translation -takes mode -values-from fconfigure-translation \
        -detail {End-of-line translation mode; also accepts a {inTranslation outTranslation} two-element list to set input and output translation independently on a read-write channel (returned as a two-element list when queried). See the value list for per-mode behaviour and defaults.}
    option -nodelay -takes boolean -role Boolean -available {tcl 9.0-} \
        -detail {TCP_NODELAY on a socket channel (Tcl 9.0+, TIP 344): disables Nagle's algorithm so small writes are sent immediately instead of being coalesced and delayed. Boolean value. Documented on socket(n).}
    option -keepalive -takes boolean -role Boolean -available {tcl 9.0-} \
        -detail {SO_KEEPALIVE on a socket channel (Tcl 9.0+, TIP 344): enables periodic keepalive probes on an otherwise idle connection. Boolean value. Documented on socket(n).}
    option -inputmode -takes mode -values-from fconfigure-inputmode -closed -available {tcl 9.0-} \
        -detail {Interactive input mode of a serial channel (Unix) or a console channel (Windows stdin/stdout) — Tcl 9.0+. Setting it to anything other than normal arranges for the terminal/console to be automatically reset when the channel is closed. Documented on open(n).}

    form Default {fconfigure channelId ?optionName? ?value ...?}

    hover {
        summary {Set and get options on a channel.}
        synopsis {fconfigure channelId}
        synopsis {fconfigure channelId optionName}
        synopsis {fconfigure channelId optionName value ?optionName value ...?}
        description {With no optionName or value, returns a list of alternating option names and values for the channel. With optionName alone, returns that option's current value. With one or more optionName/value pairs, sets each option and returns the empty string. -blocking, -buffering, -buffersize, -encoding, -eofchar, and -translation apply to every channel; -profile is Tcl 9.0+; -nodelay/-keepalive only apply to socket channels (Tcl 9.0+) and -inputmode only to serial/console channels (Tcl 9.0+). Each channel type may also add its own options beyond this generic set — see socket(n) and open(n). Superseded by chan configure (Tcl 8.5+), which accepts the same syntax and options; fconfigure itself remains available as a compatibility form.}
        source {Tcl fconfigure(n)}
        example {fconfigure stdout -buffering none
fconfigure $sock -blocking 0
set settings [fconfigure $chan]
fconfigure $f -translation binary -eofchar {}}
        returns {A list of alternating option/value pairs, a single option's value, or the empty string, depending on how many arguments follow channelId.}
    }
}

command fcopy {
    available {tcl 8.4-}
    traits BYTE_COMPILED
    arity 2..

    return_type Int
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Channel
    arg 1 -role Channel

    side_effect FileIo -reads -writes

    option -size -takes size \
        -detail {Maximum amount of data to transfer before stopping; without it, fcopy copies until end of file. Counted in bytes when the input channel is in binary mode, in characters otherwise (Tcl 9.0+); Tcl 8.6 counted bytes only when both channels shared an encoding, and Tcl 8.4/8.5 counted bytes unconditionally.}
    option -command -takes callback -role CommandPrefix -script-timing Deferred -appends {AtLeast 1} \
        -detail {Run the copy in the background and return immediately; callback is invoked when the copy completes or fails, with the byte/character count appended and an error-message argument on failure. inputChan/outputChan are switched to non-blocking mode automatically; an active event loop (vwait or Tk) is required to drive the copy.}

    form Default {fcopy inputChan outputChan ?-size size? ?-command callback?}

    hover {
        summary {Copy data from one channel to another, synchronously or in the background.}
        synopsis {fcopy inputChan outputChan ?-size size? ?-command callback?}
        description {Transfers data from inputChan to outputChan until -size bytes/characters have been copied or end of file is reached, whichever comes first; without -size, fcopy copies to end of file. Without -command, fcopy blocks until the copy finishes and returns the count written to outputChan. With -command, fcopy returns immediately and runs the copy in the background, invoking callback with the count (and an error message on failure) once it completes; if either channel is closed mid-copy, the copy stops silently and callback is never invoked. Only same-direction I/O is barred while a background copy runs — further reads on inputChan or writes on outputChan get a "channel busy" error — but a simultaneous fcopy in the opposite direction is fine (Tcl 8.6+, and is how a bidirectional copy pair is built); Tcl 8.4/8.5 instead barred all other I/O on either channel during a background copy. fcopy honors each channel's -translation and -encoding (and, from Tcl 9.0, -profile) configuration; the reported count is always outputChan's byte/character count, which can differ from the amount read from inputChan. From Tcl 9.0, fcopy can raise an encoding error (POSIX EILSEQ) when either channel uses the "strict" encoding profile.}
        source {Tcl fcopy(n)}
        example {fcopy $in $out
fcopy $in $out -size 4096
fcopy $in $out -command [list onCopyDone $in $out]}
        returns {Synchronous: the number of bytes written to outputChan (or characters, under the same bytes/characters rule as -size, from Tcl 8.6 on — Tcl 8.4/8.5 always counted bytes). Asynchronous (-command given): fcopy returns immediately and the count is delivered to the callback instead.}
    }
}

command file {
    available {tcl 8.4-}
    traits {RETURNS_PATH BYTE_COMPILED SAFE_INTERP_HIDDEN}
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect FileIo -reads -writes

    runtime_backing shipped-builtin file

    form Default {file option name ?arg arg ...?}

    hover {
        summary {Manipulate file names and attributes}
        synopsis {file option name ?arg arg ...?}
        description {Dispatches on option to one of many operations on a file's name (dirname/tail/extension/join/split/normalize, all pure string or path-table operations) or its on-disk attributes (exists/isdirectory/isfile/readable/writable/executable/owned, atime/mtime/size/type/stat, copy/rename/delete/mkdir, link/readlink, attributes). name undergoes tilde substitution if it starts with ~. Any unique abbreviation of option is accepted, matching Tcl's ensemble-style dispatch.}
        source {Tcl file(n)}
        example {file exists $path
file mkdir [file dirname $path]
file copy -force $src $dst
set ext [file extension $path]
file stat $path st
puts $st(size)}
        returns {Depends on option: a boolean (0/1), a path string, an integer, a list, a dict, or an empty string.}
    }

    subcommand atime {
        arity 1..2
        detail {Returns a decimal string giving the time at which file name was last accessed; if time is given, sets the access time instead. On Windows FAT filesystems atime is unsupported; on zipfs it is mapped to the modification time.}
        synopsis {file atime name ?time?}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        mutator
        side_effect FileIo -reads -writes
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand attributes {
        arity 1..
        detail {Query or set platform-specific file attributes: with no option, lists every attribute and its value; with an option only, returns that value; with option/value pairs, sets them. Available attributes are platform-specific (-permissions/-owner/-group on Unix, -archive/-hidden/-readonly/-system on Windows, -creator/-rsrclength on macOS); files inside a zipfs-mounted archive additionally expose read-only -archive/-compsize/-crc/-mount/-offset/-uncompsize attributes (Tcl 9.0+).}
        synopsis {file attributes name
file attributes name option
file attributes name option value ?option value ...?}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        mutator
        side_effect FileIo -reads -writes
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand channels {
        arity ..1
        detail {Returns a list of names of all registered open channels in this interpreter, or only those matching pattern (using the same rules as string match) if given.}
        synopsis {file channels ?pattern?}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
    }

    subcommand copy {
        arity 2..
        detail {Copy a file or directory (recursively) to target, or one or more sources into an existing targetDir. Does not overwrite an existing destination unless -force is given, which also adjusts destination permissions if needed; overwriting a non-empty directory, a directory with a file, or a file with a directory is always an error. Symbolic links are copied as links, not their targets.}
        synopsis {file copy ?-force? ?--? source target
file copy ?-force? ?--? source ?source ...? targetDir}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
