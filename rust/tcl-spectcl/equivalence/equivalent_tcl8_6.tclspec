        method search {
            arity 2..23
            detail {Search an item's children using comparison and traversal options.}
            synopsis {pathName search parent ?options? pattern}
            introduced_version 9.1
            return_type String
            pure
            side_effect InterpState -reads

            option -all -detail {Return every match instead of only the first.}
            option -ascii -detail {Compare values as Unicode strings (the default).}
            option -backwards -detail {Search backwards from the start item or cell.}
            option -cell \
                -detail {Return cell identifiers and interpret start and stop as cells.}
            option -columns -takes columnList \
                -detail {Limit the search to the listed columns.}
            option -dictionary \
                -detail {Use dictionary-style, case-insensitive string comparison.}
            option -exact -detail {Match the pattern as an exact string (the default).}
            option -forwards \
                -detail {Search forwards from the start item or cell (the default).}
            option -glob -detail {Interpret pattern using string-match glob rules.}
            option -hidden -detail {Include hidden items and descendants of closed items.}
            option -integer -detail {Compare pattern and non-empty cell values as integers.}
            option -nocase -detail {Use case-insensitive string matching.}
            option -not -detail {Return values that do not match the pattern.}
            option -real \
                -detail {Compare pattern and non-empty cell values as floating-point numbers.}
            option -recurse -aliases -recursive -detail {Search all descendants of parent.}
            option -regexp -detail {Interpret pattern as an advanced regular expression.}
            option -start -takes itemOrCell -detail {Start at this descendant item or cell.}
            option -stop -takes itemOrCell \
                -detail {Stop after searching this descendant item or cell.}
            option -unicode -detail {Alias for -ascii.}
            option -wraparound \
                -detail {Wrap from one end of the search range to the other when -start is used.}
        }

