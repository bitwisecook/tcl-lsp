command source {
    available {tcl 8.4-}
    traits {LANGUAGE_KEYWORD CREATES_BARRIER SOURCES_FILE TAINT_SINK BYTE_COMPILED NOT_PROC_FACTORY DYNAMIC_EVAL_BODY SAFE_INTERP_HIDDEN LOADS_EXTERNAL_UNIT}
    arity 1..3

    return_type String
    # TODO(spectcl): `body_execution` is set on the source spec. The DSL spells
    #   it `body_execution -native CONTRACT`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    analyser_hook -native Source

    side_effect FileIo -reads
    side_effect Unknown
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin source

    option -encoding -takes encodingName -available {tcl 8.5-} -min-abbrev 9 \
        -detail {The character encoding of fileName's contents. Added in Tcl 8.5 — Tcl 8.4's source has no -encoding option. When omitted, Tcl 8.5 and 8.6 assume the platform's system encoding (see encoding system); Tcl 9.0 and 9.1 instead always assume utf-8.}
    option -nopkg -available {tcl 9.0-} -min-abbrev 6 \
        -detail {Source the file without package initialisation. Added in Tcl 9.0; unavailable in Tcl 8.x.}
    option_conflict {-encoding -nopkg} -available {tcl 9.0-}

    form Default {source fileName}
    form Default {source -encoding encodingName fileName} -available {tcl 8.5-}
    form Default {source -nopkg fileName} -available {tcl 9.0-}
    form Default {source -rsrc resourceName ?fileName?} -available {tcl 8.4}
    form Default {source -rsrcid resourceId ?fileName?} -available {tcl 8.4}

    hover {
        summary {Evaluate a file or resource as a Tcl script.}
        synopsis {source fileName}
        synopsis {source -encoding encodingName fileName}
        synopsis {source -nopkg fileName}
        description {Reads fileName from disk and evaluates its contents as a Tcl script in the caller's own context — inside a proc body, the file's top-level commands run in that proc's frame exactly as if they had been typed there directly, so a top-level `set` in the file can create or overwrite a local variable of the calling proc. The command's own result is the result of the last command executed in the file; if the file raises an error, source propagates it unchanged. A return at the file's top level does not unwind past source itself — it only ends the file early, and source returns normally with the returned value, letting a sourced file guard itself with an early return (e.g. a compatibility check) without also unwinding the caller. Inside the sourced file, info script reports the path currently being sourced.

Reading stops at the first ASCII ^Z (0x1A) byte on every platform, so a Tcl script can be followed by arbitrary binary or data content in the same file (a "scripted document"); read and gets have no such restriction.

Since Tcl 8.5, -encoding selects the character encoding fileName is decoded with, and a leading byte-order mark is silently stripped whenever the effective encoding is a Unicode one. When -encoding is omitted, Tcl 8.5 and 8.6 fall back to the platform's system encoding; Tcl 9.0 and 9.1 instead always assume utf-8. Tcl 9.0 also adds -nopkg for library sourcing that must bypass package initialisation. Tcl 8.4 has no -encoding option at all, and instead supports two Macintosh-only forms, source -rsrc resourceName ?fileName? and source -rsrcid resourceId ?fileName?, for sourcing code out of a classic Mac OS resource fork; both were dropped in Tcl 8.5.

**Security**: fileName is read and executed unconditionally, so attacker influence over the path lets a caller redirect execution to a file of its own choosing — treat a non-literal fileName the same as eval of arbitrary code, and validate it against a known-good set before sourcing.}
        source {Tcl source(n)}
        example {source config.tcl
source -encoding utf-8 helpers.tcl
# Tcl 9 library loader: do not re-enter package initialisation.
source -nopkg library.tcl

foreach lib {utils.tcl widgets.tcl} {
    source $lib
}}
        returns {The result of the last command executed in the sourced file, or the value a top-level return in that file supplied (without unwinding past source itself). Propagates any error the script raises.}
    }

    refine filename {
        arity 1
    }

    refine encoding {
        arity 3
        selector -encoding -exact
        available {tcl 8.5-}
    }

    refine no-package {
        arity 2
        selector -nopkg -exact
        available {tcl 9.0-}
    }
}

command spinbox {
    available {tcl 8.4-} {package Tk}
    traits TAINTS_VAR_WRITES
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class spinbox -method-prefix-matching Enabled {
        method bbox {
            arity 1
            detail {Return the bounding box of the character at the given index.}
            synopsis {pathName bbox index}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method cget {
            arity 1
            detail {Return the current value of a spinbox option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change spinbox options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method delete {
            arity 1..2
            detail {Delete characters from first through last (or just the character at first).}
            synopsis {pathName delete first ?last?}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method get {
            arity 0
            detail {Return the spinbox's current string contents.}
            synopsis {pathName get}
            traits TAINT_SOURCE
            return_type String
            pure
            side_effect InterpState -reads
        }

        method icursor {
            arity 1
            detail {Move the insertion cursor to just before the character at the given index.}
            synopsis {pathName icursor index}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method identify {
            arity 2
            detail {Return the name of the spinbox element at the given coordinates.}
            synopsis {pathName identify x y}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method index {
            arity 1
            detail {Return the numerical index corresponding to the given index.}
            synopsis {pathName index index}
            return_type Int
            pure
            side_effect InterpState -reads
        }

        method insert {
            arity 2
            detail {Insert the string just before the character at the given index.}
            synopsis {pathName insert index string}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method invoke {
            arity 1
            detail {Invoke the up or down button, incrementing or decrementing the value.}
            synopsis {pathName invoke element}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method scan {
            arity 2
            detail {Implement fast scanning/scrolling; option is mark or dragto.}
            synopsis {pathName scan option arg}
            mutator
            side_effect InterpState -reads -writes
        }

        method selection {
            arity 1..
            detail {Manipulate the selection; option is adjust, clear, element, from, present, range, or to.}
            synopsis {pathName selection option ?arg ...?}
            return_type String
            mutator

            refine element-query {
                arity 1
                selector element
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine present {
                arity 1
                selector present
                traits PURE
                mutator no
                side_effect InterpState -reads
            }
            side_effect InterpState -reads -writes
        }

        method set {
            arity ..1
            detail {Query or set the spinbox's string value.}
            synopsis {pathName set ?string?}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method validate {
            arity 0
            detail {Force revalidation of the spinbox using its -validatecommand.}
            synopsis {pathName validate}
            traits EVALUATES_CODE
            return_type Boolean
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method xview {
            detail {Query or change the horizontal position of the text visible in the spinbox.}
            synopsis {pathName xview ?args?}
            return_type List
            mutator

            refine query {
                arity 0
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine move {
                arity 1..
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
            side_effect InterpState -reads -writes
        }
    }

    option -from -takes {} -detail {Starting value for the numeric range.}
    option -background -takes color -detail {Normal background colour of the spinbox.}
    option -borderwidth -takes {screen units} \
        -detail {Width of the border around the spinbox.}
    option -foreground -takes color -detail {Normal foreground colour of the spinbox.}
    option -locale -takes {locale name} -introduced 9.1 \
        -detail {Locale used to determine word and character boundaries (Tk 9.1+).}
    option -placeholder -takes text -introduced 8.7 \
        -detail {Help text shown when the spinbox is empty (Tk 8.7+).}
    option -placeholderforeground -takes color -introduced 8.7 \
        -detail {Foreground colour of placeholder text (Tk 8.7+).}
    option -to -takes {} -detail {Ending value for the numeric range.}
    option -increment -takes {} \
        -detail {Amount to increment or decrement the value on each arrow press.}
    option -values -takes {} \
        -detail {List of values to cycle through instead of a numeric range.}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global -taints-var-write \
        -detail {Name of a variable linked to the spinbox's contents.}
    option -width -takes {} \
        -detail {Desired width of the spinbox in average-size characters.}
    option -state -takes {} -detail {State of the spinbox: normal, disabled, or readonly.}
    option -format -takes {} -detail {Format string for displaying the value (e.g. %5.2f).}
    option -wrap -takes {} \
        -detail {Whether the value wraps around when the range limit is reached.}
    option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
        -detail {Tcl command to invoke when the value is changed via the arrows.}
    option -validate -takes {} \
        -detail {Validation mode: none, focus, focusin, focusout, key, or all.}
    option -validatecommand -takes {} -role Body -body-kind Structural -script-timing Deferred -callback-taint-inputs {%P %s %S} \
        -detail {Script to evaluate when validation is triggered.}
    option -invalidcommand -takes {} -role Body -body-kind Structural -script-timing Deferred -callback-taint-inputs {%P %s %S} \
        -detail {Script to evaluate when validation fails.}
    option -font -takes {} -detail {Font to use for text in the spinbox.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -readonlybackground -takes {} \
        -detail {Background colour when the spinbox is in readonly state.}
    option -buttonbackground -takes {} \
        -detail {Background colour of the increment/decrement buttons.}
    option -buttoncursor -takes {} \
        -detail {Cursor to display when the mouse is over the buttons.}
    option -buttondownrelief -takes {} -detail {Relief of the down (decrement) button.}
    option -buttonuprelief -takes {} -detail {Relief of the up (increment) button.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -selectbackground -takes {} -detail {Background colour for selected text.}
    option -selectborderwidth -takes {} -detail {Width of the border around selected text.}
    option -selectforeground -takes {} -detail {Foreground colour for selected text.}
    option -insertbackground -takes {} -detail {Colour of the insertion cursor.}
    option -insertborderwidth -takes {} \
        -detail {Width of the border around the insertion cursor.}
    option -insertofftime -takes {} \
        -detail {Milliseconds the insertion cursor is off during blinking.}
    option -insertontime -takes {} \
        -detail {Milliseconds the insertion cursor is on during blinking.}
    option -insertwidth -takes {} -detail {Width of the insertion cursor in screen units.}
    option -xscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for communicating with horizontal scrollbars.}
    option -exportselection -takes {} \
        -detail {Whether the selection is exported to the X selection.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the spinbox.}
    option -takefocus -takes {} \
        -detail {Whether the spinbox accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the spinbox does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the spinbox has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the spinbox.}
    option -activebackground -takes color \
        -detail {Background colour of an active increment or decrement button.}
    option -repeatinterval -takes milliseconds \
        -detail {Milliseconds between automatic repeats after -repeatdelay elapses.}
    option -justify -takes justify -detail {Text alignment: left, centre, or right.}
    option -repeatdelay -takes milliseconds \
        -detail {Milliseconds a button or key is held before automatic repeat begins.}
    option -disabledbackground -takes color \
        -detail {Background colour while disabled; empty uses the normal background.}
    option -disabledforeground -takes color \
        -detail {Foreground colour while disabled; empty uses the normal foreground.}

    form Default {spinbox pathName ?option value ...?}

    hover {
        summary {Create and manipulate a spinbox widget.}
        synopsis {spinbox pathName ?option value ...?}
        description {Displays a single-line text field with increment and decrement arrows for cycling through a range of values.}
        source {Tk man page spinbox.n}
    }

    subcommand bbox {
        arity 1
        detail {Return the bounding box of the character at the given index.}
        synopsis {pathName bbox index}
        return_type List
        pure
        side_effect InterpState -reads
    }

    subcommand cget {
        arity 1
        detail {Return the current value of a spinbox option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change spinbox options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand delete {
        arity 1..2
        detail {Delete characters from first through last (or just the character at first).}
        synopsis {pathName delete first ?last?}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand get {
        arity 0
        detail {Return the spinbox's current string contents.}
        synopsis {pathName get}
        traits TAINT_SOURCE
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand icursor {
        arity 1
        detail {Move the insertion cursor to just before the character at the given index.}
        synopsis {pathName icursor index}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand identify {
        arity 2
        detail {Return the name of the spinbox element at the given coordinates.}
        synopsis {pathName identify x y}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand index {
        arity 1
        detail {Return the numerical index corresponding to the given index.}
        synopsis {pathName index index}
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand insert {
        arity 2
        detail {Insert the string just before the character at the given index.}
        synopsis {pathName insert index string}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand invoke {
        arity 1
        detail {Invoke the up or down button, incrementing or decrementing the value.}
        synopsis {pathName invoke element}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand scan {
        arity 2
        detail {Implement fast scanning/scrolling; option is mark or dragto.}
        synopsis {pathName scan option arg}
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand selection {
        arity 1..
        detail {Manipulate the selection; option is adjust, clear, element, from, present, range, or to.}
        synopsis {pathName selection option ?arg ...?}
        return_type String
        mutator

        refine element-query {
            arity 1
            selector element
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine present {
            arity 1
            selector present
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }

    subcommand set {
        arity ..1
        detail {Query or set the spinbox's string value.}
        synopsis {pathName set ?string?}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand validate {
        arity 0
        detail {Force revalidation of the spinbox using its -validatecommand.}
        synopsis {pathName validate}
        traits EVALUATES_CODE
        return_type Boolean
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand xview {
        detail {Query or change the horizontal position of the text visible in the spinbox.}
        synopsis {pathName xview ?args?}
        return_type List
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
