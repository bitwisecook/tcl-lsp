command text {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class text -method-prefix-matching Enabled {
        method bbox {
            arity 1
            detail {Return the bounding box of the character at the given index.}
            synopsis {pathName bbox index}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method cget {
            arity 1
            detail {Return the current value of a text option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change text options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method compare {
            arity 3
            detail {Compare two indices according to a relational operator.}
            synopsis {pathName compare index1 op index2}
            return_type Boolean
            pure
            side_effect InterpState -reads
        }

        method count {
            arity 2..
            detail {Count the number of items between two indices.}
            synopsis {pathName count ?option ...? index1 index2}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method debug {
            arity ..1
            detail {Enable or query consistency checking of the B-tree code.}
            synopsis {pathName debug ?boolean?}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method delete {
            arity 1..
            detail {Delete a range of characters from the text.}
            synopsis {pathName delete index1 ?index2 ...?}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method dlineinfo {
            arity 1
            detail {Return display information for the display line containing index.}
            synopsis {pathName dlineinfo index}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method dump {
            arity 1..
            detail {Return text contents in a parseable form, or call -command once per dumped segment.}
            synopsis {pathName dump ?-all -image -mark -tag -text -window? ?-command commandPrefix? index1 ?index2?}
            traits {EVALUATES_CODE TAINT_SOURCE}
            return_type List
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes

            option -all -detail {Include text, marks, tags, images, and embedded windows.}
            option -command -takes command -role CommandPrefix -appends {Exactly 3} \
                -detail {Invoke this command prefix for each element with key, value, and index appended.}
            option -image -detail {Include embedded images.}
            option -mark -detail {Include marks.}
            option -tag -detail {Include tag transitions.}
            option -text -detail {Include text segments.}
            option -window -detail {Include embedded windows.}
        }

        method edit {
            arity 1..
            detail {Control the undo/redo mechanism and modified flag.}
            synopsis {pathName edit option ?arg ...?}
            return_type String
            mutator

            refine canredo {
                arity 1
                selector canredo
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine canundo {
                arity 1
                selector canundo
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine modified-query {
                arity 1
                selector modified
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine modified-set {
                arity 2
                selector modified
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }

            refine redo {
                arity 1
                selector redo
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }

            refine reset {
                arity 1
                selector reset
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }

            refine separator {
                arity 1
                selector separator
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }

            refine undo {
                arity 1
                selector undo
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
            side_effect InterpState -reads -writes
        }

        method get {
            arity 1..
            detail {Return the text from the widget between the given indices.}
            synopsis {pathName get ?-displaychars? ?--? index1 ?index2 ...?}
            traits TAINT_SOURCE
            return_type String
            pure
            side_effect InterpState -reads
        }

        method image {
            arity 1..
            detail {Manipulate images embedded in the text widget.}
            synopsis {pathName image option ?arg ...?}
            return_type String
            mutator

            refine cget {
                arity 3
                selector cget
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine configure-all {
                arity 2
                selector configure
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine configure-one {
                arity 3
                selector configure
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine configure-set {
                arity 4.. -step 2
                selector configure
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }

            refine create {
                arity 2.. -step 2
                selector create
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }

            refine names {
                arity 1
                selector names
                traits PURE
                mutator no
                side_effect InterpState -reads
            }
            side_effect InterpState -reads -writes
        }

        method index {
            arity 1
            detail {Return the position of index in line.char form.}
            synopsis {pathName index index}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method insert {
            arity 2..
            detail {Insert text at the given index.}
            synopsis {pathName insert index chars ?tagList chars tagList ...?}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method locale {
            arity 1
            detail {Return the locale governing word and character boundaries at an index.}
            synopsis {pathName locale index}
            introduced_version 9.1
            return_type String
            pure
            side_effect InterpState -reads
        }

        method mark {
            arity 1..
            detail {Manipulate marks within the text widget.}
            synopsis {pathName mark option ?arg ...?}
            return_type String
            mutator

            refine gravity-query {
                arity 2
                selector gravity
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine gravity-set {
                arity 3
                selector gravity
