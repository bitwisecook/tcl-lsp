    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin lrange

    form Default {lrange list first last}

    hover {
        summary {Return one or more adjacent elements from a list.}
        synopsis {lrange list first last}
        description {Treats list as a Tcl list and returns a new list containing its elements from first through last, inclusive. first and last accept a plain (optionally signed, any Tcl integer radix) integer, end (the index of the last element), or end-integer (e.g. end-2); Tcl 8.5 and later also accept the fuller index-arithmetic syntax of string index — a base of either kind followed by a single +/- offset, such as end+1 or 2+1 — which Tcl 8.4 does not: end+1 is a "bad index" error there, and arithmetic on a plain-integer base isn't recognized at all. first below 0 is treated as 0; last at or beyond the list's length is treated as end; when first is greater than last, the result is an empty string. list must be a syntactically valid Tcl list, and first/last must be syntactically valid indices — either failing raises an error rather than returning an empty result. Because the result is rebuilt through canonical list quoting rather than copied as a raw substring, `lrange list N N` is not always textually identical to `lindex list N` for an element containing whitespace or braces — it matches `list [lindex list N]` instead.}
        source {Tcl lrange(n)}
        example {set colors {red green blue yellow orange}
lrange $colors 0 1        ;# red green
lrange $colors end-2 end  ;# blue yellow orange
lrange $colors 1 end-1    ;# green blue yellow

# a single-element range is still a *list*, unlike lindex's bare element
set var {some {elements to} select}
lindex $var 1              ;# elements to
lrange $var 1 1            ;# {elements to}}
        returns {A new list built from the elements in the (clamped) inclusive range; an empty string when the range selects no elements.}
    }
}

command lrepeat {
    available {tcl 8.5-}
    traits {PURE NOT_PROC_FACTORY FRAMELESS_RUNTIME}
    arity 1..

    return_type List
    inferred_storage_type List
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -type Int -shimmers

    const_fold -native lrepeat::const_fold
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    runtime_backing shipped-builtin lrepeat

    form Default {lrepeat count ?element ...?} -available {tcl 8.6-}
    form Default {lrepeat count element ?element ...?} -available {tcl 8.5}

    hover {
        summary {Build a list by repeating elements}
        synopsis {lrepeat count ?element ...?}
        synopsis {lrepeat count element ?element ...?}
        description {Creates a list of size count times the number of element arguments, by repeating the sequence element ... count times in order — lrepeat 1 element ... is identical to list element .... count must be an integer, and a negative count is always an error. From Tcl 8.6 onward, element is optional and count may be 0, so a bare lrepeat count with no elements at all is legal and returns the empty list. In Tcl 8.5, at least one element is required and count must be a positive integer (at least 1) — both a bare lrepeat count and lrepeat 0 element are errors there.}
        source {Tcl man page lrepeat.n}
        example {lrepeat 3 a
lrepeat 3 a b c
lrepeat 3 [lrepeat 2 a] b c}
        returns {A list of size count times the number of element arguments — the element sequence repeated count times in order, or the empty list when count is 0 (Tcl 8.6 and later).}
    }
}

command lreplace {
    available {tcl 8.4-} {f5-irules}
    traits {PURE CSE_CANDIDATE BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME}
    arity 3..

    return_type List
    inferred_storage_type List
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -type List -shimmers
    arg 1 -type Int -shimmers
    arg 2 -type Int -shimmers

    inline_codegen_hook -native Lreplace
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.
    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.
    # TODO(spectcl): `result_stability` is set on the source spec. The DSL
    #   spells it `result_stability
    #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
    #   …}}`, but a draft records only that the field is set, never the
    #   expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin lreplace

    form Default {lreplace list first last ?element element ...?}

    hover {
        summary {Replace a range of list elements with new elements.}
        synopsis {lreplace list first last ?element element ...?}
        description {Returns a new list formed from list by removing the inclusive first..last range of elements and splicing the element arguments (if any) into their place; list itself is left unmodified. first and last take the same index forms as string index — 0 is the first element and end the last, with end-integer offsets (e.g. end-1) accepted since Tcl 8.4; the fuller end+integer and integer+/-integer arithmetic (e.g. end+1, 2+1) is Tcl 8.5 and later only — a "bad index" error in Tcl 8.4. When last is less than first, no elements are removed and the given elements are simply inserted before first. An out-of-range index clamps rather than erroring: a negative first or last clamps to before the first element, so lreplace can prepend, and — from Tcl 8.6.9, and in 9.0/9.1 — an index past the last element clamps to one past the end, so lreplace can append regardless of how far out of range the index is. Tcl 8.4 and 8.5 (and Tcl 8.6 before 8.6.9) lack that append clamp: there, first must index an element that actually exists in a non-empty list, and a first past the end raises an error instead of appending. With no element arguments at all, the elements in the first..last range are simply deleted.}
        source {Tcl lreplace(n)}
        example {lreplace {a b c d e} 1 1 foo                   ;# a foo c d e
lreplace {a b c d e} 1 2 three more elements   ;# a three more elements d e

set var {a b c d e}
set var [lreplace $var end end]                ;# a b c d -- delete the last element

set var {a b c d e}
set var [lreplace $var 12345 end+2 f g h i]    ;# a b c d e f g h i -- out-of-range indices append (Tcl 8.6.9+, 9.0, 9.1)}
        returns {A new list: list with the first..last range removed and the element arguments, if any, spliced into their place.}
    }
}

