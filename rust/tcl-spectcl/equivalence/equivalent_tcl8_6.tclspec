            sub_subcommand delete -detail {Delete a tag and its bindings and display information.} -synopsis {pathName tag delete tagName} -introduced 9.0 {}
            sub_subcommand has -detail {List tagged items or test whether an item has a tag.} -synopsis {pathName tag has tagName ?item?} {}
            sub_subcommand names -detail {Return all tags used by the widget.} -synopsis {pathName tag names} {}
            sub_subcommand remove -detail {Remove a tag from selected items or every item.} -synopsis {pathName tag remove tagName ?itemList?} {}
