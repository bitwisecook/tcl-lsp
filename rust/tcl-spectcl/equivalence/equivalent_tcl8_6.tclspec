command fileutil::traverse {
    available {tcl 8.5-}
    arity 1..
    required_package fileutil::traverse
    tcllib_package fileutil::traverse

    creates_instance_at 0

    side_effect FileIo -reads

    object_class fileutil::traverse -allow-unknown {
        method files {
            arity 0
            detail {Return the list of every path the traversal yields.}
            synopsis {traverser files}
            return_type List
        }

        method foreach {
            arity 2
            detail {Run body once per traversed path, with the path in filevar. An ordinary loop: break stops the traversal, continue skips to the next path.}
            synopsis {traverser foreach filevar body}
            arg 0 -role VarWrite
            arg 1 -role Body
        }

        method next {
            arity 1
            detail {Store the next traversed path in filevar and return true, or return false when the traversal is exhausted.}
            synopsis {traverser next filevar}
            return_type Boolean
            arg 0 -role VarWrite
        }
    }

    option -filter -takes cmdprefix -role CommandPrefix -appends {Exactly 1} \
        -detail {Per-path predicate, invoked at level #0 with the path appended; a true result makes the path a result of the traversal.}
    option -prefilter -takes cmdprefix -role CommandPrefix -appends {Exactly 1} \
        -detail {Per-directory predicate, invoked at level #0 with the path appended; a false result prunes the directory from the descent.}
    option -errorcmd -takes cmdprefix -role CommandPrefix -appends {Exactly 2} \
        -detail {Error handler, invoked at level #0 with the path and the message appended; without it traversal errors are thrown.}

    form Default {::fileutil::traverse ?objectName? basedir ?option value ...?}

    hover {
        summary {Create a directory-traversal object rooted at basedir.}
        synopsis {::fileutil::traverse ?objectName? basedir ?option value ...?}
        description {Creates a traverser over the directory hierarchy under *basedir*. The object's `files`, `foreach`, and `next` methods yield the paths found; `-filter` selects which paths are results, `-prefilter` decides which directories are descended into, and `-errorcmd` handles unreadable paths. All three options are read-only after construction.}
        source {tcllib fileutil::traverse package}
        returns {The name of the new traverser object command.}
    }
}

