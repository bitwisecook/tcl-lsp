    option -justify -takes justify -detail {Text alignment: left, centre, or right.}
    option -state -takes stateSpec \
        -detail {State: normal or disabled; disabled prevents edits and selection changes.}

    form Default {listbox pathName ?option value ...?}

    hover {
        summary {Create and manipulate a listbox widget.}
        synopsis {listbox pathName ?option value ...?}
        description {Displays a list of strings, one per line, and allows the user to select one or more of them.}
        source {Tk man page listbox.n}
    }

    subcommand activate {
        arity 1
        detail {Set the active element to the one at the given index.}
        synopsis {pathName activate index}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand cget {
        arity 1
        detail {Return the current value of a listbox option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change listbox options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand bbox {
        arity 1
        detail {Return the bounding box of the text of the element at the given index.}
        synopsis {pathName bbox index}
        return_type List
        pure
        side_effect InterpState -reads
    }

    subcommand curselection {
        arity 0
        detail {Return a list of the indices of all currently selected elements.}
        synopsis {pathName curselection}
        traits TAINT_SOURCE
        return_type List
        pure
        side_effect InterpState -reads
    }

    subcommand delete {
        arity 1..2
        detail {Delete one or more elements in the range first through last inclusive.}
        synopsis {pathName delete first ?last?}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand get {
        arity 1..2
        detail {Return the contents of the elements in the range first through last inclusive.}
        synopsis {pathName get first ?last?}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand index {
        arity 1
        detail {Return the integer index value corresponding to the given index.}
        synopsis {pathName index index}
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand insert {
        arity 1..
        detail {Insert zero or more new elements just before the element at the given index.}
        synopsis {pathName insert index ?element ...?}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand itemcget {
        arity 2
        detail {Return the current value of the given configuration option for an item.}
        synopsis {pathName itemcget index option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand itemconfigure {
        arity 1..
        detail {Query or modify the configuration options of an individual item.}
        synopsis {pathName itemconfigure index ?option? ?value option value ...?}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand nearest {
        arity 1
        detail {Return the index of the visible element nearest to the given y-coordinate.}
        synopsis {pathName nearest y}
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand scan {
        arity 3
        detail {Implement scanning: record scan mark, or scroll relative to a mark.}
        synopsis {pathName scan mark|dragto x y}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand see {
        arity 1
        detail {Adjust the view so that the element at the given index is visible.}
        synopsis {pathName see index}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand selection {
        arity 1..
        detail {Adjust or query the selection: anchor, clear, includes, or set.}
        synopsis {pathName selection option first ?last?}
        return_type String
        mutator

        refine includes {
            arity 2
            selector includes
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }

    subcommand size {
        arity 0
        detail {Return the number of elements in the listbox.}
        synopsis {pathName size}
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand xview {
        detail {Query or change the horizontal position of the listbox's view.}
        synopsis {pathName xview ?args?}
        return_type List
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }

    subcommand yview {
        detail {Query or change the vertical position of the listbox's view.}
        synopsis {pathName yview ?args?}
        return_type List
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }
}

command tk::menubutton {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    introduced_version 8.5
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class menubutton -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }
    }

    option -text -takes {} -detail {Text to display in the menubutton.}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Name of a variable whose value will be used as the menubutton text.}
    option -menu -takes {} \
        -detail {Path name of the menu widget to post when the menubutton is pressed.}
    option -direction -takes {} \
        -detail {Direction to post the menu: above, below, flush, left, or right.}
    option -image -takes {} -detail {Image to display in the menubutton.}
    option -bitmap -takes {} -detail {Bitmap to display in the menubutton.}
    option -compound -takes {} \
        -detail {Whether to display both image and text: none, bottom, top, left, right, or center.}
    option -width -takes {} \
        -detail {Desired width of the menubutton in characters (text) or pixels (image).}
    option -height -takes {} \
        -detail {Desired height of the menubutton in lines (text) or pixels (image).}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {How information is positioned: n, ne, e, se, s, sw, w, nw, or center.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of multi-line text: left, center, or right.}
    option -wraplength -takes {} \
        -detail {Maximum line length for word wrapping, in screen units.}
    option -underline -takes {} \
        -detail {Index of character to underline for keyboard traversal (0-based).}
    option -state -takes {} -detail {State of the menubutton: normal, active, or disabled.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -font -takes {} -detail {Font to use for the menubutton text.}
    option -padx -takes {} -detail {Extra horizontal padding inside the menubutton.}
    option -pady -takes {} -detail {Extra vertical padding inside the menubutton.}
    option -activebackground -takes {} \
        -detail {Background colour when the menubutton is active (mouse over).}
    option -activeforeground -takes {} \
        -detail {Foreground colour when the menubutton is active.}
    option -disabledforeground -takes {} \
        -detail {Foreground colour when the menubutton is disabled.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the menubutton does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the menubutton has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the menubutton.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the menubutton.}
    option -takefocus -takes {} \
        -detail {Whether the menubutton accepts focus during keyboard traversal.}
    option -indicatoron -takes {} \
        -detail {Whether to display a small indicator showing the menu direction.}

    form Default {menubutton pathName ?option value ...?}

    hover {
        summary {Create and manipulate a menubutton widget.}
        synopsis {menubutton pathName ?option value ...?}
        description {Displays a textual string, bitmap, or image. When pressed, posts an associated menu widget.}
        source {Tk man page menubutton.n}
    }
}

