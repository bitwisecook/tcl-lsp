command lappend {
    available {tcl 8.4-} {f5-irules}
    traits {READS_BEFORE_WRITE UNCONDITIONAL_VARIABLE_WRITE BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME FIRST_ARG_VARNAME}
    arity 1..
    safe_on_uninit {all-tcl f5-irules}

    return_type List
    var_elements_effect {AppendsListElements 1}
    representation_effect {CopyOnWriteContainerMutation 0 2}
    inferred_storage_type List
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    # TODO(spectcl): `form_value_effects` is set on the source spec. The DSL
    #   spells it `refine NAME
    #   {return_type|arg_types|byte_array_effect|var_elements_effect|safe_on_uninit
    #   OVERRIDE}`, but a pack may not author this field.
    arg 0 -role VarWrite -type List -shimmers
    assigns_variable_at 0

    lowering_hook -native AppendOrLappend
    codegen_hook -native Lappend
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -reads -writes

    runtime_backing shipped-builtin lappend

    form Default {lappend varName ?value value value ...?}

    hover {
        summary {Append list elements to a variable, creating it if it does not already exist.}
        synopsis {lappend varName ?value value value ...?}
        description {This command treats the variable given by varName as a list and appends each of the value arguments to that list as a separate element, with spaces between elements. If varName does not exist, it is created as a list containing just the value arguments. lappend is similar to append except that the values are appended as list elements rather than raw text: this makes it a more efficient way to build up a large list than repeated set/concat, since `lappend a $b` is much cheaper than `set a [concat $a [list $b]]` once $a is already long. From Tcl 9.0, if varName names a nonexistent element of an array that has a default value configured (see `array default`), the list stored is that default value with the value arguments appended after it, rather than just the value arguments.}
        source {Tcl man page lappend.n}
        example {set var 1
lappend var 2
lappend var 3 4 5
# var is now "1 2 3 4 5"

lappend newlist a b c
# newlist is created as "a b c"}
        returns {The new value stored in varName after the values have been appended.}
    }

    refine read-or-create {
        arity 1
        arg 0 -role VarWrite
        traits {READS_BEFORE_WRITE CONDITIONAL_VARIABLE_WRITE FRAMELESS_RUNTIME FIRST_ARG_VARNAME}
        representation_effect None
    }
}

command lassign {
    available {tcl 8.5-}
    traits {UNCONDITIONAL_VARIABLE_WRITE BYTE_COMPILED FRAMELESS_RUNTIME FRAME_HASH_BUILTIN}
    arity 1..

    return_type List
    var_write_typing {ElementsOf 0}
    return_elements {SubListOf 0}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -type List -shimmers
    repeat VarWrite -from 1

    codegen_hook -native Lassign
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -writes
    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    runtime_backing shipped-builtin lassign

    form Default {lassign list ?varName ...?} -available {tcl 8.6-}
    form Default {lassign list varName ?varName ...?} -available {tcl 8.5}

    hover {
        summary {Assign list elements to variables}
        synopsis {lassign list ?varName ...?}
        description {Treats list as a Tcl list and assigns its successive elements, in order, to the variables named by the varName arguments. If there are more varName arguments than list elements, the surplus variables are set to the empty string. If list has more elements than there are varName arguments, the leftover elements are returned as a list; otherwise the return value is the empty string. Before Tcl 8.6, at least one varName was required; from Tcl 8.6 onward `lassign list` alone is also legal and simply returns every element of list, since none of them get assigned. A common idiom uses `lassign` to "shift" the first element off a list: `set ::argv [lassign $::argv argumentToReadOff]` reassigns argv to everything after the first element while binding the first element to argumentToReadOff.}
        source {Tcl lassign(n)}
        example {lassign {a b c} x y z       ;# assigns a to x, b to y, c to z; returns {}
lassign {d e} x y z         ;# assigns d to x, e to y; z becomes {}; returns {}
lassign {f g h i} x y       ;# assigns f to x, g to y; returns {h i}
set ::argv [lassign $::argv argumentToReadOff]  ;# "shift" idiom: pops the first element off argv}
        returns {The empty string when every list element was assigned to a variable; otherwise a list of the elements left over after the last variable was assigned.}
    }
}

