command stringprep::compare {
    available {tcl 8.4-}
    traits PURE
    arity 3
    required_package stringprep
    tcllib_package stringprep

    hover {
        summary {Compare two strings after applying a stringprep profile.}
        synopsis {stringprep::compare profile string1 string2}
        source {tcllib stringprep package}
        returns {0 if the prepared strings are equal, non-zero otherwise.}
    }
}

command stringprep::register {
    available {tcl 8.4-}
    arity 1..
    required_package stringprep
    tcllib_package stringprep

    option -mapping -takes list -detail {Character mapping tables to apply.}
    option -normalization -takes form \
        -detail {The Unicode normalisation form for the profile.}
    option -prohibited -takes list -detail {Ranges of prohibited characters.}
    option -prohibitedList -takes list -detail {An explicit list of prohibited characters.}
    option -prohibitedCommand -takes command -role CommandPrefix -script-timing Deferred \
        -detail {A command that decides whether a character is prohibited.}
    option -prohibitedBidi -takes boolean -role Boolean \
        -detail {Whether to apply the bidirectional-text checks.}

    hover {
        summary {Register a named stringprep (RFC 3454) profile.}
        synopsis {stringprep::register profile ?-mapping list? ?-normalization form? ?-prohibited list? ?-prohibitedList list? ?-prohibitedCommand command? ?-prohibitedBidi boolean?}
        source {tcllib stringprep package}
    }
}

command stringprep::stringprep {
    available {tcl 8.4-}
    traits PURE
    arity 2
    required_package stringprep
    tcllib_package stringprep

    hover {
        summary {Prepare a string according to a registered stringprep profile.}
        synopsis {stringprep::stringprep profile string}
        source {tcllib stringprep package}
        returns {The prepared string.}
    }
}

command struct::disjointset {
    available {tcl 8.5-}
    required_package struct::disjointset
    tcllib_package struct::disjointset

    return_type Object

    hover {
        summary {Create a disjoint-set (union-find) object command.}
        synopsis {struct::disjointset name}
        source {tcllib struct package}
    }
}

command struct::graph {
    available {tcl 8.5-}
    required_package struct::graph
    tcllib_package struct::graph

    return_type Object
    creates_instance_at 0

    object_class struct::graph -allow-unknown {
        method walk {
            arity 1..
            detail {Walk the graph from node, invoking -command at each visited node.}
            synopsis {graphName walk node ?-dir forward|backward? ?-order pre|post|both? ?-type bfs|dfs? -command cmd}
            option_prefix_words 1

            option -dir -takes forward|backward \
                -detail {Walk direction: forward (default) or backward.}
            option -order -takes pre|post|both \
                -detail {Visit order: pre (default), post, or both.}
            option -type -takes bfs|dfs -detail {Traversal type: dfs (default) or bfs.}
            option -command -takes prefix -role CommandPrefix -appends {Exactly 3} \
                -detail {Command prefix invoked at each node with (action graphName node) appended.}
        }
    }

    hover {
        summary {Create a directed-graph object command.}
        synopsis {struct::graph ?name? ?=|:=|as|deserialize source?}
        source {tcllib struct package}
    }
}

command struct::list {
    available {tcl 8.5-}
    arity 1..
    required_package struct::list
    tcllib_package struct::list

    side_effect Unknown -reads

    form Default {struct::list subcommand ?args ...?}

    hover {
        summary {Advanced list manipulation commands.}
        synopsis {struct::list subcommand ?args ...?}
        description {Provides operations beyond the core Tcl list commands: filtering, mapping, folding, shuffling, permutations, longest-common-subsequence, and more.}
        source {tcllib struct::list package}
    }

    subcommand assign {
        arity 2..
        detail {Assign list elements to variables.}
        synopsis {struct::list assign sequence var ?var ...?}
        traits UNCONDITIONAL_VARIABLE_WRITE
        repeat VarWrite -from 1
    }

    subcommand dbJoin {
        arity 2..
        detail {Perform a relational join on two lists.}
        synopsis {struct::list dbJoin ?-inner|-left|-right|-full? ?-keys varname? keyedList1 keyedList2}
        traits CONDITIONAL_VARIABLE_WRITE

        option -keys -takes varname -role VarWrite \
            -detail {Variable to receive the joined keys when the join produces rows.}
        option -inner -detail {Return rows with keys present in every table.}
        option -left -detail {Keep keys from the first table.}
        option -right -detail {Keep keys from the last table.}
        option -full -detail {Keep keys from every table.}
    }

    subcommand dbJoinKeyed {
        arity 2..
        detail {Relational join on keyed lists.}
        synopsis {struct::list dbJoinKeyed ?options? keyedList1 keyedList2}
        traits CONDITIONAL_VARIABLE_WRITE

        option -keys -takes varname -role VarWrite \
            -detail {Variable to receive the joined keys when the join produces rows.}
        option -inner -detail {Return rows with keys present in every table.}
        option -left -detail {Keep keys from the first table.}
        option -right -detail {Keep keys from the last table.}
        option -full -detail {Keep keys from every table.}
    }

    subcommand equal {
        arity 2..
        detail {Test if two lists are structurally equal.}
        synopsis {struct::list equal ?-simple? a b}
        traits PURE
    }

    subcommand filter {
        arity 2
        detail {Return elements matching a condition.}
        synopsis {struct::list filter sequence cmdprefix}
        arg 1 -appends {Exactly 1}
    }

    subcommand filterfor {
        arity 3
        detail {Filter using an expression over each element.}
        synopsis {struct::list filterfor var sequence expr}
        arg 0 -role VarWrite
        arg 2 -role Expr
    }

    subcommand flatten {
        arity 1..
        detail {Flatten nested lists by one or more levels.}
        synopsis {struct::list flatten ?-full? ?--? sequence}
        traits PURE
    }

    subcommand fold {
        arity 3
        detail {Left-fold a list with an accumulator.}
        synopsis {struct::list fold sequence initialValue cmdprefix}
        arg 2 -appends {Exactly 2}
    }

    subcommand foreachperm {
        arity 3
        detail {Iterate over all permutations of a list.}
        synopsis {struct::list foreachperm var sequence body}
        arg 0 -role VarWrite
        arg 2 -role Body
    }

    subcommand iota {
        arity 1
        detail {Generate a list of integers 0..n-1.}
        synopsis {struct::list iota n}
        traits PURE
    }

    subcommand lcsInvert {
        arity 3
        detail {Invert a longest-common-subsequence result.}
        synopsis {struct::list lcsInvert lcsData len1 len2}
        traits PURE
    }

    subcommand longestCommonSubsequence {
        arity 2..3
        detail {Find the longest common subsequence of two lists.}
        synopsis {struct::list longestCommonSubsequence list1 list2 ?maxOccurs?}
        traits PURE
    }

    subcommand map {
        arity 2
        detail {Apply a command to each element and collect results.}
        synopsis {struct::list map sequence cmdprefix}
        arg 1 -appends {Exactly 1}
    }

    subcommand mapfor {
        arity 3
        detail {Map each element through a script and collect the results.}
        synopsis {struct::list mapfor var sequence script}
        arg 0 -role VarWrite
        arg 2 -role Body
    }

    subcommand repeat {
        arity 2..
        detail {Create a list by repeating elements.}
        synopsis {struct::list repeat count element ?element ...?}
        traits PURE
    }

    subcommand reverse {
        arity 1
        detail {Reverse the order of a list.}
        synopsis {struct::list reverse sequence}
        traits PURE
    }

    subcommand shift {
        arity 1
        detail {Remove and return the first element.}
        synopsis {struct::list shift listVar}
        traits READS_BEFORE_WRITE
        arg 0 -role VarWrite
    }

    subcommand shuffle { arity 1 ; detail {Randomly reorder elements of a list.} ; synopsis {struct::list shuffle list} }

    subcommand swap {
        arity 3
        detail {Swap two elements in a list.}
        synopsis {struct::list swap listVar i j}
        traits READS_BEFORE_WRITE
        arg 0 -role VarWrite
    }

    subcommand longestCommonSubsequence2 {
        arity 2..3
        detail {Find the longest common subsequence (alternate algorithm).}
        synopsis {struct::list longestCommonSubsequence2 list1 list2 ?maxOccurs?}
        traits PURE
    }

    subcommand lcsInvertMerge {
        arity 3
        detail {Invert and merge a longest-common-subsequence result.}
        synopsis {struct::list lcsInvertMerge lcsData len1 len2}
        traits PURE
    }

    subcommand split {
        arity 2..4
        detail {Split a list using a command prefix as filter.}
        synopsis {struct::list split sequence cmdprefix ?passVar? ?failVar?}
        traits CONDITIONAL_VARIABLE_WRITE
        arg 2 -role VarWrite
        arg 3 -role VarWrite
        arg 1 -appends {Exactly 1}
    }

    subcommand delete {
        arity 2
        detail {Delete an element from a list variable by value.}
        synopsis {struct::list delete listVar item}
        traits READS_BEFORE_WRITE
        arg 0 -role VarWrite
    }

    subcommand repeatn {
        arity 1..
        detail {Create a (nested) list by repeating a value.}
        synopsis {struct::list repeatn value count ?count ...?}
        traits PURE
    }

    subcommand firstperm {
        arity 1
        detail {Return the first permutation of a list.}
        synopsis {struct::list firstperm list}
        traits PURE
    }

    subcommand nextperm {
        arity 1
        detail {Return the next permutation in lexicographic order.}
        synopsis {struct::list nextperm perm}
        traits PURE
    }

    subcommand permutations {
        arity 1
        detail {Return all permutations of a list.}
        synopsis {struct::list permutations list}
        traits PURE
    }
}

