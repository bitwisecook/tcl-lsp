    option -foreground -takes {} -detail {Foreground colour for the label text.}
    option -font -takes {} -detail {Font to use for the label text.}
    option -padx -takes {} -detail {Extra horizontal padding inside the labelframe.}
    option -pady -takes {} -detail {Extra vertical padding inside the labelframe.}
    option -class -takes {} \
        -detail {Class name for the labelframe, used in option database lookups.}
    option -colormap -takes {} \
        -detail {Colourmap to use for the labelframe: new or inherited from a window.}
    option -container -takes {} \
        -detail {Whether the labelframe will be a container for an embedded application.}
    option -visual -takes {} -detail {Visual information for the labelframe.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the labelframe.}
    option -takefocus -takes {} \
        -detail {Whether the labelframe accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the labelframe does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the labelframe has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the labelframe.}

    form Default {labelframe pathName ?option value ...?}

    hover {
        summary {Create and manipulate a labelframe widget.}
        synopsis {labelframe pathName ?option value ...?}
        description {Displays a frame with a decorative border and an optional label, used to group related widgets visually.}
        source {Tk man page labelframe.n}
    }
}

