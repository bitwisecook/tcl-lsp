command uuid::uuid {
    available {tcl 8.5-}
    arity 1..
    required_package uuid
    tcllib_package uuid

    side_effect Unknown -reads

    form Default {uuid::uuid subcommand ?args?}

    hover {
        summary {Generate or manipulate UUIDs.}
        synopsis {uuid::uuid generate}
        synopsis {uuid::uuid equal id1 id2}
        description {Generate RFC 4122 version 4 universally unique identifiers.}
        source {tcllib uuid package}
        example {set id [uuid::uuid generate]}
        returns {A UUID string.}
    }

    subcommand equal { arity 2 }
    subcommand generate { arity 0 }
}

command variable {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD CREATES_SCOPE_ALIAS CREATES_BARRIER CREATES_DYNAMIC_BARRIER BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME FRAME_HASH_BUILTIN}

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role VarWrite
    repeat VarWrite -stride 2
    assigns_variable_at 0

    lowering_hook -native Variable
    codegen_hook -native Variable

    side_effect Variable -writes
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin variable

    form Default {variable name} -dialects {tcl8.6+ expect}
    form Default {variable ?name value...?} -dialects {tcl8.6+ expect}
    form Default {variable ?name value...? name ?value?} -dialects {tcl8.4 tcl8.5 f5-iapps f5-irules f5-tmsh}

    hover {
        summary {Create and initialize a namespace variable, or link to one from inside a procedure.}
        synopsis {variable name}
        synopsis {variable ?name value...?}
        description {Normally used inside a namespace eval body to create one or more variables in a namespace: each name is initialized with the value that follows it, and the value for the final name is optional. A name that does not yet exist is created — initialized if value is given, left undefined otherwise; an existing variable is updated only when value is given, and left unchanged otherwise. name is usually unqualified, creating the variable in the current namespace, but a name with namespace qualifiers creates it in the namespace it names. A declared-but-undefined variable is visible to namespace which but not to info exists. Used inside a procedure body, variable instead creates a local variable linked to the corresponding namespace variable (and so listed by info vars) — like global, but resolved relative to the current namespace rather than always the global (::) one; any value given still initializes or updates the linked namespace variable itself. name can never address a single array element: reference the whole array with no value, then populate its elements afterward with set or array set. Tcl 8.4 and 8.5 require at least one name argument — a bare variable with none is a "wrong # args" error there. Tcl 8.6 dropped that requirement, so a bare variable call is a legal no-op from 8.6 onward.}
        source {Tcl variable(n)}
        example {namespace eval foo {
    variable bar 12345
}

namespace eval someNS {
    variable someAry
    array set someAry {
        someName  someValue
        otherName otherValue
    }
}

namespace eval foo {
    proc spong {} {
        variable bar
        puts "bar is $bar"
        variable ::someNS::someAry
        parray someAry
    }
}}
        returns {The empty string.}
    }
}

command vwait {
    available {tcl 8.4-}
    traits {CREATES_DYNAMIC_BARRIER BYTE_COMPILED FRAME_HASH_BUILTIN}

    return_type String
    var_write_typing Destructured
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    arg_role_layout_resolver -native vwait::arg_role_layout_resolver
    arg_role_resolver_roles {VarWrite Body}

    side_effect InterpState -writes

    runtime_backing shipped-builtin vwait

    option -- -available {tcl 9.0-} \
        -detail {Mark the end of options; every remaining argument is treated as a variable name.}
    option -all -available {tcl 9.0-} \
        -detail {Require every wait condition to be met to complete the wait operation. Without -all (the default), the first condition that fires completes the wait.}
    option -extended -available {tcl 9.0-} \
        -detail {Return an extended result: an even-sized list whose odd elements are readable, timeleft, variable, or writable and whose following element is the matching channel/variable name or the remaining milliseconds, one pair per condition that fired, ordered by when each fired except timeleft, which always comes last.}
    option -nofileevents -available {tcl 9.0-} \
        -detail {Do not service file events while waiting.}
    option -noidleevents -available {tcl 9.0-} \
        -detail {Do not invoke idle handlers while waiting.}
    option -notimerevents -available {tcl 9.0-} \
        -detail {Do not service timer events (such as after) while waiting.}
    option -nowindowevents -available {tcl 9.0-} \
        -detail {Do not handle windowing-system events while waiting.}
    option -readable -takes channel -role Channel -available {tcl 9.0-} \
        -detail {Complete the wait once channel is, or becomes, readable. channel must name a Tcl channel open for reading.}
    option -timeout -takes milliseconds -integer Any -available {tcl 9.0-} \
        -detail {Limit the wait to milliseconds. (From Tcl 9.1, a monotonic clock is used for this when available.)}
    option -variable -takes {} -role VarWrite -also-role VarRead -available {tcl 9.0-} \
        -detail {varName must be the name of a global variable. Writing or unsetting it completes the wait operation.}
    option -writable -takes channel -role Channel -available {tcl 9.0-} \
        -detail {Complete the wait once channel is, or becomes, writable. channel must name a Tcl channel open for writing.}

    form Default {vwait varName} -dialects {tcl8.x expect f5-iapps f5-tmsh}
    form Default {vwait ?options? ?varName ...?} -available {tcl 9.0-}

    hover {
        summary {Process events until a variable is written, or — from Tcl 9.0 — until a channel is ready or a timeout elapses.}
        synopsis {vwait varName}
        synopsis {vwait ?options? ?varName ...?}
        description {Enters the Tcl event loop to process events, blocking the application if no events are ready, until the wait condition is met. varName is always interpreted as a variable name with respect to the global namespace, but can refer to any namespace's variable if a fully-qualified name is given. vwait may not return immediately once its condition is met: if the event handler that satisfies it does not itself complete right away — for instance because it calls vwait again, on a different variable — the outer call stays blocked until that inner one finishes; multiple vwait calls nest rather than run in parallel, and the outermost does not return until every inner one does. Some packages (http, in its synchronous modes) use vwait internally, so nesting a vwait inside an event handler risks a deadlock and is best avoided. Tcl 8.4/8.5/8.6 accept only a single varName and no options: waiting is complete once that variable is written by some event handler. Tcl 9.0 adds a second form with options for finer control and multiple event sources: any number of varNames may be given, -variable adds another (a write or an unset both complete it), and -readable/-writable wait on a channel's readiness instead of a variable — by default (without -all) the wait completes as soon as the first of these fires, not once every one of them has; -all instead requires every condition to fire before the wait completes. -timeout separately bounds the whole wait by a millisecond limit, regardless of -all. -nofileevents/-noidleevents/-notimerevents/-nowindowevents each exclude one class of event from being serviced while waiting.}
        source {Tcl vwait(n)}
        example {# The canonical block-forever idiom: nothing besides some other
# event handler calling "set forever 1" (or similar) ever ends this.
vwait forever

# Wait up to 5 seconds for a connection, then react to which happened
after 5000 {set state timeout}
set server [socket -server accept 12345]
proc accept {args} {
    global state connectionInfo
    set state accepted
    set connectionInfo $args
}
vwait state
close $server
after cancel {set state timeout}

# Tcl 9.0+: wait for the first of several conditions, with a timeout
vwait -timeout 5000 -readable $chan -variable done}
        returns {An empty string for the plain vwait varName form. From Tcl 9.0, -timeout instead makes the result the number of milliseconds remaining when the wait condition was met, or -1 if the wait timed out; and -extended makes it a list of alternating condition-name/value pairs (readable, timeleft, variable, writable) in firing order, with timeleft always last.}
    }
}

