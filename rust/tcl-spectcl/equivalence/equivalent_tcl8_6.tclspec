command split {
    available {tcl 8.4-} {f5-irules}
    traits {PURE CSE_CANDIDATE FRAMELESS_RUNTIME}
    arity 1..2

    return_type List
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    byte_array_effect Coerces
    arg 0 -type String -shimmers

    const_fold -native split::const_fold
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.
    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.
    # TODO(spectcl): `result_stability` is set on the source spec. The DSL
    #   spells it `result_stability
    #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
    #   …}}`, but a draft records only that the field is set, never the
    #   expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin split

    form Default {split string ?splitChars?}

    hover {
        summary {Split a string into a proper Tcl list.}
        synopsis {split string ?splitChars?}
        description {Returns a list created by splitting string at each character that occurs in splitChars: every character in splitChars is its own delimiter (not a substring to match), so string is scanned once and each maximal run of non-delimiter characters becomes one list element. Adjacent delimiter characters, or a delimiter at the very start or end of string, produce empty-string elements. splitChars defaults to the standard whitespace characters (space, tab, newline, and carriage return) when omitted; passing an empty string instead splits string into its individual characters. Splitting an empty string always returns an empty list (zero elements), regardless of splitChars. The result is always a syntactically well-formed Tcl list — an element that needs braces or backslashes to round-trip (an embedded space, an unbalanced brace) is quoted accordingly — which makes split a common idiom for turning arbitrary delimited text, even text that is not itself a valid list, into one that is.}
        source {Tcl split(n)}
        example {# Default splitChars is space/tab/newline/CR
split "the quick brown fox"

# Explicit delimiter set: split on comma or semicolon
split "a,b;c" ",;"

# Parse a colon-separated /etc/passwd-style record
lassign [split $line ":"] userName password uid gid longName homeDir shell

# Explode a string into its individual characters
split "abc" {}

# The empty string always yields an empty list, whatever splitChars is
split ""}
        returns {A proper Tcl list: one element for each run of characters in string that lies between (or before the first / after the last) occurrence of a splitChars character. Adjacent or edge-of-string delimiters contribute empty-string elements; splitting the empty string always yields a list of zero elements.}
    }
}

