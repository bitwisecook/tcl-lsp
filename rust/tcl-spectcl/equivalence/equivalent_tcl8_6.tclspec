        mutator
        side_effect InterpState -reads -writes
    }

    subcommand search {
        arity 2..
        detail {Search for text matching a pattern within the widget.}
        synopsis {pathName search ?switches? pattern index ?stopIndex?}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand see {
        arity 1
        detail {Scroll the widget so the character at index is visible.}
        synopsis {pathName see index}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand sync {
        arity 2 -also 0
        detail {Bring line-height metrics up to date now, or schedule a command once they are current.}
        synopsis {pathName sync ?-command commandPrefix?}
        traits DEFERS_BODY
        return_type String
        mutator
        side_effect InterpState -reads -writes

        option -command -takes command -role CommandPrefix -script-timing Deferred -appends {Exactly 0} \
            -detail {Command prefix scheduled once after line-height metrics become current.}
    }

    subcommand tag {
        arity 1..
        detail {Manipulate tags applied to ranges of text.}
        synopsis {pathName tag option ?arg ...?}
        traits DEFERS_BODY
        return_type String
        body_kind Structural
        mutator
        callback_taint_inputs {{3 %A}}
        arg_role_resolver -native tk::text::tag::arg_role_resolver
        arg_role_resolver_roles Body
        script_timing_resolver -native tk::text::tag::script_timing_resolver

        refine add {
            arity 3..
            selector add
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine bind-all {
            arity 2
            selector bind
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine bind-one {
            arity 3
            selector bind
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine bind-set {
            arity 4
            selector bind
            arg 3 -role Body
            traits DEFERS_BODY
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine cget {
            arity 3
            selector cget
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine configure-all {
            arity 2
            selector configure
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine configure-one {
            arity 3
            selector configure
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine configure-set {
            arity 4.. -step 2
            selector configure
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine delete {
            arity 2..
            selector delete
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine lower {
            arity 2..3
            selector lower
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine names {
            arity 1..2
            selector names
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine nextrange {
            arity 3..4
            selector nextrange
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine prevrange {
            arity 3..4
            selector prevrange
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine raise {
            arity 2..3
            selector raise
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine ranges {
            arity 2
            selector ranges
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine remove {
            arity 3..
            selector remove
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }

    subcommand window {
        arity 1..
        detail {Manipulate embedded windows within the text widget.}
        synopsis {pathName window option ?arg ...?}
        return_type String
        mutator

        refine cget {
            arity 3
            selector cget
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine configure-all {
            arity 2
            selector configure
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine configure-one {
            arity 3
            selector configure
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine configure-set {
            arity 4.. -step 2
            selector configure
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine create {
            arity 2.. -step 2
            selector create
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine names {
            arity 1
            selector names
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }

    subcommand xview {
        detail {Query or change the horizontal position of the text in the window.}
        synopsis {pathName xview ?args?}
        return_type List
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }

    subcommand yview {
        detail {Query or change the vertical position of the text in the window.}
        synopsis {pathName yview ?args?}
        return_type List
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }
}

command tk::toplevel {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    introduced_version 8.5
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class toplevel -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }
    }

    option -width -takes {} -detail {Desired width of the toplevel in screen units.}
    option -height -takes {} -detail {Desired height of the toplevel in screen units.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -background -takes {} -detail {Background colour of the toplevel window.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -borderwidth -takes {} -detail {Width of the border around the toplevel.}
    option -menu -takes {} \
        -detail {Path name of a menu widget to use as the toplevel's menu bar.}
    option -screen -takes {} -detail {Screen on which to place the toplevel window.}
    option -use -takes {} \
        -detail {Window identifier of a container in which to embed the toplevel.}
    option -class -takes {} \
        -detail {Class name for the toplevel, used in option database lookups.}
    option -colormap -takes {} \
        -detail {Colourmap to use for the toplevel: new or inherited from a window.}
    option -container -takes {} \
        -detail {Whether the toplevel will be a container for an embedded application.}
    option -visual -takes {} -detail {Visual information for the toplevel window.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the toplevel.}
    option -takefocus -takes {} \
        -detail {Whether the toplevel accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the toplevel does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the toplevel has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the toplevel.}
    option -pady -takes amount \
        -detail {Specifies a non-negative value indicating how much extra space to request for the widget in the Y-direction.}
    option -padx -takes amount \
        -detail {Specifies a non-negative value indicating how much extra space to request for the widget in the X-direction.}

    form Default {toplevel pathName ?option value ...?}

    hover {
        summary {Create and manipulate a toplevel widget.}
        synopsis {toplevel pathName ?option value ...?}
        description {Creates a new toplevel window that acts as a separate window manager frame, suitable for dialogue boxes and secondary windows.}
        source {Tk man page toplevel.n}
    }
}

