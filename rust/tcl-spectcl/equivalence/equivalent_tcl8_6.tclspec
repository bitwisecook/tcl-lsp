    option -servers -takes list -detail {List of SMTP servers to try, in order.}
    option -ports -takes list -detail {List of ports matching -servers.}
    option -username -takes user -detail {Username for SMTP authentication.}
    option -password -takes pass -detail {Password for SMTP authentication.}
    option -usetls -takes boolean -role Boolean \
        -detail {Whether to attempt STARTTLS negotiation.}
    option -tlspolicy -takes prefix -role CommandPrefix -appends {Exactly 2} \
        -detail {Command prefix consulted before STARTTLS; invoked with the SMTP response code and diagnostic text, and must return secure / insecure.}
    option -originator -takes addr -detail {Originator address override.}
    option -recipients -takes list -detail {Explicit recipient list override.}
    option -header -takes {{key value}} \
        -detail {A single header as a {key value} pair; may be repeated.}

    form Default {smtp::sendmessage token ?options?}

    hover {
        summary {Send an e-mail message via SMTP.}
        synopsis {smtp::sendmessage token ?-servers list? ?-ports list? ?-username user? ?-password pass? ?-usetls bool? ?-tlspolicy cmd? ?-originator addr? ?-recipients list? ?-header {key value} ...?}
        source {tcllib smtp package}
    }
}

