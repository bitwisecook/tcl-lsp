command report::report {
    available {tcl 8.5-}
    arity 2..
    required_package report
    tcllib_package report

    return_type String
    arg 0 -role Name
    arg 1 -role Value
    creates_instance_at 0

    object_class report::report {
        method destroy { arity 0 ; detail {destroy the report object} ; synopsis {reportName destroy} }
        method columns { arity 0 ; detail {number of columns in the report} ; synopsis {reportName columns} }

        method size {
            arity 1..2
            detail {get/set a column's width (a number or `dyn`)}
            synopsis {reportName size column ?number|dyn?}
            arg 1 -values-from report-report-report-report-size-arg1
        }

        method sizes { arity ..1 ; detail {get/set all column widths} ; synopsis {reportName sizes ?size-list?} }

        method pad {
            arity 1..3
            detail {get/set a column's padding}
            synopsis {reportName pad column ?left|right|both ?padstring??}
            arg 1 -values-from report-report-report-report-pad-arg1
        }

        method justify {
            arity 1..2
            detail {get/set a column's justification}
            synopsis {reportName justify column ?left|right|center?}
            arg 1 -values-from report-report-report-report-justify-arg1
        }

        method tcaption { arity ..1 ; detail {get/set the top caption region size} ; synopsis {reportName tcaption ?size?} }
        method bcaption { arity ..1 ; detail {get/set the bottom caption region size} ; synopsis {reportName bcaption ?size?} }
        method printmatrix { arity 1 ; detail {format a matrix using this report} ; synopsis {reportName printmatrix matrix} }

        method printmatrix2channel {
            arity 2
            detail {format a matrix, writing to a channel}
            synopsis {reportName printmatrix2channel matrix chan}
        }

        method top {
            arity 1..2
            detail {topmost separator line of the report}
            synopsis {<code> set data | get | enable | disable | enabled}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
            sub_subcommand enable \
                -detail {draw this separator line} -synopsis {<code> enable}
            sub_subcommand disable \
                -detail {do not draw this separator line} -synopsis {<code> disable}
            sub_subcommand enabled \
                -detail {query whether the separator is drawn} -synopsis {<code> enabled}
        }

        method topdatasep {
            arity 1..2
            detail {separator between rows of the top caption region}
            synopsis {<code> set data | get | enable | disable | enabled}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
            sub_subcommand enable \
                -detail {draw this separator line} -synopsis {<code> enable}
            sub_subcommand disable \
                -detail {do not draw this separator line} -synopsis {<code> disable}
            sub_subcommand enabled \
                -detail {query whether the separator is drawn} -synopsis {<code> enabled}
        }

        method topcapsep {
            arity 1..2
            detail {separator between the top caption and data regions}
            synopsis {<code> set data | get | enable | disable | enabled}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
            sub_subcommand enable \
                -detail {draw this separator line} -synopsis {<code> enable}
            sub_subcommand disable \
                -detail {do not draw this separator line} -synopsis {<code> disable}
            sub_subcommand enabled \
                -detail {query whether the separator is drawn} -synopsis {<code> enabled}
        }

        method datasep {
            arity 1..2
            detail {separator between rows of the data region}
            synopsis {<code> set data | get | enable | disable | enabled}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
            sub_subcommand enable \
                -detail {draw this separator line} -synopsis {<code> enable}
            sub_subcommand disable \
                -detail {do not draw this separator line} -synopsis {<code> disable}
            sub_subcommand enabled \
                -detail {query whether the separator is drawn} -synopsis {<code> enabled}
        }

        method botcapsep {
            arity 1..2
            detail {separator between the data and bottom caption regions}
            synopsis {<code> set data | get | enable | disable | enabled}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
            sub_subcommand enable \
                -detail {draw this separator line} -synopsis {<code> enable}
            sub_subcommand disable \
                -detail {do not draw this separator line} -synopsis {<code> disable}
            sub_subcommand enabled \
                -detail {query whether the separator is drawn} -synopsis {<code> enabled}
        }

        method botdatasep {
            arity 1..2
            detail {separator between rows of the bottom caption region}
            synopsis {<code> set data | get | enable | disable | enabled}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
            sub_subcommand enable \
                -detail {draw this separator line} -synopsis {<code> enable}
            sub_subcommand disable \
                -detail {do not draw this separator line} -synopsis {<code> disable}
            sub_subcommand enabled \
                -detail {query whether the separator is drawn} -synopsis {<code> enabled}
        }

        method bottom {
            arity 1..2
            detail {bottommost separator line of the report}
            synopsis {<code> set data | get | enable | disable | enabled}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
            sub_subcommand enable \
                -detail {draw this separator line} -synopsis {<code> enable}
            sub_subcommand disable \
                -detail {do not draw this separator line} -synopsis {<code> disable}
            sub_subcommand enabled \
                -detail {query whether the separator is drawn} -synopsis {<code> enabled}
        }

        method topdata {
            arity 1..2
            detail {template for data lines in the top caption region}
            synopsis {<code> set data | get}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
        }

        method data {
            arity 1..2
            detail {template for data lines in the data region}
            synopsis {<code> set data | get}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
        }

        method botdata {
            arity 1..2
            detail {template for data lines in the bottom caption region}
            synopsis {<code> set data | get}
            sub_subcommand set \
                -detail {install the line template} -synopsis {<code> set templatedata}
            sub_subcommand get -detail {return the line template} -synopsis {<code> get}
        }
    }

    form Default {report::report reportName columns ?style "style arg..."?}

    hover {
        summary {Creates a new report object with the given number of columns.}
        synopsis {report::report reportName columns ?style "style arg..."?}
        description {`reportName` becomes a command supporting the report configuration and rendering methods (`printmatrix`, `size`, `pad`, `justify`, the line codes, …). An optional `style` applies a previously-defined style at creation.}
        source {tcllib report package}
        example {::report::report r 3 style captionedtable 1 "Header"}
