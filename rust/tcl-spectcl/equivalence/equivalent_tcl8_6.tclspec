    option -columns -takes columnList -detail {List of column identifiers.}
    option -displaycolumns -takes columnList -detail {List of columns to display, or #all.}
    option -height -takes rows -detail {Number of rows to display.}
    option -headingheight -takes pixels -introduced 9.1 \
        -detail {Override the automatically calculated heading height in pixels.}
    option -padding -takes padSpec -detail {Internal padding around the widget content.}
    option -selectmode -takes mode -values-from ttk-treeview-selectmode -closed \
        -detail {How the built-in bindings manage selection.}
    option -selecttype -takes item|cell -values-from ttk-treeview-selecttype -closed -introduced 8.7 \
        -detail {Whether the built-in bindings select complete items or individual cells.}
    option -show -takes components \
        -detail {Which parts of the treeview to display (tree, headings, or both).}
    option -striped -takes boolean -role Boolean -introduced 8.7 \
        -detail {Use alternate-line colouring when the current theme supports it.}
    option -titlecolumns -takes count -introduced 9.0 \
        -detail {Number of leftmost display columns kept fixed while horizontally scrolling.}
    option -titleitems -takes count -introduced 9.0 \
        -detail {Number of top items kept fixed while vertically scrolling.}
    option -rowheight -takes pixels -introduced 9.1 \
        -detail {Override the automatically calculated row height in pixels.}
    option -xscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for horizontal scroll communication.}
    option -yscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for vertical scroll communication.}
    option -style -takes style -detail {Style to use for the widget.}
    option -class -takes className -detail {Widget class name for option-database lookups.}
    option -cursor -takes cursor \
        -detail {Cursor to display when the pointer is over the widget.}
    option -takefocus -takes focusSpec \
        -detail {Whether the widget accepts focus during keyboard traversal.}

    form Default {ttk::treeview pathName ?options?}

    hover {
        summary {Create and manipulate a themed hierarchical multicolumn data display widget.}
        synopsis {ttk::treeview pathName ?options?}
        source {Tk man page ttk_treeview.n}
