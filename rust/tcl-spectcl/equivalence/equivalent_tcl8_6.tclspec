        }

        refine query-one {
            arity 2
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 3.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }

        option -id -takes itemId -introduced 9.1 \
            -detail {Return the item's read-only identifier.}
        option -height -takes rows -introduced 9.0 \
            -detail {Height of the item in row-height multiples.}
        option -image -takes imageName \
            -detail {Image displayed beside the tree-column label.}
        option -imageanchor -takes anchor -values-from button-anchor -closed -introduced 9.0 \
            -detail {Alignment of the item image relative to its text.}
        option -hidden -takes boolean -role Boolean -introduced 9.0 \
            -detail {Whether the item is hidden from the current view.}
        option -open -takes boolean -role Boolean \
            -detail {Whether the item's children are displayed.}
        option -tags -takes tagList -detail {Tags associated with the item.}
        option -text -takes text -detail {Text displayed in the tree column.}
        option -values -takes valueList -detail {Values displayed in the data columns.}
        option state -takes stateSpec -introduced 9.1 \
            -detail {Query or modify the item's state flags.}
    }

    subcommand move {
        arity 3
        detail {Move an item below a parent at an index, or before or after another item.}
        synopsis {pathName move item parent index | pathName move item before|after otherItem}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand next {
        arity 1
        detail {Return the identifier of the item's next sibling.}
        synopsis {pathName next item}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand parent {
        arity 1
        detail {Return the identifier of the item's parent.}
        synopsis {pathName parent item}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand prev {
        arity 1
        detail {Return the identifier of the item's previous sibling.}
        synopsis {pathName prev item}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand range {
        arity 2..4
        detail {Return the inclusive view range between two items.}
        synopsis {pathName range ?-hidden? ?-norecurse? first last}
        introduced_version 9.1
        return_type List
        pure
        side_effect InterpState -reads
    }

    subcommand search {
        arity 2..23
        detail {Search an item's children using comparison and traversal options.}
        synopsis {pathName search parent ?options? pattern}
        introduced_version 9.1
        return_type String
        pure
        side_effect InterpState -reads

        option -all -detail {Return every match instead of only the first.}
        option -ascii -detail {Compare values as Unicode strings (the default).}
        option -backwards -detail {Search backwards from the start item or cell.}
        option -cell \
            -detail {Return cell identifiers and interpret start and stop as cells.}
        option -columns -takes columnList -detail {Limit the search to the listed columns.}
        option -dictionary \
            -detail {Use dictionary-style, case-insensitive string comparison.}
        option -exact -detail {Match the pattern as an exact string (the default).}
        option -forwards \
            -detail {Search forwards from the start item or cell (the default).}
        option -glob -detail {Interpret pattern using string-match glob rules.}
        option -hidden -detail {Include hidden items and descendants of closed items.}
        option -integer -detail {Compare pattern and non-empty cell values as integers.}
        option -nocase -detail {Use case-insensitive string matching.}
        option -not -detail {Return values that do not match the pattern.}
        option -real \
            -detail {Compare pattern and non-empty cell values as floating-point numbers.}
        option -recurse -aliases -recursive -detail {Search all descendants of parent.}
        option -regexp -detail {Interpret pattern as an advanced regular expression.}
        option -start -takes itemOrCell -detail {Start at this descendant item or cell.}
        option -stop -takes itemOrCell \
            -detail {Stop after searching this descendant item or cell.}
        option -unicode -detail {Alias for -ascii.}
        option -wraparound \
            -detail {Wrap from one end of the search range to the other when -start is used.}
    }

    subcommand see {
        arity 1..2
        arity 1 -retired 9.1
        arity 1..2 -introduced 9.1
        detail {Open and scroll to an item and, in Tk 9.1+, optionally a column.}
        synopsis {pathName see item ?column?}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand selection {
        arity ..5
        arity ..2 -retired 9.1
        arity ..5 -introduced 9.1
        detail {Query or modify the set of selected items.}
        synopsis {pathName selection ?selop ?-nohidden? ?-norecurse? arg ...?}
        return_type String

        refine query {
            arity 0
            traits {PURE TAINT_SOURCE_ZERO_ARGS}
            mutator no
            side_effect InterpState -reads
        }

        refine modify {
            arity 1..5
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand set {
        arity 1.. -step 2 -also 2
        detail {Query all values or one column, or set one or more column/value pairs.}
        synopsis {pathName set item ?column? ?value? ?column value ...?}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand size {
        arity 1..3
        detail {Count an item's children with optional traversal controls.}
        synopsis {pathName size ?-hidden? ?-recurse? item}
        introduced_version 9.1
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand sort {
        arity 1..20
        detail {Sort an item's children using comparison and traversal options.}
        synopsis {pathName sort parent ?options?}
        traits EVALUATES_CODE
        introduced_version 9.1
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes

        option -ascii -detail {Sort in Unicode character-code order (the default).}
        option -column -takes column -detail {Sort using values from the specified column.}
        option -command -takes prefix -role CommandPrefix -appends {Exactly 2} \
            -detail {Comparison command prefix invoked with the two values appended.}
        option -decreasing -detail {Sort from largest to smallest.}
        option -dictionary -detail {Use dictionary-style string ordering.}
        option -ignoreempty -detail {Permit empty values in integer or real sorts.}
        option -increasing -detail {Sort from smallest to largest (the default).}
        option -integer -detail {Sort values as integers.}
        option -nocase -detail {Ignore case for -ascii sorting.}
        option -real -detail {Sort values as floating-point numbers.}
        option -recurse -aliases -recursive -detail {Sort descendants recursively.}
        option -unicode -detail {Alias for -ascii.}
    }

    subcommand tag {
        arity 1..
        detail {Query or manipulate tags and their bindings and options.}
        synopsis {pathName tag add|bind|cell|configure|delete|has|names|remove ?arg ...?}
        traits DEFERS_BODY
        return_type String
        body_kind Structural
        mutator
        callback_taint_inputs {{3 %A}}
        arg_role_resolver -native ttk::treeview::tag::arg_role_resolver
        arg_role_resolver_roles Body
        script_timing_resolver -native ttk::treeview::tag::script_timing_resolver

        refine add {
            arity 3
            selector add
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine bind-all {
            arity 2
            selector bind
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine bind-one {
            arity 3
            selector bind
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine bind-set {
            arity 4
            selector bind
            traits DEFERS_BODY
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine cell-add {
            arity 4
            selector {cell add}
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine cell-has-all {
            arity 3
            selector {cell has}
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine cell-has-one {
            arity 4
            selector {cell has}
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine cell-remove-all {
            arity 3
            selector {cell remove}
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine cell-remove {
            arity 4
            selector {cell remove}
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine configure-all {
            arity 2
            selector configure
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine configure-one {
            arity 3
            selector configure
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine configure-set {
            arity 4.. -step 2
            selector configure
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine delete {
            arity 2
            selector delete
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine has-all {
            arity 2
            selector has
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine has-one {
            arity 3
            selector has
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine names {
            arity 1
            selector names
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine remove-all {
            arity 2
            selector remove
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }

        refine remove {
            arity 3
            selector remove
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
        sub_subcommand add -detail {Add a tag to a list of items.} -synopsis {pathName tag add tagName itemList} {}
        sub_subcommand bind -detail {Query or install a deferred event binding script for a tag.} -synopsis {pathName tag bind tagName ?sequence? ?script?} {}
        sub_subcommand cell -detail {Add, test, or remove tags on individual cells.} -synopsis {pathName tag cell add|has|remove tagName ?cellList?} -introduced 9.0 {}
        sub_subcommand configure -detail {Query or modify a tag's display options.} -synopsis {pathName tag configure tagName ?option? ?value option value ...?} {
            option -foreground -takes color \
                -detail {Text foreground colour for tagged items or cells.}
            option -background -takes color \
                -detail {Background colour for tagged items or cells.}
            option -font -takes font -detail {Font used for tagged text.}
            option -image -takes imageName -detail {Image used for tagged items or cells.}
            option -imageanchor -takes anchor -values-from button-anchor -closed -introduced 9.0 \
                -detail {Alignment of a tagged image.}
            option -padding -takes amount -introduced 9.0 \
                -detail {Padding around tagged cell contents.}
            option -stripedbackground -takes color -introduced 9.0 \
                -detail {Alternate-line background colour when -striped is enabled.}
        }
        sub_subcommand delete -detail {Delete a tag and its bindings and display information.} -synopsis {pathName tag delete tagName} -introduced 9.0 {}
        sub_subcommand has -detail {List tagged items or test whether an item has a tag.} -synopsis {pathName tag has tagName ?item?} {}
        sub_subcommand names -detail {Return all tags used by the widget.} -synopsis {pathName tag names} {}
        sub_subcommand remove -detail {Remove a tag from selected items or every item.} -synopsis {pathName tag remove tagName ?itemList?} {}
    }

    subcommand instate {
        arity 1..2
        detail {Test whether the widget state matches statespec, optionally running a script.}
        synopsis {pathName instate statespec ?script?}
        traits EVALUATES_CODE
        return_type String
        arg 1 -role Body
        side_effect InterpState -reads
        side_effect Unknown -reads -writes
    }

    subcommand state {
        arity ..1
        detail {Modify or query the widget state.}
        synopsis {pathName state ?stateSpec?}
        return_type List

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 1
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand style {
        arity 0
        detail {Return the widget's current style.}
        synopsis {pathName style}
        introduced_version 9.0
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand unhide {
        arity 1..2
        detail {Unhide items, optionally including descendants.}
        synopsis {pathName unhide ?-recurse? itemList}
        introduced_version 9.1
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand visible {
        arity 1
        detail {Return whether an item is visible in the current view.}
        synopsis {pathName visible item}
        introduced_version 9.1
        return_type Boolean
        pure
        side_effect InterpState -reads
    }

    subcommand xview {
        arity ..3
        detail {Query or change the horizontal position of the view.}
        synopsis {pathName xview | pathName xview moveto fraction | pathName xview scroll number units|pages}
        return_type String
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }

    subcommand yview {
        arity ..3
        detail {Query or change the vertical position of the view.}
        synopsis {pathName yview | pathName yview moveto fraction | pathName yview scroll number units|pages}
        return_type String
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }
}

