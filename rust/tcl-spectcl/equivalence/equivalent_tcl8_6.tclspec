command tcltest::configure {
    available {tcl 8.4-}
    required_package tcltest

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -verbose -takes levelList -values-from tcltest-configure-verbose \
        -detail {verbosity of test-run output}
    option -match -takes patternList \
        -detail {run only tests whose name matches one of these glob patterns}
    option -skip -takes patternList \
        -detail {skip tests whose name matches one of these glob patterns}
    option -file -takes pattern -detail {run tests in files matching this glob pattern}
    option -notfile -takes pattern -detail {skip test files matching this glob pattern}
    option -relateddir -takes pattern \
        -detail {run tests in directories matching this glob pattern}
    option -asidefromdir -takes pattern \
        -detail {skip tests in directories matching this glob pattern}
    option -constraints -takes constraintList -detail {do not skip the listed constraints}
    option -limitconstraints -takes boolean -role Boolean \
        -detail {run only tests with the listed constraints}
    option -singleproc -takes boolean -role Boolean \
        -detail {run all tests in one process rather than one per file}
    option -debug -takes level -values-from tcltest-configure-debug \
        -detail {internal debug level (integer)}
    option -preservecore -takes level -values-from tcltest-configure-preservecore \
        -detail {how aggressively to preserve core files (integer)}
    option -load -takes {} -role Body -body-kind Structural -script-timing Deferred \
        -detail {script that loads the tested commands}
    option -loadfile -takes file \
        -detail {file holding the script that loads the tested commands}
    option -tmpdir -takes dir -detail {directory for temporary files created during testing}
    option -testdir -takes dir -detail {directory searched for test files}
    option -outfile -takes file -detail {channel or file for test-run output}
    option -errfile -takes file -detail {channel or file for test-run errors}
    option -iterations -takes count -available {tcl 9.1} -introduced 2.6 \
        -detail {number of times to run each test (tcltest 2.6+)}

    hover {
        summary {Get or set tcltest configuration options.}
        synopsis {tcltest::configure ?option? ?value option value ...?}
        description {Options include ``-verbose``, ``-debug``, ``-outfile``, ``-errfile``, ``-tmpdir``, ``-testdir``, ``-file``, ``-notfile``, ``-relateddir``, ``-asidefromdir``, ``-match``, ``-skip``, ``-constraints``, ``-limitconstraints``, ``-singleproc``, ``-preservecore``, ``-load``, ``-loadfile``, and ``-iterations`` (tcltest 2.6+).}
        source {Tcl stdlib tcltest package}
    }
}

