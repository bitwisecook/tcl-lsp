        method identify { arity 2 ; detail {Identify the panedwindow component at the given coordinates.} ; synopsis {pathName identify x y} }

        method panecget {
            arity 2
            detail {Return the value of a configuration option for a pane.}
            synopsis {pathName panecget window option}
        }

        method paneconfigure {
            arity 1..
            detail {Query or modify configuration options of a pane.}
            synopsis {pathName paneconfigure window ?option? ?value option value ...?}
        }

        method panes { arity 0 ; detail {Return a list of all panes in the panedwindow.} ; synopsis {pathName panes} }

