command tcltest::test {
    available {tcl 8.4-}
    arity 2..
    required_package tcltest
    is_namespace_exported

    body_kind Structural
    # TODO(spectcl): `body_execution` is set on the source spec. The DSL spells
    #   it `body_execution -native CONTRACT`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    defines_symbol -name-arg 0 -detail-arg 1 -kind Test

    arg_role_resolver -native tcltest::test::arg_role_resolver
    arg_role_resolver_roles Body

    side_effect InterpState -reads -writes

    option -body -takes {} -role Body -body-kind Structural \
        -detail {the Tcl script that makes up the body of the test}
    option -setup -takes {} -role Body -body-kind Structural \
        -detail {a script to run before the test body}
    option -cleanup -takes {} -role Body -body-kind Structural \
        -detail {a script to run after the test body}
    option -constraints -takes constraintList \
        -detail {constraints that must all be satisfied for the test to run}
    option -result -takes expected -detail {the expected result of the test body}
    option -output -takes expected \
        -detail {expected data written to the output channel by the test body}
    option -errorOutput -takes expected \
        -detail {expected data written to the error channel by the test body}
    option -returnCodes -takes codeList -values-from tcltest-test-returncodes \
        -detail {acceptable return code(s) from the test body}
    option -errorCode -takes pattern -available {tcl 8.6-} -introduced 2.5 \
        -detail {expected -errorcode from the test body (tcltest 2.5+)}
    option -match -takes mode -values-from tcltest-test-match \
        -detail {match algorithm comparing actual to expected result}

    form Default {test name description ?option value ...?}

    hover {
        summary {Define and run a single test case.}
        synopsis {tcltest::test name description ?option value ...?}
        synopsis {tcltest::test name description ?constraints? body result}
        description {The primary command for defining tests.  Options include ``-body``, ``-result``, ``-output``, ``-errorOutput``, ``-returnCodes``, ``-match``, ``-setup``, ``-cleanup``, and ``-constraints``.}
        source {Tcl stdlib tcltest package}
    }
}

