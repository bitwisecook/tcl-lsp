command bibtex::parse {
    available {tcl 8.5-}
    required_package bibtex
    tcllib_package bibtex

    script_timing_resolver -native bibtex::parse::script_timing_resolver

    option -command -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Batch callback invoked once at EOF with the token and the full record list.}
    option -recordcommand -takes prefix -role CommandPrefix -appends {Exactly 4} \
        -detail {Per-record callback invoked with token, entry type, key, and record data.}
    option -preamblecommand -takes prefix -role CommandPrefix -appends {Exactly 2} \
        -detail {Per-preamble callback invoked with token and the preamble text.}
    option -stringcommand -takes prefix -role CommandPrefix -appends {Exactly 2} \
        -detail {Per-@string callback invoked with token and the string macro(s).}
    option -commentcommand -takes prefix -role CommandPrefix -appends {Exactly 2} \
        -detail {Per-comment callback invoked with token and the comment text.}
    option -progresscommand -takes prefix -role CommandPrefix -appends {Exactly 2} \
        -detail {Progress callback invoked with token and a percentage.}
    option -channel -takes chan -role Channel \
        -detail {Parse incrementally from this channel instead of a text string.}
    option -casesensitivestrings -takes boolean -role Boolean \
        -detail {Treat @string macro names case-sensitively.}
    option_conflict {-command -recordcommand}
    option_conflict {-command -preamblecommand}
    option_conflict {-command -stringcommand}
    option_conflict {-command -commentcommand}
    option_conflict {-command -progresscommand}
    option_requires -command -channel -message {Option -command and text exclude each other: bibtex::parse -command is the channel-completion callback and needs -channel}
    option_forbids -channel {{arg 0}} -message {Option -channel and text exclude each other}
    option_requires_one_of {} {-channel {arg 0}} -message {Neither -channel nor text specified}

    hover {
        summary {This is the general form of the command for parsing a bibliography.}
        synopsis {bibtex::parse ?options? ?text?}
        source {tcllib bibtex package}
    }
}

command bibtex::wait {
    available {tcl 8.5-}
