command namespace {
    available {tcl 8.4-}
    traits {LANGUAGE_KEYWORD NEVER_INLINE_BODY BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME DYNAMIC_EVAL_BODY}
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    codegen_hook -native Namespace

    side_effect InterpState -writes
    side_effect NamespaceState -writes

    runtime_backing shipped-builtin namespace

    form Default {namespace subcommand ?arg ...?}

    hover {
        summary {Create and manipulate contexts for commands and variables.}
        synopsis {namespace subcommand ?arg ...?}
        description {A namespace is a container for commands and variables, keeping them separate from same-named commands and variables elsewhere in a program. Namespaces nest, using :: to qualify names (::foo::bar::x); the global namespace's real name is the empty string, though :: is accepted everywhere as a synonym. An unqualified command name resolves in the current namespace, then the namespace's command resolution path (Tcl 8.5+, empty by default), then the global namespace, or else the namespace unknown handler. An unqualified variable name resolves the same way through Tcl 8.6 (current namespace, then global); Tcl 9.0 removed the fallback to the global namespace, so an unqualified variable is found only in the current namespace unless declared with `variable` or referenced by a qualified name. Not available in F5 iRules, whose data-plane interpreter strips namespace entirely.}
        source {Tcl namespace(n)}
        example {namespace eval ::counter {
    variable n 0
    namespace export bump
    proc bump {} {
        variable n
        incr n
    }
}
::counter::bump
namespace eval ::client {
    namespace import ::counter::bump
    bump
}}
    }

    subcommand children {
        arity ..2
        detail {Returns a list of all child namespaces.}
        synopsis {namespace children ?name? ?pattern?}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        arg 0 -role NamespaceName
        arg 1 -role Pattern
    }

    subcommand code {
        arity 1
        detail {Captures the current namespace context for later execution.}
        synopsis {namespace code script}
        traits {WRAPS_COMMAND_PREFIX DEFERS_BODY}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `native_result` is set on the source spec. The DSL
        #   spells it `native_result -native CONTRACT`, but a draft records only
        #   that the field is set, never the expression that set it.
        pure
        arg 0 -role Body
        inline_codegen_hook -native NamespaceCode
    }

    subcommand current {
        arity 0
        detail {Returns the fully-qualified name for the current namespace.}
        synopsis {namespace current}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        inline_codegen_hook -native NamespaceCurrent
    }

    subcommand delete {
        detail {Delete namespaces and their contents.}
        synopsis {namespace delete ?namespace namespace ...?}
        traits FIRE_AND_FORGET_TEARDOWN
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        destructive
        arg_role_count_resolver -native namespace::delete::arg_role_count_resolver
        arg_role_resolver_roles NamespaceName
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand ensemble {
        arity 1..
        detail {Creates and manipulates a command ensemble.}
        synopsis {namespace ensemble subcommand ?arg ...?}
        traits {REFLECTS_COMMAND_NAMES EXPORTS_COMMAND}
        available {tcl 8.5-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg_values_accept_prefix
        arg 0 -values-from namespace-ensemble-arg0 -closed
        analyser_hook -native NamespaceEnsemble
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.

        option -command -takes name \
            -detail {Name of the ensemble's dispatch command (default: the fully-qualified name of the invoking namespace). Write-only, and valid only with create — configure rejects it as a bad option.}
        option -map -takes dict \
            -detail {Maps subcommand names to target command-prefix lists, similar to interp alias (default: empty, meaning each subcommand maps to the identically-named command in the linked namespace).}
        option -namespace \
            -detail {The namespace the ensemble dispatches into, fixed when it was created. Read it back with configure; supplying a value raises "option -namespace is read-only", and create rejects it as a bad option.}
        option -parameters -takes list -available {tcl 8.6-} \
            -detail {Named arguments inserted between the ensemble command and the subcommand, used when generating error messages (default: none).}
        option -prefixes -takes boolean -role Boolean \
            -detail {Whether unambiguous subcommand prefixes are accepted (default: on).}
        option -subcommands -takes list \
            -detail {Explicit list of valid subcommand names (default: empty, meaning the -map keys or the linked namespace's exported commands).}
        option -unknown -takes prefix -role CommandPrefix -script-timing Deferred \
            -detail {Command prefix invoked, with the ensemble's own invocation words appended, when a subcommand is not recognised (default: none, which raises a standard "unknown subcommand" error).}
        sub_subcommand create -detail {Create an ensemble command for the current namespace.} -synopsis {namespace ensemble create ?-option value ...?} {
            option -command -takes name \
                -detail {Name of the ensemble's dispatch command (default: the fully-qualified name of the invoking namespace). Write-only, and valid only with create — configure rejects it as a bad option.}
            option -map -takes dict \
                -detail {Maps subcommand names to target command-prefix lists, similar to interp alias (default: empty, meaning each subcommand maps to the identically-named command in the linked namespace).}
            option -parameters -takes list -available {tcl 8.6-} \
                -detail {Named arguments inserted between the ensemble command and the subcommand, used when generating error messages (default: none).}
            option -prefixes -takes boolean -role Boolean \
                -detail {Whether unambiguous subcommand prefixes are accepted (default: on).}
            option -subcommands -takes list \
                -detail {Explicit list of valid subcommand names (default: empty, meaning the -map keys or the linked namespace's exported commands).}
            option -unknown -takes prefix -role CommandPrefix -script-timing Deferred \
                -detail {Command prefix invoked, with the ensemble's own invocation words appended, when a subcommand is not recognised (default: none, which raises a standard "unknown subcommand" error).}
        }
        sub_subcommand configure -detail {Query or update an existing ensemble command.} -synopsis {namespace ensemble configure command ?-option? ?value ...?} -option_prefix_words 1 {
            option -map -takes dict \
                -detail {Maps subcommand names to target command-prefix lists, similar to interp alias (default: empty, meaning each subcommand maps to the identically-named command in the linked namespace).}
            option -namespace \
                -detail {The namespace the ensemble dispatches into, fixed when it was created. Read it back with configure; supplying a value raises "option -namespace is read-only", and create rejects it as a bad option.}
            option -parameters -takes list -available {tcl 8.6-} \
                -detail {Named arguments inserted between the ensemble command and the subcommand, used when generating error messages (default: none).}
            option -prefixes -takes boolean -role Boolean \
                -detail {Whether unambiguous subcommand prefixes are accepted (default: on).}
            option -subcommands -takes list \
                -detail {Explicit list of valid subcommand names (default: empty, meaning the -map keys or the linked namespace's exported commands).}
            option -unknown -takes prefix -role CommandPrefix -script-timing Deferred \
                -detail {Command prefix invoked, with the ensemble's own invocation words appended, when a subcommand is not recognised (default: none, which raises a standard "unknown subcommand" error).}
        }
        sub_subcommand exists -detail {Return whether command is an ensemble command.} -synopsis {namespace ensemble exists command} {}
    }

    subcommand eval {
        arity 2..
        detail {Evaluate a script in a namespace context.}
        synopsis {namespace eval namespace arg ?arg ...?}
        traits {EVALUATES_CODE SCRIPT_CONCATENATES_ARGS DECLARES_NAMESPACE}
        return_type String
        body_kind Structural
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
        #   spells it `successful_handler -native
        #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
        #   -direct-provider
        #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
        #   but a pack may not author this field.
        arg 0 -role NamespaceName
        arg 1 -role Body
        lowering_hook -native NamespaceEval
        analyser_hook -native NamespaceEval
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand exists {
        arity 1
        detail {Test whether a namespace exists.}
        synopsis {namespace exists namespace}
        return_type Boolean
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        arg 0 -role NamespaceName
    }

    subcommand export {
        detail {Specifies which commands are exported from a namespace; with no patterns and no -clear, returns the namespace's current export list.}
        synopsis {namespace export ?-clear? ?pattern pattern ...?}
        traits {REFLECTS_COMMAND_NAMES EXPORTS_COMMAND}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        max_leading_option_words 1
        analyser_hook -native NamespaceExport
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.

        option -clear \
            -detail {Reset the namespace's export pattern list to empty before appending the given patterns.}
    }

    subcommand forget {
        detail {Removes previously imported commands from a namespace.}
        synopsis {namespace forget ?pattern pattern ...?}
        traits {REFLECTS_COMMAND_NAMES FIRE_AND_FORGET_TEARDOWN}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        destructive
        analyser_hook -native NamespaceForget
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand import {
        detail {Imports commands into a namespace; with no arguments, returns the list of commands already imported into the current namespace (Tcl 8.5+).}
        synopsis {namespace import ?-force? ?pattern pattern ...?}
        traits REFLECTS_COMMAND_NAMES
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        max_leading_option_words 1
        analyser_hook -native NamespaceImport
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.

        option -force \
            -detail {Silently overwrite an existing command instead of erroring on conflict.}
    }

    subcommand inscope {
        arity 2..
        detail {Executes a script in the context of the specified namespace.}
        synopsis {namespace inscope namespace script ?arg ...?}
        traits {EVALUATES_CODE SCRIPT_CONCATENATES_ARGS SCRIPT_APPENDS_LIST_ARGS}
        return_type String
        body_kind Structural
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 0 -role NamespaceName
        arg 1 -role Body
        analyser_hook -native NamespaceEval
    }

    subcommand origin {
        arity 1
        detail {Returns the fully-qualified name of the original command.}
        synopsis {namespace origin name}
        traits REFLECTS_COMMAND_NAMES
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        arg 0 -role CommandName
        inline_codegen_hook -native NamespaceOrigin
    }

    subcommand parent {
        arity ..1
        detail {Returns the fully-qualified name of the parent namespace.}
        synopsis {namespace parent ?namespace?}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        arg 0 -role NamespaceName
    }

    subcommand path {
        arity ..1
        detail {Returns the command resolution path of the current namespace.}
        synopsis {namespace path ?namespaceList?}
        available {tcl 8.5-}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        analyser_hook -native NamespacePath
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand qualifiers {
        arity 1
        detail {Returns any leading namespace qualifiers for string.}
        synopsis {namespace qualifiers string}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        const_fold -native namespace::qualifiers::const_fold
    }

    subcommand tail {
        arity 1
        detail {Returns the simple name at the end of a qualified string.}
        synopsis {namespace tail string}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        const_fold -native namespace::tail::const_fold
    }

    subcommand unknown {
        arity ..1
        detail {Sets or returns the unknown command handler for the current namespace.}
        synopsis {namespace unknown ?script?}
        traits REFLECTS_COMMAND_NAMES
        available {tcl 8.5-}
        return_type String
        script_lookup_scope TriggerFrame
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 0 -appends {AtLeast 1}
        script_timing_resolver -native namespace::unknown::script_timing_resolver
        analyser_hook -native NamespaceUnknown
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand upvar {
        arity 1.. -step 2
        detail {Arrange local variables to refer to namespace variables, as zero or more otherVar/myVar pairs. Tcl 8.5 requires at least one pair; from Tcl 8.6 the namespace argument alone is legal (and a no-op).}
        synopsis {namespace upvar namespace ?otherVar myVar ...?}
        available {tcl 8.5-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        creates_scope_alias
        arg 0 -role NamespaceName
        repeat VarWrite -from 2 -stride 2
        codegen_hook -native NamespaceUpvar

        refine tcl8.5 {
            arity 3.. -step 2
            arg 0 -role NamespaceName
            available {tcl 8.5}
        }

        refine tcl8.6+ {
            arity 1.. -step 2
            arg 0 -role NamespaceName
            available {tcl 8.6-}
        }
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand which {
        arity 1
        detail {Looks up name as either a command or variable.}
        synopsis {namespace which ?-command? ?-variable? name}
        traits REFLECTS_COMMAND_NAMES
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        reserved_trailing_words 1
        arg_role_layout_resolver -native namespace::which::arg_role_layout_resolver
        arg_role_resolver_roles {VarRead CommandNameProbe}

        option -command -detail {Resolve name as a command (the default).}
        option -variable -detail {Resolve name as a variable.}
    }
}

command namespacex {
    available {tcl 8.5-}
    arity 1..
    required_package namespacex
    tcllib_package namespacex

    hover {
        summary {Namespace-manipulation utilities (hook/import/info/state/normalize/strip).}
        synopsis {namespacex subcommand ?arg ...?}
        source {tcllib namespacex package}
    }

    subcommand hook {
        arity 1..
        detail {Manage a namespace command-resolution hook (add/proc/on/next).}
        synopsis {namespacex hook add|proc|on|next ?namespace? ...}
    }

    subcommand import {
        arity 1..
        detail {Import commands from another namespace (fromns).}
        synopsis {namespacex import fromns src ?cmd ...?}
    }

    subcommand info {
        arity 1..
        detail {Query namespace structure (allchildren/allvars/vars).}
        synopsis {namespacex info allchildren|allvars|vars namespace}
    }

    subcommand state {
        arity 1..
        detail {Save, restore, or drop a namespace's variable state (get/set/drop).}
        synopsis {namespacex state get|set|drop namespace ?state?}
    }

    subcommand normalize { arity 1 ; detail {Normalise a namespace name to its fully-qualified form.} ; synopsis {namespacex normalize name} }

    subcommand strip {
        arity 2
        detail {Strip a leading namespace prefix from a fully-qualified name.}
        synopsis {namespacex strip prefix name}
    }
}

