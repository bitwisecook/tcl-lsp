command tcl::OptProc {
    available {tcl 8.4-}
    traits {NEVER_INLINE_BODY DEFINES_PROCEDURE BYTE_COMPILED NOT_PROC_FACTORY DEFERS_BODY BODY_RUNS_IN_OWN_FRAME}
    arity 3
    required_package opt

    body_kind Structural
    arg 0 -role Name
    arg 1 -role ParamList
    arg 2 -role Body

    analyser_hook -native OptProc

    side_effect Unknown -reads
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    hover {
        summary {Define a proc with automatic option parsing.}
        synopsis {tcl::OptProc name optlist body}
        description {Defines a procedure *name* whose arguments are parsed according to *optlist*, a list of option descriptions.  Inside *body*, option values are available as local variables.}
        source {Tcl stdlib opt package}
    }
}

