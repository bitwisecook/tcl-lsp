command puts {
    available {tcl 8.4-}
    traits {TAINT_SINK BYTE_COMPILED FRAMELESS_RUNTIME}
    arity 1..2

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    arg_role_layout_resolver -native puts::arg_role_layout_resolver
    arg_role_resolver_roles Channel
    semantic_operation {Intrinsic ChannelWrite}
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect FileIo -writes

    taint_output_sink T101

    runtime_backing shipped-builtin puts

    option -nonewline -detail {Suppress the newline puts normally appends after string.}

    form Default {puts ?-nonewline? ?channelId? string}

    hover {
        summary {Write a string to a channel (stdout by default).}
        synopsis {puts ?-nonewline? ?channelId? string}
        description {Writes string to channelId, appending a newline unless -nonewline is given. channelId must be an open, writable channel — a Tcl standard channel (stdout or stderr), the result of open or socket, or a channel created by a Tcl extension — and defaults to stdout when omitted. Newline characters are translated to the channel's platform-specific end-of-line sequence according to its -translation setting; see fconfigure. Tcl buffers output internally, so text written may not reach the underlying file or device immediately — use flush to force it out. On a blocking channel, puts blocks once the output buffer fills, until the operating system accepts the buffered data; on a nonblocking channel it never blocks, instead buffering arbitrarily large amounts of data in the background, so pair nonblocking output with the event loop and fileevent to avoid unbounded memory growth. Since Tcl 8.5, chan puts offers the identical functionality through the chan ensemble, and from Tcl 9.0 the puts manual page itself just redirects there — though puts remains a fully supported, independent command in every version. Starting in Tcl 9.0, if the channel's encoding profile is strict (the default), puts raises a POSIX EILSEQ error when the string being written cannot be represented in the channel's configured encoding, instead of silently substituting a fallback character for the unencodable data (as the non-default tcl8/replace profiles do); the write may be partially completed before the error is raised.}
        source {Tcl puts(n)}
        example {puts "Hello, World!"
puts -nonewline "Hello, "
puts "World!"
puts stderr "Hello, World!"
set chan [open my.log a]
puts $chan [clock format [clock seconds]]
close $chan}
        returns {Empty string on success.}
    }
}

command pwd {
    available {tcl 8.4-}
    traits {RETURNS_PATH BYTE_COMPILED SAFE_INTERP_HIDDEN}
    arity 0

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect FileIo -reads

    runtime_backing shipped-builtin pwd

    form Default {pwd}

    hover {
        summary {Return the absolute path of the current working directory.}
        synopsis {pwd}
        description {Returns the absolute path name of the current working directory. The working directory is a per-process resource shared by every interpreter and, in a threaded build, every thread — the same one `cd` changes — so the result always reflects the most recent `cd` in the process, not a per-interpreter starting point. Errors if the working directory can no longer be determined, for example if it has been deleted, unmounted, or otherwise made inaccessible while the process was running.}
        source {Tcl pwd(n)}
        example {set tarFile [file normalize somefile.tar]
set savedDir [pwd]
cd /tmp
exec tar -xf $tarFile
cd $savedDir}
        returns {The absolute path of the current working directory.}
    }
}

command radiobutton {
    available {tcl 8.4-} {package Tk}
    traits TAINTS_VAR_WRITES
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class radiobutton -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a radiobutton option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change radiobutton options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method deselect {
            arity 0
            detail {Deselect the radiobutton and clear its associated variable.}
            synopsis {pathName deselect}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method flash {
            arity 0
            detail {Flash the radiobutton using its active and normal colours.}
            synopsis {pathName flash}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method invoke {
            arity 0
            detail {Select the radiobutton and invoke its associated command.}
            synopsis {pathName invoke}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method select {
            arity 0
            detail {Select the radiobutton and set its associated variable to -value.}
            synopsis {pathName select}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }
    }

    option -text -takes {} -detail {Text to display in the radiobutton.}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Name of a variable whose value will be used as the radiobutton text.}
    option -background -takes color -detail {Normal background colour of the radiobutton.}
    option -borderwidth -takes {screen units} \
        -detail {Width of the border around the radiobutton.}
    option -foreground -takes color -detail {Normal foreground colour of the radiobutton.}
    option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global -taints-var-write \
        -detail {Name of the global variable shared by all radiobuttons in the group.}
    option -value -takes {} \
        -detail {Value stored in the variable when this radiobutton is selected.}
    option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
        -detail {Tcl command to invoke when the radiobutton is selected.}
    option -state -takes {} -detail {State of the radiobutton: normal, active, or disabled.}
    option -indicatoron -takes {} -detail {Whether to display the selection indicator.}
    option -selectimage -takes {} \
        -detail {Image to display when the radiobutton is selected.}
    option -selectcolor -takes {} \
        -detail {Colour of the indicator when the radiobutton is selected.}
    option -image -takes {} -detail {Image to display in the radiobutton.}
    option -bitmap -takes {} -detail {Bitmap to display in the radiobutton.}
    option -compound -takes {} \
        -detail {Whether to display both image and text: none, bottom, top, left, right, or center.}
    option -width -takes {} \
        -detail {Desired width of the radiobutton in characters (text) or pixels (image).}
    option -height -takes {} \
        -detail {Desired height of the radiobutton in lines (text) or pixels (image).}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {How information is positioned: n, ne, e, se, s, sw, w, nw, or center.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of multi-line text: left, center, or right.}
    option -wraplength -takes {} \
        -detail {Maximum line length for word wrapping, in screen units.}
    option -underline -takes {} \
        -detail {Index of character to underline for keyboard traversal (0-based).}
    option -font -takes {} -detail {Font to use for the radiobutton text.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -activebackground -takes {} \
        -detail {Background colour when the radiobutton is active (mouse over).}
    option -activeforeground -takes {} \
        -detail {Foreground colour when the radiobutton is active.}
    option -disabledforeground -takes {} \
        -detail {Foreground colour when the radiobutton is disabled.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -padx -takes {} -detail {Extra horizontal padding inside the radiobutton.}
    option -pady -takes {} -detail {Extra vertical padding inside the radiobutton.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the radiobutton.}
    option -takefocus -takes {} \
        -detail {Whether the radiobutton accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the radiobutton does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the radiobutton has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the radiobutton.}
    option -overrelief -takes {} \
        -detail {Relief to use when the mouse cursor is over the radiobutton.}
    option -tristateimage -takes {} \
        -detail {Image to display when the radiobutton is in the tristate mode.}
    option -tristatevalue -takes {} \
        -detail {Value that places the radiobutton in tristate mode.}

    form Default {radiobutton pathName ?option value ...?}

    hover {
        summary {Create and manipulate a radiobutton widget.}
        synopsis {radiobutton pathName ?option value ...?}
        description {Displays a textual string, bitmap, or image with a selection indicator for mutual-exclusion choices within a group.}
        source {Tk man page radiobutton.n}
    }

    subcommand cget {
        arity 1
        detail {Return the current value of a radiobutton option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change radiobutton options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand deselect {
        arity 0
        detail {Deselect the radiobutton and clear its associated variable.}
        synopsis {pathName deselect}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand flash {
        arity 0
        detail {Flash the radiobutton using its active and normal colours.}
        synopsis {pathName flash}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand invoke {
        arity 0
        detail {Select the radiobutton and invoke its associated command.}
        synopsis {pathName invoke}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand select {
        arity 0
        detail {Select the radiobutton and set its associated variable to -value.}
        synopsis {pathName select}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }
}

