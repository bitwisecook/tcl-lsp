command panedwindow {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class panedwindow -method-prefix-matching Enabled {
        method add {
            arity 1..
            detail {Add one or more child windows to the panedwindow.}
            synopsis {pathName add window ?window ...? ?option value ...?}
        }

        method forget { arity 1 ; detail {Remove the specified pane from the panedwindow.} ; synopsis {pathName forget window} }
        method identify { arity 2 ; detail {Identify the panedwindow component at the given coordinates.} ; synopsis {pathName identify x y} }

        method panecget {
            arity 2
            detail {Return the value of a configuration option for a pane.}
            synopsis {pathName panecget window option}
        }

        method paneconfigure {
            arity 1..
            detail {Query or modify configuration options of a pane.}
            synopsis {pathName paneconfigure window ?option? ?value option value ...?}
        }

        method panes { arity 0 ; detail {Return a list of all panes in the panedwindow.} ; synopsis {pathName panes} }

        method proxy {
            detail {Query or manipulate the sash-drag proxy.}
            synopsis {pathName proxy ?args?}
            mutator

            refine coord {
                arity 1
                selector coord
                traits PURE
                mutator no
                side_effect InterpState -reads
            }
            side_effect InterpState -reads -writes
        }

        method sash {
            arity 1..
            detail {Query or adjust sash positions.}
            synopsis {pathName sash option ?arg ...?}
            mutator

            refine coord {
                arity 2
                selector coord
                traits PURE
                mutator no
                side_effect InterpState -reads
            }
            side_effect InterpState -reads -writes
        }
    }

    option -orient -takes {} \
        -detail {Orientation of the panedwindow: horizontal or vertical.}
    option -sashwidth -takes {} -detail {Width of each sash in screen units.}
    option -sashrelief -takes {} \
        -detail {Relief of the sashes: flat, groove, raised, ridge, solid, or sunken.}
    option -sashpad -takes {} -detail {Extra padding on each side of a sash.}
    option -sashcursor -takes {} -detail {Cursor to display when the mouse is over a sash.}
    option -showhandle -takes {} -detail {Whether to display handles on the sashes.}
    option -handlesize -takes {} -detail {Size of the sash handle in screen units.}
    option -handlepad -takes {} \
        -detail {Distance from the top or left end of a sash to the handle.}
    option -opaqueresize -takes {} \
        -detail {Whether panes are resized continuously as the sash is dragged.}
    option -width -takes {} -detail {Desired width of the panedwindow in screen units.}
    option -height -takes {} -detail {Desired height of the panedwindow in screen units.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -background -takes {} -detail {Background colour of the panedwindow.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -borderwidth -takes {} -detail {Width of the border around the panedwindow.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the panedwindow.}
    option -takefocus -takes {} \
        -detail {Whether the panedwindow accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the panedwindow does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the panedwindow has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the panedwindow.}

    form Default {panedwindow pathName ?option value ...?}

    hover {
        summary {Create and manipulate a panedwindow widget.}
        synopsis {panedwindow pathName ?option value ...?}
        description {Displays a container that divides its space among child widgets separated by movable sashes.}
        source {Tk man page panedwindow.n}
    }

    subcommand add {
        arity 1..
        detail {Add one or more child windows to the panedwindow.}
        synopsis {pathName add window ?window ...? ?option value ...?}
    }

    subcommand forget { arity 1 ; detail {Remove the specified pane from the panedwindow.} ; synopsis {pathName forget window} }
    subcommand identify { arity 2 ; detail {Identify the panedwindow component at the given coordinates.} ; synopsis {pathName identify x y} }

    subcommand panecget {
        arity 2
        detail {Return the value of a configuration option for a pane.}
        synopsis {pathName panecget window option}
    }

    subcommand paneconfigure {
        arity 1..
        detail {Query or modify configuration options of a pane.}
        synopsis {pathName paneconfigure window ?option? ?value option value ...?}
    }

    subcommand panes { arity 0 ; detail {Return a list of all panes in the panedwindow.} ; synopsis {pathName panes} }

    subcommand proxy {
        detail {Query or manipulate the sash-drag proxy.}
        synopsis {pathName proxy ?args?}
        mutator

        refine coord {
            arity 1
            selector coord
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }

    subcommand sash {
        arity 1..
        detail {Query or adjust sash positions.}
        synopsis {pathName sash option ?arg ...?}
        mutator

        refine coord {
            arity 2
            selector coord
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }
}

command parray {
    available {tcl 8.4-}
    traits {WHOLE_ARRAY_ARG OVERRIDABLE_LIBRARY_PROC}
    arity 1..2

    return_type String
    pattern_type Glob
    arg 0 -role VarRead
    arg 1 -role Pattern

    side_effect FileIo -writes
    side_effect Variable -reads

    runtime_backing tcl-body {-package-source parray.tcl}

    form Default {parray arrayName ?pattern?} -available {tcl 8.5-}
    form Default {parray arrayName} -available {tcl 8.4}

    hover {
        summary {Print an array's names and values to standard output.}
        synopsis {parray arrayName ?pattern?}
        synopsis {parray arrayName}
        description {Prints every name/value pair in arrayName to stdout, one pair per line as `arrayName(elementName) = value`, with the name field padded so every `=` lines up in a column; names are visited in sorted order. arrayName must already be an array accessible to the caller — local or global — since parray reaches it via upvar. Since Tcl 8.5, an optional trailing pattern restricts the printed elements to those whose names match pattern under string match's glob rules; Tcl 8.4 has no pattern argument and always prints every element. Output always goes to stdout; there is no option to target a different channel. parray is a standard-library Tcl procedure, autoloaded like foreachLine or the auto_* helpers, and a script may freely redefine it.}
        source {Tcl library(n)}
        example {parray tcl_platform             ;# prints every tcl_platform element
parray tcl_platform os*         ;# Tcl 8.5+: prints only names matching the glob os* (e.g. os, osVersion)}
        returns {The empty string.}
    }
}

