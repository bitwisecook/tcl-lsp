    option -locale -takes {locale name} -introduced 9.1 \
        -detail {Locale used to determine word and character boundaries (Tk 9.1+).}
    option -width -takes {} -detail {Desired width of the text widget in characters.}
    option -background -takes color -detail {Normal background colour of the text widget.}
    option -borderwidth -takes {screen units} \
        -detail {Width of the border around the text widget.}
    option -foreground -takes color -detail {Normal foreground colour of the text widget.}
    option -height -takes {} -detail {Desired height of the text widget in lines.}
    option -wrap -takes {} -detail {Line wrapping mode: none, char, or word.}
    option -state -takes {} -detail {State of the text widget: normal or disabled.}
    option -font -takes {} -detail {Font to use for text in the widget.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -spacing1 -takes {} \
        -detail {Extra space above each line of text, in screen units.}
    option -spacing2 -takes {} \
        -detail {Extra space between display lines within a logical line, in screen units.}
    option -spacing3 -takes {} \
        -detail {Extra space below each line of text, in screen units.}
    option -tabs -takes {} -detail {Tab stop positions and alignment for the text widget.}
    option -insertbackground -takes {} -detail {Colour of the insertion cursor.}
    option -insertborderwidth -takes {} \
        -detail {Width of the border around the insertion cursor.}
    option -insertofftime -takes {} \
        -detail {Milliseconds the insertion cursor is off during blinking.}
    option -insertontime -takes {} \
        -detail {Milliseconds the insertion cursor is on during blinking.}
    option -insertwidth -takes {} -detail {Width of the insertion cursor in screen units.}
    option -selectbackground -takes {} -detail {Background colour for selected text.}
    option -selectborderwidth -takes {} -detail {Width of the border around selected text.}
    option -selectforeground -takes {} -detail {Foreground colour for selected text.}
    option -xscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for communicating with horizontal scrollbars.}
    option -yscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for communicating with vertical scrollbars.}
    option -exportselection -takes {} \
        -detail {Whether the selection is exported to the X selection.}
    option -setgrid -takes {} \
        -detail {Whether this widget controls the resizing grid for its toplevel.}
    option -padx -takes {} -detail {Extra horizontal padding inside the text widget.}
    option -pady -takes {} -detail {Extra vertical padding inside the text widget.}
    option -undo -takes {} -detail {Whether the undo mechanism is active.}
    option -maxundo -takes {} \
        -detail {Maximum number of compound undo actions on the undo stack.}
    option -autoseparators -takes {} \
        -detail {Whether undo separators are inserted automatically.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the text widget.}
    option -takefocus -takes {} \
        -detail {Whether the text widget accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the widget does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the widget has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the widget.}
    option -blockcursor -takes boolean -role Boolean \
        -detail {Whether to draw the insertion cursor as a character-sized block.}
    option -endline -takes line \
        -detail {Line just after the last line exposed by this widget; empty uses the store's end.}
    option -inactiveselectbackground -takes color \
        -detail {Selection colour while unfocused; empty hides the unfocused selection.}
    option -insertunfocussed -takes cursorStyle \
        -detail {Unfocused insertion cursor style: none, hollow, or solid.}
    option -startline -takes line \
        -detail {First line from the underlying text store exposed by this widget.}
    option -tabstyle -takes style \
        -detail {Tab-stop interpretation: tabular or wordprocessor.}

    form Default {text pathName ?option value ...?}

    hover {
        summary {Create and manipulate a multi-line text widget.}
        synopsis {text pathName ?option value ...?}
        description {Displays one or more lines of text and allows the user to edit them. Supports embedded images and windows.}
        source {Tk man page text.n}
