command my {
    available {tcl 8.6-}
    traits {LANGUAGE_KEYWORD TCLOO_SELF_DISPATCH TCLOO_METHOD_CONTEXT}
    arity 1..

    return_type String
    allow_unknown_subcommands

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin my

    form Default {my methodName ?arg ...?}

    hover {
        summary {invoke any method, including non-exported ones, of the current object}
        synopsis {my methodName ?arg ...?}
        description {The my command is used within the body of a method, constructor, or destructor to invoke any method the current object supports, including ones that are not exported — unlike calling the object's own command directly (e.g. [self object] methodName), which only reaches exported methods. In Tcl 9.0+, my can also reach a declared private method of the object or class — a visibility tier stricter than plain non-export — when called from another method defined by that same object or class. Each object has its own my command, living in its instance namespace; a saved reference to it keeps invoking the correct object even if that object is later renamed. A common idiom is `namespace code {my Callback}`, which packages a call to a non-exported method as a command prefix usable from outside the object — for example as a variable-trace or event-handler callback.}
        source {Tcl my(n)}
        example {oo::class create Counter {
    method count {} {
        my variable total
        puts [incr total]
    }
}
set c [Counter new]
$c count                  ;# prints 1
$c count                  ;# prints 2
$c count                  ;# prints 3}
        returns {The result of the invoked method.}
    }

    subcommand variable {
        detail {Link each named object-instance variable into the current method's local scope; a bare `my variable` (no names) is a legal no-op. Each varName must be unqualified — no :: namespace separator.}
        synopsis {my variable ?varName ...?}
        available {tcl 8.6-}
        return_type String
        creates_scope_alias
        arg_role_resolver -native my::variable::arg_role_resolver
        arg_role_resolver_roles VarWrite
        side_effect Variable -writes
    }
}

command mymethod {
    available {tcl 8.6}
    traits {LANGUAGE_KEYWORD TCLOO_METHOD_CONTEXT TCLOO_REQUIRES_METHOD_FRAME}
    arity 1..
    required_package oo::util
    tcllib_package oo::util

    return_type List

    form Default {mymethod methodName ?arg ...?}

    hover {
        summary {build a command prefix that invokes a method of the current object}
        synopsis {mymethod methodName ?arg ...?}
        description {Used within the body of a method, constructor, or destructor to generate a script fragment (a proper list) that will invoke methodName on the current object — as reported by self — when it is later executed. Any additional arguments are supplied as leading arguments to that callback. mymethod is an alias of callback, named for compatibility with Tcllib's ooutil and snit packages. The generated prefix keeps working from outside any method (that is its purpose: file events, traces, after scripts), and it keeps naming the right object even if the object is renamed. methodName may be any exported or unexported method, but not a private one; if no such method exists when the callback fires, the object's unknown method handler is called.}
        source {Tcl callback(n)}
        example {oo::class create Echo {
    variable chan
    constructor {c} {
        set chan $c
        fileevent $chan readable [callback Readable]
    }
    method Readable {} {
        if {[gets $chan line] >= 0} {
            puts $chan $line
        }
    }
}}
        returns {A command prefix (a proper list) that invokes methodName on the current object.}
    }
}

