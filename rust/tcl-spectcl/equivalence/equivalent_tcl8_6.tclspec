command coroutine {
    available {tcl 8.6-}
    traits {LANGUAGE_KEYWORD BYTE_COMPILED NOT_PROC_FACTORY COROUTINE_PRIMITIVE}
    arity 2..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Name
    arg 1 -appends Unknown
    defines_command_at 0

    side_effect InterpState -writes
    side_effect Unknown

    runtime_backing shipped-builtin coroutine

    form Default {coroutine name command ?arg...?}

    hover {
        summary {Create a named coroutine and run it up to its first suspension or completion.}
        synopsis {coroutine name command ?arg...?}
        description {Creates a new command called name backed by a coroutine context, then immediately calls command ?arg...? inside it — command is resolved in the namespace coroutine itself was called from, but once running it starts in the global namespace with no caller stack frames above it (uplevel/upvar cannot reach past the coroutine's own frames). Inside the context, yield suspends execution and its value becomes the result of this coroutine call (or of whichever call resumed the coroutine); yieldto instead cedes control to another command, and the resuming call's arguments come back as a list. If command returns or raises an exception without ever yielding, name is deleted immediately and its result (or error) becomes the result of this call. name can also be removed early with `rename name {}`, which fires any pending variable-deletion traces inside the coroutine's frames; `info coroutine` reports the name of the currently running coroutine. From Tcl 9.0, a suspended coroutine's state can additionally be inspected with coroprobe or have a command queued for its next resumption with coroinject.}
        source {Tcl man page coroutine(n)}
        example {proc counter {} {
    set i 0
    while 1 {
        yield $i
        incr i
    }
}
coroutine next counter
puts [next]
puts [next]
rename next {}}
        returns {The value passed to the coroutine's first yield or yieldto call, or command's own result if it returns without ever yielding.}
    }
}

