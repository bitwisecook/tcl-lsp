    option -width -takes {} -detail {Desired width of the panedwindow in screen units.}
    option -height -takes {} -detail {Desired height of the panedwindow in screen units.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -background -takes {} -detail {Background colour of the panedwindow.}
    option -relief -takes relief -values-from button-relief -closed \
