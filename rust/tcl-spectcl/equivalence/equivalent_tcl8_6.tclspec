        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand with {
        arity 2..
        detail {Map all dictionary keys to variables, execute body, write back.}
        synopsis {dict with dictionaryVariable ?key ...? body}
        # TODO(spectcl): `body_execution` is set on the source spec. The DSL
        #   spells it `body_execution -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
        #   spells it `successful_handler -native
        #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
        #   -direct-provider
        #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
        #   but a pack may not author this field.
        mutator
        creates_scope_alias
        arg 0 -type Dict -shimmers
        arg_role_resolver -native dict::with::arg_role_resolver
        arg_role_resolver_roles {VarWrite VarRead Body}
        analyser_hook -native DictWith
    }

    subcommand info {
        arity 1
        detail {This returns information (intended for display to people) about the given dictionary though the format of this data is dependent on the implementation of the dictionary.}
        synopsis {dict info dictionaryValue}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        arg 0 -type Dict -shimmers
    }

    subcommand getd {
        arity 3..
        detail {Synonym for ``dict getdef`` — returns the value that the key path maps to in the dictionary value, or the default if the key is absent.}
        synopsis {dict getd dictionaryValue ?key ...? key default}
        available {tcl 9.0-}
        return_type String
        pure
        arg 0 -type Dict -shimmers
    }

    subcommand getdef {
        arity 3..
        detail {Returns the value that the key path maps to in the dictionary value, or the default if the key is absent.}
        synopsis {dict getdef dictionaryValue ?key ...? key default}
        available {tcl 9.0-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        arg 0 -type Dict -shimmers
    }

    subcommand getwithdefault {
        arity 3..
        detail {Returns the value that the key path maps to in the dictionary value, or the default if the key is absent. Alias for dict getdef.}
        synopsis {dict getwithdefault dictionaryValue ?key ...? key default}
        available {tcl 9.0-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        arg 0 -type Dict -shimmers
    }
}

