command tk::checkbutton {
    available {tcl 8.4-} {package Tk}
    traits TAINTS_VAR_WRITES
    arity 1..
    required_package Tk
    introduced_version 8.5
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class checkbutton -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a checkbutton option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change checkbutton options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method deselect {
            arity 0
            detail {Deselect the checkbutton and set its associated variable to -offvalue.}
            synopsis {pathName deselect}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method flash {
            arity 0
            detail {Flash the checkbutton using its active and normal colours.}
            synopsis {pathName flash}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method invoke {
            arity 0
            detail {Toggle the checkbutton and invoke its associated command.}
            synopsis {pathName invoke}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method select {
            arity 0
            detail {Select the checkbutton and set its associated variable to -onvalue.}
            synopsis {pathName select}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method toggle {
            arity 0
            detail {Toggle the checkbutton and update its associated variable.}
            synopsis {pathName toggle}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }
    }

    option -text -takes {} -detail {Text to display in the checkbutton.}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Name of a variable whose value will be used as the checkbutton text.}
    option -background -takes color -detail {Normal background colour of the checkbutton.}
    option -borderwidth -takes {screen units} \
        -detail {Width of the border around the checkbutton.}
    option -foreground -takes color -detail {Normal foreground colour of the checkbutton.}
    option -variable -takes {} -role VarWrite -also-role VarRead -variable-scope Global -taints-var-write \
        -detail {Name of the global variable linked to the checkbutton state.}
    option -onvalue -takes {} \
        -detail {Value stored in the variable when the checkbutton is selected.}
    option -offvalue -takes {} \
        -detail {Value stored in the variable when the checkbutton is deselected.}
    option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
        -detail {Tcl command to invoke when the checkbutton is toggled.}
    option -state -takes {} -detail {State of the checkbutton: normal, active, or disabled.}
    option -indicatoron -takes {} -detail {Whether to display the selection indicator.}
    option -selectimage -takes {} \
        -detail {Image to display when the checkbutton is selected.}
    option -selectcolor -takes {} \
        -detail {Colour of the indicator when the checkbutton is selected.}
    option -image -takes {} -detail {Image to display in the checkbutton.}
    option -bitmap -takes {} -detail {Bitmap to display in the checkbutton.}
    option -compound -takes {} \
        -detail {Whether to display both image and text: none, bottom, top, left, right, or center.}
    option -width -takes {} \
        -detail {Desired width of the checkbutton in characters (text) or pixels (image).}
    option -height -takes {} \
        -detail {Desired height of the checkbutton in lines (text) or pixels (image).}
    option -anchor -takes anchor -values-from button-anchor -closed \
        -detail {How information is positioned: n, ne, e, se, s, sw, w, nw, or center.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of multi-line text: left, center, or right.}
    option -wraplength -takes {} \
        -detail {Maximum line length for word wrapping, in screen units.}
    option -underline -takes {} \
        -detail {Index of character to underline for keyboard traversal (0-based).}
    option -font -takes {} -detail {Font to use for the checkbutton text.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -activebackground -takes {} \
        -detail {Background colour when the checkbutton is active (mouse over).}
    option -activeforeground -takes {} \
        -detail {Foreground colour when the checkbutton is active.}
    option -disabledforeground -takes {} \
        -detail {Foreground colour when the checkbutton is disabled.}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -padx -takes {} -detail {Extra horizontal padding inside the checkbutton.}
    option -pady -takes {} -detail {Extra vertical padding inside the checkbutton.}
    option -cursor -takes {} \
        -detail {Cursor to display when the mouse is over the checkbutton.}
    option -takefocus -takes {} \
        -detail {Whether the checkbutton accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the checkbutton does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the checkbutton has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the checkbutton.}
    option -overrelief -takes {} \
        -detail {Relief to use when the mouse cursor is over the checkbutton.}
    option -offrelief -takes relief \
        -detail {Relief while deselected when -indicatoron is false; defaults to raised.}
    option -tristateimage -takes image \
        -detail {Image shown in tri-state mode when -image is configured.}
    option -tristatevalue -takes value \
        -detail {Variable value that selects tri-state mode; defaults to the empty string.}

    form Default {checkbutton pathName ?option value ...?}

    hover {
        summary {Create and manipulate a checkbutton widget.}
        synopsis {checkbutton pathName ?option value ...?}
        description {Displays a textual string, bitmap, or image with a selection indicator that toggles between on and off states.}
        source {Tk man page checkbutton.n}
    }

    subcommand cget {
        arity 1
        detail {Return the current value of a checkbutton option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change checkbutton options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand deselect {
        arity 0
        detail {Deselect the checkbutton and set its associated variable to -offvalue.}
        synopsis {pathName deselect}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand flash {
        arity 0
        detail {Flash the checkbutton using its active and normal colours.}
        synopsis {pathName flash}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand invoke {
        arity 0
        detail {Toggle the checkbutton and invoke its associated command.}
        synopsis {pathName invoke}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand select {
        arity 0
        detail {Select the checkbutton and set its associated variable to -onvalue.}
        synopsis {pathName select}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand toggle {
        arity 0
        detail {Toggle the checkbutton and update its associated variable.}
        synopsis {pathName toggle}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }
}

command tk::entry {
    available {tcl 8.4-} {package Tk}
    traits TAINTS_VAR_WRITES
    arity 1..
    required_package Tk
    introduced_version 8.5
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class entry -method-prefix-matching Enabled {
        method bbox {
            arity 1
            detail {Return the bounding box of the character at the given index.}
            synopsis {pathName bbox index}
            return_type List
            pure
            side_effect InterpState -reads
        }

        method cget {
            arity 1
            detail {Return the current value of an entry option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change entry options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method delete {
            arity 1..2
            detail {Delete characters from first through last (or just the character at first).}
            synopsis {pathName delete first ?last?}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method get {
            arity 0
            detail {Return the entry's current string contents.}
            synopsis {pathName get}
            traits TAINT_SOURCE
            return_type String
            pure
            side_effect InterpState -reads
        }

        method icursor {
            arity 1
            detail {Move the insertion cursor to just before the character at the given index.}
            synopsis {pathName icursor index}
            return_type String
            mutator
            side_effect InterpState -reads -writes
        }

        method index {
            arity 1
            detail {Return the numerical index corresponding to the given index.}
            synopsis {pathName index index}
            return_type Int
            pure
            side_effect InterpState -reads
        }

        method insert {
            arity 2
            detail {Insert the string just before the character at the given index.}
            synopsis {pathName insert index string}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method scan {
            arity 2
            detail {Implement fast scanning/scrolling; option is mark or dragto.}
            synopsis {pathName scan option arg}
            mutator
            side_effect InterpState -reads -writes
        }

        method selection {
            arity 1..
            detail {Manipulate the selection; option is adjust, clear, from, present, range, or to.}
            synopsis {pathName selection option ?arg ...?}
            return_type String
            mutator

            refine present {
                arity 1
                selector present
                traits PURE
                mutator no
                side_effect InterpState -reads
            }
            side_effect InterpState -reads -writes
        }

        method validate {
            arity 0
            detail {Force revalidation of the entry using its -validatecommand.}
            synopsis {pathName validate}
            traits EVALUATES_CODE
            return_type Boolean
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }

        method xview {
            detail {Query or change the horizontal position of the text visible in the entry.}
            synopsis {pathName xview ?args?}
            return_type List
            mutator

            refine query {
                arity 0
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine move {
                arity 1..
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
            side_effect InterpState -reads -writes
        }
    }

    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global -taints-var-write \
        -detail {Name of a variable linked to the entry's contents.}
    option -background -takes color -detail {Normal background colour of the entry.}
    option -borderwidth -takes {screen units} \
        -detail {Width of the border around the entry.}
    option -foreground -takes color -detail {Normal foreground colour of the entry.}
    option -locale -takes {locale name} -introduced 9.1 \
        -detail {Locale used to determine word and character boundaries (Tk 9.1+).}
    option -width -takes {} -detail {Desired width of the entry in average-size characters.}
    option -state -takes {} -detail {State of the entry: normal, disabled, or readonly.}
    option -show -takes {} \
        -detail {Character to display instead of actual contents (e.g. '*' for passwords).}
    option -font -takes {} -detail {Font to use for text in the entry.}
    option -bg -takes {} -detail {Shorthand for -background.}
    option -fg -takes {} -detail {Shorthand for -foreground.}
    option -placeholder -takes text -introduced 8.7 \
        -detail {Help text shown when the entry is empty (Tk 8.7+).}
    option -placeholderforeground -takes color -introduced 8.7 \
        -detail {Foreground colour of the placeholder text (Tk 8.7+).}
    option -relief -takes relief -values-from button-relief -closed \
        -detail {3-D effect: flat, groove, raised, ridge, solid, or sunken.}
    option -justify -takes justify -values-from button-justify -closed \
        -detail {Justification of text within the entry: left, center, or right.}
    option -insertbackground -takes {} -detail {Colour of the insertion cursor.}
    option -insertborderwidth -takes {} \
        -detail {Width of the border around the insertion cursor.}
    option -insertofftime -takes {} \
        -detail {Milliseconds the insertion cursor is off during blinking.}
    option -insertontime -takes {} \
        -detail {Milliseconds the insertion cursor is on during blinking.}
    option -insertwidth -takes {} -detail {Width of the insertion cursor in screen units.}
    option -selectbackground -takes {} -detail {Background colour for selected text.}
    option -selectborderwidth -takes {} -detail {Width of the border around selected text.}
    option -selectforeground -takes {} -detail {Foreground colour for selected text.}
    option -xscrollcommand -takes prefix -role CommandPrefix -script-timing Deferred -appends {Exactly 2} \
        -detail {Command prefix for communicating with horizontal scrollbars.}
    option -exportselection -takes {} \
        -detail {Whether the selection is exported to the X selection.}
    option -readonlybackground -takes {} \
        -detail {Background colour when the entry is in readonly state.}
    option -validate -takes {} \
        -detail {Validation mode: none, focus, focusin, focusout, key, or all.}
    option -validatecommand -takes {} -role Body -body-kind Structural -script-timing Deferred -callback-taint-inputs {%P %s %S} \
        -detail {Script to evaluate when validation is triggered.}
    option -invalidcommand -takes {} -role Body -body-kind Structural -script-timing Deferred -callback-taint-inputs {%P %s %S} \
        -detail {Script to evaluate when validation fails.}
    option -cursor -takes {} -detail {Cursor to display when the mouse is over the entry.}
    option -takefocus -takes {} \
        -detail {Whether the entry accepts focus during keyboard traversal.}
    option -highlightbackground -takes {} \
        -detail {Colour of the highlight region when the entry does not have focus.}
    option -highlightcolor -takes {} \
        -detail {Colour of the highlight region when the entry has focus.}
    option -highlightthickness -takes {} \
        -detail {Width of the highlight rectangle drawn around the entry.}
    option -disabledbackground -takes color \
        -detail {Background colour while disabled; empty uses the normal background.}
    option -disabledforeground -takes color \
        -detail {Foreground colour while disabled; empty uses the normal foreground.}

    form Default {entry pathName ?option value ...?}

    hover {
        summary {Create and manipulate a single-line text entry widget.}
        synopsis {entry pathName ?option value ...?}
        description {Displays a one-line text string and allows the user to edit it using standard editing characters.}
        source {Tk man page entry.n}
    }

    subcommand bbox {
        arity 1
        detail {Return the bounding box of the character at the given index.}
        synopsis {pathName bbox index}
        return_type List
        pure
        side_effect InterpState -reads
    }

    subcommand cget {
        arity 1
        detail {Return the current value of an entry option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change entry options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand delete {
        arity 1..2
        detail {Delete characters from first through last (or just the character at first).}
        synopsis {pathName delete first ?last?}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand get {
        arity 0
        detail {Return the entry's current string contents.}
        synopsis {pathName get}
        traits TAINT_SOURCE
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand icursor {
        arity 1
        detail {Move the insertion cursor to just before the character at the given index.}
        synopsis {pathName icursor index}
        return_type String
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand index {
        arity 1
        detail {Return the numerical index corresponding to the given index.}
        synopsis {pathName index index}
        return_type Int
        pure
        side_effect InterpState -reads
    }

    subcommand insert {
        arity 2
        detail {Insert the string just before the character at the given index.}
        synopsis {pathName insert index string}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand scan {
        arity 2
        detail {Implement fast scanning/scrolling; option is mark or dragto.}
        synopsis {pathName scan option arg}
        mutator
        side_effect InterpState -reads -writes
    }

    subcommand selection {
        arity 1..
        detail {Manipulate the selection; option is adjust, clear, from, present, range, or to.}
        synopsis {pathName selection option ?arg ...?}
        return_type String
        mutator

        refine present {
            arity 1
            selector present
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }

    subcommand validate {
        arity 0
        detail {Force revalidation of the entry using its -validatecommand.}
        synopsis {pathName validate}
        traits EVALUATES_CODE
        return_type Boolean
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }

    subcommand xview {
        detail {Query or change the horizontal position of the text visible in the entry.}
        synopsis {pathName xview ?args?}
        return_type List
        mutator

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine move {
            arity 1..
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
        side_effect InterpState -reads -writes
    }
}

