command trace {
    available {tcl 8.4-} {f5-irules}
    traits {CREATES_BARRIER CREATES_DYNAMIC_BARRIER BYTE_COMPILED}
    arity 1..

    script_lookup_scope TriggerFrame
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.

    side_effect InterpState -reads -writes

    runtime_backing shipped-builtin trace

    form Default {trace option ?arg arg ...?}

    hover {
        summary {Monitor variable accesses, command renames/deletions, and command executions by invoking a callback.}
        synopsis {trace option ?arg arg ...?}
        description {Dispatches on option to add, remove, info, or (deprecated, removed in Tcl 9.0) variable/vdelete/vinfo. trace add type name ops commandPrefix arranges for commandPrefix to be invoked, with operation-specific arguments appended, whenever the variable, command, or command execution named by name undergoes one of the operations in ops; for type command or execution, name must already exist or trace add throws an error, while for type variable a nonexistent name is instead silently created without a value. trace remove undoes a matching trace; trace info returns the traces currently set. type is variable, command, or execution (any unique abbreviation accepted). For a variable trace, ops is one or more of array/read/write/unset, and the callback receives commandPrefix name1 name2 op — name1 is the accessed variable's name and name2 the array index when the trace was set on an array or an array element (present even when name1 itself looks like a scalar, e.g. via an upvar alias to a single element); a read/write callback may itself rewrite the variable to override the traced operation's result, and returning an error from the callback aborts the read/write/access that triggered it; while a read or write callback runs, that same trace is temporarily disabled (so it cannot re-trigger itself), but an unset callback is the one exception — traces stay enabled during unset, so a handler that installs a new trace and touches the variable will see it fire. When several traces are set on the same variable they fire most-recently-added first, stopping at the first one that raises an error, and a trace on the array as a whole fires before one on a single element of it. For a command trace, ops is rename and/or delete, with the callback receiving commandPrefix oldName newName op; deletion cannot be prevented from inside the trace, since Tcl always removes the command once the callback returns, and a rename or delete performed from inside the callback does not re-trigger further traces of that same type. A command trace also never fires when its target disappears because the interpreter itself is being torn down, since there is then no interpreter left to run the callback in. For an execution trace, ops is one or more of enter/leave/enterstep/leavestep — enter/leave fire immediately before/after the traced command itself runs, enterstep/leavestep fire before/after every command nested inside it (meaningful only when name is a procedure) — with the callback receiving commandPrefix command-string op for enter/enterstep or commandPrefix command-string code result op for leave/leavestep; deleting the traced command from inside an enter/enterstep callback stops the pending execution, and while an execution callback runs, that same trace is likewise temporarily disabled. Multiple execution traces on the same name fire in reverse creation order for enter/enterstep and original creation order for leave/leavestep. trace add/remove/variable/vdelete return an empty string; trace info/vinfo return a list of the matching traces (an empty list if none are set), each element itself a two-element {opList commandPrefix} list.}
        source {Tcl trace(n)}
        example {# Log every write to a configuration variable, and read the new value
# back out via the name(s) the callback receives (not a closure over
# the original variable name, since upvar can alias it under another).
proc logWrite {name1 name2 op} {
    upvar #0 $name1 var
    puts "$name1 -> $var"
}
trace add variable ::config(port) write logWrite

# Trace every command entered while `compute` runs.
proc traceStep {cmdString op} {
    puts "step: $cmdString"
}
trace add execution compute enterstep traceStep

# Remove a trace again with the exact same arguments used to add it.
trace remove variable ::config(port) write logWrite}
        returns {Depends on the subcommand: an empty string (add, remove, and the deprecated variable/vdelete), or a list of the matching traces — one element per trace, each itself a two-element {opList commandPrefix} list (info, and the deprecated vinfo).}
    }

    subcommand add {
        arity 4
        detail {Arrange for commandPrefix to be invoked, with operation-specific arguments appended, whenever the variable/command/execution named by name undergoes one of the operations in ops. For type command or execution, name must already exist or this throws an error; for type variable, a nonexistent name is instead silently created without a value (visible to a namespace which query but not to info exists, until something writes it). Present, with this exact 4-argument shape, in every Tcl release from 8.4 through 9.1.}
        synopsis {trace add type name ops commandPrefix}
        traits {TARGETS_VARIABLE_BY_NAME REFLECTS_COMMAND_NAMES ESTABLISHES_VARIABLE_TRACE DEFERS_BODY}
        available {tcl 8.4-}
        return_type String
        variable_receivers {{1 trace-subject}}
        mutator
        arg_values_accept_prefix
        arg 0 -values-from trace-add-arg0 -closed
        arg 2 -values-from trace-add-arg2
        arg_role_layout_resolver -native trace::add::arg_role_layout_resolver
        arg_role_resolver_roles {VarWrite CommandName}
        command_prefix_resolver -native trace::add::command_prefix_resolver
        script_timing_resolver -native trace::add::script_timing_resolver
        literal_argument_validator -native trace::add::literal_argument_validator
        side_effect InterpState -writes
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand info {
        arity 2
        detail {Return a list of the traces currently set on the command or variable name, one element per trace, each itself a two-element {opList commandPrefix} list, or an empty list if none are set. For type command or execution, a nonexistent name throws an error; for type variable, a nonexistent name likewise just yields an empty list.}
        synopsis {trace info type name}
        traits {TARGETS_VARIABLE_BY_NAME REFLECTS_COMMAND_NAMES}
        available {tcl 8.4-}
        return_type List
        variable_receivers {{1 trace-subject}}
        pure
        arg_values_accept_prefix
        arg 0 -values-from trace-add-arg0 -closed
        arg_role_layout_resolver -native trace::info::arg_role_layout_resolver
        arg_role_resolver_roles {VarRead CommandName}
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
        side_effect InterpState -reads
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand remove {
        arity 4
        detail {Remove a previously added trace matching type, name, ops, and commandPrefix exactly. For a variable name that does not exist, or a variable/command/execution trace that does not match, this is silently a no-op; for a nonexistent command or execution name it instead throws an error.}
        synopsis {trace remove type name opList commandPrefix}
        traits {TARGETS_VARIABLE_BY_NAME REFLECTS_COMMAND_NAMES ESTABLISHES_VARIABLE_TRACE}
        available {tcl 8.4-}
        return_type String
        variable_receivers {{1 trace-subject}}
        mutator
        arg_values_accept_prefix
        arg 0 -values-from trace-add-arg0 -closed
        arg 2 -values-from trace-add-arg2
        arg_role_layout_resolver -native trace::remove::arg_role_layout_resolver
        arg_role_resolver_roles {VarWrite CommandName}
        command_prefix_resolver -native trace::remove::command_prefix_resolver
        script_timing_resolver -native trace::remove::script_timing_resolver
        literal_argument_validator -native trace::remove::literal_argument_validator
        side_effect InterpState -reads -writes
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand variable {
        arity 3
        detail {Arrange for command to be executed whenever variable name is accessed, using the legacy single-letter ops encoding (a/r/w/u, concatenated with no separator, e.g. rwu). Equivalent to trace add variable name ops command. Deprecated throughout 8.4-8.6; removed in Tcl 9.0 (absent from the 9.0/9.1 manpages' synopsis and body alike).}
        synopsis {trace variable name ops command}
        traits {TARGETS_VARIABLE_BY_NAME ESTABLISHES_VARIABLE_TRACE DEFERS_BODY}
        available {tcl 8.4-9.0} {f5-irules}
        deprecated_version 8.4
        retired_version 9.0
        return_type String
        variable_receivers {{0 trace-subject}}
        mutator
        arg 1 -values-from trace-variable-arg1
        arg_role_count_resolver -native trace::variable::arg_role_count_resolver
        arg_role_resolver_roles VarWrite
        command_prefix_resolver -native trace::variable::command_prefix_resolver
        script_timing_resolver -native trace::variable::script_timing_resolver
        literal_argument_validator -native trace::variable::literal_argument_validator
        side_effect InterpState -writes
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand vdelete {
        arity 3
        detail {Delete a variable trace added with trace variable or trace add variable, using the legacy single-letter ops encoding (a/r/w/u). Equivalent to trace remove variable name ops command. Deprecated throughout 8.4-8.6; removed in Tcl 9.0.}
        synopsis {trace vdelete name ops command}
        traits {TARGETS_VARIABLE_BY_NAME ESTABLISHES_VARIABLE_TRACE}
        available {tcl 8.4-9.0} {f5-irules}
        deprecated_version 8.4
        retired_version 9.0
        return_type String
        variable_receivers {{0 trace-subject}}
        mutator
        arg 1 -values-from trace-variable-arg1
        arg_role_count_resolver -native trace::vdelete::arg_role_count_resolver
        arg_role_resolver_roles VarWrite
        command_prefix_resolver -native trace::vdelete::command_prefix_resolver
        script_timing_resolver -native trace::vdelete::script_timing_resolver
        literal_argument_validator -native trace::vdelete::literal_argument_validator
        side_effect InterpState -reads -writes
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand vinfo {
        arity 1
        detail {Return trace information for the given variable: one element per trace, each a two-element {ops command} list. Unlike trace info variable, whose first element is a word list, ops here is the legacy single-letter string (a/r/w/u), rendered in the fixed order r, w, u, a — so a trace on reads and writes reports rw. Covers traces added by either spelling. Deprecated throughout 8.4-8.6; removed in Tcl 9.0.}
        synopsis {trace vinfo name}
        traits TARGETS_VARIABLE_BY_NAME
        available {tcl 8.4-9.0} {f5-irules}
        deprecated_version 8.4
        retired_version 9.0
        return_type List
        variable_receivers {{0 trace-subject}}
        pure
        arg 0 -role VarRead
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
        side_effect InterpState -reads
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }
}

command try {
    available {tcl 8.6-}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD NEVER_INLINE_BODY BYTE_COMPILED NOT_PROC_FACTORY BRANCH_SELECTED_BODY}
    arity 1..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 1 -values-from try-arg1 -closed

    clause_grammar {
        head Body -timing protected
        repeated on {Pattern LoopVarList Body} -pattern completion-code
        repeated trap {Pattern LoopVarList Body} -pattern error-code-prefix
        tail finally Body -timing always
        fallthrough_body -
    }

    arg_role_resolver_roles {Body Keyword}
    lowering_hook -native Try
    inline_codegen_hook -native Try

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin try

    form Default {try body ?handler...? ?finally script?}

    hover {
        summary {Trap and process errors and exceptions}
        synopsis {try body ?handler...? ?finally script?}
        description {Evaluates body, then dispatches to at most one matching handler clause, tried in the order written, based on how body completed. Each clause is either "on code variableList script" — matching an exact completion code, where code is ok, error, return, break, or continue, or the equivalent integer 0 through 4 — or "trap pattern variableList script" — matching only when body raised an error whose -errorcode option has pattern as a leading prefix, compared element-wise with inter-word spacing normalised in both (not as a raw string prefix). An empty pattern (trap {}) therefore matches any error, so on error and trap {} are equivalent, and an earlier on error masks every later trap. A handler's variableList holds up to two variable names: when the first is present and non-empty it receives body's own result (its error message, on an error), and when the second is present and non-empty it receives the options dictionary as of that same moment. A handler script that is exactly "-" falls through to the next handler's script, just like a switch body of "-" — the last handler may not itself be "-". Once a handler has run, or none matched, an optional trailing finally script always runs — even when body or the handler raised an error, and irrespective of which handler, if any, matched. A finally that completes normally discards its own result and lets the handler's (or body's, when none matched) result and completion code propagate outward unchanged, so a plain return inside body still returns from the enclosing procedure once finally has run; a finally that does not complete normally replaces that outcome with its own instead. Whenever body, a handler, or finally raises a new exception while superseding an earlier one, the superseded exception's options dictionary is recorded on the new one under its -during key. try does not exist before Tcl 8.6, where it was added alongside throw.}
        source {Tcl try(n)}
        example {# Guarantee cleanup regardless of outcome
set f [open /some/file/name a]
try {
    puts $f "some message"
} finally {
    close $f
}

# Differentiate error causes by their -errorcode
try {
    set f [open /some/file/name r]
} trap {POSIX EISDIR} {} {
    puts "it's a directory"
} trap {POSIX ENOENT} {} {
    puts "it doesn't exist"
}

# finally still runs even though the body returns
proc readFile {filename} {
    set f [open $filename r]
    try {
        return [read $f]
    } finally {
        close $f
    }
}}
        returns {The result and completion code of whichever handler matched, or of body itself when no handler matched, once finally (if present) has completed normally; a finally that does not itself complete with code ok replaces this outcome instead.}
    }
}

command ttk::button {
    available {tcl 8.4-} {package Tk}
    arity 1..
    required_package Tk
    introduced_version 8.5
    warn_missing_import no

    creates_instance_at 0

    side_effect InterpState -writes

    object_class ttk::button -method-prefix-matching Enabled {
        method cget {
            arity 1
            detail {Return the current value of a widget option.}
            synopsis {pathName cget option}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method configure {
            detail {Query or change widget options.}
            synopsis {pathName configure ?option? ?value option value ...?}
            return_type String

            refine query {
                arity ..1
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 2.. -step 2
                traits CONFIGURES_INSTANCE_OPTIONS
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method identify {
            arity 3
            detail {Identify a themed component at the given coordinates.}
            synopsis {pathName identify element x y}
            return_type String
            pure
            side_effect InterpState -reads
        }

        method instate {
            arity 1..2
            detail {Test widget state and optionally run a script.}
            synopsis {pathName instate statespec ?script?}
            traits EVALUATES_CODE
            arg 1 -role Body
            side_effect InterpState -reads
            side_effect Unknown -reads -writes
        }

        method state {
            arity ..1
            detail {Query or change widget state.}
            synopsis {pathName state ?stateSpec?}
            return_type List

            refine query {
                arity 0
                traits PURE
                mutator no
                side_effect InterpState -reads
            }

            refine set {
                arity 1
                traits {}
                mutator yes
                side_effect InterpState -reads -writes
            }
        }

        method style {
            arity 0
            detail {Return the widget's current style.}
            synopsis {pathName style}
            introduced_version 8.7
            return_type String
            pure
            side_effect InterpState -reads
        }

        method invoke {
            arity 0
            detail {Invoke the script associated with the button.}
            synopsis {pathName invoke}
            traits EVALUATES_CODE
            return_type String
            mutator
            side_effect InterpState -reads -writes
            side_effect Unknown -reads -writes
        }
    }

    option -text -takes string -detail {Text to display in the button.}
    option -textvariable -takes {} -role VarWrite -also-role VarRead -variable-scope Global \
        -detail {Variable whose value is used as the button text.}
    option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
        -detail {Script to evaluate when the button is invoked.}
    option -image -takes imageName -detail {Image to display in the button.}
    option -compound -takes compoundType -detail {How to display image relative to text.}
    option -width -takes width -detail {Desired width of the button.}
    option -state -takes stateSpec -detail {Widget state (normal or disabled).}
    option -style -takes style -detail {Style to use for the widget.}
    option -class -takes className -detail {Widget class name for option-database lookups.}
    option -cursor -takes cursor \
        -detail {Cursor to display when the pointer is over the widget.}
    option -takefocus -takes focusSpec \
        -detail {Whether the widget accepts focus during keyboard traversal.}
    option -padding -takes padSpec -detail {Internal padding around the widget content.}
    option -underline -takes index \
        -detail {Index of the character to underline for mnemonic activation.}
    option -default -takes defaultState \
        -detail {Default button state (normal, active, or disabled).}

    form Default {ttk::button pathName ?options?}

    hover {
        summary {Create and manipulate a themed button widget.}
        synopsis {ttk::button pathName ?options?}
        source {Tk man page ttk_button.n}
    }

    subcommand cget {
        arity 1
        detail {Return the current value of a widget option.}
        synopsis {pathName cget option}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand configure {
        detail {Query or change widget options.}
        synopsis {pathName configure ?option? ?value option value ...?}
        return_type String

        refine query {
            arity ..1
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 2.. -step 2
            traits CONFIGURES_INSTANCE_OPTIONS
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand identify {
        arity 3
        detail {Identify a themed component at the given coordinates.}
        synopsis {pathName identify element x y}
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand instate {
        arity 1..2
        detail {Test widget state and optionally run a script.}
        synopsis {pathName instate statespec ?script?}
        traits EVALUATES_CODE
        arg 1 -role Body
        side_effect InterpState -reads
        side_effect Unknown -reads -writes
    }

    subcommand state {
        arity ..1
        detail {Query or change widget state.}
        synopsis {pathName state ?stateSpec?}
        return_type List

        refine query {
            arity 0
            traits PURE
            mutator no
            side_effect InterpState -reads
        }

        refine set {
            arity 1
            traits {}
            mutator yes
            side_effect InterpState -reads -writes
        }
    }

    subcommand style {
        arity 0
        detail {Return the widget's current style.}
        synopsis {pathName style}
        introduced_version 8.7
        return_type String
        pure
        side_effect InterpState -reads
    }

    subcommand invoke {
        arity 0
        detail {Invoke the script associated with the button.}
        synopsis {pathName invoke}
        traits EVALUATES_CODE
        return_type String
        mutator
        side_effect InterpState -reads -writes
        side_effect Unknown -reads -writes
    }
}

