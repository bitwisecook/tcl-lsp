        arity 1..
        detail {Add one or more child windows to the panedwindow.}
        synopsis {pathName add window ?window ...? ?option value ...?}
    }

    subcommand forget { arity 1 ; detail {Remove the specified pane from the panedwindow.} ; synopsis {pathName forget window} }
    subcommand identify { arity 2 ; detail {Identify the panedwindow component at the given coordinates.} ; synopsis {pathName identify x y} }

    subcommand panecget {
        arity 2
        detail {Return the value of a configuration option for a pane.}
        synopsis {pathName panecget window option}
    }

    subcommand paneconfigure {
        arity 1..
        detail {Query or modify configuration options of a pane.}
        synopsis {pathName paneconfigure window ?option? ?value option value ...?}
    }

    subcommand panes { arity 0 ; detail {Return a list of all panes in the panedwindow.} ; synopsis {pathName panes} }

    subcommand proxy {
        detail {Query or manipulate the sash-drag proxy.}
        synopsis {pathName proxy ?args?}
        mutator

        refine coord {
            arity 1
            selector coord
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }

    subcommand sash {
        arity 1..
        detail {Query or adjust sash positions.}
        synopsis {pathName sash option ?arg ...?}
        mutator

        refine coord {
            arity 2
            selector coord
            traits PURE
            mutator no
            side_effect InterpState -reads
        }
        side_effect InterpState -reads -writes
    }
