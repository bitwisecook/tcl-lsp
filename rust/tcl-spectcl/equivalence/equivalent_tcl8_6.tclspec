command tell {
    available {tcl 8.4-}
    traits BYTE_COMPILED
    arity 1

    return_type Int
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Channel

    side_effect FileIo -reads

    runtime_backing shipped-builtin tell

    form Default {tell channelId}

    hover {
        summary {Return the current access position for an open channel.}
        synopsis {tell channelId}
        description {Returns an integer string giving the current access position in channelId, as a byte offset — not a character offset, unlike read — that can be passed to seek to move the channel back to that position. The value is -1 for a channel whose underlying file or device does not support seeking, such as most pipes and sockets; unlike seek, which raises an error when asked to reposition a non-seekable channel, tell simply reports the sentinel -1 instead. channelId must already be open: a Tcl standard channel (stdin, stdout, stderr), the result of open or socket, or a channel created by a Tcl extension.

Tcl 8.5 introduced chan tell, an equivalent command reached through the chan ensemble; from Tcl 9.0 the tell manual page documents itself purely as an alias for chan tell ("has been superceded by the chan tell command which supports the same syntax and options"), though tell keeps working exactly as described above in every version through 9.1.}
        source {Tcl tell(n)}
        example {set f [open data.log r]
set offset [tell $f]
if {[gets $f line] >= 0 && [string match "ERROR:*" $line]} {
    puts "found: $line"
} else {
    # Not a match -- rewind so the next reader sees this line again
    seek $f $offset
}
close $f

# A command pipeline is not seekable
set p [open |[list cat somefile] r]
puts [tell $p]
close $p}
        returns {An integer string: the channel's current access position in bytes, or -1 for a channel that does not support seeking.}
    }
}

