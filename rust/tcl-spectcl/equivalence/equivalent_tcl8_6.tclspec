command interp {
    available {tcl 8.4-}
    traits {LANGUAGE_KEYWORD BYTE_COMPILED NOT_PROC_FACTORY DYNAMIC_EVAL_BODY REFLECTS_COMMAND_NAMES}
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect InterpState -reads -writes

    taint_interp_eval_subcommands {eval invokehidden}

    runtime_backing shipped-builtin interp

    form Default {interp subcommand ?arg arg ...?}

    hover {
        summary {Create and manipulate Tcl interpreters.}
        synopsis {interp subcommand ?arg arg ...?}
        description {A child interpreter has its own namespace for commands, procedures, and variables, and connects back to its creator only through aliases (a command in the child that invokes a command in its parent or a sibling), shared environment variables, and resource-limit callbacks. `interp create -safe` creates a safe interpreter: dangerous commands such as exec, open, source, and socket are hidden rather than removed, so only a trusted ancestor can still reach them, via `interp invokehidden`. Tcl 8.6 added the preferred parent/child spelling (`interp children`) alongside the older `interp slaves`; Tcl 9.0 documents only `children`, but still accepts the legacy `slaves` compatibility spelling.}
        source {Tcl interp(n)}
        example {set child [interp create -safe]
interp alias $child log {} puts
interp eval $child {log "hello from the child"}
interp delete $child}
        returns {Varies by subcommand: a boolean for exists/issafe, a list for aliases/hidden/children (or slaves), the new interpreter's name for create, or the evaluated script's result for eval; most state-changing subcommands (delete, hide, expose, marktrusted, share, transfer) return an empty string.}
    }

    subcommand alias {
        arity 2..
        detail {Manage command aliases.}
        synopsis {interp alias path cmd}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
        #   spells it `successful_handler -native
        #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
        #   -direct-provider
        #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
        #   but a pack may not author this field.
        command_prefix_resolver -native interp::alias::command_prefix_resolver
        script_timing_resolver -native interp::alias::script_timing_resolver
        analyser_hook -native InterpAlias
        side_effect InterpState -reads
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand aliases {
        arity ..1
        detail {List aliases.}
        synopsis {interp aliases ?path?}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }

    subcommand bgerror {
        arity 1..2
        detail {Get or set background error handler.}
        synopsis {interp bgerror path ?cmdPrefix?}
        available {tcl 8.5-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        command_prefix_resolver -native interp::bgerror::command_prefix_resolver
        script_timing_resolver -native interp::bgerror::script_timing_resolver
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand cancel {
        arity ..2
        detail {Cancel a script evaluation.}
        synopsis {interp cancel ?-unwind? ?--? ?path? ?result?}
        available {tcl 8.6-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.

        option -unwind \
            -detail {Unwind the evaluation stack without regard to any intervening catch, rather than stopping at the first enclosing one.}
        option -- \
            -detail {Marks the end of switches; needed when path itself looks like a switch (e.g. -safe).}
    }

    subcommand create {
        arity ..1 -positionals
        detail {Create a child interpreter.}
        synopsis {interp create ?-safe? ?--? ?name?}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        defines_command_at 0
        analyser_hook -native InterpCreate
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.

        option -safe
        option --
    }

    subcommand debug {
        arity 1..3
        detail {Get or set debug mode.}
        synopsis {interp debug path ?-frame ?bool??}
        available {tcl 8.5-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.

        option -frame -takes boolean -role Boolean \
            -detail {Enable exact per-command file/line tracking for `info frame` in the target interpreter (slower execution). Given with no value, only reports the current setting. Once turned on, cannot be turned back off.}
    }

    subcommand delete {
        detail {Delete interpreters.}
        synopsis {interp delete ?path ...?}
        traits FIRE_AND_FORGET_TEARDOWN
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        destructive
        analyser_hook -native InterpDelete
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand eval {
        arity 2..
        detail {Evaluate script in another interpreter.}
        synopsis {interp eval path arg ?arg ...?}
        traits {EVALUATES_CODE SCRIPT_CONCATENATES_ARGS}
        return_type String
        # TODO(spectcl): `body_interpreter` is set on the source spec. The DSL
        #   spells it `body_interpreter Current|{Argument INDEX}`, but the
        #   loader has no reader for that property word yet.
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg 1 -role Body
        analyser_hook -native InterpEval
    }

    subcommand exists {
        arity ..1
        detail {Check if interpreter exists.}
        synopsis {interp exists ?path?}
        return_type Boolean
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }

    subcommand expose {
        arity 2..3
        detail {Expose a hidden command.}
        synopsis {interp expose path hiddenCmdName ?exposedCmdName?}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        analyser_hook -native InterpExpose
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand hidden {
        arity ..1
        detail {List hidden commands.}
        synopsis {interp hidden ?path?}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }

    subcommand hide {
        arity 2..3
        detail {Hide a command.}
        synopsis {interp hide path exposedCmdName ?hiddenCmdName?}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        analyser_hook -native InterpHide
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand invokehidden {
        arity 2..
        detail {Invoke a hidden command.}
        synopsis {interp invokehidden path ?-option ...? hiddenCmdName ?arg ...?}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        option_prefix_words 1

        option -global \
            -detail {Invoke the hidden command at the global level in the target interpreter, instead of the current call frame.}
        option -namespace -takes ns -role Name -available {tcl 8.5-} \
            -detail {Namespace in which to invoke the hidden command. Ignored if -global is also given.}
        option -- -available {tcl 8.5-} \
            -detail {Marks the end of switches, so hiddenCmdName may itself start with -.}
    }

    subcommand issafe {
        arity ..1
        detail {Check if interpreter is safe.}
        synopsis {interp issafe ?path?}
        return_type Boolean
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }

    subcommand limit {
        arity 2.. -step 2 -also 3
        detail {Get or set resource limits.}
        synopsis {interp limit path limitType ?-option? ?value ...?}
        available {tcl 8.5-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        arg_values_accept_prefix
        arg 1 -values-from interp-limit-arg1 -closed

        option -command -takes {} -role Body -body-kind Structural -script-timing Deferred \
            -detail {Script run in the global namespace of the interpreter that set this option, invoked when the limited interpreter's limit is exceeded; may extend the limit to let evaluation continue. Common to both limit types.}
        option -granularity -takes n \
            -detail {How often, relative to the interpreter's consistent-state checkpoints, the limit is actually checked. Common to both limit types.}
        option -milliseconds -takes ms \
            -detail {Millisecond offset applied after -seconds. Only meaningful for the time limit type, given alongside -seconds.}
        option -seconds -takes epochSeconds \
            -detail {Epoch seconds (as from clock seconds) at which the time limit fires. Empty string clears the time limit. Only meaningful for the time limit type.}
        option -value -takes count \
            -detail {Number of commands the interpreter may execute before the command limit fires. Empty string clears the command limit. Only meaningful for the command limit type.}
    }

    subcommand marktrusted {
        arity 1
        detail {Mark interpreter as trusted.}
        synopsis {interp marktrusted path}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
        #   spells it `state_transitions NAME|{ composition … argument_shape
        #   … resolver none|from-frame-effect|-native ID|{words ctx} {…}
        #   widen … covers … commit … }`, but a draft records only that
        #   the field is set, never the expression that set it.
    }

    subcommand recursionlimit {
        arity 1..2
        detail {Get or set recursion limit.}
        synopsis {interp recursionlimit path ?newlimit?}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `world_effects` is set on the source spec. The DSL
        #   spells it `world_effects none|NAME|{ … }`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
