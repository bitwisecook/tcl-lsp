        summary {Returns the type of the DNS packet.}
        synopsis {DNS::ptype}
        description {This iRules command returns the type of the DNS packet.

Note: This command requires the DNS Profile, which is only enabled as
part of GTM or the DNS Services add-on.}
        source {https://clouddocs.f5.com/api/irules/DNS__ptype.html}
        example {OMAIN response is going to be sent,
            # instead attach a record to resolve to.
            when DNS_RESPONSE {
                if { [DNS::ptype] == "NXDOMAIN" } {
                    DNS::header rcode NOERROR
                    DNS::answer insert "[DNS::question name]. 60 [DNS::question class] [DNS::question type] 192.168.1.245"
                }
            }}
    }
}

command DNS::query {
    available {f5-irules}

    side_effect DnsState -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DNS::query ('dnsx' | 'dns-express') NAME DNS_TYPE (DNSSEC)?}

    hover {
        summary {Returns or constructs and sends a query to the DNS-Express database for a name and type.}
        synopsis {DNS::query ('dnsx' | 'dns-express') NAME DNS_TYPE (DNSSEC)?}
        description {This iRules command returns or constructs and sends a query to the
DNS-Express database for a name and type (IN class only).

Note: This command requires the DNS Profile, which is only enabled as
part of GTM or the DNS Services add-on.}
        source {https://clouddocs.f5.com/api/irules/DNS__query.html}
        example {when DNS_RESPONSE {
        set rrsl [DNS::query dnsx nameserver.org SOA]
        foreach rrs $rrsl {
            foreach rr $rrs {
                if { [DNS::type $rr] == "SOA" } {
                    DNS::additional insert $rr
                }
            }
        }
    }}
    }
}

