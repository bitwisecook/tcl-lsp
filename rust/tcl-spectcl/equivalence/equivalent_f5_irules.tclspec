command clientside {
    available {f5-irules}
    traits IS_SIDE_SWITCH
    arity ..1

    arg 0 -role Body

    side_effect ConnectionControl -reads -side Client

    # TODO(spectcl): `side_switch_target` is set on the source spec. The DSL
    #   spells it `side_switch_target Client|Server`, but a draft records only
    #   that the field is set, never the expression that set it.

    form Default {clientside (NESTING_SCRIPT)?}

    hover {
        summary {Causes the specified iRule commands to be evaluated under the client-side context.}
        synopsis {clientside (NESTING_SCRIPT)?}
        description {Causes the specified iRule commands to be evaluated under the client-side context. This command has no effect if the iRule is already being evaluated under the client-side context. If there is no argument, the command returns 1 if the current event is in the clientside context or 0 if not.}
        source {https://clouddocs.f5.com/api/irules/clientside.html}
        example {when SERVER_CONNECTED {
   # Check if the client IP address is 10.1.1.80
   # [clientside {IP::remote_addr}] is equivalent to [IP::client_addr]
   if { [IP::addr [clientside {IP::remote_addr}] equals 10.1.1.80] } {
      # Do something like drop the packets in this example
      discard
   }
}}
        returns {clientside Returns 1 if the current event is in the clientside context or 0 if not.}
    }
}

command clock {
    available {tcl 8.4-} {f5-irules}
    traits {CSE_CANDIDATE BYTE_COMPILED}
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    runtime_backing shipped-builtin clock

    option -base -takes timeVal -detail {Base time for relative scanning.}
    option -format -takes format -detail {strftime-style format string.}
    option -gmt -takes boolean -role Boolean -detail {Use GMT instead of local time.}
    option -locale -takes locale -available {tcl 8.5-} -detail {Locale for month/day names.}
    option -timezone -takes zone -available {tcl 8.5-} -detail {Time zone for conversion.}
    option -validate -takes boolean -role Boolean -available {tcl 9.0-} \
        -detail {Validate date fields strictly (Tcl 9.0+).}

    form Default {clock subcommand ?arg ...?}

    hover {
        summary {Obtain and manipulate dates and times.}
        synopsis {clock add timeVal ?count unit ...?}
        synopsis {clock clicks ?-milliseconds? ?-microseconds?}
        synopsis {clock format timeVal ?-option value ...?}
        synopsis {clock microseconds}
        synopsis {clock milliseconds}
        synopsis {clock monotonic}
        synopsis {clock scan inputString ?-option value ...?}
        synopsis {clock seconds}
        description {`clock seconds`, `clock milliseconds`, `clock microseconds`, and `clock clicks` read the current wall-clock time; `clock monotonic` (Tcl 9.1+) instead reads a clock guaranteed never to run backwards, unlike wall-clock time which can jump on an NTP correction. `clock format` converts a seconds-since-epoch value to text and `clock scan` parses text back into one; `clock add` performs calendar-aware arithmetic on a seconds value (day/week arithmetic preserves local time across DST transitions; month/year arithmetic clamps to the last day of a shorter target month). Before the Tcl 8.5 clock rewrite (TIP 173), `clock format` accepted only -format/-gmt and `clock scan` accepted only -base/-gmt, always via free-form parsing, and there was no `clock add`/`clock microseconds`/`clock milliseconds` at all — `-locale`, `-timezone`, and `clock scan`'s strict -format parsing all arrived with that rewrite. `-validate` (Tcl 9.0+, TIP 688) controls whether an out-of-range field during a strict `clock scan` raises an error (the default) or is clamped into range.}
        source {Tcl clock(n)}
        example {clock format [clock seconds] -format {%Y-%m-%d %H:%M:%S}
clock scan {2024-01-15} -format {%Y-%m-%d}
clock add [clock seconds] 1 day -timezone :UTC}
        returns {An integer for seconds, milliseconds, microseconds, clicks, monotonic, scan, and add; a formatted string for format.}
    }

    subcommand add {
        arity 1..
        detail {Add duration to a time.}
        synopsis {clock add timeVal ?count unit ...?}
        available {tcl 8.5-}
        return_type Int
        pure
        option_prefix_words 1
        arg 2 -values-from clock-add-arg2
        arg 4 -values-from clock-add-arg2
        arg 6 -values-from clock-add-arg2
        arg 8 -values-from clock-add-arg2
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.

        option -gmt -takes boolean -role Boolean \
            -detail {Do the arithmetic in UTC instead of the local time zone; superseded by -timezone :UTC but still accepted.}
        option -locale -takes locale -detail {Locale used to resolve month/weekday names.}
        option -timezone -takes tz \
            -detail {Time zone the calendar arithmetic (days/weekdays/weeks/months/years) is done in.}
    }

    subcommand clicks {
        arity ..1
        detail {Return hi-res clock value.}
        synopsis {clock clicks ?-milliseconds? ?-microseconds?}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.

        option -milliseconds \
            -detail {Return the same value as `clock milliseconds` instead of the raw high-resolution counter.}
        option -microseconds -available {tcl 8.5-} \
            -detail {Return the same value as `clock microseconds` instead of the raw high-resolution counter.}
    }

    subcommand format {
        arity 1..
        detail {Format a time value.}
        synopsis {clock format timeVal ?-option value ...?}
        return_type String
        format_string_type Clock
        pure
        option_prefix_words 1
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.

        option -format -takes format -role FormatString \
            -detail {strftime-style output format string (default "%a %b %d %H:%M:%S %Z %Y").}
        option -gmt -takes boolean -role Boolean \
            -detail {Format in UTC instead of the local time zone; superseded by -timezone :UTC but still accepted.}
        option -locale -takes locale -available {tcl 8.5-} \
            -detail {Locale for month / day-of-week names and the other locale-dependent format groups (%a, %c, ...).}
        option -timezone -takes tz -available {tcl 8.5-} \
            -detail {Time zone to format the value in.}
    }

    subcommand microseconds {
        arity 0
        detail {Return current time in microseconds.}
        synopsis {clock microseconds}
        available {tcl 8.5-}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
    }

    subcommand milliseconds {
        arity 0
        detail {Return current time in milliseconds.}
        synopsis {clock milliseconds}
        available {tcl 8.5-}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
    }

    subcommand monotonic {
        arity 0
        detail {Return current monotonic clock value in microseconds.}
        synopsis {clock monotonic}
        available {tcl 9.1}
        return_type Int
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
    }

    subcommand scan {
        arity 1..
        detail {Parse a date/time string.}
        synopsis {clock scan inputString ?-option value ...?}
        return_type Int
        format_string_type Clock
        option_prefix_words 1
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.

        option -base -takes seconds \
            -detail {Base date/time used to fill in fields the input string doesn't specify.}
        option -format -takes format -role ScanFormat -available {tcl 8.5-} \
            -detail {Explicit input format string for strict parsing; omitting it falls back to the deprecated free-form scanner.}
        option -gmt -takes boolean -role Boolean \
            -detail {Interpret the input as UTC instead of local time; superseded by -timezone :UTC but still accepted.}
        option -locale -takes locale -available {tcl 8.5-} \
            -detail {Locale for month / day-of-week names.}
        option -timezone -takes tz -available {tcl 8.5-} \
            -detail {Time zone for interpretation.}
        option -validate -takes boolean -role Boolean -available {tcl 9.0-} \
            -detail {When true (the default), an out-of-range field (e.g. day 31 in a 30-day month) raises an error; when false, it is clamped into range instead.}
    }

    subcommand seconds {
        arity 0
        detail {Return current time in seconds.}
        synopsis {clock seconds}
        return_type Int
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        # TODO(spectcl): `result_stability` is set on the source spec. The DSL
        #   spells it `result_stability
        #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
        #   …}}`, but a draft records only that the field is set, never the
        #   expression that set it.
    }
}

command clone {
    available {f5-irules}

    side_effect ConnectionControl -writes -side Both

    form Default {clone pool POOL_OBJ (member IP_ADDR (PORT)?)?}

    hover {
        summary {Causes the system to clone traffic to the specified pool, pool member or vlan regardless of monitor status.}
        synopsis {clone pool POOL_OBJ (member IP_ADDR (PORT)?)?}
        synopsis {clone nexthop VLAN_OBJ}
        description {Causes the system to clone traffic to the specified pool, pool member or vlan regardless of monitor status. (Pool member status may be determined by the use of the LB::status command. Failure to select a server because none are available may be prevented by using the active_members command to test the number of active members in the target pool before choosing it.) Any responses to cloned traffic from pool members will be ignored.}
        source {https://clouddocs.f5.com/api/irules/clone.html}
        example {when CLIENT_ACCEPTED {
   clone nexthop tap_vlan
}}
        returns {clone pool <pool_name> Specifies the pool to which you want to send the cloned traffic.}
    }
}

command close {
    available {f5-irules}
    arity 1..2

    arg 0 -role Channel

    side_effect ConnectionControl -writes -side Both

    form Default {close CONNECTION}

    hover {
        summary {Closes an existing sideband connection.}
        synopsis {close CONNECTION}
        description {This command closes an existing sideband connection. It is one of several commands that make up the ability to create sideband connections from iRules.}
        source {https://clouddocs.f5.com/api/irules/close.html}
        example {# Open a sideband connection with a connection timeout of 100 ms and an idle timeout of 30 seconds
#   to a local virtual server name sideband_virtual_server
set conn_id [connect -timeout 100 -idle 30 -status conn_status sideband_virtual_server]

# Same as above, but use an external host IP:port instead of a virtual server name
set conn_id [connect -timeout 100 -idle 30 -status conn_status 10.0.0.10:80]

# close the connection
close conn_id}
        returns {close <connection> closes an existing connection}
    }
}

command concat {
    available {tcl 8.4-} {f5-irules}
    traits {PURE BYTE_COMPILED FRAMELESS_RUNTIME EXPANSION_ESCAPE_SAFE}

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    byte_array_effect Coerces

    const_fold -native concat::const_fold
    codegen_hook -native Concat
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.
    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.
    # TODO(spectcl): `result_stability` is set on the source spec. The DSL
    #   spells it `result_stability
    #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
    #   …}}`, but a draft records only that the field is set, never the
    #   expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin concat

    form Default {concat ?arg arg ...?}

    hover {
        summary {Join lists together}
        synopsis {concat ?arg arg ...?}
        description {Joins every argument together with a single space, after trimming leading and trailing white-space from each one. If all of the arguments are lists, this has the same effect as concatenating them into a single list. Arguments that are empty after trimming are dropped entirely rather than leaving a stray separating space (documented from Tcl 8.6 on; the 8.4/8.5 manual pages describe only the trim-and-join rule). Whitespace in the interior of an argument is left untouched, so multiple internal spaces survive the join. Because concat splices raw argument text rather than list structure, unbalanced braces or quotes spanning an argument boundary can produce a malformed result; for guaranteed list-safe concatenation use `list {*}listA {*}listB` instead (the official recommendation as of the Tcl 9.0 manual page).}
        source {Tcl concat(n)}
        example {concat a b {c d e} {f {g h}}
concat " a b {c   " d "  e} f"
concat "a   b   c" { d e f }
list {*}"a   b   c" {*}{ d e f }}
        returns {The concatenated string, or the empty string when no arguments are given.}
    }
}

command connect {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    taint_network_sink_args {}
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -protocol -takes PROTO -detail {IP protocol (default TCP).}
    option -myaddr -takes IP_ADDR -detail {Source address for the connection.}
    option -myport -takes PORT -detail {Source port for the connection.}
    option -timeout -takes MSEC -detail {Time in ms to wait for connection.}
    option -idle -takes SEC -detail {Idle timeout in seconds (default 300).}
    option -tos -takes TOS -detail {IP TOS value.}
    option -status -takes VARIABLE -detail {Save connection status into variable.}

    form Default {connect ?options? destination}

    hover {
        summary {Establishes a sideband connection.}
        synopsis {connect info (}
        synopsis {connect ((}
        description {This command establishes a sideband connection. It is one of several commands that make up the ability to use sideband connections from iRules.}
        source {https://clouddocs.f5.com/api/irules/connect.html}
        example {# Open a sideband connection with a connection timeout of 100 ms and an idle timeout of 30 seconds
#   to a local virtual server name sideband_virtual_server
set conn_id [connect -timeout 100 -idle 30 -status conn_status sideband_virtual_server]

# Same as above, but use an external host IP:port instead of a virtual server name
set conn_id [connect -timeout 100 -idle 30 -status conn_status 10.0.0.10:80]


Example with more complete error handling:}
        returns {This command opens a sideband connection to the specified destination.}
    }
}

command continue {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD NEEDS_START_CMD BYTE_COMPILED FRAMELESS_RUNTIME TRANSFERS_CONTROL CONTINUES_LOOP}
    arity 0

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    inline_codegen_hook -native Continue
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin continue

    form Default {continue}

    hover {
        summary {Skip to the next iteration of the innermost enclosing loop.}
        synopsis {continue}
        description {Typically invoked inside the body of a looping command such as for, foreach, or while. It raises a TCL_CONTINUE exception that aborts the remainder of the current iteration and transfers control to the next iteration of the innermost containing loop — the loop's own per-iteration step (for's third clause, foreach's advance to the next list element, while's condition re-check) still runs as normal. Outside a loop the exception does not simply propagate forever: catch traps it and returns an ordinary TCL_CONTINUE result (code 4) with an empty value, and a Tk event binding script that invokes continue is terminated — skipping any further "+"-appended scripts for that binding — while Tk goes on to run bindings for other tags. If a continue exception instead escapes the body of a procedure, or reaches the top level of a script, without being absorbed by an enclosing loop, catch, or binding, the interpreter converts it into an error: invoked "continue" outside of a loop.}
        source {Tcl man page continue.n}
        example {for {set i 0} {$i < 10} {incr i} {
    if {$i == 5} {
        continue
    }
    puts $i
}}
        returns {None in normal use — control transfers to the next iteration of the innermost enclosing loop. Trapped with catch, the caught value is an empty string.}
    }
}

command cpu {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    form Default {cpu usage (}

    hover {
        summary {Returns the average TMM cpu load for the given interval.}
        synopsis {cpu usage (}
        description {The cpu usage command returns the average TMM cpu load for the given
interval. All averages are exponential weighted moving averages over
the interval.}
        source {https://clouddocs.f5.com/api/irules/cpu.html}
        example {when HTTP_REQUEST {
  if{ [cpu usage 5sec] <= 1} {
    pool1
  } else {
    HTTP::redirect "http://anotherpool.com"
  }
}}
    }
}

command crc32 {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    form Default {crc32 ANY_CHARS}

    hover {
        summary {Returns the crc32 checksum for the specified string.}
        synopsis {crc32 ANY_CHARS}
        description {The crc32 command calculates a 32-bit cyclic redundancy check value
(CRC) for the bytes in a string using the well-known CRC-32 (Ethernet
CRC) scheme. The polynomial is 0x04c11db7, the CRC register is
initialized with 0xffffffff, the input bytes are taken msb-first, and
the result is the complement of the final register value reflected.
(crc32 implements the scheme called "CRC-32" in this Catalogue of
Parametrised CRC Algorithms.)
crc32 returns a number, or the empty string if an error occurs.}
        source {https://clouddocs.f5.com/api/irules/crc32.html}
        example {when HTTP_REQUEST {
   # Create a hash value for the host based on crc32
   # This could also be based on md5 or any other implementation
   # of a hash like djb or something.
set key [crc32 [HTTP::host]]

   # Modulo the hash value by 1 - odd goes to one member, even another
set key [expr {$key & 1}]

   # Route the request to the pool member based on the modulus
   # of the hash value.
switch $key {
0 { pool my_pool member 1.2.3.4:80 }
1 { pool my_pool member 5.6.7.8:80 }
   }
}}
    }
}

command decode_uri {
    available {f5-irules}
