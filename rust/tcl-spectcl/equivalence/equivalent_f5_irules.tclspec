command recv {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    option -eol -detail {Suspend until end-of-line received.}
    option -peek -detail {Return data but leave it buffered.}
    option -timeout -takes MSEC -detail {Time in ms to wait for data.}
    option -status -takes VARIABLE -detail {Save recv status into variable.}

    form Default {recv ?options? ?numChars? connection ?varname?}

    hover {
        summary {Receives data from a given sideband connection.}
        synopsis {recv ((}
        description {This command receives data from an existing sideband connection (established with connect). It is one of several commands that make up the ability to create sideband connections from iRules.}
        source {https://clouddocs.f5.com/api/irules/recv.html}
        example {when HTTP_REQUEST {
    set dest "10.10.145.1:80"
    set conn [connect -protocol TCP -timeout 30000 -idle 30 $dest]
    set data "GET /mypage/index.html HTTP/1.0\r\n\r\n"
    send $conn $data
    # recv 2000 chars get recv bytes error
    set recv_2kbytes [recv -timeout 30000 2000 $conn]
    log local0. "Recv data: '$recv_2kbytes'"
    set length_recv [string length $recv_2kbytes]
    log local0. "length_recv has $length_recv bytes in it."
    close $conn
}}
        returns {Receives some data (up to numChars bytes) from a sideband connection. If varname is specified, the response is stored in that variable, and recv returns the amount of data received. Otherwise, recv returns the response data.}
    }
}

command redirect {
    available {f5-irules}

    side_effect ResponseCommit -writes -side Client

    deprecated_replacement HTTP::redirect

    form Default {redirect to HOST_URI}

    hover {
        summary {Redirects an HTTP request to the specific location.}
        synopsis {redirect to HOST_URI}
        description {Redirects an HTTP request to a specific location. The location can be
either a host name or a URI. This is a BIG-IP 4.X statement, provided
for backward compatibility. You can use the equivalent 9.X command
HTTP::redirect instead.}
        source {https://clouddocs.f5.com/api/irules/redirect.html}
        example {when HTTP_REQUEST {
    # HTTP::redirect, HTTP::host and HTTP::uri should be used instead
    redirect to "https://[http_host][http_uri]"
}}
    }
}

command regexp {
    available {tcl 8.4-} {f5-irules}
    traits {CONDITIONAL_VARIABLE_WRITE BYTE_COMPILED FRAME_HASH_BUILTIN}
    arity 1..

    return_type Int
    var_write_typing Destructured
    # TODO(spectcl): `variable_write_min_args` is set on the source spec. The
    #   DSL spells it `variable_write_min_args N`, but the loader has no reader
    #   for that property word yet.
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    pattern_type Regex
    prefix_matching Strict

    arg_role_layout_resolver -native regexp::arg_role_layout_resolver
    arg_role_resolver_roles {Pattern VarWrite}
    inline_codegen_hook -native Regexp
    analyser_hook -native RegexPatternCapture
    return_type_hook -native Regexp
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -writes

    runtime_backing shipped-builtin regexp

    option -nocase \
        -detail {Match case-insensitively: upper-case characters in string are treated as lower case.}
    option -expanded \
        -detail {Ignore whitespace and # comments in exp (the (?x) embedded flag).}
    option -line \
        -detail {Enable newline-sensitive matching: equivalent to giving both -linestop and -lineanchor together (the (?n) embedded flag).}
    option -linestop \
        -detail {Make . and [^...] bracket expressions stop at a newline instead of matching through it (the (?p) embedded flag).}
    option -lineanchor \
        -detail {Make ^ and $ also match immediately after/before a newline, not just the start/end of the whole string (the (?w) embedded flag).}
    option -all \
        -detail {Match as many times as possible, returning the total match count instead of 1/0; with match variables given, they end up holding the last match only.}
    option -inline -effect {suppresses-role VarWrite} -family layout \
        -detail {Return the match data as a list instead of writing match variables (illegal to combine with a matchVar/subMatchVar argument). With -all, every match's data is concatenated into one flat list.}
    option -indices \
        -detail {Store each matchVar/subMatchVar as a {first last} character-index pair into string instead of the matched text.}
    option -start -takes index \
        -detail {Character index into string to start matching at. Tcl 8.4 accepts only a plain non-negative integer; Tcl 8.5 and later accept the fuller index syntax used by string index (e.g. end, end-N). ^ no longer anchors to the string's real start there, though \A still does; -indices results stay relative to the whole string, and index is clamped to the string's bounds.}
    option -about -available {tcl 8.4-} -effect {reserves-trailing-words 1} -family layout \
        -detail {Skip matching and instead return {subexpressionCount propertyList}; needs only exp. Available in C Tcl; Jim 0.84 does not support this switch.}
    option -- -effect ends-options -family layout \
        -detail {Ends switch parsing; the next word is treated as exp even if it begins with -.}
    option_forbids -inline {{arg 2}} -message {regexp match variables not allowed when using -inline}
    option_effect_family layout {base all-on combine accumulate}

    form Default {regexp ?switches? exp string ?matchVar? ?subMatchVar subMatchVar ...?}
    form Default {regexp -about ?switches? exp}

    hover {
        summary {Match a regular expression against a string.}
        synopsis {regexp ?switches? exp string ?matchVar? ?subMatchVar subMatchVar ...?}
        synopsis {regexp -about ?switches? exp}
        description {Determines whether exp (an ARE — see re_syntax) matches part or all of string, returning 1 on a match and 0 otherwise. Extra arguments after string name variables to receive match data: matchVar gets the overall matched text, and each subMatchVar gets the text of one parenthesized subexpression in exp, left to right; a subMatchVar with no corresponding subexpression, or whose subexpression did not participate in the match, is set to the empty string (or to "-1 -1" when -indices is given).

-all repeats the match as many times as possible and returns the total match count instead of 1/0; if match variables are also given, they end up holding only the last match. -inline returns the match data as a list instead of writing match variables — combining it with any matchVar/subMatchVar argument is an error — and combined with -all the per-match lists are concatenated into one flat list (the whole match plus one element per subexpression, for each match). -about skips matching entirely and returns {subexpressionCount propertyList} describing the compiled pattern; it needs only exp, string may be omitted. -start index begins the search index characters into string without anchoring ^ there (\A still anchors to index), and any -indices results stay relative to the start of the whole string, not to index.

**Security**: When exp comes from an untrusted variable, put -- before it so a leading - can't be parsed as a switch. Avoid patterns with nested unbounded quantifiers (e.g. (a+)+) against attacker-controlled input — they can trigger catastrophic backtracking (ReDoS).}
        source {Tcl regexp(n)}
        example {regexp {^[0-9]+$} $input
regexp -nocase {^error:\s*(.*)$} $line -> message
regexp -all -inline {\S+} $text
regexp -indices -- {(\w+)@(\w+)} $email -> user host
regexp -about {(a)(b)*c}}
        returns {1 if exp matches, 0 otherwise; the total match count instead when -all is given. A list of the match data (instead of writing match variables) when -inline is given. With -about, a two-element {subexpressionCount propertyList} list describing the pattern, without attempting any match.}
    }
}

command regsub {
    available {tcl 8.4-} {f5-irules}
    traits {UNCONDITIONAL_VARIABLE_WRITE BYTE_COMPILED FRAME_HASH_BUILTIN}
    arity 3..4 -positionals

    return_type Int
    var_write_typing {Fixed String}
    # TODO(spectcl): `variable_write_min_args` is set on the source spec. The
    #   DSL spells it `variable_write_min_args N`, but the loader has no reader
    #   for that property word yet.
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    byte_array_effect Coerces
    pattern_type Regex
    format_string_type Regsub
    prefix_matching Strict

    arg_role_layout_resolver -native regsub::arg_role_layout_resolver
    arg_role_resolver_roles {Pattern FormatString VarWrite}
    command_prefix_resolver -native regsub::command_prefix_resolver
    const_fold -native regsub::const_fold
    const_fold_versioned -native regsub::const_fold_versioned
    analyser_hook -native RegexPatternCapture
    return_type_hook -native Regsub
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -writes

    taint_transform REGEX_LITERAL
    taint_transform_when RegsubQuotesRegexMetacharacters
    taint_double_encode_colour REGEX_LITERAL

    runtime_backing shipped-builtin regsub

    option -nocase \
        -detail {Match case-insensitively: upper-case characters in string are treated as lower case when matching against exp; substitutions written into subSpec still use the original, unconverted text of string.}
    option -expanded \
        -detail {Ignore whitespace and # comments in exp (the (?x) embedded flag).}
    option -line \
        -detail {Enable newline-sensitive matching: equivalent to giving both -linestop and -lineanchor together (the (?n) embedded flag).}
    option -linestop \
        -detail {Make . and [^...] bracket expressions stop at a newline instead of matching through it (the (?p) embedded flag).}
    option -lineanchor \
        -detail {Make ^ and $ also match immediately after/before a newline, not just the start/end of the whole string (the (?w) embedded flag).}
    option -all \
        -detail {Replace every non-overlapping match of exp in string instead of only the first; & and \n backreferences in subSpec are recomputed independently for each match.}
    option -start -takes index \
        -detail {Character index into string to start matching at. Tcl 8.4 accepts only a plain non-negative integer; Tcl 8.5 and later accept the fuller index syntax used by string index (e.g. end, end-N). ^ no longer anchors to the string's real start there, though \A still does; index is clamped to the string's bounds.}
    option -command -dialects {tcl9.0+ jim} \
        -detail {Treat subSpec as a command prefix (a non-empty list) instead of a substitution template: & and \n lose their special meaning. The whole match, then each capturing subexpression's match (like regexp -inline), are appended to the prefix, and the completed list is evaluated as a Tcl command whose result becomes the replacement text. Invoked once per match with -all, otherwise at most once; any error or exception from the callback becomes an error from regsub itself.}
    option -- \
        -detail {Ends switch parsing; the next word is treated as exp even if it begins with -.}

    form Default {regsub ?switches? exp string subSpec ?varName?}

    hover {
        summary {Perform substitutions based on regular expression pattern matching.}
        synopsis {regsub ?switches? exp string subSpec ?varName?}
        description {Matches the regular expression exp (an ARE — see re_syntax) against string and replaces the matched text with subSpec. Only the first match is replaced unless -all is given, which replaces every non-overlapping match instead. Within subSpec, & or \0 stands for the whole match and \1 through \9 for the text of the corresponding parenthesized subexpression; extra backslashes escape these forms, and enclosing subSpec in braces is usually safest when it needs to contain backslashes of its own.

When varName is supplied, the substituted text is stored there and the command returns the number of replacements made; when it is omitted, the substituted string is returned directly instead. Since Tcl 9.0 (TIP 463), -command changes subSpec from a template into a command prefix: the whole match plus each capturing group's text are appended to it (as regexp -inline would return them), and the prefix is evaluated as a Tcl command whose result becomes the replacement text — useful when the substitution needs computation a plain template can't express.

**Security**: put -- before exp when it comes from an untrusted variable so a leading - can't be parsed as a switch. Avoid patterns with nested unbounded quantifiers (e.g. (a+)+) against attacker-controlled input — they can trigger catastrophic backtracking (ReDoS).}
        source {Tcl regsub(n)}
        example {regsub -all {\mfoo\M} $text bar text
regsub -nocase {\yinteresting\y} $text {"&"} text
set trimmed [regsub -all {^\s+|\s+$} $line {}]
regsub -all -command {\w+} $message {string totitle}}
        returns {The substituted string, or the count of replacements made when varName is given.}
    }
}

command reject {
    available {f5-irules}
    traits DIAGRAM_ACTION

    irules_source_flow DropsConnection
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.

    side_effect ConnectionControl -writes -side Both
    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {reject}

    hover {
        summary {Causes the connection to be rejected.}
        synopsis {reject}
        description {Causes the connection to be rejected, returning a reset as appropriate
for the protocol. Subsequent code in the current event in the current
iRule or other iRules on the VS are still executed prior to the reset
being sent.

**Warning**: After `reject`, the current iRule continues executing,
and other iRules on the VS also run. This can cause TCL errors
(e.g. `ASM::disable` on a rejected connection). Always follow
`reject` with `event disable all` and `return`.

If the VS is using FastHTTP, reject commands will not work, at least
under 11.3.0.}
        source {https://clouddocs.f5.com/api/irules/reject.html}
        example {when CLIENT_ACCEPTED {
  if { [TCP::local_port] != 443 } {
    reject
    event disable all
    return
  }
}}
    }
}

command relate_client {
    available {f5-irules}

    side_effect ConnectionControl -writes -side Client

    form Default {relate_client CONFIG}

    hover {
        summary {Sets up a related established connection.}
        synopsis {relate_client CONFIG}
        description {Sets up a related established connection. This can be used with protocols that parse information out of a control connection and then establish a data connection based on information that was exchanged in the control connection.}
        source {https://clouddocs.f5.com/api/irules/relate_client.html}
        example {when SIP_REQUEST {
    # Taken from https://devcentral.f5.com/wiki/irules.Load-Balance-Outbound-SIP-Voice-Traffic-Signaling-AND-Media-with-SNAT.ashx
    # Pre-establish the UDP connection to allow RTP from Server -> Client (and vice versa)
    relate_client {
        proto 17
        clientflow $source_VLAN $destination_RTP $destination_RTP_port $source_inside $source_RTP_port
        serverflow $destination_VLAN $source_outside $source_RTP_port $destination_RTP $destination_RTP_port
    }
}}
    }
}

command relate_server {
    available {f5-irules}

    side_effect ConnectionControl -writes -side Server

    form Default {relate_server CONFIG}

    hover {
        summary {Sets up a related established connection.}
        synopsis {relate_server CONFIG}
        description {Sets up a related established connection. This can be used with protocols that parse information out of a control connection and then establish a data connection based on information that was exchanged in the control connection.}
        source {https://clouddocs.f5.com/api/irules/relate_server.html}
        example {when SIP_RESPONSE {
    # Taken from https://devcentral.f5.com/wiki/irules.Load-Balance-Outbound-SIP-Voice-Traffic-Signaling-AND-Media-with-SNAT.ashx
    # Pre-establish the UDP connection to allow RTP from Server -> Client (and vice versa)
    relate_server {
        proto 17
        clientflow $source_VLAN $destination_RTP $destination_RTP_port $source_inside $source_RTP_port
        serverflow $destination_VLAN $source_outside $source_RTP_port $destination_RTP $destination_RTP_port
    }
}}
    }
}

command remote_addr {
    available {f5-irules}

    side_effect TcpState -reads -side Both

    deprecated_replacement IP::remote_addr
    deprecated_replacement_drop_in

    form Default {remote_addr}

    hover {
        summary {Deprecated: Use IP::remote_addr instead.}
        synopsis {remote_addr}
        description {Returns the IP address of the host on the far end of the connection. In the clientside context, this is the client IP address. In the serverside context this is the node IP address. You can also specify the IP::client_addr and IP::server_addr commands, respectively.

In BIG-IP 10.x with route domains enabled this command returns the remote IP address in the x.x.x.x%rd of the server or client (depending on the context) that is in any non-default route domain else it returns just the IP address as expected.

This command is equivalent to the BIG-IP 4.X variable remote_addr.}
        source {https://clouddocs.f5.com/api/irules/remote_addr.html}
        example {when CLIENT_ACCEPTED {
    if { [IP::addr [IP::remote_addr] equals 206.0.0.0 mask 255.0.0.0] } {
        pool clients_from_206
    } else {
        pool other_clients_pool
    }
}}
        returns {Returns the IP address of the host on the far end of the connection.}
    }
}

command remote_port {
    available {f5-irules}

    deprecated_replacement TCP::remote_port
    deprecated_replacement_drop_in

    hover {
        summary {Deprecated: use TCP::remote_port instead}
    }
}

command return {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD TERMINATES_BLOCK NEEDS_START_CMD BYTE_COMPILED FRAMELESS_RUNTIME}

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `native_result` is set on the source spec. The DSL spells
    #   it `native_result -native CONTRACT`, but a draft records only that the
    #   field is set, never the expression that set it.
    reserved_trailing_words 1

    arg_role_layout_resolver -native return::arg_role_layout_resolver
    arg_role_resolver_roles Result
    context_gate -native return::context_gate
    lowering_hook -native Return
    inline_codegen_hook -native Return

    side_effect EventControl -writes -available {f5-irules}
    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin return

    option -code -takes code -values-from return-code -closed -integer Any \
        -detail {Exceptional return code: ok/error/return/break/continue, or an integer (5–0x3fffffff reserved for application use by convention, not enforced).}
    option -level -takes level -integer {Range 0 2147483647} -available {tcl 8.5-} \
        -detail {Stack levels up the code applies to (default 1). 0 means this `return` itself returns -code. Must be 0..=2147483647; a negative or larger value is a hard error (unlike -code's integer, which never errors in this range).}
    option -errorcode -takes list \
        -detail {Additional error info, merged into the errorCode global. Only meaningful with -code error; defaults to "NONE" when omitted there.}
    option -errorinfo -takes info \
        -detail {Initial stack trace, merged into the errorInfo global. Only meaningful with -code error; Tcl supplies its own default when omitted there.}
    option -errorstack -takes list -arity-hook -native return::errorstack::arity -available {tcl 8.6-} \
        -detail {Initial error stack (must be an even-sized list). Only meaningful with -code error.}
    option -options -takes dict -available {tcl 8.5-} \
        -detail {Dictionary of additional option/value pairs, merged in as if each had been given directly.}

    form Default {return ?-code code? ?-level level? ?result?} -available {tcl 8.5-}
    form Default {return ?-code code? ?-errorinfo info? ?-errorcode code? ?string?} -available {{tcl 8.4} {f5-irules}}
    form Default {return} -available {f5-irules}

    hover {
        summary {Return from the current procedure/script with optional control-code metadata.}
        synopsis {return ?result?}
        synopsis {return ?-code code? ?result?}
        synopsis {return ?option value ...? ?result?}
        description {With no options, immediately returns from the current procedure — or, inside a script evaluated by source, stops evaluating that script — with an empty result unless result is given. -code sets an exceptional completion code instead of the default ok; -errorinfo and -errorcode (plus -errorstack from Tcl 8.6) are honoured only when -code is error, each seeding the matching global (errorInfo/errorCode) and defaulting to Tcl's own trace or "NONE" when omitted. -level (Tcl 8.5+, default 1) counts call-stack levels up the code applies to; -level 0 makes this return itself complete with code immediately, which is how interp alias builds break/continue-alike commands. -options (Tcl 8.5+) merges a dict of option/value pairs in as if each had been passed directly — typically the options dict a catch just captured, to re-raise a caught error unchanged. Tcl 8.4 recognises only -code, -errorinfo, and -errorcode. In an iRules event body, return takes no arguments at all and exits only the current event invocation; outside an event body iRules still exposes just that 8.4-shaped option set, since its embedded core is Tcl 8.4.6.}
        source {Tcl return(n); F5 return(1)}
        example {proc safeDiv {a b} {
    if {$b == 0} {
        return -code error "cannot divide by zero"
    }
    return [expr {$a / $b}]
}

# Re-throw a caught error unchanged, preserving errorInfo/errorCode (Tcl 8.5+)
if {[catch {doWork} result options]} {
    return -options $options $result
}

# Build a break-alike via -level 0 (Tcl 8.5+)
interp alias {} Break {} return -level 0 -code break}
        returns {The result string that becomes the enclosing procedure's result (or, inside a script evaluated by source, that script's result). With -code other than the default ok, result instead becomes the payload of the resulting exceptional completion — e.g. the message text of a -code error, or the value a catch reports when it traps this return.}
    }
}

command rmd160 {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    form Default {rmd160 ANY_CHARS}

    hover {
        summary {Returns the RIPEMD-160 message digest of the specified string.}
        synopsis {rmd160 ANY_CHARS}
        description {Returns the RIPEMD-160 (RACE Integrity Primitives Evaluation Message Digest) message digest of the specified string, or an empty string if an error occurs. Used to ensure data integrity.}
        source {https://clouddocs.f5.com/api/irules/rmd160.html}
        example {when HTTP_REQUEST {
    binary scan [rmd160 [HTTP::host]] w1 key

    set key [expr {$key & 1}]
    switch $key {
        0 { pool my_pool member 1.2.3.4:80 }
        1 { pool my_pool member 5.6.7.8:80 }
    }
}}
        returns {rmd160 <string> Returns the RIPEMD-160 message digest of the specified string, or an empty string if an error occurs.}
    }
}

command scan {
    available {tcl 8.4-} {f5-irules}
    traits {CONDITIONAL_VARIABLE_WRITE BYTE_COMPILED FRAME_HASH_BUILTIN}
    arity 2..

    return_type Int
    var_write_typing Destructured
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    format_string_type Sprintf

    arg_role_count_resolver -native scan::arg_role_count_resolver
    arg_role_resolver_roles {ScanFormat VarWrite}
    const_fold -native scan::const_fold
    return_type_hook -native Scan
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -writes

    runtime_backing shipped-builtin scan

    form Default {scan string format ?varName varName ...?}

    hover {
        summary {Parse string using conversion specifiers in the style of sscanf}
        synopsis {scan string format ?varName varName ...?}
        description {Skips whitespace in string before each conversion, except %c and %[chars]/%[^chars], which do not. A %n$ positional specifier sends that conversion's result to argument n (1-based) instead of the next varName in sequence; once one specifier in format is positional, every specifier must be. Integer conversions (%d, %o, %x/%X, %b, %u, %i) take an optional size modifier that bounds the stored range: h or no modifier limits it to 32 bits, l limits it to the wide()/64-bit range, and ll removes the limit entirely (arbitrary precision). L is a synonym for ll (unlimited) on Tcl 9.0 and later, but on Tcl 8.5 and 8.6 it instead meant the same 64-bit range as l; Tcl 8.4 has neither ll nor an unlimited range, only a plain l or L meaning "at least 64 bits". Tcl 9.0 and later also accept q and j as synonyms for l (wide/64-bit range) and z and t as platform-pointerSize-dependent (matching h's 32-bit range or l's wide range depending on the tcl_platform(pointerSize) value); none of these four size modifiers are recognized before 9.0. %b (binary integer) needs Tcl 8.6 or later. With one or more varName arguments the command writes each converted value and returns the count of conversions performed, or -1 if string runs out before the first conversion completes; with no varName arguments it returns the converted values as a list instead, or the empty string on that same end-of-input failure.}
        source {Tcl scan(n)}
        example {scan $string {#%2x%2x%2x} r g b
scan $string {%d:%d} hours minutes
set count [scan $string {%d %d} x y]
set values [scan $string {%d %d}]}
        returns {The number of successful conversions, or -1 if the end of string is reached before any conversion completes. With no varName arguments, returns the converted values as a list instead, or the empty string on that same end-of-input failure.}
    }
}

command send {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    option -timeout -takes MSEC -detail {Time in ms to wait for data to be sent.}
    option -status -takes VARIABLE -detail {Save send status into variable.}
    option --

    form Default {send ?options? ?--? connection data}

    hover {
        summary {Sends data on an existing sideband connection.}
        synopsis {send ((}
        description {This command sends data on an existing sideband connection (established with connect). It is one of several commands that make up the ability to create sideband connections from iRules.

Arguments

    <connection> is the connection identifier returned from connect

    <data> is the data to send

    -timeout ms specifies the amount of time to wait for the data to be sent. The default is an immediate timeout.

    -status varname will save the result of the send command into varname. The possible status values are:
        1. sent - the data was sent successfully
        2.}
        source {https://clouddocs.f5.com/api/irules/send.html}
        # TODO(spectcl): `hover` holds text no Tcl word carries verbatim — an
        #   unbalanced brace or a backslash-newline. A braced word is the only
        #   faithful spelling, so the statement is dropped rather than written
        #   down wrong.
        returns {Sends data on a specified sideband connection, and returns an integer representing the amount of data that was sent.}
    }
}

