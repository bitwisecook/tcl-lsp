command DIAMETER::avp {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::avp <subcommand> ?args?}

    hover {
        summary {Provides detailed access to diameter attribute-value pairs.}
        synopsis {DIAMETER::avp <subcommand> ?args?}
        synopsis {DIAMETER::avp code <avp_code> ?vendor_id? ?index?}
        synopsis {DIAMETER::avp data <avp_code> ?vendor_id? ?index?}
        description {This iRule command gives access to set and get attribute-value pairs.
Specifics for each command are below in the syntax section.

The AVP upon which this command operates is specified in a flexible
manner.  An AVP name or code (usually) must be specified, and an
optional index may be also specified.  Many commands also accept a
vendor-id.  When an AVP name is specified, it is converted to a code.
Names are written as listed in RFC 3588, formatted as e.g.,
"HOST-IP-ADDRESS".  AVP codes are 32-bit (4-octet) integer values.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__avp.html}
        example {when DIAMETER_EGRESS {
     # Sets the flags of the AVP Product Name to 0 (for Vendor Specific, Mandatory, Protected and Reserved)
     DIAMETER::avp flags set 269 0
     # Checks that the flags are properly set (was a bug in 11.3, solved in 11.4)
     log local0. "AVP : [DIAMETER::avp flags get 269] "
     # Removes the Supported-Vendor-Id from the request
     DIAMETER::avp delete 265
}}
    }

    subcommand code {
        arity 1..3
        detail {Get/set AVP code.}
        synopsis {DIAMETER::avp code <avp_code> ?vendor_id? ?index?}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand count {
        arity 1..2
        detail {Count AVPs matching code.}
        synopsis {DIAMETER::avp count <avp_code> ?vendor_id?}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand length {
        arity 1..3
        detail {Get AVP length.}
        synopsis {DIAMETER::avp length <avp_code> ?vendor_id? ?index?}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand create {
        arity 2..3
        detail {Create a new AVP.}
        synopsis {DIAMETER::avp create <avp_code> <data> ?vendor_id?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand data {
        arity 1..3
        detail {Get/set AVP data.}
        synopsis {DIAMETER::avp data <avp_code> ?vendor_id? ?index?}
        pure
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand delete {
        arity 1..3
        detail {Delete an AVP.}
        synopsis {DIAMETER::avp delete <avp_code> ?vendor_id? ?index?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand replace {
        arity 2..4
        detail {Replace AVP data.}
        synopsis {DIAMETER::avp replace <avp_code> <data> ?vendor_id? ?index?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand insert {
        arity 3..4
        detail {Insert a new AVP at position.}
        synopsis {DIAMETER::avp insert <position> <avp_code> <data> ?vendor_id?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand append {
        arity 2..3
        detail {Append an AVP.}
        synopsis {DIAMETER::avp append <avp_code> <data> ?vendor_id?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand flags {
        arity 2..5
        detail {Get/set AVP flags.}
        synopsis {DIAMETER::avp flags <get|set> <avp_code> ?value? ?vendor_id? ?index?}
        pure
        mutator
        arg 0 -values-from diameter-avp-flags-arg0
        side_effect NetworkIo -reads -writes -side Both
    }
}

command DIAMETER::command {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

