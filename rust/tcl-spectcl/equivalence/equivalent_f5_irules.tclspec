    }

    subcommand version {
        arity 0
        detail {Get Sec-WebSocket-Version header value.}
        synopsis {WS::response version}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand key {
        arity 0
        detail {Get Sec-WebSocket-Accept header value.}
        synopsis {WS::response key}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand valid {
        arity 0
        detail {Check if WebSocket upgrade was successful.}
        synopsis {WS::response valid}
        pure
        side_effect NetworkIo -reads -side Both
    }
}

command X509::cert_fields {
    available {f5-irules}

    side_effect SslState -reads -side Global

    form Default {X509::cert_fields CERTIFICATE ERROR_CODE ((hash}

    hover {
        summary {Returns a list of X509 certificate fields to be added to HTTP headers for ModSSL behavior.}
        synopsis {X509::cert_fields CERTIFICATE ERROR_CODE ((hash}
        description {When given a valid certificate, returns a TCL list of field names and
values which can be added to the HTTP headers in order to emulate
ModSSL behavior. The output can be passed to 'HTTP::header insert
$list' as a list for insertion in the HTTP request or response.}
        source {https://clouddocs.f5.com/api/irules/X509__cert_fields.html}
        example {when CLIENTSSL_CLIENTCERT {
    if { [SSL::cert count] > 0 } {
        session add ssl [SSL::sessionid] [X509::cert_fields [SSL::cert 0] [SSL::verify_result] whole] $timeout
    }
}}
        returns {Returns a list of X509 certificate fields to be added to HTTP headers.}
    }
}

command X509::extensions {
    available {f5-irules}

    side_effect SslState -reads -side Global

    form Default {X509::extensions CERTIFICATE}

    hover {
        summary {Returns the X509 extensions set on an X509 certificate.}
        synopsis {X509::extensions CERTIFICATE}
        description {Returns the X509 extensions set on the specified X509 certificate.}
        source {https://clouddocs.f5.com/api/irules/X509__extensions.html}
        example {when CLIENTSSL_CLIENTCERT {
    set myCert [SSL::cert 0]
    set result [X509::extensions $myCert]
    log local0. "X509::extensions $result"

    if { $result matches_glob "*X509v3 extensions:*X509v3 Basic*" } {
        log local0. "match"
    } else {
        log local0. "no match"
    }
}}
        returns {Returns the X509 extensions set on an X509 certificate.}
    }
}

command X509::hash {
    available {f5-irules}

    side_effect SslState -reads -side Global

    form Default {X509::hash CERTIFICATE}

    hover {
        summary {Returns the MD5 hash (fingerprint) of an X509 certificate.}
        synopsis {X509::hash CERTIFICATE}
        description {Returns the MD5 hash (fingerprint) of the specified X509 certificate.}
        source {https://clouddocs.f5.com/api/irules/X509__hash.html}
        example {when HTTP_REQUEST {
  if { [info exist cert_hash] } {
    if { $cert_hash equals "XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX"} {
      HTTP::redirect "https://somesite/"
    } else {
      HTTP::redirect "https://someothersite/"
    }
  }
}}
        returns {Returns the MD5 hash (fingerprint) of an X509 certificate.}
    }
}

