command TCP::local_port {
    available {f5-irules}
    traits {PURE CSE_CANDIDATE}

    side_effect TcpState -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {TCP::local_port (clientside | serverside)?}

    hover {
        summary {Returns the local port of a TCP connection.}
        synopsis {TCP::local_port (clientside | serverside)?}
        description {Returns the local port/service number of the specified side, or the current context (client or server) if there is no argument.
This command is equivalent to the BIG-IP 4.X variable local_port. When used
in a clientside context, this command returns the client-side TCP
destination port. When used in a serverside context, this command
returns the server-side TCP source port.}
        source {https://clouddocs.f5.com/api/irules/TCP__local_port.html}
        example {when SERVER_CONNECTED {
  # This logs information about the TCP connections on *both* sides of the fullproxy
  set client_remote "[IP::client_addr]:[TCP::client_port]"
  set client_local  "[IP::local_addr clientside]:[TCP::local_port clientside]"
  set server_local  "[IP::local_addr]:[TCP::local_port]"
  set server_remote "[IP::server_addr]:[TCP::server_port]"
  log local0. "Got connection: Client($client_remote)<->($client_local)LTM($server_local)<->($server_remote)Server"
}}
        returns {The local port.}
    }
}

command TCP::lossfilter {
    available {f5-irules}

    side_effect TcpState -reads -writes -side Both

    form Default {TCP::lossfilter TCP_IGNORE_RATE TCP_IGNORE_BURST}

    hover {
        summary {Sets the TCP Loss Ignore Parameters.}
        synopsis {TCP::lossfilter TCP_IGNORE_RATE TCP_IGNORE_BURST}
        description {Sets the maximum size burst loss (in packets) and maximum number of packets per million lost before triggering congestion response.
  * Burst range is valid from 0 to 32. Higher values decrease the
    chance of performing congestion control.
  * Rate range is valid from 0 to 1,000,000. Rate is X packets lost per
    million before congestion control kicks in.}
        source {https://clouddocs.f5.com/api/irules/TCP__lossfilter.html}
        example {when SERVER_CONNECTED {
    log local0. "Client: [client_addr]:[client_port] - Server: [server_addr]:[server_port]."
    # Set client-side loss filter.
    # Ignore up to 150 losses per million packets and burst losses of up to 10 packets.
    clientside {
        TCP::lossfilter 150 10
    }
    # No loss filter on server-side.
    serverside {
        TCP::lossfilter 0 0
    }
}}
        returns {None.}
    }
}

command TCP::lossfilterburst {
    available {f5-irules}

    side_effect TcpState -reads -writes -side Both

    form Default {TCP::lossfilterburst}

    hover {
        summary {Gets the TCP Loss Ignore Burst Parameter.}
        synopsis {TCP::lossfilterburst}
        description {Gets the maximum size burst loss (in packets) before triggering congestion response.
  * Burst range is valid from 0 to 32. Higher values decrease the
    chance of performing congestion control.}
        source {https://clouddocs.f5.com/api/irules/TCP__lossfilterburst.html}
        example {when SERVER_CONNECTED {
    # Set loss filter burst to a maximum of 3
    if { [TCP::lossfilterburst] > 3 } {
        TCP::lossfilter [TCP::lossfilterrate] 3
    }
}}
        returns {TCP Loss Ignore Burst in packets.}
    }
}

command TCP::lossfilterrate {
    available {f5-irules}

    side_effect TcpState -reads -writes -side Both

    form Default {TCP::lossfilterrate}

    hover {
        summary {Gets the TCP Loss Ignore Rate Parameter.}
        synopsis {TCP::lossfilterrate}
        description {Gets the maximum number of packets per million lost before triggering congestion response.
  * Rate range is valid from 0 to 1,000,000. Rate is X packets lost per
    million before congestion control kicks in.}
        source {https://clouddocs.f5.com/api/irules/TCP__lossfilterrate.html}
        example {when SERVER_CONNECTED {
    # Remove loss filter if present
    if { [TCP::lossfilterrate] > 0 } {
        TCP::lossfilter 0 0
    }
}}
        returns {TCP Loss Ignore Rate in packets per million.}
    }
}

command TCP::mss {
    available {f5-irules}

    side_effect TcpState -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {TCP::mss}

    hover {
        summary {Returns the Maximum Segment Size (MSS) for a TCP connection.}
        synopsis {TCP::mss}
        description {Returns the initial connection negotiated MSS. It does not deduct bytes for any common TCP options present in data packets are not deducted. In other words, it is the minimum of the MSS options in the SYN and SYN-ACK packets, or the MSS default of 536 bytes if one packet is missing the option.}
        source {https://clouddocs.f5.com/api/irules/TCP__mss.html}
        example {when HTTP_REQUEST {
  if { [TCP::mss] >= 1280 } {
    COMPRESS::disable
  }
}}
        returns {MSS in bytes.}
    }
}

command TCP::nagle {
    available {f5-irules}

    side_effect TcpState -reads -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {TCP::nagle (enable | disable | auto)}

    hover {
        summary {Toggles the Nagle mode.}
        synopsis {TCP::nagle (enable | disable | auto)}
        description {Enables or disables the Nagle algorithm on the current TCP connection.
Nagle waits for additional data before sending undersized packets, see RFC896 for details.
The auto option enables or disables Nagle based on connection conditions.}
        source {https://clouddocs.f5.com/api/irules/TCP__nagle.html}
        example {# Change the TCP Nagle mode to auto.
when CLIENT_ACCEPTED {
    TCP::nagle auto
}}
        returns {None.}
    }
}

command TCP::naglemode {
    available {f5-irules}

    side_effect TcpState -reads -writes -side Both

    form Default {TCP::naglemode}

    hover {
        summary {Returns setting of Nagle mode.}
        synopsis {TCP::naglemode}
        description {Returns the Nagle mode of a TCP flow.}
        source {https://clouddocs.f5.com/api/irules/TCP__naglemode.html}
        example {# Get the TCP Nagle mode of the TCP flow.
when CLIENT_ACCEPTED {
    log local0. "TCP Nagle mode: [TCP::naglemode]"
}}
        returns {- enabled - disabled - auto}
    }
}

command TCP::naglestate {
    available {f5-irules}

    side_effect TcpState -reads -side Both

    form Default {TCP::naglestate}

    hover {
        summary {Returns current state of Nagle algorithm.}
        synopsis {TCP::naglestate}
        description {If the Nagle mode is "enabled" or "disabled", it returns that mode. If "auto", it returns the current selection of the autotuning.}
        source {https://clouddocs.f5.com/api/irules/TCP__naglestate.html}
        example {# Get the TCP Nagle state of the TCP flow.
when CLIENT_ACCEPTED {
    log local0. "TCP Nagle state: [TCP::naglestate]"
}}
        returns {The string "disabled" or "enabled"}
    }
}

command TCP::notify {
    available {f5-irules}
    arity 1

    side_effect TcpState -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `event_emission_forms` is set on the source spec. The DSL
    #   spells it `event_emission_form {word …} {E …} ?-possible|-async?`,
    #   but a draft records only that the field is set, never the expression
    #   that set it.

    form Default {TCP::notify (request | response | eom)}

    hover {
        summary {Sends a message to upper layers of iRule processing.}
        synopsis {TCP::notify (request | response | eom)}
        description {This command has two uses, which are unrelated to one another:
  1. to indicate the end of a message when TCP message-based load-balancing is in effect;
  2. to raise the USER_REQUEST or USER_RESPONSE event.

The BIG-IP LTM module supports TCP message-based load-balancing. This is enabled by applying an mblb profile to an LTM Virtual Server that also has a tcp profile applied. Note that currently (up to and including 11.4.1), the mblb profile can only be added using tmsh. There is no mechanism for adding it via the Web UI.}
        source {https://clouddocs.f5.com/api/irules/TCP__notify.html}
        example {when CLIENT_ACCEPTED {
        set message_length              0
        set collected_length            0
        set at_msg_start                1

        TCP::collect
}}
        returns {None.}
    }
}

command TCP::offset {
