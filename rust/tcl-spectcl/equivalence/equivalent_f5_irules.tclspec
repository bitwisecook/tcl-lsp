command GTP::header {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    taint_source TAINTED

    option -message -takes MESSAGE -detail {Operate on specific message.}

    form Default {GTP::header <field> ?set|remove? ?-message msg? ?value?}

    hover {
        summary {Allows for the parsing of GTP header information.}
        synopsis {GTP::header ('version' | 'type') ('-message' MESSAGE)?}
        synopsis {GTP::header ('teid' | 'npdu' | 'sequence') ('-message' MESSAGE)?}
        synopsis {GTP::header ('teid' | 'npdu' | 'sequence') 'set' ('-message' MESSAGE)? VALUE}
        synopsis {GTP::header ('teid' | 'npdu' | 'sequence') 'remove' ('-message' MESSAGE)?}
        description {Allows for the parsing of GTP header information. UINT -- Unsigned
integer value of n bits. For n > 8, appropriate network to host byte
order conversion happens transparently.}
        source {https://clouddocs.f5.com/api/irules/GTP__header.html}
        example {when GTP_SIGNALLING_INGRESS {
    log local0. "GTP version [GTP::header version]"
    log local0. "GTP type [GTP::header type]"
}}
    }

    subcommand version {
        arity 0
        detail {Get GTP version.}
        synopsis {GTP::header version ?-message msg?}
        pure
        side_effect NetworkIo -reads -side Both

        option -message -takes MESSAGE -detail {Operate on specific message.}
    }

    subcommand type {
        arity 0
        detail {Get GTP type.}
        synopsis {GTP::header type ?-message msg?}
        pure
        side_effect NetworkIo -reads -side Both

        option -message -takes MESSAGE -detail {Operate on specific message.}
    }

    subcommand npdu {
        detail {Get/set/remove GTP npdu.}
        synopsis {GTP::header npdu ?set|remove? ?-message msg? ?value?}
        pure
        mutator
        side_effect NetworkIo -reads -writes -side Both

        option -message -takes MESSAGE -detail {Operate on specific message.}
    }

    subcommand teid {
        detail {Get/set/remove GTP teid.}
        synopsis {GTP::header teid ?set|remove? ?-message msg? ?value?}
        pure
        mutator
        side_effect NetworkIo -reads -writes -side Both

        option -message -takes MESSAGE -detail {Operate on specific message.}
    }

    subcommand sequence {
        detail {Get/set/remove GTP sequence.}
        synopsis {GTP::header sequence ?set|remove? ?-message msg? ?value?}
        pure
        mutator
        side_effect NetworkIo -reads -writes -side Both

        option -message -takes MESSAGE -detail {Operate on specific message.}
    }

    subcommand extension {
        detail {Access GTP extension headers.}
        synopsis {GTP::header extension ?args?}
        pure
        mutator
        side_effect NetworkIo -reads -writes -side Both

        option -message -takes MESSAGE -detail {Operate on specific message.}
    }
}

command GTP::ie {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    option -message -takes MESSAGE -detail {Operate on a specific GTP message object.}
    option -type -takes TYPE -detail {Filter by IE type value.}
    option -instance -takes INSTANCE -detail {Filter by IE instance.}

    form Default {GTP::ie 'exists' ('-message' MESSAGE)? (IE_PATH)?}

    hover {
        summary {This set of commands allows for the parsing and interpretation of GTP IE elements.}
        synopsis {GTP::ie 'exists' ('-message' MESSAGE)? (IE_PATH)?}
        synopsis {GTP::ie 'count' ('-message' MESSAGE)? ('-type' TYPE)? ('-instance' INSTANCE)? (IE_PATH)?}
        synopsis {GTP::ie 'get' ('instance' | 'length' | 'encode-type' | 'value') ('-message' MESSAGE)? IE_PATH}
        synopsis {GTP::ie 'get' 'list' ('-message' MESSAGE)? ('-type' TYPE)? ('-instance' INSTANCE)? (IE_PATH)?}
        description {This set of commands allows for the parsing and interpretation of GTP
IE elements.}
        source {https://clouddocs.f5.com/api/irules/GTP__ie.html}
        example {when GTP_SIGNALLING_INGRESS {
    if { [GTP::ie exists imsi:0] } {
        log local0. "GTP imsi [GTP::ie get value imsi:0]"
    }
    log local0. "Total number of top level IEs [GTP::ie count]"
    set ie_list [ GTP::ie get list]
    foreach ie $ie_list {
        log local0. "IE $ie"
    }
}}
    }
}

