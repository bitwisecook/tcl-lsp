command serverside {
    available {f5-irules}
    traits IS_SIDE_SWITCH
    arity ..1

    arg 0 -role Body

    side_effect ConnectionControl -reads -side Server

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `side_switch_target` is set on the source spec. The DSL
    #   spells it `side_switch_target Client|Server`, but a draft records only
    #   that the field is set, never the expression that set it.

    form Default {serverside (NESTING_SCRIPT)?}

    hover {
        summary {Causes the specified iRule command to be evaluated under the server-side context.}
        synopsis {serverside (NESTING_SCRIPT)?}
        description {Causes the specified iRule command or commands to be evaluated under the server-side context. This command has no effect if the iRule is already being evaluated under the server-side context. If there is no argument, the command returns 1 if the current event is in the serverside context or 0 if not.}
        source {https://clouddocs.f5.com/api/irules/serverside.html}
        example {when CLIENT_ACCEPTED {

   # Check if the server (pool member) IP address is 10.1.1.80
   # [serverside {IP::remote_addr}] is equivalent to [IP::server_addr]
   if { [IP::addr [serverside {IP::remote_addr}] equals 10.1.1.80] } {

      # Do something like drop the packets in this example
      discard
   }
}}
        returns {serverside Returns 1 if the current event is in the serverside context or 0 if not.}
    }
}

command session {
    available {f5-irules}

    side_effect PersistenceTable -reads -writes -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {session add SESSION_MODE}

    hover {
        summary {Utilizes the persistence table to store arbitrary information based on the same keys as persistence.}
        synopsis {session add SESSION_MODE}
        synopsis {session (lookup | delete) SESSION_MODE}
        description {Utilizes the persistence table to store arbitrary information based on
the same keys as persistence. This information does not affect the
persistence itself.}
        source {https://clouddocs.f5.com/api/irules/session.html}
        example {when HTTP_REQUEST {
set value [session lookup uie [list $myVar any virtual]]
}}
    }

    subcommand add { mutator ; side_effect PersistenceTable -writes -side Client }
    subcommand lookup { pure ; side_effect PersistenceTable -reads -side Client }
    subcommand delete { mutator ; side_effect PersistenceTable -writes -side Client }
    subcommand count { pure ; side_effect PersistenceTable -reads -side Client }
}

command set {
    available {tcl 8.4-} {f5-irules}
    traits {BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME FIRST_ARG_VARNAME}
    arity 1..2

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role VarRead
    assigns_variable_at 0

    lowering_hook -native Set
    codegen_hook -native Set
    inline_codegen_hook -native Set
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -reads -writes
    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    runtime_backing shipped-builtin set

    binds_handle {-name-from {Word 0} -class-from {ConstructionValue 1}}

    form Default {set varName ?value?}

    hover {
        summary {Read the value of a variable, or set it to a new value.}
        synopsis {set varName ?value?}
        description {With one argument, returns varName's current value — an error if it has never been set. With two, assigns value to varName, creating the variable if it doesn't already exist, and returns that same value. varName names an array element when written as arrayName(index); the index may itself come from variable or command substitution. varName can also be produced by substitution itself, so `set out [set $vbl]` reads whichever variable vbl currently names — Tcl's own documentation notes arrays are usually the cleaner alternative to this kind of double-dereferencing. Scope resolution depends on context: inside a procedure, an unqualified varName is a local or parameter unless previously declared via global, variable, or upvar; outside a procedure, or when varName is namespace-qualified, it resolves as a namespace variable instead. At namespace scope, Tcl 8.4 through 8.6 fall back to a same-named variable in the global namespace (never an intermediate enclosing namespace) when the current namespace has none; Tcl 9.0 and later require an exact match in the current namespace, with no global fallback.}
        source {Tcl set(n)}
        example {set r [expr {rand()}]
set anAry(msg) "Hello, World!"

# Array element addressed by a variable-held index
set elemName "msg"
set anAry($elemName) "Hello, World!"

# Indirection: read the variable named by the current value of vbl
set in0 "small random"
set in1 "large random"
set vbl in[expr {rand() >= 0.5}]
set out [set $vbl]}
        returns {varName's new value when value is given, otherwise its current value.}
    }

    refine read {
        arity 1
        arg 0 -role VarRead
        side_effect Variable -reads
    }

    refine write {
        arity 2
        arg 0 -role VarWrite
        side_effect Variable -writes
    }
}

command sha1 {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    form Default {sha1 ANY_CHARS}

    hover {
        summary {Returns the SHA version 1.0 message digest of the specified string.}
        synopsis {sha1 ANY_CHARS}
        description {Returns the Secure Hash Algorithm version 1.0 (SHA1) message digest of the specified string, or if an error occurs, an empty string. Used to ensure data integrity.}
        source {https://clouddocs.f5.com/api/irules/sha1.html}
        example {when HTTP_REQUEST {
    binary scan [sha1 [HTTP::host]] w1 key

    set key [expr {$key & 1}]
    switch $key {
        0 { pool my_pool member 1.2.3.4:80 }
        1 { pool my_pool member 5.6.7.8:80 }
    }
}}
        returns {sha1 <string> Returns the Secure Hash Algorithm version 1.0 (SHA1) message digest of the specified string, or if an error occurs, an empty string.}
    }
}

