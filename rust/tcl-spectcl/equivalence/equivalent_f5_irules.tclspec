command http_client_ip {
    available {f5-irules}
    arity ..1

    side_effect HttpHeader -reads -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {http_client_ip ?xff_header_name?}

    hover {
        summary {Return the first IP address from X-Forwarded-For (or a named header), otherwise the L3 client IP address.}
        synopsis {call http_client_ip}
        synopsis {call http_client_ip "True-Client-IP"}
        description {Returns the first valid, non-loopback IP from the specified forwarding header (default `X-Forwarded-For`), falling back to `IP::client_addr` when no suitable address is found.

HTTP headers are case-insensitive, so `x-forwarded-for` == `X-FORWARDED-FOR` == `X-Forwarded-For`.

For a client `9.9.9.9` with headers `X-Forwarded-For: 1.1.1.1,2.2.2.2` and `X-Forwarded-For: 3.3.3.3,4.4.4.4`, returns `1.1.1.1`.  With no forwarding header, returns `9.9.9.9`.

Uses `catch {clientside {HTTP::version}}` as a lightweight `HTTP::has_responded` equivalent compatible with TMOS < 14.1.

Loopback / zero addresses filtered out:
  - `127.0.0.0/8`
  - `0.0.0.0/32`
  - `::/127`}
        source {https://clouddocs.f5.com/api/irules/http_client_ip.html}
        example {when HTTP_REQUEST priority 500 {
    # Rate-limit by real client IP
    table set pfx-[call http_client_ip] 1 180 180
}

# Use a custom header name
when HTTP_REQUEST priority 500 {
    table set pfx-[call http_client_ip True-Client-IP] 1 180 180
}}
        returns {A single IP address string.}
    }
}

command http_content_len_max {
    available {f5-irules}
    arity ..1

    side_effect HttpBody -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {http_content_len_max ?max_size?}

    hover {
        summary {Return the HTTP Content-Length up to a maximum size (default 1024), or reject if the header is not a valid integer.}
        synopsis {call http_content_len_max}
        synopsis {call http_content_len_max 8192}
        description {Returns the `Content-Length` header value clamped to *size* (default 1024).

  - `Content-Length: 512` → returns `512`
  - `Content-Length: 2048` with default size → returns `1024`
  - `Content-Length: 2048` with size `8192` → returns `2048`
  - No `Content-Length` header → returns the empty string
  - Non-integer `Content-Length` (RFC 2616 Section 14.13 violation) → calls `reject`}
        source {https://clouddocs.f5.com/api/irules/http_content_len_max.html}
        example {# Collect up to the default 1024 bytes
when HTTP_REQUEST priority 500 {
    HTTP::collect [call http_content_len_max]
}

# Collect up to 8192 bytes
when HTTP_REQUEST priority 500 {
    HTTP::collect [call http_content_len_max 8192]
}}
        returns {The effective Content-Length (clamped to *size*), the empty string if no header is present, or the connection is rejected.}
    }
}

