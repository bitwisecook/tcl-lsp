    hover {
        summary {Decodes the specified string using HTTP URI encoding.}
        synopsis {decode_uri ANY_CHARS}
        description {Decodes the specified string using HTTP URI encoding per RFC2616 and
returns the result. This is a BIG-IP 4.x variable, provided for
backward-compatibiliy. You can use the equivalent 9.X commmand
URI::decode instead.}
        source {https://clouddocs.f5.com/api/irules/decode_uri.html}
    }
}

command discard {
    available {f5-irules}
    traits DIAGRAM_ACTION

    irules_source_flow DropsConnection
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.

    side_effect ConnectionControl -writes -side Both
    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {discard}

    hover {
        summary {Causes the current packet or connection to be dropped/discarded.}
        synopsis {discard}
        description {Causes the current packet or connection (depending on the context of
the event) to be dropped/discarded and the rule continues (no implied
return). This command is identical to drop.

**Warning**: After `discard`, the current iRule continues executing,
and other iRules and later priorities in this event also run. This
can cause TCL errors. Always follow `discard` with `event disable
all` and `return`.}
        source {https://clouddocs.f5.com/api/irules/discard.html}
        example {when HTTP_REQUEST {
  if { [IP::addr [IP::client_addr] equals 10.1.1.80] } {
    discard
    event disable all
    return
  }
}}
    }
}

