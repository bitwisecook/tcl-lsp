command MQTT::topic {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {MQTT::topic ?subcommand? ?args?}

    hover {
        summary {Manipulate topic(s) of MQTT message.}
        synopsis {MQTT::topic ?subcommand? ?args?}
        synopsis {MQTT::topic replace <new_topic> ?index?}
        synopsis {MQTT::topic count}
        description {This command can be used to manipulate topic(s) of MQTT message.
This command is valid only for following MQTT message types:

    PUBLISH
    SUBSCRIBE
    UNSUBSCRIBE}
        source {https://clouddocs.f5.com/api/irules/MQTT__topic.html}
        example {when MQTT_SERVER_INGRESS {
    set smtype [MQTT::type]
    if {$smtype == "SUBACK"} {
       set mid [MQTT::packet_id]
       set tc [table lookup -subtable "packetid_count_table" "[client_addr]_[client_port]_${mid}"]
       set return_codes [MQTT::return_code_list]
       set return_codes [lreplace $return_codes $tc $tc]
       MQTT::replace type SUBACK packet_id $mid return_code_list $return_codes
    }
}}
        returns {When called without an argument, this command returns the topic-name of MQTT PUBLISH message, or the topic-name of the first topic of MQTT SUBSCRIBE and UNSUBSCRIBE messages.}
    }

    subcommand replace {
        arity 1..2
        detail {Replace topic name.}
        synopsis {MQTT::topic replace <topic> ?index?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand count {
        arity 0
        detail {Get topic count.}
        synopsis {MQTT::topic count}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand list {
        arity 0
        detail {List all topics.}
        synopsis {MQTT::topic list}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand index {
        arity 1
        detail {Get topic at index.}
        synopsis {MQTT::topic index <n>}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand qos {
        arity ..1
        detail {Get/set topic QoS.}
        synopsis {MQTT::topic qos ?index?}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand add {
        arity 1..2
        detail {Add a topic.}
        synopsis {MQTT::topic add <topic> ?qos?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand delete {
        arity 1
        detail {Delete a topic.}
        synopsis {MQTT::topic delete <index>}
        mutator
