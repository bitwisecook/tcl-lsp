command b64encode {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    form Default {b64encode ANY_CHARS}

    hover {
        summary {Returns a string that is base-64 encoded, or if an error occurs, an empty string.}
        synopsis {b64encode ANY_CHARS}
        description {Returns a string that is base-64 encoded, or if an error occurs, an empty string.}
        source {https://clouddocs.f5.com/api/irules/b64encode.html}
        example {when RULE_INIT {
    set ::key [AES::key]
}}
        returns {b64encode <string> Returns a string that is base-64 encoded, or if an error occurs, an empty string.}
    }
}

command binary {
    available {tcl 8.4-} {f5-irules}
    traits {CSE_CANDIDATE BYTE_COMPILED FRAME_HASH_BUILTIN}
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect Variable -writes

    runtime_backing shipped-builtin binary

    form Default {binary format formatString ?arg arg ...?}
    form Default {binary scan string formatString ?varName varName ...?}
    form Default {binary encode format ?-option value ...? data} -available {tcl 8.6-}
    form Default {binary decode format ?-option value ...? data} -available {tcl 8.6-}

    hover {
        summary {Manipulate binary data}
        synopsis {binary format formatString ?arg arg ...?}
        synopsis {binary scan string formatString ?varName varName ...?}
        synopsis {binary encode format ?-option value ...? data}
        synopsis {binary decode format ?-option value ...? data}
        synopsis {binary subcommand ?arg ...?}
        description {This command provides facilities for manipulating binary data. format builds a binary string from Tcl values and scan parses one back out into variables; both walk an imaginary cursor through the data driven by a shared formatString mini-language of type-count field specifiers (a/A/b/B/h/H/c/s/S/i/I/w/W/f/d/x/X/@, plus t/n/m native-byte-order and r/R/q/Q little/big-endian float forms since 8.5). encode and decode instead convert to and from a text encoding (base64, hex, or uuencode) and were added in Tcl 8.6. A Tcl "binary string" is simply one whose characters are all in the range \u0000-\u00FF.}
        source {Tcl man page binary.n}
        example {set packed [binary format c3 {72 105 33}]
binary scan $packed c3 codes
# codes is now "72 105 33"

set hex [binary encode hex $packed]
set back [binary decode hex $hex]
# back is again the 3-byte binary string}
        returns {format, encode, and decode return the newly built value (format/decode a byte array, encode a text string); scan returns the number of variables it successfully set.}
    }

    subcommand decode {
        arity 2..
        detail {Decode base64/hex/uuencode-encoded text back into a binary string.}
        synopsis {binary decode format ?-option value ...? data}
        available {tcl 8.6-}
        return_type ByteArray
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
        arg 1 -type String
        arg 0 -values-from binary-decode-arg0 -closed

        option -strict \
            -detail {Raise an error on input that deviates from the encoding instead of silently tolerating it: a non-base64 character for base64, whitespace for hex, or a non-standard line for uuencode.}
        # TODO(spectcl): `nested_native_compilation` is set on the source spec.
        #   The DSL spells it `sub_subcommand NAME -native_compilation
        #   CONTRACT`, but a pack may not author this field.
        sub_subcommand hex
        # TODO(spectcl): `nested_native_compilation` is set on the source spec.
        #   The DSL spells it `sub_subcommand NAME -native_compilation
        #   CONTRACT`, but a pack may not author this field.
        sub_subcommand base64
        # TODO(spectcl): `nested_native_compilation` is set on the source spec.
        #   The DSL spells it `sub_subcommand NAME -native_compilation
        #   CONTRACT`, but a pack may not author this field.
        sub_subcommand uuencode
    }

    subcommand encode {
        arity 2..
        detail {Encode binary data as base64, hex, or uuencode text.}
        synopsis {binary encode format ?-option value ...? data}
        available {tcl 8.6-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
        #   spells it `successful_handler -native
        #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
        #   -direct-provider
        #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
        #   but a pack may not author this field.
        byte_array_effect {Rebinarifies 1}
        pure
        arg 1 -type ByteArray -shimmers
        arg 0 -values-from binary-decode-arg0 -closed

        option -maxlen -takes length -integer Any \
            -detail {Split the output into lines of at most length characters. Ignored for hex. base64: unlimited by default (no splitting). uuencode: 5-85, default 61.}
        option -wrapchar -takes character \
            -detail {Line separator used when -maxlen splits the output. Ignored for hex. base64: any character, default "\n". uuencode: zero or more of tab/VT/FF/CR followed by an optional newline, default a single newline.}
        # TODO(spectcl): `nested_native_compilation` is set on the source spec.
        #   The DSL spells it `sub_subcommand NAME -native_compilation
        #   CONTRACT`, but a pack may not author this field.
        sub_subcommand hex {}
        # TODO(spectcl): `nested_native_compilation` is set on the source spec.
        #   The DSL spells it `sub_subcommand NAME -native_compilation
        #   CONTRACT`, but a pack may not author this field.
        sub_subcommand base64
        # TODO(spectcl): `nested_native_compilation` is set on the source spec.
        #   The DSL spells it `sub_subcommand NAME -native_compilation
        #   CONTRACT`, but a pack may not author this field.
        sub_subcommand uuencode
    }

    subcommand format {
        arity 1..
        detail {Build a binary string from Tcl values, laid out by a cursor-driven format specification.}
        synopsis {binary format formatString ?arg ...?}
        return_type ByteArray
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
        #   spells it `successful_handler -native
        #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
        #   -direct-provider
        #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
        #   but a pack may not author this field.
        format_string_type Binary
        pure
        arg 0 -role FormatString -type String
        # TODO(spectcl): `completion` is set on the source spec. The DSL spells
        #   it `completion {CODE …}`, but a draft records only that the field
        #   is set, never the expression that set it.
    }

    subcommand scan {
        arity 2..
        detail {Parse fields out of a binary string into variables, using a cursor-driven format specification. Returns the number of variables successfully set.}
        synopsis {binary scan string formatString ?varName ...?}
        traits CONDITIONAL_VARIABLE_WRITE
        return_type Int
        var_write_typing Destructured
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
        #   spells it `successful_handler -native
        #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
        #   -direct-provider
        #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
        #   but a pack may not author this field.
        byte_array_effect {Rebinarifies 0}
        format_string_type Binary
        arg 0 -type ByteArray -shimmers
        arg 1 -type String
        arg_role_count_resolver -native binary::scan::arg_role_count_resolver
        arg_role_resolver_roles {ScanFormat VarWrite}
    }
}

command break {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD NEEDS_START_CMD BYTE_COMPILED FRAMELESS_RUNTIME TRANSFERS_CONTROL BREAKS_LOOP}
    arity 0

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    inline_codegen_hook -native Break
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin break

    form Default {break}

    hover {
        summary {Abort execution of the innermost enclosing loop.}
        synopsis {break}
        description {Typically invoked inside the body of a looping command such as for, foreach, or while. It raises a TCL_BREAK exception that aborts the current script out to the innermost containing loop, which then stops iterating and returns normally — execution resumes with the statement after the loop. The exception is also handled by catch, Tk event bindings, and the outermost script of a procedure body. Used anywhere else — outside a loop, catch, Tk binding, or a procedure's top level — it is an error: invoked "break" outside of a loop.}
        source {Tcl man page break.n}
        example {for {set i 0} {$i < 10} {incr i} {
    if {$i == 5} {
        break
    }
    puts $i
}}
        returns {None in normal use — control transfers to just past the innermost enclosing loop. Trapped with catch, the caught value is an empty string.}
    }
}

command call {
    available {f5-irules}
    traits INVOKES_USER_PROC
    arity 1..

    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.

    arg_role_resolver -native call::arg_role_resolver
    arg_role_resolver_roles Name

    side_effect ProcDefinition -reads -side Global

    option -debug -detail {Enable debug mode.}

    form Default {call ?-debug? <proc_name> ?arg ...?}

    hover {
        summary {Calls an iRule procedure.}
        synopsis {call ?-debug? <proc_name> ?arg ...?}
        description {iRule procedures:
    - Are similar to procedures, functions, subroutines from other languages
    - Allow for reuse of common code
        - Reference the same code from multiple locations, but only define it in one place
        - Simplifies code maintenance
    - Allow you to augment the predefined iRule commands

Procedures are defined with the proc statement. This must be done
outside of any event. Procedures can be defined within an iRule
assigned to a virtual server or in a separate iRule not assigned to
any virtual server.

Call a local proc (defined in the same iRule) without a namespace prefix:
    call my_proc $args

To reference a proc in another iRule in the same partition, prefix with
the iRule name:
    call other_rule::my_proc $args

To reference a proc in another partition:
    call /other_partition/other_rule::procname args}
        source {https://clouddocs.f5.com/api/irules/call.html}
        example {when RULE_INIT {
    # Call a proc which returns no values
    call proc_rule::printArguments one two three

    # Save the return value of a proc
    set return_values [call proc_rule::returnArguments one two three]
}}
        returns {Returns the value(s) that return (if any).}
    }
}

command case {
    available {tcl 8.4-9.0} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD NEVER_INLINE_BODY NOT_PROC_FACTORY}
    arity 2..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    arg_role_resolver -native case::arg_role_resolver
    arg_role_resolver_roles Body
    lowering_hook -native Switch
    analyser_hook -native Switch

    side_effect Unknown -reads -writes

    deprecated_replacement switch

    # TODO(spectcl): `case_list` is set on the source spec. The DSL spells it
    #   `case_list NAME|{ … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    form Default {case string ?in? patList body ?patList body ...?}
    form Default {case string ?in? {patList body ?patList body ...?}}

    hover {
        summary {Obsolete glob-pattern branching — use `switch` instead.}
        synopsis {case string ?in? patList body ?patList body ...?}
        synopsis {case string ?in? {patList body ?patList body ...?}}
        description {Matches string against each patList in turn and evaluates the body of the first one that matches, returning that body's result. Each patList is a single pattern or a list of patterns, and each pattern may use the wild-cards `string match` accepts. A patList of `default` matches unconditionally; with no match and no default, `case` returns the empty string. The patterns and bodies may be given as separate words, where substitutions apply normally, or grouped into one braced argument, which is convenient for multi-line commands but performs no command or variable substitution on the patterns — so the two forms can behave differently. An optional literal `in` may follow string. `case` is obsolete: it has been supported only for backward compatibility since Tcl 7.0 and was removed in Tcl 9.0. `switch` replaces it, but not as a plain rename — `switch` has no `in` word and takes `-exact`/`-glob`/`-regexp`/`--` options, so a subject that can begin with `-` needs `--` and glob matching needs `-glob`.}
        source {Tcl case(n)}
        example {case $x in {a  {puts one}  b  {puts two}}

case $x {
    a       { puts one }
    b       { puts two }
    default { puts other }
}

# The Tcl 8.5+/9.x replacement
switch -glob -- $x {
    a       { puts one }
    b       { puts two }
    default { puts other }
}}
        returns {The result of the matched body, or an empty string when no patList matches and there is no default clause.}
    }
}

command catch {
    available {tcl 8.4} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD UNCONDITIONAL_VARIABLE_WRITE BYTE_COMPILED NOT_PROC_FACTORY}
    arity 1..2
    arity 1..2 -retired 8.5
    arity 1..3 -introduced 8.5

    return_type Int
    var_write_typing Destructured
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Body
    arg 1 -role VarWrite

    clause_grammar {
        head Body -timing protected
        tail {{LoopVarList optional} {LoopVarList optional}}
        selection all
    }

    lowering_hook -native Catch
    inline_codegen_hook -native Catch
    analyser_hook -native Catch

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin catch

    form Default {catch script ?resultVarName? ?optionsVarName?} -available {tcl 8.5-}
    form Default {catch script ?varName?} -available {{tcl 8.4} {f5-irules}}

    hover {
        summary {Evaluate script and trap exceptional returns}
        synopsis {catch script ?resultVarName? ?optionsVarName?}
        description {Evaluates script in the caller's own variable scope and always completes normally, even when script raises an error — a single unguarded error never aborts the surrounding script. The integer catch returns is script's completion code: 0 (TCL_OK) for normal completion, 1 (TCL_ERROR) for an error, 2 (TCL_RETURN) if script executed return, 3 (TCL_BREAK) for break, 4 (TCL_CONTINUE) for continue, or a larger custom code set via `return -code`. When resultVarName is given, it is set to script's result on success or to the error message on failure. From Tcl 8.5, an optional third word, optionsVarName, receives a dict of the return options: -code and -level are always present, and on an error -errorinfo, -errorcode, and -errorline are added too — joined by -errorstack from Tcl 8.6 onward. Tcl 8.4's catch takes only the single result variable (there named varName) and has no options dict; iRules' embedded Tcl 8.4.6 runtime follows that same two-argument form. Only run-time errors are trapped: a syntax error Tcl finds while compiling script itself (e.g. unmatched braces) is not caught.}
        source {Tcl man page catch.n}
        example {if {[catch {open $someFile w} fid]} {
    puts stderr "Could not open $someFile for writing\n$fid"
    exit 1
}
if {[catch {expr {1 / 0}} result options]} {
    puts "error: $result (code [dict get $options -code])"
}}
        returns {An integer completion code — 0 (TCL_OK) through 4 (TCL_CONTINUE) for the standard completion codes, or a larger custom code set via `return -code`.}
    }
}

command check {
    available {f5-irules}

    side_effect BigipConfig -reads -side Global

    form Default {check}

    hover {
        summary {Set the iRule validation level.}
        synopsis {check}
        description {Set the iRule validation level: - none: disable the validation.}
        source {https://clouddocs.f5.com/api/irules/check.html}
    }
}

command class {
    available {f5-irules}
    traits DIAGRAM_ACTION

    side_effect DataGroup -reads -side Global

    option -all -detail {Return all matches.}
    option -value -detail {Return value instead of name.}
    option -name -detail {Return name.}
    option -index -detail {Return index.}
    option -element -detail {Return full element.}
    option -nocase -detail {Case-insensitive comparison.}
    option -list -detail {Return value always as a list.}

    form Default {class <subcommand> ?options? ?--? args...}

    hover {
        summary {Advanced access of classes.}
        synopsis {class 'match' (((CLASS_SEARCH_OPTION) ('-all'))#)? ('--')? ITEM CLASS_OPERATOR CLASS_OBJ}
        synopsis {class match attempts to match the provided <item> to an element in <class> by applying the <operator> to the <item>.}
        synopsis {class match [HTTP::uri] ends_with image_class}
        description {The class command, implemented in v10.0.0, allows you to query data groups and data group properties.

These commands work for both internal (defined in the bigip.conf) and external (custom file) data groups. Internal data groups were not able to make use of the name/value pairing with the := separator until version 10.1. As of 10.1 all classes support the name/value pairing.

The class command deprecates the findclass and matchclass commands as it offers better functionality and performance than the older commands.}
        source {https://clouddocs.f5.com/api/irules/class.html}
        example {when LB_FAILED {
      HTTP::respond 200 content [b64decode [class element -value 0 img]] "Content-Type" "image/png"
   }}
    }

    subcommand match {
        detail {Match an item against a data group.}
        synopsis {class match ?options? ?--? <item> <operator> <class>}
        pure
        source_configuration_reference DataGroupComparison

        option -all -detail {Return all matches.}
        option -value -detail {Return value instead of name.}
        option -name -detail {Return name.}
        option -index -detail {Return index.}
        option -element -detail {Return full element.}
        option -nocase -detail {Case-insensitive comparison.}
        option --
    }

    subcommand search {
        detail {Search a data group for an item.}
        synopsis {class search ?options? ?--? <class> <operator> <item>}
        pure

        option -all -detail {Return all matches.}
        option -value -detail {Return value instead of name.}
        option -name -detail {Return name.}
        option -index -detail {Return index.}
        option -element -detail {Return full element.}
        option -nocase -detail {Case-insensitive comparison.}
        option --
    }

    subcommand lookup {
        arity 2
        detail {Return the value paired with a name.}
        synopsis {class lookup <name> <class>}
        pure
        source_configuration_reference DataGroupLookup
    }

    subcommand element {
        arity 2
        detail {Return an element by index.}
        synopsis {class element ?-value|-name? ?--? <index> <class>}
        pure

        option -value -detail {Return value instead of name.}
        option -name -detail {Return name.}
        option --
    }

    subcommand type {
        arity 1
        detail {Return the data type of a data group.}
        synopsis {class type <class>}
        pure
    }

    subcommand exists {
        arity 1
        detail {Check if a data group exists.}
        synopsis {class exists <class>}
        pure
    }

    subcommand size {
        arity 1
        detail {Return the number of elements.}
        synopsis {class size <class>}
        pure
    }

    subcommand names {
        arity 1..2
        detail {Return list of data group names.}
        synopsis {class names ?-nocase? ?-list? ?--? <class> ?pattern?}
        pure

        option -nocase -detail {Case-insensitive comparison.}
        option -list -detail {Return value always as a list.}
        option --
    }

    subcommand get {
        arity 1..2
        detail {Return all elements as a list.}
        synopsis {class get ?-nocase? ?-list? ?--? <class> ?pattern?}
        pure

        option -nocase -detail {Case-insensitive comparison.}
        option -list -detail {Return value always as a list.}
        option --
    }

    subcommand startsearch { arity 1 ; detail {Begin iterating over a data group.} ; synopsis {class startsearch <class>} }

    subcommand nextelement {
        arity 2
        detail {Get next element during iteration.}
        synopsis {class nextelement ?options? ?--? <class> <search_id>}

        option -index -detail {Return index instead of element.}
        option -value -detail {Return value instead of name.}
        option -element -detail {Return name and value as one element.}
        option -list -detail {Always return a list.}
        option -name -detail {Return name.}
        option --
    }

    subcommand anymore {
        arity 2
        detail {Check if more elements remain.}
        synopsis {class anymore <class> <search_id>}
        pure
    }

    subcommand donesearch { arity 2 ; detail {End a data group iteration.} ; synopsis {class donesearch <class> <search_id>} }
}

