command URI::basename {
    available {f5-irules}

    side_effect HttpUri -reads -side Global

    taint_source TAINTED

    form Default {URI::basename URI_STRING}

    hover {
        summary {Extracts the basename part of a given uri string.}
        synopsis {URI::basename URI_STRING}
        description {Extracts the basename part of a given uri string.
For the following URI:
/main/index.jsp?user=test&login=check

The basename is:

index.jsp}
        source {https://clouddocs.f5.com/api/irules/URI__basename.html}
        example {when HTTP_REQUEST {
  set base [URI::basename [HTTP::uri]]
  log local0. "Basename of uri [HTTP::uri] is $base"
}}
        returns {Return the basename part of a given uri string.}
    }
}

command URI::compare {
    available {f5-irules}

    side_effect HttpUri -reads -side Global

    form Default {URI::compare URI_STRING URI_STRING}

    hover {
        summary {Compares two URI's for equality.}
        synopsis {URI::compare URI_STRING URI_STRING}
        description {Compares two URI's as recommended by RFC2616 section 3.2.3.

3.2.3 URI Comparison

   When comparing two URIs to decide if they match or not, a client
   SHOULD use a case-sensitive octet-by-octet comparison of the entire
   URIs, with these exceptions:

      - A port that is empty or not given is equivalent to the default
        port for that URI-reference;

        - Comparisons of host names MUST be case-insensitive;

        - Comparisons of scheme names MUST be case-insensitive;

        - An empty abs_path is equivalent to an abs_path of "/".}
        source {https://clouddocs.f5.com/api/irules/URI__compare.html}
        example {when HTTP_REQUEST {
  set uri_to_check "/dir1/somepath"
  if { [URI::compare [HTTP::uri] $uri_to_check] } {
    log local0. "URI's are equal!"
  }
}}
        returns {Returns 1 if URIs match; 0 otherwise.}
    }
}

command URI::decode {
    available {f5-irules}
    traits IS_UNESCAPE

    side_effect HttpUri -reads -side Global

    form Default {URI::decode URI_STRING}

    hover {
        summary {Returns a decoded version of a given URI.}
        synopsis {URI::decode URI_STRING}
        description {Returns a URI decoded version of a given URI.
For details on URI encoding, see RFC3986, section 2.1. Percent-Encoding.

This command is equivalent to the BIG-IP 4.X variable decode_uri.}
        source {https://clouddocs.f5.com/api/irules/URI__decode.html}
        example {when HTTP_REQUEST {
  log local0. "The decoded version of \"[HTTP::query]\" is \"[URI::decode [HTTP::query]]\""
}}
        returns {Returns a decoded version of a given URI.}
    }
}

command URI::encode {
    available {f5-irules}

    side_effect HttpUri -reads -side Global

    taint_transform {CRLF_FREE URL_ENCODED}
    taint_double_encode_colour URL_ENCODED

    form Default {URI::encode URI_STRING}

    hover {
        summary {Returns an encoded version of a given URI.}
        synopsis {URI::encode URI_STRING}
        description {Returns the encoded version of the given URI.
For details on URI encoding, see RFC3986, section 2.1. Percent-Encoding.

This command is equivalent to the BIG-IP 4.X variable encode_uri.}
        source {https://clouddocs.f5.com/api/irules/URI__encode.html}
        example {when HTTP_REQUEST {
  set my_parameter_value "my URL encoded parameter value with metacharacters (&*@#[])"
  log local0. "The encoded version of \"$my_parameter_value\" is \"[URI::encode $my_parameter_value]\""
  HTTP::redirect "/path?parameter=[URI::encode $my_parameter_value]"
}}
        returns {Returns an encoded version of a given URI.}
    }
}

command URI::encode_component {
    available {f5-irules}

    taint_transform {CRLF_FREE URL_ENCODED}
    taint_double_encode_colour URL_ENCODED

    form Default {URI::encode_component STRING}

    hover {
        summary {Percent-encodes a single URI component.}
        synopsis {URI::encode_component STRING}
        description {Percent-encodes a single URI component (path segment, query
parameter name or value, fragment, etc.) according to RFC 3986
section 2.1.  Unlike ``URI::encode`` this encodes every
reserved delimiter (``/``, ``?``, ``&``, ``=``, …) so the
result is safe to embed inside a larger URI without altering
its structure.}
        source {https://clouddocs.f5.com/api/irules/URI__encode.html}
        example {when HTTP_REQUEST {
  set value "key=value&other"
  HTTP::uri "/search?q=[URI::encode_component $value]"
}}
        returns {Returns a percent-encoded string.}
    }
}

command URI::escape {
    available {f5-irules}

    taint_transform {CRLF_FREE URL_ENCODED}
    taint_double_encode_colour URL_ENCODED

    form Default {URI::escape URI_STRING}

    hover {
        summary {Percent-encodes a URI string (alias for URI::encode).}
        synopsis {URI::escape URI_STRING}
        description {Percent-encodes *URI_STRING* according to RFC 3986.
This is an alias for ``URI::encode``.}
        source {https://clouddocs.f5.com/api/irules/URI__encode.html}
        returns {Returns a percent-encoded URI string.}
    }
}

