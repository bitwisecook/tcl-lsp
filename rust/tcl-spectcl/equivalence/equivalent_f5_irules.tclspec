command SCTP::respond {
    available {f5-irules}

    side_effect TcpState -writes -side Both

    form Default {SCTP::respond (PAYLOAD_DATA (PAYLOAD_OFFSET)? (PAYLOAD_LENGTH)?)}

    hover {
        summary {Sends the specified data directly to the peer.}
