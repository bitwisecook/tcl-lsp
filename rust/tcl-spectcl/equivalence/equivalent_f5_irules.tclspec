        synopsis {STREAM::expression EXPRESSION}
        description {Replaces the stream expression in the Stream profile with the specified
value. The syntax is identical to the profile syntax.
Note that this change affects this connection only and is sticky
for the duration of the connection.}
        source {https://clouddocs.f5.com/api/irules/STREAM__expression.html}
        example {when HTTP_REQUEST {
   # Disable the stream filter for all requests
   STREAM::disable
}}
    }
}

command STREAM::match {
    available {f5-irules}

    side_effect StreamProfile -reads -side Both

