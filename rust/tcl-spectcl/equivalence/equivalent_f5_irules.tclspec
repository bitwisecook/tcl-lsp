}

command POP3::activation_mode {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {POP3::activation_mode (none | allow | require)?}

    hover {
        summary {Set the activation mode.}
        synopsis {POP3::activation_mode (none | allow | require)?}
        description {Sets the activation mode to none (it will never activate), allow (if the POP3 client sends STARTTLS, we will activate TLS), or require (all commands will be rejected until STARTTLS is received).}
        source {https://clouddocs.f5.com/api/irules/POP3__activation_mode.html}
        example {when CLIENT_ACCEPTED {
                if { !([IP::addr [IP::client_addr] ne 10.0.0.0/8) } {
                    POP3::activation_mode require
                }
            }}
    }
}

