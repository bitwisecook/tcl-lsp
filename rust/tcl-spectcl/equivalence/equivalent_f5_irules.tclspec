    #   field is set, never the expression that set it.

    deprecated_replacement {(removed)}

    form Default {WAM::enable}

    hover {
        summary {Enables Web Accelerator plugin processing on the connection.}
        synopsis {WAM::enable}
        description {Enables the WAM plugin for the current TCP connection. WAM will remain
enabled on the current TCP connection until it is closed or
WAM::disable is called.}
        source {https://clouddocs.f5.com/api/irules/WAM__enable.html}
        example {# Disable WAM for HTTP paths ending in .php
when HTTP_REQUEST {
  WAM::enable
  if { [HTTP::path] ends_with ".php" } {
    WAM::disable
  }
}}
    }
}

command WEBSSO::disable {
    available {f5-irules}

    side_effect ApmState -writes -side Both

