For the following URL:
http://www.example.com:8080/main/index.jsp?user=test&login=check
The URI is: /main/index.jsp?user=test&login=check

Note that in the HTTP_PROXY_REQUEST event, this command returns the complete
proxy URI. This includes the scheme, host and port, and thus the result would be:
http://www.example.com:8080/main/index.jsp?user=test&login=check}
        source {https://clouddocs.f5.com/api/irules/HTTP__uri.html}
        example {when HTTP_PROXY_REQUEST {
   log local.0 "This proxy request is:[HTTP::uri]"
}}
        returns {Returns the URI part of the HTTP request.}
    }
}

command HTTP::username {
    available {f5-irules}
    traits REQUIRES_HTTP_CONTEXT

    side_effect HttpHeader -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {HTTP::username}

    hover {
        summary {Returns the username part of HTTP basic authentication.}
        synopsis {HTTP::username}
        description {Returns the username part of HTTP basic authentication.
As described in RFC2617 the username and password in basic
authentication is sent by the client in the Authorization header. The
client base64 encodes the username and password in the format of:
Authorization: Basic base64encoding(username:password)
The HTTP::username command parses and base64 decodes the username.
The HTTP::password command parses and base64 decodes the password.}
        source {https://clouddocs.f5.com/api/irules/HTTP__username.html}
        example {when CLIENT_ACCEPTED {
  set auth_sid [AUTH::start pam default_radius]
}}
        returns {Returns the username part of HTTP basic authentication}
    }
}

command HTTP::version {
    available {f5-irules}
    traits {PURE CSE_CANDIDATE REQUIRES_HTTP_CONTEXT}

    arg 0 -values-from http-version-arg0 -closed

    side_effect HttpHeader -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -string -takes version -detail {Get/set version as raw string.}

    form Default {HTTP::version ('0.9' | '1.0' | '1.1')?
HTTP::version -string ?value?}

    hover {
        summary {Returns or sets the HTTP version of the request or response.}
        synopsis {HTTP::version ('0.9' | '1.0' | '1.1')?}
        synopsis {HTTP::version '-string' (ANY_CHARS)?}
        description {Returns or sets the HTTP version of the request or response. This
command replaces the BIG-IP 4.X variable http_version.
If needed, Connection and Host headers will automatically be added
appropriately.
HTTP::version will return the original version of the request or
response, even if it has been changed.  Note that this will return
the "effective" version used, which may be different than the actual
version string in the request or response.  For example, invalid
version numbers may be parsed as 1.1 in order to increase
inter-operability with common HTTP servers.}
        source {https://clouddocs.f5.com/api/irules/HTTP__version.html}
        example {when HTTP_RESPONSE {
  HTTP::version "1.1"
}}
        returns {Returns the HTTP version of the request or response}
    }
}

