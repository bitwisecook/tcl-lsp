        mutator
        side_effect SslState -writes -side Both
    }

    subcommand always {
        arity 0
        detail {Authenticate on every connection.}
        synopsis {SSL::authenticate always}
        mutator
        side_effect SslState -writes -side Both
    }

    subcommand depth {
        arity 1
        detail {Set max certificate chain traversal depth.}
        synopsis {SSL::authenticate depth <number>}
        mutator
        side_effect SslState -writes -side Both
    }
}

command SSL::c3d {
    available {f5-irules}

    side_effect SslState -reads -writes -side Both

    form Default {SSL::c3d <subcommand> <args>}

    hover {
        summary {Inserts a certificate extension to the C3D certificate, sets the C3D client certificate, or modifies forged certificate subject CN.}
        synopsis {SSL::c3d extension (ARG ARG)}
        synopsis {SSL::c3d cert CERTIFICATE}
        synopsis {SSL::c3d subject (ARG ARG)}
        synopsis {SSL::c3d cert_lifespan HOURS}
        synopsis {SSL::c3d cert_start_date (override | original)?}
        description {Inserts a certificate extension to the C3D certificate, sets the C3D client certificate, or modifies forged certificate subject CN. When subject CN is modified CN, O, OU will be converted to PrintableString where possible or UTF-8. Expected input for subject CN is in UTF-8 format.}
        source {https://clouddocs.f5.com/api/irules/SSL__c3d.html}
        example {when CLIENTSSL_HANDSHAKE {
    log local0.info "CLIENTSSL_HANDSHAKE"
    SSL::c3d extension CP "2.16.840.1.101.2.1.11.9, cpsuri:https://localhost/test-statement/pki/cps.txt, cpsuri:https://localhost/test-statement1/pki/cps.txt;2.16.840.1.101.2.1.11.19"
    SSL::c3d extension SAN "DNS:*.test-client.com, IP:1.1.1.1"
    SSL::c3d extension 1.2.3.4 "The oid-vaule for oid 1.2.3.4"
    SSL::c3d cert_lifespan 5
    SSL::c3d cert_start_date override
    SSL::c3d extension KU "critical,digitalSignature,keyEncipherment"
    SSL::c3d extension EKU "clientAuth,codeSigning"
    SSL::c3d extension SDA "dateOfBirth:20250115120000Z,gender:M,countryOfCitizenship:US"
    if {[SSL::cert count] > 0} {
        SSL::c3d subject commonName [X509::subject [SSL::cert 0] commonName]
    }
}}
        returns {SSL::c3d extension <oid oid-value> inserts an extension. SSL::c3d cert <certificate in DER> sets the C3D client certificate. SSL::c3d subject <nid value> sets the forged certificate subject. SSL::c3d cert_lifespan <hours> sets its lifespan. SSL::c3d cert_start_date [override | original] controls its notBefore value.}
    }

    subcommand extension {
        arity 2
        detail {Insert a certificate extension.}
        synopsis {SSL::c3d extension <oid> <value>}
        mutator
        side_effect SslState -writes -side Both
    }

    subcommand cert {
        arity 1
        detail {Set the C3D client certificate.}
        synopsis {SSL::c3d cert <certificate>}
        mutator
        side_effect SslState -writes -side Both
    }

    subcommand subject {
        arity 2
        detail {Modify forged certificate subject CN.}
        synopsis {SSL::c3d subject <field> <value>}
        mutator
        side_effect SslState -writes -side Both
    }

    subcommand cert_lifespan {
        arity 1
        detail {Set the forged C3D certificate lifespan in hours.}
        synopsis {SSL::c3d cert_lifespan <hours>}
        introduced_version 21.1.0
        mutator
        side_effect SslState -writes -side Both

        hover {
            summary {Sets the lifespan of the forged C3D certificate in hours.}
            synopsis {SSL::c3d cert_lifespan <hours>}
            description {Sets the lifespan of the forged C3D certificate in hours. Introduced in BIG-IP 21.1.0.}
            source {https://clouddocs.f5.com/api/irules/SSL__c3d.html}
            example {SSL::c3d cert_lifespan 5}
        }
    }

    subcommand cert_start_date {
        arity ..1
        detail {Choose the forged C3D certificate start date.}
        synopsis {SSL::c3d cert_start_date ?override|original?}
        introduced_version 21.1.0
        mutator
        arg 0 -values-from ssl-c3d-cert-start-date-arg0
        side_effect SslState -writes -side Both

        hover {
            summary {Controls the forged C3D certificate's notBefore value.}
            synopsis {SSL::c3d cert_start_date ?override|original?}
            description {Specifies whether to override the generated C3D certificate's notBefore value with the forging time or retain the original certificate's notBefore value. Introduced in BIG-IP 21.1.0.}
            source {https://clouddocs.f5.com/api/irules/SSL__c3d.html}
            example {SSL::c3d cert_start_date override}
        }
    }
}

