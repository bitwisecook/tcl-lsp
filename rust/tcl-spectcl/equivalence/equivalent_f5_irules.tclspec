command ISTATS::get {
    available {f5-irules}

    side_effect IStats -reads -side Global

    form Default {ISTATS::get KEY}

    hover {
        summary {Retrieves the value associated with the given key.}
        synopsis {ISTATS::get KEY}
        description {Reads in the value associated with the given iStats key}
        source {https://clouddocs.f5.com/api/irules/ISTATS__get.html}
        example {when HTTP_REQUEST {
        if { [string tolower [HTTP::uri]] equals "/12345" } {
                ISTATS::incr "uri /12345 counter Requests" 1
                HTTP::uri "/"
                HTTP::redirect "http://www.mysite.com"
        } elseif { [string tolower [HTTP::uri]] equals "/stats" } {
                  HTTP::respond 200 content "<html><body>Requests for /12345: [ISTATS::get "uri /12345 counter Requests"]</body></html>"
        }
}}
        returns {Returns the value associated with the given key.}
    }
}

command ISTATS::incr {
    available {f5-irules}

    side_effect IStats -writes -side Global

    form Default {ISTATS::incr KEY VALUE}

    hover {
        summary {Increments the specified key by the given value.}
        synopsis {ISTATS::incr KEY VALUE}
        description {Increments the specified key by the given value. The increment value must be non-negative for a counter.

Note that text string iStats may not be incremented.}
        source {https://clouddocs.f5.com/api/irules/ISTATS__incr.html}
        example {when HTTP_REQUEST {
        if { [string tolower [HTTP::uri]] equals "/12345" } {
                ISTATS::incr "uri /12345 counter Requests" 1
                HTTP::uri "/"
                HTTP::redirect "http://www.mysite.com"
        } elseif { [string tolower [HTTP::uri]] equals "/stats" } {
                  HTTP::respond 200 content "<html><body>Requests for /12345: [ISTATS::get "uri /12345 counter Requests"]</body></html>"
        }
}}
    }
}

command ISTATS::remove {
    available {f5-irules}

    side_effect IStats -writes -side Global

    form Default {ISTATS::remove KEY}

    hover {
        summary {Removes the given iStat entirely.}
        synopsis {ISTATS::remove KEY}
        description {Removes the given iStat entirely.}
        source {https://clouddocs.f5.com/api/irules/ISTATS__remove.html}
        example {ISTATS::remove "ltm.pool /Common/mypool counter some_counter"}
    }
}

command ISTATS::set {
    available {f5-irules}

    side_effect IStats -writes -side Global

    form Default {ISTATS::set KEY VALUE}

    hover {
        summary {Sets the given key's value within iStats.}
        synopsis {ISTATS::set KEY VALUE}
        description {Set the given key's value within iStats}
        source {https://clouddocs.f5.com/api/irules/ISTATS__set.html}
        example {when HTTP_REQUEST {
  # send request to /invalidate?policy=<policy>
  if { [HTTP::path] eq "/invalidate" } {
        set wa_policy [URI::query [HTTP::uri] policy]
        if { $wa_policy ne "" } {
          ISTATS::set "WA policy string $wa_policy" "invalidated"
        }
        HTTP::respond 200 content "<html><body>Cache Invalidated for Policy: $wa_policy</body></html>"
  }
}}
    }
}

command IVS_ENTRY::result {
    available {f5-irules}

    side_effect Unknown -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {IVS_ENTRY::result (noop | modified | response)}

    hover {
        summary {Sends a result code to the IVS client.}
        synopsis {IVS_ENTRY::result (noop | modified | response)}
        description {Send a result code to the IVS (Internal Virtual Server) client
(usually ADAPT). The intent is to allow an IVS to be used in a
user-defined way without a specific IVS profile like "icap". If an
"icap" profile is present, IVS_ENTRY::result should not be used as
it would cause a second result to be sent to the IVS client
(usually ADAPT), with undefined effect.}
        source {https://clouddocs.f5.com/api/irules/IVS_ENTRY__result.html}
        example {when IVS_ENTRY_REQUEST {
                # Tell primary virtual the IVS will not handle this request
                IVS_ENTRY::result noop
            }}
    }
}

command JSON::array {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {JSON::array (}

    hover {
        summary {A group of subcommands that operate on a JSON array.}
        synopsis {JSON::array (}
        description {A group of subcommands that operate on a JSON array (first parameter of each subcommand).}
        source {https://clouddocs.f5.com/api/irules/JSON__array.html}
        example {when JSON_REQUEST {
    set rootval [JSON::root]
    set ary [JSON::get $rootval array]

    set size [JSON::array size $ary]
    set type_at_idx [JSON::array type $ary 2]
    set myint [JSON::array get $ary 1 integer]
    JSON::array set $ary 0 integer 500
    JSON::array insert $ary 5 string John
    JSON::array append $ary null
    JSON::array remove $ary 7
    set myvaluelist [JSON::array values $ary]
}}
        returns {Return depends on subcommand. See syntax description for detail.}
    }
}

command JSON::create {
    available {f5-irules}

    side_effect Unknown -writes

    form Default {JSON::create}

    hover {
        summary {Creates a new, empty JSON cache instance.}
        synopsis {JSON::create}
        description {Creates a new, empty JSON cache instance. It can then be filled with any JSON content and rendered. It will be deleted when no longer referenced by a Tcl variable.}
        source {https://clouddocs.f5.com/api/irules/JSON__create.html}
        example {when JSON_REQUEST {
    set cache [JSON::create]
    set rootval [JSON::root $cache]
    JSON::set $rootval string HelloWorld
    set rendered [JSON::render $cache]
}}
        returns {Returns the new JSON cache instance.}
    }
}

command JSON::get {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {JSON::get JSON_ELEMENT (JSON_TYPE)?}

    hover {
        summary {Gets the value content of a JSON element.}
        synopsis {JSON::get JSON_ELEMENT (JSON_TYPE)?}
        description {A JSON value can be one of many types. This command returns the value (content) of an element according to its type, as described below:

null : An empty Tcl list.
boolean : 1 for true or 0 for false.
integer : A Tcl number representing an integer in the range -(2^63) through (2^63 - 1).
literal: A Tcl string not requiring JSON escape sequences.
string : A Tcl string without escape sequences (having been replaced by the characters they represent).
object : A JSON object handle.
array : A JSON array handle.}
        source {https://clouddocs.f5.com/api/irules/JSON__get.html}
        example {when JSON_REQUEST {
    set rootval [JSON::root]
    set content [JSON::get $rootval integer]
    log local0. "$content"
}}
        returns {Returns the content held within the JSON element, according to the types listed in the above description.}
    }
}

command JSON::object {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {JSON::object (}

    hover {
        summary {A group of subcommands that operate on a JSON object.}
        synopsis {JSON::object (}
        description {A group of subcommands that operate on a JSON object (first parameter of each subcommand).}
        source {https://clouddocs.f5.com/api/irules/JSON__object.html}
        example {when JSON_REQUEST {
    set rootval [JSON::root]
    set obj [JSON::get $rootval object]

    set size [JSON::object size $obj]
    set type_at_key [JSON::object type $obj somekey]
    set myint [JSON::object get $obj intkey integer]
    JSON::object set $obj intkey integer 500
    JSON::object add $obj namekey string John
    JSON::object remove $obj intkey
    set mykeylist [JSON::object keys $obj]
    set myvaluelist [JSON::object values $obj]
}}
        returns {Return depends on subcommand. See syntax description for detail.}
    }
}

command JSON::parse {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {JSON::parse (JSON_STRING (JSON_MAX_ENTRIES)? )?}

    hover {
        summary {Parses JSON content into a JSON cache that can be manipulated using further JSON:: commands.}
        synopsis {JSON::parse (JSON_STRING (JSON_MAX_ENTRIES)? )?}
        description {If a string is omitted, returns any JSON cache that preexists in the context in which this is executed. This is the normal case when the command is executed in the JSON_REQUEST or JSON_RESPONSE event.
If a string is provided, it is assumed to contain JSON and is parsed into a new JSON cache. This will be deleted when it is no longer referenced by a Tcl variable. This is useful when a JSON profile is not being used.}
        source {https://clouddocs.f5.com/api/irules/JSON__parse.html}
        example {when JSON_REQUEST {
    JSON::render
}}
        returns {Returns a JSON cache instance handle to use for retrieving and overwriting content, and rendering.}
    }
}

command JSON::render {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {JSON::render (JSON_CACHE)?}

    hover {
        summary {Returns a string containing a textual rendering of the JSON cache content.}
        synopsis {JSON::render (JSON_CACHE)?}
        description {If a JSON cache handle is omitted, renders any JSON cache that preexists in the context in which this is executed. This is the normal case when the command is executed in a the JSON_REQUEST or JSON_RESPONSE event.
If a JSON cache handle is provided, renders that JSON cache. This is useful when a JSON profile is not being used.
NOTE: Rendering consumes the data in the cache, so after a render, no further value retrieval/modification/rendering may be done on this JSON cache instance.}
        source {https://clouddocs.f5.com/api/irules/JSON__render.html}
        example {when MR_INGRESS {
    set cache [JSON::create]
    set rootval [JSON::root $cache]
    JSON::set $rootval string HelloWorld
    set rendered [JSON::render $cache]
}}
        returns {Returns the string containing the rendered JSON content.}
    }
}

command JSON::root {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {JSON::root (JSON_CACHE)?}

    hover {
        summary {Gets the JSON element (aka.}
        synopsis {JSON::root (JSON_CACHE)?}
        description {If a JSON cache handle is supplied, returns the root element of that JSON cache instance. This is useful when a JSON profile is not being used.}
        source {https://clouddocs.f5.com/api/irules/JSON__root.html}
        example {when JSON_REQUEST {
    set rootval [JSON::root]
    JSON::set $rootval string HelloWorld
    set rendered [JSON::render $cache]
}}
        returns {Returns the JSON element at the root of the JSON cache instance.}
    }
}

command JSON::set {
    available {f5-irules}

    side_effect Unknown -writes

    form Default {JSON::set JSON_ELEMENT JSON_TYPE (JSON_VALUE)?}

    hover {
        summary {Sets a JSON element (aka.}
        synopsis {JSON::set JSON_ELEMENT JSON_TYPE (JSON_VALUE)?}
        description {Sets the value (content) of a JSON element, replacing any existing value. The given value should be according to the given type, as described below:

null: Omit. JSON type null has no value.
boolean: 0 (false) or 1 (true).
integer: A Tcl number representing an integer in the range -(2^63) through (2^63 - 1). Otherwise, use the literal type.
literal: A Tcl string not requiring JSON escape sequences.
string: A Tcl string without escape sequences (certain characters will be replaced by JSON escape sequences).
object: Omit. An empty object is created.
array: Omit. An empty array is created.}
        source {https://clouddocs.f5.com/api/irules/JSON__set.html}
        example {when JSON_REQUEST {
    set rootval [JSON::root]
    JSON::set $rootval string HelloWorld
}}
        returns {Returns the JSON element whose value was set (same element as the first argument passed to the command).}
    }
}

command JSON::type {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {JSON::type JSON_ELEMENT}

    hover {
        summary {Gets the type of the given JSON element (aka.}
        synopsis {JSON::type JSON_ELEMENT}
        description {A JSON value can be one of many types. This command allows you to determine the type of value in the element.}
        source {https://clouddocs.f5.com/api/irules/JSON__type.html}
        example {when JSON_REQUEST {
    set rootval [JSON::root]
    JSON::set $rootval string HelloWorld
    set type [JSON::type $rootval]
}}
        returns {Returns a string representing the JSON type ('null' | 'boolean' | 'integer' | 'literal' | 'string' | 'object' | 'array' | 'invalid').}
    }
}

command L7CHECK::protocol {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {L7CHECK::protocol set VALUE}

    hover {
        summary {Set or get L7 protocol value.}
        synopsis {L7CHECK::protocol set VALUE}
        synopsis {L7CHECK::protocol get}
