command BOTDEFENSE::action {
    available {f5-irules}

    side_effect AsmState -reads -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {BOTDEFENSE::action (allow |}

    hover {
        summary {Returns or overrides the action to be taken by Bot Defense.}
        synopsis {BOTDEFENSE::action (allow |}
        description {Returns or overrides the action to be taken by Bot Defense.

Overriding the action may fail on certain cases. For example, overriding to the "browser_challenge" action, may only be done on requests to which the value of BOTDEFENSE::cs_possible is "true". When overriding the action, the command returns "ok" if the action was successfully set. Otherwise, the action is not changed, and the reason for failure is returned.

After a successful action override (resulting in the "ok" string), the action cannot be overridden again.}
        source {https://clouddocs.f5.com/api/irules/BOTDEFENSE__action.html}
        example {when HTTP_RESPONSE_RELEASE {
    if {[info exists botdefense_responded]} {
        HTTP::header insert "myheader" "blocked request"
    }
}}
        returns {* When called without any arguments: Returns a string signifying the action to be taken by Bot Defense. If the action was overridden, the returned action is the overridden one. * When called with an argument for overriding the action, the return value is a status string.}
    }
}

command BOTDEFENSE::bot_anomalies {
    available {f5-irules}

    side_effect AsmState -reads -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {BOTDEFENSE::bot_anomalies}

    hover {
        summary {Returns the list of names of anomalies detected for the client that sent the current request.}
        synopsis {BOTDEFENSE::bot_anomalies}
        description {Returns the list of names of anomalies detected for the client that sent the current request. Some anomalies may have been detected in previous requests of the same client and are still valid.}
        source {https://clouddocs.f5.com/api/irules/BOTDEFENSE__bot_anomalies.html}
        example {when BOTDEFENSE_ACTION {
    foreach {anomaly} [BOTDEFENSE::bot_anomalies] {
        log.local0. "Found anomaly: $anomaly"
    }
}}
        returns {Returns a list of names of all anomalies detected for the sending client. In case no anomalies found it returns an empty list.}
    }
}

command BOTDEFENSE::bot_categories {
    available {f5-irules}

    side_effect AsmState -reads -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {BOTDEFENSE::bot_categories}

    hover {
        summary {Returns the list of category names to which the current client belongs.}
        synopsis {BOTDEFENSE::bot_categories}
        description {Returns the list of category names to which the current client belongs. These categories are determined by the anomalies found for the respective client. Note these categories are additional to the bot signature category which is applicable if a bot signature was found.}
        source {https://clouddocs.f5.com/api/irules/BOTDEFENSE__bot_categories.html}
        example {when BOTDEFENSE_ACTION {
    foreach {cat} [BOTDEFENSE::bot_categories] {
        log.local0. "Found category: $cat"
    }
}}
        returns {Returns a list of all category names to which the current client belongs based on the anomalies found for the client. The categories come in addition to the bot signature category optionally detected and returned in BOTDEFENSE::bot_signature_category. If no anomaly found then the list will be empty.}
    }
}

command BOTDEFENSE::bot_name {
