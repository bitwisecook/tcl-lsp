        summary {Returns a cloned copy of the GTP message.}
        synopsis {GTP::clone (MESSAGE_VAR)?}
        description {Returns a cloned copy of the GTP message.}
        source {https://clouddocs.f5.com/api/irules/GTP__clone.html}
        example {when CLIENT_ACCEPTED {
    set payload [UDP::payload]
    set t2 [GTP::parse $payload]
    set t3 [GTP::clone $t2]
    log local0. "GTP type [GTP::header type -message $t3]"
    log local0. "GTP teid [GTP::header teid -message $t3]"
}}
        returns {Returns a cloned copy of the GTP message.}
    }
}

