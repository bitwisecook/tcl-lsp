    form Default {ADAPT::preview_size (ADAPT_CTX)? (ADAPT_SIDE)? (SIZE)?}

    hover {
        summary {Sets or returns the preview-size attribute.}
        synopsis {ADAPT::preview_size (ADAPT_CTX)? (ADAPT_SIDE)? (SIZE)?}
        description {The ADAPT::preview_size command sets or returns the preview-size
attribute of the ADAPT filter on the current or specified side of
the virtual server connection for which the iRule is being executed.}
        source {https://clouddocs.f5.com/api/irules/ADAPT__preview_size.html}
        example {when HTTP_RESPONSE {
    if { [HTTP::header "Content-Type"] contains "image" } {
        ADAPT::select ivs-icap-image
        ADAPT::preview_size 10000
    }
    if { [HTTP::header "Content-Type"] contains "video" } {
       ADAPT::select ivs-icap-video
       ADAPT::preview_size 30000
    }
}}
        returns {Returns the current or modified preview size (bytes).}
    }
}

command ADAPT::result {
    available {f5-irules}

    side_effect IcapState -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {ADAPT::result (ADAPT_CTX)? (ADAPT_SIDE)? ('bypass' | 'close' | 'abort')?}

    hover {
        summary {Sets or returns the adaptation result code.}
        synopsis {ADAPT::result (ADAPT_CTX)? (ADAPT_SIDE)? ('bypass' | 'close' | 'abort')?}
        description {The ADAPT::result command sets or returns the adaptation result
code of the ADAPT filter on the current or specified side of the
virtual server connection for which the iRule is being executed.

Possible result codes are:
    * unknown - The internal virtual server has not returned a
      result yet. It is not possible to change the result code
      to this value.
    * bypass - The internal virtual server does not need to modify
      the request or response.}
        source {https://clouddocs.f5.com/api/irules/ADAPT__result.html}
        example {when ADAPT_REQUEST_RESULT {
     if {[ADAPT::result] == "respond"} {
        # Force ADAPT to ignore any direct response from IVS
        # (contrived example, probably not useful as-is).
        ADAPT::result bypass
     }
}}
        returns {Returns the current or modified result code.}
    }
}

command ADAPT::select {
    available {f5-irules}

    side_effect IcapState -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {ADAPT::select (ADAPT_CTX)? (ADAPT_SIDE)? (NAME)?}

    hover {
        summary {Sets or returns the internal virtual server (IVS) selection.}
        synopsis {ADAPT::select (ADAPT_CTX)? (ADAPT_SIDE)? (NAME)?}
        description {The ADAPT::select command returns or selects the name of
the internal virtual server (IVS) associated with the ADAPT
filter on the current or specified side of the virtual server
connection for which the iRule is being executed.}
        source {https://clouddocs.f5.com/api/irules/ADAPT__select.html}
        example {when HTTP_RESPONSE {
     if { [HTTP::header "Content-Type"] contains "image" } {
        ADAPT::select ivs-icap-image
        ADAPT::preview_size 10000
        ADAPT::enable yes
     }
     if { [HTTP::header "Content-Type"] contains "video" } {
        ADAPT::select ivs-icap-video
        ADAPT::preview_size 30000
        ADAPT::enable yes
     }
}}
        returns {Returns the current or new internal virtual server (IVS) name.}
    }
}

command ADAPT::service_down_action {
    available {f5-irules}

    side_effect IcapState -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {ADAPT::service_down_action (ADAPT_CTX)? (ADAPT_SIDE)? ('ignore' | 'reset' | 'drop')?}

    hover {
        summary {Sets or returns the service-down-action attribute.}
        synopsis {ADAPT::service_down_action (ADAPT_CTX)? (ADAPT_SIDE)? ('ignore' | 'reset' | 'drop')?}
        description {The ADAPT::service_down_action command sets or returns the
service-down-action attribute of the ADAPT filter on the
current or specified side of the virtual server connection
for which the iRule is being executed.

Possible service-down-actions aare:
    * ignore - Do not send the HTTP request or response to the
      internal virtual server (bypass). Pass it through unchanged.
    * reset - Reset (RST) the connection.
    * drop - Drop (FIN) the connection.}
        source {https://clouddocs.f5.com/api/irules/ADAPT__service_down_action.html}
        example {when ADAPT_REQUEST_HEADERS {
     # Cause connection to be dropped if ICAP server handling
     # response is down for requests with a custom HTTP header
     # (which might have been resulted from request adaptation).
     if {[HTTP::header exists "X-Drop-if-down"]} {
        ADAPT::service_down_action response drop
     }
}}
        returns {Returns the current or modified service-down-action.}
    }
}

command ADAPT::timeout {
    available {f5-irules}

    side_effect IcapState -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {ADAPT::timeout (ADAPT_CTX)? (ADAPT_SIDE)? (TIMEOUT_VALUE)?}

    hover {
        summary {Sets or returns the timeout attribute.}
        synopsis {ADAPT::timeout (ADAPT_CTX)? (ADAPT_SIDE)? (TIMEOUT_VALUE)?}
        description {The ADAPT::timeout command sets or returns the timeout attribute
of the ADAPT filter on the current or specified side of the
virtual server connection for which the iRule is being executed.
The timeout (in milliseconds) is how long ADAPT will wait for
a result from the internal virtual server before deciding the
service is down.}
        source {https://clouddocs.f5.com/api/irules/ADAPT__timeout.html}
        example {when HTTP_RESPONSE {
     if { [HTTP::header "Content-Type"] contains "image" } {
        ADAPT::select ivs-icap-image
        ADAPT::timeout 500
     }
     if { [HTTP::header "Content-Type"] contains "video" } {
        ADAPT::select ivs-icap-video
        ADAPT::timeout 2000
     }
 }}
        returns {Returns the current or modified timeout in milliseconds.}
    }
}

command AES::decrypt {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {AES::decrypt KEY DATA}

    hover {
        summary {Decrypts the data using the previously-created AES key.}
        synopsis {AES::decrypt KEY DATA}
        description {Decrypt the data using an AES key.}
        source {https://clouddocs.f5.com/api/irules/AES__decrypt.html}
        example {when HTTP_REQUEST {
  set key "AES 128 43047ad71173be644498b98de6a32fe3"
  set decryptedData [AES::decrypt $key $encryptedData]
  log local0. "The decrypted data is $decryptedData"
}}
        returns {Returns the decrypted data.}
    }
}

command AES::encrypt {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {AES::encrypt KEY DATA}

    hover {
        summary {Encrypts the data using the previously-created AES key.}
        synopsis {AES::encrypt KEY DATA}
        description {Encrypt the data using an AES key.}
        source {https://clouddocs.f5.com/api/irules/AES__encrypt.html}
        example {when SERVER_DATA {
  set key "AES 128 43047ad71173be644498b98de6a32fe3"
  set encryptedData [AES::encrypt $key [TCP::payload]]
  TCP::payload replace 0 [TCP::payload length] $encryptedData
}}
        returns {Returns the encrypted data.}
    }
}

command AES::key {
    available {f5-irules}

    side_effect Unknown -reads

    form Default {AES::key ('128' | '192' | '256')?}

    hover {
        summary {Creates an AES key to encrypt/decrypt data.}
        synopsis {AES::key ('128' | '192' | '256')?}
        description {Creates an AES key of the specified length for use in
encryption/decryption operations.}
        source {https://clouddocs.f5.com/api/irules/AES__key.html}
        example {when RULE_INIT {
    set ::key [AES::key 128]
}}
        returns {Returns the created key.}
    }
}

