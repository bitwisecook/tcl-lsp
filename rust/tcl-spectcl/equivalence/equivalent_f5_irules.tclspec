command CRYPTO::decrypt {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    option -alg -takes ALG -detail {Decryption algorithm.}
    option -ctx -takes CTX_VAR -detail {Context variable for multi-step operations.}
    option -final -detail {Finalize context-based operation.}
    option -key -takes KEY -detail {Binary key.}
    option -keyhex -takes KEY_HEX -detail {Hex-encoded key.}
    option -iv -takes IV -detail {Initialization vector (binary).}
    option -ivhex -takes IV_HEX -detail {Initialization vector (hex).}
    option -padding -takes PADDING -detail {Padding mode (pkcs, oaep, none).}

    form Default {CRYPTO::decrypt (('-padding' (pkcs | oaep | none) )}

    hover {
        summary {This iRules command decrypts data.}
        synopsis {CRYPTO::decrypt (('-padding' (pkcs | oaep | none) )}
        description {This iRules command decrypts data.

CRYPTO::decrypt [-alg <>] [-ctx <> [-final]] [-key[hex] <>] [-iv[hex] <>] [<data>]
                [-padding <"pkcs" | "oaep" | "none">]

     * decrypts data based on several parameters
          + alg - algorithm. ASCII string from a given list (see below)
            The spelling is lowercase and the iRule will fail for anything
            not in the list. In ctx mode, alg must be given in the first
            CRYPTO::command and cannot be modified.}
        source {https://clouddocs.f5.com/api/irules/CRYPTO__decrypt.html}
    }
}

command CRYPTO::encrypt {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    option -alg -takes ALG -detail {Encryption algorithm.}
    option -ctx -takes CTX_VAR -detail {Context variable for multi-step operations.}
    option -final -detail {Finalize context-based operation.}
    option -key -takes KEY -detail {Binary key.}
    option -keyhex -takes KEY_HEX -detail {Hex-encoded key.}
    option -iv -takes IV -detail {Initialization vector (binary).}
    option -ivhex -takes IV_HEX -detail {Initialization vector (hex).}
    option -padding -takes PADDING -detail {Padding mode (pkcs, oaep, none).}

    form Default {CRYPTO::encrypt (('-padding' (pkcs | oaep | none) )}

    hover {
        summary {This iRules command encrypts data.}
        synopsis {CRYPTO::encrypt (('-padding' (pkcs | oaep | none) )}
        description {This iRules command encrypts data. A ciphertext encrypted with this
command should be decryptable by third party software.

CRYPTO::encrypt [-alg <>] [-ctx <> [-final]] [-key[hex] <>] [-iv[hex] <>] [<data>]
                [-padding <"pkcs" | "oaep" | "none">]

     * encrypts data based on several parameters
          + alg - algorithm. ASCII string from a given list (see below)
            The spelling is lowercase and the iRule will fail for anything
            not in the list. In ctx mode, alg must be given in the first
            CRYPTO:: command and cannot be modified.}
        source {https://clouddocs.f5.com/api/irules/CRYPTO__encrypt.html}
        # TODO(spectcl): `hover` holds text no Tcl word carries verbatim — an
        #   unbalanced brace or a backslash-newline. A braced word is the only
        #   faithful spelling, so the statement is dropped rather than written
        #   down wrong.
    }
}

command CRYPTO::hash {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    option -alg -takes ALG -detail {Hash algorithm.}
    option -ctx -takes CTX_VAR -detail {Context variable for multi-step operations.}
    option -final -detail {Finalize context-based operation.}

    form Default {CRYPTO::hash (('-alg' ('md5' | 'ripemd160' | 'sha1' | 'sha224' | 'sha256' | 'sha384'}

    hover {
        summary {Generates a hash on a piece of data.}
        synopsis {CRYPTO::hash (('-alg' ('md5' | 'ripemd160' | 'sha1' | 'sha224' | 'sha256' | 'sha384'}
        description {This iRules command generates a hash on a piece of data

CRYPTO::hash [-alg <>] [-ctx <> [-final]] [<data>]

     * Generates a hash on a piece of data

Algorithm List

     * md5
     * ripemd160
     * sha1
     * sha224
     * sha256
     * sha384
     * sha512}
        source {https://clouddocs.f5.com/api/irules/CRYPTO__hash.html}
        example {when HTTP_REQUEST {
if {[class match [b64encode [CRYPTO::hash -alg sha384 [HTTP::host][HTTP::path]]] equals HASH ]} {
    log local0. " this FQDN + PATH is mathing - [HTTP::host][HTTP::path]"
}
}}
    }
}

