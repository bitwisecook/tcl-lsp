command lindex {
    available {tcl 8.4-} {f5-irules}
    traits {PURE CSE_CANDIDATE BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME}
    arity 1..

    return_type String
    return_elements {ElementOf 0}
    representation_effect {CoerceOrdinaryListIndices 0 1}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -type List -shimmers
    arg 1 -type Int -shimmers

    const_fold -native lindex::const_fold
    inline_codegen_hook -native Lindex
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.
    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.
    # TODO(spectcl): `result_stability` is set on the source spec. The DSL
    #   spells it `result_stability
    #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
    #   …}}`, but a draft records only that the field is set, never the
    #   expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin lindex

    form Default {lindex list ?index ...?}

    hover {
        summary {Retrieve an element (or nested sublist) from a list by index.}
        synopsis {lindex list ?index ...?}
        description {Treats list as a Tcl list and returns the index'th element (0 refers to the first element). With no index, or a single empty-string index, the return value is list itself, unchanged. index accepts a non-negative or negative integer, end, end-integer, or — since Tcl 8.5 — the fuller index-arithmetic syntax of `string index`, such as end+1 or $n+2 (each index takes at most one +/- offset — end-1+1 is not valid syntax); Tcl 8.4 supports only a bare integer or the fixed end-integer form. An index that is negative or greater than or equal to the list's length returns an empty string rather than raising an error. Extraction follows the same brace/quote/backslash rules as the Tcl parser, but performs no variable or command substitution, so an element that looks like $x or [foo] is returned literally. Additional index arguments are applied in turn to the result of the previous step, descending into nested sublists — lindex $a 1 2 is equivalent to lindex [lindex $a 1] 2 — and may be given as separate words or grouped into a single list argument, e.g. lindex $a {1 2}.}
        source {Tcl lindex(n)}
        example {set colors {red green blue yellow}
lindex $colors 0      ;# red
lindex $colors end    ;# yellow
lindex $colors end-1  ;# blue
lindex $colors        ;# red green blue yellow -- no index returns the list unchanged

set matrix {{1 2 3} {4 5 6}}
lindex $matrix 1 2    ;# 6
lindex $matrix {1 2}  ;# 6 -- indices grouped into a single list argument}
        returns {The selected element, or nested sublist when multiple indices are given; the list itself, unchanged, when no index is given; or an empty string when an index is out of range.}
    }
}

