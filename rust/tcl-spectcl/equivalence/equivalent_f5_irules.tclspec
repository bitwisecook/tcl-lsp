command SIP::header {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {SIP::header <subcommand|name> ?args?}

    hover {
        summary {Gets or sets SIP header information.}
        synopsis {SIP::header SIP_HEADER_NAME (INDEX)?}
        synopsis {SIP::header ('value' | 'remove') HEADER_NAME (INDEX)?}
        synopsis {SIP::header ('insert') HEADER_NAME HEADER_VALUE (INDEX)?}
        synopsis {SIP::header 'names'}
        description {This set of commands allows you to get or set information in the SIP
header.

Note: These commands still work on MBLB (Message Based Load
Balancing) SIP post 11.6+, but there are new commands that only
run on MRF (Message Routing Framework) SIP and were introduced
in 11.6.}
        source {https://clouddocs.f5.com/api/irules/SIP__header.html}
        example {when SIP_REQUEST_SEND {
  log local0. [SIP::method]
  SIP::header insert Via [format "SIP/2.0/TCP %s:%s" [IP::local_addr] [TCP::local_port]]
  SIP::header insert Y-Header "it is yyy"
}}
    }

    subcommand value {
        arity 1..2
        detail {Get header value by name and optional index.}
        synopsis {SIP::header value <name> ?index?}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand remove {
        arity 1..2
        detail {Remove a header by name and optional index.}
        synopsis {SIP::header remove <name> ?index?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand insert {
        arity 2..3
        detail {Insert a new header.}
        synopsis {SIP::header insert <name> <value> ?index?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand names {
        arity 0
        detail {List all header names.}
        synopsis {SIP::header names}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand at {
        arity 1
        detail {Get header at index.}
        synopsis {SIP::header at <index>}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand exists {
        arity 1
        detail {Check if header exists.}
        synopsis {SIP::header exists <name>}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand replace {
        arity 2..3
        detail {Replace header value.}
        synopsis {SIP::header replace <name> <value> ?index?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand count {
        arity 1
        detail {Count headers with name.}
        synopsis {SIP::header count <name>}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand values {
        arity 1
        detail {Get all values for header.}
        synopsis {SIP::header values <name>}
        pure
        side_effect NetworkIo -reads -side Both
    }
}

