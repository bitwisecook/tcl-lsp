    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::command (DIAMETER_COMMAND_CODE)?}

    hover {
        summary {Gets or sets the command-code.}
        synopsis {DIAMETER::command (DIAMETER_COMMAND_CODE)?}
        description {The DIAMETER::command gets or sets the command code in the Diameter message header.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__command.html}
        example {when DIAMETER_INGRESS {
    log local0. "Received a DIAMETER command, with code [DIAMETER::command]"
}}
        returns {If new command-code value is not provided, returns command code of current Diameter message}
    }
}

command DIAMETER::disconnect {
    available {f5-irules}

    side_effect ConnectionControl -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::disconnect ORIGIN_HOST ORIGIN_REALM DIAMETER_DISCONNECT_CAUSE}

    hover {
        summary {Sends Disconnect-Peer-Request to client or server based on context.}
        synopsis {DIAMETER::disconnect ORIGIN_HOST ORIGIN_REALM DIAMETER_DISCONNECT_CAUSE}
        description {This iRule command sends Disconnect-Peer-Request to the client (if run
on clientside) or to the server (if run on serverside).}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__disconnect.html}
        example {when DIAMETER_INGRESS {
    # 2 = DO_NOT_WANT_TO_TALK_TO_YOU (RFC 6733 sec 5.4.3)
    DIAMETER::disconnect "bigip.core.example.com" "example.com" 2
}}
    }
}

