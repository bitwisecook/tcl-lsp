    hover {
        summary {This command can be used to turn off WebSocket processing.}
        synopsis {WS::enabled ( 'false' )?}
        description {WS::enabled
    This can be used to determine whether the Websocket processing is enabled or disabled for a particular connection.

WS::enabled false
    This can be used to disable the Websocket processing for a particular connection.}
        source {https://clouddocs.f5.com/api/irules/WS__enabled.html}
        example {when HTTP_REQUEST {
    WS::enabled false
}}
        returns {WS::enabled command returns TRUE if Websocket processing is enabled for a particular connection, FALSE otherwise.}
    }
}

command WS::frame {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {WS::frame <subcommand> ?args?}

    hover {
        summary {This command allows you to perform various operations on a Websocket frame, determine whether this frame indicates the end of the message, insert a new frame, drop the current frame, or manipulate the frame by prepending, appending or replacing the contents of the frame.}
        synopsis {WS::frame <subcommand> ?args?}
        synopsis {WS::frame insert <type> <payload> ?mask?}
        description {WS::frame eom
    The command can be used to determine whether current frame is last one in the Websocket message.

WS::frame orig_masked
    The command can be used to determine whether current frame received from the client or server was masked.

WS::frame type
    The command can be used to determine the type of current frame received from the client or server.

WS::frame mask
    The command can be used to determine the mask of the current frame.

WS::frame drop
    The command can be used to drop the current frame.}
        source {https://clouddocs.f5.com/api/irules/WS__frame.html}
        example {when WS_SERVER_FRAME {
    log local0. "Websocket frame eom: [WS::frame eom]"
    log local0. "Websocket frame received mask: [WS::frame orig_masked]"
    log local0. "Websocket frame type: [WS::frame type]"
    log local0. "Websocket frame mask: [WS::frame mask]"
    WS::frame drop
    WS::frame insert 1 "abcdefghi"
    WS::frame prepend "Using WS I sent "
    WS::frame append "message was sent"
    WS::frame replace "replaced"
}}
        returns {The eom, orig_masked, type and mask commands return the values of corresponding fields in the Websockets frame header. Drop, insert, prepend, append and replace can be used to manipulate the frame contents.}
    }

    subcommand eom {
        arity 0
        detail {Check if frame is end of message.}
        synopsis {WS::frame eom}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand drop {
        arity 0
        detail {Drop the current frame.}
        synopsis {WS::frame drop}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand orig_masked {
        arity 0
        detail {Check if frame was masked.}
        synopsis {WS::frame orig_masked}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand type {
        arity 0
        detail {Get frame type.}
        synopsis {WS::frame type}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand mask {
        arity 0
        detail {Get frame mask.}
        synopsis {WS::frame mask}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand insert {
        arity 2..3
        detail {Insert a new frame.}
        synopsis {WS::frame insert <type> <payload> ?mask?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand prepend {
        arity 1
        detail {Prepend data to frame.}
        synopsis {WS::frame prepend <data>}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand append {
        arity 1
        detail {Append data to frame.}
        synopsis {WS::frame append <data>}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand replace {
        arity 1
        detail {Replace frame contents.}
        synopsis {WS::frame replace <data>}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }
}

command WS::masking {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {WS::masking ( 'preserve' | 'remask' )}

    hover {
        summary {This command determines the behavior of Websocket processing.}
        synopsis {WS::masking ( 'preserve' | 'remask' )}
        description {WS::masking preserve
    The WebSockets module will not unmask the payload. Data received from the end-points will be sent untouched to other modules for further processing.

WS::masking remask
    The data received from the end-points is unmasked and sent to other modules for further processing. The client-to-server frame's payload is then masked with the specified mask before sending data out on the wire again.}
        source {https://clouddocs.f5.com/api/irules/WS__masking.html}
        example {when WS_REQUEST {
    WS::masking preserve
    WS::masking remask
}}
    }
}

command WS::message {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {WS::message ( 'drop' )}

