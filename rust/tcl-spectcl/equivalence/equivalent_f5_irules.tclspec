    form Default {HTTP::payload ( LENGTH | (OFFSET LENGTH) )?}

    hover {
        summary {Queries for or manipulates HTTP payload information.}
        synopsis {HTTP::payload ( LENGTH | (OFFSET LENGTH) )?}
        synopsis {HTTP::payload length}
        synopsis {HTTP::payload rechunk}
        synopsis {HTTP::payload unchunk}
        description {Queries for or manipulates HTTP payload (content) information. With
this command, you can retrieve content, query for content size, or
replace a certain amount of content. The content does not include the
HTTP headers.}
        source {https://clouddocs.f5.com/api/irules/HTTP__payload.html}
        example {when HTTP_RESPONSE_DATA {
HTTP::respond 200 content [HTTP::payload]
}}
    }
}

command HTTP::proxy {
    available {f5-irules}
    traits REQUIRES_HTTP_CONTEXT

    side_effect HttpUri -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {HTTP::proxy ?subcommand? ?args?}

    hover {
        summary {Controls the application of HTTP proxy when using an Explicit HTTP profile.}
        synopsis {HTTP::proxy}
        synopsis {HTTP::proxy ('enable' | 'disable')}
        synopsis {HTTP::proxy 'uri-rewrite' ('enable' | 'disable')}
        synopsis {HTTP::proxy ('addr' | 'port' | 'rtdom' | 'exists' | 'iptuple')}
        synopsis {HTTP::proxy chain ?args?}
        description {When an Explicit HTTP profile is applied to a virtual server, HTTP::proxy allows control of whether the BIG-IP will handle the proxy of the connection locally or send it to a downstream pool for processing instead.

This functionality was introduced in v11.6, and is available for v11.5.1 via an Engineering Hotfix.

HTTP::proxy allows inspection of the results of the DNS lookup used in the Explicit HTTP Proxy.

When a HTTP Proxy Chaining profile is applied to a virtual server, HTTP::proxy chain may be used to control the CONNECT request used to connect to the next proxy in the chain.}
        source {https://clouddocs.f5.com/api/irules/HTTP__proxy.html}
        example {when HTTP_REQUEST {
    log local0. "[HTTP::method] [HTTP::uri]"
}}
    }

    subcommand enable {
        arity 0
        detail {Enable HTTP proxy.}
        synopsis {HTTP::proxy enable}
        mutator
        side_effect HttpUri -reads -writes -side Both
    }

    subcommand disable {
        arity 0
        detail {Disable HTTP proxy.}
        synopsis {HTTP::proxy disable}
        mutator
        side_effect HttpUri -reads -writes -side Both
    }

    subcommand uri-rewrite {
        arity 1
        detail {Control URI rewriting.}
        synopsis {HTTP::proxy uri-rewrite ?enable|disable?}
        mutator
        arg 0 -values-from http-proxy-uri-rewrite-arg0
        side_effect HttpUri -reads -writes -side Both
    }

    subcommand addr {
        arity 0
        detail {Get proxy destination address.}
        synopsis {HTTP::proxy addr}
        pure
        side_effect HttpUri -reads -side Both
    }

    subcommand port {
        arity 0
        detail {Get proxy destination port.}
        synopsis {HTTP::proxy port}
        pure
        side_effect HttpUri -reads -side Both
    }

    subcommand rtdom {
        arity 0
        detail {Get proxy route domain.}
        synopsis {HTTP::proxy rtdom}
        pure
        side_effect HttpUri -reads -side Both
    }

    subcommand exists {
        arity 0
        detail {Check if proxy is active.}
        synopsis {HTTP::proxy exists}
        pure
        side_effect HttpUri -reads -side Both
    }

    subcommand iptuple {
        arity 0
        detail {Get proxy IP tuple.}
        synopsis {HTTP::proxy iptuple}
        pure
        side_effect HttpUri -reads -side Both
    }

    subcommand chain {
        detail {Control proxy chaining.}
        synopsis {HTTP::proxy chain ?args?}
        mutator
        side_effect HttpUri -reads -writes -side Both
    }
}

