command ILX::call {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    # TODO(spectcl): `remote_method` is set on the source spec. — the loader
    #   has no reader for that property word yet.

    option -timeout -takes MSEC -detail {Timeout in milliseconds.}
    option --

    form Default {ILX::call HANDLE ?-timeout ms? ?--? METHOD ?args ...?}

    hover {
        summary {Calls an ILX method.}
        synopsis {ILX::call HANDLE ?-timeout ms? ?--? METHOD ?args ...?}
        description {Make a call to a method defined within the plugin extension referenced by the handle.  Provide the method with the arguments listed in ARGS, do not continue processing the iRule until a response is received.}
        source {https://clouddocs.f5.com/api/irules/ILX__call.html}
        example {when CLIENT_ACCEPTED {
    # Get a handle to the running extension instance to call into.
    set RPC_HANDLE [ILX::init my_plugin my_extension]
    # Make the call and store the response in $rpc_response
    set rpc_response [ILX::call $RPC_HANDLE my_js_function arg1 arg2]
}}
        returns {The return value is the argument passed to response.reply() call on the extension side (eg. an array, a string, etc).}
    }
}

command ILX::init {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    # TODO(spectcl): `remote_method` is set on the source spec. — the loader
    #   has no reader for that property word yet.

    form Default {ILX::init (EXTENSION | (PLUGIN EXTENSION))}

    hover {
        summary {Creates a handle to a running ILX plugin extension.}
        synopsis {ILX::init (EXTENSION | (PLUGIN EXTENSION))}
        description {Creates a handle for future use by ILX::call and ILX::notify.  This handle is a reference to a running ILX plugin extension.  The lifetime of this variable affects the behavior of the ILX target if controlled by BIG-IP.  Instances of the plugin extension will be held in draining mode as long as there are open references to the ILX handle in any event.}
        source {https://clouddocs.f5.com/api/irules/ILX__init.html}
        example {when CLIENT_ACCEPTED {
    # Get a handle to the running extension instance to call into.
    set RPC_HANDLE [ILX::init my_plugin my_extension]
    # Make the call and store the response in $rpc_response
    set rpc_response [ILX::call $RPC_HANDLE my_js_function arg1 arg2]
}}
        returns {Returns a handle to the running extension to call into.}
    }
}

command ILX::notify {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    # TODO(spectcl): `remote_method` is set on the source spec. — the loader
    #   has no reader for that property word yet.

    form Default {ILX::notify HANDLE METHOD (ARGS)*}

    hover {
        summary {Calls an ILX method asynchronously.}
        synopsis {ILX::notify HANDLE METHOD (ARGS)*}
        description {Make a call to the plugin extension defined by the handle but do not wait for a response before continuing to process the remainder of the iRule. The delivery of the call to the plugin extension is "best effort" and is not guaranteed.}
        source {https://clouddocs.f5.com/api/irules/ILX__notify.html}
        example {when CLIENT_ACCEPTED {
    # Get a handle to the running extension instance to call into.
    set RPC_HANDLE [ILX::init my_plugin my_extension]
    # Make the asynchronous call
    ILX::notify $RPC_HANDLE my_js_function arg1 arg2
}}
        returns {None}
    }
}

command IMAP::activation_mode {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    form Default {IMAP::activation_mode (none | allow | require)?}

    hover {
        summary {Get or set the activation mode for IMAP STARTTLS.}
        synopsis {IMAP::activation_mode (none | allow | require)?}
        description {Sets the IMAP activation mode to none (IMAP STARTTLS detection will not activate), allow (IMAP will optionally activate TLS if client or server support STARTTLS), or require (IMAP will require that both client and server support STARTTLS). Returns the current activation mode if no option is specified.}
        source {https://clouddocs.f5.com/api/irules/IMAP__activation_mode.html}
        example {when CLIENT_ACCEPTED {
                if { ([IP::addr [IP::client_addr] equals 10.0.0.0/8]) } {
                    IMAP::activation_mode require
                }

                if { ([IP::addr [IP::client_addr] equals 10.0.0.0/8]) } {
                    set mode [IMAP::activation_mode]
                }
            }}
    }
}

