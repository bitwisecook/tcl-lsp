    }
}

command TCP::idletime {
    available {f5-irules}

    side_effect TcpState -reads -side Both

    form Default {TCP::idletime IDLE_TIME}

    hover {
        summary {Sets the TCP Idle Timeout.}
        synopsis {TCP::idletime IDLE_TIME}
        description {Sets the number of seconds before BIG-IP deletes connections with no traffic. A value of zero indicates no time limit.}
        source {https://clouddocs.f5.com/api/irules/TCP__idletime.html}
        example {when SERVER_CONNECTED {
    log local0. "Client: [client_addr]:[client_port] - Server: [server_addr]:[server_port]."
    # Set server-side idletime to 100.
