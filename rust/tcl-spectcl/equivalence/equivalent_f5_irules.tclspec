command persist {
    available {f5-irules}
    traits DIAGRAM_ACTION

    side_effect PersistenceTable -writes -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {persist <mode> ?args?}

    hover {
        summary {Sets the connection persistence type.}
        synopsis {persist none}
        synopsis {persist cookie (('insert' (COOKIE_NAME (EXPIRATION)?)?) | ('rewrite' (COOKIE_NAME (EXPIRATION)?)?) | ('passive' (COOKIE_NAME)?) | ('hash' COOKIE_NAME ( (<OFFSET LENGTH>)? (TIMEOUT)?)?))?}
        synopsis {persist source_addr (IPV4_MASK)? (TIMEOUT)?}
        synopsis {persist simple (IPV4_MASK)? (TIMEOUT)?}
        synopsis {persist mcp PERSIST_MCP_NAME}
        synopsis {persist add <mode> <key> ?timeout?}
        synopsis {persist lookup <mode> <key> ?all|node|port|pool?}
        synopsis {persist delete <mode> <key>}
        description {Causes the system to use the named persistence type to persist the
connection. Also allows direct inspection and manipulation of the
persistence table.}
        source {https://clouddocs.f5.com/api/irules/persist.html}
        example {when CLIENTSSL_HANDSHAKE {
   # Persist the client connection based on the SSL session ID
    persist ssl
}}
    }

    subcommand none { arity 0 ; detail {Disable persistence for this connection.} ; synopsis {persist none} }
    subcommand cookie { detail {Use cookie persistence.} ; synopsis {persist cookie ?insert|rewrite|passive|hash ...?} }
    subcommand source_addr { arity ..2 ; detail {Use source-address persistence.} ; synopsis {persist source_addr ?mask? ?timeout?} }
    subcommand simple { arity ..2 ; detail {Use simple persistence.} ; synopsis {persist simple ?mask? ?timeout?} }
    subcommand dest_addr { arity ..2 ; detail {Use destination-address persistence.} ; synopsis {persist dest_addr ?mask? ?timeout?} }
    subcommand sticky { arity ..2 ; detail {Use sticky persistence.} ; synopsis {persist sticky ?mask? ?timeout?} }
    subcommand msrdp { arity ..1 ; detail {Use Microsoft Remote Desktop persistence.} ; synopsis {persist msrdp ?timeout?} }
    subcommand ssl { arity ..1 ; detail {Use SSL persistence.} ; synopsis {persist ssl ?timeout?} }
    subcommand uie { arity 1..2 ; detail {Use universal inspection engine persistence.} ; synopsis {persist uie <string> ?timeout?} }
    subcommand universal { arity 1..2 ; detail {Use universal persistence.} ; synopsis {persist universal <string> ?timeout?} }
    subcommand hash { arity 1..2 ; detail {Use hash persistence.} ; synopsis {persist hash <string> ?timeout?} }
    subcommand carp { arity 1..2 ; detail {Use CARP persistence.} ; synopsis {persist carp <string> ?timeout?} }
    subcommand sip { arity 1..2 ; detail {Use SIP persistence.} ; synopsis {persist sip <string> ?timeout?} }
    subcommand host { arity ..1 ; detail {Use host persistence.} ; synopsis {persist host ?timeout?} }

    subcommand mcp {
        arity 1
        detail {Use MCP persistence.}
        synopsis {persist mcp <persistence-name>}
        introduced_version 21.1.0

        hover {
            summary {Persists the connection using an MCP persistence name.}
            synopsis {persist mcp <persistence-name>}
            description {Uses MCP persistence for the supplied name. Introduced in BIG-IP 21.1.0.}
            source {https://clouddocs.f5.com/api/irules/persist.html}
            example {persist mcp persistence_name}
        }
    }

    subcommand add {
        arity 2..3
        detail {Add a persistence-table entry.}
        synopsis {persist add <mode> <key> ?timeout?}
        arg 0 -values-from persist-add-arg0
        versioned_arg_value 0 mcp -introduced 21.1.0
    }

    subcommand lookup {
        arity 2..3
        detail {Look up a persistence-table entry.}
        synopsis {persist lookup <mode> <key> ?all|node|port|pool?}
        arg 0 -values-from persist-add-arg0
        versioned_arg_value 0 mcp -introduced 21.1.0
    }

    subcommand delete {
        arity 2
        detail {Delete a persistence-table entry.}
        synopsis {persist delete <mode> <key>}
        arg 0 -values-from persist-add-arg0
        versioned_arg_value 0 mcp -introduced 21.1.0
    }
}

command pkg::create {
    traits {PURE OVERRIDABLE_LIBRARY_PROC}
    arity 6.. -step 2

    return_type String

    runtime_backing tcl-body {-package-source package.tcl}

    option -name -takes packageName -detail {Name of the package. Required.}
    option -version -takes packageVersion -detail {Version of the package. Required.}
    option -load -takes filespec \
        -detail {A {file ?procs?} list naming a library to load with `load`; procs, if given, lists the commands it supplies (empty or omitted sets up pkg_mkIndex-style direct loading instead). May be repeated. At least one -load or -source is required overall.}
    option -source -takes filespec \
        -detail {A {file ?procs?} list naming a Tcl script to load with `source`. May be repeated. At least one -load or -source is required overall.}

    form Default {::pkg::create -name packageName -version packageVersion ?-load filespec? ... ?-source filespec? ...}

    hover {
        summary {Construct a package ifneeded command for a package specification.}
        synopsis {::pkg::create -name packageName -version packageVersion ?-load filespec? ... ?-source filespec? ...}
        description {Builds the `package ifneeded name version script` command for a package and returns it as a string — pkg::create only assembles the command text, it never itself calls `package`, `load`, or `source`, so the caller (typically a pkgIndex.tcl, or a directly `eval`'d expression) is the one that runs it. -name and -version are always required; at least one -load or -source must also be given, and either may repeat to fold several files into the one generated script. Each -load filespec is a {file ?procs?} list: file is loaded with `load`, and the optional procs element lists the commands it supplies — when procs is empty or omitted, the generated script sets the package up for pkg_mkIndex-style direct loading instead of naming specific commands. Each -source filespec has the same {file ?procs?} shape but for a Tcl script file loaded with `source`. Tcl 8.4 through 8.6 document -load's target specifically as a binary library; Tcl 9.0 and 9.1 describe it simply as a library, with no other documented change.}
        source {Tcl packagens(n)}
        example {eval [::pkg::create -name mypkg -version 1.0 -source mypkg.tcl]
eval [::pkg::create -name mypkg -version 1.0 -load [list mypkg[info sharedlibextension] Mypkg_Init]]}
        returns {The generated package ifneeded command, as a string.}
    }
}

command pool {
    available {f5-irules}
    traits DIAGRAM_ACTION
    arity 1..4

    side_effect PoolSelection -writes -side Server

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {pool <pool_name> [member <addr> [<port>]]}

    hover {
        summary {Select a load-balancing pool for the current flow.}
        synopsis {pool <pool_name> [member <addr> [<port>]]}
        description {Can direct traffic to a pool, optionally pinning to a specific member.}
        source {https://clouddocs.f5.com/api/irules/pool.html}
    }
}

command priority {
    available {f5-irules}
    traits {IRULES_TOP_LEVEL_ONLY SETS_EVENT_PRIORITY}
    arity 1

    side_effect ConnectionControl -writes -side Both

    # TODO(spectcl): `irules_top_level_effect` is set on the source spec. The
    #   DSL spells it `irules_top_level_effect Priority|Timing`, but a draft
    #   records only that the field is set, never the expression that set it.

    form Default {priority EVENT_PRIORITY}

    hover {
        summary {Sets the order of execution for iRule events.}
        synopsis {priority EVENT_PRIORITY}
        description {The priority command is used as an attribute associated with any iRule
event. When the iRules are loaded into the internal iRules engine for a
given virtual server, they are stored in a table with the event name
and a priority (with a default of 500).
Lower numbered priority events are evaluated before higher numbered
priority events: When an event is triggered an event, the irules engine
passes control to each of the code blocks for that given event in the
order of lowest to highest priority.}
        source {https://clouddocs.f5.com/api/irules/priority.html}
        example {when CLIENT_ACCEPTED {
       log "Client [IP::remote_addr] connected"
    }}
    }
}

command proc {
    available {f5-irules}
    traits {NEVER_INLINE_BODY DEFINES_PROCEDURE IRULES_TOP_LEVEL_ONLY DEFERS_BODY BODY_RUNS_IN_OWN_FRAME}
    arity 3

    body_kind Structural
    # TODO(spectcl): `procedure_definition` is set on the source spec. The DSL
    #   spells it `procedure_definition -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    arg 0 -role Name
    arg 1 -role ParamList
    arg 2 -role Body

    lowering_hook -native Proc
    analyser_hook -native Proc

    side_effect ProcDefinition -writes -side Global
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    form Default {proc NAME ARGUMENT_N_DEFAULT PROC_SCRIPT}

    hover {
        summary {Define an iRule proc.}
        synopsis {proc NAME ARGUMENT_N_DEFAULT PROC_SCRIPT}
        description {Define an iRule proc which is called by iRule command call.

The syntax is same as basic TCL proc command.}
        source {https://clouddocs.f5.com/api/irules/proc.html}
        example {when CLIENT_DATA {
    call logme "Coming to CLIENT_DATA"
}}
        returns {Returns the value in the return command, if any, in the proc script.}
    }
}

