command FIX::tag {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requirement_forms` is set on the source spec. The
    #   DSL spells it `event_requirement_form {word …} ?-only-in {E …}? ?{
    #   … }?`, but a draft records only that the field is set, never the
    #   expression that set it.

    form Default {FIX::tag map set SENDER DATA_GROUP}

    hover {
        summary {Defines/deletes the mapping between senderCompID and a tag map data group.}
        synopsis {FIX::tag map set SENDER DATA_GROUP}
        synopsis {FIX::tag map delete}
        synopsis {FIX::tag get TAG}
        description {This command can either retrieve tag value or update the mapping
between senderCompID and a tag map data group. In latter case If a
mapping is already defined in the profile attributes for
sender-tag-map, it is overwritten by the iRule mapping.}
        source {https://clouddocs.f5.com/api/irules/FIX__tag.html}
        example {when RULE_INIT {
  # with the follow command, tag 10001 is replaced to 20001 for the messages sent by client_1
  # before sending to pool member and reverse-replaced(20001 to 10001) to client_1
  FIX::tag map set client_1 data_group_1
  FIX::tag map set client_2 data_group_1
  FIX::tag map set client_3 data_group_2
}}
    }
}

command FLOW::create_related {
    available {f5-irules}

    side_effect FlowState -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -translation-loose -detail {Option -translation-loose.}
    option -hairpin -detail {Option -hairpin.}

    form Default {FLOW::create_related (((-translation-loose) (-hairpin))#)? (FLOW_CREATE_RELATED_SUBCMDS)+}

    hover {
        summary {Creates a related client side and server side flow.}
        synopsis {FLOW::create_related (((-translation-loose) (-hairpin))#)? (FLOW_CREATE_RELATED_SUBCMDS)+}
        description {Creates a related connection. Each related connection has two flows in it, a clientside flow and a serverside flow. The clientside flow is created using
the information provided in "clientflow" and serverside flow is created using the information provided in the "serverflow". Both these flows are linked
together and form a connection. BIGIP excepts that the the first packet always comes from the client side of the connection for all protocols except UDP.
The returned TCL handle points to the clientside flow. [FLOW::peer] command can be used to get a handle to the peer flow.}
        source {https://clouddocs.f5.com/api/irules/FLOW__create_related.html}
        # TODO(spectcl): `hover` holds text no Tcl word carries verbatim — an
        #   unbalanced brace or a backslash-newline. A braced word is the only
        #   faithful spelling, so the statement is dropped rather than written
        #   down wrong.
        returns {TCL handle for the client side flow. On error an exception is thrown with a message indicating the cause of failure. The string representation of the TCL handle can be used to retrieve the flow details.}
    }
}

command FLOW::idle_duration {
    available {f5-irules}

    side_effect FlowState -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {FLOW::idle_duration ANY_CHARS}

    hover {
        summary {Returns the time in seconds when the flow was last used.}
        synopsis {FLOW::idle_duration ANY_CHARS}
        description {Returns the time in seconds when the flow was last used.}
        source {https://clouddocs.f5.com/api/irules/FLOW__idle_duration.html}
        example {when CLIENT_DATA {
            # Log and refresh the related flow whenever the client sends data.
            log local0. "Flow idle duration before refresh [FLOW::idle_duration $result]"
            FLOW::refresh $result
            log local0. "Flow idle duration after refresh [FLOW::idle_duration $result]"
            TCP::release
            TCP::collect

        }}
        returns {Returns the time in seconds when the flow was last used.}
    }
}

command FLOW::idle_timeout {
    available {f5-irules}

    side_effect FlowState -reads -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {FLOW::idle_timeout (ANY_CHARS) (NONNEGATIVE_INTEGER)?}

    hover {
        summary {Sets/Gets the idle timeout on the flow}
        synopsis {FLOW::idle_timeout (ANY_CHARS) (NONNEGATIVE_INTEGER)?}
        description {Sets/Gets the idle timeout on the flow.}
        source {https://clouddocs.f5.com/api/irules/FLOW__idle_timeout.html}
        example {when SERVER_CONNECTED {
    set cf [FLOW::this]

    #Get flow idletimeout
    log local0. "Idle timeout: [FLOW::idle_timeout $cf]"

    #Set flow idletimeout
    FLOW::idle_timeout $cf 100

    unset cf
}}
        returns {Set operation: Nothing is returned Get operation: Idle timeout set on the flow as number string. On error an exception is thrown with a message indicating the cause of failure.}
    }
}

command FLOW::peer {
    available {f5-irules}

    side_effect FlowState -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {FLOW::peer ANY_CHARS}

    hover {
        summary {Returns the TCL flow handle for the peer flow.}
        synopsis {FLOW::peer ANY_CHARS}
        description {Returns the TCL flow handle for the peer flow.}
        source {https://clouddocs.f5.com/api/irules/FLOW__peer.html}
        example {when SERVER_CONNECTED {
    # Get server side flow handle.
    set cf [FLOW::this]

    # Get client side flow handle.
    set peer [FLOW::peer $cf]
    log local0. "Peer flow is $peer"
    unset cf peer
}}
        returns {TCL handle for the peer flow. On error an exception is thrown with a message indicating the cause of failure.}
    }
}

command FLOW::priority {
    available {f5-irules}

    side_effect FlowState -reads -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {FLOW::priority FLOW_PRIORITY}

    hover {
        summary {Set/Get flow's internal packet priority.}
        synopsis {FLOW::priority FLOW_PRIORITY}
        synopsis {FLOW::priority (clientside | serverside) (FLOW_PRIORITY)?}
        synopsis {FLOW::priority (ANY_CHARS) (FLOW_PRIORITY)?}
        description {This command is used to get/set the flow's internal packet priority.
Valid priority is any integer value from 0 to 7.
Syntax:
FLOW::priority [TCL handle|clientside|serverside] [priority]

Following are the variations of this command:

FLOW::priority

 Returns the internal packet priority of current flow.

Flow::priority <priority>

 Sets the priority of the current flow's internal packet priority.
 Exception is thrown if priority is outside the allowed range [0-7].

FLOW::priority clientside

 Returns the priority of the clientside flow's internal packet priority.}
        source {https://clouddocs.f5.com/api/irules/FLOW__priority.html}
        example {when SERVER_CONNECTED {
  FLOW::priority serverside 4

  # Alternate way to use the command using the TCL flow handle.
  # Set priority on both client side and server side flow.
  FLOW::priority $clientflow 2
  FLOW::priority [FLOW::this] 2
}}
        returns {Get operation returns an integer between 0-7. Set operation returns nothing. Exception is thrown if the operation cannot be completed.}
    }
}

command FLOW::refresh {
    available {f5-irules}

    side_effect FlowState -writes -side Both

