        description {Enables or disables TCP explicit congestion notification.
When enabled, respond to explicit router notification of congestion by invoking the TCP congestion response.
See RFC3168 for details.}
        source {https://clouddocs.f5.com/api/irules/TCP__ecn.html}
        example {when SERVER_CONNECTED {
    log local0. "Client: [client_addr]:[client_port] - Server: [server_addr]:[server_port]."
    TCP::ecn disable
}}
        returns {None.}
    }
}

command TCP::enhanced_loss_recovery {
    available {f5-irules}

    side_effect TcpState -reads -writes -side Both

    form Default {TCP::enhanced_loss_recovery BOOL_VALUE}

    hover {
        summary {Toggles enhanced loss recovery.}
        synopsis {TCP::enhanced_loss_recovery BOOL_VALUE}
        description {Enables or disables enhanced loss recovery which recovers from random packet loss more effectively.}
        source {https://clouddocs.f5.com/api/irules/TCP__enhanced_loss_recovery.html}
        example {when CLIENT_ACCEPTED {
    TCP::enhanced_loss_recovery enable
}}
