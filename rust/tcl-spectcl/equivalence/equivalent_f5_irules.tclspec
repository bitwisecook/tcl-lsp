    hover {
        summary {Returns TCP header and payload information.}
        synopsis {DATAGRAM::tcp (flags | payload_length | window)}
        synopsis {DATAGRAM::tcp (option | option_count) (IPV4_OPTION)?}
        synopsis {DATAGRAM::tcp payload (LENGTH)?}
        description {This iRules command returns tcp header information.
Note: throws an error if L4 protocol of the current connection is not
TCP

DATAGRAM::tcp flags

     * This command returns TCP header flags as an integer value.

DATAGRAM::tcp option

     * This command returns a Tcl list of TCP options. See
       DATAGRAM::ip option for details on behavior.

DATAGRAM::tcp option [option-code]

     * This command returns a Tcl list of TCP option values for TCP option
       with a given option code. See DATAGRAM::ip option for details
       on behavior.}
        source {https://clouddocs.f5.com/api/irules/DATAGRAM__tcp.html}
        example {when FLOW_INIT {
  if { [IP::protocol] == 6 } {
    log local0. "TCP Flow: [IP::client_addr] [TCP::client_port] --> [IP::local_addr] [TCP::local_port]"
    log local0. "TCP Payload Length = [DATAGRAM::tcp payload_length] Payload: [DATAGRAM::tcp payload 100]"
  }
}}
    }
}

command DATAGRAM::udp {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DATAGRAM::udp payload (LENGTH)?}

    hover {
        summary {Returns UDP payload information.}
        synopsis {DATAGRAM::udp payload (LENGTH)?}
        synopsis {DATAGRAM::udp payload_length}
        description {This iRules command returns UDP payload information.
Note: throws an error if L4 protocol of the current connection is not
UDP

DATAGRAM::udp payload [<size>]

     * Returns the content of the current UDP payload. If <size> is specified and more than <size>
       bytes are available, only the first <size> bytes of collected data are returned.

DATAGRAM::udp payload_length

     * Returns the length, in bytes, of the current UDP payload.}
        source {https://clouddocs.f5.com/api/irules/DATAGRAM__udp.html}
        example {when FLOW_INIT {
  if { [IP::protocol] == 17 } {
     log local0. "UDP Flow: [IP::client_addr] [UDP::client_port] --> [IP::local_addr] [UDP::local_port]"
     log local0. "UDP Payload Length = [DATAGRAM::udp payload_length] Payload: [DATAGRAM::udp payload 100]"
   }
}}
    }
}

