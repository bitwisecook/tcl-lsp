    hover {
        summary {Set the activation mode.}
        synopsis {LDAP::activation_mode (none | allow | require)}
        description {Sets the activation mode to none (it will never activate), allow (if the SMTP client sends STARTTLS, we will activate TLS), or require (all commands will be rejected until STARTTLS is received).}
        source {https://clouddocs.f5.com/api/irules/LDAP__activation_mode.html}
        example {when CLIENT_ACCEPTED {
                if { !([IP::addr [IP::client_addr] ne 10.0.0.0/8) } {
                    LDAP::activation_mode require
                }
            }}
    }
}

