        synopsis {encoding names}
        synopsis {encoding profiles}
        synopsis {encoding system ?encoding?}
        synopsis {encoding user}
        description {convertfrom/convertto move data between Tcl's internal string representation and an external encoding, defaulting to the current system encoding when encoding is omitted. names lists the available encodings (utf-8 and iso8859-1 are always present); system gets or sets the encoding used whenever Tcl passes strings to system calls. dirs (Tcl 8.5+) sets the search path for additional *.enc encoding data files. Tcl 9.0 added the profiles and user subcommands, plus a -profile/-failindex option pair on convertfrom/convertto (TIP 656): -profile picks how a conversion error is handled — strict (the default) raises an exception, tcl8 reproduces Tcl 8.6's lenient byte-mapping/'?'-substitution behaviour, and replace substitutes U+FFFD (or '?' on non-UTF convertto targets) — and -failindex var returns the successfully-converted prefix instead of raising, storing the index of the failing byte (convertfrom) or character (convertto) in var, or -1 if none failed. Code relying on Tcl 8.6's old silent lenient behaviour needs -profile tcl8 under Tcl 9.0+, since strict is now the default.}
        source {Tcl encoding(n)}
        example {encoding names
encoding system
set s [encoding convertfrom utf-8 $bytes]
set bytes [encoding convertto -profile strict iso8859-1 $s]
if {[catch {encoding convertfrom -profile strict -failindex idx ascii $data} result]} {
    puts "bad byte at $idx: $result"
}}
        returns {Depends on the subcommand: convertfrom returns the decoded string, convertto the encoded byte sequence; dirs/names/profiles return a list; system/user return an encoding name. dirs and system also act as setters, in which case they return the empty string.}
    }

    subcommand convertfrom {
        arity 1..6
        detail {Convert data from the specified encoding to a Tcl string; if encoding is omitted, uses the current system encoding.}
        synopsis {encoding convertfrom ?encoding? data}
        traits {UNCONDITIONAL_VARIABLE_WRITE TAINT_SOURCE}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        is_unescape
        side_effect Variable -writes -available {tcl 9.0-}

        option -profile -takes profile -values-from encoding-convertfrom-profile -closed -available {tcl 9.0-} \
            -detail {Encoding profile controlling how a conversion error is handled; defaults to strict.}
        option -failindex -takes var -role VarWrite -available {tcl 9.0-} \
            -detail {Variable to receive the index of the source byte that triggered a conversion error, or -1 if none did. When given, returns the successfully-converted prefix instead of raising an exception on failure.}
    }

    subcommand convertto {
        arity 1..6
        detail {Convert a Tcl string to the specified encoding, returning a byte sequence; if encoding is omitted, uses the current system encoding.}
        synopsis {encoding convertto ?encoding? data}
        traits UNCONDITIONAL_VARIABLE_WRITE
        return_type ByteArray
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        byte_array_effect Encodes

        refine value {
            arity 1..2
            traits FRAMELESS_RUNTIME
            side_effect InterpState -reads
        }
        side_effect Variable -writes -available {tcl 9.0-}

        option -profile -takes profile -values-from encoding-convertfrom-profile -closed -available {tcl 9.0-} \
            -detail {Encoding profile controlling how a conversion error is handled; defaults to strict.}
        option -failindex -takes var -role VarWrite -available {tcl 9.0-} \
            -detail {Variable to receive the index of the source character that triggered a conversion error, or -1 if none did. When given, returns the successfully-converted prefix instead of raising an exception on failure.}
    }

    subcommand dirs {
        arity ..1
        detail {Get or set the search path for *.enc encoding data files. It is an error for directoryList not to be a valid list; an unreadable/unsearchable directory in it is silently ignored when searching.}
        synopsis {encoding dirs ?directoryList?}
        available {tcl 8.5-}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        side_effect InterpState -reads -writes
    }

    subcommand names {
        arity 0
        detail {Return a list of the names of all currently available encodings. utf-8 and iso8859-1 are always present.}
        synopsis {encoding names}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }

    subcommand system {
        arity ..1
        detail {Get or set the system encoding, used whenever Tcl passes strings to system calls.}
        synopsis {encoding system ?encoding?}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        side_effect InterpState -reads -writes
    }

    subcommand profiles {
        arity 0
        detail {Return a list of the names of the available encoding profiles (strict, tcl8, replace).}
        synopsis {encoding profiles}
        available {tcl 9.0-}
        return_type List
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }

    subcommand user {
        arity 0
        detail {Return the encoding matching the user's platform preferences: on Windows, derived from the user's code-page registry setting; on other platforms, the same value as encoding system.}
        synopsis {encoding user}
        available {tcl 9.0-}
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }
}

command error {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD TERMINATES_BLOCK NEEDS_START_CMD BYTE_COMPILED FRAMELESS_RUNTIME CATCHABLE_THROW}
    arity 1..3

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    inline_codegen_hook -native Error
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect InterpState -writes

    runtime_backing shipped-builtin error

    form Default {error message ?info? ?code?}

    hover {
        summary {Generate an error}
        synopsis {error message ?info? ?code?}
        description {Returns a TCL_ERROR code that unwinds command interpretation, catchable with catch (or, from Tcl 8.6 on, try). message becomes the error result. The optional info, when given, seeds the -errorinfo return option (the errorInfo global in Tcl 8.4) and suppresses the interpreter's own first increment of stack-trace information — the command containing this error call is then omitted from the trace and info appears in its place, letting a catch handler graft a previously captured trace onto a re-thrown error. The optional code, when given, becomes the -errorcode return option (the errorCode global in Tcl 8.4), a machine-readable error identifier conventionally formatted as a list; when code is omitted, errorCode/-errorcode is reset to "NONE". From Tcl 8.5 on, prefer catching with the options-dictionary form and re-throwing via `return -options` over hand-copying errorInfo, since it preserves errorCode and every other return option too.}
        source {Tcl error(n)}
        example {if {$divisor == 0} {
    error "cannot divide by zero" "" {ARITH DIVZERO {divide by zero}}
}

# Re-throw with the original trace and error code intact (Tcl 8.5+)
if {[catch {doWork} result options]} {
    return -options $options $result
}}
        returns {Never returns to the caller: unconditionally completes with a TCL_ERROR whose result is message, catchable by an enclosing catch (or, from Tcl 8.6 on, try).}
    }
}

command eval {
    available {tcl 8.4-} {f5-irules}
    traits {LANGUAGE_KEYWORD CREATES_BARRIER EVALUATES_CODE TAINT_SINK CREATES_DYNAMIC_BARRIER BYTE_COMPILED NOT_PROC_FACTORY DYNAMIC_EVAL_BODY SCRIPT_CONCATENATES_ARGS}
    arity 1..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Body

    lowering_hook -native Eval

    side_effect Unknown
    # TODO(spectcl): `frame_effect` is set on the source spec. The DSL spells it
    #   `frame_effect -level-word W -layout L`, but a draft records only that
    #   the field is set, never the expression that set it.

    taint_sink_safe_colour LIST_CANONICAL

    xc_translatable no
    runtime_backing shipped-builtin eval

    form Default {eval arg ?arg ...?}

    hover {
        summary {Evaluate one or more arguments as a Tcl script.}
        synopsis {eval arg ?arg ...?}
        description {Concatenates all of its arguments in the same fashion as `concat`, then passes the result to the Tcl interpreter recursively as a script, evaluated in the caller's own variable/procedure context — unlike `uplevel`, `eval` never changes stack frame.

Because the `list` command quotes words so that they are not further expanded by `eval`, `eval [list $a $b $c]` and `$a $b $c` are equivalent for any values of $a, $b, and $c; this is what makes it safe to rebuild and re-run a command from a `list`-built value.

**Security**: any argument built from unsanitised input becomes arbitrary code once concatenated and evaluated — `eval` is a taint sink. In the common case of expanding a pre-built word list, prefer `{*}$cmdList` (Tcl 8.5+) instead: it is less general than `eval` but, since it never re-parses the words as script text, far easier to keep safe.}
        source {Tcl eval(n)}
        example {set script {puts "logging now"}
eval $script

# Safe: list-quoted words are not re-split, so this is equivalent to
# calling the command directly.
set cmd [list string index $line 0]
eval $cmd

# Prefer {*} to expand a pre-built word list instead (Tcl 8.5+):
set argsList [list -nocase $pattern $line]
set matched [string match {*}$argsList]}
        returns {The result of evaluating the concatenated script, or the error it raises — propagated as eval's own result, including any -errorinfo/-errorcode/-level the script's error carried.}
    }
}

command event {
    available {f5-irules}
    traits DIAGRAM_ACTION

    irules_source_flow EventControl

    side_effect ConnectionControl -writes -side Both

    form Default {event info}

    hover {
        summary {Enables or disables evaluation of the specified iRule event or all iRule events on this connection.}
        synopsis {event info}
        synopsis {event (enable | disable) ('all')?}
        synopsis {event EVENTNAME (enable | disable)}
        description {Enables or disables evaluation of the specified iRule event, or all
iRule events, on this connection. However, the iRule continues to run.

**Pattern — after drop/reject**: Always follow `drop` or `reject`
with `event disable all` and `return` to prevent other iRules from
running on the now-invalid connection.}
        source {https://clouddocs.f5.com/api/irules/event.html}
        example {when HTTP_RESPONSE {
  COMPRESS::method prefer gzip
  event disable
}}
    }
}

command expr {
    available {tcl 8.4-} {f5-irules}
    traits {PURE_EVALUATION NEEDS_START_CMD TAINT_SINK BYTE_COMPILED NOT_PROC_FACTORY FRAMELESS_RUNTIME EXPR_CONCATENATES_ARGS}
    arity 1..

    return_type Numeric
    representation_effect {CoerceExpressionValues 0}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Expr -type Numeric -shimmers

    lowering_hook -native Expr
    inline_codegen_hook -native Expr

    side_effect Unknown -reads

    runtime_backing shipped-builtin expr

    form Default {expr arg ?arg arg ...?}

    hover {
        summary {Evaluate a Tcl expression.}
        synopsis {expr arg ?arg arg ...?}
        description {**Always brace expressions**: `expr {$a + $b}`.

Without braces, `expr $x + 1` undergoes double substitution: the Tcl parser expands `$x` first, then `expr` evaluates the result. If `$x` contains `[dangerous_command]`, it executes. Bracing also enables bytecode compilation for better performance — and does not fully neutralise the risk, since a bracketed command inside a braced expression (`expr {[cmd]}`) is still executed as part of evaluating the operand.

Operands may be numbers, booleans (any form `string is boolean` accepts), `$variables`, double- or brace-quoted strings, bracketed commands, or `func(...)` calls into the `tcl::mathfunc` namespace (Tcl 8.5+; in 8.4 math functions exist only as expr syntax, with no namespace-command form).

The expression grammar has grown over releases. Tcl 8.5 added the exponentiation operator `**`, the list-membership operators `in`/`ni`, `Inf`/`NaN` floating-point literals, explicit `0b`/`0o` integer prefixes, and switched integer arithmetic to arbitrary precision (LibTomMath) — Tcl 8.4 computed integers with fixed-width C `long`/`wide` types. Tcl 9.0 added the always-UNICODE-string relational operators `lt`/`gt`/`le`/`ge`, an explicit `0d` decimal prefix, `_` digit separators (`1_000_000`), and removed the ambiguous "leading zero means octal" reading (`013` is decimal 13, not octal 11, as of 9.0).

In F5 iRules, `expr` runs on an embedded Tcl 8.4.6 core, so none of the 8.5+/9.0+ additions above are available: no `**`, `in`/`ni`, `lt`/`gt`/`le`/`ge`, `Inf`/`NaN`, or `0b`/`0o`/`0d` prefixes, and integers stay fixed-width.}
        source {Tcl expr(n)}
        example {expr {8.2 + 6}
expr {($x*$x - $y*$y) / exp($x*$x + $y*$y)}
expr {$a eq $b ? "equal" : "different"}
set randNum [expr {int(100 * rand())}]}
        returns {The value of the evaluated expression — typically numeric, but a bare operand (e.g. `expr {$x}`) or a ternary branch can pass through an arbitrary string or list value unchanged.}
    }
}

command fasthash {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    form Default {fasthash DATA}

    hover {
        summary {Returns a hash for the specified string.}
        synopsis {fasthash DATA}
        description {fasthash is guaranteed to return a high quality hash of the input as quickly as practical. The hash value returned is between 0 and 2^63-1 inclusive (a positive integer).

fasthash was added because there are many use cases (ie CARP) which need a hash of some value (ie URI) and which were using crc32 (which is a bad and slow hash function).

Note: fasthash does not guarantee to provide the same hash value across different BIGIP versions and over BIGIP reboots. Do not use fasthash for long term and persistent storage.}
        source {https://clouddocs.f5.com/api/irules/fasthash.html}
        example {when CLIENT_ACCEPTED {
    set str "hello world"
    log local0. "hash of $str is [fasthash $str]"
}}
        returns {Returns the numeric hash for the specified string}
    }
}

command findclass {
    available {f5-irules}

    side_effect DataGroup -reads -side Global

    deprecated_replacement {class match / class search}

    form Default {findclass STRING DATA_GROUP (SEPARATOR)?}

    hover {
        summary {Searches a data group list for a member that starts with the specified string and returns the data-group member string.}
        synopsis {findclass STRING DATA_GROUP (SEPARATOR)?}
        description {Searches a data group list for a member whose key matches the specified
string, and if a match is found, returns the data-group member string.

Note: findclass has been deprecated in v10 in favor of the new
class commands. The class command offers better functionality and
performance than findclass
Only the key value of the data group list member (the portion up to the
first separator character, which defaults to space unless otherwise
specified) is compared to the specified string to determine a match.}
        source {https://clouddocs.f5.com/api/irules/findclass.html}
        example {when HTTP_REQUEST {
  set location [findclass [HTTP::uri] URIredirects_dg " "]
  if { $location ne "" } {
    HTTP::redirect $location
  }
}}
    }
}

command findstr {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    form Default {findstr STRING SEARCH_STRING (}

    hover {
        summary {Finds a string within another string and returns the string starting at the offset specified from the match.}
        synopsis {findstr STRING SEARCH_STRING (}
        description {A custom iRule function which finds a string within another string
and returns the string starting at the offset specified from the match.}
        source {https://clouddocs.f5.com/api/irules/findstr.html}
        example {when RULE_INIT {
  set static::payload {<meta HTTP-EQUIV="REFRESH" CONTENT="0; URL=https://host.domain.com/path/file.ext?...&var=val">}
  set static::term {">}
  set urlresponse [findstr $static::payload URL= 4 $static::term]
  log local0. "urlresponse $urlresponse"
}}
    }
}

command for {
    available {tcl 8.4-} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD HAS_BOOLEAN_COND HAS_LOOP_BODY NEVER_INLINE_BODY BYTE_COMPILED NOT_PROC_FACTORY}
    arity 4

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Body -layout InlineScript
    arg 1 -role Expr -type Boolean -shimmers
    arg 2 -role Body -layout InlineScript
    arg 3 -role Body

    clause_grammar {
        head Body -timing init
        once Expr
        once Body -timing next
        tail Body -timing per-iteration
        selection all
    }

    lowering_hook -native For

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin for

    form Default {for start test next body}

    hover {
        summary {C-style loop with init, test, and next scripts.}
        synopsis {for start test next body}
        description {`start` (a Tcl script) runs once before the loop begins. Before each pass, `test` is evaluated as an expression; the loop continues while it is non-zero. After `body` runs, `next` runs, then `test` is re-evaluated. `continue` inside `body` skips the rest of that pass and jumps straight to `next` and the next `test` check; `break` inside `body` or `next` ends the loop immediately. Either way `for` itself returns an empty string. `test` should almost always be written in braces (e.g. `{$i < 10}`): an unbraced `test` is substituted once, before the loop starts, so it never sees changes `next` or `body` make and typically runs forever.}
        source {Tcl for(n)}
        example {for {set i 0} {$i < 10} {incr i} {
    puts $i
}}
        returns {An empty string.}
    }
}

command foreach {
    available {tcl 8.4-} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD HAS_LOOP_BODY NEVER_INLINE_BODY LOOP_LIST_HEADER BYTE_COMPILED NOT_PROC_FACTORY}
    arity 3.. -step 2

    return_type String
    var_write_typing {ElementsOf 0}
    representation_effect {CoerceOrdinaryListPairs 0}
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -type List -shimmers
    repeat LoopVarList -stride 2 -exclude-trailing 1

    clause_grammar {
        group 0 -timing per-iteration
        tail Body -timing per-iteration
        selection all
    }

    arg_role_count_resolver -native foreach::arg_role_count_resolver
    arg_role_resolver_roles Body
    lowering_hook -native Foreach
    analyser_hook -native Foreach

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin foreach

    form Default {foreach varlist1 list1 ?varlist2 list2 ...? body}

    hover {
        summary {Iterate over one or more lists, assigning loop variables from each.}
        synopsis {foreach varname list body}
        synopsis {foreach varlist1 list1 ?varlist2 list2 ...? body}
        description {In the simple form, varname takes on each value of list in turn and body runs once per value. In the general form, each varlist/list pair is handled independently: on every iteration, the variables of each varlist are assigned consecutive values from its corresponding list, as if by lindex. Iteration continues until every value from every list has been used exactly once — enough passes to exhaust the longest list — and a list too short for its varlist supplies empty strings for the missing elements on later passes. break and continue inside body behave exactly as they do in for. foreach itself always returns an empty string, regardless of what body does.}
        source {Tcl foreach(n)}
        example {foreach x {a b c} {
    puts $x
}
foreach {name value} {height 6 width 8} {
    puts "$name = $value"
}
foreach x {1 2 3} y {a b} {
    puts "$x $y"
}}
        returns {An empty string.}
    }
}

command format {
    available {tcl 8.4-} {f5-irules}
    traits {PURE CSE_CANDIDATE BYTE_COMPILED FRAMELESS_RUNTIME}
    arity 1..

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    byte_array_effect Coerces
    format_string_type Sprintf
    arg 0 -role FormatString

    const_fold_versioned -native format::const_fold_versioned
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.
    # TODO(spectcl): `dispatch_dependencies` is set on the source spec. — a
    #   pack may not author this field.
    # TODO(spectcl): `result_stability` is set on the source spec. The DSL
    #   spells it `result_stability
    #   Unknown|ReferentiallyTransparent|Volatile|{ReadsVersionedWorld {D
    #   …}}`, but a draft records only that the field is set, never the
    #   expression that set it.

    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `state_transitions` is set on the source spec. The DSL
    #   spells it `state_transitions NAME|{ composition … argument_shape …
    #   resolver none|from-frame-effect|-native ID|{words ctx} {…} widen …
    #   covers … commit … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    runtime_backing shipped-builtin format

    form Default {format formatString ?arg arg ...?}

    hover {
        summary {Format a string in the style of C's sprintf.}
        synopsis {format formatString ?arg arg ...?}
        description {Scans formatString left to right, copying text through unchanged except where a % introduces a conversion specifier that consumes the next arg (or, with an %n$ position, an explicit one — once any specifier in the string is positional, every specifier must be). A specifier is %[n$][flags][width][.precision][size]verb: the flags are - (left-justify instead of the default right-justify), + (always show a sign), space (a leading space on a non-negative number), 0 (zero-pad instead of space-pad), and # (alternate form: on every version it forces a decimal point on a float and preserves %g's trailing zeros; for the integer verbs, before Tcl 9.0 it adds a leading 0 on octal or 0x/0X on hex (matching the verb's case) or, from Tcl 8.6, 0b on binary, while from Tcl 9.0 octal instead gets an 0o prefix, hex always gets a lowercase 0x prefix, and decimal gains a new 0d prefix). width and precision may each be a literal number or * to take the value from the next argument; precision means digits after the point for e/f, total significant digits for g, a minimum digit count (zero-padded) for the integer verbs, and a maximum character count for s. Conversion verbs: d/i (signed decimal), u (unsigned decimal), o (unsigned octal), x/X (unsigned hex), b (unsigned binary — Tcl 8.6 and later only), c (integer codepoint to character), s (string, unconverted), f (fixed-point), e/E (scientific notation), g/G (the shorter of f or e, with trailing zeros stripped), and %% for a literal percent. Tcl 9.0 and later also accept a/A (hexadecimal floating-point) and p (shorthand for 0x%zx). An optional size modifier before the verb (h or l; also ll from Tcl 8.5, and I, I32, I64, z, t, L, j, or q from Tcl 9.0) controls the integer conversion's truncation width but is ignored for the float verbs and for %c/%s. Two widths depend on the build's C ABI: before Tcl 9.0 an unmodified integer conversion is C long wide, and from 9.0 z, t and p are pointer wide; tcl-lsp evaluates both as 64 bits, as a 64-bit Unix (LP64) build does, where 64-bit Windows and 32-bit builds may differ. Too few arguments, or a malformed specifier, raises an error; unused trailing arguments are ignored.}
        source {Tcl man page format.n}
        example {format {Hello, %s! You are %d years old.} $name $age
format %05.2f $pi
format {%#x} 255
format {%-10s|} $label}
        returns {The formatted string.}
    }
}

command forward {
    available {f5-irules}

    side_effect ConnectionControl -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {forward}

    hover {
        summary {Sets the connection to forward IP packets.}
        synopsis {forward}
        description {Sets the connection to forward IP packets. This is strict forwarding
and will bypass any pool configured on the virtual server.
The request will be forwarded out the appropriate interface according
to the routes in the LTM routing table. No destination address or port
translation is performed.}
        source {https://clouddocs.f5.com/api/irules/forward.html}
        example {when CLIENT_ACCEPTED {
  if { [class match [IP::client_addr] equals my_hosts_class]} {
    snat 192.168.100.12
  } else {
    forward
  }
}}
    }
}

