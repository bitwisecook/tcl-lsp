command HTTP::password {
    available {f5-irules}
    traits REQUIRES_HTTP_CONTEXT

    side_effect HttpHeader -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {HTTP::password}

    hover {
        summary {Returns the password part of HTTP basic authentication.}
        synopsis {HTTP::password}
        description {Returns the password part of HTTP basic authentication.
As described in RFC2617 the username and password in basic
authentication is sent by the client in the Authorization header. The
client base64 encodes the username and password in the format of:
Authorization: Basic base64encoding(username:password)
The HTTP::username command parses and base64 decodes the username.
The HTTP::password command parses and base64 decodes the password.}
        source {https://clouddocs.f5.com/api/irules/HTTP__password.html}
        example {when CLIENT_ACCEPTED {
  set auth_sid [AUTH::start pam default_radius]
}}
    }
}

command HTTP::path {
    available {f5-irules}
    traits {PURE CSE_CANDIDATE UNNORMALISED_HTTP_GETTER REQUIRES_HTTP_CONTEXT DIAGRAM_ACTION}

    side_effect HttpUri -reads -side Both

    taint_source {TAINTED PATH_PREFIXED}
    setter_constraint 0 -prefix / -code IRULE3101 \
        -message {HTTP::path value must start with '/'}
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -normalized \
        -detail {Return the canonicalised path (URL evasion patterns rejected).}

    form Getter {HTTP::path ?-normalized?}
    form Setter {HTTP::path <PATH_VALUE>}

    hover {
        summary {Returns or sets the path part of the HTTP request.}
        synopsis {HTTP::path (PATH_VALUE)?}
        description {Returns or sets the path part of the HTTP request. The path is defined
as the path and filename in a request. It does not include the query string.
For the following URL: http://www.example.com:8080/main/index.jsp?user=test&login=check

The path is: /main/index.jsp

Note that only ? is used as the separator for the query string.
So, for the following URL: http://www.example.com:8080/main/index.jsp;session_id=abcdefgh?user=test&login=check

The path is: /main/index.jsp;session_id=abcdefgh

**Best practice**: Prefer `HTTP::path` over `HTTP::uri` when you
only need the path without the query string. Use `-normalized`
for consistent matching (prevents URL-encoding evasion).}
        source {https://clouddocs.f5.com/api/irules/HTTP__path.html}
        example {when HTTP_REQUEST {
  log local0. "\[HTTP::path\] original: [HTTP::path]"
  HTTP::path [string tolower [HTTP::path]]
}}
        returns {Returns the path part of the HTTP request.}
    }
}

