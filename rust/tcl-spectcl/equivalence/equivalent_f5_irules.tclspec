    #   field is set, never the expression that set it.
    # TODO(spectcl): `event_requirement_forms` is set on the source spec. The
    #   DSL spells it `event_requirement_form {word …} ?-only-in {E …}? ?{
    #   … }?`, but a draft records only that the field is set, never the
    #   expression that set it.
    # TODO(spectcl): `data_collection` is set on the source spec. The DSL spells
    #   it `data_collection -native ID`, but a draft records only that the field
    #   is set, never the expression that set it.

    form Default {MQTT::payload ?subcommand? ?args?}

    hover {
        summary {Manipulate payload of MQTT PUBLISH message}
        synopsis {MQTT::payload ?subcommand? ?args?}
        synopsis {MQTT::payload length}
        synopsis {MQTT::payload replace <data> ?offset? ?length?}
        description {This command can be used to manipulate payload of MQTT message.
This command is valid only for following MQTT message types:

    PUBLISH}
        source {https://clouddocs.f5.com/api/irules/MQTT__payload.html}
        example {#Example: Redirect PUBLISH that has payloads with blocked keywords defined in
#blacklisted_keywords_datagroup in first 200 bytes. Prepend a admin message in
#the payload.
#
when MQTT_CLIENT_INGRESS {
    set type [MQTT::type]
    switch $type {
       "PUBLISH" {
          if { [class exists  blacklisted_keywords_datagroup] } {
             MQTT::collect 200
          }
       }
    }
}}
        returns {When called without an argument, this command returns the collected payload of MQTT PUBLISH message.}
    }

    subcommand length {
        arity 0
        detail {Get payload length.}
        synopsis {MQTT::payload length}
        pure
        side_effect NetworkIo -reads -side Both
    }

    subcommand replace {
        arity 1..3
        detail {Replace payload data.}
        synopsis {MQTT::payload replace <data> ?offset? ?length?}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand prepend {
        arity 1
        detail {Prepend data to payload.}
        synopsis {MQTT::payload prepend <data>}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }

    subcommand append {
        arity 1
        detail {Append data to payload.}
        synopsis {MQTT::payload append <data>}
        mutator
        side_effect NetworkIo -reads -writes -side Both
    }
}

