command when {
    available {f5-irules}
    traits {LANGUAGE_KEYWORD IS_EVENT_HANDLER IRULES_TOP_LEVEL_ONLY DEFERS_BODY BODY_RUNS_IN_OWN_FRAME}
    arity 2..6

    body_kind Structural
    arg 1 -values-from when-arg1
    arg 2 -values-from when-arg2
    defines_symbol -name-arg 0 -kind Event

    arg_role_count_resolver -native when::arg_role_count_resolver
    arg_role_resolver_roles Body
    lowering_hook -native When

    side_effect InterpState -writes -side Global

    # TODO(spectcl): `event_handler_priority` is set on the source spec. The DSL
    #   spells it `event_handler_priority -default N ?-warn-implicit?`, but a
    #   draft records only that the field is set, never the expression that set
    #   it.

    form Default {when EVENT { body }}
    form Default {when EVENT priority N { body }}

    hover {
        summary {Declare an iRules event handler block.}
        synopsis {when EVENT { body }}
        synopsis {when EVENT priority N { body }}
        synopsis {when EVENT timing enable|disable { body }}
        description {`body` runs whenever the specified BIG-IP event fires.}
        source {https://clouddocs.f5.com/api/irules/when.html}
    }
}

command whereis {
    available {f5-irules}

    side_effect BigipConfig -reads -side Global

    form Default {whereis (ldns | IP_ADDR)}

    hover {
        summary {Returns geographical information on an IP address.}
        synopsis {whereis (ldns | IP_ADDR)}
        description {Returns the geographic location of a specific IP address.
For more information on using whereis in LTM, you can check Jason
Rahm's article

Legal usage notes

   The data is purchased by F5 for use on BIG-IP systems and products for
   traffic management. The key to understanding EULA compliance is to
   figure out where the geolocation decision is being made.}
        source {https://clouddocs.f5.com/api/irules/whereis.html}
    }
}

command while {
    available {tcl 8.4-} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD HAS_BOOLEAN_COND HAS_LOOP_BODY NEVER_INLINE_BODY BYTE_COMPILED NOT_PROC_FACTORY}
    arity 2

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    arg 0 -role Expr -type Boolean -shimmers
    arg 1 -role Body

    clause_grammar {
        head Expr
        tail Body -timing per-iteration
        selection all
    }

    lowering_hook -native While

    side_effect Unknown -reads -writes

    runtime_backing shipped-builtin while

    form Default {while test body}

    hover {
        summary {Execute script repeatedly as long as a condition is met.}
        synopsis {while test body}
        description {test is evaluated as an expression, the same way expr evaluates its argument, and the result must be a proper boolean value. While it is true, body is executed by passing it to the Tcl interpreter; once body finishes, test is evaluated again, and the cycle repeats until test becomes false. continue inside body terminates the current iteration and jumps straight to the next test check; break inside body causes immediate termination of the whole loop. Either way while itself always returns an empty string. test should almost always be enclosed in braces, e.g. {$x < 10}: an unbraced test is substituted once, before the loop starts, so it never sees changes body makes to the variables involved and this is likely to result in an infinite loop. Enclosing test in braces delays variable substitution until the expression is evaluated before each iteration, so changes body makes are visible on the next check.}
        source {Tcl while(n)}
        example {set x 0
while {$x < 10} {
    puts "x is $x"
    incr x
}

set lineCount 0
while {[gets $chan line] >= 0} {
    puts "[incr lineCount]: $line"
}}
        returns {An empty string.}
    }
}

command xff_list {
    available {f5-irules}
    arity ..1

    side_effect HttpHeader -reads -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {xff_list ?xff_header_name?}

    hover {
        summary {Return a sorted, deduplicated list of valid non-loopback IP addresses from the X-Forwarded-For header.}
        synopsis {call xff_list}
        synopsis {call xff_list "X-Real-IP"}
        description {Also known as `xff_uniq_sorted_ip_list`.  Collects all addresses from the named header (default `X-Forwarded-For`), even when the header appears multiple times.

  - Entries that are not IPv4 or IPv6 are removed
  - Both IPv4 and IPv6 addresses are collected and returned
  - The result is sorted; duplicate IPs are collapsed
  - FQDNs are not valid IPs and are therefore removed
  - Loopback / zero addresses (`127.0.0.0/8`, `0.0.0.0/32`, `::/127`) are filtered out

Useful for geolocation or blacklist lookups against forwarded addresses.}
        source {https://clouddocs.f5.com/api/irules/xff_list.html}
        example {when HTTP_REQUEST priority 350 {
    foreach ip [call xff_list] {
        if {[class match -- $ip eq "blacklist-ips"]} {
            log local0. "Blocking bad XFF IP: $ip"
            reject
            return
        }
    }
}}
        returns {A Tcl list of unique, sorted IP address strings.}
    }
}

command xff_uniq_ordered_ip_list {
    available {f5-irules}
    arity ..1

    side_effect HttpHeader -reads -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {xff_uniq_ordered_ip_list ?xff_header_name?}

    hover {
        summary {Return a deduplicated list of valid non-loopback IP addresses from the X-Forwarded-For header, preserving the original header order.}
        synopsis {call xff_uniq_ordered_ip_list}
        synopsis {call xff_uniq_ordered_ip_list "X-Real-IP"}
        description {Like `xff_uniq_sorted_ip_list` but preserves the original header order instead of sorting.  Use this when the order of IPs in the headers matters (e.g. tracing the proxy chain).  It comes with a memory and performance penalty over the sorted `xff_list` so should only be used when truly necessary.

  - Entries that are not IPv4 or IPv6 are removed
  - Both IPv4 and IPv6 addresses are collected and returned
  - The order of the request IPs is preserved
  - Duplicate IPs are collapsed
  - FQDNs are not valid IPs and are therefore removed
  - Loopback / zero addresses (`127.0.0.0/8`, `0.0.0.0/32`, `::/127`) are filtered out}
        source {https://clouddocs.f5.com/api/irules/xff_uniq_ordered_ip_list.html}
        example {when HTTP_REQUEST priority 350 {
    foreach ip [call xff_uniq_ordered_ip_list] {
        if {[class match -- $ip eq "blacklist-ips"]} {
            log local0. "Blocking bad XFF IP: $ip"
            reject
            return
        }
    }
}}
        returns {A Tcl list of unique IP address strings in original header order.}
    }
}

command xff_uniq_sorted_ip_list {
    available {f5-irules}
    arity ..1

    side_effect HttpHeader -reads -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {xff_uniq_sorted_ip_list ?xff_header_name?}

    hover {
        summary {Return a sorted, deduplicated list of valid non-loopback IP addresses from the X-Forwarded-For header.}
        synopsis {call xff_uniq_sorted_ip_list}
        synopsis {call xff_uniq_sorted_ip_list "X-Real-IP"}
        description {Collects all addresses from the named header (default `X-Forwarded-For`), even when the header appears multiple times.

  - Entries that are not IPv4 or IPv6 are removed
  - Both IPv4 and IPv6 addresses are collected and returned
  - The result is sorted; duplicate IPs are collapsed
  - FQDNs are not valid IPs and are therefore removed
  - Loopback / zero addresses (`127.0.0.0/8`, `0.0.0.0/32`, `::/127`) are filtered out

See also: `xff_list` (convenience alias), `xff_uniq_ordered_ip_list` (preserves header order).}
        source {https://clouddocs.f5.com/api/irules/xff_uniq_sorted_ip_list.html}
        example {when HTTP_REQUEST priority 350 {
    foreach ip [call xff_uniq_sorted_ip_list] {
        if {[class match -- $ip eq "blacklist-ips"]} {
            log local0. "Blocking bad XFF IP: $ip"
            reject
            return
        }
    }
}}
        returns {A Tcl list of unique, sorted IP address strings.}
    }
}

}
