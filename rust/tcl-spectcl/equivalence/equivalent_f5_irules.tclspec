command CACHE::header {
    available {f5-irules}

    side_effect StreamProfile -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {CACHE::header ('exists' | 'remove' | 'value') HEADER_NAME}

    hover {
        summary {Get/modify the content of an header related to an object stored in the RAM Cache.}
        synopsis {CACHE::header ('exists' | 'remove' | 'value') HEADER_NAME}
        synopsis {CACHE::header ('insert' | 'replace') HEADER_NAME HEADER_VALUE}
        description {The command is used to gather or modify the content of a header stored
in the cache.

CACHE::header <name>

     * Get the content of the requested header

CACHE::header insert <name> <value>

     * Add the header with the specified value to the list of headers sent to the
       client when delivering an object from the cache.

CACHE::header remove <name>

     * Remove the header with the specified name.

CACHE::header replace <name> <value>

     * Replace the header with the specified value.

CACHE::header value <name>

     * Return the header value for the specified header name.}
        source {https://clouddocs.f5.com/api/irules/CACHE__header.html}
        example {when CACHE_UPDATE {
    # cached object's headers manipulation
    # modifications will be seen whenever the object is served from cache
    CACHE::header replace Server Big-IP-Server
}}
    }
}

command CACHE::headers {
    available {f5-irules}

    side_effect StreamProfile -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {CACHE::headers}

    hover {
        summary {Returns the HTTP headers of the object in the cache.}
        synopsis {CACHE::headers}
        description {Returns the HTTP headers of the object in the cache.
If CACHE::header is used to manipulate the response headers prior to calling CACHE::headers, the modifications will not be reflected by CACHE::headers.

CACHE::headers

     * Returns the HTTP headers of the object in the cache as TCL Name / value pairs list.}
        source {https://clouddocs.f5.com/api/irules/CACHE__headers.html}
        example {when CACHE_RESPONSE {
  # log all  HTTP headers sent in cache response.
  log local0. [CACHE::headers]
}}
        returns {Returns the HTTP headers of the object in the cache as TCL Name / value pairs list.}
    }
}

