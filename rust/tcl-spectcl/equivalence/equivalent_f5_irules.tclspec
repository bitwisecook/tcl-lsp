        summary {Returns the number of bytes held in memory via TCP::collect.}
        synopsis {TCP::offset}
        description {Returns the number of bytes currently held in memory via
TCP::collect. This data is available via TCP::payload.}
        source {https://clouddocs.f5.com/api/irules/TCP__offset.html}
        example {when CLIENT_ACCEPTED {
  TCP::collect
}}
        returns {The number of bytes collected.}
    }
}

command TCP::option {
    available {f5-irules}
    arity 2..4

    side_effect TcpState -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {TCP::option <get|set|noset> <kind> ?value? ?all?}

    hover {
        summary {Retrieves or changes TCP header options.}
        synopsis {TCP::option get <kind>}
        synopsis {TCP::option set <kind> <value> ?all?}
        synopsis {TCP::option noset <kind>}
        description {Gets or sets the value of the specified option of the TCP header.
The TCP::option get command is only functional when BIG-IP has been configured to collect options before the iRule is called. In v10, this is done with a db variable and is effective only on the clientside. When called in the serverside context it returns an error indicating that the specified option was not configured for collection.

In v11, this is configured through the TCP profile and the command can be used in either the serverside context or the clientside, depending on the profile configuration.}
        source {https://clouddocs.f5.com/api/irules/TCP__option.html}
        example {#Insert the client REAL IP (mostly used when the client IP is SNATted).
when SERVER_CONNECTED {
    scan [IP::client_addr] {%d.%d.%d.%d} a b c d
    TCP::option set 29 [binary format cccc $a $b $c $d] all
}}
        returns {With the "get" keyword, returns the specified TCP option kind value. If the requested option kind was not configured for collection, an error indicating so is returned instead. If the option kind was specified but has not yet been seen on the current connection, the command returns null.}
    }

    subcommand get {
        arity 1
        detail {Get TCP option value.}
        synopsis {TCP::option get <kind>}
        pure
        side_effect TcpState -reads -side Both
    }

    subcommand set {
        arity 2..3
        detail {Set TCP option value.}
        synopsis {TCP::option set <kind> <value> ?all?}
        mutator
        side_effect TcpState -reads -writes -side Both
    }

    subcommand noset {
        arity 1
        detail {Prevent option from being set.}
        synopsis {TCP::option noset <kind>}
        mutator
        side_effect TcpState -writes -side Both
    }
}

command TCP::pacing {
    available {f5-irules}

    side_effect TcpState -reads -writes -side Both

    form Default {TCP::pacing (BOOL_VALUE)?}

    hover {
        summary {Toggles TCP rate pacing.}
        synopsis {TCP::pacing (BOOL_VALUE)?}
        description {Rate pacing limits the data send rate to the physical limitations of the interface to reduce the chance of queue drops.}
        source {https://clouddocs.f5.com/api/irules/TCP__pacing.html}
        example {when SERVER_CONNECTED {
    log local0. "Client: [client_addr]:[client_port] - Server: [server_addr]:[server_port]."
    # Set client-side rate pacing to enabled.
    clientside {
        log local0. "Client: pacing [TCP::pacing], enabling"
        TCP::pacing enable
    }
    # Set server-side rate pacing to disabled.
    serverside {
        log local0. "Server: pacing [TCP::pacing], disabling"
        TCP::pacing disable
    }
}}
        returns {TCP::pacing returns whether TCP rate pacing is enabled.}
    }
}

command TCP::payload {
    available {f5-irules}
    arity ..4

    byte_array_payload -replace-data-index 3
    default_form_first_word Integer

    side_effect TcpState -reads -writes -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `data_collection` is set on the source spec. The DSL spells
    #   it `data_collection -native ID`, but a draft records only that the field
    #   is set, never the expression that set it.

    form Getter {TCP::payload ?<size>?}

    hover {
        summary {Returns or changes the data collected by TCP::collect.}
        synopsis {TCP::payload ?<size>?}
        synopsis {TCP::payload replace <offset> <length> <data>}
        synopsis {TCP::payload length}
        description {Returns the accumulated TCP data content, or replaces collected payload with the specified data.}
        source {https://clouddocs.f5.com/api/irules/TCP__payload.html}
        example {when CLIENT_ACCEPTED {
  TCP::collect
}}
    }

    refine collected-bytes {
        arity ..1
    }

    subcommand replace {
        arity 3
        detail {Replace bytes in collected payload.}
        synopsis {TCP::payload replace <offset> <length> <data>}
        mutator
    }

    subcommand length { arity 0 ; detail {Returns the amount of accumulated TCP data in bytes.} ; synopsis {TCP::payload length} }
}

