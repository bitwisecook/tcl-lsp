command ASM::login_status {
    available {f5-irules}

    side_effect AsmState -reads -side Client

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {ASM::login_status}

    hover {
        summary {Request status of the login session tracked by one of the login pages defined in the policy.}
        synopsis {ASM::login_status}
        description {Returns status of the login session tracked by one of the login pages defined in the policy. Following are the possible values:

                not_logged_in: The request is not within a login session.
                logging_in: The request is to a login URL.
                logged_in: The request is within a login session, indicates a successful login in the ASM_RESPONSE_LOGIN event.
                failed: The login attempt is failed, triggered only in the ASM_RESPONSE_LOGIN event.}
        source {https://clouddocs.f5.com/api/irules/ASM__login_status.html}
        example {when ASM_RESPONSE_LOGIN {
                if {[ASM::login_status] eq "logged_in"} {
                    log local0. "User [ASM::username] logged in succesfully."
                }
                else {
                    log local0. "Login attempt to [ASM::username] failed."
                }
            }}
        returns {Returns status of the login session.;}
    }
}

