This command is valid only for following MQTT message types:

    CONNECT}
        source {https://clouddocs.f5.com/api/irules/MQTT__protocol_name.html}
        example {# Upgrade protocol from 3.1 to 3.1.1
when MQTT_CLIENT_INGRESS {
   set type [MQTT::type]
   switch $type {
       "CONNECT" {
          if {[MQTT::protocol_version] == 3 } {
