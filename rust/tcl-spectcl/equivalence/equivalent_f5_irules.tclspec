command incr {
    available {tcl 8.4-} {f5-irules}
    traits {READS_BEFORE_WRITE BYTE_COMPILED FRAMELESS_RUNTIME FIRST_ARG_VARNAME}
    arity 1..2
    safe_on_uninit tcl8.5+

    return_type Int
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `native_result` is set on the source spec. The DSL spells
    #   it `native_result -native CONTRACT`, but a draft records only that the
    #   field is set, never the expression that set it.
    arg 0 -role VarWrite -type Int -shimmers
    arg 1 -type Int -shimmers
    assigns_variable_at 0

    lowering_hook -native Incr
    inline_codegen_hook -native Incr
    # TODO(spectcl): `completion` is set on the source spec. The DSL spells it
    #   `completion {CODE …}`, but a draft records only that the field is set,
    #   never the expression that set it.

    side_effect Variable -reads -writes
    # TODO(spectcl): `world_effects` is set on the source spec. The DSL spells
    #   it `world_effects none|NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    runtime_backing shipped-builtin incr

    form Default {incr varName ?increment?}

    hover {
        summary {Increment the value of a variable}
        synopsis {incr varName ?increment?}
        description {Increments the value stored in the variable whose name is varName; the variable's current value must be an integer. If increment is given, its value (also an integer) is added to varName; otherwise 1 is added. The new value is stored as a decimal string in varName and also returned as the result. From Tcl 8.5 onward, varName may be unset: it is then initialised to increment (or the default of 1) instead of raising a "no such variable" error. From Tcl 9.0 onward, incrementing a non-existent element of an array that has a default value (see `array default`) stores the sum of that default and the increment, rather than just the increment (or 1). `incr x 0` is a common idiom for validating that x already holds an integer without changing it.}
        source {Tcl incr(n)}
        example {set count 0
incr count       ;# count is now 1
incr count 41    ;# count is now 42
incr count 0     ;# validates count is an integer without changing it
incr total 5     ;# Tcl 8.5+: total is unset, so it's initialised to 5}
        returns {The variable's new value: an integer, stored as a decimal string.}
    }

    refine implicit {
        arity 1
        arg 0 -role VarWrite
        lowering_hook -native Incr
    }

    refine explicit {
        arity 2
        arg 0 -role VarWrite
        lowering_hook -native Incr
    }
}

command info {
    available {tcl 8.4-} {f5-irules}
    traits BYTE_COMPILED
    arity 1..

    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.

    side_effect InterpState -reads

    runtime_backing shipped-builtin info

    form Default {info option ?arg arg ...?}

    hover {
        summary {Information about the state of the Tcl interpreter}
        synopsis {info option ?arg arg ...?}
        description {A large introspection ensemble; option names may be abbreviated to any unambiguous prefix. Covers procedure metadata (args, body, default, procs), variable metadata (exists, vars, globals, locals), and command/interpreter/environment metadata (commands, cmdcount, complete, level, loaded, hostname, library, nameofexecutable, patchlevel, script, sharedlibextension, tclversion). Tcl 8.5 adds stack-frame introspection (frame). Tcl 8.6 adds coroutine, errorstack, and the TclOO info class/info object introspection subcommands. Tcl 9.0 adds cmdtype, constant, consts, an optional prefix argument to loaded, and extends the TclOO introspection with creationid, definitionnamespace, and properties. Tcl 9.1 makes no further changes to info.}
        source {Tcl info(n)}
        example {if {[info exists myVar]} {
    puts $myVar
}
foreach p [info procs helper*] {
    puts "found $p"
}
puts "Tcl [info tclversion] (patchlevel [info patchlevel])"}
        returns {Varies by subcommand: most return a string, list, or boolean. info level and info frame return an integer when called with no argument, and a list or dictionary respectively when given one. See each subcommand's own description for its exact shape.}
    }

    subcommand version {
        arity 0
        detail {Returns the major and minor version of the Jim interpreter.}
        synopsis {info version}
        dialects jim
        return_type String
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        pure
    }

    subcommand stacktrace {
        arity 0
        dialects jim
        # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
        #   spells it `native_compilation -native CONTRACT`, but a draft records
        #   only that the field is set, never the expression that set it.
        side_effect InterpState -reads
    }

    subcommand args {
        arity 1
