    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DATAGRAM::ip6 hop_limit}

    hover {
        summary {Returns ipv6 header information.}
        synopsis {DATAGRAM::ip6 hop_limit}
        synopsis {DATAGRAM::ip6 (option | option_count) (IPV6_OPTION)?}
        description {This iRules command returns ipv6 header information.
Note: throws an error when used with IPv4

DATAGRAM::ip6 hop_limit

     * This command returns IPv6 hop limit as an integer value.

DATAGRAM::ip6 option

     * This command returns a Tcl list of IPv6 options from reassembled
       IPv6 datagram. Each option is a Tcl list with one or two values -
       option code (integer), and option value (byte array) if option has
       the value. Multiple options with the same code will be returned as
       separate sublists.}
        source {https://clouddocs.f5.com/api/irules/DATAGRAM__ip6.html}
    }
}

