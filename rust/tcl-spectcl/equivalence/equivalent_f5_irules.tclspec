command LB::queue {
    available {f5-irules}

    side_effect PoolSelection -writes -side Server

    form Default {LB::queue queued}

    hover {
        summary {Returns queue information.}
        synopsis {LB::queue queued}
        synopsis {LB::queue on}
        synopsis {LB::queue limit}
        synopsis {LB::queue depth}
        description {Returns queue information. Connection queuing details:

    * Operates at the TCP level
    * Only engages when the connection limit is hit
    * Queue is specified by length, time, or both (in the pool configuration)
    * Queues operate per-tmm, there is no state sharing
        * Length limit divided by tmm count
        * FIFO guarantees only per-tmm
    * Queued at the pool level for non-persistent connections
    * Queued at the pool member level for persistent connections.}
        source {https://clouddocs.f5.com/api/irules/LB__queue.html}
        example {when LB_QUEUED {
    log local0. "[IP::local_addr] was queued - [LB::queue depth one pool1] / [LB::queue limit depth pool1]"
}}
        returns {LB::queue limit depth|time [<pool name>] Returns queue limit info (depth is per-tmm)}
    }
}

command LB::reselect {
    available {f5-irules}

    side_effect PoolSelection -writes -side Server

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {LB::reselect (clone pool POOL_OBJ (member IP_ADDR)?)?}

    hover {
        summary {Advance to the next available node in a pool.}
        synopsis {LB::reselect (clone pool POOL_OBJ (member IP_ADDR)?)?}
        synopsis {LB::reselect pool POOL_OBJ (member ((IP_ADDR PORT) |}
        synopsis {LB::reselect snat (automap |}
        synopsis {LB::reselect snatpool SNAT_POOL_OBJ (member IP_ADDR)?}
        description {This command is used to advance to the next available node in a pool, either using the load balancing settings of that pool, or by specifying a member explicitly. Note that the reselect may not happen immediately; it may wait until the current iRule event is completely finished executing.

There is no reselect retry limit built into the command: You MUST implement a limiting mechanism in your iRule using logic similar to that in the examples below.}
        source {https://clouddocs.f5.com/api/irules/LB__reselect.html}
        example {when CLIENT_ACCEPTED {
    set def_pool [LB::server pool]
    set lb_fails 0
}}
    }
}

