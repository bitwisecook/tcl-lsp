command SIP::route_status {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {SIP::route_status}

    hover {
        summary {Returns the routing status of the current message.}
        synopsis {SIP::route_status}
        description {The SIP::route_status command returns the routing status of the current
message. Valid status are:
  * "unprocessed"
  * "route found"
  * "no route found"
  * "dropped"
  * "queue full"
  * "no connection"
  * "connection closing"
  * "internal error"

"route found" is based on the SIP RouteTable finding a route. It is not
effected by the proxy’s ability to create a connection, so even if the
server is not listening on the specified address or marked down, it
might still return status as "route found" if the RouteTable is able to
find the route.}
        source {https://clouddocs.f5.com/api/irules/SIP__route_status.html}
        example {when SIP_RESPONSE_SEND {
  log local0. [SIP::route_status]
}}
        returns {Returns routing status of the current message}
    }
}

