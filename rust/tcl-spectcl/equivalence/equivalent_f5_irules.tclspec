command ACCESS::perflow {
    available {f5-irules}

    side_effect ApmState -reads -side Both

    form Default {ACCESS::perflow <get|set> <key> ?value?}

    hover {
        summary {Returns perflow variable value}
        synopsis {ACCESS::perflow get KEY}
        synopsis {ACCESS::perflow set ( 'perflow.custom' | 'perflow.scratchpad' | 'perflow.custom.flow' | 'perflow.scratchpad.flow' | 'perflow.l7_protocol_lookup.result' ) VALUE}
        description {This command can be used to either set or return the value of a perflow variable that has been set inside the Access Per-Request Policy that is being run.

            ACCESS::perflow get <var> will return the value of any perflow variable that has already been set. A perflow variable with no value set will return an empty string. An invalid perflow variable name will give a connection reset.

            ACCESS::perflow set <var> <val> will set the value of the custom perflow variable. Currently the only perflow variables that can be set are "perflow.custom", "perflow.}
        source {https://clouddocs.f5.com/api/irules/ACCESS__perflow.html}
        example {when ACCESS_PER_REQUEST_AGENT_EVENT {
                set id [ACCESS::perflow get perflow.irule_agent_id]

                if { $id eq "irule_agent_one" } {
                    log local0. "Made it to iRule agent in perrequest policy."
                    ACCESS::perflow set perflow.custom "agent_one"
                }
            }}
        returns {ACCESS::perflow get will return the string of perflow variable; empty if value isn't set}
    }

    subcommand get {
        arity 1
        detail {Get a perflow variable value.}
        synopsis {ACCESS::perflow get <key>}
        pure
        side_effect ApmState -reads -side Both
    }

    subcommand set {
        arity 2
        detail {Set a perflow variable value.}
        synopsis {ACCESS::perflow set <key> <value>}
        mutator
        arg 0 -values-from access-perflow-set-arg0
        side_effect ApmState -reads -writes -side Both
    }
}

command ACCESS::policy {
    available {f5-irules}

    side_effect ApmState -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {ACCESS::policy <subcommand> ?args?}

    hover {
        summary {Return information about access policies.}
        synopsis {ACCESS::policy agent_id}
        synopsis {ACCESS::policy evaluate ('-sid' SESSION_ID)}
        synopsis {ACCESS::policy result (-sid SESSION_ID)?}
        synopsis {ACCESS::policy uri}
        description {The ACCESS::policy commands allow you to retrieve information about the
access policies in place for a given connection.

ACCESS::policy agent_id

     * Returns the identifier for the agent raising the
       ACCESS_POLICY_AGENT_EVENT.

ACCESS::policy result

     * Returns back the result of an access policy. The result will be one
       of following:
     * - allow
     * - deny
     * - redirect

ACCESS::policy uri

     * Returns TRUE if current request URI is internal to ACCESS (v11+
       only).}
        source {https://clouddocs.f5.com/api/irules/ACCESS__policy.html}
        example {when CLIENT_CLOSED {
    # To avoid clutter, remove the access session for the flow.
    ACCESS::session remove -sid $flow_sid
}}
    }

    subcommand agent_id {
        arity 0
        detail {Get the agent identifier.}
        synopsis {ACCESS::policy agent_id}
        pure
        side_effect ApmState -reads -side Both
    }

    subcommand evaluate {
        detail {Evaluate an access policy.}
        synopsis {ACCESS::policy evaluate ?-sid id?}
        side_effect ApmState -reads -writes -side Both

        option -sid -takes SESSION_ID -detail {Session ID.}
    }

    subcommand result {
        detail {Get the policy result (allow/deny/redirect).}
        synopsis {ACCESS::policy result ?-sid id?}
        pure
        side_effect ApmState -reads -side Both

        option -sid -takes SESSION_ID -detail {Session ID.}
    }

    subcommand uri {
        arity 0
        detail {Check if URI is internal to ACCESS.}
        synopsis {ACCESS::policy uri}
        pure
        side_effect ApmState -reads -side Both
    }
}

command ACCESS::respond {
    available {f5-irules}

    side_effect ApmState -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -ifile -detail {Option -ifile.}
    option -content -takes {} -detail {Option -content.}

    form Default {ACCESS::respond STATUS_CODE (ifile | -ifile) IFILE_OBJ}

    hover {
        summary {This command generates new respond and automatically overrides the default respond.}
        synopsis {ACCESS::respond STATUS_CODE (ifile | -ifile) IFILE_OBJ}
        synopsis {ACCESS::respond STATUS_CODE (((('content' | '-content') CONTENT)}
        description {This command generates new respond and automatically overrides the
default respond. This command only can be used only once per HTTP
request, and subsequent calls to this command will return an error.

HTTP iRules should be used with caution after an ACCESS::respond call.
They may not behave as expected since ACCESS::respond creates an HTTP response.
As of version 13.0.0, the way that HTTP caching interacts with the
HTTP iRule commands has changed, so inconsistencies are expected when using
HTTP iRules after ACCESS::respond.}
        source {https://clouddocs.f5.com/api/irules/ACCESS__respond.html}
        example {when ACCESS_POLICY_COMPLETED {
    set policy_result [ACCESS::policy result]
    switch $policy_result {
    "allow" {
    # Do nothing
    }
    "deny" {
        ACCESS::respond 401 content "<html><body>Error: Failure in Authentication</body></html>" Connection Close
    }
    }
}}
    }
}

command ACCESS::restrict_irule_events {
    available {f5-irules}

    side_effect ApmState -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {ACCESS::restrict_irule_events (enable | disable)}

    hover {
        summary {Enable or disable HTTP and higher layer iRule events for the internal APM access control URIs.}
        synopsis {ACCESS::restrict_irule_events (enable | disable)}
        description {During access policy execution, ACCESS creates requests to various URIs
related to various access policy processing. These includes /my.policy
and other pages (logon, message box etc.) shown to the end user. By
default from 11.0.0 onward, HTTP and higher layer iRule events are not
raised for the internal access control URIs. All events except
ACCESS_SESSION_STARTED, ACCESS_SESSION_CLOSED,
ACCESS_POLICY_AGENT_EVENT, ACCESS_POLICY_COMPLETED are blocked (not
raised) for internal access control URI.
This command allows admin to overwrite the default behavior.}
        source {https://clouddocs.f5.com/api/irules/ACCESS__restrict_irule_events.html}
        example {when CLIENT_ACCEPTED {
    ACCESS::restrict_irule_events disable
}}
    }
}

command ACCESS::saml {
    available {f5-irules}

    side_effect ApmState -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {ACCESS::saml <subcommand> ?content?}

    hover {
        summary {Access or manipulate SAML related messages.}
        synopsis {ACCESS::saml authn (CONTENT)?}
        synopsis {ACCESS::saml assertion (CONTENT)?}
        synopsis {ACCESS::saml slo_req (CONTENT)?}
        synopsis {ACCESS::saml slo_resp (CONTENT)?}
        description {The different ACCESS::saml sub-commands allow you to
access or manipulate outgoing SAML request/response messages including
authentication request, assertion, single logout request and response.

ACCESS::saml authn

     * Returns the SAML authentication request payload generated by BIG-IP
       as service provider. Sets the SAML authentication request if given.

ACCESS::saml assertion

     * Returns the SAML assertion payload generated by BIG-IP as
       identity provider. Sets the SAML assertion if given.}
        source {https://clouddocs.f5.com/api/irules/ACCESS__saml.html}
        # TODO(spectcl): `hover` holds text no Tcl word carries verbatim — an
        #   unbalanced brace or a backslash-newline. A braced word is the only
        #   faithful spelling, so the statement is dropped rather than written
        #   down wrong.
    }

    subcommand authn {
        arity ..1
        detail {Get/set SAML authentication request.}
        synopsis {ACCESS::saml authn ?content?}
        pure
        mutator
        side_effect ApmState -reads -writes -side Both
    }

    subcommand assertion {
        arity ..1
        detail {Get/set SAML assertion.}
        synopsis {ACCESS::saml assertion ?content?}
        pure
        mutator
        side_effect ApmState -reads -writes -side Both
    }

    subcommand slo_req {
        arity ..1
        detail {Get/set SAML single logout request.}
        synopsis {ACCESS::saml slo_req ?content?}
        pure
        mutator
        side_effect ApmState -reads -writes -side Both
    }

    subcommand slo_resp {
        arity ..1
        detail {Get/set SAML single logout response.}
        synopsis {ACCESS::saml slo_resp ?content?}
        pure
        mutator
        side_effect ApmState -reads -writes -side Both
    }
}

command ACCESS::session {
    available {f5-irules}

    side_effect ApmState -reads -side Both

    option -flow -detail {Create a flow-scoped session.}
    option -timeout -takes SECONDS -detail {Session timeout in seconds.}
    option -lifetime -takes SECONDS -detail {Session lifetime in seconds.}
    option -sid -takes SESSION_ID -detail {Session ID.}
    option -remaining -takes {} -detail {Remaining time.}
    option -state_allow -detail {Check for allow state.}
    option -state_deny -detail {Check for deny state.}
    option -state_redirect -detail {Check for redirect state.}
    option -state_inprogress -detail {Check for in-progress state.}
    option -secure -detail {Access secure session data.}
    option -config -detail {Access config session data.}
    option -ssid -takes SESSION_ID -detail {Sub-session ID.}
    option --

    form Default {ACCESS::session <subcommand> ?options? ?args?}

    hover {
        summary {Access or manipulate session information.}
        synopsis {ACCESS::session create (('-flow')? ('-timeout' TIMEOUT)? ('-lifetime' LIFETIME)?)#}
        synopsis {ACCESS::session modify ('-sid' SESSION_ID)? (('-timeout' TIMEOUT)? (('-lifetime' LIFETIME)? | ('-remaining' REMAINING)?))#}
        synopsis {ACCESS::session exists ('-state_allow' | '-state_deny' | '-state_redirect' | '-state_inprogress')? (-sid)? (SESSION_ID)?}
        synopsis {ACCESS::session data get ('-sid' SESSION_ID)? ('-secure' | '-config')? KEY (-ssid SESSION_ID)?}
        description {The different permutations of the ACCESS::session command allow you to
access or manipulate different portions of session information when
dealing with APM requests.

ACCESS::session data get

     * Returns the value of session variable.

ACCESS::session data set [ ]

     * Sets the value of session variable to be the given.

ACCESS::session exists

     * This commands returns TRUE when the session with provided sid
       exists, and returns FALSE otherwise. This command is allowed to be
       executed in different events other then ACCESS events. This command
       added in version 10.}
        source {https://clouddocs.f5.com/api/irules/ACCESS__session.html}
        example {when ACCESS_ACL_ALLOWED {
set user [ACCESS::session data get "session.logon.last.username"]
HTTP::header insert "X-USERNAME" $user
}}
    }

    subcommand create {
        detail {Create a new session.}
        synopsis {ACCESS::session create ?-flow? ?-timeout secs? ?-lifetime secs?}
        mutator
        side_effect ApmState -reads -writes -side Both

        option -flow -detail {Create a flow-scoped session.}
        option -timeout -takes SECONDS -detail {Session timeout in seconds.}
        option -lifetime -takes SECONDS -detail {Session lifetime in seconds.}
    }

    subcommand modify {
        detail {Modify an existing session.}
        synopsis {ACCESS::session modify ?-sid id? ?-timeout secs? ?-lifetime secs?}
        mutator
        side_effect ApmState -reads -writes -side Both

        option -sid -takes SESSION_ID -detail {Session ID.}
        option -timeout -takes SECONDS -detail {Session timeout in seconds.}
        option -lifetime -takes SECONDS -detail {Session lifetime in seconds.}
        option -remaining -takes {} -detail {Remaining time.}
    }

    subcommand exists {
        arity ..1
        detail {Check if a session exists.}
        synopsis {ACCESS::session exists ?-sid id?}
        pure
        side_effect ApmState -reads -side Both

        option -sid -takes SESSION_ID -detail {Session ID.}
        option -state_allow -detail {Check for allow state.}
        option -state_deny -detail {Check for deny state.}
        option -state_redirect -detail {Check for redirect state.}
        option -state_inprogress -detail {Check for in-progress state.}
    }

    subcommand data {
        arity 1..
        detail {Get or set session data.}
        synopsis {ACCESS::session data <get|set> ?-sid id? <key> ?--? ?value?}
        arg 0 -values-from access-session-data-arg0
        side_effect ApmState -reads -writes -side Both

        option -sid -takes SESSION_ID -detail {Session ID.}
        option -secure -detail {Access secure session data.}
        option -config -detail {Access config session data.}
        option -ssid -takes SESSION_ID -detail {Sub-session ID.}
        option --
    }

    subcommand remove {
        detail {Remove a session.}
        synopsis {ACCESS::session remove ?-sid id?}
        mutator
        side_effect ApmState -reads -writes -side Both

        option -sid -takes SESSION_ID -detail {Session ID.}
    }

    subcommand sid {
        arity 0
        detail {Get the session ID.}
        synopsis {ACCESS::session sid}
        pure
        side_effect ApmState -reads -side Both
    }
}

command ACCESS::user {
    available {f5-irules}

    side_effect ApmState -reads -side Both

    form Default {ACCESS::user <subcommand> <arg>}

    hover {
        summary {Returns user ID information.}
        synopsis {ACCESS::user getkey SID_HASH}
        synopsis {ACCESS::user getsid KEY}
        synopsis {ACCESS::user ACCESS_USER_COMMAND (ACCESS_USER_INFO)?}
        description {The ACCESS::user commands return user ID information.

ACCESS::user getsid <key>

     * Returns the list of created external SIDs which is associated wit
       the specified key

ACCESS::user getkey <sid_hash>

     * Returns the original SID for specified hash of SID
     * This command works for clientless mode only

 * Requires APM module}
        source {https://clouddocs.f5.com/api/irules/ACCESS__user.html}
        example {when ACCESS_SESSION_STARTED {
    # Associate the user_key with the session by assigning the value.
    if { [ info exists user_key ] } {
        ACCESS::session data set "session.user.uuid" $user_key
    }
}}
    }

    subcommand getkey {
        arity 1
        detail {Get original SID from hash.}
        synopsis {ACCESS::user getkey <sid_hash>}
        pure
        side_effect ApmState -reads -side Both
    }

    subcommand getsid {
        arity 1
        detail {Get external SIDs for key.}
        synopsis {ACCESS::user getsid <key>}
        pure
        side_effect ApmState -reads -side Both
    }
}

command ACCESS::uuid {
    available {f5-irules}

    side_effect ApmState -reads -side Both

    form Default {ACCESS::uuid getsid SESSION_ID}

    hover {
        summary {Enumerates the session IDs that belongs to a specified uuid key by the order of its creation and provides them in a Tcl list.}
        synopsis {ACCESS::uuid getsid SESSION_ID}
        synopsis {ACCESS::uuid ACCESS_UUID_COMMAND (ACCESS_UUID_INFO)?}
        description {Enumerates the session IDs that belongs to a specified uuid key by the
order of its creation and provides them in a Tcl list. By default, the
uuid created by AAC is using the following format.
  * {profile_name}.{user_name}

However, the admin can manually override this by specifying their own
uuid key via assigning that value to session.user.uuid session
variable. This can be done via iRule using ACCESS::session data set
session.user.uuid or via VPE using Variable Assignment Agent. The
return value of ACCESS::uuid getsid is a Tcl list.}
        source {https://clouddocs.f5.com/api/irules/ACCESS__uuid.html}
        example {when HTTP_REQUEST {
    set apm_cookie_list [ ACCESS::uuid getsid "[PROFILE::access name].[HTTP::username]" ]
    log local0. "[PROFILE::access name].[HTTP::username] => session number [llength $apm_cookie_list]"
    for {set i 0} {$i < [llength $apm_cookie_list]} {incr i} {
        log local0. "MRHSession => [ lindex $apm_cookie_list $i]"
    }
}}
    }
}

command ACL::action {
    available {f5-irules}

    side_effect AsmState -reads -side Both

    form Default {ACL::action (default |}

    hover {
        summary {Sets or retrieves the current ACL action.}
        synopsis {ACL::action (default |}
        description {The ACL::action command allows you to determine the ACL action in the
FLOW_INIT event. This command requires the Advanced Firewall
Manager module.}
        source {https://clouddocs.f5.com/api/irules/ACL__action.html}
        example {when FLOW_INIT {
  if { [IP::addr [IP::client_addr] equals 172.29.97.151] } {
    ACL::action allow
    virtual /Common/my_http_vs
    log "FLOW_INIT: ACL allow to /Common/my_http_vs"
  }
}}
        returns {When no argument is provided, the command will return an integer value corresponding to an action that will be taken: + 0 is a drop + 1 is reset (or reject) + 2 is allow (or accept) + 3 is allow-final (or accept-decisively)}
    }
}

command ACL::eval {
    available {f5-irules}

    side_effect AsmState -reads -side Both

