    form Default {DNS::type RR_OBJECT (DNS_TYPE)?}

    hover {
        summary {Gets or sets the resource record type field.}
        synopsis {DNS::type RR_OBJECT (DNS_TYPE)?}
        description {This iRules command gets or sets the resource record type field

Note: This command functions only in the context of LTM iRules and
requires the DNS Profile, which is only enabled as part of GTM or the
DNS Services add-on.}
        source {https://clouddocs.f5.com/api/irules/DNS__type.html}
        example {when DNS_RESPONSE {
        set rrs [DNS::answer]
        foreach rr $rrs {
            if { [DNS::type $rr] == "SOA" } {
                DNS::answer remove $rr
            }
        }
    }}
    }
}

command DNSMSG::header {
    available {f5-irules}

    side_effect DnsState -reads -side Both

    taint_source TAINTED

    form Default {DNSMSG::header DNS_MESSAGE ('rcode' | 'opcode' | 'id' | 'ra' | 'rd' | 'tc' | 'qr' | 'aa' | 'ad' | 'cd')}

    hover {
        summary {Returns a field from the header of a dns_message.}
        synopsis {DNSMSG::header DNS_MESSAGE ('rcode' | 'opcode' | 'id' | 'ra' | 'rd' | 'tc' | 'qr' | 'aa' | 'ad' | 'cd')}
        description {Takes a dns_message structure and field name, and returns the specified field value from the header.}
        source {https://clouddocs.f5.com/api/irules/DNSMSG-header.html}
        example {when CLIENT_ACCEPTED {
        set result [RESOLVER::name_lookup "/Common/r1" www.abc.com a]
        set rcode [DNSMSG::header $result rcode]
}}
        returns {Returns a field from the header.}
    }
}

command DNSMSG::record {
    available {f5-irules}

    side_effect DnsState -reads -side Both

    taint_source TAINTED

    form Default {DNSMSG::record RESOURCE_RECORD ('owner' | 'type' | 'ttl' | 'class' | 'rdata')}

    hover {
        summary {Returns the specified field from a resource record object.}
        synopsis {DNSMSG::record RESOURCE_RECORD ('owner' | 'type' | 'ttl' | 'class' | 'rdata')}
        description {This iRule gets the specified field from a resource record object.}
        source {https://clouddocs.f5.com/api/irules/DNSMSG-record.html}
        example {when CLIENT_ACCEPTED {
        set result [RESOLVER::name_lookup "/Common/r1" www.abc.com a]
        set answer [DNSMSG::section $result answer]
        set first_rr [lindex $answer 1]
        set rdata [DNSMSG::record $first_rr rdata]
}}
        returns {Returns the specified field from the resource record object.}
    }
}

command DNSMSG::section {
    available {f5-irules}

    side_effect DnsState -reads -side Both

    taint_source TAINTED

    form Default {DNSMSG::section DNS_MESSAGE ('question' | 'answer' | 'authority' | 'additional' )}

    hover {
        summary {Returns a section of a dns_message.}
        synopsis {DNSMSG::section DNS_MESSAGE ('question' | 'answer' | 'authority' | 'additional' )}
        description {This iRule gets the specified section of a dns_message.}
        source {https://clouddocs.f5.com/api/irules/DNSMSG-section.html}
        example {when CLIENT_ACCEPTED {
        set result [RESOLVER::name_lookup "/Common/r1" www.abc.com a]
        set answer [DNSMSG::section $result answer]
}}
        returns {Returns a TCL list of resource records from the specified section.}
    }
}

command DOSL7::disable {
    available {f5-irules}

    side_effect Dosl7State -writes -side Both

    form Default {DOSL7::disable}

    hover {
        summary {Disables blocking and detection of DoS attacks according to the ASM security policy configuration.}
        synopsis {DOSL7::disable}
        description {Disables blocking and detection of DoS attacks according to the ASM
security policy configuration. When enabled using DOSL7::enable,
transactions will be enforced according to the DoS L7 ASM policy
configuration for both detection and prevention.}
        source {https://clouddocs.f5.com/api/irules/DOSL7__disable.html}
        example {when IN_DOSL7_ATTACK {
    DOSL7::disable
}}
    }
}

command DOSL7::enable {
    available {f5-irules}

    side_effect Dosl7State -writes -side Both

    form Default {DOSL7::enable (DOSL7_PROFILE_OBJ)?}

    hover {
        summary {Enables blocking and detection of DoS attacks according to the ASM security policy configuration.}
        synopsis {DOSL7::enable (DOSL7_PROFILE_OBJ)?}
        description {Enables blocking and detection of DoS attacks according to the ASM
security policy configuration. When disabled using DOSL7::disable,
transactions will bypass DoS L7 for both detection and prevention.}
        source {https://clouddocs.f5.com/api/irules/DOSL7__enable.html}
        example {when HTTP_REQUEST {
    DOSL7::enable
}}
    }
}

