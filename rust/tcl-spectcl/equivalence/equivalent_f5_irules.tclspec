command SSL::session {
    available {f5-irules}

    side_effect SslState -reads -side Both

    form Default {SSL::session invalidate ( drop | nodrop )?}

    hover {
        summary {Drops a session from the SSL session cache.}
        synopsis {SSL::session invalidate ( drop | nodrop )?}
        description {Invalidates the current session. If no parameter is specified, or the "drop" parameter is specified, this commands drops the current SSL session ID from the session cache to prevent reuse of the session. If "nodrop" is specified, the current session will be invalidated but the session will not be dropped from the session cache.}
        source {https://clouddocs.f5.com/api/irules/SSL__session.html}
        example {when HTTP_REQUEST {
    if { [HTTP::uri] contains "/maint_mode" } {
        ## send content and die
        HTTP::respond 200 content $::error_html Connection Close
        event HTTP_REQUEST disable
        SSL::session invalidate
    }
}}
        returns {SSL::session invalidate Invalidates the current session. Specifically, this command drops the current SSL session ID from the session cache to prevent reuse of the session.}
    }
}

command SSL::sessionid {
