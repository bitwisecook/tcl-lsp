        example {when HTTP_REQUEST {
    if {[HTTP2::version] != 0} {
        HTTP::header insert "X-HTTP2-Values version " "[HTTP2::version]"
    }
}}
        returns {The return is 2 if the HTTP/2 protocol is used, 0 if HTTP/2 is not active.}
    }
}

