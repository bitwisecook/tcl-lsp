        summary {This command can be used to drop an entire Websocket message.}
        synopsis {WS::message ( 'drop' )}
        description {WS::message drop
    Drop an entire Websocket message.}
        source {https://clouddocs.f5.com/api/irules/WS__message.html}
        example {when WS_CLIENT_FRAME {
    WS::message drop
}}
    }
}

command WS::payload {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `data_collection` is set on the source spec. The DSL spells
    #   it `data_collection -native ID`, but a draft records only that the field
    #   is set, never the expression that set it.

    form Default {WS::payload (LENGTH | (OFFSET LENGTH))?}

    hover {
        summary {Queries for or manipulates Websocket frame payload information.}
        synopsis {WS::payload (LENGTH | (OFFSET LENGTH))?}
        synopsis {WS::payload length}
        synopsis {WS::payload replace OFFSET LENGTH STRING}
        description {WS::payload <length>
    Returns the content that the WS::collect command has collected thus far, up to the number of bytes specified. If you do not specify a size, the system returns the entire collected content.

WS::payload <offset> <length>
    Returns the content that the WS::collect command has collected thus far from the specified offset, up to the number of bytes specified.

WS::payload length
    Returns the size of the content that has been collected thus far, in bytes.}
        source {https://clouddocs.f5.com/api/irules/WS__payload.html}
        example {when WS_CLIENT_FRAME {
    WS::collect frame 1000
    set clen 1000
}}
    }
}

