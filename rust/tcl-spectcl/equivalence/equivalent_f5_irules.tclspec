command MR::message {
    available {f5-irules}

    side_effect MessageState -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -count -takes {} -detail {Option -count.}

    form Default {MR::message clone (CLONE_ID)+}

    hover {
        summary {Returns or sets details in the message routing table.}
        synopsis {MR::message clone (CLONE_ID)+}
        synopsis {MR::message clone -count CLONE_COUNT}
        description {Clones the message a number of times (one for each CLONE_ID) and dispatches each cloned
message as ingress. After the original message has completed the event in which this command
is executed, each cloned message executes the MR_INGRESS iRule event for itself.
(CLONE_ID)+ can be one or more strings separated by space.
Protection against infinite loops should be considered!
Returns the clone_count, see below, (allowed only at MR_INGRESS).
            
Clones the message CLONE_COUNT number of times and dispatches each cloned
message as ingress.}
        source {https://clouddocs.f5.com/api/irules/MR__message.html}
        example {# Example 1
when MR_INGRESS {
    if {[GENERICMESSAGE::message is_request] != 0} {
        set host [MR::message pick_host peer /Common/mypeer]
        MR::message route config tcp_tc host $host
    }
}}
    }
}

