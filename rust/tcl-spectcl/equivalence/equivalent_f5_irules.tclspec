command SSL::disable {
    available {f5-irules}
    traits DIAGRAM_ACTION

    side_effect SslState -writes -side Both

    form Default {SSL::disable (clientside | serverside)?}

    hover {
        summary {Disables SSL processing.}
        synopsis {SSL::disable (clientside | serverside)?}
        description {Disables SSL processing. This command is useful when using a virtual server that services both SSL and non-SSL traffic, or when you want to selectively re-encrypt traffic to pool members.

Note: Disabling SSL on the serverside only applies before serverside connection has been established (SERVER_CONNECTED) or when the clientside of the connection is in a detached state (e.g., oneconnect, LB::detach).}
        source {https://clouddocs.f5.com/api/irules/SSL__disable.html}
        example {when SERVER_CONNECTED {
    if { $usessl == 0 } {
        SSL::disable
    }
}}
        returns {SSL::disable [clientside | serverside] Disables SSL processing on one side of the LTM. Sends an SSL alert to the peer requesting termination of SSL processing.}
    }
}

command SSL::enable {
    available {f5-irules}
    traits DIAGRAM_ACTION

    side_effect SslState -writes -side Both

    form Default {SSL::enable (clientside | serverside)?}

    hover {
        summary {Re-enables SSL processing.}
        synopsis {SSL::enable (clientside | serverside)?}
        description {Re-enables SSL processing.

Note that the proper use of this command is highly protocol dependent and not recommended in the majority of cases. To selectively enable SSL processing, you should instead use an ssl profile and then use SSL::disable to selectively disable SSL processing.

If a server-side connection is already established, this command will immediately cause the system to generate a Client Hello to a server, even if an iRule subsequently invokes SSL::disable serverside.}
        source {https://clouddocs.f5.com/api/irules/SSL__enable.html}
        example {when CLIENT_ACCEPTED {
    if { !([IP::addr [IP::client_addr] eq 10.0.0.0/8]) } {
        SSL::enable
        TCP::release
        set sslenable 0
    }
}}
        returns {SSL::enable [clientside | serverside] Re-enables SSL processing on one side of the LTM. serverside parameter may optionally be specified to indicate the context in which SSL will be enabled. By default, it will be enabled in the current context (i.e.}
    }
}

command SSL::extensions {
    available {f5-irules}
    traits {PURE CSE_CANDIDATE}

    side_effect SslState -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -index -takes EXT_NUMBER -detail {Return extension at specified index.}
    option -type -takes EXT_TYPE_VALUE \
        -detail {Return extension matching specified type value.}

    form Default {SSL::extensions ?options?}

    hover {
        summary {Returns or manipulates SSL extensions.}
        synopsis {SSL::extensions (count |}
        synopsis {SSL::extensions insert OPAQUE_EXT}
        description {Returns or manipulates SSL extensions.}
        source {https://clouddocs.f5.com/api/irules/SSL__extensions.html}
        example {when CLIENTSSL_CLIENTHELLO {
    set my_ext "Hello world!"
    set my_ext_type 62965
    SSL::extensions insert [binary format S1S1a* $my_ext_type [string length $my_ext] $my_ext]
}}
        returns {SSL::extensions Returns the extensions sent by the peer as a single opaque byte array. Valid in all SSL handshake events (those other than *SSL_DATA).}
    }
}

command SSL::forward_proxy {
    available {f5-irules}

    side_effect SslState -reads -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {SSL::forward_proxy <subcommand> ?args?}

    hover {
        summary {Sets the SSL forward proxy bypass feature to bypass or intercept, or retrieves the forged certificate, or enables/disables/gets verified_handshake semantics, or mask/ignore certificate response_control for the SSL handshake or inserts a certificate extension to the certificate, or sets server certificate status.}
        synopsis {SSL::forward_proxy ( (policy (bypass | intercept)?) | cert)}
        synopsis {SSL::forward_proxy verified_handshake (enable | disable) ?}
        synopsis {SSL::forward_proxy cert response_control (ignore | mask) ?}
        synopsis {SSL::forward_proxy extension (ARG ARG)}
        description {This command sets the SSL forward proxy bypass feature to bypass or intercept, or retrieves the forged certificate if the policy or cert subcommands are specified. If verified-handshake subcommand is specified, the command enables, disables or retrieves the verified_handshake behavior for the SSL handshake. If response_control subcommand is specified, the command ignore or mask the server side certificate errors while forging client certificate. If extension subcommand is specified, the command inserts an extension while forging a certificate.}
        source {https://clouddocs.f5.com/api/irules/SSL__forward_proxy.html}
        example {when CLIENTSSL_SERVERHELLO_SEND {
    log local0. 'bypassing'
    SSL::forward_proxy policy bypass
}}
        returns {SSL::forward_proxy policy <[bypass] | [intercept]> This command sets the policy of SSL Forward Proxy Bypass feature to "bypass" or "intercept"}
    }

    subcommand policy {
        arity ..1
        detail {Set or get forward proxy bypass policy.}
        synopsis {SSL::forward_proxy policy ?bypass | intercept?}
        mutator
        arg 0 -values-from ssl-forward-proxy-policy-arg0
        side_effect SslState -reads -writes -side Both
    }

    subcommand cert {
        arity ..2
        detail {Retrieve the forged certificate or set cert options.}
        synopsis {SSL::forward_proxy cert ?response_control? ?status?}
        pure
        arg 0 -values-from ssl-forward-proxy-cert-arg0
        side_effect SslState -reads -side Both
    }

    subcommand verified_handshake {
        arity ..1
        detail {Enable, disable, or get verified handshake semantics.}
        synopsis {SSL::forward_proxy verified_handshake ?enable | disable?}
        mutator
        arg 0 -values-from ssl-forward-proxy-verified-handshake-arg0
        side_effect SslState -reads -writes -side Both
    }

    subcommand extension {
        arity 2
        detail {Insert a certificate extension while forging.}
        synopsis {SSL::forward_proxy extension <oid> <value>}
        mutator
        side_effect SslState -writes -side Both
    }
}

command SSL::handshake {
