        summary {Get or set retain flag of MQTT PUBLISH message.}
        synopsis {MQTT::retain ('0' | '1')?}
        description {This command can be used to get or set retain flag of MQTT message.
This command is valid only for following MQTT message types:

    PUBLISH}
        source {https://clouddocs.f5.com/api/irules/MQTT__retain.html}
        example {# Convert PUBLISH for topics in a retain_datagroup to retain messages
when MQTT_CLIENT_INGRESS {
   set type [MQTT::type]
   switch $type {
      "PUBLISH" {
          if {[MQTT::retain] eq 0} {
              if { [class exists retain_datagroup] } {
                  if {[class match [MQTT::topic] starts_with retain_datagroup]} {
                     MQTT::retain 1
                  }
              }
          }
      }
   }
}}
        returns {When called without an argument, this command returns the retain flag of MQTT PUBLISH message.}
    }
}

