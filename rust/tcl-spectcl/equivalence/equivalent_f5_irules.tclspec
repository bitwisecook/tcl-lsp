command DIAMETER::dynamic_route_insertion {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::dynamic_route_insertion ( BOOLEAN )?}

    hover {
        summary {Set whether dynamic route insertion is enabled.}
        synopsis {DIAMETER::dynamic_route_insertion ( BOOLEAN )?}
        description {If status is set to "enabled", a dynamic route will be created for this connection.

This value, once set, remains for the life of the connection.  After the connection is closed, this route will be removed once "timeout" seconds have elapsed.  The default timeout is set by the configuration option "dynamic-route-timeout".

The zero-argument form of this command returns whether the setting is enabled on the current connection.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__dynamic_route_insertion.html}
        example {when CLIENT_ACCEPTED {
                if { ([IP::address] starts_with "192.168.") } {
                    DIAMETER::dynamic_route_insertion disabled
                }
            }}
    }
}

command DIAMETER::dynamic_route_lookup {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::dynamic_route_lookup ( connection | message ) ( BOOLEAN )?}

    hover {
        summary {Set whether messages should be routed dynamically.}
        synopsis {DIAMETER::dynamic_route_lookup ( connection | message ) ( BOOLEAN )?}
        description {"message":
If status is set to "enabled", previously created dynamic routes will be consulted during the routing of this message.

"connection":
The setting will be applied to this and all later messages on this connection.

The zero-argument form of this command returns whether the setting is enabled on the current message.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__dynamic_route_lookup.html}
        example {when DIAMETER_INGRESS {
                if { ([DIAMETER::header appid] equals 666) } {
                    DIAMETER::dynamic_route_lookup message disabled
                }
            }}
    }
}

