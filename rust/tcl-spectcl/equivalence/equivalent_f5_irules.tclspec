command active_members {
    available {f5-irules}

    side_effect PoolSelection -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -list -detail {Return as list instead of count.}

    form Default {active_members ('-list')? POOL_OBJ}

    hover {
        summary {Returns the number or list of active members in the specified pool.}
        synopsis {active_members ('-list')? POOL_OBJ}
        description {Returns the number or list of active members in the specified pool.}
        source {https://clouddocs.f5.com/api/irules/active_members.html}
        example {when HTTP_REQUEST {
    if { [active_members http_pool] >= 2 } {
        pool http_pool
    }
}}
        returns {active_members <pool_name> Returns the number of active members in the specified pool.}
    }
}

