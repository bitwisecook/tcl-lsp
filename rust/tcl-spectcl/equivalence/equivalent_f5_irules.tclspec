command DIAMETER::length {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::length}

    hover {
        summary {Gets diameter message length.}
        synopsis {DIAMETER::length}
        description {This iRule command returns the length of the current message,
including the message header.

The value returned reflects the current length of the message at the
instant the iRule command is executed: if you store the length of a
message in a variable and then modify the message, your stored length
may be incorrect.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__length.html}
        example {when DIAMETER_INGRESS {
    log local0. "Received a Diameter message of [DIAMETER::length] bytes"
}}
    }
}

command DIAMETER::message {
    available {f5-irules}

    side_effect NetworkIo -reads -writes -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::message}

    hover {
        summary {Returns the whole Diameter message as a TCL string object.}
        synopsis {DIAMETER::message}
        description {This iRule command returns the current Diameter message as a TCL
string object.  This includes both the header and the payload.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__message.html}
        example {when DIAMETER_INGRESS {
    log local0. "Received a DIAMETER message: [DIAMETER::message]"
}}
    }
}

command DIAMETER::payload {
    available {f5-irules}

    byte_array_payload -replace-data-index 1

    side_effect NetworkIo -reads -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `data_collection` is set on the source spec. The DSL spells
    #   it `data_collection -native ID`, but a draft records only that the field
    #   is set, never the expression that set it.

    form Default {DIAMETER::payload ('replace' PAYLOAD)?}

    hover {
        summary {Gets or sets DIAMETER message payload.}
        synopsis {DIAMETER::payload ('replace' PAYLOAD)?}
        description {This iRule command gets or sets the current DIAMETER message\'s
payload, as a byte string.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__payload.html}
        example {when DIAMETER_INGRESS {
    log local0. "Received a DIAMETER message, with payload [DIAMETER::payload]"
}}
    }
}

command DIAMETER::persist {
    available {f5-irules}

    side_effect PersistenceTable -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::persist}

    hover {
        summary {Returns the persistence key being used for the current message.}
        synopsis {DIAMETER::persist}
        synopsis {DIAMETER::persist reset}
        synopsis {DIAMETER::persist use}
        description {This iRule command returns the persistence key being used for the
current message. If new persist key is provided, the existing
persistence key will be replaced. The value of the new key MUST be the
value of a valid AVP in the message. An AVP attribute name should not
be given as the new key value.

If bidirection is specified as false, disable(d), no, 0, or is
unspecified, then persistence is not bidirectional. If bidirection is
specified as true, enable(d), yes, or 1 this persistence entry is
bidirectional.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__persist.html}
        example {when DIAMETER_INGRESS {
    log local0. "Received a DIAMETER message, persistence key is [DIAMETER::persist]"
}}
    }
}

command DIAMETER::realm {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::realm ( ('origin' | 'dest' ) (DIAMETER_REALM)? )}

    hover {
        summary {Gets or sets the value of the origin-realm or destination-realm AVP.}
        synopsis {DIAMETER::realm ( ('origin' | 'dest' ) (DIAMETER_REALM)? )}
        description {This iRule command gets or sets the value of the origin-realm (code 296) or
destination-realm (code 283) AVP in the current Diameter message.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__realm.html}
        example {when DIAMETER_INGRESS {
    log local0. "Received a DIAMETER message with origin realm [DIAMETER::realm origin]"
}}
    }
}

command DIAMETER::respond {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::respond DIAMETER_VERSION RFLAG_BINARY PFLAG_BINARY EFLAG_BINARY TFLAG_BINARY}

    hover {
        summary {Sends message to client or server (based on context).}
        synopsis {DIAMETER::respond DIAMETER_VERSION RFLAG_BINARY PFLAG_BINARY EFLAG_BINARY TFLAG_BINARY}
        description {This iRule command creates and sends a new message to the client or
server.

When called from clientside events, the new message is sent to the client.
When called from serverside events, the new message is sent to the server.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__respond.html}
        # TODO(spectcl): `hover` holds text no Tcl word carries verbatim — an
        #   unbalanced brace or a backslash-newline. A braced word is the only
        #   faithful spelling, so the statement is dropped rather than written
        #   down wrong.
    }
}

command DIAMETER::result {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

