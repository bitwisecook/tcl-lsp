command subst {
    available {tcl 8.4-} {f5-irules}
    traits {PERFORMS_SUBSTITUTION IS_UNESCAPE TAINT_SINK}
    arity 1..

    return_type String
    # TODO(spectcl): `body_execution` is set on the source spec. The DSL spells
    #   it `body_execution -native CONTRACT`, but a draft records only that the
    #   field is set, never the expression that set it.
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    byte_array_effect Coerces
    reserved_trailing_words 1

    const_fold -native subst::const_fold

    side_effect Unknown -reads -writes

    taint_sink_gate -native subst::taint_sink_gate

    runtime_backing shipped-builtin subst

    option -nobackslashes -effect {disables substitution backslashes} -family negated \
        -detail {Disable backslash substitution; backslash sequences such as \n are left as literal text. Command and variable substitution are unaffected.}
    option -nocommands -effect {disables substitution commands} -family negated \
        -detail {Disable top-level command substitution; [ and ] are treated as ordinary characters. A [command] nested inside a variable reference (e.g. an array index) still runs, since that is part of resolving the variable, not a top-level substitution.}
    option -novariables -effect {disables substitution variables} -family negated \
        -detail {Disable top-level variable substitution; $ is treated as an ordinary character. A $variable reference nested inside a command still runs, since that is part of evaluating the command, not a top-level substitution.}
    option -backslashes -available {tcl 9.1} -effect {selects substitution backslashes} -family positive \
        -detail {Enable only backslash substitution; commands and variables are left as literal text (Tcl 9.1). Cannot combine with -nobackslashes/-nocommands/-novariables.}
    option -commands -available {tcl 9.1} -effect {selects substitution commands} -family positive \
        -detail {Enable only command substitution; backslashes and variables are left as literal text (Tcl 9.1). Cannot combine with -nobackslashes/-nocommands/-novariables.}
    option -variables -available {tcl 9.1} -effect {selects substitution variables} -family positive \
        -detail {Enable only variable substitution; backslashes and commands are left as literal text (Tcl 9.1). Cannot combine with -nobackslashes/-nocommands/-novariables.}
    option_forbids -nobackslashes {-backslashes -commands -variables} -available {tcl 9.1} -message {cannot combine positive and negative options}
    option_forbids -nocommands {-backslashes -commands -variables} -available {tcl 9.1} -message {cannot combine positive and negative options}
    option_forbids -novariables {-backslashes -commands -variables} -available {tcl 9.1} -message {cannot combine positive and negative options}
    option_effect_family negated {base all-on combine accumulate}
    option_effect_family positive {base all-off combine accumulate -introduced 9.1}

    form Default {subst ?-nobackslashes? ?-nocommands? ?-novariables? string}
    form Default {subst ?-backslashes? ?-commands? ?-variables? string} -available {tcl 9.1}

    hover {
        summary {Perform backslash, command, and variable substitutions on a string.}
        synopsis {subst ?-nobackslashes? ?-nocommands? ?-novariables? string}
        synopsis {subst ?-backslashes? ?-commands? ?-variables? string}
        description {Applies the same variable, command, and backslash substitution rules Tcl itself uses when parsing a command word, but a second time: string is substituted once by the Tcl parser when the call to subst is itself parsed, then again by subst at runtime. This is what lets `subst {$x}` substitute `$x` even though the enclosing braces would normally suppress substitution.

All three substitution kinds run by default. -nobackslashes, -nocommands, and -novariables (every Tcl version) each turn off exactly the substitution they name; -nocommands is the one that matters for safety, since it is the only kind that can execute arbitrary code. One kind can still trigger another even when disabled: with -novariables, a `[command]` still expands any $variable inside it, since evaluating the command requires it; with -nocommands, a `$name([b])` array reference still runs the `[b]` inside its index, since resolving the variable requires it.

Tcl 9.1 adds inverted, positive-only switches -backslashes/-commands/-variables: giving any one of these turns every substitution off by default and enables only the ones named, so `subst -variables $s` is equivalent to `subst -nobackslashes -nocommands $s`. The two switch families cannot be combined in one call.

A break inside an embedded command or variable index stops substitution immediately, keeping only the text produced so far; continue substitutes an empty string for that one embedded piece and keeps going; return (or any other completion code) substitutes the returned value for it. Any other error propagates as subst's own error.

**Security**: without -nocommands (or a -variables/-backslashes-only call), any `[cmd]` in string is executed as Tcl, making subst a code-injection sink for untrusted input. Use `subst -nocommands $template` when only variable interpolation is needed, or prefer `[string map]` / `[format]` for safe templating.}
        source {Tcl subst(n)}
        example {set name Alice
puts [subst {Hello, $name! Today is [clock format [clock seconds] -format %A].}]

# Safe templating: disable command substitution for untrusted input
set template {Welcome, $user!}
puts [subst -nocommands $template]

# Tcl 9.1: enable only variable substitution
puts [subst -variables {$name < [expr {1+1}] > \n}]}
        returns {The fully-substituted string: break truncates it at the point of the exception, continue/return substitute their value for just that one embedded command or variable index, and any other error becomes subst's own error.}
    }

    refine template {
        arity 1
        side_effects none
    }
}

command substr {
    available {f5-irules}

    side_effect Unknown -reads -side Global

    form Default {substr STRING SKIP_COUNT (TERMINATOR)?}

    hover {
        summary {Returns a substring from a string.}
        synopsis {substr STRING SKIP_COUNT (TERMINATOR)?}
        description {A custom iRule function which returns a substring named <string>,
based on the values of the <skip_count> and <terminator> arguments.
Note the following:
  * The <skip_count> and <terminator> arguments are used in the same
    way as they are for the findstr command.
  * The <skip_count> argument is the index into <string> of the first
    character to be returned, where 0 indicates the first character of
    <string>.
  * The <terminator> argument can be either the subtring length or the
    substring terminating string.}
        source {https://clouddocs.f5.com/api/irules/substr.html}
        example {when HTTP_REQUEST {
  set uri [substr $uri 1 "?"]
  log local0. "Uri Part = $uri"
}}
    }
}

command switch {
    available {tcl 8.4-} {f5-irules}
    traits {CONTROL_FLOW LANGUAGE_KEYWORD NEVER_INLINE_BODY BYTE_COMPILED NOT_PROC_FACTORY}
    arity 3.. -step 2 -also 2 -positionals

    return_type String
    # TODO(spectcl): `native_compilation` is set on the source spec. The DSL
    #   spells it `native_compilation -native CONTRACT`, but a draft records
    #   only that the field is set, never the expression that set it.
    # TODO(spectcl): `successful_handler` is set on the source spec. The DSL
    #   spells it `successful_handler -native
    #   Leaf|ExpressionArguments|DictionaryConstructor|EnsembleLeaf|EnsemblePathLeaf
    #   -direct-provider
    #   F5String|F5Binary|VariableOperands|InitialiseEmptyVariable|CatchOutputs|PossibleBodies|CommandBindingTransition`,
    #   but a pack may not author this field.
    reserved_trailing_words 2

    arg_role_resolver -native switch::arg_role_resolver
    arg_role_resolver_roles Body
    lowering_hook -native Switch
    analyser_hook -native Switch

    side_effect Unknown -reads -writes

    taint_numeric_coercion IntegerModeOperands

    runtime_backing shipped-builtin switch

    # TODO(spectcl): `case_list` is set on the source spec. The DSL spells it
    #   `case_list NAME|{ … }`, but a draft records only that the field is
    #   set, never the expression that set it.

    option -exact -effect {selects selection exact} -family match \
        -detail {Exact string compare mode. This is the default.}
    option -glob -effect {selects selection glob} -family match \
        -detail {Glob-style pattern mode, as implemented by `string match`.}
    option -integer -available {tcl 9.1} -effect {selects selection other} -family match \
        -detail {Integer comparison mode: string and every pattern (other than a trailing default) must be a valid integer, or switch raises an error. Cannot be combined with -nocase.}
    option -regexp -effect {selects selection regexp} -family match \
        -detail {Regular expression pattern mode.}
    option -nocase -available {tcl 8.5-} -effect {selects case-sensitivity} -family case \
        -detail {Case-insensitive matching. Not supported together with -integer (Tcl 9.1+).}
    option -matchvar -takes varName -available {tcl 8.5-} \
        -detail {Store the list of matched substrings here — element 0 is the overall match, each later element a capturing group (only legal with -regexp); an empty list when a default branch runs.}
    option -indexvar -takes varName -available {tcl 8.5-} \
        -detail {Store the list of matched substring start/end index pairs here, parallel to -matchvar (only legal with -regexp); an empty list when a default branch runs.}
    option -- -effect ends-options -family layout \
        -detail {End of options: the next word is always the subject string, even if it starts with -.}
    option_effect_family match {base {only selection exact} combine last-wins}
    option_effect_family case {base all-off combine accumulate}
    option_effect_family layout {base all-on combine accumulate}

    form Default {switch ?options? string pattern body ?pattern body ...?}
    form Default {switch ?options? string {pattern body ?pattern body ...?}}

    hover {
        summary {Pattern-based branching on a subject string.}
        synopsis {switch ?options? string pattern body ?pattern body ...?}
        synopsis {switch ?options? string {pattern body ?pattern body ...?}}
        description {Compares string against each pattern in turn and, on the first match, evaluates the corresponding body and returns its result. -exact (the default), -glob (as `string match`), -regexp, and, from Tcl 9.1, -integer select the comparison mode; -nocase (Tcl 8.5+) makes any of them case-insensitive except -integer, which it cannot combine with — -integer also turns a non-integer string or pattern, other than a trailing default, into an error. A pattern of default, which must come last, matches unconditionally; with no match and no default, switch returns an empty string. A body of exactly "-" shares the next pattern's body, so several patterns can fall through to one script. Patterns and bodies may be given as separate words, with substitutions applying normally, or grouped into one braced {pattern body ...} argument, handy for multi-line switches — no command or variable substitution happens on patterns in the braced form, so it can behave differently from the separate-words form. -matchvar and -indexvar (Tcl 8.5+, only with -regexp) capture the overall match plus each capturing group's substrings, or their start/end indices, into the named variables, writing an empty list when a default branch runs. When switch is called with exactly two arguments in total, neither is scanned as an option (documented from Tcl 8.5 on) — the first is always the subject and the second the pattern list, even if the subject begins with -; with more arguments, a subject beginning with - still needs --. Tcl 8.4 recognises only -exact/-glob/-regexp/--.}
        source {Tcl switch(n)}
        example {switch -glob -- $ext {
    .tcl    -
    .tm     { puts "Tcl source" }
    .h      { puts "C header" }
    default { puts "unknown extension" }
}

# Capture what matched (Tcl 8.5+)
switch -regexp -matchvar parts -- $line {
    {^(\w+):\s*(.*)$} {
        puts "key=[lindex $parts 1] value=[lindex $parts 2]"
    }
}

# Dispatch on argument count (Tcl 9.1+)
switch -integer -- [llength $args] {
    0       { puts "no arguments" }
    1       { puts "one argument: [lindex $args 0]" }
    default { puts "many arguments: $args" }
}}
        returns {The result of evaluating the matched body, or an empty string when no pattern matches and there is no default clause.}
    }
}

command table {
    available {f5-irules}
    traits DIAGRAM_ACTION

    side_effect SessionTable -reads -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -mustexist -detail {Fail if key does not already exist.}
    option -excl -detail {Fail if key already exists.}
    option -notouch -detail {Do not reset lifetime/timeout on access.}
    option -subtable -takes {} -detail {Operate on a named subtable.}
    option -georedundancy -detail {Enable geo-redundancy for this entry.}
    option -remaining -detail {Return remaining time.}
    option -count -detail {Return count of matching keys.}
    option -all -detail {Delete all keys in a subtable.}

    form Default {table <subcommand> ?options? ?--? key ?value? ?lifetime? ?timeout?}

    hover {
        summary {Provides enhanced access to the session table.}
        synopsis {table set (((-mustexist | -excl) -notouch ((-subtable TABLE_NAME) | -georedundancy))# ('--')?)? KEY VALUE (('indefinite' | POSITIVE_INTEGER) ('indefinite' | POSITIVE_INTEGER)?)?}
        synopsis {table add ((-notouch ((-subtable TABLE_NAME) | -georedundancy))# ('--')?)? KEY VALUE (('indefinite' | POSITIVE_INTEGER) ('indefinite' | POSITIVE_INTEGER)?)?}
        synopsis {table replace ((-notouch ((-subtable TABLE_NAME) | -georedundancy))# ('--')?)? KEY VALUE (('indefinite' | POSITIVE_INTEGER) ('indefinite' | POSITIVE_INTEGER)?)?}
        synopsis {table lookup ((-notouch ((-subtable TABLE_NAME) | -georedundancy))# ('--')?)? KEY}
        description {The table command is a superset of the session command, with improved syntax for general purpose use. Please see the table command article series for detailed information on its use.

This command is not available to GTM.

If the table command is used on the standby system in a HA pair, the command will perform a no-op because the content of the standby unit's session db should be updated only through mirroring.}
        source {https://clouddocs.f5.com/api/irules/table.html}
        example {when RULE_INIT {
    set static::maxquery 100
    set static::holdtime 600
}}
    }

    subcommand set {
        synopsis {table set ?-notouch? ?-subtable name | -georedundancy? ?-mustexist | -excl? key value ?timeout ?lifetime??}
        mutator
        side_effect SessionTable -reads -writes -side Both

        option -notouch -detail {Do not reset lifetime/timeout on access.}
        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -georedundancy -detail {Enable geo-redundancy for this entry.}
        option -mustexist -detail {Fail if key does not already exist.}
        option -excl -detail {Fail if key already exists.}
        option --
    }

    subcommand add {
        synopsis {table add ?-notouch? ?-subtable name | -georedundancy? key value ?timeout ?lifetime??}
        mutator
        side_effect SessionTable -reads -writes -side Both

        option -notouch -detail {Do not reset lifetime/timeout on access.}
        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -georedundancy -detail {Enable geo-redundancy for this entry.}
        option --
    }

    subcommand incr {
        synopsis {table incr ?-notouch? ?-subtable name | -georedundancy? ?-mustexist? key ?delta?}
        mutator
        side_effect SessionTable -reads -writes -side Both

        option -notouch -detail {Do not reset lifetime/timeout on access.}
        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -georedundancy -detail {Enable geo-redundancy for this entry.}
        option -mustexist -detail {Fail if key does not already exist.}
        option --
    }

    subcommand delete {
        synopsis {table delete ?-subtable name | -georedundancy? key | -all}
        mutator
        side_effect SessionTable -reads -writes -side Both

        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -georedundancy -detail {Enable geo-redundancy for this entry.}
        option -all -detail {Delete all keys in a subtable.}
        option --
    }

    subcommand append {
        synopsis {table append ?-notouch? ?-subtable name | -georedundancy? ?-mustexist? key string}
        mutator
        side_effect SessionTable -reads -writes -side Both

        option -notouch -detail {Do not reset lifetime/timeout on access.}
        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -georedundancy -detail {Enable geo-redundancy for this entry.}
        option -mustexist -detail {Fail if key does not already exist.}
        option --
    }

    subcommand replace {
        synopsis {table replace ?-notouch? ?-subtable name | -georedundancy? key value ?timeout ?lifetime??}
        mutator
        side_effect SessionTable -reads -writes -side Both

        option -notouch -detail {Do not reset lifetime/timeout on access.}
        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -georedundancy -detail {Enable geo-redundancy for this entry.}
        option --
    }

    subcommand keys {
        synopsis {table keys -subtable name ?-count | -notouch?}
        side_effect SessionTable -reads -side Both

        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -count -detail {Return count of matching keys.}
        option -notouch -detail {Do not reset lifetime/timeout on access.}
        option --
    }

    subcommand lifetime {
        synopsis {table lifetime ?-subtable name | -georedundancy? key ?value | -remaining?}
        side_effect SessionTable -reads -side Both

        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -georedundancy -detail {Enable geo-redundancy for this entry.}
        option -remaining -detail {Return remaining time.}
        option --
    }

    subcommand timeout {
        synopsis {table timeout ?-subtable name | -georedundancy? key ?value | -remaining?}
        side_effect SessionTable -reads -side Both

        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -georedundancy -detail {Enable geo-redundancy for this entry.}
        option -remaining -detail {Return remaining time.}
        option --
    }

    subcommand lookup {
        synopsis {table lookup ?-notouch? ?-subtable name | -georedundancy? key}
        side_effect SessionTable -reads -side Both

        option -notouch -detail {Do not reset lifetime/timeout on access.}
        option -subtable -takes {} -detail {Operate on a named subtable.}
        option -georedundancy -detail {Enable geo-redundancy for this entry.}
        option --
    }
}

