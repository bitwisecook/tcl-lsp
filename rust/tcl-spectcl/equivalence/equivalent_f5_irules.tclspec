        synopsis {POLICY::rules ('matched')? POLICY_NAME}
        description {Returns the policy rules of the supplied policy that had actions
executed.}
        source {https://clouddocs.f5.com/api/irules/policy__rules.html}
        example {# Log the policy targets for this virtual server
when HTTP_REQUEST {

        log local0. "Looping through \[POLICY::names matched\]: [POLICY::names matched]"
        foreach policy [POLICY::names matched] {
                log local0. "\[POLICY::rules matched $policy\]: [POLICY::rules matched $policy]"
        }
}}
    }
}

