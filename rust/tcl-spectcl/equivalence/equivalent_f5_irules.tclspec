command DOSL7::profile {
    available {f5-irules}

    side_effect Dosl7State -reads -side Global

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DOSL7::profile}

    hover {
        summary {Returns the DOS profile from which the L7-DoS policy is extracted.}
        synopsis {DOSL7::profile}
        description {This command returns the DOS profile from which the L7-DoS policy is
extracted.
Note:
  * in 11.4, default policy returns empty string and if L7-DoS is
    disabled, the <no-profile> string is returned.
  * in 11.5+, default policy returns the one configured with the vip
    and if L7-DoS is disabled, a null string is returned.}
        source {https://clouddocs.f5.com/api/irules/DOSL7__profile.html}
    }
}

command DOSL7::slowdown {
    available {f5-irules}

    side_effect Dosl7State -writes -side Both

    form Default {DOSL7::slowdown RATE TIMEOUT}

    hover {
        summary {Adds source IP extracted from current connection to greylist.}
        synopsis {DOSL7::slowdown RATE TIMEOUT}
        description {Adds source IP extracted from current connection to greylist. TCP slowdown will be applied according to supplied RATE (in percents) and TIMEOUT (in seconds).
A RATE represents amount of incoming data packets to be dropped to perform slowdown.}
        source {https://clouddocs.f5.com/api/irules/DOSL7__slowdown.html}
        example {when HTTP_REQUEST {
                 if { [HTTP::uri] contains "heavy.php" } {
                     DOSL7::slowdown 30 60
                 }
             }}
    }
}

