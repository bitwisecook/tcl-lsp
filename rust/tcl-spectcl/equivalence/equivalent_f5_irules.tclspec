    option -exp -takes EXPONENT -detail {Exponent (for RSA).}
    option -passphrase -takes PASSPHRASE -detail {Passphrase for key derivation.}
    option -salt -takes SALT -detail {Binary salt.}
    option -salthex -takes SALT_HEX -detail {Hex-encoded salt.}
