command DIAMETER::skip_capabilities_exchange {
    available {f5-irules}

    side_effect NetworkIo -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::skip_capabilities_exchange ( HOSTNAME )?}

    hover {
        summary {Instructs DIAMETER protocol to skip capabilities exchange when establishing a peering relationship.}
        synopsis {DIAMETER::skip_capabilities_exchange ( HOSTNAME )?}
        description {Once called, the current connection will skip DIAMETER capabilities exchange message communication with the peer device and will immediately be able to receive DIAMETER messaegs.

If the HOSTNAME parameter is provided, the provided name will be used as the peer device's origin-host attribute for logging.}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__skip_capabilities_exchange.html}
        example {when CLIENT_ACCEPTED {
                if { ([IP::address] starts_with "192.168.") } {
                    DIAMETER::skip_capabilities_exchange [IP::address].somesp.com
                }
            }}
    }
}

command DIAMETER::state {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DIAMETER::state}

    hover {
        summary {Returns the current state of the Diameter peer's connection.}
        synopsis {DIAMETER::state}
        description {This iRule command returns the current state of the Diameter peer\'s
connection, as a string. There are five possible states:
  * CLOSED - The connection is down
  * WAIT_ICEA - still waiting for the initial CEA
  * ROPEN - The connection has been reopened
  * IOPEN - The connection is open for the first time
  * CLOSING - The connection will soon be down}
        source {https://clouddocs.f5.com/api/irules/DIAMETER__state.html}
        example {when DIAMETER_INGRESS {
    if { [DIAMETER::state] == "ROPEN" } {
        log local0. "Received a DIAMETER message via a reopened connection"
    }
}}
    }
}

command DNS::additional {
    available {f5-irules}

    side_effect DnsState -reads -writes -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DNS::additional ?clear | insert <rr> | remove <rr>?}

    hover {
        summary {Returns, inserts, removes, or clears RRs from the additional section.}
        synopsis {DNS::additional ('clear' | (('insert' | 'remove') RR_OBJECT))?}
        description {This iRules command returns, inserts, removes, or clears RRs from the
additional section.

Note: This command functions only in the context of LTM iRules and
requires the DNS Profile, which is only enabled as part of GTM or the
DNS Services add-on.}
        source {https://clouddocs.f5.com/api/irules/DNS__additional.html}
        example {when DNS_RESPONSE {
        set rrs [DNS::answer]
        foreach rr $rrs {
            DNS::ttl $rr 1234
        }
        set new_rr [DNS::rr "bigip3900-30.f5net.com. 88 IN A 1.2.3.4"]
        DNS::additional insert $new_rr
    }}
    }

    subcommand clear {
        arity 0
        detail {Clear all additional RRs.}
        synopsis {DNS::additional clear}
        mutator
        side_effect DnsState -writes -side Both
    }

    subcommand insert {
        arity 1
        detail {Insert an RR into the additional section.}
        synopsis {DNS::additional insert <rr_object>}
        mutator
        side_effect DnsState -writes -side Both
    }

    subcommand remove {
        arity 1
        detail {Remove an RR from the additional section.}
        synopsis {DNS::additional remove <rr_object>}
        mutator
        side_effect DnsState -writes -side Both
    }
}

command DNS::answer {
    available {f5-irules}
    traits DIAGRAM_ACTION

    side_effect DnsState -reads -writes -side Both

    taint_source TAINTED
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {DNS::answer ?clear | insert <rr> | remove <rr>?}

    hover {
        summary {Returns, inserts, removes, or clears all RRs from the answer section.}
        synopsis {DNS::answer ('clear' | (('insert' | 'remove') RR_OBJECT))?}
        description {This iRules command returns, inserts, removes, or clears RRs from the
answer section.

Note: This command functions only in the context of LTM iRules and
requires the DNS Profile, which is only enabled as part of GTM or the
DNS Services add-on.}
        source {https://clouddocs.f5.com/api/irules/DNS__answer.html}
        example {ttl of all answer records and add a glue record
            when DNS_RESPONSE {
                set rrs [DNS::answer]
                foreach rr $rrs {
                    DNS::ttl $rr 1234
                }
                set new_rr [DNS::rr "bigip3900-30.f5net.com. 88 IN A 1.2.3.4"]
                DNS::additional insert $new_rr
            }}
    }

    subcommand clear {
        arity 0
        detail {Clear all answer RRs.}
        synopsis {DNS::answer clear}
        mutator
        side_effect DnsState -writes -side Both
    }

    subcommand insert {
        arity 1
        detail {Insert an RR into the answer section.}
        synopsis {DNS::answer insert <rr_object>}
        mutator
        side_effect DnsState -writes -side Both
    }

    subcommand remove {
        arity 1
        detail {Remove an RR from the answer section.}
        synopsis {DNS::answer remove <rr_object>}
        mutator
        side_effect DnsState -writes -side Both
    }
}

