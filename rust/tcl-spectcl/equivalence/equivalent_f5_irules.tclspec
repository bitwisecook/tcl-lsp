    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {CACHE::disable}

    hover {
        summary {Disables caching for this request.}
        synopsis {CACHE::disable}
        description {Disables caching for this request.

CACHE::disable

     * Disables caching for this request.}
        source {https://clouddocs.f5.com/api/irules/CACHE__disable.html}
        example {when HTTP_REQUEST {
  # Disable caching if the URI does not contain the string "images"
  if { not ([HTTP::uri] contains "images") } {
    CACHE::disable
  }
}}
    }
}

