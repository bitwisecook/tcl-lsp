command RADIUS::code {
    available {f5-irules}

    side_effect NetworkIo -reads -side Both

    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    form Default {RADIUS::code}

    hover {
        summary {This command returns the RADIUS message code}
        synopsis {RADIUS::code}
        description {This command returns the RADIUS message code}
        source {https://clouddocs.f5.com/api/irules/RADIUS__code.html}
        example {when CLIENT_ACCEPTED {
    if { [RADIUS::code] == 4 } {
        set rd 0
        # Extract the APN information from the AVP
        set called_station_id [RADIUS::avp 30 "string"]
        if {$called_station_id == "station1"} {
            set rd 1
        } elseif {$called_station_id == "station2"} {
            set rd 2
        }
        # Overwrite the default route domain value with the new value.
        RADIUS::rtdom $rd
    }
}}
        returns {returns radius message code.}
    }
}

