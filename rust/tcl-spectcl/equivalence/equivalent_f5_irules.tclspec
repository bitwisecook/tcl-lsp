connection modes as "per-peer", "per-blade", "per-tmm" or "per-client".
For incoming connections, it will return "per-peer".}
        source {https://clouddocs.f5.com/api/irules/MR__connection_mode.html}
        example {when SERVER_CONNECTED {
    log local0. "[MR::connection_instance] [MR::connection_mode]"
}}
        returns {returns the connection mode}
    }
}

command MR::equivalent_transport {
    available {f5-irules}

    side_effect MessageState -writes -side Both

    form Default {MR::equivalent_transport}

    hover {
        summary {Gets or sets the transport that is usable as an equivalent transport.}
        synopsis {MR::equivalent_transport}
        synopsis {MR::equivalent_transport none}
        synopsis {MR::equivalent_transport (('virtual' VIRTUAL_SERVER_OBJ) | ('config' TRANSPORT_CONFIG))}
        description {Gets or sets the transport that is usable as an equivalent transport. The equivalent transport may be used as an alternate when selecting a subsequent connection to the device the current connections communicates with.
        
Gets the transport that is usable as an equivalent transport. The equivalent transport may be used as an alternate when selecting a subsequent connection to the device the current connections communicates with.
            
Resets the transport that is usable as an equivalent transport.}
        source {https://clouddocs.f5.com/api/irules/MR__equivalent_transport.html}
        example {when CLIENT_ACCEPTED {
    MR::equivalent_transport config /Common/inbound_tc
}}
        returns {Returns the current equivalent transport. This will contain the transport type and transport name. For example: 'config /Common/inbound_tc'.}
    }
}

