command HTTP::respond {
    available {f5-irules}
    traits {REQUIRES_HTTP_CONTEXT DIAGRAM_ACTION}
    arity 1..

    arg 1 -values-from http-respond-arg1

    side_effect ResponseCommit -reads -writes -side Client

    taint_output_sink IRULE3001
    # TODO(spectcl): `event_requires` is set on the source spec. The DSL spells
    #   it `event_requires NAME|{ … }`, but a draft records only that the
    #   field is set, never the expression that set it.

    option -version -takes {1.0 | 1.1} \
        -detail {Protocol version on the synthesised response.}
    option -content -takes CONTENT -detail {Response body content.}
    option -ifile -takes IFILE_OBJ -detail {Serve the response body from an iFile object.}
    option -noserver -detail {Suppress the auto-injected `Server` response header.}
    option -reset -detail {Reset the connection after sending the response.}

    form Default {HTTP::respond <status> ?option value ...?}

    hover {
        summary {Send an immediate HTTP response from an iRule.}
        synopsis {HTTP::respond <status> ?option value ...?}
        description {Common options include `content`, `noserver`, `reset`, and `version`.

The response is sent when the current event completes. You cannot alter it in later HTTP events or after another response has already been sent.

**Security**: When the response body contains user-supplied data
(HTTP headers, URI, payload), HTML-encode it to prevent XSS.
For blocking/maintenance pages, include `Connection close` and
`Cache-Control no-store` headers:
```tcl
HTTP::respond 403 content $html Connection close Cache-Control no-store
```}
        source {https://clouddocs.f5.com/api/irules/HTTP__respond.html}
    }
}

