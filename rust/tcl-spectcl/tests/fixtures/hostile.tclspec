# A deliberately hostile pack — the negative half of the corpus-validation
# harness (`../spec_corpus.rs`).
#
# `docs/design/spec-packs.md` makes containment a load-bearing guarantee:
# "a spec must never be able to take the LSP down … a panic, budget blowout,
# or stack overflow in a hook is converted to abstention, never propagation".
# This pack is what proves it against the *real* loader, the *real* plan, and
# the *real* host with its default budgets — not a unit-test stub.
#
# It is NOT under `specs/` and NOT under `docs/design/spec-dsl-examples/`, so
# discovery never finds it and no shipped tier can pick it up. It exists only
# for the harness, which loads it by explicit path.
#
# Three hooks, one per containment mode:
#
#   hostile::spin   an unbounded `while {1}` — the loop the compiler inlines
#                   into bytecode, so the command counter is never charged and
#                   only the wall-clock cap can stop it.
#   hostile::burn   a 100-million-iteration loop aimed at the command budget.
#                   It is caught by the wall-clock cap instead, and that is
#                   the design's own point rather than a miss: "the command
#                   limit counts *dispatched* commands ... so a loop the
#                   compiler inlines into bytecode is not charged; the
#                   wall-clock cap, polled inside the bytecode trampoline, is
#                   what stops that case" (spec-packs.md). The harness asserts
#                   a budget blowout, not which budget — either answer is
#                   containment working.
#   hostile::boom   a body the harness's engine wrapper panics on. No Tcl body
#                   can be relied on to panic a *correct* VM, so the panic is
#                   injected at the engine boundary by the marker below — the
#                   same code path a real panic takes, above the same real
#                   loader/plan/host seam.
#
# Every one of the three must end as abstention plus a crash record, with the
# hook quarantined and the harness still running.

speclib hostile 1 {
    command hostile::spin {
        arity 1
        arg 0 -role Value
        hover { summary {Never returns; the wall-clock cap must stop it.} }
        const_fold -inputs {words} {words ctx} {
            set spun 0
            while {1} {
                set spun [expr {$spun + 1}]
            }
            fold $spun
        }
    }

    command hostile::burn {
        arity 1
        arg 0 -role Value
        hover { summary {Outspends the command budget.} }
        const_fold -inputs {words} {words ctx} {
            set total 0
            for {set i 0} {$i < 100000000} {incr i} {
                set total [expr {$total + [string length [lindex $words 0]]}]
            }
            fold $total
        }
    }

    command hostile::boom {
        arity 1
        arg 0 -role Value
        hover { summary {Panics inside the engine.} }
        const_fold -inputs {words} {words ctx} {
            set marker HARNESS-PANIC-INJECT
            fold [string length [lindex $words 0]]
        }
    }
}
