{
  "bundles": [
    {
      "rule": {
        "fullPath": "/Common/ref_rule",
        "name": "ref_rule",
        "source": "when HTTP_REQUEST {\n        pool /Common/real_pool\n        pool /Common/ghost_pool\n        node /Common/ghost_node 80\n        virtual /Common/ghost_vs\n        persist uie /Common/ghost_persist\n    }"
      },
      "pools": [
        {
          "fullPath": "/Common/real_pool",
          "monitor": "/Common/real_mon",
          "loadBalancingMode": null,
          "members": [
            {
              "name": "/Common/n1:80",
              "address": "10.0.0.10",
              "port": null,
              "monitor": null
            }
          ]
        }
      ],
      "dataGroups": [],
      "persistence": [],
      "snatPools": [],
      "profiles": [],
      "monitors": [
        {
          "fullPath": "/Common/real_mon",
          "type": "http"
        }
      ],
      "nodes": [
        {
          "fullPath": "/Common/n1",
          "address": "10.0.0.10"
        }
      ],
      "rules": [],
      "unresolved": {
        "pool": [
          "/Common/ghost_pool"
        ],
        "node": [
          "/Common/ghost_node"
        ]
      },
      "sourceSlices": {
        "/Common/ref_rule": "ltm rule /Common/ref_rule {\n    when HTTP_REQUEST {\n        pool /Common/real_pool\n        pool /Common/ghost_pool\n        node /Common/ghost_node 80\n        virtual /Common/ghost_vs\n        persist uie /Common/ghost_persist\n    }\n}\n",
        "/Common/real_pool": "ltm pool /Common/real_pool {\n    members {\n        /Common/n1:80 {\n            address 10.0.0.10\n        }\n    }\n    monitor /Common/real_mon\n}\n",
        "/Common/n1": "ltm node /Common/n1 {\n    address 10.0.0.10\n}\n",
        "/Common/real_mon": "ltm monitor http /Common/real_mon {\n    interval 5\n    timeout 16\n}\n"
      }
    }
  ]
}
