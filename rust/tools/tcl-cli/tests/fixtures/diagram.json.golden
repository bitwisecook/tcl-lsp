{
  "events": [
    {
      "name": "CLIENT_ACCEPTED",
      "priority": null,
      "multiplicity": "once_per_connection",
      "flow": [
        {
          "kind": "switch",
          "subject": "[IP::client_addr]",
          "arms": [
            {
              "pattern": "10.0.0.1 | 10.0.0.2",
              "body": [
                {
                  "kind": "action",
                  "label": "pool secure_pool",
                  "command": "pool",
                  "args": [
                    "secure_pool"
                  ]
                }
              ]
            },
            {
              "pattern": "192.168.1.1",
              "body": [
                {
                  "kind": "action",
                  "label": "node 1.2.3.4 80",
                  "command": "node",
                  "args": [
                    "1.2.3.4",
                    "80"
                  ]
                }
              ]
            },
            {
              "pattern": "default",
              "body": [
                {
                  "kind": "action",
                  "label": "pool default_pool",
                  "command": "pool",
                  "args": [
                    "default_pool"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "HTTP_REQUEST",
      "priority": 200,
      "multiplicity": "per_request",
      "flow": [
        {
          "kind": "if",
          "branches": [
            {
              "condition": "[HTTP::uri] starts_with \"/api\"",
              "body": [
                {
                  "kind": "assign",
                  "var": "host",
                  "value": "[HTTP::header value Host]"
                },
                {
                  "kind": "action",
                  "label": "pool api_pool",
                  "command": "pool",
                  "args": [
                    "api_pool"
                  ]
                }
              ]
            },
            {
              "condition": "else",
              "body": [
                {
                  "kind": "action",
                  "label": "HTTP::respond 404 content not found",
                  "command": "HTTP::respond",
                  "args": [
                    "404",
                    "content",
                    "not found"
                  ]
                }
              ]
            }
          ]
        },
        {
          "kind": "loop",
          "label": "foreach k v",
          "body": [
            {
              "kind": "action",
              "label": "log local0. ${k}=${v}",
              "command": "log",
              "args": [
                "local0.",
                "${k}=${v}"
              ]
            }
          ]
        },
        {
          "kind": "catch",
          "body": [
            {
              "kind": "action",
              "label": "HTTP::collect 100",
              "command": "HTTP::collect",
              "args": [
                "100"
              ]
            }
          ]
        },
        {
          "kind": "try",
          "body": [
            {
              "kind": "assign",
              "var": "r",
              "value": "[helper $host]"
            }
          ],
          "handlers": [
            {
              "kind_handler": "on",
              "match": "error",
              "body": [
                {
                  "kind": "action",
                  "label": "log local0. failed",
                  "command": "log",
                  "args": [
                    "local0.",
                    "failed"
                  ]
                }
              ]
            }
          ],
          "finally": [
            {
              "kind": "action",
              "label": "HTTP::release",
              "command": "HTTP::release",
              "args": []
            }
          ]
        }
      ]
    },
    {
      "name": "HTTP_RESPONSE",
      "priority": null,
      "multiplicity": "per_request",
      "flow": [
        {
          "kind": "action",
          "label": "log local0. done",
          "command": "log",
          "args": [
            "local0.",
            "done"
          ]
        }
      ]
    }
  ],
  "procedures": [
    {
      "name": "helper",
      "params": [
        "h"
      ],
      "flow": [
        {
          "kind": "assign",
          "var": "looked",
          "value": "[class match -value $h equals hosts]"
        },
        {
          "kind": "return",
          "label": "return ${looked}"
        }
      ]
    }
  ]
}
