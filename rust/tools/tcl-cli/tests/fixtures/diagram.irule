when CLIENT_ACCEPTED {
    switch [IP::client_addr] {
        "10.0.0.1" -
        "10.0.0.2" { pool secure_pool }
        "192.168.1.1" { node 1.2.3.4 80 }
        default { pool default_pool }
    }
}
when HTTP_REQUEST priority 200 {
    if {[HTTP::uri] starts_with "/api"} {
        set host [HTTP::header value Host]
        pool api_pool
    } else {
        HTTP::respond 404 content "not found"
    }
    foreach {k v} $pairs {
        log local0. "$k=$v"
    }
    catch { HTTP::collect 100 } err
    try {
        set r [helper $host]
    } on error {e opts} {
        log local0. "failed"
    } finally {
        HTTP::release
    }
}
when HTTP_RESPONSE {
    log local0. "done"
}
proc helper {h} {
    set looked [class match -value $h equals hosts]
    return $looked
}
