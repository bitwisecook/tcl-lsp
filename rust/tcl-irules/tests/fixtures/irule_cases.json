[
 [
  "when HTTP_REQUEST {\n  pool web_pool\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  set p /Common/api_pool\n  pool $p\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  pool $undefined\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  pool members foo\n}\n",
  "ltm"
 ],
 [
  "when CLIENT_ACCEPTED {\n  virtual vs1\n  node n1\n  snatpool sp1\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  class lookup [HTTP::host] my_dg\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  if [class match [HTTP::host] equals dg] {\n    pool p\n  }\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  persist /Common/my_persist\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  persist cookie insert /Common/cp\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  snat pool sp2\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  LB::reselect pool p3\n}\n",
  "ltm"
 ],
 [
  "when HTTP_REQUEST {\n  set x [HTTP::host]\n  pool $x\n}\n",
  "ltm"
 ],
 [
  "when DNS_REQUEST {\n  pool gpool\n}\n",
  "gtm"
 ],
 [
  "when HTTP_REQUEST {\n  SSL::profile clientssl\n}\n",
  "ltm"
 ],
 [
