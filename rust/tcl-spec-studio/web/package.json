{
  "name": "@tcl-spec-studio/web",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript front-end for the tcl-lsp command-registry spec studio.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs --tests && node --test dist/tests/units.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test --ext .ts && prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver-protocol": "^3.18.2"
  }
}
