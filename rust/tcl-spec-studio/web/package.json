{
  "name": "@tcl-spec-studio/web",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript front-end for the tcl-lsp command-registry spec studio.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@12.2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "install:chromium": "playwright install --with-deps chromium",
    "test": "node build.mjs --tests && node --test dist/tests/units.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
