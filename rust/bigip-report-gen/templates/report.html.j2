<!doctype html>
<!-- Generated by the bitwisecook BIG-IP Report Generator · https://github.com/bitwisecook · https://github.com/bitwisecook/tcl-lsp -->
<html lang="en" data-theme="auto" data-generator="bitwisecook-bigip-report-generator" data-generator-url="https://github.com/bitwisecook" data-report-id="{{ report_id }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="bitwisecook BIG-IP Report Generator & f5-query — https://github.com/bitwisecook">
<meta name="author" content="bitwisecook (https://github.com/bitwisecook)">
<title>{{ title }}</title>
<style>
{{ report_css | safe }}
{{ topology_css | safe }}
{{ certs_css | safe }}
{{ secrets_css | safe }}
{{ apm_css | safe }}
{{ forensics_css | safe }}
{{ print_css | safe }}
</style>
</head>
<body>
<!-- bitwisecook BIG-IP Report Generator — https://github.com/bitwisecook -->
<div class="visually-hidden" aria-hidden="true">Generated by the bitwisecook BIG-IP Report Generator — https://github.com/bitwisecook</div>
<header class="topbar">
  <div class="brand">
    {# No user-supplied logo → the f5-query mark, inlined as <svg>. The footer
       inlines the same mark, and ids are document-global, so this copy's ids
       (all of them `f5q-…`, along with every url(#…) that points at them) are
       re-prefixed — two copies of `f5q-a` would be a duplicate id. #}
    {% if logo %}<img class="logo logo-custom" src="{{ logo }}" alt="Report logo">{% else %}<span class="logo logo-mark" role="img" aria-label="f5-query">{{ logo_f5q_svg | replace("f5q-", "hdrf5q-") | safe }}</span>{% endif %}
    <div>
      <h1>{{ title }}</h1>
      <p class="sub">
        Generated {{ generated_at }} ·
        {{ devices|length }} device{{ 's' if devices|length != 1 else '' }} ·
        query&nbsp;engine v{{ engine_version }}
      </p>
      <span class="by">BIG-IP&nbsp;Report&nbsp;Generator &amp; f5&#8209;query by <a href="https://github.com/bitwisecook" rel="noopener">bitwisecook</a></span>
    </div>
  </div>
  <div class="topbar-actions">
    <input id="globalSearch" type="search" placeholder="Search everything… (/)" autocomplete="off">
    <button id="themeToggle" title="Toggle light / dark" aria-label="Toggle theme">◐</button>
  </div>
</header>

{% macro chip(label, value, tone='', target='') %}
<div class="chip {{ tone }}{{ ' chip-link' if target }}"{% if target %} data-target="{{ target }}" role="button" tabindex="0" title="Go to {{ label }}"{% endif %}><span class="chip-val">{{ value }}</span><span class="chip-lbl">{{ label }}</span></div>
{% endmacro %}

{#: Render a firewall rule endpoint (source / destination) compactly. :#}
{% macro fw_endpoint(e) %}
{%- if not e or (not e.addresses and not e.addressLists and not e.ports and not e.portLists) -%}
<span class="muted">any</span>
{%- else -%}
{% for x in e.addresses %}<span class="tag">{{ x }}</span>{% endfor %}
{%- for x in e.addressLists %}<span class="tag blue" title="address-list">{{ x | leaf }}</span>{% endfor %}
{%- for x in e.ports %}<span class="tag amber">:{{ x }}</span>{% endfor %}
{%- for x in e.portLists %}<span class="tag" title="port-list">:{{ x | leaf }}</span>{% endfor %}
{%- endif -%}
{% endmacro %}

<section class="summary">
  {{ chip('Virtual Servers', totals.virtuals, '', 'virtuals') }}
  {{ chip('Pools', totals.pools, '', 'pools') }}
  {{ chip('Pool Members', totals.poolMembers, '', 'pools') }}
  {{ chip('Nodes', totals.nodes, '', 'nodes') }}
  {{ chip('iRules', totals.rules, '', 'rules') }}
  {{ chip('Monitors', totals.monitors, '', 'monitors') }}
  {{ chip('Data Groups', totals.dataGroups, '', 'dataGroups') }}
  {{ chip('Orphaned Objects', totals.orphans, 'warn' if totals.orphans else 'ok') }}
  {{ chip('SSL Certificates', totals.certificates, '', 'certificates') }}
</section>

{% if architecture and architecture.deviceCount > 1 %}
<section class="architecture" id="architecture">
  <div class="arch-head">
    <h2>Architecture</h2>
    <span class="muted">how the loaded devices relate as tiers —
      {%- if architecture.defined %} from manifest{% else %} auto-detected from address overlap{% endif -%}
    </span>
  </div>
  {% if architecture.manifestError %}
  <div class="insight warn"><span class="dot"></span>Manifest ignored: {{ architecture.manifestError }}</div>
  {% endif %}
  <div class="arch-diagram diag-host" id="archDiagram" aria-label="Interactive architecture diagram — click a device to jump to it"></div>
  <div class="arch-tiers-lbl">Devices by tier</div>
  <div class="arch-tiers">
    {% for t in architecture.tiers %}
    <div class="arch-tier">
      <div class="arch-tier-lbl">Tier {{ t.tier }}</div>
      {% for d in t.devices %}
      <div class="arch-node arch-role-{{ d.role }}">
        <span class="arch-node-name">{{ d.label }}</span>
        <span class="arch-node-role">{{ d.role }}</span>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% if architecture.links %}
  <div class="tablewrap">
  <table class="grid arch-links">
    <thead><tr><th>Upstream</th><th></th><th>Downstream</th><th>Source</th><th>Evidence</th></tr></thead>
    <tbody>
      {% for l in architecture.links %}
      <tr>
        <td class="mono strong">{{ l.fromLabel }}</td>
        <td class="arch-arrow">→</td>
        <td class="mono strong">{{ l.toLabel }}</td>
        <td>{% if l.source == 'auto' %}<span class="tag">auto</span>{% elif l.source == 'manifest' %}<span class="tag blue">manifest</span>{% else %}<span class="tag green">manifest + auto</span>{% endif %}</td>
        <td class="mono">
          {%- if l.vias %}
          {% for v in l.vias[:4] %}<span class="tag" title="{{ v.fromObj }} → {{ v.toObj }}">{{ v.address }}{% if v.port %}:{{ v.port }}{% endif %}</span>{% endfor %}
          {%- if l.viaCount > 4 %}<span class="muted">+{{ l.viaCount - 4 }} more</span>{% endif %}
          {%- elif l.label %}<span class="muted">{{ l.label }}</span>
          {%- else %}<span class="muted">—</span>{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
</section>
{% endif %}

{% if devices|length > 1 %}
<nav class="device-switch" role="tablist" aria-label="Devices">
  {% for d in devices %}
  <button class="dev-tab{{ ' active' if loop.first }}" data-dev="{{ loop.index0 }}">{{ d.name }}</button>
  {% endfor %}
</nav>
{% endif %}

{% for d in devices %}
<article class="device{{ ' active' if loop.first }}" data-dev="{{ loop.index0 }}">
  <div class="device-head">
    <h2>{{ d.name }}</h2>
    <div class="device-meta">
      {% if d.tmshVersion %}<span class="badge">TMOS {{ d.tmshVersion }}</span>{% endif %}
      <span class="badge muted">{{ d.uri | leaf }}</span>
    </div>
  </div>

  {% if d.partitions and d.partitions | length > 1 %}
  <div class="partition-bar">
    <span class="partition-lbl">Partition</span>
    <select class="partition-filter" aria-label="Filter by partition">
      <option value="__all__">All partitions</option>
      {% for pt in d.partitions %}<option value="{{ pt }}">/{{ pt }}</option>{% endfor %}
    </select>
    <span class="partition-note">shared <code>/Common</code> objects stay visible</span>
  </div>
  {% endif %}

  <div class="view-controls">
    <label class="sys-toggle"><input type="checkbox" class="show-system"> Show built-in / system objects — default profiles, monitors and <code>_sys_*</code> internals</label>
  </div>

  {% if d.insights %}
  <div class="insights">
    {% for ins in d.insights %}
    <div class="insight {{ ins.level }}"><span class="dot"></span>{{ ins.text }}</div>
    {% endfor %}
  </div>
  {% endif %}

  <nav class="tabs" role="tablist">
    {% if front_matter_html %}<button class="tab active" data-panel="frontMatter">Front matter</button>{% endif %}
    <button class="tab{% if not front_matter_html %} active{% endif %}" data-panel="virtuals">Virtual Servers <span class="n">{{ d.counts.virtuals }}</span></button>
    <button class="tab" data-panel="pools">Pools <span class="n">{{ d.counts.pools }}</span></button>
    <button class="tab" data-panel="nodes">Nodes <span class="n">{{ d.counts.nodes }}</span></button>
    <button class="tab" data-panel="monitors">Monitors <span class="n">{{ d.counts.monitors }}</span></button>
    <button class="tab" data-panel="rules">iRules <span class="n">{{ d.counts.rules }}</span></button>
    <button class="tab" data-panel="dataGroups">Data Groups <span class="n">{{ d.counts.dataGroups }}</span></button>
    <button class="tab" data-panel="profiles">Profiles <span class="n">{{ d.counts.profiles }}</span></button>
    <button class="tab" data-panel="certificates">SSL Certificates <span class="n">{{ d.counts.certificates }}</span></button>
    {% if d.counts.secrets %}<button class="tab" data-panel="secrets">Secrets <span class="n">{{ d.counts.secrets }}</span></button>{% endif %}
    {% if d.counts.apmProfiles %}<button class="tab" data-panel="apm">APM <span class="n">{{ d.counts.apmProfiles }}</span></button>{% endif %}
    {% if d.counts.gtm %}<button class="tab" data-panel="gtm">GTM / DNS <span class="n">{{ d.counts.gtm }}</span></button>{% endif %}
    {% if d.counts.firewall %}<button class="tab" data-panel="firewall">Firewall / NAT <span class="n">{{ d.counts.firewall }}</span></button>{% endif %}
    {% if d.counts.files or d.forensics.flagged %}<button class="tab" data-panel="forensics">Forensics <span class="n">{{ d.counts.files }}</span></button>{% endif %}
    <button class="tab" data-panel="objectIndex">Object Index</button>
    <button class="tab" data-panel="topology">Topology</button>
    <button class="tab" data-panel="listener">Listener Matcher</button>
    <button class="tab" data-panel="apps">Apps <span class="n app-badge">0</span></button>
    <button class="tab" data-panel="f5sites">F5 Sites</button>
    {% if has_console %}
    <button class="tab" data-panel="console">Query Console</button>
    {% endif %}
  </nav>

  {#: ---------------- Front matter (user-supplied Markdown) ---------------- :#}
  {% if front_matter_html %}
  <div class="panel active" data-panel="frontMatter">
    <div class="front-matter md-body">{{ front_matter_html | safe }}</div>
  </div>
  {% endif %}

  {#: ---------------- Virtual Servers ---------------- :#}
  <div class="panel{% if not front_matter_html %} active{% endif %}" data-panel="virtuals">
    <div class="app-bar">
      <span class="app-bar-lbl">Bundle as app:</span>
      <input class="app-name" type="text" placeholder="App name…" maxlength="60" aria-label="App name">
      <button class="app-save" type="button" title="Save the ticked virtual servers as an app (stored in this browser)">💾 Save app</button>
      <span class="app-count muted">0 selected</span>
      <span class="app-hint muted">tick virtual servers, name the app, then open the Apps tab</span>
    </div>
    <div class="tablewrap">
    <table class="grid">
      <thead><tr>
        <th class="app-col"><input type="checkbox" class="app-pick-all" title="Select all visible" aria-label="Select all"></th>
        <th>Name</th><th>Destination</th><th>Port</th><th>Pool</th>
        <th>Profiles</th><th>iRules</th><th>SNAT</th><th>Proto</th><th></th>
      </tr></thead>
      <tbody>
      {% for v in d.virtuals %}
      <tr class="searchable{{ ' is-disabled' if v.disabled }}" data-search="{{ v.name }} {{ v.fullPath }} {{ v.destAddr }} {{ v.destPort }} {{ v.source }} {{ v.ipProtocol }} {{ v.description }}">
        <td class="app-col"><input type="checkbox" class="app-pick" data-vs="vs:{{ v.fullPath }}" data-name="{{ v.name }}" aria-label="Select {{ v.name }}"></td>
        <td class="mono strong"><span class="objlink namelink" data-oid="vs:{{ v.fullPath }}">{{ v.name }}</span>{% if v.disabled %} <span class="tag red">disabled</span>{% endif %}</td>
        <td class="mono">{{ v.destAddr }}</td>
        <td class="mono">{{ v.destPort }}</td>
        <td class="mono">{% if v.pool %}<a href="#" class="ref" data-oid="pool:{{ v.pool }}">{{ v.pool | leaf }}</a>{% else %}<span class="muted">—</span>{% endif %}</td>
        <td>{% for p in v.profiles %}<span class="tag" data-oid="prof:{{ p }}">{{ p | leaf }}</span>{% endfor %}</td>
        <td>{% for r in v.rules %}<span class="tag blue" data-oid="rule:{{ r }}">{{ r | leaf }}</span>{% endfor %}</td>
        <td class="mono small">{{ v.snatpool | leaf if v.snatpool else v.sourceXlate or '—' }}</td>
        <td class="mono small">{{ v.ipProtocol }}</td>
        <td>{% if v.description %}<span class="info-i" title="{{ v.description }}">i</span>{% endif %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>

  {#: ---------------- Pools ---------------- :#}
  <div class="panel" data-panel="pools">
    <div class="tablewrap">
    <table class="grid">
      <thead><tr>
        <th></th><th>Name</th><th>Members</th><th>Monitor</th><th>LB Mode</th><th>Used By</th>
      </tr></thead>
      <tbody>
      {% for p in d.pools %}
      <tr class="searchable expandable{{ ' orphan' if p.orphanStatus == 'orphan' }}{{ ' possible-orphan' if p.orphanStatus == 'possible' }}" data-search="{{ p.name }} {{ p.fullPath }} {{ p.lbMode }} {% for m in p.members %}{{ m.address }} {{ m.port }} {% endfor %}">
        <td class="expander">{% if p.members %}▸{% endif %}</td>
        <td class="mono strong"><span class="objlink namelink" data-oid="pool:{{ p.fullPath }}">{{ p.name }}</span>{% if p.orphanStatus == 'orphan' %} <span class="tag amber">orphan</span>{% elif p.orphanStatus == 'possible' %} <span class="tag" title="No static reference, but {% for m in p.orphanMatches %}iRule {{ m.rule }} could build a matching name ({{ m.pattern }}){% if not loop.last %}; {% endif %}{% else %}an iRule selects pools dynamically{% endfor %} — can't be proven unused">possible orphan</span>{% endif %}</td>
        <td>{{ p.memberCount }}{% if p.memberCount == 0 %} <span class="tag amber">empty</span>{% endif %}</td>
        <td class="mono small">{{ p.monitor or '—' }}</td>
        <td class="mono small">{{ p.lbMode or 'round-robin' }}</td>
        <td class="mono small">{% for u in p.usedBy %}<span class="tag blue" data-oref="{{ u }}">{{ u | leaf }}</span>{% else %}<span class="muted">nothing</span>{% endfor %}</td>
      </tr>
      {% if p.members %}
      <tr class="detail"><td></td><td colspan="5">
        <table class="subgrid">
          <thead><tr><th>Member</th><th>Address</th><th>Port</th><th>Monitor</th></tr></thead>
          <tbody>
          {% for m in p.members %}
          <tr><td class="mono">{{ m.name | leaf }}</td><td class="mono">{{ m.address }}</td><td class="mono">{{ m.port }}</td><td class="mono small">{{ m.monitor or '—' }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </td></tr>
      {% endif %}
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>

  {#: ---------------- Nodes ---------------- :#}
  <div class="panel" data-panel="nodes">
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Name</th><th>Address</th><th>Monitor</th><th>Used By Pools</th></tr></thead>
      <tbody>
      {% for n in d.nodes %}
      <tr class="searchable{{ ' orphan' if n.orphanStatus == 'orphan' }}{{ ' possible-orphan' if n.orphanStatus == 'possible' }}" data-search="{{ n.name }} {{ n.fullPath }} {{ n.address }}">
        <td class="mono strong"><span class="objlink namelink" data-oid="node:{{ n.fullPath }}">{{ n.name }}</span>{% if n.orphanStatus == 'orphan' %} <span class="tag amber">orphan</span>{% elif n.orphanStatus == 'possible' %} <span class="tag" title="No static reference, but {% for m in n.orphanMatches %}iRule {{ m.rule }} could build a matching name ({{ m.pattern }}){% if not loop.last %}; {% endif %}{% else %}an iRule selects nodes dynamically{% endfor %} — can't be proven unused">possible orphan</span>{% endif %}</td>
        <td class="mono">{{ n.address }}</td>
        <td class="mono small">{{ n.monitor or '—' }}</td>
        <td class="mono small">{% for u in n.usedBy %}<span class="tag" data-oref="{{ u }}">{{ u | leaf }}</span>{% else %}<span class="muted">nothing</span>{% endfor %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>

  {#: ---------------- Monitors ---------------- :#}
  <div class="panel" data-panel="monitors">
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Name</th><th>Type</th><th>Interval</th><th>Timeout</th><th>Send</th><th>Receive</th><th>Used By</th></tr></thead>
      <tbody>
      {% for mo in d.monitors %}
      <tr class="searchable{{ ' orphan' if not mo.usedBy }}" data-search="{{ mo.name }} {{ mo.fullPath }} {{ mo.type }}">
        <td class="mono strong"><span class="objlink namelink" data-oid="mon:{{ mo.fullPath }}">{{ mo.name }}</span></td>
        <td><span class="tag">{{ mo.type }}</span></td>
        <td class="mono">{{ mo.interval }}</td>
        <td class="mono">{{ mo.timeout }}</td>
        <td class="mono small clip">{{ mo.send or '—' }}</td>
        <td class="mono small clip">{{ mo.recv or '—' }}</td>
        <td class="mono small">{{ mo.usedBy|length }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>

  {#: ---------------- iRules ---------------- :#}
  <div class="panel" data-panel="rules">
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th></th><th>Name</th><th>Events</th><th>Lines</th><th>Attached To</th></tr></thead>
      <tbody>
      {% for r in d.rules %}
      <tr class="searchable expandable{{ ' orphan' if not r.usedBy }}" data-search="{{ r.name }} {{ r.fullPath }} {{ r.events | join(' ') }} {{ r.refPools | join(' ') }} {{ r.refDataGroups | join(' ') }} {{ r.body }}">
        <td class="expander">▸</td>
        <td class="mono strong"><span class="objlink namelink" data-oid="rule:{{ r.fullPath }}">{{ r.name }}</span>{% if not r.usedBy %} <span class="tag amber">unattached</span>{% endif %}</td>
        <td>{% for e in r.events %}<span class="tag blue">{{ e }}</span>{% endfor %}</td>
        <td class="mono">{{ r.lineCount }}</td>
        <td class="mono small">{% for u in r.usedBy %}<span class="tag">{{ u | leaf }}</span>{% else %}<span class="muted">—</span>{% endfor %}</td>
      </tr>
      <tr class="detail"><td></td><td colspan="4">{% set ro = r.referencedObjects %}{% if ro %}<div class="irule-refs">{% if ro.static %}<div class="refs-static"><span class="refs-lbl">Referenced objects:</span> {% for o in ro.static %}<span class="objlink ref-obj" data-oid="{{ o.oid }}" title="{{ o.type }} {{ o.fullPath }}">{{ o.type }} {{ o.name }}</span> {% endfor %}</div>{% endif %}{% if not ro.static and not ro.dynamic %}<div class="refs-none muted">No pool / node / snatpool / data-group references (static or dynamic) in this iRule.</div>{% endif %}{% for g in ro.dynamic %}<div class="refs-dyn"><div class="refs-ctx">Potentially referenced objects{% if g.attached %} — resolved for {% for vn in g.virtuals %}<span class="tag">{{ vn }}</span>{% endfor %} in partition <code>/{{ g.partition }}</code>{% else %} — this iRule is not attached to any virtual; filters resolved in <code>/{{ g.partition }}</code>{% endif %}</div><table class="refs-table"><thead><tr><th>Determined filter</th><th>Type</th><th>Matching objects (this partition)</th></tr></thead><tbody>{% for f in g.filters %}<tr><td><code class="attach-pat" title="reconstructed from the iRule source: {{ f.raw }}">{{ f.glob }}</code>{% if f.unconstrained %} <span class="muted small">(any name)</span>{% elif f.exact %} <span class="muted small">(exact)</span>{% endif %}</td><td class="mono small">{{ f.type }}</td><td>{% for o in f.objects %}<span class="objlink ref-obj" data-oid="{{ o.oid }}" title="{{ o.fullPath }}">{{ o.name }}</span> {% else %}<span class="muted">{% if f.unconstrained %}any {{ f.type }} in scope{% else %}none defined match{% endif %}</span>{% endfor %}</td></tr>{% endfor %}</tbody></table></div>{% endfor %}</div>{% endif %}{% if r.flowchart %}<div class="irule-flow"><div class="irule-flow-src" hidden>{{ r.flowchart }}</div><div class="irule-flow-diagram diag-host"></div></div>{% endif %}<pre class="code tcl">{{ r.bodyHtml | safe }}</pre></td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>

  {#: ---------------- Data Groups ---------------- :#}
  <div class="panel" data-panel="dataGroups">
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th></th><th>Name</th><th>Type</th><th>Records</th><th>Used By</th></tr></thead>
      <tbody>
      {% for g in d.dataGroups %}
      <tr class="searchable expandable{{ ' orphan' if not g.usedBy }}" data-search="{{ g.name }} {{ g.fullPath }} {{ g.type }} {{ g.records | join(' ') }}">
        <td class="expander">{% if g.records %}▸{% endif %}</td>
        <td class="mono strong"><span class="objlink namelink" data-oid="dg:{{ g.fullPath }}">{{ g.name }}</span></td>
        <td><span class="tag">{{ g.type }}</span></td>
        <td class="mono">{{ g.recordCount }}</td>
        <td class="mono small">{{ g.usedBy|length }}</td>
      </tr>
      {% if g.records %}
      <tr class="detail"><td></td><td colspan="4"><div class="records">{% for rec in g.records %}<code>{{ rec }}</code>{% endfor %}</div></td></tr>
      {% endif %}
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>

  {#: ---------------- Profiles ---------------- :#}
  <div class="panel" data-panel="profiles">
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Name</th><th>Type</th><th>Parent</th><th>Certificate</th><th>Ciphers</th><th>Used By</th></tr></thead>
      <tbody>
      {% for p in d.profiles %}
      <tr class="searchable" data-search="{{ p.name }} {{ p.fullPath }} {{ p.type }} {{ p.cert }} {{ p.parent }}">
        <td class="mono strong"><span class="objlink namelink" data-oid="prof:{{ p.fullPath }}">{{ p.name }}</span></td>
        <td><span class="tag{{ ' green' if 'SSL' in p.type }}">{{ p.type }}</span></td>
        <td class="mono small">{{ p.parent | leaf if p.parent else '—' }}</td>
        <td class="mono small">{{ p.cert | leaf if p.cert else '—' }}</td>
        <td class="mono small clip">{{ p.ciphers or '—' }}</td>
        <td class="mono small">{{ p.usedBy|length }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>

  {#: ---------------- SSL Certificates ---------------- :#}
  <div class="panel" data-panel="certificates">
    <p class="lm-field-note">Certificate inventory pulled straight from the config — every <code>sys file ssl-cert</code> stanza carries its own expiry, subject and issuer. <b>Days remaining is computed live against your clock</b>, so this view is current whenever the report is opened. Sorted soonest-to-expire first; expired and expiring-within-30-days are flagged. Click a row for the SAN list, fingerprint and what uses it.</p>
    <div class="cert-summary"></div>
    <div class="cert-controls">
      <label><input type="checkbox" class="cert-only-problems"> Only show expired / expiring soon</label>
      <label>Warn within
        <select class="cert-window">
          <option value="14">14 days</option>
          <option value="30" selected>30 days</option>
          <option value="60">60 days</option>
          <option value="90">90 days</option>
        </select>
      </label>
    </div>
    {% if d.certificates %}
    <div class="tablewrap">
    <table class="grid cert-grid">
      <thead><tr>
        <th></th><th>Certificate</th><th>Subject (CN)</th><th>Issuer</th>
        <th>Expires</th><th class="cert-remaining-col">Remaining</th><th>Key</th><th>Used By</th>
      </tr></thead>
      <tbody>
      {% for c in d.certificates %}
      <tr class="searchable expandable cert-row" data-epoch="{{ c.expirationDate }}"
          data-search="{{ c.name }} {{ c.fullPath }} {{ c.subject }} {{ c.issuer }} {{ c.subjectAlternativeName }} {{ c.usedByVirtuals | join(' ') }} {{ c.usedByProfiles | join(' ') }}">
        <td class="expander">▸</td>
        <td class="mono strong"><span class="objlink">{{ c.name }}</span>{% if c.isBundle == 'true' %} <span class="tag">bundle</span>{% endif %}</td>
        <td class="mono small clip">{{ c.subject or '—' }}</td>
        <td class="mono small clip">{{ c.issuer or '—' }}</td>
        <td class="mono small">{{ c.expirationString or '—' }}</td>
        <td class="mono small cert-remaining">—</td>
        <td class="mono small">{{ c.keyType }}{% if c.keySize %}/{{ c.keySize }}{% endif %}</td>
        <td class="mono small">{% for u in c.usedByVirtuals %}<span class="tag blue">{{ u | leaf }}</span>{% else %}{% if c.usedByProfiles %}{% for p in c.usedByProfiles %}<span class="tag">{{ p | leaf }}</span>{% endfor %}{% else %}<span class="tag amber">unused</span>{% endif %}{% endfor %}</td>
      </tr>
      <tr class="detail"><td></td><td colspan="7">
        <div class="cert-detail">
          <div><span class="cd-k">Full path</span><span class="mono">{{ c.fullPath }}</span>{% if c.fromCertFile %} <span class="tag" title="Subject, validity, SANs and chain were parsed from the certificate in the UCS filestore, not from the config stanza">parsed from cert file</span>{% endif %}</div>
          {% if c.notBefore %}<div><span class="cd-k">Issued</span><span class="mono small">{{ c.notBefore }}</span></div>{% endif %}
          {% if c.expirationString %}<div><span class="cd-k">Expires</span><span class="mono small">{{ c.expirationString }}</span></div>{% endif %}
          {% if c.subjectAlternativeName %}<div><span class="cd-k">SAN</span><span class="mono small">{{ c.subjectAlternativeName }}</span></div>{% endif %}
          {% if c.sigAlg %}<div><span class="cd-k">Signature</span><span class="mono small">{{ c.sigAlg }}</span></div>{% endif %}
          {% if c.fingerprint %}<div><span class="cd-k">Fingerprint</span><span class="mono small">{{ c.fingerprint }}</span></div>{% endif %}
          {% if c.serialNumber %}<div><span class="cd-k">Serial</span><span class="mono small">{{ c.serialNumber }}</span></div>{% endif %}
          {% if c.chain %}<div class="cert-chain"><span class="cd-k">Chain</span>
            <ol class="chain-list">
            {% for link in c.chain %}
              {% if link.role == 'gap' %}<li class="chain-gap"><span class="tag amber">chain incomplete — issuer <span class="mono">{{ link.cn }}</span> not in config</span></li>
              {% else %}<li class="chain-{{ link.role }}"><span class="tag">{{ link.role }}</span> <span class="mono small">{{ link.cn }}</span>{% if link.selfSigned %} <span class="muted small">(self-signed)</span>{% endif %}{% if link.notAfter %} <span class="muted small">· exp {{ link.notAfter }}</span>{% endif %}</li>{% endif %}
            {% endfor %}
            </ol>
          </div>{% endif %}
          {% if c.hasKey %}<div><span class="cd-k">Private key</span><span class="mono small">{{ c.keyPath | leaf }}{% if c.keySecurityType %} · {{ c.keySecurityType }}{% endif %}{% if c.keyPassphrase %} · passphrase {% if c.keyPassphraseEncrypted %}<span class="tag amber">encrypted — supply the f5mku master key to reveal</span>{% else %}<code class="secret">{{ c.keyPassphrase }}</code>{% endif %}{% endif %}</span></div>{% endif %}
          {% if c.usedByProfiles %}<div><span class="cd-k">Profiles</span><span class="mono small">{{ c.usedByProfiles | join(', ') }}</span></div>{% endif %}
          {% if c.sourcePath %}<div><span class="cd-k">Source</span><span class="mono small">{{ c.sourcePath }}</span></div>{% endif %}
        </div>
      </td></tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% else %}
    <p class="hint">No <code>sys file ssl-cert</code> objects in this config. A UCS backup or a full config save (<code>tmsh save sys config</code>) includes them; a partial <code>bigip.conf</code> that only defines LTM objects may not.</p>
    {% endif %}
  </div>

  {#: ---------------- Secrets ---------------- :#}
  {% if d.counts.secrets %}
  <div class="panel" data-panel="secrets">
    <p class="lm-field-note">Every credential-bearing field in the config — SSL private-key passphrases, monitor / RADIUS / SNMP / iApp secrets. BIG-IP stores these encrypted under the unit master key (<code>f5mku -K</code>). Values are <b>masked</b>: when the report was generated <em>with</em> the master key you can reveal the decrypted secret; otherwise it stays encrypted and cannot be shown. Nothing here was uploaded, and printing only shows secrets you have revealed.</p>
    <div class="secrets-summary"></div>
    <div class="tablewrap">
    <table class="grid secret-grid">
      <thead><tr><th>Object</th><th>Field</th><th>Secret</th></tr></thead>
      <tbody>
      {% for s in d.secrets %}
      <tr class="searchable secret-row" data-search="{{ s.object }} {{ s.field }}">
        <td class="mono small">{{ s.object }}</td>
        <td class="mono"><span class="tag">{{ s.field }}</span></td>
        <td class="mono small secret-cell">
          <span class="secret-mask">••••••••••••</span>{% if s.encrypted %} <span class="tag amber" title="Regenerate the report with the f5mku master key to reveal">encrypted</span>{% else %}<code class="secret-val" hidden>{{ s.value }}</code> <button type="button" class="secret-reveal">Reveal</button>{% endif %}
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>
  {% endif %}

  {#: ---------------- APM access-profile walk ---------------- :#}
  {% if d.counts.apmProfiles %}
  <div class="panel" data-panel="apm">
    <p class="lm-field-note">Every <code>apm profile access</code> walked out to everything it depends on — the virtual servers that attach it, its connectivity profile, the access policy and its items (with the <code>next-item</code> flow between them), the agents on each item, the AAA servers they authenticate against, and the resources a resource-assign agent hands out (network access → lease pool / client DNS, webtops, remote-desktop resources). Laid out left-to-right like the Visual Policy Editor: <b>green</b> start / allow, <b>red</b> deny, orthogonal connectors labelled with each branch.</p>
    {% for p in d.apmProfiles %}
    <div class="apm-profile searchable" data-search="{{ p.name }} {{ p.fullPath }} {{ p.policy }} {% for o in p.objects %}{{ o.name }} {% endfor %}">
      <div class="apm-head">
        <span class="apm-title">{{ p.name }}</span>
        <span class="apm-path mono">{{ p.fullPath }}</span>
        <span class="apm-meta">
          {% if p.policy %}<span class="tag">policy: {{ p.policy }}</span>{% endif %}
          {% for v in p.virtuals %}<span class="tag blue">{{ v }}</span>{% else %}<span class="tag amber">no virtual attaches this profile</span>{% endfor %}
          <span class="tag" title="Objects linked from this profile">{{ p.objectCount }} linked</span>
        </span>
      </div>
      <div class="apm-graph">
        <script type="application/json" class="apm-graph-data">{{ p.graph | tojson }}</script>
        <div class="apm-diagram"></div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {#: ---------------- GTM / DNS ---------------- :#}
  {% if d.counts.gtm %}
  <div class="panel" data-panel="gtm">
    <p class="lm-field-note">The GTM (BIG-IP DNS) global load-balancing tier: wide-IPs resolve a name to a pool, whose members select a <code>server</code>'s virtual server. A server's virtual-server destinations are the downstream LTM virtual addresses — the link the <a href="#architecture">Architecture</a> view uses to place this GTM in front of its LTM tiers.</p>

    {% if d.gtmWideips %}
    <h3 class="subhead">Wide-IPs <span class="n">{{ d.gtmWideips | length }}</span></h3>
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Wide-IP</th><th>Type</th><th>Pools</th><th>Aliases</th><th>LB mode</th></tr></thead>
      <tbody>
      {% for w in d.gtmWideips %}
      <tr class="searchable" data-search="{{ w.name }} {{ w.fullPath }}">
        <td class="mono strong">{{ w.name }}</td>
        <td>{% if w.recordType %}<span class="tag">{{ w.recordType | upper }}</span>{% endif %}</td>
        <td class="mono">{% for p in w.pools %}<span class="tag blue">{{ p | leaf }}</span>{% endfor %}</td>
        <td class="mono small">{% for a in w.aliases %}{{ a }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
        <td>{{ w.poolLbMode or '—' }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}

    {% if d.gtmPools %}
    <h3 class="subhead">Pools <span class="n">{{ d.gtmPools | length }}</span></h3>
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Pool</th><th>Type</th><th>LB mode</th><th>Members</th></tr></thead>
      <tbody>
      {% for p in d.gtmPools %}
      <tr class="searchable" data-search="{{ p.name }} {{ p.fullPath }}">
        <td class="mono strong">{{ p.name }}</td>
        <td>{% if p.recordType %}<span class="tag">{{ p.recordType | upper }}</span>{% endif %}</td>
        <td>{{ p.lbMode or '—' }}</td>
        <td class="mono small">{% for m in p.members %}<span class="tag" title="{{ m.state }}">{{ m.name }}{% if m.staticTarget %} → {{ m.staticTarget }}{% endif %}</span>{% else %}<span class="muted">—</span>{% endfor %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}

    {% if d.gtmServers %}
    <h3 class="subhead">Servers <span class="n">{{ d.gtmServers | length }}</span></h3>
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Server</th><th>Datacenter</th><th>Product</th><th>Addresses</th><th>Virtual-server targets</th></tr></thead>
      <tbody>
      {% for s in d.gtmServers %}
      <tr class="searchable" data-search="{{ s.name }} {{ s.fullPath }}">
        <td class="mono strong">{{ s.name }}</td>
        <td class="mono">{{ s.datacenter | leaf or '—' }}</td>
        <td>{{ s.product or '—' }}</td>
        <td class="mono small">{% for a in s.addresses %}{{ a }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
        <td class="mono small">{% for v in s.virtualServers %}<span class="tag green">{{ v }}</span>{% else %}<span class="muted">—</span>{% endfor %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}

    {% if d.gtmDatacenters %}
    <h3 class="subhead">Datacenters <span class="n">{{ d.gtmDatacenters | length }}</span></h3>
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Datacenter</th><th>Location</th><th>Contact</th></tr></thead>
      <tbody>
      {% for c in d.gtmDatacenters %}
      <tr class="searchable" data-search="{{ c.name }} {{ c.fullPath }}">
        <td class="mono strong">{{ c.name }}</td>
        <td>{{ c.location or '—' }}</td>
        <td>{{ c.contact or '—' }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {#: ---------------- Firewall / NAT ---------------- :#}
  {% if d.counts.firewall %}
  <div class="panel" data-panel="firewall">
    <p class="lm-field-note">The AFM firewall and NAT posture: policies and the rule-lists they enforce, the address-/port-lists rules match on, and the NAT policies and source/destination translations.</p>

    {% if d.firewallPolicies %}
    <h3 class="subhead">Firewall policies <span class="n">{{ d.firewallPolicies | length }}</span></h3>
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Policy</th><th>Rule-lists</th><th>Inline rules</th></tr></thead>
      <tbody>
      {% for p in d.firewallPolicies %}
      <tr class="searchable" data-search="{{ p.name }} {{ p.fullPath }}">
        <td class="mono strong">{{ p.name }}</td>
        <td class="mono">{% for rl in p.ruleLists %}<span class="tag blue">{{ rl | leaf }}</span>{% else %}<span class="muted">—</span>{% endfor %}</td>
        <td class="mono small">{% for r in p.rules %}<span class="tag">{{ r }}</span>{% else %}<span class="muted">—</span>{% endfor %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}

    {% if d.firewallRuleLists %}
    <h3 class="subhead">Rule-lists <span class="n">{{ d.firewallRuleLists | length }}</span></h3>
    {% for rl in d.firewallRuleLists %}
    <div class="rule-list-block">
      <div class="rule-list-name mono strong">{{ rl.name }} <span class="muted">({{ rl.ruleCount }} rule{{ '' if rl.ruleCount == 1 else 's' }})</span></div>
      <div class="tablewrap">
      <table class="grid fw-rules">
        <thead><tr><th>Rule</th><th>Action</th><th>Proto</th><th>Source</th><th>Destination</th><th>Log</th></tr></thead>
        <tbody>
        {% for r in rl.rules %}
        <tr class="searchable" data-search="{{ r.name }} {{ rl.name }}">
          <td class="mono strong">{{ r.name }}</td>
          <td><span class="tag {{ 'green' if r.action == 'accept' else 'red' if r.action in ['drop','reject'] else '' }}">{{ r.action or '—' }}</span></td>
          <td class="mono">{{ r.ipProtocol or 'any' }}</td>
          <td class="mono small">{{ fw_endpoint(r.source) }}</td>
          <td class="mono small">{{ fw_endpoint(r.destination) }}{% if r.ruleList %} <span class="tag blue">list {{ r.ruleList | leaf }}</span>{% endif %}</td>
          <td>{% if r.log %}<span class="tag amber">log</span>{% endif %}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      </div>
    </div>
    {% endfor %}
    {% endif %}

    {% if d.firewallAddressLists %}
    <h3 class="subhead">Address-lists <span class="n">{{ d.firewallAddressLists | length }}</span></h3>
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Address-list</th><th>Addresses</th><th>Nested lists</th><th>FQDNs</th></tr></thead>
      <tbody>
      {% for a in d.firewallAddressLists %}
      <tr class="searchable" data-search="{{ a.name }} {{ a.fullPath }}">
        <td class="mono strong">{{ a.name }}</td>
        <td class="mono small">{% for x in a.addresses %}<span class="tag">{{ x }}</span>{% else %}<span class="muted">—</span>{% endfor %}</td>
        <td class="mono small">{% for x in a.addressLists %}<span class="tag blue">{{ x | leaf }}</span>{% endfor %}</td>
        <td class="mono small">{% for x in a.fqdns %}{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}

    {% if d.firewallPortLists %}
    <h3 class="subhead">Port-lists <span class="n">{{ d.firewallPortLists | length }}</span></h3>
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Port-list</th><th>Ports</th></tr></thead>
      <tbody>
      {% for p in d.firewallPortLists %}
      <tr class="searchable" data-search="{{ p.name }} {{ p.fullPath }}">
        <td class="mono strong">{{ p.name }}</td>
        <td class="mono small">{% for x in p.ports %}<span class="tag">{{ x }}</span>{% else %}<span class="muted">—</span>{% endfor %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}

    {% if d.natPolicies or d.natSourceTranslations or d.natDestinationTranslations %}
    <h3 class="subhead">NAT</h3>
    {% if d.natPolicies %}
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>NAT policy</th><th>Rule-lists</th><th>Rules</th></tr></thead>
      <tbody>
      {% for p in d.natPolicies %}
      <tr class="searchable" data-search="{{ p.name }} {{ p.fullPath }}">
        <td class="mono strong">{{ p.name }}</td>
        <td class="mono">{% for rl in p.ruleLists %}<span class="tag blue">{{ rl | leaf }}</span>{% else %}<span class="muted">—</span>{% endfor %}</td>
        <td class="mono small">{% for r in p.rules %}<span class="tag">{{ r }}</span>{% else %}<span class="muted">—</span>{% endfor %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
    {% if d.natSourceTranslations or d.natDestinationTranslations %}
    <div class="tablewrap">
    <table class="grid">
      <thead><tr><th>Translation</th><th>Direction</th><th>Type</th><th>Addresses</th><th>Ports</th></tr></thead>
      <tbody>
      {% for t in d.natSourceTranslations %}
      <tr class="searchable" data-search="{{ t.name }} {{ t.fullPath }}">
        <td class="mono strong">{{ t.name }}</td>
        <td><span class="tag">source</span></td>
        <td class="mono">{{ t.type or '—' }}</td>
        <td class="mono small">{% for x in t.addresses %}{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
        <td class="mono small">{% for x in t.ports %}{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
      </tr>
      {% endfor %}
      {% for t in d.natDestinationTranslations %}
      <tr class="searchable" data-search="{{ t.name }} {{ t.fullPath }}">
        <td class="mono strong">{{ t.name }}</td>
        <td><span class="tag">destination</span></td>
        <td class="mono">{{ t.type or '—' }}</td>
        <td class="mono small">{% for x in t.addresses %}{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
        <td class="mono small">{% for x in t.ports %}{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
    {% endif %}
  </div>
  {% endif %}

  {#: ---------------- Forensics (UCS file inventory + hunting checklist) ---------------- :#}
  {% if d.counts.files or d.forensics.flagged %}
  <div class="panel" data-panel="forensics">
    <p class="lm-field-note">Forensic inventory of the OS files inside this device's <code>.ucs</code> — the paths an attacker tampers with on a compromised BIG-IP, each with its size and <b>SHA-256</b> (diff it against a known-good host). The checklist runs the <b>UCS forensic checks</b> (see the <b>F5 Sites</b> tab) live against the archive and flags what it finds. File contents are shown only for small non-sensitive text files, behind a per-file reveal; <code>shadow</code> and private keys are <b>never embedded</b> — nothing here left your browser.</p>
    <div class="forensics-view"></div>
  </div>
  {% endif %}

  {#: ---------------- Object Index ---------------- :#}
  {#: A flat, filterable index of every object in this device, grouped by type;
      each row deep-links to the object's expanded row on its own tab. Built
      client-side by topology.ts from the embedded model (shared by both
      backends). :#}
  <div class="panel" data-panel="objectIndex">
    <div class="objindex-bar">
      <input type="search" class="objindex-filter" placeholder="Filter objects by name or path…" aria-label="Filter object index">
    </div>
    <div class="objindex-view"></div>
  </div>

  {#: ---------------- Topology ---------------- :#}
  <div class="panel" data-panel="topology">
    <div class="topo-controls">
      <label>Focus
        <select class="topo-focus"></select>
      </label>
      <label>Depth
        <select class="topo-depth">
          <option value="1">1 hop</option>
          <option value="2" selected>2 hops</option>
          <option value="3">3 hops</option>
          <option value="99">all connected</option>
        </select>
      </label>
      <span class="topo-types">
        {% for tt in topo_types %}
        <label><input type="checkbox" class="topo-type" value="{{ tt.t }}"{{ ' checked' if tt.t in ['vs','pool','node','rule'] }}> {{ tt.lbl }}</label>
        {% endfor %}
      </span>
    </div>
    <div class="legend">
      <span><i style="background:#dbeafe;border-color:#2563eb"></i>Virtual</span>
      <span><i style="background:#dcfce7;border-color:#16a34a"></i>Pool</span>
      <span><i style="background:#f1f5f9;border-color:#64748b"></i>Node</span>
      <span><i style="background:#fef9c3;border-color:#ca8a04"></i>Monitor</span>
      <span><i style="background:#ede9fe;border-color:#7c3aed"></i>iRule</span>
      <span><i style="background:#e0f2fe;border-color:#0284c7"></i>Profile</span>
    </div>
    <p class="hint">Click a node to open its detail drawer. Click a <b>connector line</b> to light up everything connected to it (e.g. an iRule→pool link highlights every virtual using that iRule, and the pool's nodes). Dashed edges are pool references found <em>inside</em> an iRule.</p>
    <div class="diag-host"></div>
  </div>

  {#: ---------------- Listener Matcher ---------------- :#}
  <div class="panel" data-panel="listener">
    <p class="lm-field-note">Enter a client flow — which virtual server picks it up? Results are ranked most-specific first (the matched listener is highlighted at the top); virtuals at the same specificity are shown side by side. Click any listener to load the exact flow that reaches it and simulate its processing. Supports IPv4 and IPv6, VLANs and route domains. Source defaults to <code>0.0.0.0/0</code>.</p>
    <div class="lm-form">
      <div class="fld"><label>Source</label><input class="lm-src lm-field" placeholder="0.0.0.0/0"></div>
      <div class="fld"><label>Destination</label><input class="lm-dst lm-field" placeholder="e.g. 192.168.1.21"></div>
      <div class="fld"><label>Port</label><input class="lm-port lm-field" placeholder="443"></div>
      <div class="fld"><label>Protocol</label>
        <select class="lm-proto"><option value="any">any</option><option>tcp</option><option>udp</option><option>sctp</option></select>
      </div>
      <div class="fld"><label>VLAN</label><select class="lm-vlan"></select></div>
      <div class="fld"><label>Route domain</label><input class="lm-rd lm-field" placeholder="0"></div>
      <button class="lm-run">Match ▸</button>
    </div>
    <div class="lm-results"></div>
    <div class="lm-sim"></div>
  </div>

  {#: ---------------- Apps (user-bundled virtual servers) ---------------- :#}
  <div class="panel" data-panel="apps">
    <div class="apps-view"></div>
  </div>

  {#: ---------------- F5 Sites — community / support / security-IR resources ---------------- :#}
  <div class="panel" data-panel="f5sites">
    <p class="lm-field-note">Curated F5 community, support and <b>security-incident-response</b> resources. Because this report is often generated from a <code>.ucs</code> archive of a device under investigation, the <b>UCS forensic checklist</b> below ties each archive path to the attacker behaviour to look for and its <a href="https://attack.mitre.org/" target="_blank" rel="noopener noreferrer">MITRE ATT&amp;CK</a> technique. Every link opens on F5 DevCentral, my.F5 or CISA — nothing here is loaded to render the page or phones home.</p>

    <div class="f5sites-groups">
      <section class="f5sites-group">
        <h3>DevCentral &amp; community</h3>
        <ul class="f5sites-links">
