{
  "name": "@bigip-report-gen/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript front-end for the BIG-IP report generators (Python f5report + Rust tcl-bigip-report).",
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@12.2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "prettier --check \"src/search/**/*.ts\"",
    "format": "prettier --write \"src/search/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2"
  }
}
