{
  "name": "@bigip-report-gen/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript front-end for the BIG-IP report generators (Python f5report + Rust tcl-bigip-report).",
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@12.0.2",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/search --ext .ts && prettier --check \"src/search/**/*.ts\"",
    "format": "prettier --write \"src/search/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
