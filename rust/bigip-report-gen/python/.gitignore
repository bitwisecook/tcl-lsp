# This crate is built by maturin outside the Cargo workspace, so the root
# `/target/` ignore (anchored to the repo root) does not cover it.
/target/

# The compiled PyO3 extension maturin drops into the editable package tree.
python/f5report/*.so

# Local dev report output.
*.html

# Front-end assets synced from ../shared by `npm run build` — build outputs, not
# checked in; every wheel/dev build regenerates them. __init__.py stays tracked.
python/f5report/templates/*.js
python/f5report/templates/*.css
python/f5report/templates/*.j2
python/f5report/vendor/*.js
python/f5report/vendor/*.wasm
python/f5report/vendor/*.svg
