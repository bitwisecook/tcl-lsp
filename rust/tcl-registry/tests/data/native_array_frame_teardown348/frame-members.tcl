set log {}; proc fresh args {lappend ::log NEW}; proc old args {lappend ::log OLD; trace add variable ::xx unset fresh; trace add variable ::yy unset fresh}; proc owner {} {set a(x) X; set a(y) Y; set before [namespace eval :: {upvar 1 a(x) xx; upvar 1 a(y) yy; list $xx $yy}]; trace add variable a(x) unset old; trace add variable a(y) unset old; set before}; set before [owner]; list $before $log
