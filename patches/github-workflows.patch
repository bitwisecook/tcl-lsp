+name: rust-lsp-e2e
+
+# Native-server lsp_e2e gate for the `rust` branch.
+#
+# Split out from `rust-gate.yml` (the cargo workspace checks) deliberately: this
+# surface builds the `tcl-lsp-server` binary and drives the end-to-end LSP suite
+# (rust/tcl-lsp-server/tests/*_e2e.rs) against it over stdio JSON-RPC — a slower,
+# heavier surface than the unit tests, so it reports as its own independent
+# check rather than being coupled to the cargo workspace checks.
+#
+# The suite is a fully native Rust port of the former Python `tests/lsp_e2e/`
+# pytest suite: no Python, no uv. `make test-rust` runs both surfaces locally.
+#
+# This is a BLOCKING gate: the `lsp-e2e` job is wired as a REQUIRED status check
+# (branch protection on `rust`). `main`'s pipeline is ci.yml; this lives on
+# `rust` only.
+
+on:
+  pull_request:
+    branches: [rust]
+  push:
+    branches: [rust]
+
+concurrency:
+  group: rust-lsp-e2e-${{ github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  lsp-e2e:
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
+        with:
+          fetch-depth: 1
+
+      - name: Cache cargo registry + target
+        uses: Swatinem/rust-cache@c19371144df3bb44fab255c43d04cbc2ab54d1c4 # v2.9.1
+
+      - name: Install cargo-nextest
+        uses: taiki-e/install-action@16b05812d776ae1dfaabc8277e421fb6d2506419 # v2.82.7
+        with:
+          tool: nextest
+
+      # The integration tests spawn the real `tcl-lsp-server` binary via
+      # `CARGO_BIN_EXE_tcl-lsp-server` (cargo builds it as a test dependency) and
+      # talk LSP JSON-RPC to it over stdio — the native replacement for the old
+      # `uv run pytest tests/lsp_e2e/`. This also runs the crate's `*_smoke.rs`
+      # integration tests. nextest runs them in one parallel pool (no
+      # serial-per-binary penalty); it does not run doctests, which the
+      # rust-gate `--doc` step covers workspace-wide.
+      - name: lsp_e2e against the native Rust server
+        run: cargo nextest run -p tcl-lsp-server --no-fail-fast
