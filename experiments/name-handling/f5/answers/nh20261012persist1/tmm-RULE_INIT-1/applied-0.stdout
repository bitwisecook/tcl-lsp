ltm rule __tcl_lsp_probe_nh20261012persist1_provider {
proc __nh_nh20261012persist1_target {value} {list NATIVE $value}
proc record {nh_context nh_case nh_stage nh_code nh_value nh_invocation} {
set nh_options_available unavailable
set nh_return_options {}
set nh_unit [TMM::cmp_group]:[TMM::cmp_unit]

set nh_ec {}
set nh_ei {}
set nh_ec_present 0
set nh_ei_present 0
if {$nh_code == 1} {
    if {[info exists ::errorCode]} {set nh_ec $::errorCode; set nh_ec_present 1}
    if {[info exists ::errorInfo]} {set nh_ei $::errorInfo; set nh_ei_present 1}
}
foreach {nh_field nh_value} [list result $nh_value metadata [list errorcode-present $nh_ec_present errorinfo-present $nh_ei_present return-options $nh_options_available] returnoptions $nh_return_options errorcode $nh_ec errorinfo $nh_ei] {
    if {$nh_field == "returnoptions" && $nh_options_available == "unavailable"} {continue}
    if {$nh_field != "result" && $nh_field != "returnoptions" && $nh_code != 1} {continue}
    set nh_encoding utf-8
    set nh_encoder encoding
    if {[catch {$nh_encoder convertto utf-8 $nh_value} nh_encoded]} {
        set nh_encoded $nh_value
        set nh_encoding binary-scan-tcl-value
    }
    binary scan $nh_encoded H* nh_hex
    set nh_chunks [expr {([string length $nh_hex] + 399) / 400}]
    if {$nh_chunks == 0} {set nh_chunks 1}
    for {set nh_i 0} {$nh_i < $nh_chunks} {incr nh_i} {
        set nh_part [string range $nh_hex [expr {$nh_i * 400}] [expr {$nh_i * 400 + 399}]]
        log local0. "NHO|nh20261012persist1|$nh_case|$nh_context|$nh_stage|$nh_code|$nh_unit|$nh_invocation|$nh_field|$nh_encoding|$nh_i|$nh_chunks|$nh_part"
    }
}

}
proc measure {invocation} {
set nh_invocation $invocation
# NHO|nh20261012persist1|native-computed-ordinary-head|tmm-procedure|
set nh_setup {}
set nh_operation [binary format H* 7365742068656164205f5f6e685f6e68323032363130313270657273697374315f7461726765743b202468656164204f5244494e415259]
set nh_setup_code [catch {eval $nh_setup} nh_setup_result]
call /Common/__tcl_lsp_probe_nh20261012persist1_provider::record tmm-procedure native-computed-ordinary-head setup $nh_setup_code $nh_setup_result $nh_invocation
if {$nh_setup_code == 0} {set nh_code [catch {eval $nh_operation} nh_value]
call /Common/__tcl_lsp_probe_nh20261012persist1_provider::record tmm-procedure native-computed-ordinary-head lookup $nh_code $nh_value $nh_invocation
}
# NHO|nh20261012persist1|native-catalogue-versus-call|tmm-procedure|
set nh_setup {}
set nh_operation [binary format H* ]
set nh_setup_code [catch {eval $nh_setup} nh_setup_result]
call /Common/__tcl_lsp_probe_nh20261012persist1_provider::record tmm-procedure native-catalogue-versus-call setup $nh_setup_code $nh_setup_result $nh_invocation
if {$nh_setup_code == 0} {set nh_code [catch {eval $nh_operation} nh_value]
call /Common/__tcl_lsp_probe_nh20261012persist1_provider::record tmm-procedure native-catalogue-versus-call lookup $nh_code $nh_value $nh_invocation
}
# NHO|nh20261012persist1|native-computed-rename|tmm-procedure|
set nh_setup {}
set nh_operation [binary format H* ]
set nh_setup_code [catch {eval $nh_setup} nh_setup_result]
call /Common/__tcl_lsp_probe_nh20261012persist1_provider::record tmm-procedure native-computed-rename setup $nh_setup_code $nh_setup_result $nh_invocation
if {$nh_setup_code == 0} {set nh_code [catch {eval $nh_operation} nh_value]
call /Common/__tcl_lsp_probe_nh20261012persist1_provider::record tmm-procedure native-computed-rename lookup $nh_code $nh_value $nh_invocation
}
# NHO|nh20261012persist1|worker-cells-read|tmm-procedure|
set nh_setup {}
set nh_operation [binary format H* ]
set nh_setup_code [catch {eval $nh_setup} nh_setup_result]
call /Common/__tcl_lsp_probe_nh20261012persist1_provider::record tmm-procedure worker-cells-read setup $nh_setup_code $nh_setup_result $nh_invocation
if {$nh_setup_code == 0} {set nh_code [catch {eval $nh_operation} nh_value]
call /Common/__tcl_lsp_probe_nh20261012persist1_provider::record tmm-procedure worker-cells-read lookup $nh_code $nh_value $nh_invocation
}
}
}
