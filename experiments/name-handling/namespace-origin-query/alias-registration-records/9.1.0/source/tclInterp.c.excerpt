2125: /*
2126:  *----------------------------------------------------------------------
2127:  *
2128:  * AliasList --
2129:  *
2130:  *	Computes a list of aliases defined in a child interpreter.
2131:  *
2132:  * Results:
2133:  *	A standard Tcl result.
2134:  *
2135:  * Side effects:
2136:  *	None.
2137:  *
2138:  *----------------------------------------------------------------------
2139:  */
2140: 
2141: static int
2142: AliasList(
2143:     Tcl_Interp *interp,		/* Interp for data return. */
2144:     Tcl_Interp *childInterp)	/* Interp whose aliases to compute. */
2145: {
2146:     Tcl_HashEntry *entryPtr;
2147:     Tcl_HashSearch hashSearch;
2148:     Tcl_Obj *resultPtr;
2149:     Alias *aliasPtr;
2150:     Child *childPtr;
2151: 
2134:  *
2135:  * Side effects:
2136:  *	None.
2137:  *
2138:  *----------------------------------------------------------------------
2139:  */
2140: 
2141: static int
2142: AliasList(
2143:     Tcl_Interp *interp,		/* Interp for data return. */
2144:     Tcl_Interp *childInterp)	/* Interp whose aliases to compute. */
2145: {
2146:     Tcl_HashEntry *entryPtr;
2147:     Tcl_HashSearch hashSearch;
2148:     Tcl_Obj *resultPtr;
2149:     Alias *aliasPtr;
2150:     Child *childPtr;
2151: 
2152:     TclNewObj(resultPtr);
2153:     childPtr = &INTERP_INFO(childInterp)->child;
2154: 
2155:     entryPtr = Tcl_FirstHashEntry(&childPtr->aliasTable, &hashSearch);
2156:     for ( ; entryPtr != NULL; entryPtr = Tcl_NextHashEntry(&hashSearch)) {
2157: 	aliasPtr = (Alias *) Tcl_GetHashValue(entryPtr);
2158: 	Tcl_ListObjAppendElement(NULL, resultPtr, aliasPtr->token);
2159:     }
2160:     Tcl_SetObjResult(interp, resultPtr);
2161:     return TCL_OK;
2162: }
