900:     childPtr = &interpInfoPtr->child;
901:     childPtr->parentInterp	= NULL;
902:     childPtr->childEntryPtr	= NULL;
903:     childPtr->childInterp	= interp;
904:     childPtr->interpCmd		= NULL;
905:     Tcl_InitHashTable(&childPtr->aliasTable, TCL_STRING_KEYS);
906: 
907:     Tcl_NRCreateCommand2(interp, "interp", Tcl_InterpObjCmd, NRInterpCmd,
908: 	    NULL, NULL);
909:     Tcl_CreateObjCommand2(interp, INIT_AUTO_PATH_CMD, InitAutoPathObjCmd,
2089:  *
2090:  * Side effects:
2091:  *	None.
2092:  *
2093:  *----------------------------------------------------------------------
2094:  */
2095: 
2096: static int
2097: AliasDescribe(
2098:     Tcl_Interp *interp,		/* Interpreter for result & errors. */
2099:     Tcl_Interp *childInterp,	/* Interpreter containing alias. */
2100:     Tcl_Obj *namePtr)		/* Name of alias to describe. */
2101: {
2102:     Child *childPtr;
2103:     Tcl_HashEntry *hPtr;
2104:     Alias *aliasPtr;
2105:     Tcl_Obj *prefixPtr;
2106: 
2107:     /*
2108:      * If the alias has been renamed in the child, the parent can still use
2109:      * the original name (with which it was created) to find the alias to
2110:      * describe it.
2111:      */
2112: 
2113:     childPtr = &INTERP_INFO(childInterp)->child;
2114:     hPtr = Tcl_FindHashEntry(&childPtr->aliasTable, TclGetString(namePtr));
2115:     if (hPtr == NULL) {
2116: 	return TCL_OK;
2117:     }
2118:     aliasPtr = (Alias *) Tcl_GetHashValue(hPtr);
2119:     prefixPtr = Tcl_NewListObj(aliasPtr->objc, &aliasPtr->objPtr);
2120:     Tcl_SetObjResult(interp, prefixPtr);
2121:     return TCL_OK;
2122: }
2123: 
