920:  *
921:  * Side effects:
922:  *	None.
923:  *
924:  *----------------------------------------------------------------------
925:  */
926: 
927: static unsigned
928: HashStringKey(
929:     Tcl_HashTable *tablePtr,	/* Hash table. */
930:     void *keyPtr)		/* Key from which to compute hash value. */
931: {
932:     const char *string = keyPtr;
933:     unsigned int result;
934:     char c;
935: 
936:     /*
937:      * I tried a zillion different hash functions and asked many other people
938:      * for advice. Many people had their own favorite functions, all
939:      * different, but no-one had much idea why they were good ones. I chose
940:      * the one below (multiply by 9 and add new character) because of the
941:      * following reasons:
942:      *
943:      * 1. Multiplying by 10 is perfect for keys that are decimal strings, and
944:      *    multiplying by 9 is just about as good.
945:      * 2. Times-9 is (shift-left-3) plus (old). This means that each
946:      *    character's bits hang around in the low-order bits of the hash value
947:      *    for ever, plus they spread fairly rapidly up to the high-order bits
948:      *    to fill out the hash value. This seems works well both for decimal
949:      *    and non-decimal strings, but isn't strong against maliciously-chosen
950:      *    keys.
951:      *
952:      * Note that this function is very weak against malicious strings; it's
953:      * very easy to generate multiple keys that have the same hashcode. On the
954:      * other hand, that hardly ever actually occurs and this function *is*
955:      * very cheap, even by comparison with industry-standard hashes like FNV.
956:      * If real strength of hash is required though, use a custom hash based on
957:      * Bob Jenkins's lookup3(), but be aware that it's significantly slower.
958:      * Since Tcl command and namespace names are usually reasonably-named (the
959:      * main use for string hashes in modern Tcl) speed is far more important
960:      * than strength.
961:      *
962:      * See also HashString in tclLiteral.c.
963:      * See also TclObjHashKey in tclObj.c.
964:      *
965:      * See [tcl-Feature Request #2958832]
966:      */
967: 
968:     if ((result = UCHAR(*string)) != 0) {
969: 	while ((c = *++string) != 0) {
970: 	    result += (result << 3) + UCHAR(c);
971: 	}
972:     }
973:     return result;
974: }
975: 
976: 
977: /*
978:  *----------------------------------------------------------------------
979:  *
980:  * BogusFind --
981:  *
982:  *	This function is invoked when an Tcl_FindHashEntry is called on a
