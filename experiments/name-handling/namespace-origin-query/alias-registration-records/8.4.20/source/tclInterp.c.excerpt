236:     slavePtr = &interpInfoPtr->slave;
237:     slavePtr->masterInterp	= NULL;
238:     slavePtr->slaveEntryPtr	= NULL;
239:     slavePtr->slaveInterp	= interp;
240:     slavePtr->interpCmd		= NULL;
241:     Tcl_InitHashTable(&slavePtr->aliasTable, TCL_STRING_KEYS);
242: 
243:     Tcl_CreateObjCommand(interp, "interp", Tcl_InterpObjCmd, NULL, NULL);
244: 
245:     Tcl_CallWhenDeleted(interp, InterpInfoDeleteProc, NULL);
1157:  * Side effects:
1158:  *	An alias command is created and entered into the alias table
1159:  *	for the slave interpreter.
1160:  *
1161:  *----------------------------------------------------------------------
1162:  */
1163: 
1164: static int
1165: AliasCreate(interp, slaveInterp, masterInterp, namePtr, targetNamePtr,
1166: 	objc, objv)
1167:     Tcl_Interp *interp;		/* Interp for error reporting. */
1168:     Tcl_Interp *slaveInterp;	/* Interp where alias cmd will live or from
1169: 				 * which alias will be deleted. */
1170:     Tcl_Interp *masterInterp;	/* Interp in which target command will be
1171: 				 * invoked. */
1172:     Tcl_Obj *namePtr;		/* Name of alias cmd. */
1173:     Tcl_Obj *targetNamePtr;	/* Name of target cmd. */
1174:     int objc;			/* Additional arguments to store */
1175:     Tcl_Obj *CONST objv[];	/* with alias. */
1176: {
1177:     Alias *aliasPtr;
1178:     Tcl_HashEntry *hPtr;
1179:     Target *targetPtr;
1180:     Slave *slavePtr;
1181:     Master *masterPtr;
1182:     Tcl_Obj **prefv;
1183:     int new, i;
1184: 
1185:     aliasPtr = (Alias *) ckalloc((unsigned) (sizeof(Alias) 
1186:             + objc * sizeof(Tcl_Obj *)));
1187:     aliasPtr->namePtr		= namePtr;
1188:     Tcl_IncrRefCount(aliasPtr->namePtr);
1189:     aliasPtr->targetInterp	= masterInterp;
1190: 
1191:     aliasPtr->objc = objc + 1;
1192:     prefv = &aliasPtr->objPtr;
1193: 
1194:     *prefv = targetNamePtr;
1195:     Tcl_IncrRefCount(targetNamePtr);
1196:     for (i = 0; i < objc; i++) {
1197: 	*(++prefv) = objv[i];
1198: 	Tcl_IncrRefCount(objv[i]);
1199:     }
1200: 
1201:     Tcl_Preserve(slaveInterp);
1202:     Tcl_Preserve(masterInterp);
1203: 
1204:     aliasPtr->slaveCmd = Tcl_CreateObjCommand(slaveInterp,
1205: 	    Tcl_GetString(namePtr), AliasObjCmd, (ClientData) aliasPtr,
1206: 	    AliasObjCmdDeleteProc);
1207: 
1208:     if (TclPreventAliasLoop(interp, slaveInterp,
1209: 	    aliasPtr->slaveCmd) != TCL_OK) {
1210: 	/*
1211: 	 * Found an alias loop!	 The last call to Tcl_CreateObjCommand made
1212: 	 * the alias point to itself.  Delete the command and its alias
1213: 	 * record.  Be careful to wipe out its client data first, so the
1214: 	 * command doesn't try to delete itself.
1215: 	 */
1216: 
1217: 	Command *cmdPtr;
1218: 	
1219: 	Tcl_DecrRefCount(aliasPtr->namePtr);
1220: 	Tcl_DecrRefCount(targetNamePtr);
1221: 	for (i = 0; i < objc; i++) {
1222: 	    Tcl_DecrRefCount(objv[i]);
1223: 	}
1224: 	
1225: 	cmdPtr = (Command *) aliasPtr->slaveCmd;
1226: 	cmdPtr->clientData = NULL;
1227: 	cmdPtr->deleteProc = NULL;
1228: 	cmdPtr->deleteData = NULL;
1229: 	Tcl_DeleteCommandFromToken(slaveInterp, aliasPtr->slaveCmd);
1230: 
1231: 	ckfree((char *) aliasPtr);
1232: 
1233: 	/*
1234: 	 * The result was already set by TclPreventAliasLoop.
1235: 	 */
1236: 
1237: 	Tcl_Release(slaveInterp);
1238: 	Tcl_Release(masterInterp);
1239: 	return TCL_ERROR;
1240:     }
1241: 
1242:     /*
1243:      * Make an entry in the alias table. If it already exists delete
1244:      * the alias command. Then retry.
1245:      */
1246: 
1247:     slavePtr = &((InterpInfo *) ((Interp *) slaveInterp)->interpInfo)->slave;
1248:     while (1) {
1249: 	Alias *oldAliasPtr;
1250: 	char *string;
1251: 	
1252: 	string = Tcl_GetString(namePtr);
1253: 	hPtr = Tcl_CreateHashEntry(&slavePtr->aliasTable, string, &new);
1254: 	if (new != 0) {
1255: 	    break;
1256: 	}
1257: 
1258: 	oldAliasPtr = (Alias *) Tcl_GetHashValue(hPtr);
1259: 	Tcl_DeleteCommandFromToken(slaveInterp, oldAliasPtr->slaveCmd);
1260:     }
1261: 
1262:     aliasPtr->aliasEntryPtr = hPtr;
1263:     Tcl_SetHashValue(hPtr, (ClientData) aliasPtr);
1264:     
1265:     /*
1266:      * Create the new command. We must do it after deleting any old command,
1267:      * because the alias may be pointing at a renamed alias, as in:
1268:      *
1269:      * interp alias {} foo {} bar		# Create an alias "foo"
1270:      * rename foo zop				# Now rename the alias
1271:      * interp alias {} foo {} zop		# Now recreate "foo"...
1272:      */
1273: 
1274:     targetPtr = (Target *) ckalloc((unsigned) sizeof(Target));
1275:     targetPtr->slaveCmd = aliasPtr->slaveCmd;
1276:     targetPtr->slaveInterp = slaveInterp;
1277: 
1278:     Tcl_MutexLock(&cntMutex);
1279:     masterPtr = &((InterpInfo *) ((Interp *) masterInterp)->interpInfo)->master;
1280:     do {
1281:         hPtr = Tcl_CreateHashEntry(&masterPtr->targetTable,
1282:                 (char *) aliasCounter, &new);
1283: 	aliasCounter++;
1284:     } while (new == 0);
1285:     Tcl_MutexUnlock(&cntMutex);
1286: 
1287:     Tcl_SetHashValue(hPtr, (ClientData) targetPtr);
1288:     aliasPtr->targetEntryPtr = hPtr;
1289: 
1290:     Tcl_SetObjResult(interp, namePtr);
1291: 
1292:     Tcl_Release(slaveInterp);
1293:     Tcl_Release(masterInterp);
1294:     return TCL_OK;
1295: }
1296: 
1297: 
1298: /*
1299:  *----------------------------------------------------------------------
1300:  *
1301:  * AliasDelete --
1302:  *
1303:  *	Deletes the given alias from the slave interpreter given.
1304:  *
1305:  * Results:
1306:  *	A standard Tcl result.
1307:  *
1308:  * Side effects:
1309:  *	Deletes the alias from the slave interpreter.
1310:  *
1311:  *----------------------------------------------------------------------
1312:  */
1313: 
1314: static int
1315: AliasDelete(interp, slaveInterp, namePtr)
1316:     Tcl_Interp *interp;		/* Interpreter for result & errors. */
1317:     Tcl_Interp *slaveInterp;	/* Interpreter containing alias. */
1318:     Tcl_Obj *namePtr;		/* Name of alias to delete. */
1319: {
1320:     Slave *slavePtr;
1321:     Alias *aliasPtr;
1322:     Tcl_HashEntry *hPtr;
1323: 
1324:     /*
1325:      * If the alias has been renamed in the slave, the master can still use
1326:      * the original name (with which it was created) to find the alias to
1327:      * delete it.
1328:      */
1329: 
1330:     slavePtr = &((InterpInfo *) ((Interp *) slaveInterp)->interpInfo)->slave;
1331:     hPtr = Tcl_FindHashEntry(&slavePtr->aliasTable, Tcl_GetString(namePtr));
1332:     if (hPtr == NULL) {
1333: 	Tcl_AppendStringsToObj(Tcl_GetObjResult(interp), "alias \"",
1334: 		Tcl_GetString(namePtr), "\" not found", NULL);
1335:         return TCL_ERROR;
1336:     }
1337:     aliasPtr = (Alias *) Tcl_GetHashValue(hPtr);
1338:     Tcl_DeleteCommandFromToken(slaveInterp, aliasPtr->slaveCmd);
1339:     return TCL_OK;
1340: }
1341: 
1342: 
1343: /*
1344:  *----------------------------------------------------------------------
1345:  *
1346:  * AliasDescribe --
1347:  *
1348:  *	Sets the interpreter's result object to a Tcl list describing
1349:  *	the given alias in the given interpreter: its target command
1350:  *	and the additional arguments to prepend to any invocation
1351:  *	of the alias.
1352:  *
1353:  * Results:
1354:  *	A standard Tcl result.
1355:  *
1356:  * Side effects:
1357:  *	None.
1358:  *
1359:  *----------------------------------------------------------------------
1355:  *
1356:  * Side effects:
1357:  *	None.
1358:  *
1359:  *----------------------------------------------------------------------
1360:  */
1361: 
1362: static int
1363: AliasDescribe(interp, slaveInterp, namePtr)
1364:     Tcl_Interp *interp;		/* Interpreter for result & errors. */
1365:     Tcl_Interp *slaveInterp;	/* Interpreter containing alias. */
1366:     Tcl_Obj *namePtr;		/* Name of alias to describe. */
1367: {
1368:     Slave *slavePtr;
1369:     Tcl_HashEntry *hPtr;
1370:     Alias *aliasPtr;	
1371:     Tcl_Obj *prefixPtr;
1372: 
1373:     /*
1374:      * If the alias has been renamed in the slave, the master can still use
1375:      * the original name (with which it was created) to find the alias to
1376:      * describe it.
1377:      */
1378: 
1379:     slavePtr = &((InterpInfo *) ((Interp *) slaveInterp)->interpInfo)->slave;
1380:     hPtr = Tcl_FindHashEntry(&slavePtr->aliasTable, Tcl_GetString(namePtr));
1381:     if (hPtr == NULL) {
1382:         return TCL_OK;
1383:     }
1384:     aliasPtr = (Alias *) Tcl_GetHashValue(hPtr);
1385:     prefixPtr = Tcl_NewListObj(aliasPtr->objc, &aliasPtr->objPtr);
1386:     Tcl_SetObjResult(interp, prefixPtr);
1387:     return TCL_OK;
1388: }
1389: 
1390: 
1391: /*
1392:  *----------------------------------------------------------------------
1393:  *
1394:  * AliasList --
1395:  *
1396:  *	Computes a list of aliases defined in a slave interpreter.
1397:  *
1398:  * Results:
1399:  *	A standard Tcl result.
1400:  *
1401:  * Side effects:
1402:  *	None.
1403:  *
1404:  *----------------------------------------------------------------------
1405:  */
1406: 
1407: static int
1408: AliasList(interp, slaveInterp)
1409:     Tcl_Interp *interp;		/* Interp for data return. */
1410:     Tcl_Interp *slaveInterp;	/* Interp whose aliases to compute. */
1411: {
1412:     Tcl_HashEntry *entryPtr;
1413:     Tcl_HashSearch hashSearch;
1414:     Tcl_Obj *resultPtr;	
1415:     Alias *aliasPtr;
1416:     Slave *slavePtr;
1417: 
1400:  *
1401:  * Side effects:
1402:  *	None.
1403:  *
1404:  *----------------------------------------------------------------------
1405:  */
1406: 
1407: static int
1408: AliasList(interp, slaveInterp)
1409:     Tcl_Interp *interp;		/* Interp for data return. */
1410:     Tcl_Interp *slaveInterp;	/* Interp whose aliases to compute. */
1411: {
1412:     Tcl_HashEntry *entryPtr;
1413:     Tcl_HashSearch hashSearch;
1414:     Tcl_Obj *resultPtr;	
1415:     Alias *aliasPtr;
1416:     Slave *slavePtr;
1417: 
1418:     slavePtr = &((InterpInfo *) ((Interp *) slaveInterp)->interpInfo)->slave;
1419:     resultPtr = Tcl_GetObjResult(interp);
1420: 
1421:     entryPtr = Tcl_FirstHashEntry(&slavePtr->aliasTable, &hashSearch);
1422:     for ( ; entryPtr != NULL; entryPtr = Tcl_NextHashEntry(&hashSearch)) {
1423:         aliasPtr = (Alias *) Tcl_GetHashValue(entryPtr);
1424:         Tcl_ListObjAppendElement(NULL, resultPtr, aliasPtr->namePtr);
1425:     }
1426:     return TCL_OK;
1427: }
