1754:     Tcl_Interp *childInterp)	/* Interp whose aliases to compute. */
1755: {
1756:     Tcl_HashEntry *entryPtr;
1757:     Tcl_HashSearch hashSearch;
1758:     Tcl_Obj *resultPtr;
1759:     Alias *aliasPtr;
1760:     Child *childPtr;
1761: 
1744:  *
