523:     childPtr = &interpInfoPtr->child;
524:     childPtr->parentInterp	= NULL;
525:     childPtr->childEntryPtr	= NULL;
526:     childPtr->childInterp	= interp;
527:     childPtr->interpCmd		= NULL;
528:     Tcl_InitHashTable(&childPtr->aliasTable, TCL_STRING_KEYS);
529: 
530:     Tcl_NRCreateCommand(interp, "interp", Tcl_InterpObjCmd, NRInterpCmd,
531: 	    NULL, NULL);
532: 
1699:  *
1700:  * Side effects:
1701:  *	None.
1702:  *
1703:  *----------------------------------------------------------------------
1704:  */
1705: 
1706: static int
1707: AliasDescribe(
1708:     Tcl_Interp *interp,		/* Interpreter for result & errors. */
1709:     Tcl_Interp *childInterp,	/* Interpreter containing alias. */
1710:     Tcl_Obj *namePtr)		/* Name of alias to describe. */
1711: {
1712:     Child *childPtr;
1713:     Tcl_HashEntry *hPtr;
1714:     Alias *aliasPtr;
1715:     Tcl_Obj *prefixPtr;
1716: 
1717:     /*
1718:      * If the alias has been renamed in the child, the parent can still use
1719:      * the original name (with which it was created) to find the alias to
1720:      * describe it.
1721:      */
1722: 
1723:     childPtr = &INTERP_INFO(childInterp)->child;
1724:     hPtr = Tcl_FindHashEntry(&childPtr->aliasTable, TclGetString(namePtr));
1725:     if (hPtr == NULL) {
1726: 	return TCL_OK;
1727:     }
1728:     aliasPtr = (Alias *) Tcl_GetHashValue(hPtr);
1729:     prefixPtr = Tcl_NewListObj(aliasPtr->objc, &aliasPtr->objPtr);
1730:     Tcl_SetObjResult(interp, prefixPtr);
1731:     return TCL_OK;
1732: }
