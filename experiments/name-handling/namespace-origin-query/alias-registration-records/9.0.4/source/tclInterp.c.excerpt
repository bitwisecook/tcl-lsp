1750: 
1751: static int
1752: AliasList(
1753:     Tcl_Interp *interp,		/* Interp for data return. */
1754:     Tcl_Interp *childInterp)	/* Interp whose aliases to compute. */
1755: {
1756:     Tcl_HashEntry *entryPtr;
1757:     Tcl_HashSearch hashSearch;
1758:     Tcl_Obj *resultPtr;
1759:     Alias *aliasPtr;
1760:     Child *childPtr;
1761: 
1762:     TclNewObj(resultPtr);
1763:     childPtr = &INTERP_INFO(childInterp)->child;
1764: 
1765:     entryPtr = Tcl_FirstHashEntry(&childPtr->aliasTable, &hashSearch);
1766:     for ( ; entryPtr != NULL; entryPtr = Tcl_NextHashEntry(&hashSearch)) {
1767: 	aliasPtr = (Alias *) Tcl_GetHashValue(entryPtr);
1768: 	Tcl_ListObjAppendElement(NULL, resultPtr, aliasPtr->token);
1769:     }
1770:     Tcl_SetObjResult(interp, resultPtr);
1771:     return TCL_OK;
1772: }
