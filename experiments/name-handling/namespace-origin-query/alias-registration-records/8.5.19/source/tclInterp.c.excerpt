2211:     slavePtr->interpCmd = Tcl_CreateObjCommand(masterInterp, path,
2212: 	    SlaveObjCmd, slaveInterp, SlaveObjCmdDeleteProc);
2213:     Tcl_InitHashTable(&slavePtr->aliasTable, TCL_STRING_KEYS);
2214:     Tcl_SetHashValue(hPtr, slavePtr);
2215:     Tcl_SetVar(slaveInterp, "tcl_interactive", "0", TCL_GLOBAL_ONLY);
