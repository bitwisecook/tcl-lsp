ltm rule __tcl_lsp_probe_nh20261012cap1_tmm_RULE_INIT {
when RULE_INIT {
set nh_unit "[TMM::cmp_group]:[TMM::cmp_unit]"
set nh_setup {}
set nh_operation [binary format H* 6c697374205b696e666f2070617463686c6576656c5d205b696e666f2074636c76657273696f6e5d205b6e616d6573706163652063757272656e745d]
set nh_setup_code [catch {eval $nh_setup} nh_setup_result]

set nh_ec {}
set nh_ei {}
if {$nh_setup_code == 1} {
    if {[info exists ::errorCode]} {set nh_ec $::errorCode}
    if {[info exists ::errorInfo]} {set nh_ei $::errorInfo}
}
foreach {nh_field nh_value} [list result $nh_setup_result errorcode $nh_ec errorinfo $nh_ei] {
    set nh_encoding utf-8
    set nh_encoder encoding
    if {[catch {$nh_encoder convertto utf-8 $nh_value} nh_encoded]} {
        set nh_encoded $nh_value
        set nh_encoding binary-scan-tcl-value
    }
    binary scan $nh_encoded H* nh_hex
    set nh_chunks [expr {([string length $nh_hex] + 399) / 400}]
    if {$nh_chunks == 0} {set nh_chunks 1}
    for {set nh_i 0} {$nh_i < $nh_chunks} {incr nh_i} {
        set nh_part [string range $nh_hex [expr {$nh_i * 400}] [expr {$nh_i * 400 + 399}]]
        log local0. "NHO|nh20261012cap1|version|tmm-RULE_INIT|setup|$nh_setup_code|$nh_unit|$nh_field|$nh_encoding|$nh_i|$nh_chunks|$nh_part"
    }
}
