set cc catch
set setup_options {}
set question_options {}
set setup_code [$cc [binary format H* ] setup_result setup_options]
set setup_error_code {}
set setup_error_info {}
if {$setup_code && [info exists ::errorCode]} {set setup_error_code $::errorCode}
if {$setup_code && [info exists ::errorInfo]} {set setup_error_info $::errorInfo}
set question_code unreached
set question_result {}
set question_error_code {}
set question_error_info {}
if {!$setup_code} {
set question_code [$cc [binary format H* 3a3a696e7374616c6c3a3a72656164] question_result question_options]
if {$question_code && [info exists ::errorCode]} {set question_error_code $::errorCode}
if {$question_code && [info exists ::errorInfo]} {set question_error_info $::errorInfo}
}
foreach key {setup_code setup_result setup_options setup_error_code setup_error_info question_code question_result question_options question_error_code question_error_info} {binary scan [set $key] H* hex; puts [list OBS $key $hex]}
