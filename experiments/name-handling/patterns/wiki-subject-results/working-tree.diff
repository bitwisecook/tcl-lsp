+pub fn bytelength<O: ValueOps>(ops: &mut O, s: &O::Value) -> O::Value {
+    let n = ops
+        .as_str(s)
+        .encode_utf16()
+        .map(|unit| match unit {
+            1..=0x7f => 1_i64,
+            0..=0x7ff => 2,
+            _ => 3,
+        })
+        .sum();
+    ops.new_int(n)
