+#[test]
+fn namespace_delete_validates_all_operands_before_mutating() {
+    let source = "namespace eval N {}\n\
+                  set code [catch {namespace delete N missing} message]\n\
+                  list $code [namespace exists N] $message";
+    for release in ["tcl8.4", "tcl8.5", "tcl8.6", "tcl9.0", "tcl9.1"] {
+        assert_eq!(
+            run_at(source, release),
+            "1 1 {unknown namespace \"missing\" in namespace delete command}",
+            "{release}"
+        );
+    }
+}
