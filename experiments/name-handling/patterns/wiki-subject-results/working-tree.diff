+/// Requirement words passed to a `package unknown` command prefix.
+#[must_use]
+pub fn package_unknown_requirements_for(
+    requirements: &[String],
+    exact: bool,
+    release: TclVersion,
+) -> Vec<String> {
+    if release == TclVersion::V8_4 {
+        let mut arguments = vec![requirements.first().cloned().unwrap_or_default()];
+        if exact {
+            arguments.push("-exact".to_owned());
+        }
+        arguments
+    } else if requirements.is_empty() {
+        vec!["0-".to_owned()]
+    } else if exact {
+        requirements.iter().map(|version| exact_requirement(version)).collect()
+    } else {
+        requirements.to_vec()
+    }
+}
