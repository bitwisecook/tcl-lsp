 fn trace_original_child_guard(label: &str, offset: Option<u32>, passed: bool) {
     if std::env::var_os("TCL_LSP_TRACE_ORIGINAL_CHILD_GUARDS").is_some() {
         eprintln!("ORIGINAL_CHILD_GUARD label={label} offset={offset:?} passed={passed}");
+    }
+}
+
+fn callback_source_probe_enabled(offset: Option<u32>) -> bool {
+    matches!(offset, Some(158 | 211))
+        && std::env::var_os("TCL_LSP_TRACE_CALLBACK_SOURCE_PROJECTION").is_some()
+}
+
+fn trace_callback_source_probe(stage: &str, offset: Option<u32>, passed: bool) {
+    if callback_source_probe_enabled(offset) {
+        eprintln!("CALLBACK_SOURCE_GUARD stage={stage} offset={offset:?} passed={passed}");
+    }
+}
+
+fn trace_callback_projected_schema(
+    offset: Option<u32>,
+    schema: &tcl_registry::ResolvedInvocation<'_, '_>,
+) {
+    if callback_source_probe_enabled(offset) {
+        eprintln!(
+            "CALLBACK_SOURCE_SCHEMA offset={offset:?} command={} subcommand_kind={:?} subcommand={:?} argument_offset={} wraps={} body_kind={:?}",
+            schema.facts().canonical_command,
+            schema.subcommand.kind(),
+            schema.subcommand.resolved().map(|selected| selected.canonical_name),
+            schema.semantics.argument_offset,
+            schema.semantics.traits.contains(tcl_registry::Traits::WRAPS_COMMAND_PREFIX),
+            schema.semantics.body_kind,
+        );
     }
 }
 
