@@ -26,6 +26,78 @@ use tcl_registry::CommandRegistry;
 mod itcl;
 mod snit;
 
+static ORIGINAL_W210_TRACE_ACTIVE: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+
+pub(crate) fn original_w210_trace_enabled() -> bool {
+    ORIGINAL_W210_TRACE_ACTIVE.load(std::sync::atomic::Ordering::SeqCst)
+}
+
+pub(crate) fn original_w210_source_hash(bytes: &[u8]) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut hash = std::collections::hash_map::DefaultHasher::new();
+    bytes.hash(&mut hash);
+    hash.finish()
+}
+
+struct OriginalW210TraceScope(bool);
+impl Drop for OriginalW210TraceScope {
+    fn drop(&mut self) {
+        ORIGINAL_W210_TRACE_ACTIVE.store(self.0, std::sync::atomic::Ordering::SeqCst);
+    }
+}
+
+pub(crate) struct OriginalW210ReadTrace {
+    enabled: bool,
+    source_hash: u64,
+    start: u32,
+    end: u32,
+    stage: std::cell::Cell<&'static str>,
+    accepted: std::cell::Cell<bool>,
+}
+impl OriginalW210ReadTrace {
+    pub(crate) fn new(image: &tcl_lexer::SourceImage, span: tcl_lexer::Span) -> Self {
+        Self {
+            enabled: original_w210_trace_enabled(),
+            source_hash: original_w210_source_hash(image.bytes()),
+            start: span.start(),
+            end: span.end(),
+            stage: std::cell::Cell::new("begin"),
+            accepted: std::cell::Cell::new(false),
+        }
+    }
+    pub(crate) fn at(&self, stage: &'static str) {
+        self.stage.set(stage);
+        if self.enabled {
+            eprintln!(
+                "W210_ORIGINAL_READ attempt={stage} source_hash={:016x} span={}..{}",
+                self.source_hash, self.start, self.end
+            );
+        }
+    }
+    pub(crate) fn accept(&self) {
+        self.accepted.set(true);
+    }
+}
+impl Drop for OriginalW210ReadTrace {
+    fn drop(&mut self) {
+        if self.enabled {
+            eprintln!(
+                "W210_ORIGINAL_READ result={} stage={} source_hash={:016x} span={}..{}",
+                if self.accepted.get() {
+                    "Accepted"
+                } else {
+                    "Refused"
+                },
+                self.stage.get(),
+                self.source_hash,
+                self.start,
+                self.end
+            );
+        }
+    }
+}
+
