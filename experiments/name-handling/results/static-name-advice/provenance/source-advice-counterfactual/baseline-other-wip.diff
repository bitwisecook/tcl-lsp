+        assert_eq!(
+            interp.eval_str(script.as_bytes()),
+            Code::Ok,
+            "{version:?}: {:?}; refusal={:?}",
+            interp.result_bytes(),
+            interp.native_execution_refusal()
+        );
+        let mut result = interp.result_bytes();
+        result.push(b'\n');
+        assert_eq!(result, oracle.stdout, "{version:?}");
+    }
+}
