+/// Original SIMPLE_WORD option grammar, independent of registration authority.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum NativeNamespaceWhichShape {
+    Command { argument: usize },
+    Declined,
+    Unavailable,
+}
+
+pub(crate) fn namespace_which_shape(
+    shapes: &[Shape],
+    option: Option<&[u8]>,
+    version: TclVersion,
+) -> NativeNamespaceWhichShape {
+    use NativeNamespaceWhichShape as Outcome;
+    if version < TclVersion::V8_6 || !(1..=2).contains(&shapes.len()) {
+        return Outcome::Declined;
+    }
+    let argument = if shapes.len() == 1 {
+        0
+    } else {
+        match shapes[0] {
+            Shape::Literal | Shape::QuotedLiteral | Shape::BracedLiteral => {
+                let Some(option) = option else {
+                    return Outcome::Unavailable;
+                };
+                if !(2..=8).contains(&option.len()) || !b"-command".starts_with(option) {
+                    return Outcome::Declined;
+                }
+                1
+            }
+            Shape::BackslashLiteral | Shape::Substituted => return Outcome::Declined,
+            Shape::Expanded | Shape::Opaque => return Outcome::Unavailable,
+        }
+    };
+    if matches!(shapes[argument], Shape::Expanded | Shape::Opaque) {
+        Outcome::Unavailable
+    } else {
+        Outcome::Command { argument }
+    }
+}
+
 /// Pure compile-known pattern restriction of the original C compiler. The
 /// caller supplies its original source-channel value and selected registration.
 #[must_use]
