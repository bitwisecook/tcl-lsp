-      "id": "naming.package.original-file-candidate-provenance",
-      "document": "docs/design/analysis/name-resolution-proofs/original-package-file-candidate-provenance.md",
-      "problem_statement": "A package filename scan can mistake any operand named source, inert braced data or all directory files for evidence that a deferred loader sources a file.",
