\n\tif (objc == 3) {\n\t    cmdObj = objv[2];\n\t} else {\n\t    cmdObj = Tcl_ConcatObj(objc-2, objv+2);\n\t}\n\treturn TimerIdleDo(interp, cmdObj);\n    case AFTER_INFO:\n\tif (objc < 2 || objc > 3) {\n\t    Tcl_WrongNumArgs(interp, 2, objv, \"?id?\");\n\t    return TCL_ERROR;\n\t}\n\treturn TimerInfoDo(interp, objc-1, objv+1, true);\n    default:\n\tTCL_UNREACHABLE();\n    }\n    return TCL_OK;\n}",
