   /* Stop the loop if a provided script returns BREAK or ERR */\n            int retval = Jim_EvalObj(interp, scriptObjPtr);\n            if (retval == JIM_ERR || retval == JIM_BREAK) {\n                if (retval == JIM_ERR) {\n                    rc = -2;\n                }\n                break;\n            }\n        }\n    }\n    if (oldValue)\n        Jim_DecrRefCount(interp, oldValue);\n\n    if (rc == -2) {\n        return JIM_ERR;\n    }\n\n    Jim_SetEmptyResult(interp);\n    return JIM_OK;\n}",
