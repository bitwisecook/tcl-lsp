+/// Installation directories appended to `auto_path`, in Tcl lookup order.
+#[must_use]
+pub fn auto_path_installation(library: Option<&[u8]>, executable: Option<&[u8]>) -> Vec<Vec<u8>> {
+    let mut paths = Vec::new();
+    if let Some(library) = library {
