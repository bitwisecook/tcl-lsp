+pub struct OriginalProcedureSummaryOwners(Option<Arc<Module>>);
+impl PartialEq for OriginalProcedureSummaryOwners {
+    fn eq(&self, other: &Self) -> bool {
+        match (&self.0, &other.0) {
+            (Some(left), Some(right)) => Arc::ptr_eq(left, right),
+            (None, None) => true,
+            _ => false,
+        }
+    }
