+    pub(crate) fn static_unicode_value(&self) -> Option<String> {
+        if self.word.span() != self.cursor.container_span()
+            || !self
+                .cursor
+                .matches_source(self.word.image(), self.word.config())
+            || self.word.group().expand
+        {
