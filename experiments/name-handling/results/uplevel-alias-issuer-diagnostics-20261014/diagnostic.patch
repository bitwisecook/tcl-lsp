+    #[test]
+    fn logical_source_issuer_probe_preserves_actual_write_and_body_consumers() {
+        let fixtures: &[(&str, &[&str])] = &[
+            (
+                "namespace eval N {variable x FIRST; set x AGAIN; puts $x}\n",
+                &["set x AGAIN"],
+            ),
+            (
+                "set x ROOT\nproc p {} {set x FIRST; set x AGAIN; set N::x QUALIFIED}\n",
+                &["set x AGAIN", "set N::x QUALIFIED"],
+            ),
+            (
+                "set x ROOT\nnamespace eval N {\n variable x NAMESPACE\n proc p {} {\n  set x PROCEDURE\n  uplevel #0 {puts $x}\n  uplevel 0 {puts $x}\n  uplevel 1 {puts $x}\n }\n}\n",
+                &["uplevel #0", "uplevel 0", "uplevel 1"],
+            ),
+            (
+                "set root ROOT\nnamespace eval $unknown {\n set local OWN\n puts $local\n puts $Target::x\n}\n",
+                &["namespace eval"],
+            ),
+            (
+                "interp alias {} branch {} if 1\nbranch {puts $value}",
+                &["branch {puts"],
+            ),
+        ];
+        let mut failures = Vec::new();
+        for &(source, needles) in fixtures {
+            let analysis = crate::analyser::Analyser::new().analyse(source, "tcl");
+            let input = analysis.resolved_input.as_ref().unwrap();
+            let realm = analysis.retained_command_realm().unwrap();
+            let image = tcl_lexer::SourceImage::document(source);
+            eprintln!(
+                "ISSUER_FIXTURE source={source:?} cards={:?}",
+                analysis
+                    .original_variable_write_advice
+                    .iter()
+                    .map(|card| card.span())
+                    .collect::<Vec<_>>()
+            );
+            for &needle in needles {
+                let offset = u32::try_from(source.find(needle).unwrap()).unwrap();
+                let segment = realm
+                    .original_source_catalogue_segment_at(input, offset)
+                    .unwrap_or_else(|| {
+                        crate::segmenter::segment_commands_with_offset_and_config(
+                            &source[usize::try_from(offset).unwrap()..],
+                            offset,
+                            input.lexer_config().nested(),
+                        )
+                        .into_iter()
+                        .next()
+                        .unwrap()
+                    });
+                let words = source_registry_words(source, &analysis, &segment);
+                let schema = words.as_ref().and_then(|words| {
+                    words.with_source_schema(input.borrowed_context_registry(), |schema| {
+                        let (roles, complete) = schema.authored_source_argument_roles();
+                        (roles, complete)
+                    })
+                });
+                let bodies = words.as_ref().map(|words| {
+                    words
+                        .source_script_bodies(input.borrowed_context_registry())
+                        .iter()
+                        .map(|body| body.content_span())
+                        .collect::<Vec<_>>()
+                });
+                eprintln!(
+                    "ISSUER_CALL needle={needle:?} offset={offset} source_words={} schema={schema:?} bodies={bodies:?}",
+                    words.is_some()
+                );
+                if needle.starts_with("set ") {
+                    let token = segment.argv.get(1).unwrap();
+                    let original = realm.original_written_word_at_span_in_source(
+                        &image,
+                        token.span,
+                        input.lexer_config(),
+                    );
+                    let card = analysis
