+                let segment = realm
+                    .invocation_at_source("", offset)
+                    .original_recorded_command()
+                    .map(|(segment, _)| segment)
+                    .or_else(|| realm.original_source_catalogue_segment_at(input, offset));
+                let words = source_registry_words_at(source, &analysis, offset);
+                let schema = words.as_ref().and_then(|words| {
+                    words.with_source_schema(input.borrowed_context_registry(), |schema| {
+                        let (roles, complete) = schema.authored_source_argument_roles();
+                        (roles, complete)
+                    })
+                });
+                let bodies = words.as_ref().map(|words| {
+                    words
+                        .source_script_bodies(input.borrowed_context_registry())
+                        .iter()
+                        .map(|body| body.content_span())
+                        .collect::<Vec<_>>()
+                });
+                eprintln!(
+                    "ISSUER_CALL needle={needle:?} offset={offset} source_words={} schema={schema:?} bodies={bodies:?}",
+                    words.is_some()
+                );
