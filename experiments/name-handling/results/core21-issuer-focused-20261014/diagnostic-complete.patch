+                        token.span,
+                        original.is_some()
+                    );
+                    if !card {
+                        failures.push(format!("missing write card: {needle}"));
+                    }
+                } else if bodies.as_ref().is_none_or(|bodies| bodies.is_empty()) {
+                    failures.push(format!("missing body: {needle}"));
