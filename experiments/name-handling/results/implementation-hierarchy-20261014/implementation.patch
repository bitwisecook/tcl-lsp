+namespace eval Inner {{
+\
+                 oo::class create Base {{method run {{}} {{}}}}
+\
+                 oo::class create Child {{{relation} Base; method run {{}} {{}}}}
+\
+                 oo::class create Grandchild {{superclass Child; method run {{}} {{}}}}
+\
+                 }}
+}}
+"
+            );
