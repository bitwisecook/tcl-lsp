+/// Readonly name words selected by the retained complete original invocation.
+#[must_use]
+pub fn original_variable_name_role_words(
+    source: &str,
+    analysis: &crate::analyser::AnalysisResult,
+    command: &SegmentedCommand,
+) -> Vec<NameRoleWord> {
+    use crate::registry_invocation::{EffectiveInvocationWord, InvocationWordOrigin};
+    let Some(selected) =
+        crate::registry_invocation::source_registry_words(source, analysis, command)
+    else {
+        return Vec::new();
+    };
+    let mut out = Vec::new();
+    for &(argument, role) in selected.roles().unwrap_or(&[]) {
+        if !role.names_variable() {
+            continue;
+        }
+        let Some(InvocationWordOrigin::Written(written)) = selected.origins().get(argument + 1)
+        else {
+            continue;
+        };
+        let Some(original) = selected.original_argument_word(argument) else {
+            continue;
+        };
+        let value = match selected.arguments().get(argument) {
+            Some(EffectiveInvocationWord::Literal(value)) => value.as_str(),
+            Some(EffectiveInvocationWord::ByteLiteral(value)) => {
+                let Ok(value) = std::str::from_utf8(value) else {
+                    continue;
+                };
+                value
+            }
+            _ => continue,
+        };
+        let Ok(span) = original.content_span() else {
+            continue;
+        };
+        out.push(NameRoleWord {
+            word: value.to_owned(),
+            span,
+            braced_literal: true,
+            role,
+            word_index: *written,
+        });
+    }
+    out.sort_by_key(|word| word.span.start());
+    out.dedup_by(|left, right| left.span == right.span);
+    out
+}
