+#[cfg(test)]
+pub(super) fn trace_w210_factory(site: &CommandAllocationSite, stage: &str, passed: bool) {
+    if std::env::var_os("TCL_LSP_TRACE_W210_FACTORY").is_some()
+        && site.source.source_image().bytes()
+            == include_bytes!(
+                "../../../../experiments/name-handling/tcltest-shared-frame/probe.tcl"
+            )
+        && [58, 441, 760, 1076].contains(&site.offset)
+    {
+        eprintln!(
+            "W210_FACTORY offset={} stage={stage} passed={passed}",
+            site.offset
+        );
+    }
+}
+
+macro_rules! w210_option {
+    ($site:expr, $stage:expr, $value:expr) => {{
+        let value = $value;
+        #[cfg(test)]
+        trace_w210_factory($site, $stage, value.is_some());
+        value
+    }};
+}
+
+macro_rules! w210_check {
+    ($site:expr, $stage:expr, $value:expr) => {{
+        let value = $value;
+        #[cfg(test)]
+        trace_w210_factory($site, $stage, value);
+        value
+    }};
+}
