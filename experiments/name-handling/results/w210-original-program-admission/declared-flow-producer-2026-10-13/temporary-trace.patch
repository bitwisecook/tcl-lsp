+#[cfg(test)]
+pub(super) fn trace_w210_producer_matches(site: &CommandAllocationSite) -> bool {
+    if std::env::var_os("TCL_LSP_TRACE_W210_PRODUCER").is_none() {
+        return false;
+    }
+    let bytes = site.source.source_image().bytes();
+    (bytes
+        == include_bytes!("../../../../experiments/name-handling/tcltest-shared-frame/probe.tcl")
+        && [58, 441, 760, 1076].contains(&site.offset))
+        || bytes == b"proc ::missing::p {arg} {puts $missing}"
+        || bytes == b"rename proc stock; stock p {arg} {puts $missing}"
+        || bytes == b"interp alias {} define {} proc p; define {arg} {puts $missing}"
+        || bytes == b"interp alias {} define {} proc p {arg}; define {puts $missing}"
+}
+
+#[cfg(test)]
+pub(super) fn trace_w210_producer(site: &CommandAllocationSite, stage: &str, available: bool) {
+    if trace_w210_producer_matches(site) {
+        eprintln!(
+            "W210_PRODUCER offset={} stage={stage} available={available}",
+            site.offset
+        );
+    }
+}
+
+macro_rules! w210_producer_option {
+    ($site:expr, $stage:expr, $value:expr) => {{
+        let value = $value;
+        #[cfg(test)]
+        trace_w210_producer($site, $stage, value.is_some());
+        value
+    }};
+}
+
+macro_rules! w210_producer_check {
+    ($site:expr, $stage:expr, $value:expr) => {{
+        let value = $value;
+        #[cfg(test)]
+        trace_w210_producer($site, $stage, value);
+        value
+    }};
+}
