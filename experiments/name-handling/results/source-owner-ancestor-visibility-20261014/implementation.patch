+            ("Cargo.toml", "[package]\nname = \"fixture\"\n"),
+            ("src/lib.rs", "pub(crate) mod shared; mod outside;"),
+            ("src/shared/mod.rs", "pub(in crate::shared) mod owner; pub(crate) mod caller;"),
+            ("src/shared/owner.rs", "pub(crate) struct Ledger; impl Ledger { pub(crate) fn capture() {} }"),
