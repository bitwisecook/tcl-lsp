+fn visibility_scope(visibility: &syn::Visibility, owner: &str) -> Option<String> {
+    let restriction = match visibility {
+        syn::Visibility::Public(_) => return Some("crate".into()),
+        syn::Visibility::Inherited => return Some(owner.into()),
+        syn::Visibility::Restricted(restriction) => restriction,
+    };
+    if restriction.path.leading_colon.is_some()
+        || restriction.path.segments.iter().any(|segment| !matches!(segment.arguments, syn::PathArguments::None))
+    {
+        return None;
+    }
+    let parts = restriction.path.segments.iter().map(|segment| segment.ident.to_string()).collect::<Vec<_>>();
+    if restriction.in_token.is_none() && parts.len() != 1 { return None; }
+    let mut base = owner.split("::").map(str::to_owned).collect::<Vec<_>>();
+    if base.first().is_none_or(|part| part != "crate") { return None; }
+    let mut rest = parts.as_slice();
+    match rest.first()?.as_str() {
+        "crate" => { base.truncate(1); rest = &rest[1..]; }
+        "self" => { rest = &rest[1..]; }
+        "super" => {
+            while rest.first().is_some_and(|part| part == "super") {
+                if base.len() == 1 { return None; }
+                base.pop();
+                rest = &rest[1..];
+            }
+        }
+        _ => return None,
+    }
+    if rest.iter().any(|part| matches!(part.as_str(), "crate" | "self" | "super")) { return None; }
+    base.extend(rest.iter().cloned());
+    let scope = base.join("::");
+    (owner == scope || owner.starts_with(&format!("{scope}::"))).then_some(scope)
+}
