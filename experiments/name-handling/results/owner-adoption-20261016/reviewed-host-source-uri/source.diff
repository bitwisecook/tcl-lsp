+        ));
+        assert_eq!(root(&vm, "host-target"), array);
+        assert_eq!(array_member(&vm, array, "retained"), retained);
+        assert_eq!(bytes(&vm, retained), b"unchanged");
+        let installed = array_member(&vm, array, "missing::key(x)");
