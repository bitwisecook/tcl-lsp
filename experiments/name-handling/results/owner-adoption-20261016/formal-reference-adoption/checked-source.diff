+                    let plan = tcl_lexer::native_script_words_in_with_purpose(
+                        word.image().clone(),
+                        body,
+                        word.config(),
+                        tcl_lexer::SourceSegmentationPurpose::NestedScript,
+                    )
+                    .ok()?;
+                    if plan.fatal_tail.is_some() {
+                        return None;
+                    }
+                    for command in plan.commands {
+                        pending.extend(command.words);
+                    }
