+        assert_eq!(backend.diag_inputs_epoch(), epoch);
+        assert!(!validate(&backend, &result).await);
+        let current = backend
+            .minify_document_command(&[snapshot(&uri, source, 3)])
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(validate(&backend, &current).await);
+        backend
+            .documents
+            .lock("transform_close_fixture")
+            .await
+            .remove(&uri);
