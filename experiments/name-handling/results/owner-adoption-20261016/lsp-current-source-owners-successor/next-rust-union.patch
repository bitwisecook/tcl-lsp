+            uri: item.uri.clone(),
+        })?;
+        let Some(advice) = advice else {
+            return Ok(None);
+        };
+        self.finish_logical_call_advice(&retained, &advice, &stamp)
+            .await
+            .map(|projection| projection.map(|projection| projection.edges))
+    }
