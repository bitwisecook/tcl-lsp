+                entry: &frame,
+                nodes: Vec::new(),
+                jobs: Vec::new(),
+                conditional_overwrites: Vec::new(),
+                read_sites: BTreeSet::new(),
+            };
+            let mut raw = tokens.clone();
+            raw.source_binding = None;
