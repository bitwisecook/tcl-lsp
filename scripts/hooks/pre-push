#!/usr/bin/env bash
# Pre-push hook: refuse to push unless one of the recognised gate
# stamps matches the current worktree.
#
# Accepted stamps, in order of preference:
#
#   tmp/test-slow.stamp   — comprehensive (`make test-slow`).  Strictest.
#   tmp/check-all.stamp   — full lint + typecheck across every language.
#   tmp/ci-fast.stamp     — Python lint + typecheck + fast tests (≈10s).
#                           Minimum gate; mirrors the GitHub Actions
#                           ``pr-gate`` job that the PR will run.
#
# Each ``make`` target writes its own stamp on success via
# :file:`scripts/worktree-fingerprint.sh`; the hook recomputes the
# fingerprint at push time and rejects the push if no stamp matches.
#
# Agents must also have a matching ``tmp/test-slow.stamp`` before
# opening a PR (see AGENTS.md).
#
# Bypass with ``--no-verify`` or ``SKIP_PUSH_GATE=1`` only when
# explicitly authorised.
set -euo pipefail

if [ -n "${SKIP_PUSH_GATE:-}" ] || [ -n "${SKIP_TEST_SLOW_GATE:-}" ]; then
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
fingerprint_script="$repo_root/scripts/worktree-fingerprint.sh"
hooks_dir=$(cd "$repo_root" && git rev-parse --git-path hooks)
case "$hooks_dir" in
    /*) ;;
    *)  hooks_dir="$repo_root/$hooks_dir" ;;
esac

if [ ! -x "$fingerprint_script" ]; then
    echo "pre-push: $fingerprint_script not found or not executable" >&2
    echo "pre-push: did the hook get installed against an old checkout?" >&2
    exit 1
fi

current=$("$fingerprint_script")

# Stamps are ordered from strongest to weakest.  Any matching stamp
# at the current fingerprint accepts the push.
stamps=(
    "$repo_root/tmp/test-slow.stamp"
    "$repo_root/tmp/check-all.stamp"
    "$repo_root/tmp/ci-fast.stamp"
)

matched=""
for stamp in "${stamps[@]}"; do
    if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$current" ]; then
        matched="$stamp"
        break
    fi
done

if [ -n "$matched" ]; then
    exit 0
fi

# Drift / missing — explain how to recover.
existing=""
for stamp in "${stamps[@]}"; do
    if [ -f "$stamp" ]; then
        existing="$existing\n  $stamp ($(cat "$stamp"))"
    fi
done

if [ -z "$existing" ]; then
    cat >&2 <<EOF
pre-push: refused — no gate stamp found in $repo_root/tmp/
pre-push:
pre-push: Run ONE of the following before pushing:
pre-push:
pre-push:   make ci-fast       Fast Python gate (~10s)
pre-push:   make check-all     Full multi-language gate (~30s)
pre-push:   make test-slow     Comprehensive (required before opening a PR)
pre-push:
pre-push: Each target writes its own stamp on success.
pre-push:
pre-push: To bypass temporarily: SKIP_PUSH_GATE=1 git push ...
pre-push: To uninstall the hook:  rm $hooks_dir/pre-push
EOF
else
    cat >&2 <<EOF
pre-push: refused — worktree fingerprint does not match any gate stamp
pre-push:
pre-push:   current:$existing
pre-push:           current fingerprint: $current
pre-push:
pre-push: The worktree has changed since the last gate run.  Re-run
pre-push: 'make ci-fast' (fast) / 'make check-all' (strict) /
pre-push: 'make test-slow' (full) before pushing.
pre-push:
pre-push: To bypass temporarily: SKIP_PUSH_GATE=1 git push ...
EOF
fi

exit 1
