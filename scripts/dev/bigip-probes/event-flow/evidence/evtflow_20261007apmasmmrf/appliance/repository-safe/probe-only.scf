ltm rule __tcl_lsp_evtflow_efe_ssl_data {
when RULE_INIT {
        log local0. "EVTFLOW2|run=EFE|event=RULE_INIT|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=ssl-data"
    }
    when CLIENTSSL_HANDSHAKE {
        log local0. "EVTFLOW2|run=EFE|event=CLIENTSSL_HANDSHAKE|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=ssl-data|cipher=[SSL::cipher name]"
        SSL::collect 1
    }
    when CLIENTSSL_DATA {
        binary scan [SSL::payload] H* payload_hex
        log local0. "EVTFLOW2|run=EFE|event=CLIENTSSL_DATA|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=ssl-data|bytes=[SSL::payload length]|hex=$payload_hex"
        SSL::release
    }
    when SERVERSSL_HANDSHAKE {
        log local0. "EVTFLOW2|run=EFE|event=SERVERSSL_HANDSHAKE|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=ssl-data|cipher=[SSL::cipher name]"
        SSL::collect 1
    }
    when SERVERSSL_DATA {
        binary scan [SSL::payload] H* payload_hex
        log local0. "EVTFLOW2|run=EFE|event=SERVERSSL_DATA|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=ssl-data|bytes=[SSL::payload length]|hex=$payload_hex"
        SSL::release
    }
}
ltm rule __tcl_lsp_evtflow_efe_tcp_user_data {
when RULE_INIT {
        log local0. "EVTFLOW2|run=EFE|event=RULE_INIT|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=tcp-user-data"
    }
    when CLIENT_ACCEPTED {
        set evtflow2_id [format {%s:%s} [IP::client_addr] [TCP::client_port]]
        log local0. "EVTFLOW2|run=EFE|event=CLIENT_ACCEPTED|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=tcp-user-data|id=$evtflow2_id"
        TCP::collect
    }
    when CLIENT_DATA {
        binary scan [TCP::payload] H* payload_hex
        log local0. "EVTFLOW2|run=EFE|event=CLIENT_DATA|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=tcp-user-data|id=$evtflow2_id|bytes=[TCP::payload length]|hex=$payload_hex"
        TCP::release
        TCP::notify request
        TCP::collect
    }
    when USER_REQUEST {
        log local0. "EVTFLOW2|run=EFE|event=USER_REQUEST|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=tcp-user-data|id=$evtflow2_id|side=serverside"
    }
    when SERVER_CONNECTED {
        log local0. "EVTFLOW2|run=EFE|event=SERVER_CONNECTED|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=tcp-user-data|id=$evtflow2_id"
        TCP::collect
    }
    when SERVER_DATA {
        binary scan [TCP::payload] H* payload_hex
        log local0. "EVTFLOW2|run=EFE|event=SERVER_DATA|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=tcp-user-data|id=$evtflow2_id|bytes=[TCP::payload length]|hex=$payload_hex"
        TCP::release
        TCP::notify response
        TCP::collect
    }
    when USER_RESPONSE {
        log local0. "EVTFLOW2|run=EFE|event=USER_RESPONSE|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=tcp-user-data|id=$evtflow2_id|side=clientside"
    }
    when CLIENT_CLOSED {
        log local0. "EVTFLOW2|run=EFE|event=CLIENT_CLOSED|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=tcp-user-data|id=$evtflow2_id"
    }
}
