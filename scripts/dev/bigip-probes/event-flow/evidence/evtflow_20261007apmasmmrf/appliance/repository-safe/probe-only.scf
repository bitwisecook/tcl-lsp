    when WS_CLIENT_FRAME {
        log local0. "EVTFLOW2|run=EFC|event=WS_CLIENT_FRAME|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=websocket"
        WS::collect frame
    }
    when WS_CLIENT_DATA {
        binary scan [WS::payload] H* payload_hex
        log local0. "EVTFLOW2|run=EFC|event=WS_CLIENT_DATA|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=websocket|bytes=[WS::payload length]|hex=$payload_hex"
