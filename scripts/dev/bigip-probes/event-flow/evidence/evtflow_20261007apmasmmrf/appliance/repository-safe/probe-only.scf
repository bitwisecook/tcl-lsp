        log local0. "EVTFLOW2|run=EGH|event=HTTP_REQUEST|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=asm|mode=transparent|id=$evtflow2_asm_id|uri=[HTTP::uri]"
    }
    when ASM_REQUEST_DONE {
        log local0. "EVTFLOW2|run=EGH|event=ASM_REQUEST_DONE|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=asm|mode=transparent|id=$evtflow2_asm_id|status=[ASM::status]|count=[ASM::violation count]|names=[ASM::violation names]"
    }
    when ASM_REQUEST_VIOLATION {
        log local0. "EVTFLOW2|run=EGH|event=ASM_REQUEST_VIOLATION|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=asm|mode=transparent|id=$evtflow2_asm_id"
    }
    when ASM_REQUEST_BLOCKING {
        log local0. "EVTFLOW2|run=EGH|event=ASM_REQUEST_BLOCKING|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=asm|mode=transparent|id=$evtflow2_asm_id|policy=[ASM::policy]"
    }
    when ASM_RESPONSE_VIOLATION {
        log local0. "EVTFLOW2|run=EGH|event=ASM_RESPONSE_VIOLATION|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|probe=asm|mode=transparent|id=$evtflow2_asm_id"
    }
}
ltm rule __tcl_lsp_evtflow_egi_cross_early {
when RULE_INIT {
        log local0. "EVTFLOW3|run=EGI|event=RULE_INIT|phase=early|tmm=[TMM::cmp_group]:[TMM::cmp_unit]"
    }
    when CLIENT_ACCEPTED priority 10 {
        log local0. "EVTFLOW3|run=EGI|event=CLIENT_ACCEPTED|phase=early|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|client=[IP::client_addr]:[TCP::client_port]"
    }
    when HTTP_REQUEST priority 10 {
        set evtflow3_id [HTTP::header value X-Evtflow-Request]
        log local0. "EVTFLOW3|run=EGI|event=HTTP_REQUEST|phase=early|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|id=$evtflow3_id|uri=[HTTP::uri]"
    }
}
ltm rule __tcl_lsp_evtflow_egi_cross_late {
when RULE_INIT {
        log local0. "EVTFLOW3|run=EGI|event=RULE_INIT|phase=late|tmm=[TMM::cmp_group]:[TMM::cmp_unit]"
    }
    when HTTP_REQUEST priority 900 {
        set evtflow3_id [HTTP::header value X-Evtflow-Request]
        log local0. "EVTFLOW3|run=EGI|event=HTTP_REQUEST|phase=late|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|id=$evtflow3_id|uri=[HTTP::uri]"
    }
    when HTTP_REQUEST_RELEASE {
        log local0. "EVTFLOW3|run=EGI|event=HTTP_REQUEST_RELEASE|phase=late|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|id=$evtflow3_id|uri=[HTTP::uri]"
    }
    when SERVER_CONNECTED {
        log local0. "EVTFLOW3|run=EGI|event=SERVER_CONNECTED|phase=late|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|id=$evtflow3_id|server=[IP::server_addr]:[TCP::server_port]"
    }
    when HTTP_REQUEST_SEND {
        log local0. "EVTFLOW3|run=EGI|event=HTTP_REQUEST_SEND|phase=late|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|id=$evtflow3_id|uri=[HTTP::uri]"
    }
    when HTTP_RESPONSE priority 100 {
        log local0. "EVTFLOW3|run=EGI|event=HTTP_RESPONSE|phase=late|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|id=$evtflow3_id|status=[HTTP::status]"
    }
    when HTTP_RESPONSE_RELEASE {
        log local0. "EVTFLOW3|run=EGI|event=HTTP_RESPONSE_RELEASE|phase=late|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|id=$evtflow3_id|status=[HTTP::status]"
    }
    when CLIENT_CLOSED {
        set close_id unset
        if { [info exists evtflow3_id] } { set close_id $evtflow3_id }
        log local0. "EVTFLOW3|run=EGI|event=CLIENT_CLOSED|phase=late|tmm=[TMM::cmp_group]:[TMM::cmp_unit]|id=$close_id"
    }
}
