#!/usr/bin/env bash
#
# Launch the native Rust tcl-lsp MCP server (`tcl-mcp`).
#
# Resolution order (all diagnostics go to stderr so stdout stays a clean
# JSON-RPC stream):
#   1. a locally-built binary (target/release or target/debug) — in-repo dev;
#   2. a previously-fetched binary cached under ~/.cache/tcl-lsp;
#   3. a prebuilt release asset downloaded from GitHub for the host platform —
#      the "skill fetches the binary" path (needs curl/gh + network, no cargo);
#   4. a from-source `cargo build` as the last resort.
#
# Referenced by the repo `.mcp.json` so Claude Code / Codex use the native
# server (no Python, no PyO3) when working in this repository.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
repo="bitwisecook/tcl-lsp"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/tcl-lsp"

# 1. Locally-built binary (in-repo dev / `make rust-mcp`).
for cand in "$root/target/release/tcl-mcp" "$root/target/debug/tcl-mcp"; do
    [ -x "$cand" ] && exec "$cand" "$@"
done

# 2. Previously-fetched binary.
[ -x "$cache/tcl-mcp" ] && exec "$cache/tcl-mcp" "$@"

# Host OS/arch → Rust target triple used in the `tcl-mcp-<triple>` asset names.
host_triple() {
    case "$(uname -s)/$(uname -m)" in
        Linux/x86_64 | Linux/amd64)   echo x86_64-unknown-linux-gnu ;;
        Linux/aarch64 | Linux/arm64)  echo aarch64-unknown-linux-gnu ;;
        Linux/riscv64)                echo riscv64gc-unknown-linux-gnu ;;
        Darwin/arm64 | Darwin/aarch64) echo aarch64-apple-darwin ;;
        Darwin/x86_64)                echo x86_64-apple-darwin ;;
        *) return 1 ;;
    esac
}

# 3. Fetch a prebuilt release asset for this platform.
if triple="$(host_triple)"; then
    asset="tcl-mcp-${triple}"
    mkdir -p "$cache"
    if command -v gh >/dev/null 2>&1 \
        && gh release download --repo "$repo" --pattern "$asset" --output "$cache/tcl-mcp" --clobber >&2 2>&1; then
        chmod +x "$cache/tcl-mcp" && exec "$cache/tcl-mcp" "$@"
    fi
    if command -v curl >/dev/null 2>&1 \
        && curl -fsSL "https://github.com/${repo}/releases/latest/download/${asset}" -o "$cache/tcl-mcp" 2>/dev/null; then
        chmod +x "$cache/tcl-mcp" && exec "$cache/tcl-mcp" "$@"
    fi
    echo "tcl-mcp: could not fetch prebuilt $asset; building from source…" >&2
fi

# 4. Last resort: build from source (needs cargo).
echo "tcl-mcp: building release from source (one-time; run 'make rust-mcp' to prebuild)…" >&2
cargo build --release -p tcl-mcp --manifest-path "$root/Cargo.toml" 1>&2
exec "$root/target/release/tcl-mcp" "$@"
