        synopsis {get_nodes ?-include_generated_clocks? ?-no_duplicates? ?-nocase? ?-nowarn? ?-of_clocks? ?filter?}
        description {Returns a collection; iterate it with foreach_in_collection.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

