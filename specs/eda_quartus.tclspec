}

command get_timing_paths {
    dialects tcl8.5
    required_package quartus-sta

    form Default {get_timing_paths ?-from from_list? ?-to to_list? ?-through through_list? ?-setup | -hold? ?-npaths n? ?-nworst n? ?-less_than_slack slack? ?-pairs_only? ?-detail summary|path_only|path_and_clock|full_path?}

    hover {
        summary {Get a collection of timing paths.}
        synopsis {get_timing_paths ?-from from_list? ?-to to_list? ?-through through_list? ?-setup | -hold? ?-npaths n? ?-nworst n? ?-less_than_slack slack? ?-pairs_only? ?-detail summary|path_only|path_and_clock|full_path?}
        description {The programmatic sibling of report_timing: it takes the same rich filtering options, including the rise_/fall_ families, but hands back a Tcl collection for foreach_in_collection instead of printing a report. The standard way to walk timing paths from a script.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command get_top_level_entity {
    dialects tcl8.5
    required_package quartus-project

    form Default {get_top_level_entity}

    hover {
        summary {Get the name-id of the current focus or top-level entity.}
        synopsis {get_top_level_entity}
        description {The returned name-id is what get_name_info -info entity_name expects.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command import_sdc {
    dialects tcl8.5
    required_package quartus-sta

    form Default {import_sdc}

    hover {
        summary {Read SDC constraints from the synthesized database.}
        synopsis {import_sdc}
        description {Loads the constraints already stored in the database, with no file to name — the common alternative to read_sdc.}
        source {Quartus Prime Pro Tcl API reference}
