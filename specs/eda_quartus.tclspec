}

command get_device_names {
    dialects tcl8.5
    required_package quartus-device

    form Default {get_device_names -hardware_name hardware_name}

    hover {
        summary {List the devices on a JTAG chain.}
        synopsis {get_device_names -hardware_name hardware_name}
        description {-hardware_name is required and comes from get_hardware_names; the result feeds open_device -device_name. Really a member of ::quartus::jtag 1.0 — the pack files it under quartus-device because the Quartus dialect profile pins no quartus-jtag package.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command get_family_list {
    dialects tcl8.5
    required_package quartus-device

    form Default {get_family_list}

    hover {
        summary {Get all available device families.}
        synopsis {get_family_list}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command get_fanins {
    dialects tcl8.5
    required_package quartus-sdc-ext

    form Default {get_fanins ?-asynch? ?-clock? ?-inverting_paths? ?-no_logic? ?-non_inverting_paths? ?-stop_at_clocks? ?-synch? ?-through names? filter}

    hover {
        summary {Get a collection of nodes that fan in to the given nodes.}
        synopsis {get_fanins ?-asynch? ?-clock? ?-inverting_paths? ?-no_logic? ?-non_inverting_paths? ?-stop_at_clocks? ?-synch? ?-through names? filter}
        description {Returns a collection; iterate it with foreach_in_collection.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command get_fanouts {
    dialects tcl8.5
    required_package quartus-sdc-ext

    form Default {get_fanouts ?-asynch? ?-clock? ?-inverting_paths? ?-no_logic? ?-non_inverting_paths? ?-stop_at_clocks? ?-synch? ?-through names? filter}

    hover {
        summary {Get a collection of nodes that fan out from the given nodes.}
        synopsis {get_fanouts ?-asynch? ?-clock? ?-inverting_paths? ?-no_logic? ?-non_inverting_paths? ?-stop_at_clocks? ?-synch? ?-through names? filter}
        description {Returns a collection; iterate it with foreach_in_collection.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command get_global_assignment {
    dialects tcl8.5
    required_package quartus-project

    form Default {get_global_assignment -name name ?-section_id id? ?-front? ?-fall? ?-rise?}

    hover {
        summary {Get a global project assignment value.}
        synopsis {get_global_assignment -name name ?-section_id id? ?-front? ?-fall? ?-rise?}
        source {F5}
    }
}

command get_hardware_names {
    dialects tcl8.5
    required_package quartus-device

    form Default {get_hardware_names}

    hover {
        summary {List the attached JTAG programming hardware.}
        synopsis {get_hardware_names}
        description {Each name is a type and optional port, for example USB-Blaster [USB-0]; the result feeds open_device -hardware_name and get_device_names -hardware_name. Really a member of ::quartus::jtag 1.0 — the pack files it under quartus-device because the Quartus dialect profile pins no quartus-jtag package.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command get_instance_assignment {
    dialects tcl8.5
    required_package quartus-project

    form Default {get_instance_assignment -name name ?-to to? ?-from from? ?-entity entity? ?-section_id id? ?-tag data? ?-front? ?-fall? ?-rise?}

    hover {
        summary {Get an instance assignment value.}
        synopsis {get_instance_assignment -name name ?-to to? ?-from from? ?-entity entity? ?-section_id id? ?-tag data? ?-front? ?-fall? ?-rise?}
        source {F5}
