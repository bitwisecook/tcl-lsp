command report_path {
    dialects tcl8.5
    required_package quartus-sta

    form Default {report_path ?-from names? ?-fall_from names? ?-fall_through names? ?-fall_to names? ?-npaths n? ?-nworst n? ?-min_path? ?-list_clocks? ?-logic_depth? ?-pairs_only? ?-panel_name name? ?-file name? ?-append?}

    hover {
        summary {Report the delay of paths between two points.}
        synopsis {report_path ?-from names? ?-fall_from names? ?-fall_through names? ?-fall_to names? ?-npaths n? ?-nworst n? ?-min_path? ?-list_clocks? ?-logic_depth? ?-pairs_only? ?-panel_name name? ?-file name? ?-append?}
        description {A detailed path report that, unlike report_timing, does not require the endpoints to be clocked. The reference's option list continues past the options modelled here, in the same rise_/fall_ and -to/-through families report_timing uses.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command report_timing {
    dialects tcl8.5
    required_package quartus-sta

    form Default {report_timing ?-from from_list? ?-to to_list? ?-through through_list? ?-from_clock clocks? ?-to_clock clocks? ?-rise_from names? ?-fall_from names? ?-rise_through names? ?-fall_through names? ?-rise_to names? ?-fall_to names? ?-rise_from_clock clocks? ?-fall_from_clock clocks? ?-rise_to_clock clocks? ?-fall_to_clock clocks? ?-setup | -hold | -recovery | -removal? ?-npaths n? ?-nworst n? ?-less_than_slack slack? ?-detail summary|path_only|path_and_clock|full_path? ?-extra_info basic|all|none? ?-asynch_clock? ?-inter_clock? ?-intra_clock? ?-data_delay? ?-false_path? ?-pairs_only? ?-show_routing? ?-split_by_corner? ?-panel_name name? ?-file file? ?-append? ?-stdout?}

    hover {
        summary {Report timing paths.}
        synopsis {report_timing ?-from from_list? ?-to to_list? ?-through through_list? ?-from_clock clocks? ?-to_clock clocks? ?-rise_from names? ?-fall_from names? ?-rise_through names? ?-fall_through names? ?-rise_to names? ?-fall_to names? ?-rise_from_clock clocks? ?-fall_from_clock clocks? ?-rise_to_clock clocks? ?-fall_to_clock clocks? ?-setup | -hold | -recovery | -removal? ?-npaths n? ?-nworst n? ?-less_than_slack slack? ?-detail summary|path_only|path_and_clock|full_path? ?-extra_info basic|all|none? ?-asynch_clock? ?-inter_clock? ?-intra_clock? ?-data_delay? ?-false_path? ?-pairs_only? ?-show_routing? ?-split_by_corner? ?-panel_name name? ?-file file? ?-append? ?-stdout?}
        description {-detail and -extra_info are enum-valued: summary, path_only, path_and_clock or full_path, and basic, all or none. Use get_timing_paths for the same query as a collection instead of a printed report.}
        source {F5}
    }
}

