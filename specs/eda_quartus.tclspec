    hover {
        summary {Read SDC constraint file for TimeQuest.}
        synopsis {read_sdc ?-hdl? ?-instance instance_name? ?-no_import? ?-no_sdc_promotion? ?-post_fit | -post_syn? ?-project_relative? ?file_name?}
        description {-echo does not exist in the current syntax. file_name is optional: with no arguments the command loads the default SDC files plus the HDL-embedded constraints.}
        source {F5}
    }
}

command remove_all_assignments {
    dialects tcl8.5
    required_package quartus-project

    form Default {remove_all_assignments ?-name name? ?-to to? ?-entity entity? ?-type type? ?-section_id id?}

    hover {
        summary {Legacy: remove all assignments matching criteria.}
        synopsis {remove_all_assignments ?-name name? ?-to to? ?-entity entity? ?-type type? ?-section_id id?}
        description {Split by type in current ::quartus::project 7.0: use remove_all_global_assignments, remove_all_instance_assignments or remove_all_parameters instead — there is no single successor to name.}
        source {F5}
    }
}

command remove_all_global_assignments {
    dialects tcl8.5
    required_package quartus-project

    form Default {remove_all_global_assignments -name name ?-entity entity? ?-section_id id? ?-tag data? ?-fall? ?-rise?}

    hover {
        summary {Remove every global assignment matching criteria.}
        synopsis {remove_all_global_assignments -name name ?-entity entity? ?-section_id id? ?-tag data? ?-fall? ?-rise?}
        description {One of the three type-specific commands that replaced remove_all_assignments. -name is required.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command remove_all_instance_assignments {
    dialects tcl8.5
    required_package quartus-project

    form Default {remove_all_instance_assignments -name name ?-entity entity? ?-section_id id? ?-tag data? ?-fall? ?-rise?}

    hover {
        summary {Remove every instance assignment matching criteria.}
        synopsis {remove_all_instance_assignments -name name ?-entity entity? ?-section_id id? ?-tag data? ?-fall? ?-rise?}
        description {One of the three type-specific commands that replaced remove_all_assignments. -name is required.}
