    }
}

command remove_all_parameters {
    dialects tcl8.5
    required_package quartus-project

    form Default {remove_all_parameters -name name ?-entity entity? ?-section_id id? ?-tag data? ?-fall? ?-rise?}

    hover {
        summary {Remove every parameter assignment matching criteria.}
        synopsis {remove_all_parameters -name name ?-entity entity? ?-section_id id? ?-tag data? ?-fall? ?-rise?}
        description {One of the three type-specific commands that replaced remove_all_assignments. -name is required.}
