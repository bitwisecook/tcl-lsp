}

command is_database_version_compatible {
    dialects tcl8.5
    required_package quartus-project

    form Default {is_database_version_compatible}

    hover {
        summary {Check whether the project database version is compatible.}
        synopsis {is_database_version_compatible}
        description {The guard to run before project_open -force on a database written by another Quartus version. The reference records the command's presence and purpose; its option list is not modelled here.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command is_project_open {
    dialects tcl8.5
    required_package quartus-project

    form Default {is_project_open}

    hover {
        summary {Check whether a project is currently open.}
        synopsis {is_project_open}
        description {Returns 1 or 0; the idiomatic guard before project_close.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command load_package {
