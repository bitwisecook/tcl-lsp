}

command remove_connection {
    dialects tcl8.5
    required_package quartus-project

    form Default {remove_connection ?-from output_net_name? ?-from_node from_node? ?-from_port from_port? ?-to dest_node_name? ?-to_node to_node? ?-to_port to_port? ?-port dest_node_port?}

    hover {
        summary {Remove a connection in an ECO change.}
        synopsis {remove_connection ?-from output_net_name? ?-from_node from_node? ?-from_port from_port? ?-to dest_node_name? ?-to_node to_node? ?-to_port to_port? ?-port dest_node_port?}
        description {Same shape as make_connection minus -tieoff, and every argument is optional. Really a member of ::quartus::eco 1.0, not ::quartus::project; the pack keeps quartus-project because the Quartus dialect profile pins no quartus-eco package.}
        source {F5}
    }
}

command rename_node {
    dialects tcl8.5
    required_package quartus-project

    form Default {rename_node -from old_name -to new_name}

    hover {
        summary {Legacy: rename a node in an ECO change.}
        synopsis {rename_node -from old_name -to new_name}
        description {Not in the current ::quartus::project 7.0 index, and not in ::quartus::eco 1.0 either — the package that owns the sibling ECO node commands create_new_node, remove_node, place_node, unplace_node and modify_lutmask. No documented successor under any package or name.}
        source {F5}
    }
}

