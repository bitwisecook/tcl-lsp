    required_package quartus-flow

    form Default {write_flow_assignment_digest}

    hover {
        summary {Write a digest of the flow assignments.}
        synopsis {write_flow_assignment_digest}
        description {The digest is what later runs compare against to detect stale incremental-compile state. The reference records the command's presence and purpose; its option list is not modelled here.}
