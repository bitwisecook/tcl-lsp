# tcl-lsp — bundled SpecTcl loadable: the Intel/Altera Quartus tool commands.
#
# This pack IS the source of truth for these commands. The Rust modules that
# used to hold them (rust/tcl-registry/src/commands/eda_quartus/) were deleted when
# the EDA vendor libraries migrated to bundled `.tclspec` loadables, per
# docs/design/spec-packs.md ("the EDA vendor libraries ship as bundled
# `.tclspec` loadables … so the loader path is exercised in production from day
# one rather than reserved for private packs"). Every command was proved
# field-for-field equal to its compiled spec by the SpecTcl round-trip gate
# before the modules were removed.
#
# Discovery: the **bundled** tier — `specs/` beside the server executable, or
# wherever $TCL_LSP_SPEC_PACK_DIR points (rust/tcl-spectcl/src/discovery.rs).
# Edit this file to change the specs; there is no generator to re-run.
# Syntax: docs/design/spec-dsl-examples/README.md. The initial text was written
# by the spec studio's SpecTcl renderer (rust/tcl-spec-studio/src/render_spectcl.rs)
# from the registry modules, which reported no unwritable field on any command
# here; this file is hand-maintained from now on.
#
# ── 2026-08 refresh, against the Quartus Prime Pro Edition Tcl API reference
# (Quartus Prime Pro Edition Help 26.1.1, dated 2026-08-07, the per-command
# `tcl_pkg_*_cmd_*.htm` pages). Blocks written or re-derived from it carry
# `source {Quartus Prime Pro Tcl API reference}`; blocks whose text still comes
# from the original registry modules keep their `source {F5}`.
#
#   * Commands the current reference no longer documents are kept — real
#     scripts and old flows still carry them — with a `Legacy:` summary and,
#     where the reference names a single direct successor, a
#     `deprecated_replacement`. Where the successor is a *split* (three
#     commands, not one) the successors are named in the description instead.
#   * Two package attributions in the reference have no home in this profile:
#     `::quartus::jtag 1.0` (close_device, device_lock, device_unlock,
#     open_device, get_hardware_names, get_device_names) and `::quartus::eco
#     1.0` (make_connection, remove_connection). rust/tcl-dialect/src/profile.rs
#     pins only quartus-project/flow/sta/sdc-ext/report/device/misc for the
#     `intel-quartus-eda-tcl` profile, so those commands keep the nearest
#     shipped `required_package` and state their true package in the hover
#     description. Adding `quartus-jtag` / `quartus-eco` to the profile is the
#     real fix and is deliberately left to a profile change.
#   * `execute_flow` carries both flag sets: Pro Edition's current one and the
#     Standard Edition (frozen at 18.1) one users still write. The description
#     says which is which.

speclib eda_quartus 1.1 {

command check_timing {
    dialects tcl8.5
    required_package quartus-sta

    form Default {check_timing ?-append? ?-file name? ?-include check_list? ?-panel_name name? ?-stdout?}

    hover {
        summary {Check for timing analysis issues.}
        synopsis {check_timing ?-append? ?-file name? ?-include check_list? ?-panel_name name? ?-stdout?}
        description {Must be preceded by update_timing_netlist. -include takes a list of check names rather than a closed enum — no_clock, multiple_clock, generated_clock, no_input_delay, no_output_delay, partial_input_delay, partial_output_delay, io_min_max_delay_consistency and others.}
        source {F5}
    }
}

command close_device {
    dialects tcl8.5
    required_package quartus-device

    form Default {close_device}

    hover {
        summary {Close the active JTAG device.}
        synopsis {close_device}
        description {Really a member of ::quartus::jtag 1.0, not ::quartus::device — ::quartus::device holds only the part/family query commands. The pack keeps quartus-device because the Quartus dialect profile pins no quartus-jtag package to attribute it to.}
        source {F5}
    }
}

command create_timing_netlist {
    dialects tcl8.5
    required_package quartus-sta

    form Default {create_timing_netlist ?-model fast|slow? ?-post_syn? ?-grade c|i|m|e|a? ?-speed speed? ?-temperature degC? ?-voltage mV? ?-snapshot snapshot? ?-force_dat? ?-no_latch? ?-zero_ic_delays? ?operating_conditions?}

    hover {
        summary {Create a timing netlist for analysis.}
        synopsis {create_timing_netlist ?-model fast|slow? ?-post_syn? ?-grade c|i|m|e|a? ?-speed speed? ?-temperature degC? ?-voltage mV? ?-snapshot snapshot? ?-force_dat? ?-no_latch? ?-zero_ic_delays? ?operating_conditions?}
        description {-post_map no longer exists and there is no -post_fit either: the command already annotates the atom netlist with post-fitting results by default, and -post_syn selects the post-synthesis netlist instead. To change operating corner, prefer set_operating_conditions over deleting and recreating the netlist.}
        source {F5}
    }
}

command delete_timing_netlist {
    dialects tcl8.5
    required_package quartus-sta

    form Default {delete_timing_netlist}

    hover {
        summary {Delete the current timing netlist.}
        synopsis {delete_timing_netlist}
        source {F5}
    }
}

command derive_clock_uncertainty {
    dialects tcl8.5
    required_package quartus-sdc-ext

    form Default {derive_clock_uncertainty ?-add? ?-overwrite?}

    hover {
        summary {Derive and apply clock uncertainty from the timing model.}
        synopsis {derive_clock_uncertainty ?-add? ?-overwrite?}
        description {Calculates inter-clock, intra-clock and I/O interface uncertainty from the device timing-model characterization and applies it to the design. One of the SDC macros write_sdc -expand inlines.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command derive_clocks {
    dialects tcl8.5
    required_package quartus-sdc-ext

    form Default {derive_clocks ?-period period?}

    hover {
        summary {Legacy: automatically derive clocks from the design.}
        synopsis {derive_clocks ?-period period?}
        description {Not a member of ::quartus::sdc_ext 2.0 any more and no longer individually documented in Pro Edition; it survives only as one of the SDC-file macros write_sdc -expand inlines. derive_pll_clocks and derive_clock_uncertainty are the derive_* commands that still have their own reference pages. No single documented successor.}
        source {F5}
    }
}

command derive_pll_clocks {
    dialects tcl8.5
    required_package quartus-sdc-ext

    form Default {derive_pll_clocks ?-create_base_clocks? ?-use_net_name?}

    hover {
        summary {Automatically derive PLL output clocks.}
        synopsis {derive_pll_clocks ?-create_base_clocks? ?-use_net_name?}
        description {No longer supported for Stratix 10 and later families: only Arria 10 and Cyclone 10 GX still honour it. On every other device the Timing Analyzer auto-derives PLL clocks from the constraints bound to the related IP.}
        source {F5}
    }
}

command device_lock {
    dialects tcl8.5
    required_package quartus-device

    form Default {device_lock -timeout milliseconds}

    hover {
        summary {Lock a JTAG device for exclusive access.}
        synopsis {device_lock -timeout milliseconds}
        description {-timeout is required, and its value is the time to wait for access to the device in milliseconds, not seconds. Really a member of ::quartus::jtag 1.0, not ::quartus::device; the pack keeps quartus-device because the Quartus dialect profile pins no quartus-jtag package.}
        source {F5}
    }
}

command device_unlock {
    dialects tcl8.5
    required_package quartus-device

    form Default {device_unlock}

    hover {
        summary {Unlock a previously locked JTAG device.}
        synopsis {device_unlock}
        description {Really a member of ::quartus::jtag 1.0, not ::quartus::device; the pack keeps quartus-device because the Quartus dialect profile pins no quartus-jtag package.}
        source {F5}
    }
}

command download_device_file {
    dialects tcl8.5
    required_package quartus-flow

    form Default {download_device_file -file file}

    hover {
        summary {Populate device/devdata with a device file.}
        synopsis {download_device_file -file file}
        description {The file path is relative to the user's acds directory. Used to stage device data a flow needs before execute_flow runs.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command execute_assignment_batch {
    dialects tcl8.5
    required_package quartus-project

    form Default {execute_assignment_batch}

    hover {
        summary {Batch a set of assignment operations.}
        synopsis {execute_assignment_batch}
        description {Groups multiple assignment operations so a large scripted flow pays the assignment-database cost once instead of per call. The reference records the command's presence and purpose; its option list is not modelled here.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command execute_flow {
    dialects tcl8.5
    required_package quartus-flow

    form Default {execute_flow -compile | -export_database | -analysis_and_elaboration | -check_ios | -check_netlist | -design_analysis | -finalize | -implement | -import_database | -incremental_compilation_export | -incremental_compilation_import | -ip_upgrade | -quick_elaboration | -signalprobe | -simulation | -analysis_and_synthesis | -fitter | -assembler | -timing_analyzer | -eda_netlist_writer | -signaltap ?-dni? ?-eco value? ?-flow_args name_value_list? ?-dont_export_assignments?}

    hover {
        summary {Execute a Quartus compilation flow.}
        synopsis {execute_flow -compile | -export_database | -analysis_and_elaboration | -check_ios | -check_netlist | -design_analysis | -finalize | -implement | -import_database | -incremental_compilation_export | -incremental_compilation_import | -ip_upgrade | -quick_elaboration | -signalprobe | -simulation | -analysis_and_synthesis | -fitter | -assembler | -timing_analyzer | -eda_netlist_writer | -signaltap ?-dni? ?-eco value? ?-flow_args name_value_list? ?-dont_export_assignments?}
        description {Exactly one flow flag per call — you can run only one flow at a time. -compile and -export_database are accepted by both editions. -analysis_and_elaboration, -check_ios, -check_netlist, -design_analysis, -finalize, -implement, -import_database, -incremental_compilation_export, -incremental_compilation_import, -ip_upgrade, -quick_elaboration, -signalprobe and -simulation are the current Pro Edition set of ::quartus::flow 1.1, as are the -dni, -eco, -flow_args and -dont_export_assignments modifiers. -analysis_and_synthesis, -fitter, -assembler, -timing_analyzer, -eda_netlist_writer and -signaltap are absent from current Pro Edition docs; they are the Standard Edition spelling, whose scripting guide is frozen at version 18.1. The nearest Pro equivalents are -analysis_and_elaboration for -analysis_and_synthesis, -implement for -fitter, -finalize for -assembler and -signalprobe for -signaltap; the reference does not document a rename, so both sets are kept.}
        source {F5}
    }
}

command execute_module {
    dialects tcl8.5
    required_package quartus-flow

    form Default {execute_module -tool asm|cdb|eda|fit|map|syn|pow|sta|stp|sim|si|cpf|ipg|pfg|qtlg|quick_elaboration|sh ?-args arg_list? ?-classic? ?-dni? ?-dont_export_assignments?}

    hover {
        summary {Execute a specific Quartus module.}
        synopsis {execute_module -tool asm|cdb|eda|fit|map|syn|pow|sta|stp|sim|si|cpf|ipg|pfg|qtlg|quick_elaboration|sh ?-args arg_list? ?-classic? ?-dni? ?-dont_export_assignments?}
        description {-tool is required and takes one of the executable names above. -classic selects the Classic-mode flow and -dni the DNI-mode tool.}
        source {F5}
    }
}

command export_assignments {
    dialects tcl8.5
    required_package quartus-project

    form Default {export_assignments ?-reorganize? ?-report_write_failure?}

    hover {
        summary {Export assignments to the .qsf file.}
        synopsis {export_assignments ?-reorganize? ?-report_write_failure?}
        source {F5}
    }
}

command get_all_assignments {
    dialects tcl8.5
    required_package quartus-project

    form Default {get_all_assignments -name name -type global|instance|parameter|default ?-to to? ?-from from? ?-entity entity? ?-section_id id? ?-tag data? ?-fall? ?-rise?}

    hover {
        summary {Get all assignments matching criteria.}
        synopsis {get_all_assignments -name name -type global|instance|parameter|default ?-to to? ?-from from? ?-entity entity? ?-section_id id? ?-tag data? ?-fall? ?-rise?}
        description {-name and -type are both required; -type is a four-way enum. Returns a collection, so iterate it with foreach_in_collection.}
        source {F5}
    }
}

command get_available_operating_conditions {
    dialects tcl8.5
    required_package quartus-sta

    form Default {get_available_operating_conditions ?-all? ?-compile?}

    hover {
        summary {List the operating conditions available for analysis.}
        synopsis {get_available_operating_conditions ?-all? ?-compile?}
        description {Enumerates the corners that set_operating_conditions will accept for the current device and timing netlist.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command get_current_project {
    dialects tcl8.5
    required_package quartus-project

    form Default {get_current_project}

    hover {
        summary {Get the name of the currently open project.}
        synopsis {get_current_project}
        source {Quartus Prime Pro Tcl API reference}
    }
}

command get_current_revision {
    dialects tcl8.5
    required_package quartus-project

    form Default {get_current_revision ?project_name?}

    hover {
        summary {Get the current revision name of a project.}
        synopsis {get_current_revision ?project_name?}
        description {Defaults to the open project when project_name is omitted.}
        source {Quartus Prime Pro Tcl API reference}
