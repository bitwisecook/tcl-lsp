}

command get_io_assignment {
    dialects tcl8.5
    required_package quartus-project

    form Default {get_io_assignment -name name -to pin_name}

    hover {
        summary {Legacy: get an I/O assignment value.}
        synopsis {get_io_assignment -name name -to pin_name}
        description {Not in the current ::quartus::project 7.0 command index — set_io_assignment survives but has no documented getter counterpart any more. get_instance_assignment is the closest surviving read path for pin-level assignments.}
        source {F5}
    }
}

command get_name_info {
    dialects tcl8.5
    required_package quartus-project

    form Default {get_name_info -info info_type name_id}

