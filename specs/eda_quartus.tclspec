command make_connection {
    dialects tcl8.5
    required_package quartus-project

    form Default {make_connection ?-from output_net_name? ?-from_node from_node? ?-from_port from_port? ?-to dest_node_name? ?-to_node to_node? ?-to_port to_port? ?-port dest_node_port? ?-tieoff VCC|GND?}

    hover {
        summary {Make a connection in an ECO change.}
        synopsis {make_connection ?-from output_net_name? ?-from_node from_node? ?-from_port from_port? ?-to dest_node_name? ?-to_node to_node? ?-to_port to_port? ?-port dest_node_port? ?-tieoff VCC|GND?}
        description {Every argument is optional, and -tieoff drives the destination port to VCC or GND instead of a source net. Really a member of ::quartus::eco 1.0, not ::quartus::project; the pack keeps quartus-project because the Quartus dialect profile pins no quartus-eco package.}
        source {F5}
    }
}

command open_device {
