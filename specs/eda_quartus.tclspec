command get_part_info {
    dialects tcl8.5
    required_package quartus-device

    form Default {get_part_info ?-default_voltage? ?-device? ?-device_group? ?-family? ?-family_variant? ?-fast_grade_revision? ?-grade_revision? ?-hssi_speed_grade? ?-iobank_revision? ?-package? ?-pdn_model_status? ?-pin_count? ?-pof_id? ?-power_model? ?-power_model_status? ?-rohs_grade? ?-sip_tile? ?-speed_grade? ?-subdevice_id_code? ?-subdevice_id_mask? ?-temperature_grade? part_name}

    hover {
        summary {Get information about a specific FPGA part.}
        synopsis {get_part_info ?-default_voltage? ?-device? ?-device_group? ?-family? ?-family_variant? ?-fast_grade_revision? ?-grade_revision? ?-hssi_speed_grade? ?-iobank_revision? ?-package? ?-pdn_model_status? ?-pin_count? ?-pof_id? ?-power_model? ?-power_model_status? ?-rohs_grade? ?-sip_tile? ?-speed_grade? ?-subdevice_id_code? ?-subdevice_id_mask? ?-temperature_grade? part_name}
        description {-available_pin_count does not exist in the current option list; -family, -speed_grade, -package and -pin_count are still spelled as before.}
        source {F5}
    }
}

command get_part_list {
    dialects tcl8.5
    required_package quartus-device

    form Default {get_part_list ?-family family? ?-device device? ?-package package? ?-pin_count pin_count? ?-speed_grade speed_grade?}

    hover {
        summary {Get a list of available FPGA parts.}
        synopsis {get_part_list ?-family family? ?-device device? ?-package package? ?-pin_count pin_count? ?-speed_grade speed_grade?}
        source {F5}
    }
}

