command write_sdc {
    dialects tcl8.5
    arity 1..
    required_package quartus-sta

    form Default {write_sdc ?-expand? ?-history? ?-valid_exceptions? file_name}

    hover {
        summary {Write the current constraint set to an SDC file.}
        synopsis {write_sdc ?-expand? ?-history? ?-valid_exceptions? file_name}
        description {-expand inlines the SDC macros — derive_clocks, derive_pll_clocks, derive_lvds_clocks and derive_clock_uncertainty — before writing, so the output is a flat constraint set.}
        source {Quartus Prime Pro Tcl API reference}
    }
}

}
