        synopsis {open_device -hardware_name name -device_name name}
        description {Both flags are required. Get their values from get_hardware_names and get_device_names. Really a member of ::quartus::jtag 1.0, not ::quartus::device; the pack keeps quartus-device because the Quartus dialect profile pins no quartus-jtag package.}
        source {F5}
    }
}

command post_message {
