}

command set_parameter {
    dialects tcl8.5
    required_package quartus-project

    form Default {set_parameter -name name ?-comment comment? ?-tag data? ?-disable? ?-remove? ?-fall? ?-rise? ?value?}

    hover {
        summary {Set a parameter on the top-level entity.}
        synopsis {set_parameter -name name ?-comment comment? ?-tag data? ?-disable? ?-remove? ?-fall? ?-rise? ?value?}
        description {-to and -entity are no longer in the syntax: assignments that use them are ignored and raise a critical warning. set_parameter is now project-wide, overwriting the parameters of the design's top-level entity.}
        source {F5}
    }
}

