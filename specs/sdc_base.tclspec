command set_clock_sense {
    dialects all-tcl
    arity 1..
    required_package sdc
    deprecated_replacement set_sense

    form Default {set_clock_sense ?-positive? ?-negative? ?-pulse pulse_type? ?-stop_propagation? ?-clocks clock_list? pin_list}

    hover {
        summary {Legacy: set the sense of a clock path at a pin.}
        synopsis {set_clock_sense ?-positive? ?-negative? ?-pulse pulse_type? ?-stop_propagation? ?-clocks clock_list? pin_list}
        description {SDC 2.0 folded this command into set_sense -type clock; new constraint files should use set_sense. -pulse takes one of rise_triggered_high_pulse, rise_triggered_low_pulse, fall_triggered_high_pulse or fall_triggered_low_pulse.}
        source {SDC 2.2}
    }
}

