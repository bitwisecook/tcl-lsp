    hover {
        summary {Return all register cells.}
        synopsis {all_registers ?-no_hierarchy? ?-hsc separator? ?-clock clock_name? ?-rise_clock clock_name? ?-fall_clock clock_name? ?-cells? ?-data_pins? ?-clock_pins? ?-slave_clock_pins? ?-async_pins? ?-output_pins? ?-level_sensitive? ?-edge_triggered? ?-master_slave?}
