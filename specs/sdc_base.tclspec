command foreach_in_collection {
    dialects all-tcl
    traits {CONTROL_FLOW HAS_LOOP_BODY NEVER_INLINE_BODY LOOP_LIST_HEADER}
    arity 3
    required_package sdc

    arg 0 -role VarWrite
    arg 2 -role Body

    analyser_hook -native Foreach

    form Default {foreach_in_collection var collection body}

    hover {
        summary {Iterate over objects in a collection.}
        synopsis {foreach_in_collection var collection body}
        source {F5}
    }
}

