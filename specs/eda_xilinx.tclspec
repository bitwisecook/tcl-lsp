command register_drc_rule {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -category -takes category \
           -detail {The grouping for the rule, used as the first level of hierarchy in the GUI when listing DRC rules, defaulting to User Defined.}
    option -name -takes name \
           -detail {The unique abbreviation for the rule in the violation library, matching the abbreviation given to create_violation (required).}
    option -desc -takes description \
           -detail {A brief description of the rule, displayed in the GUI and used in the DRC report and summary.}
    option -msg -takes message \
           -detail {The message displayed when a violation of the rule is found, which may include the substitution keys %MSG_STRING, %NETLIST_ELEMENT, %SITE_GROUP, %CLOCK_REGION, and %BANK.}
    option -checker -takes checker \
           -detail {The name of the Tcl procedure that defines the rule checking functionality; a single abbreviation can have multiple checkers.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {register_drc_rule ?-category category? -name name ?-desc description? ?-msg message? ?-checker checker? ?-quiet? ?-verbose?}

    hover {
        summary {Register a user defined DRC rule.}
        synopsis {register_drc_rule ?-category category? -name name ?-desc description? ?-msg message? ?-checker checker? ?-quiet? ?-verbose?}
        description {Registers a new user-defined DRC rule into the violation library for use by the tool. The Tcl checker procedure performs the actions of the design rule check, validating design objects and flagging any violations with the create_violation command, and must be separately defined, for instance by loading it with source. User-defined rules are enabled or disabled for use with report_drc through the manage_user_drc_rule command.}
        returns {Nothing.}
        example {register_drc_rule -name NETV -msg {%Msg_String. For %NETLIST_ELEMENT net.} \
   -checker net_check}
        source {Xilinx UG835 2012.2}
    }
}
command reimport_files {
