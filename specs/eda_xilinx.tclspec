        description {Creates a new transaction-level modeling (TLM) port with the given name in the current IP integrator subsystem design.}
        returns {The newly created TLM port object, or nothing if the command fails.}
        source {Xilinx UG835 2026.1}
    }
}
command create_cell {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -reference -takes reference \
           -detail {The library cell or source file module referenced by the new cell instances (required).}
    option -black_box \
           -detail {Define a black box instance of the specified reference cell, for a top-down flow where the reference cell does not exist yet.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_cell -reference reference ?-black_box? ?-quiet? ?-verbose? cells}

    hover {
        summary {Create cells in the current design.}
        synopsis {create_cell -reference reference ?-black_box? ?-quiet? ?-verbose? cells}
        description {Adds cells to the netlist of the current Synthesized or Implemented design, at the top level or hierarchically within any module, referencing an existing library or design cell or a black box that has not been created yet. Netlist editing changes the in-memory view of the netlist only, is not allowed on the elaborated RTL design, and cells cannot be added to library macros or macro-primitives.}
        returns {The name of the created cell instance or instances.}
        example {create_cell -reference or1200_cpu myCell1 myCell2 myCell3}
        source {Xilinx UG835 2026.1}
    }
}
command create_cluster_configuration {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -submit_cmd -takes submit_cmd \
           -detail {The command used to submit the job on the cluster (required).}
    option -kill_cmd -takes kill_cmd \
           -detail {The command used to kill the job on the cluster, which must take the job id as input (required).}
    option -monitor_cmd -takes monitor_cmd \
           -detail {The monitor command of the cluster configuration.}
    option -job_id_proc -takes job_id_proc -detail {Name of the proc used to parse the job id.}
    option -job_id_tcl -takes job_id_tcl -detail {Path to the Tcl file containing the job id proc.}
    option -type -takes type -values {LSF SGE SLURM CUSTOM} -closed \
           -detail {The cluster type: Load Sharing Facility, Sun Grid Engine, Simple Linux Utility For Resource Management, or CUSTOM for an unsupported cluster type (required).}
    option -force -detail {Force overwriting of a cluster configuration that already exists.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_cluster_configuration -submit_cmd submit_cmd -kill_cmd kill_cmd ?-monitor_cmd monitor_cmd? ?-job_id_proc job_id_proc? ?-job_id_tcl job_id_tcl? -type type ?-force? ?-quiet? ?-verbose? name}

    hover {
        summary {Create a cluster configuration.}
        synopsis {create_cluster_configuration -submit_cmd submit_cmd -kill_cmd kill_cmd ?-monitor_cmd monitor_cmd? ?-job_id_proc job_id_proc? ?-job_id_tcl job_id_tcl? -type type ?-force? ?-quiet? ?-verbose? name}
        description {Creates a cluster configuration used for launching synthesis and implementation runs, defined by its name, submit command, kill command, and type. Configurations are persisted in the Vivado tool settings, so a configuration is created once and reused; names must be unique and can be listed with get_cluster_configurations. The CUSTOM type is an experimental feature for cluster types Vivado does not support and is not thoroughly validated.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command create_dashboard_gadget {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name -detail {The name of the gadget to create (required).}
    option -type -takes type -values {DRC Methodology Power Timing Utilization} \
           -detail {The type of dashboard gadget to create (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_dashboard_gadget -name name -type type ?-quiet? ?-verbose?}

    hover {
        summary {Create a gadget for the project summary dashboard.}
        synopsis {create_dashboard_gadget -name name -type type ?-quiet? ?-verbose?}
        description {Creates a new gadget for a dashboard such as the Project Summary, letting different aspects of a synthesized or implemented run be viewed: timing information, resource utilization, DRC and methodology violations, and power analysis. A gadget carries properties such as TYPE, ROW, COL, REPORTS, RUN.STEP, VIEW.TYPE, and ORIENTATION that are set with set_property; this command is primarily intended to be used from the Vivado IDE with the Add Gadget command.}
        returns {Nothing.}
        example {create_dashboard_gadget -name gadget_power -type power}
        source {Xilinx UG835 2026.1}
    }
}
command create_dataflow_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {The name of the design to be created; a default name derived from the parent design name and the minimum bus width is used when omitted.}
    option -min_bus_width -takes min_bus_width \
           -detail {The minimum width of data buses kept in the dataflow design, 16 by default; increasing it likely results in a smaller netlist.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_dataflow_design ?-name name? ?-min_bus_width min_bus_width? ?-quiet? ?-verbose?}

    hover {
        summary {Create a new dataflow design.}
        synopsis {create_dataflow_design ?-name name? ?-min_bus_width min_bus_width? ?-quiet? ?-verbose?}
        description {Creates a dataflow design from a design loaded in memory and opens it in viewer mode, so the design cannot be edited and flow commands and most reporting commands cannot be run on it. The trimmed netlist drops single bit signals, buses narrower than the minimum bus width, all flops, most LUTs, and carry look-ahead elements while keeping wide buses, advanced primitives, LUTRAMs, BlockRAMs, URAMs, and AI Engine and DSP blocks. Cell objects in the dataflow design can be cross probed to the parent design by selecting them and switching designs with current_design.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command create_debug_core {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_debug_core ?-quiet? ?-verbose? name type}

    hover {
        summary {Create a new Integrated Logic Analyzer debug core.}
        synopsis {create_debug_core ?-quiet? ?-verbose? name type}
        description {Adds a new Integrated Logic Analyzer (ILA) debug core to an open netlist design in the current project; a debug core can only be added to an open netlist design. The core is created with a CLK port that defines its single clock domain and a PROBE port offering multiple channels for nets marked with the MARK_DEBUG property, so a separate core is needed per clock domain. Further ports are added with create_debug_port and signals attached with connect_debug_port.}
        returns {A new debug_core object.}
        example {open_run -name netlist_1 synth_1
create_debug_core myCore ila}
        source {Xilinx UG835 2026.1}
    }
}
command create_debug_port {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_debug_port ?-quiet? ?-verbose? name type}

    hover {
        summary {Create a new debug port.}
        synopsis {create_debug_port ?-quiet? ?-verbose? name type}
        description {Adds a new port to an existing ILA debug core created with create_debug_core, providing connection points for nets to debug. The supported port types are clk, probe, and the trigger pairs trig_in/trig_in_ack and trig_out/trig_out_ack; new ports default to a width of 1, and only probe ports can be widened with the PORT_WIDTH property.}
        returns {A new debug_port object.}
        example {create_debug_core myCore ila
create_debug_port myCore probe}
        source {Xilinx UG835 2026.1}
    }
}
command create_drc_check {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -hiername -takes hiername \
           -detail {A rule grouping used as the first level of hierarchy when listing DRC rules in the GUI, "User Defined" by default.}
    option -name -takes name \
           -detail {The unique name for the design rule, of the form PREFIX-id where the prefix is a 4 to 6 letter abbreviation and the id an integer, such as ABCD-23 (required).}
    option -desc -takes desc \
           -detail {A brief description of the rule shown in the GUI and used in the DRC report and summary.}
    option -msg -takes msg \
           -detail {The message displayed when a violation is found, which may include the substitution keys %MSG_STRING (%STR), %NETLIST_ELEMENT (%ELG), %SITE_GROUP (%SIG), %CLOCK_REGION (%CRG), %BANK (%PBG), and %BEL_GROUP.}
    option -rule_body -takes rule_body \
           -detail {The name of the Tcl procedure that implements the rule check, or a string of Tcl code to be evaluated (required).}
    ;# NOTE(xilinx): the severity literals are spelled inconsistently between the Usage
    ;# table (Error, Critical Warning, Warning, Advisory) and the Arguments prose
    ;# (ERROR, "CRITICAL WARNING", WARNING, ADVISORY), so no closed value set is given.
    option -severity -takes severity \
           -detail {The severity level of the rule being created: error, critical warning, warning, or advisory, defaulting to warning.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_drc_check ?-hiername hiername? -name name ?-desc desc? ?-msg msg? -rule_body rule_body ?-severity severity? ?-quiet? ?-verbose?}

    hover {
        summary {Create a user defined DRC rule.}
        synopsis {create_drc_check ?-hiername hiername? -name name ?-desc desc? ?-msg msg? -rule_body rule_body ?-severity severity? ?-quiet? ?-verbose?}
        description {Creates a user-defined DRC rule check for use by report_drc, naming the check, optionally grouping it into a hierarchy and describing it, defining a placeholder message, and pointing at the Tcl checker procedure to run. The checker proc uses create_drc_violation to flag violations, whose design objects are substituted into the placeholder message; the check is then added to a rule deck with add_drc_checks. An existing check of the same name must first be removed with delete_drc_check, and the IS_ENABLED property, TRUE at creation, controls whether the check runs.}
        returns {Nothing.}
        example {create_drc_check -name {RAMW-1} -hiername {RAMB} \
  -desc {Data Width Check} -rule_body dataWidthCheck -severity Advisory}
        source {Xilinx UG835 2026.1}
    }
}
command create_drc_ruledeck {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_drc_ruledeck ?-quiet? ?-verbose? ruledecks}

    hover {
        summary {Create one or more user defined DRC rule deck objects.}
        synopsis {create_drc_ruledeck ?-quiet? ?-verbose? ruledecks}
        description {Creates one or more user-defined rule decks for use when running report_drc, where a drc_ruledeck is a collection of design rule checks grouped for convenience to be run at different stages of the design flow. The created rule decks are empty; add checks with add_drc_checks and remove them with remove_drc_checks.}
        returns {The drc_ruledeck objects created.}
        example {create_drc_ruledeck my_rules project_rules}
        source {Xilinx UG835 2026.1}
    }
}
command create_drc_violation {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {The name of the design rule check associated with the violation, matching the -name of the create_drc_check that calls the checker procedure (required).}
    ;# NOTE(xilinx): the Usage table lists FATAL among the severities while the Arguments
    ;# prose does not, so no closed value set is given.
    option -severity -takes severity \
           -detail {The severity of the created violation, overriding the default severity of the rule check.}
    option -msg -takes msg \
           -detail {A violation specific message substituted for the general string variable (%STR) in the placeholder message defined by create_drc_check.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_drc_violation -name name ?-severity severity? ?-msg msg? ?-quiet? ?-verbose? ?objects?}

    hover {
        summary {Create a DRC violation.}
        synopsis {create_drc_violation -name name ?-severity severity? ?-msg msg? ?-quiet? ?-verbose? ?objects?}
        description {Creates a DRC violation object and manages the design objects associated with the violation for reporting by report_drc. It is called from the Tcl checker procedure named by the -rule_body of a create_drc_check, once per violation found. Cell, port, pin, net, clock region, site, and package I/O bank objects map to the substitution keys %ELG, %CRG, %SIG, and %PBG, and both their order and their type must match the -msg specification of the corresponding check.}
        returns {The created DRC violation object.}
        source {Xilinx UG835 2026.1}
    }
}
command create_fileset {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -constrset \
           -detail {Create the fileset as a constraints fileset, the default when no fileset type is given.}
    option -simset -detail {Create the fileset as a simulation source fileset.}
    option -blockset \
           -detail {Create the fileset as a block source fileset, configuring an IP core or hierarchical module for out-of-context design; requires -define_from.}
    option -clone_properties -takes fileset \
           -detail {Clone the properties of the specified fileset onto the newly created fileset.}
    ;# NOTE(xilinx): the Syntax line and Usage table show -define_from unbracketed, but the
    ;# Arguments prose marks it (Optional) and required only with -blockset, and the
    ;# section's own constraint-set examples omit it, so it is spelled optional here.
    option -define_from -takes module \
           -detail {The module in the source fileset to be the top of the blockset (required with -blockset).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-constrset -simset -blockset}

    form Default {create_fileset ?-constrset? ?-simset? ?-blockset? ?-clone_properties fileset? ?-define_from module? ?-quiet? ?-verbose? name}

    hover {
        summary {Create a new fileset.}
        synopsis {create_fileset ?-constrset? ?-simset? ?-blockset? ?-clone_properties fileset? ?-define_from module? ?-quiet? ?-verbose? name}
        description {Defines a new fileset within a design project, to which files can then be added with add_files. Only one fileset type option may be given, and a constraint set is created when none is specified. A blockset configures the IP core or hierarchical module named by -define_from as an out-of-context block, moving its files into the new fileset and defining out-of-context synthesis and implementation runs whose output products, including the DCP and any structural simulation netlists, are stored there.}
        returns {A new fileset object.}
        example {create_fileset -constrset -quiet constraints2}
        source {Xilinx UG835 2026.1}
    }
}
command create_gui_custom_command {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name -detail {Unique name of the command to create (required).}
    option -menu_name -takes menu_name -detail {Menu name for the custom command.}
    option -description -takes description \
           -detail {Text displayed as the description of the menu item and optionally the toolbar button.}
    option -show_on_toolbar -detail {Add this command to the toolbar.}
    option -run_proc -takes run_proc \
           -detail {Needed when both -command and -tcl_file are given: if TRUE the menu command runs the -command, otherwise it sources the -tcl_file script.}
    option -toolbar_icon -takes toolbar_icon \
           -detail {The full path to the PNG or JPEG file to display on the toolbar button.}
    option -command -takes command -detail {The command to be executed.}
    option -tcl_file -takes tcl_file -detail {The full path to the Tcl file to source.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_gui_custom_command -name name ?-menu_name menu_name? ?-description description? ?-show_on_toolbar? ?-run_proc run_proc? ?-toolbar_icon toolbar_icon? ?-command command? ?-tcl_file tcl_file? ?-quiet? ?-verbose?}

    hover {
        summary {Create a custom command in the GUI.}
        synopsis {create_gui_custom_command -name name ?-menu_name menu_name? ?-description description? ?-show_on_toolbar? ?-run_proc run_proc? ?-toolbar_icon toolbar_icon? ?-command command? ?-tcl_file tcl_file? ?-quiet? ?-verbose?}
        description {Creates a GUI menu item for a user custom command, appearing in the Tools then Custom Commands menu of the Vivado IDE. The command can also be shown on the toolbar, and clicking the button either executes the custom command or sources a Tcl file; get_gui_custom_commands lists the user-defined custom commands.}
        returns {Nothing.}
        example {create_gui_custom_command -name print_version -command "version" \
-description "Gets tool version" -show_on_toolbar}
        source {Xilinx UG835 2026.1}
    }
}
command create_gui_custom_command_arg {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -command_name -takes command_name \
           -detail {The name of the custom GUI command to create an argument for (required).}
    option -arg_name -takes arg_name \
           -detail {The unique name of the custom command argument to create (required).}
    option -default -takes default -detail {Default value of the custom command argument.}
    option -comment -takes comment -detail {Comment for the custom command argument.}
    option -optional -detail {Make the custom command argument optional.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_gui_custom_command_arg -command_name command_name -arg_name arg_name ?-default default? ?-comment comment? ?-optional? ?-quiet? ?-verbose?}

    hover {
        summary {Create a custom command argument for a custom command in the GUI.}
        synopsis {create_gui_custom_command_arg -command_name command_name -arg_name arg_name ?-default default? ?-comment comment? ?-optional? ?-quiet? ?-verbose?}
        description {Defines an argument for a specific custom GUI command created with create_gui_custom_command. Use get_gui_custom_commands to list the defined custom commands and get_gui_custom_command_args to list the arguments of one of them.}
        returns {Nothing.}
        example {create_gui_custom_command_arg -command_name print_version -arg_name quiet \
-default "-quiet" -comment "Ignore commands errors" -optional}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_axi_txn {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -address -takes address \
           -detail {The address of the register on the hw_axi object to read from or write into, address zero by default.}
    option -data -takes data \
           -detail {The data value in hexadecimal format to write into the address location for WRITE transactions, all zeroes by default.}
    option -size -takes size \
           -detail {Deprecated data word size in bits, now set automatically from the IP core properties.}
    ;# NOTE(xilinx): the Arguments prose spells the values READ and WRITE while the
    ;# section's own examples use read and write, so the set is not marked closed.
    option -type -takes type -values {READ WRITE} \
           -detail {Whether the AXI transaction reads from the specified address or writes into it (required).}
    option -len -takes len \
           -detail {The length of the transaction as a number of data words, 1 by default.}
    option -burst -takes burst -values {INCR FIXED WRAP} -closed \
           -detail {The type of AXI burst to perform, incremental (INCR) by default.}
    option -cache -takes cache \
           -detail {The AXI command cache to implement, specified in decimal form, 3 by default.}
    option -id -takes id \
           -detail {The ID to assign to the AXI transaction in decimal form, letting the tool identify responses to read and write transactions, 0 by default.}
    option -force \
           -detail {Overwrite an existing transaction with the specified name if it exists, otherwise create a new transaction.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_axi_txn ?-address address? ?-data data? ?-size size? -type type ?-len len? ?-burst burst? ?-cache cache? ?-id id? ?-force? ?-quiet? ?-verbose? name hw_axi}

    hover {
        summary {Create a hardware AXI transaction object.}
        synopsis {create_hw_axi_txn ?-address address? ?-data data? ?-size size? -type type ?-len len? ?-burst burst? ?-cache cache? ?-id id? ?-force? ?-quiet? ?-verbose? name hw_axi}
        description {Defines a read or write burst transaction for the JTAG to AXI Master core, the hw_axi object returned by get_hw_axis, which must be given as an object rather than by name. The transaction is stored as a property of the hw_axi object, waiting to be run with run_hw_axi and reported with report_hw_axi_txn.}
        returns {A new hardware AXI transaction object.}
        example {create_hw_axi_txn write_txn [get_hw_axis hw_axi_1] -type WRITE \
-len 4 -data {44444444_33333333_22222222_11111111}}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_bitstream {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -hw_device -takes hw_device \
           -detail {The hw_device object to associate the hw_bitstream object with, as returned by get_hw_devices or current_hw_device (required).}
    option -mask -takes mask \
           -detail {The mask file indicating which bits of the bitstream are compared to readback data, stored on the MASK property of the created object.}
    option -nky -takes nky \
           -detail {The encryption key file required for an encrypted bitstream, stored on the ENCRYPTION.FILE property with its key value on ENCRYPTION.KEY.}
    option -detect_partial \
           -detail {Detect a partial bitstream file created by write_bitstream -reference_bitfile, enabling incremental programming of the device.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_bitstream -hw_device hw_device ?-mask mask? ?-nky nky? ?-detect_partial? ?-quiet? ?-verbose? ?file?}

    hover {
        summary {Read a bitstream file into memory.}
        synopsis {create_hw_bitstream -hw_device hw_device ?-mask mask? ?-nky nky? ?-detect_partial? ?-quiet? ?-verbose? ?file?}
        description {Reads a bitstream file written by write_bitstream to create a hw_bitstream object and associate it with a hw_device in the Hardware Manager, setting the PROGRAM.HW_BITSTREAM and PROGRAM.FILE properties on the device. A hw_bitstream object is also created automatically by program_hw_devices, and the object created here can be removed with delete_hw_bitstream.}
        returns {The name of the hw_bitstream object created, or an error if it fails.}
        example {create_hw_bitstream -hw_device [current_hw_device] C:/Data/design1.bit}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_cfgmem {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -hw_device -takes hw_device \
           -detail {The hw_device object to associate the memory configuration device with, as returned by get_hw_devices or current_hw_device (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_cfgmem -hw_device hw_device ?-quiet? ?-verbose? mem_device}

    hover {
        summary {Read a configuration memory file into memory.}
        synopsis {create_hw_cfgmem -hw_device hw_device ?-quiet? ?-verbose? mem_device}
        description {Creates a hw_cfgmem object, describing a flash memory device used for configuring and booting an FPGA, and associates it with the specified hw_device through the device's PROGRAM.HW_CFGMEM property. The memory must be given as a cfgmem_part object from get_cfgmem_parts, whose COMPATIBLE_PARTS property identifies the devices it works with; once created it can be programmed with program_hw_cfgmem.}
        returns {The created hw_cfgmem object, or an error if it fails.}
        example {create_hw_cfgmem -hw_device [current_hw_device] [lindex $cfgParts 0 ]}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_device {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -idcode -takes idcode \
           -detail {The hexadecimal JTAG ID code for a user-defined device, not required for a Xilinx part.}
    option -idcode2 -takes idcode2 -detail {A second hexadecimal device ID code.}
    option -irlength -takes irlength \
           -detail {The decimal JTAG Instruction Register length for a user-defined device, not required for a Xilinx part.}
    option -mask -takes mask \
           -detail {The hexadecimal mask defining which bits of the device Data Register response are valid, not required for a Xilinx part.}
    option -part -takes part -detail {A Xilinx part for the device, or a user-defined part name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_device ?-idcode idcode? ?-idcode2 idcode2? ?-irlength irlength? ?-mask mask? ?-part part? ?-quiet? ?-verbose?}

    hover {
        summary {Create a hw_device (JTAG chain) on an open target.}
        synopsis {create_hw_device ?-idcode idcode? ?-idcode2 idcode2? ?-irlength irlength? ?-mask mask? ?-part part? ?-quiet? ?-verbose?}
        description {Creates a hw_device object on an open Serial Vector Format (SVF) target, adding it to the JTAG chain so it can be queried and programmed like other devices. Xilinx devices need only a recognized part number, while user-defined parts require the JTAG ID code, IR length, and mask and are added as space-holder devices that can be queried but not programmed. Create all devices defining the JTAG chain before performing any operation on it, or the chain referenced in the SVF file will be improperly defined.}
        returns {Nothing.}
        example {create_hw_device -part xc7k325t}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_probe {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -no_gui_update \
           -detail {Do not update the Vivado logic analyzer GUI to reflect the addition of the user-defined probe.}
    option -map -takes map \
           -detail {The physical probe port names and signal bits, and optionally constant values, to map into the new user-defined probe.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_probe ?-no_gui_update? ?-map map? ?-quiet? ?-verbose? name core}

    hover {
        summary {Create a hardware probe object.}
        synopsis {create_hw_probe ?-no_gui_update? ?-map map? ?-quiet? ?-verbose? name core}
        description {Creates a user-defined probe on the specified ILA core to define triggers and view data in the Vivado Logic Analyzer, combining specific bit values of existing probes; the probe name carries its width, as in probeName[0:3], which must match the number of bits mapped. Probes mapping bits of a single physical probe can trigger and view data, while probes combining bits from several physical probes can only view data; samples are reported with list_hw_samples and the probe removed with delete_hw_probe.}
        returns {A new hardware probe object.}
        example {create_hw_probe -map {0011 probe5[3:0] probe8 probe9} myProbeAR[9:0] hw_ila_1}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_sio_link {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -description -takes description \
           -detail {A brief description acting as a label for the link, stored on the DESCRIPTION property of the hw_sio_link object.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_sio_link ?-description description? ?-quiet? ?-verbose? ?hw_sio_rx? ?hw_sio_tx?}

    hover {
        summary {Create a new link between hardware RX and TX endpoints.}
        synopsis {create_hw_sio_link ?-description description? ?-quiet? ?-verbose? ?hw_sio_rx? ?hw_sio_tx?}
        description {Defines a communication link between transmitter and receiver objects on the GTs of the IBERT debug core implemented on the current hardware device, for the link-based Vivado serial I/O analyzer. Although both endpoints are marked optional at least one must be given, and a link with only one endpoint is an open-ended link whose missing endpoint is treated as Unknown and can be renamed in a link property; link behaviour is configured with set_property.}
        returns {The new hardware SIO link.}
        example {create_hw_sio_link -description Link_12 [get_hw_sio_txs *MGT_X0Y12*] \
[get_hw_sio_rxs *MGT_X0Y12*]}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_sio_linkgroup {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -description -takes description \
           -detail {A brief description acting as a label for the link group, stored on the DESCRIPTION property of the hw_sio_linkgroup object.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_sio_linkgroup ?-description description? ?-quiet? ?-verbose? hw_sio_links}

    hover {
        summary {Create a new hardware SIO link group.}
        synopsis {create_hw_sio_linkgroup ?-description description? ?-quiet? ?-verbose? hw_sio_links}
        description {Associates the specified TX to RX communication links on the IBERT debug core of the current device into a group, so their properties can be configured and scans run collectively. The links must be given as objects returned by create_hw_sio_link or get_hw_sio_links, and including a link that already belongs to another link group returns an error.}
        returns {The new hardware SIO link group.}
        example {create_hw_sio_linkgroup -description "LoopBack Links" \
   [get_hw_sio_links -filter {DESCRIPTION == Link_12 || DESCRIPTION == \
   "Link 9" || DESCRIPTION == "Link 10" || DESCRIPTION == "Link 11" }]}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_sio_scan {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -description -takes description \
           -detail {A brief description acting as a label for the serial I/O analyzer scan, used to identify the hw_sio_scan object.}
    option -link_settings -takes link_settings \
           -detail {A list of link properties and values to set before running the scan; the default settings are used when omitted.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_sio_scan ?-description description? ?-link_settings link_settings? ?-quiet? ?-verbose? scan_type hw_sio_object}

    hover {
        summary {Create a new hardware SIO scan.}
        synopsis {create_hw_sio_scan ?-description description? ?-link_settings link_settings? ?-quiet? ?-verbose? scan_type hw_sio_object}
        description {Creates a serial I/O analyzer scan object for a link or receiver on the IBERT debug core, to analyze the margin of a link using the specialized Eye Scan hardware. The scan_type is 1d_bathtub, scanning all horizontal sampling points through the 0 vertical axis, or 2d_full_eye, scanning all horizontal and vertical sampling points; the hw_sio_object must be a list of one hw_sio_link or hw_sio_rx object, and if a link is passed it must have an RX endpoint. The scan is run with run_hw_sio_scan, saved with write_hw_sio_scan, and removed with remove_hw_sio_scan.}
        returns {The new hardware SIO scan.}
        example {set xil_newScan [create_hw_sio_scan -description {LoopBack} 2d_full_eye \
[lindex [get_hw_sio_links *MGT_X0Y10/TX*] 0 ]]
run_hw_sio_scan [get_hw_sio_scans $xil_newScan]}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_sio_sweep {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -description -takes description \
           -detail {A brief description acting as a label for the serial I/O analyzer sweep scan.}
    option -iteration_settings -takes iteration_settings \
           -detail {A list of LINK_SETTINGS properties to vary across the scans of the sweep.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_sio_sweep ?-description description? ?-iteration_settings iteration_settings? ?-quiet? ?-verbose? scan_type ?hw_sio_link?}

    hover {
        summary {Create a new hardware SIO sweep.}
        synopsis {create_hw_sio_sweep ?-description description? ?-iteration_settings iteration_settings? ?-quiet? ?-verbose? scan_type ?hw_sio_link?}
        description {Creates a serial I/O analyzer link sweep object, a collection of link scans run across a range of GT configuration values to determine which settings suit the design best. The scan_type is 1d_bathtub or 2d_full_eye, and if a link object is passed it must have an RX endpoint. The sweep is run with run_hw_sio_sweep, saved with write_hw_sio_sweep, and removed with remove_hw_sio_sweep.}
        returns {The new hardware SIO sweep.}
        example {set xil_newSweep [create_hw_sio_sweep -description {Sweep 0} 2d_full_eye \
   [lindex [get_hw_sio_links *MGT_X0Y10/TX*] 0 ]]
run_hw_sio_sweep [get_hw_sio_sweeps $xil_newSweep]}
        source {Xilinx UG835 2026.1}
    }
}
command create_hw_target {
    available {tcl 8.5}
    required_package vivado

