        summary {Get a list of Versal soft memory controller cores.}
        synopsis {get_hw_softmcs ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}
        description {Returns a list of the soft memory cores on the current hardware device. Versal devices can be instantiated with fabric based memory controllers equipped with logic cores to extract debug data from the hardware, known as Versal SoftMC; the controllers contain memory configuration and memory calibration data that can be accessed from the Vivado Hardware Manager, where the calibration and margin data are presented in a graphical format for ease of analysis.}
        returns {Soft memory controller cores.}
        example {get_hw_softmcs -filter {DISPLAY_NAME == SoftMC_2}}
        source {Xilinx UG835 2026.1}
    }
}
command get_hw_sysmon_reg {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_hw_sysmon_reg ?-quiet? ?-verbose? hw_sysmon hexaddress}

    hover {
        summary {Get the system monitor register value.}
        synopsis {get_hw_sysmon_reg ?-quiet? ?-verbose? hw_sysmon hexaddress}
        description {Returns the hex value of the system monitor register defined at the specified hex address of the specified hw_sysmon object, which must be given as an object returned by get_hw_sysmons. The System Monitor Analog-to-Digital Converter measures die temperature and voltage on the hw_device, and its data is stored in dedicated status and control registers accessible through the hw_sysmon_reg object. The recommended procedure is to retrieve register values as formatted properties of the hw_sysmon object with get_property instead, optionally after refresh_hw_sysmon, since this command returns the unformatted hex value.}
        returns {Register value in Hex.}
        example {set opTemp [get_hw_sysmon_reg [lindex [get_hw_sysmons] 0 ] 00 ]}
        source {Xilinx UG835 2026.1}
    }
}
command get_hw_sysmons {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects \
           -detail {Return the hw_sysmon objects of the specified hw_server, hw_target, or hw_device objects; cannot be used with a search pattern.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_hw_sysmons ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of hardware SysMons.}
        synopsis {get_hw_sysmons ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the Sysmon debug core objects defined on the current hardware device. Every device that supports the system monitor automatically has one or more hw_sysmon objects created when refresh_hw_device is called, each assigned properties for all the temperature, voltage, and control registers, with temperature and voltage values already translated to Celsius, Fahrenheit, and Voltage. The raw hex values in the registers can also be read with get_hw_sysmon_reg. This command returns a list of hw_sysmon objects on the current or specified hw_device, or returns an error if it fails.}
        returns {Hardware sysmons.}
        example {get_hw_sysmons -of_objects [current_hw_device]}
        source {Xilinx UG835 2026.1}
    }
}
