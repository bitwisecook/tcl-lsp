command launch_chipscope_analyzer {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -run -takes run \
           -detail {The implemented run to launch ChipScope Analyzer with; the run must be implemented and have a bitstream file generated.}
    option -csproject -takes csproject \
           -detail {The name of the ChipScope project to open, specified with its .cpj extension; the default project name is csdefaultproj.cpj.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_chipscope_analyzer ?-run run? ?-csproject csproject? ?-quiet? ?-verbose?}

    hover {
        summary {Launch the ChipScope Pro Analyzer tool for the active run or a specified implemented run.}
        synopsis {launch_chipscope_analyzer ?-run run? ?-csproject csproject? ?-quiet? ?-verbose?}
        description {Launches the ChipScope Pro Analyzer tool for the active run, or a specified implemented design run; a netlist design can be set up for use with ChipScope prior to implementation using create_debug_core, create_debug_port, and connect_debug_port. The implemented design must also have a bitstream file generated by BitGen or an error is returned. UG835 2026.1 heads this section with the line that the command issues an error that you can not run this command.}
        example {launch_chipscope_analyzer -run impl_3 -csproject impl_3_cs_project}
        source {Xilinx UG835 2026.1}
    }
}
command launch_impact {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -run -takes run \
           -detail {Launch iMPACT with the specified run; the active implementation run is used if none is given.}
    option -ipf -takes ipf_file \
           -detail {The iMPACT project file to use to save the results to; the target device is configured according to the default settings if it is not given.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_impact ?-run run? ?-ipf ipf_file? ?-quiet? ?-verbose?}

    hover {
        summary {Launch iMPACT to configure a device and generate programming files.}
        synopsis {launch_impact ?-run run? ?-ipf ipf_file? ?-quiet? ?-verbose?}
        description {Launches iMPACT to configure the device and generate programming files, read back and verify design configuration data, debug configuration problems, or execute XSVF files. The bitstream file must be generated with write_bitstream prior to using iMPACT. UG835 2026.1 heads this section with the line that the command issues an error that you can not run this command.}
        returns {The list of files read.}
        example {launch_impact -run impl_3}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command launch_modelsim {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -simset -takes simset \
           -detail {Name of the simulation fileset to simulate, defaulting to the current simulation fileset.}
    option -mode -takes mode -values {behavioral timing} -closed \
           -detail {Simulation mode, defaulting to behavioral.}
    option -noclean_dir -detail {Do not remove simulation run directory files prior to launching the simulator.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_modelsim ?-simset simset? ?-mode mode? ?-noclean_dir? ?-quiet? ?-verbose?}

    hover {
        summary {Launch simulation using ModelSim simulator.}
        synopsis {launch_modelsim ?-simset simset? ?-mode mode? ?-noclean_dir? ?-quiet? ?-verbose?}
        description {Launches the Mentor Graphics ModelSim or Questa Advanced Simulator tool, which must be installed and on the PATH, with the project target_simulator property set to ModelSim. The Xilinx simulation libraries must first be compiled for the target simulator with compile_simlib, and the simulator references them through the modelsim.ini file; the command returns the transcript of the simulator.}
        returns {Nothing.}
        example {launch_modelsim -mode timing}
        source {Xilinx UG835 2012.2}
    }
}
command launch_runs {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -jobs -takes jobs \
           -detail {The number of parallel jobs to run on the local host; the default is 1.}
    option -scripts_only \
           -detail {Generate a runme script for each specified run so the runs can be queued to be launched at a later time.}
    option -lsf -takes bsub_command \
           -detail {Use IBM Platform Load Sharing Facility to launch the runs, with the bsub command line to pass to LSF as the required argument.}
    option -sge -takes qsub_command \
           -detail {Use Oracle Grid Engine or Sun Grid Engine to launch the runs, with the qsub command line to pass to SGE as the required argument.}
    option -cluster_configuration -takes configuration_name \
           -detail {Run jobs on the named cluster configuration, taken from the GUI settings.}
    option -dir -takes launch_directory \
           -detail {The directory for the tool to write run results into, with a separate folder created for each run.}
    option -to_step -takes step_name \
           -detail {Launch the run through the named implementation step and then stop; the step must be enabled for the run, it is ignored when launching multiple runs, and it is not valid with -next_step.}
    option -next_step \
           -detail {Continue a prior run from the step at which it was stopped; it is ignored when launching multiple runs and is not valid with -to_step.}
    option -host -takes host_jobs \
           -detail {Launch on the named remote host with a specified number of jobs, given as a hostname and job count pair; supported on Linux only.}
    option -remote_cmd -takes remote_command \
           -detail {The command used to log in to remote hosts.}
    option -email_to -takes email_addresses \
           -detail {List of email addresses to notify when jobs complete; only applicable with -host.}
    option -email_all \
           -detail {Send a separate email after each job completes; only applicable with -host.}
    option -pre_launch_script -takes script \
           -detail {A shell script to run on the specified host before launching each job; only applicable with -host.}
    option -post_launch_script -takes script \
           -detail {A shell script to run on the specified host after each job completes; only applicable with -host.}
    option -custom_script -takes script_map_file \
           -detail {A user run script map file containing a mapping of run names to user run scripts.}
    option -force \
           -detail {Run the command even if there are pending constraint changes, which will be lost, in a Dynamic Function eXchange design.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_runs ?-jobs jobs? ?-scripts_only? ?-lsf bsub_command? ?-sge qsub_command? ?-cluster_configuration configuration_name? ?-dir launch_directory? ?-to_step step_name? ?-next_step? ?-host host_jobs? ?-remote_cmd remote_command? ?-email_to email_addresses? ?-email_all? ?-pre_launch_script script? ?-post_launch_script script? ?-custom_script script_map_file? ?-force? ?-quiet? ?-verbose? runs}

    hover {
        summary {Launch a set of runs.}
        synopsis {launch_runs ?-jobs jobs? ?-scripts_only? ?-lsf bsub_command? ?-sge qsub_command? ?-cluster_configuration configuration_name? ?-dir launch_directory? ?-to_step step_name? ?-next_step? ?-host host_jobs? ?-remote_cmd remote_command? ?-email_to email_addresses? ?-email_all? ?-pre_launch_script script? ?-post_launch_script script? ?-custom_script script_map_file? ?-force? ?-quiet? ?-verbose? runs}
        description {Launches synthesis and implementation runs when running the Vivado Design Suite in Project Mode. A run must be previously defined with create_run and configured with set_property; both synthesis and implementation runs can be named in the same command, but the parent synthesis run must already be complete before an implementation run can be launched. The valid -to_step values for implementation runs are opt_design, power_opt_design, place_design, the post-place power_opt_design step, phys_opt_design, route_design, and write_bitstream. In Non-Project Mode the implementation steps are launched individually instead.}
        example {launch_runs synth_1 synth_2 synth_4 -jobs 2}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command launch_sdk {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -bit -takes bit -detail {Specify the bitstream file for FPGA programming.}
    option -bmm -takes bmm -detail {Specify the BMM file for BRAM initialization.}
    option -workspace -takes workspace -detail {Specify the workspace directory for SDK projects.}
    option -hwspec -takes hwspec \
           -detail {Specify the hardware platform specification file (system.xml) exported by export_hardware.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_sdk ?-bit bit? ?-bmm bmm? ?-workspace workspace? ?-hwspec hwspec? ?-quiet? ?-verbose?}

    hover {
        summary {Launch Xilinx Software Development Kit (SDK).}
        synopsis {launch_sdk ?-bit bit? ?-bmm bmm? ?-workspace workspace? ?-hwspec hwspec? ?-quiet? ?-verbose?}
        description {Launches the Software Development Kit (SDK) to design the software for embedded processor sources in the project. This command follows export_hardware, which writes the embedded processor hardware specification file for use by SDK; the command returns a transcript of the SDK tool launch.}
        returns {Nothing.}
        example {launch_sdk -hwspec C:/Data/export_sdk/hw/robot.xml -workspace C:/Data/sdk_work/}
        source {Xilinx UG835 2012.2}
    }
}
command launch_simulation {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -step -takes step -values {all compile elaborate simulate} -closed \
           -detail {The simulation step to launch; the default is all, which launches all steps.}
    option -simset -takes simset \
           -detail {The name of the simulation fileset containing the test benches and sources used during simulation; the current simulation fileset is used if not specified.}
    option -mode -takes mode \
           -values {behavioral post-synthesis post-implementation} -closed \
           -detail {The simulation mode, selecting a behavioral simulation of the HDL sources, a simulation of the post-synthesis netlist, or a simulation of the post-implementation design; the default is behavioral.}
    option -type -takes type -values {functional timing} -closed \
           -detail {The netlist type, selecting functional simulation of just the netlist or timing simulation of the netlist and SDF file; only applicable with -mode post-synthesis or post-implementation and an error with -mode behavioral.}
    option -scripts_only \
           -detail {Only generate the simulation scripts for the target simulator rather than launching the compile, elaborate, and simulate steps.}
    option -gui \
           -detail {Invoke the simulator GUI when executing the simulate script; applicable for scripts-only mode.}
    option -exec \
           -detail {Execute the existing script for the step specified with -step, which must have been generated first into the simulation run directory.}
    option -of_objects -takes objects \
           -detail {Run simulation for a single specified sub-design or composite file, specified as a design object returned by get_files; applicable with -scripts_only only.}
    option -absolute_path \
           -detail {Make design source file paths in the generated scripts absolute rather than relative to the simulation run directory.}
    option -install_path -takes install_path \
           -detail {The directory containing the simulator executables; the target simulator looks in the current PATH if it is not specified.}
    option -gcc_install_path -takes gcc_install_path \
           -detail {The directory containing the simulator GNU compiler executables for g++ and gcc.}
    option -noclean_dir \
           -detail {Do not remove files from the simulation run directory prior to launching the simulator.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_simulation ?-step step? ?-simset simset? ?-mode mode? ?-type type? ?-scripts_only? ?-gui? ?-exec? ?-of_objects objects? ?-absolute_path? ?-install_path install_path? ?-gcc_install_path gcc_install_path? ?-noclean_dir? ?-quiet? ?-verbose?}

    hover {
        summary {Generate simulation scripts of the design and launch steps for the target simulator.}
        synopsis {launch_simulation ?-step step? ?-simset simset? ?-mode mode? ?-type type? ?-scripts_only? ?-gui? ?-exec? ?-of_objects objects? ?-absolute_path? ?-install_path install_path? ?-gcc_install_path gcc_install_path? ?-noclean_dir? ?-quiet? ?-verbose?}
        description {Launches a simulator to perform analysis and verification of a design, creating a script file for the target simulator and then executing it in the simulation run directory, where the simulation results are saved in log files. The target simulator is defined by the TARGET_SIMULATOR property on the project, whose value can be XSim, ModelSim, Xcelium, VCS, Riviera, or ActiveHDL, with XSim the default. The flow is a three-step process of compile, elaborate, and simulate, with one script file written per step and run in sequence unless -scripts_only is given.}
        returns {A transcript of the process, or an error if it fails.}
        example {launch_simulation -scripts_only}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
