}
command export_bd_synth {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite any existing design checkpoint and stub files of the same name.}
    option -keep -detail {Keep the temporary directory and project.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Print verbose messaging.}

    form Default {export_bd_synth ?-force? ?-keep? ?-quiet? ?-verbose? file}

    hover {
        summary {Create and write a single design checkpoint and stub files for a block design.}
        synopsis {export_bd_synth ?-force? ?-keep? ?-quiet? ?-verbose? file}
        description {A user-written application that runs synthesis for a block design (.bd), integrates the design along with any needed sub-designs such as out-of-context synthesized IP, and writes out a single design checkpoint (.dcp) of the entire synthesized design plus HDL stub files, for use with third party synthesis tools. The output files are placed in the same directory as the source BD file.}
        returns {Nothing; an error is thrown if the command is not successful.}
        example {export_bd_synth [get_files block_1.bd]}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command export_hardware {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -bitstream \
           -detail {Export the bitstream and BMM model data to the SDK export directory in addition to the hardware specification file; an error is returned if the bitstream file does not exist.}
    option -dir -takes directory \
           -detail {Export directory; by default the hardware files are written under project_name.sdk/SDK/SDK_Export/hw in the local project directory.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -writes

    form Default {export_hardware ?-bitstream? ?-dir directory? ?-quiet? ?-verbose? files ?run?}

    hover {
        summary {Export the system hardware platform for SDK.}
        synopsis {export_hardware ?-bitstream? ?-dir directory? ?-quiet? ?-verbose? files ?run?}
        description {Exports the Embedded Processor system hardware platform so SDK can support software design for the embedded processor sources in the project. The files argument is a files object holding the XPS project files (.xmp) to export, obtained with get_files, and the optional run argument names an implementation run to export. By default the hardware specification file (.xml) is written for each specified embedded processor, and its output can be used to invoke SDK with launch_sdk.}
        returns {Nothing.}
        example {export_hardware -bitstream [get_files *.xmp]}
        source {Xilinx UG835 2012.2}
    }
}
command export_ip_user_files {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects -detail {IP or BD file object to export files for.}
    option -ip_user_files_dir -takes directory -detail {Base directory path for exporting IP files.}
    option -ipstatic_source_dir -takes directory \
           -detail {Custom directory path for exporting IP static files.}
    option -lib_map_path -takes directory -detail {Compiled simulation library directory path.}
    option -single_step -detail {Write a single-step script.}
    option -no_script -detail {Do not export simulation scripts.}
    option -for_target_sim -detail {Export simulation scripts for the target simulator only.}
    option -sync -detail {Delete IP/IPI dynamic and simulation script files.}
    option -reset -detail {Delete all IP/IPI static, dynamic and simulation script files.}
    option -force -detail {Overwrite files.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {export_ip_user_files ?-of_objects objects? ?-ip_user_files_dir directory? ?-ipstatic_source_dir directory? ?-lib_map_path directory? ?-single_step? ?-no_script? ?-for_target_sim? ?-sync? ?-reset? ?-force? ?-quiet? ?-verbose?}

    hover {
        summary {Generate and export IP/IPI user files from a project.}
        synopsis {export_ip_user_files ?-of_objects objects? ?-ip_user_files_dir directory? ?-ipstatic_source_dir directory? ?-lib_map_path directory? ?-single_step? ?-no_script? ?-for_target_sim? ?-sync? ?-reset? ?-force? ?-quiet? ?-verbose?}
        description {Exports the IP generated static, dynamic, netlist, Verilog/VHDL stub, and memory initialization files to the ip_user_files area, and can be scoped to one or more IPs with -of_objects. By default the command also calls export_simulation to generate simulation scripts; -no_script suppresses that, while -sync and -reset delete previously exported files.}
        example {export_ip_user_files \
     -of_objects [get_ips char_fifo] \
     -no_script}
        source {Xilinx UG835 2026.1}
    }
}
command export_simulation {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Arguments prose marks -simulator (Required), but the
    ;# Syntax line and the Usage table both bracket it; the Usage table is taken
    ;# as authoritative, so it is spelled optional here.
    option -simulator -takes simulator \
           -values {all xsim modelsim questa xcelium vcs riviera activehdl} -closed \
           -detail {Target simulator to generate the script for; the default is all.}
    option -of_objects -takes objects \
           -detail {Export the simulation script for the specified object, an IP or BD.}
    option -step -takes step -values {compile elaborate simulate} -closed \
           -detail {Write the script for the specified step; specify simulate for -single_step.}
    option -ip_user_files_dir -takes directory \
           -detail {Directory path to the exported IP/BD files, static, dynamic and data.}
    option -ipstatic_source_dir -takes directory \
           -detail {Directory path to the exported IP/BD static files.}
    option -lib_map_path -takes directory -detail {Compiled simulation library directory path.}
    option -install_path -takes directory -detail {Simulator installation directory path.}
    option -gcc_install_path -takes directory \
           -detail {GNU compiler installation directory path for the g++/gcc executables.}
    option -script_name -takes file_name -detail {Output script filename.}
    option -directory -takes directory -detail {Output directory path for the generated script.}
    option -runtime -takes run_time \
           -detail {Simulation run time; the default is a full simulation run or until a logical break or finish condition.}
    option -define -takes defines -detail {Verilog defines applicable for the current design.}
    option -generic -takes generics -detail {VHDL generics applicable for the current design.}
    option -include -takes directories -detail {Include directory paths for Verilog include files.}
    option -more_options -takes options -detail {Additional options for the simulator tools.}
    option -single_step -detail {Write a single-step script; the supported simulator is xcelium.}
    option -use_ip_compiled_libs -detail {Reference the pre-compiled IP simulation library.}
    option -absolute_path -detail {Make all file paths absolute.}
    option -export_source_files -detail {Copy IP/BD source files to the output directory.}
    option -generate_hier_access -detail {Extract the path for hierarchical access simulation.}
    option -exec -detail {Execute the generated script.}
    option -report_ip_status \
           -detail {Check IP/BD generation status for not generated or stale simulation targets.}
    option -force -detail {Overwrite previous files.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {export_simulation ?-simulator simulator? ?-of_objects objects? ?-step step? ?-ip_user_files_dir directory? ?-ipstatic_source_dir directory? ?-lib_map_path directory? ?-install_path directory? ?-gcc_install_path directory? ?-script_name file_name? ?-directory directory? ?-runtime run_time? ?-define defines? ?-generic generics? ?-include directories? ?-more_options options? ?-single_step? ?-use_ip_compiled_libs? ?-absolute_path? ?-export_source_files? ?-generate_hier_access? ?-exec? ?-report_ip_status? ?-force? ?-quiet? ?-verbose?}

    hover {
        summary {Export a script and associated data files for driving standalone simulation.}
        synopsis {export_simulation ?-simulator simulator? ?-of_objects objects? ?-step step? ?-ip_user_files_dir directory? ?-ipstatic_source_dir directory? ?-lib_map_path directory? ?-install_path directory? ?-gcc_install_path directory? ?-script_name file_name? ?-directory directory? ?-runtime run_time? ?-define defines? ?-generic generics? ?-include directories? ?-more_options options? ?-single_step? ?-use_ip_compiled_libs? ?-absolute_path? ?-export_source_files? ?-generate_hier_access? ?-exec? ?-report_ip_status? ?-force? ?-quiet? ?-verbose?}
        description {Exports a simulation script for the target simulator containing the tool commands for compiling, elaborating, and simulating the design. The command retrieves the simulation compile order of the specified object, which may be a simulation fileset, an IP, or a block design, and writes it into a shell script, .do, or .prj file; when no object is specified the script covers the active simulation top of the current simulation fileset. Source and include paths are written relative to the output directory unless -absolute_path is given, and the Xilinx simulation library must be compiled first with compile_simlib for the generated script to run.}
        returns {Nothing.}
        example {export_simulation \
      -simulator xsim \
      -directory test_xsim \
      -ip_user_files_dir project_1/project_1.ip_user_files_dir \
      -ipstatic_source_dir project_1/project_1.ip_user_files_dir/ipstatic \
      -use_ip_compiled_libs}
        source {Xilinx UG835 2026.1}
    }
}
command export_xsim_coverage {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -cov_db_name -takes db_name \
           -detail {Coverage database name; repeat the option for multiple databases.}
    option -cov_db_dir -takes directory \
           -detail {Coverage database directory; repeat the option for multiple directories.}
    option -output_dir -takes directory \
           -detail {Directory the HTML report files are generated in.}
    option -ccExclusionFile -takes file_name -detail {Code coverage exclusion file (required).}
    option -report_format -takes format -values {html text all} -closed \
           -detail {Desired format of the coverage report; the default is html.}
    option -merge_db_name -takes db_name -detail {Name for the merged coverage database output.}
    option -merge_dir -takes directory \
           -detail {Directory where the merged coverage database will be saved.}
    option -cc_fullfile -detail {Show the entire file in the code coverage report.}
    option -cc_instancescount -takes count \
           -detail {Maximum number of instances shown in the code coverage report; the default is 100.}
    option -file -takes file_name \
           -detail {File with the locations of the coverage databases to restore.}
    option -nolog -detail {Suppress log file generation.}
    option -log -takes file_name -detail {Log file name; the default is xcrg.log.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {export_xsim_coverage ?-cov_db_name db_name? ?-cov_db_dir directory? ?-output_dir directory? -ccExclusionFile file_name ?-report_format format? ?-merge_db_name db_name? ?-merge_dir directory? ?-cc_fullfile? ?-cc_instancescount count? ?-file file_name? ?-nolog? ?-log file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Read the coverage database generated by the Vivado simulator and export it as an HTML report.}
        synopsis {export_xsim_coverage ?-cov_db_name db_name? ?-cov_db_dir directory? ?-output_dir directory? -ccExclusionFile file_name ?-report_format format? ?-merge_db_name db_name? ?-merge_dir directory? ?-cc_fullfile? ?-cc_instancescount count? ?-file file_name? ?-nolog? ?-log file_name? ?-quiet? ?-verbose?}
        description {Generates the coverage report from the coverage databases saved on disk by the XSim simulator kernel. The same command reports both functional coverage and code coverage; the code coverage report is only generated when the design was compiled with the xelab code coverage options enabled, and the functional coverage report requires SystemVerilog functional coverage constructs in the design.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command extract_files {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -base_dir -takes directory \
           -detail {Base directory for the extracted files; the default is ip_files.}
    option -force -detail {Overwrite existing files.}
    option -no_ip_dir -detail {Do not include the IP dir as part of the extract directory.}
    option -no_paths -detail {Do not include directories when extracting files.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {extract_files ?-base_dir directory? ?-force? ?-no_ip_dir? ?-no_paths? ?-quiet? ?-verbose? files}

    hover {
        summary {Extract files from a core container to disk.}
        synopsis {extract_files ?-base_dir directory? ?-force? ?-no_ip_dir? ?-no_paths? ?-quiet? ?-verbose? files}
        description {Extracts the files from an IP in core container format, the compressed zip file that reduces the file structure in the design and increases tool performance. The named files are the IP core container (.XCIX) files to extract from, and the extracted files are written into the ip_files folder of the current working directory unless -base_dir names another.}
