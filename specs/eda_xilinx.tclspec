}
command tie_unused_pins {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes cells \
           -detail {Tie the unused pins of the specified cell objects, which must be specified with the get_ commands rather than by name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {tie_unused_pins ?-of_objects cells? ?-quiet? ?-verbose?}

    hover {
        summary {Tie off unused cell pins.}
        synopsis {tie_unused_pins ?-of_objects cells? ?-quiet? ?-verbose?}
        description {Ties up or down the unconnected pins of cells in the open synthesized or implemented design, using an internal process to identify whether a pin should be tied up or down. This command is intended for the unconnected pins of cells added to the netlist with the create_cell command.}
        returns {Nothing.}
        example {tie_unused_pins -of_objects [get_cells cpuEngine]}
        source {Xilinx UG835 2026.1}
    }
}
command undo {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -list \
           -detail {Reports the list of commands that can be undone, through which the tool steps backward as undo is executed.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {undo ?-list? ?-quiet? ?-verbose?}

    hover {
        summary {Undo the previous command.}
        synopsis {undo ?-list? ?-quiet? ?-verbose?}
        description {Undoes a prior command, and can be used repeatedly to undo a series of commands. A group of commands created with startgroup and endgroup is undone as a sequence, starting at the endgroup command and continuing until the startgroup command is reached; an undone command can be restored with redo. This command is intended for use in the Vivado IDE rather than in Tcl scripts, where write_checkpoint and read_checkpoint should be used to restore a design to a former state.}
        returns {With -list, the list of undoable tasks.}
        example {undo -list}
        source {Xilinx UG835 2026.1}
    }
}
command ungroup_bd_cells {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -prefix -takes prefix \
           -detail {A prefix name to apply to any cells that are moved up one level in the hierarchy.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {ungroup_bd_cells ?-prefix prefix? ?-quiet? ?-verbose? ?cells?}

    hover {
        summary {Move the cells inside a hierarchy cell to its parent cell and remove the hierarchical cell.}
        synopsis {ungroup_bd_cells ?-prefix prefix? ?-quiet? ?-verbose? ?cells?}
        description {Undoes the grouping of IP integrator cells into a hierarchical module made by group_bd_cells or move_bd_cells, moving the cells inside a selected hierarchical module up one level to the parent cell and then removing the hierarchical module. Only one hierarchical module can be specified at a time. Connections between the selected cells are maintained, and connections to other cells are maintained automatically by removing unneeded subsystem ports and pins.}
        returns {0 if success.}
        example {ungroup_bd_cells -prefix up2_ [get_bd_cells myMod2]}
        source {Xilinx UG835 2026.1}
    }
}
command unhighlight_objects {
