command compile_simlib {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -cfg_file \
           -detail {Create a new configuration file with default settings in the current directory if it is not already present.}
    option -directory -takes dir \
           -detail {Directory path for saving the compiled results; the default is the current working directory.}
    option -exclude_sublib \
           -detail {Exclude the sub-libraries defined in the EDK .pao file from compilation (EDK libraries only).}
    option -exclude_superseded \
           -detail {Exclude the superseded EDK libraries from compilation (EDK libraries only).}
    option -family -takes family \
           -values {virtex7 virtex7l kintex7 kintex7l artix7 artix7l zynq} -closed \
           -detail {Select the device architecture to compile the selected libraries for; the default is all families.}
    option -force -detail {Overwrite the current pre-compiled libraries.}
    option -language -takes language -values {verilog vhdl all} -closed \
           -detail {Compile libraries for this language; without it the language follows the simulator selected with -simulator.}
    option -library -takes library -values {all unisim simprim xilinxcorelib edk} -closed \
           -detail {Select the library to compile; the default is all (repeatable).}
    option -precompiled_directory -takes dir \
           -detail {Specify the existing directory where previously compile_simlib-compiled libraries are located.}
    option -simulator -takes simulator -values {modelsim questasim ies vcs_mx} -closed \
           -detail {Compile libraries for this simulator; ies and vcs_mx are Linux only.}
    option -simulator_exec_path -takes path \
           -detail {Use simulator executables from this directory, required when the target simulator is not on the PATH or to override it.}
    option -source_library_path -takes path \
           -detail {Search this directory for the library source files before the default paths named by the XILINX, XILINX_PLANAHEAD, and XILINX_EDK environment variables.}
    option -32bit -detail {Perform the 32-bit compilation instead of the default 64-bit compilation.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {compile_simlib ?-cfg_file? ?-directory dir? ?-exclude_sublib? ?-exclude_superseded? ?-family family? ?-force? ?-language language? ?-library library? ?-precompiled_directory dir? ?-simulator simulator? ?-simulator_exec_path path? ?-source_library_path path? ?-32bit? ?-quiet? ?-verbose?}

    hover {
        summary {Compile simulation libraries.}
        synopsis {compile_simlib ?-cfg_file? ?-directory dir? ?-exclude_sublib? ?-exclude_superseded? ?-family family? ?-force? ?-language language? ?-library library? ?-precompiled_directory dir? ?-simulator simulator? ?-simulator_exec_path path? ?-source_library_path path? ?-32bit? ?-quiet? ?-verbose?}
        description {Compiles the Xilinx HDL-based simulation libraries for use by simulators other than the Vivado simulator and Isim, which ship pre-compiled. Libraries generally must be recompiled with a new software release to update the simulation models and to support a new simulator version; when a project is open its device family, target language, and library settings supply the defaults, and the command returns information related to the compiled libraries.}
        returns {Nothing.}
        example {compile_simlib -simulator modelsim -family virtex7 -library unisim \
   -library simprim -language vhdl}
        source {Xilinx UG835 2012.2}
    }
}
