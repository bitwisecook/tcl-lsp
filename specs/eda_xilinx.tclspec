        summary {Get a list of debug ports in the current design.}
        synopsis {get_debug_ports ?-filter expression? ?-of_objects objects? ?-regexp? ?-nocase? ?-quiet? ?-verbose? ?patterns?}
        description {Gets a list of ports defined on Integrated Logic Analyzer (ILA) debug cores in the current project that match a specified search pattern; the default gets all debug ports in the project. Debug ports are defined when ILA debug cores are created with create_debug_core, and ports can be added to existing cores with create_debug_port. A debug port is named by its core_name/port_name combination.}
        returns {List of debug_port objects.}
        example {get_debug_ports -filter {PORT_WIDTH==8}}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command get_delays {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -of_objects -takes objects -detail {Get the delays of the objects passed in here.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Returns row of this section says "Nothing" while the
    ;# section summary says delay objects are returned; the Returns row is
    ;# recorded as written. The -of_objects Usage row reads "Get the clock regions
    ;# of the objects passed in here", carried over from get_clock_regions.

    form Default {get_delays ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-quiet? ?-verbose?}

    hover {
        summary {Return delay objects.}
        synopsis {get_delays ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-quiet? ?-verbose?}
        description {Returns the delay objects of the objects given to -of_objects, reduced by any -filter expression.}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
