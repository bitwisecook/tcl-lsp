command reorder_files {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -fileset -takes fileset \
           -detail {The fileset in which to reorder files, defaulting to the sources_1 source fileset.}
    option -before -takes file \
           -detail {Move the listed files before this file, which must be specified with the full path name in the fileset.}
    option -after -takes file \
           -detail {Move the listed files after this file, which must be specified with the full path name in the fileset.}
    option -front \
           -detail {Move the listed files to the front of the list of files in the fileset (default).}
    option -back \
           -detail {Move the listed files to the back of the list of files in the fileset.}
    option -auto \
           -detail {Automatically re-order the given fileset based on the hierarchy requirements of the current top module.}
    option -disable_unused \
           -detail {Disable all files not associated with the TOP design unit.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reorder_files ?-fileset fileset? ?-before file? ?-after file? ?-front? ?-back? ?-auto? ?-disable_unused? files ... ?-quiet? ?-verbose?}

    hover {
        summary {Change the order of source files in the active fileset.}
        synopsis {reorder_files ?-fileset fileset? ?-before file? ?-after file? ?-front? ?-back? ?-auto? ?-disable_unused? files ... ?-quiet? ?-verbose?}
        description {Reorders source files in the specified fileset, placing the files indicated at the front of, the back of, or before or after other files within the fileset. Files must be specified by their full path name in the fileset and are reordered in the order they are specified. The command also has an auto reorder feature that reorders the files based on the requirements of the current top module in the design.}
        returns {Nothing.}
        example {reorder_files -front {C:/Data/FPGA/file1.vhdl C:/Data/FPGA/file2.vhdl}}
        source {Xilinx UG835 2012.2}
    }
}
