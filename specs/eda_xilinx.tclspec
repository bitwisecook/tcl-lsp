    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_hw_sio_links ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of hardware SIO links.}
        synopsis {get_hw_sio_links ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the communication links between TX and RX objects on the GTs of the IBERT debug core defined on the current hardware device. The Vivado serial I/O analyzer is a link-based analyzer that lets you link between any transmitter and receiver within the IBERT design, and links can be configured by setting property values on the link object with set_property. This command returns a list of link objects on the IBERT debug core, or returns an error if it fails.}
        returns {Hardware SIO links.}
        example {get_hw_sio_links -filter {DESCRIPTION == "Link4" || DESCRIPTION == "Link2"}}
        source {Xilinx UG835 2026.1}
    }
}
command get_hw_sio_plls {
