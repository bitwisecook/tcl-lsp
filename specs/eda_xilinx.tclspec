command load_features {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {load_features ?-quiet? ?-verbose? ?features?}

    hover {
        summary {Load Tcl commands for a specified feature.}
        synopsis {load_features ?-quiet? ?-verbose? ?features?}
        description {Loads the specified features of the Vivado Design Suite into memory. To reduce the memory footprint of the tool, groups of Tcl commands called features are unavailable until a command from that feature set is run or the feature is explicitly loaded; loading a feature makes its commands and their help text available without running the feature of the tool. Use list_features to list the features available to be loaded, which is a dynamic list that changes from release to release.}
        returns {Nothing if successful, or an error message if it failed.}
        example {load_features simulator}
        source {Xilinx UG835 2026.1}
    }
}
command lock_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -level -takes level -values {logical placement routing} -closed \
           -detail {The level of the cell or design to preserve, where logical preserves the logical design, placement preserves the logical and placed design, and routing preserves the logical, placed, and routed design; the default is placement.}
    option -unlock \
           -detail {Unlock cells, or the whole design if no cells are specified; -level must be specified for unlocking just as it is for locking.}
    option -export \
           -detail {Permit the placement and routing data of a locked design or cell to be exported as an XDC file by write_xdc, which is not permitted by default.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {lock_design ?-level level? ?-unlock? ?-export? ?-quiet? ?-verbose? ?cell?}

    hover {
        summary {Lock or unlock the netlist, placement, or routing of a design.}
        synopsis {lock_design ?-level level? ?-unlock? ?-export? ?-quiet? ?-verbose? ?cell?}
        description {Locks down the placement and routing of a design, or of the specified cell of a design, for the Hierarchical Design flows for Design Preservation and Dynamic Function eXchange. After reading an out-of-context design checkpoint with read_checkpoint, the preservation level for the module must be defined. The command sets the IS_LOC_FIXED, IS_BEL_FIXED, and IS_ROUTE_FIXED properties of the specified logic, and only physically placed cells and routed nets are locked or unlocked.}
        example {lock_design -level routing [get_cells usbEngine*]}
        source {Xilinx UG835 2026.1}
    }
}
command log_saif {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {log_saif ?-quiet? ?-verbose? hdl_objects}

    hover {
        summary {Log Switching Activity Interchange Format (SAIF) toggle for specified wire, signal, or reg.}
        synopsis {log_saif ?-quiet? ?-verbose? hdl_objects}
        description {Writes the switching activity rates for the specified HDL signals during the current simulation. The SAIF file is an ASCII file containing header information and toggle counts for the specified signals of the design, as well as the timing attributes that specify time durations for signals at level 0, 1, X, or Z. This command can only be used after open_saif has opened a SAIF file in the current simulation.}
        returns {Does not return any object.}
        example {log_saif [ get_objects ]}
        source {Xilinx UG835 2026.1}
    }
}
command log_vcd {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -ports -detail {Dump the ports of the given scopes.}
    option -file -takes file \
           -detail {The file where scope-specific ports are to be dumped; the default is dumpports.vcd.}
    option -level -takes level \
           -detail {The number of levels of design hierarchy to traverse when locating HDL objects to write to the VCD file, where the default of 0 dumps the level given by the HDL objects and all levels below it and a value of 1 dumps only that level.}
    option -include_systemc -detail {Dump the SystemC VCD.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {log_vcd ?-ports? ?-file file? ?-level level? ?-include_systemc? ?-quiet? ?-verbose? ?hdl_objects?}

    hover {
        summary {Log Value Change Dump (VCD) simulation output for specified wire, signal, or reg.}
        synopsis {log_vcd ?-ports? ?-file file? ?-level level? ?-include_systemc? ?-quiet? ?-verbose? ?hdl_objects?}
        description {Indicates which HDL objects to write into the Value Change Dump file, modelling the behavior of the Verilog dumpvars system task. HDL objects include HDL signals, variables, or constants as defined in the Verilog or VHDL test bench and source files, and the level of hierarchy is represented in the hdl_objects pattern. The actual values of the objects are written to the VCD file when checkpoint_vcd or flush_vcd is run at a specific time during simulation. The open_vcd command must be used before any other VCD command.}
        returns {Does not return any object.}
        example {log_vcd [get_objects -filter { type == port } /tb/UUT/* ]}
        source {Xilinx UG835 2026.1}
    }
}
command log_wave {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -recursive -aliases {-r} \
           -detail {Recursively log the waveform activity of the specified HDL objects and their children.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -aliases {-v} \
           -detail {Suspend message limits during command execution.}

    form Default {log_wave ?-recursive? ?-quiet? ?-verbose? hdl_objects}

    hover {
        summary {Log simulation output for specified wire, signal, or reg for viewing using the Vivado simulator waveform viewer.}
        synopsis {log_wave ?-recursive? ?-quiet? ?-verbose? hdl_objects}
        description {Logs simulation activity for the specified HDL objects into the waveform database file for viewing with the Vivado simulator waveform viewer, where an HDL object is an entity that can hold a value such as a wire, signal, or register. Unlike add_wave, this command does not add the waveform object to the waveform configuration; it simply enables logging of waveform activity to the waveform database. The level of hierarchy is represented in the hdl_objects pattern.}
        returns {Nothing.}
        example {log_wave -r [get_objects /testbench/dut/*]}
        source {Xilinx UG835 2026.1}
    }
}
command ltrace {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {ltrace ?-quiet? ?-verbose? value}

    hover {
        summary {Turn on or off printing of the file name and line number of the HDL statement being simulated.}
        synopsis {ltrace ?-quiet? ?-verbose? value}
        description {Enables line-level tracing for simulation debugging purposes, returning the simulation source file and line number being evaluated to the Tcl console. A value of on, true, or yes enables line tracing and any other value sets it to off, false, or no. The feature can also be enabled with the LINE_TRACING property on the current simulation object. Process tracing with ptrace provides more detailed information than line tracing does.}
        returns {The state of line tracing, or an error if it fails.}
        example {ltrace true}
        source {Xilinx UG835 2026.1}
    }
}
command make_bd_intf_pins_external {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {make_bd_intf_pins_external ?-quiet? ?-verbose? objects}

    hover {
        summary {Create an external port for the corresponding interface pins.}
        synopsis {make_bd_intf_pins_external ?-quiet? ?-verbose? objects}
        description {Creates an external interface port in the current block design and connects it to the selected block interface pin, which is specified as a list of interface pin objects returned by get_bd_intf_pins or cell objects returned by get_bd_cells. If a cell is given, all of its unconnected block interface pins are made external, one external port per interface pin. The created external interface port has the same properties as the selected block interface pin.}
        returns {Pass if successful in creating at least one interface port.}
        example {make_bd_intf_pins_external [get_bd_intf_pins axi_gpio_0/S_AXI]}
        source {Xilinx UG835 2026.1}
    }
}
command make_bd_pins_external {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {make_bd_pins_external ?-quiet? ?-verbose? objects}

    hover {
        summary {Create an external port for the corresponding pin.}
        synopsis {make_bd_pins_external ?-quiet? ?-verbose? objects}
        description {Creates an external port in the current block design and connects it to the selected block pin, which is specified as a list of block pin objects returned by get_bd_pins or cell objects returned by get_bd_cells. If a cell is given, all of its unconnected block pins are made external, one external port per block pin. The created external port has the same properties as the selected block pin.}
        returns {Pass if successful in creating at least one port.}
        example {make_bd_pins_external [get_bd_pins axi_gpio_0/s_axi_aclk]}
        source {Xilinx UG835 2026.1}
    }
}
command make_diff_pair_ports {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {make_diff_pair_ports ?-quiet? ?-verbose? ports}

    hover {
        summary {Make a differential pair for 2 ports.}
        synopsis {make_diff_pair_ports ?-quiet? ?-verbose? ports}
        description {Joins two existing ports to create a differential pair, with the first port specified becoming the positive side of the pair. The port directions, interfaces, and other properties must match for the ports to be joined, otherwise an error is returned. The two ports must first be created, either with create_port or by reading in an XDC file.}
        example {make_diff_pair_ports port_Pos1 port_Neg1}
        source {Xilinx UG835 2026.1}
    }
}
command make_wrapper {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -top \
           -detail {Create a top-level Verilog or VHDL wrapper that instantiates the sub-design as the top level of the design hierarchy.}
    option -testbench \
           -detail {Create a simulation test bench template for the sub-design, including the design under test instantiation but not the stimulus; only valid for System Generator composite files.}
    option -inst_template \
           -detail {Create an instantiation template for the specified source, which is generated for reference purposes only and is not added to the project.}
    option -language -takes language \
           -detail {Target language for the wrapper to be generated.}
    option -fileset -takes fileset_name \
           -detail {The destination fileset for importing the wrapper file into the project; sources_1 by default.}
    option -add -detail {Add the generated files into the project.}
    option -import \
           -detail {Import the wrapper file into the project, adding it to the appropriate fileset.}
    option -force -detail {Overwrite an existing wrapper file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {make_wrapper ?-top? ?-testbench? ?-inst_template? ?-language language? ?-fileset fileset_name? ?-add? ?-import? ?-force? ?-quiet? ?-verbose? files}

    hover {
        summary {Generate an HDL wrapper for the specified source.}
        synopsis {make_wrapper ?-top? ?-testbench? ?-inst_template? ?-language language? ?-fileset fileset_name? ?-add? ?-import? ?-force? ?-quiet? ?-verbose? files}
        description {Creates a Verilog or VHDL wrapper for instantiating a sub-design into the project, for Embedded Processor Designs and any other IP integrator block design as well as DSP modules created in System Generator or MathWorks MATLAB. The wrapper can make the sub-design the top level of a stand-alone design, instantiate it into an existing design, or provide a simulation test bench for System Generator sub-designs. Only the .mdl, .slx, and .bd file formats are supported, and the wrapper is generated in the language given by the TARGET_LANGUAGE property on the project.}
        returns {Information related to the creation of the wrappers, or an error if it fails.}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command manage_user_drc_rule {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -action -takes action -values {register unregister} -closed \
           -detail {Select register to enable, or unregister to disable, a user-defined DRC rule previously registered with register_drc_rule; without this option the rules are disabled by default.}
    option -abbrev -takes abbrev \
           -detail {The unique abbreviation for the user-defined rule in the violation library, matching the name given to register_drc_rule (required).}
    option -rules -takes rules \
           -detail {The list of Tcl proc names, the rules, to enable or disable for the specified abbreviation.}
    option -list_rules -takes scope -values {all enabled} -closed \
           -detail {List the rules associated with the specified abbreviation, either all rules or only those currently enabled.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-action -list_rules}

    form Default {manage_user_drc_rule ?-action action? -abbrev abbrev ?-rules rules? ?-list_rules scope? ?-quiet? ?-verbose?}

    hover {
        summary {Manage and report or list all the user defined DRC rules.}
        synopsis {manage_user_drc_rule ?-action action? -abbrev abbrev ?-rules rules? ?-list_rules scope? ?-quiet? ?-verbose?}
        description {Provides a utility to manage user-defined DRC rules created by writing a Tcl checker procedure and registering it with register_drc_rule. The command enables or disables previously registered rules for a specific DRC abbreviation, where enabled rules are checked for violations when report_drc is run, and -list_rules lists the currently registered rules available for that abbreviation. Note -list_rules and -action cannot be used together.}
        returns {Nothing.}
        example {manage_user_drc_rule -abbrev ABCD -list_rules all}
        source {Xilinx UG835 2012.2}
    }
}
command mark_objects {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -color_index -takes color_index \
           -detail {The color index to use for marking the selected objects, an integer from 1 to 20 configured from the mark color settings of the IDE.}
    option -rgb -takes rgb_list \
           -detail {The color to use in the form of an RGB code specified as three values, for instance 255 255 0 for yellow.}
    option -color -takes color \
           -values {red green blue magenta yellow cyan orange} -closed \
           -detail {The color to use for marking the specified objects.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {mark_objects ?-color_index color_index? ?-rgb rgb_list? ?-color color? ?-quiet? ?-verbose? objects}

    hover {
        summary {Mark objects in GUI.}
        synopsis {mark_objects ?-color_index color_index? ?-rgb rgb_list? ?-color color? ?-quiet? ?-verbose? objects}
        description {Marks the specified objects in GUI mode, placing an iconic mark to aid in locating them, displayed in a color determined by one of the color options. Use only one color option; if both color options are specified, -rgb takes precedence over -color. Objects can be unmarked with the unmark_objects command.}
        example {mark_objects -color red [get_selected_objects]}
        source {Xilinx UG835 2026.1}
    }
}
command modify_debug_ports {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -probes -takes probe_connections \
           -detail {A list of probe connections given as a Tcl list of lists, each a triplet of the logical pin of the debug core to be connected, the probe channel index, and the logical net of the signal to be probed.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {modify_debug_ports ?-probes probe_connections? ?-quiet? ?-verbose?}

    hover {
        summary {Modify routed probe connections to debug cores.}
        synopsis {modify_debug_ports ?-probes probe_connections? ?-quiet? ?-verbose?}
        description {Modifies a routed design to connect nets to specified ports of debug cores, taking a list of connections to be made to specified debug probes. Each connection is a Tcl list of three elements separated by spaces: the logical pin of the debug core to be connected, the channel index of the specified probe, and the logical net of the signal to be probed. The command disconnects existing net connections to the specified probe ports as needed, connects each net to be probed to the specified probe port, and automatically routes the modified connections, leaving newly disconnected nets unconnected. The Arguments section of UG835 2026.1 describes -probes as required while its Usage table marks the option optional.}
        example {modify_debug_ports -probes [list {top/x_ila/probe0 0 top/inst_A/net_0} \
  {top/x_ila/probe1 1 top/inst_A/net_a} {top/x_ila/probe1 2 top/inst_A/net_b}]}
        source {Xilinx UG835 2026.1}
    }
}
command move_bd_cells {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -prefix -takes prefix \
           -detail {A prefix name to apply to any cells that are moved into the hierarchical module.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {move_bd_cells ?-prefix prefix? ?-quiet? ?-verbose? ?parent_cell? ?cells?}

    hover {
        summary {Move cells into a hierarchy cell.}
        synopsis {move_bd_cells ?-prefix prefix? ?-quiet? ?-verbose? ?parent_cell? ?cells?}
        description {Moves IP integrator cells, specified by get_bd_cells, into the named hierarchical module within the current subsystem design. Connections between the cells being moved are maintained, and connections between these cells and cells that are not being moved are maintained automatically by IP integrator adding pins and ports to cross the hierarchical boundary. The command returns the name of the parent cell module when successful, or an error message if it failed. Cells can also be copied into a hierarchical module with copy_bd_objs, or grouped into one with group_bd_cells.}
        returns {0 if success.}
        example {move_bd_cells -prefix mod1_ /myModule1 [get_bd_cells /myAxiFifo_1]}
        source {Xilinx UG835 2026.1}
    }
}
command move_dashboard_gadget {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {The name of the gadget to move (required).}
    option -row -takes row \
           -detail {The target row in the Project Summary dashboard for the gadget placement (required).}
    option -col -takes col \
           -detail {The target column in the Project Summary dashboard for the gadget placement (required).}
    option -dashboard -takes dashboard \
           -detail {The name of the dashboard to which the gadget is associated.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {move_dashboard_gadget -name name -row row -col col ?-dashboard dashboard? ?-quiet? ?-verbose?}

    hover {
        summary {Reposition the gadget for the Project Summary dashboard.}
        synopsis {move_dashboard_gadget -name name -row row -col col ?-dashboard dashboard? ?-quiet? ?-verbose?}
        description {Specifies the placement of a dashboard gadget into the dashboard, arranged by row and column. The Project Summary dashboard has two columns, 0 and 1, and as many rows as needed to display all the gadgets; specifying a column other than 0 or 1, or a row in excess of the currently defined rows plus one, returns an error. The Project Summary is currently the only dashboard, so the gadget is placed into that dashboard.}
        example {move_dashboard_gadget -name utilization_1 -row 3 -col 0}
        source {Xilinx UG835 2026.1}
    }
}
command move_files {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fileset -takes fileset_name \
           -detail {The destination fileset to which the specified source files should be moved; the sources_1 fileset is used by default and an error is returned if the specified fileset does not exist.}
    option -of_objects -takes reconfig_modules \
           -detail {Reconfigurable Modules to move the files to.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {move_files ?-fileset fileset_name? ?-of_objects reconfig_modules? ?-quiet? ?-verbose? ?files?}

    hover {
        summary {Move files from one fileset to another while maintaining all of their original properties.}
        synopsis {move_files ?-fileset fileset_name? ?-of_objects reconfig_modules? ?-quiet? ?-verbose? ?files?}
        description {Moves files returned by the get_files command from one fileset to another while maintaining the properties on the files. File objects returned by get_files must be specified rather than file names.}
        returns {List of files that were moved.}
        example {move_files -fileset constrs_2 [get_files top_full.xdc]}
        source {Xilinx UG835 2026.1}
    }
}
command move_pblock {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes source_ranges \
           -detail {The source Pblock region ranges to move, used together with -to as a pair.}
    option -to -takes destination_ranges \
           -detail {The destination Pblock region ranges, used together with -from as a pair; multiple pairs are allowed in a single command.}
    option -locs -takes locs \
           -values {keep_all keep_only_fixed keep_none move move_unfixed trim trim_unfixed} -closed \
           -detail {The configuration of the placed logic in the Pblock once it is moved; the default is keep_all, which retains the locations of all placed cells as per the current placement.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {move_pblock ?-from source_ranges? ?-to destination_ranges? ?-locs locs? ?-quiet? ?-verbose? pblock}

    hover {
        summary {Move Pblock range constraints.}
        synopsis {move_pblock ?-from source_ranges? ?-to destination_ranges? ?-locs locs? ?-quiet? ?-verbose? pblock}
        description {Moves the specified Pblock, only if the Pblock was created with the create_pblock command. A Pblock consists of a group of cells that can be assigned to one or more independent or overlapping rectangles, and the -from and -to pairs move the rects of a Pblock from one location to another. The -locs option decides what happens to logic already placed in the Pblock, from keeping all placements through moving them relative to the new location to unplacing logic that falls outside it.}
        source {Xilinx UG835 2026.1}
    }
}
command move_wave {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -into -takes target \
           -detail {The wave configuration, group, or virtual bus into which the wave objects will be moved.}
    option -at_wave -takes wave_object \
           -detail {Insert the wave objects into the specified wave object, or after it if it is not a group or virtual bus.}
    option -after_wave -takes wave_object \
           -detail {Insert the wave objects after the specified wave object.}
    option -before_wave -takes wave_object \
           -detail {Insert the wave objects before the specified wave object.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {move_wave ?-into target? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-quiet? ?-verbose? items}

    hover {
        summary {Move wave objects from their current position to the specified position in the wave configuration.}
        synopsis {move_wave ?-into target? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-quiet? ?-verbose? items}
        description {Moves the specified wave objects from their current position to a new position in the wave configuration, either into a wave configuration, group, or virtual bus, or at, after, or before a given wave object.}
        source {Xilinx UG835 2026.1}
    }
}
command open_bd_design {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_bd_design ?-quiet? ?-verbose? name}

    hover {
        summary {Open an existing IP subsystem design from disk file.}
        synopsis {open_bd_design ?-quiet? ?-verbose? name}
        description {Opens an IP subsystem design in the IP integrator of the Vivado Design Suite; the subsystem must previously have been created with create_bd_design. The name is the path and file name of the design to open and must include the file extension.}
        returns {The design object. Returns nothing if the command fails.}
        example {open_bd_design   C:/Data/project1/project1.src/sources_1/bd/design_1/design_1.bd}
        source {Xilinx UG835 2026.1}
    }
}
command open_checkpoint {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -part -takes part \
           -detail {Override the checkpoint part, which may cause errors if the checkpoint contains xdef.}
    option -ignore_timing \
           -detail {Reload the checkpoint without the timing constraints to make opening it quicker; it does not work if a time option is given.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_checkpoint ?-part part? ?-ignore_timing? ?-quiet? ?-verbose? file}

    hover {
        summary {Open a design checkpoint in a new project.}
        synopsis {open_checkpoint ?-part part? ?-ignore_timing? ?-quiet? ?-verbose? file}
        description {Opens a design checkpoint file, creates a new in-memory project, and initializes a design immediately in the new project with the contents of the checkpoint; it can open a top-level design checkpoint or the checkpoint created for an out-of-context module. No project needs to be created first, since the command reads the design data into memory and opens the design in Non-Project Mode. When multiple design checkpoints are open, current_project switches between the open designs and current_design shows which checkpoint is active.}
        example {open_checkpoint C:/Data/state1/checkpoint.dcp -part xc7k325tffg900-2}
        source {Xilinx UG835 2026.1}
    }
}
command open_example_project {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -dir -takes directory \
           -detail {The path to the directory where the example project will be written.}
    option -rename_bdcell -takes instance_name \
           -detail {The IP instance name to use instead of the IP name of the specified block design cell in the example design.}
    option -force \
           -detail {Force the opening of a new example project, overwriting an existing example project at the specified path.}
    option -in_process \
           -detail {Open the example project in the same tool process as the current project rather than launching a new process instance.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_example_project ?-dir directory? ?-rename_bdcell instance_name? ?-force? ?-in_process? ?-quiet? ?-verbose? objects}

    hover {
        summary {Open the example project for the indicated IP.}
        synopsis {open_example_project ?-dir directory? ?-rename_bdcell instance_name? ?-force? ?-in_process? ?-quiet? ?-verbose? objects}
        description {Opens an example project for the specified IP cores, which can be used to explore the features of the IP core in a stand-alone project instead of integrated into the current project.}
        returns {The project that was opened.}
        example {open_example_project -dir C:/Data/examples -force [get_ips blk_mem*]}
        source {Xilinx UG835 2026.1}
    }
}
command open_hw_manager {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_hw_manager ?-quiet? ?-verbose?}

    hover {
        summary {Open the hardware tool.}
        synopsis {open_hw_manager ?-quiet? ?-verbose?}
        description {Opens the Hardware Manager in the Vivado Design Suite, in the IDE or in Tcl or batch mode, which is the first step in programming or debugging a design in AMD FPGA hardware. The Hardware Manager provides logic debug, programming and configuration, in-system serial I/O debug, and system monitoring, and uses first class objects such as hw_server, hw_target, hw_device, and hw_ila whose properties are read and set with get_property and set_property. The typical flow is to open the manager, connect to a hardware server, open a hardware target, identify the device, associate the programming and probes files, and program the device. Close it again with close_hw_manager.}
        returns {Nothing if successful, and an error if it fails.}
        example {open_hw_manager}
        source {Xilinx UG835 2026.1}
    }
}
command open_hw_platform {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -no_auto_upgrade \
           -detail {Do not upgrade the IP used in the block design to the latest version, which is done by default where possible.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_hw_platform ?-no_auto_upgrade? ?-quiet? ?-verbose? ?file?}

    hover {
        summary {Open the Xilinx Shell Archive.}
        synopsis {open_hw_platform ?-no_auto_upgrade? ?-quiet? ?-verbose? ?file?}
        description {Opens a Xilinx support archive file and extracts the Vivado project, block design, and IP from the archive, creating a project directory and project file from the XSA. The project is created in the current working directory, or the directory from which the tool was launched. Use report_ip_status to identify out-of-date IP.}
        returns {The name of the shell file.}
        example {open_hw_platform C:/Data/zc706.xsa}
        source {Xilinx UG835 2026.1}
    }
}
command open_hw_target {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -jtag_mode -takes jtag_mode -values {on off} \
           -detail {Open the hardware target in JTAG mode for accessing boundary scan, which makes the instruction and data registers accessible through the JTAG scan commands; it is a boolean property that can also be enabled with values of 1 or True.}
    option -xvc_url -takes xvc_url \
           -detail {Open the hardware target as a connection to a Xilinx Virtual Cable, taking the IP address and port number of the xvcServer application.}
    option -auto_calibrate \
           -detail {Auto-calibrate the target for optimal frequency, for the SmartLynq cable only.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_hw_target ?-jtag_mode jtag_mode? ?-xvc_url xvc_url? ?-auto_calibrate? ?-quiet? ?-verbose? ?hw_target?}

    hover {
        summary {Open a connection to a hardware target on the hardware server.}
        synopsis {open_hw_target ?-jtag_mode jtag_mode? ?-xvc_url xvc_url? ?-auto_calibrate? ?-quiet? ?-verbose? ?hw_target?}
        description {Opens a connection to the specified hardware target of the connected hardware servers, or to the current hardware target if none is specified. A hardware target is a system board containing a JTAG chain of one or more devices that can be programmed with a bitstream file or used to debug a design, and connections to it are managed by the hardware server application and connect_hw_server. The target must be specified as an object returned by get_hw_targets or current_hw_target, and the opened target automatically becomes the current hardware target. An open connection is closed with close_hw_target.}
        returns {Connection messages from the hardware server, or an error if it fails.}
        example {open_hw_target [lindex [get_hw_targets] 0]}
        source {Xilinx UG835 2026.1}
    }
}
command open_io_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {The name of a new or existing I/O Pin Planning design.}
    option -part -takes part \
           -detail {The device to use when creating a new design; the default part is used if it is not specified.}
    option -constrset -takes constrset \
           -detail {The name of the constraint fileset to use when opening an I/O design, which must already exist.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_io_design ?-name name? ?-part part? ?-constrset constrset? ?-quiet? ?-verbose?}

    hover {
        summary {Open an IO design.}
        synopsis {open_io_design ?-name name? ?-part part? ?-constrset constrset? ?-quiet? ?-verbose?}
        description {Opens a new or existing I/O Pin Planning design. The design_mode property for the current source fileset must be defined as PinPlanning in order to open an I/O design, otherwise an error about the design mode of the fileset is returned.}
        returns {Design object.}
        example {open_io_design -name myIO}
        source {Xilinx UG835 2026.1}
    }
}
command open_project {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -part -takes part \
           -detail {A target part to use when opening the project, overriding the part of the project; it is not supported in Vivado Lab Edition.}
    option -read_only \
           -detail {Open the project in read-only mode, so that no modifications can be saved unless the project is saved to a new editable project with save_project_as.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_project ?-part part? ?-read_only? ?-quiet? ?-verbose? file}

    hover {
        summary {Open a Vivado project file (.xpr).}
        synopsis {open_project ?-part part? ?-read_only? ?-quiet? ?-verbose? file}
        description {Opens the specified Vivado Design Suite project file, or the project file for the Vivado Lab Edition. The file must be given with both its path and its extension. The -part option lets a saved project change speed grade or move between early availability and production parts of the same device and package, within a limited range of compatible parts; it is not supported in the Vivado Lab Edition, where current_hw_target and current_hw_device determine the target part instead.}
        returns {Opened project object.}
        example {open_project C:/Designs/project1.xpr}
        source {Xilinx UG835 2026.1}
    }
}
command open_report {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -file -takes filename \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also specified.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it; it can only be used with -file.}
    option -console \
           -detail {Output the report results to the Tcl console, which is the default behavior if no other options are specified.}
    option -name -takes name \
           -detail {Output the results to a GUI panel with this name, linking objects between the report and the design for cross-selection.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_report ?-file filename? ?-append? ?-console? ?-name name? ?-return_string? ?-quiet? ?-verbose? rpx}

    hover {
        summary {Open report from .rpx file.}
        synopsis {open_report ?-file filename? ?-append? ?-console? ?-name name? ?-return_string? ?-quiet? ?-verbose? rpx}
        description {Reads an RPX protobuf file into memory to reload report results into the Vivado Design Suite; it requires an open implemented or synthesized design. The RPX file is written by report commands such as report_timing_summary and report_pulse_width that support the -rpx option, and is an interactive report file that reconnects the objects in the report to design objects so that cross-selection between the report in the IDE and the design is enabled.}
        returns {The report results, to the Tcl console by default or to a named report window in the IDE when -name is given; an error if it fails.}
        example {open_report -name RPX1 design1_summary.rpx}
        source {Xilinx UG835 2026.1}
    }
}
command open_run {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -name -takes name \
           -detail {The name assigned to the synthesized or implemented design when the run is opened, for reference purposes only.}
    option -pr_config -takes pr_config \
           -detail {The PR Configuration to apply while opening the design; only valid when opening a synthesis run.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_run ?-name name? ?-pr_config pr_config? ?-quiet? ?-verbose? run}

    hover {
        summary {Open a run into a netlist or implementation design.}
        synopsis {open_run ?-name name? ?-pr_config pr_config? ?-quiet? ?-verbose? run}
        description {Opens the specified synthesis run into a Netlist Design, or implementation run into an Implemented Design, combining the run properties defining the target part and constraint set with the synthesis or implementation results to create the design view. The run must have completed synthesis or implementation before it can be opened, or an error is returned. Use open_checkpoint to open a Non-Project based checkpoint into memory instead.}
        returns {Design object.}
        example {open_run impl_1}
        source {Xilinx UG835 2026.1}
    }
}
command open_saif {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_saif ?-quiet? ?-verbose? file_name}

    hover {
        summary {Open a file for storing signal switching rates for power estimation.}
        synopsis {open_saif ?-quiet? ?-verbose? file_name}
        description {Creates or opens a Switching Activity Interchange Format file for storing signal switching rates in the current simulation for later use by report_power. The SAIF file is an ASCII file containing header information, toggle counts for the specified signals, and the timing attributes that specify time durations for signals at level 0, 1, X, or Z, and is recommended for power analysis since it is smaller than the VCD file. Once opened, switching activity is written into it with log_saif; only one SAIF can be open at one time during simulation, and close_saif closes it.}
        returns {The SAIF object that was opened.}
        example {open_saif myData.saif}
        source {Xilinx UG835 2026.1}
    }
}
command open_vcd {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -ports \
           -detail {Open an extended VCD file for dumping ports, which defaults to dumpports.vcd.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_vcd ?-ports? ?-quiet? ?-verbose? ?file?}

    hover {
        summary {Open a Value Change Dump (VCD) file for capturing simulation output.}
        synopsis {open_vcd ?-ports? ?-quiet? ?-verbose? ?file?}
        description {Creates or opens a Value Change Dump file to capture simulation output, operating like the Verilog dumpfile simulator directive. VCD is an ASCII file containing header information, variable definitions, and value change details of a set of HDL signals, which can be viewed in a VCD viewer or used to estimate power consumption. Value changes are written with checkpoint_vcd, flush_vcd, or log_vcd, collection is paused and resumed with stop_vcd and start_vcd, the size is limited with limit_vcd, and the file is closed with close_vcd. The default file name is dump.vcd, and an existing file is reset to a new state.}
        returns {A VCD object; the current VCD is set to this object so that current_vcd returns it.}
        example {open_vcd design1.vcd}
        source {Xilinx UG835 2026.1}
    }
}
command open_wave_config {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_wave_config ?-quiet? ?-verbose? ?filename?}

    hover {
        summary {Open a wave config.}
        synopsis {open_wave_config ?-quiet? ?-verbose? ?filename?}
        description {Opens the specified Wave Config file in the current simulation and maps it to the data source of that simulation. The Wave Config file contains just the list of wave objects to display, their display properties, and markers, while the waveform database contains the event data for all traced signals whether displayed or not. A wave configuration object is created with create_wave_config and written to disk with save_wave_config. The file name should have a .wcfg suffix, which is assigned automatically if no other suffix is supplied, and any HDL objects in the file that are not found in the current simulation are ignored.}
        returns {The wave config opened.}
        example {open_wave_config testbench.wcfg}
        source {Xilinx UG835 2026.1}
    }
}
command open_wave_database {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -noautoloadwcfg \
           -detail {Do not automatically open the wave config files associated with the waveform database.}
    option -protoinst -takes protoinst_file \
           -detail {A protoinst file for protocol analysis.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {open_wave_database ?-noautoloadwcfg? ?-protoinst protoinst_file? ?-quiet? ?-verbose? wdb}

    hover {
        summary {Open a Waveform Database (WDB) file produced by a prior simulation run and return a simulation object.}
        synopsis {open_wave_database ?-noautoloadwcfg? ?-protoinst protoinst_file? ?-quiet? ?-verbose? wdb}
        description {Opens an existing static simulator database file and its associated wave config file. The simulation is static rather than live and can only be used to review prior results, so many of the commands for running and resetting the simulation are not available. HDL objects are added to the waveform database during simulation with log_wave, and objects logged that way can be added posthumously to the wave configuration of a static simulation with add_wave. Use this command with open_wave_config to open a previously completed simulation for review in the Vivado IDE.}
        example {open_wave_database {C:/Data/project_xsim/testbench_behav.wdb}
open_wave_config {C:/Data/project_xsim/testbench_behav.wcfg}
current_fileset}
        source {Xilinx UG835 2026.1}
    }
}
command opt_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -retarget \
           -detail {Retarget one type of block to another when moving the design from one device family to another, also absorbing inverters into downstream logic where possible.}
    option -propconst \
           -detail {Propagate constant inputs through the circuit, which can eliminate redundant combinational logic from the netlist.}
    option -sweep \
           -detail {Remove unnecessary logic such as loadless cells and nets, with additional optimizations such as tie-off, register replication driving multiple OBUF, buffer insertion, dual port to single port RAM retargeting, and IDELAYCTRL grouping.}
    option -bram_power_opt \
           -detail {Enable power optimization on block RAM cells, changing the WRITE_MODE on unread ports of true dual-port RAMs to NO_CHANGE and applying intelligent clock gating to block RAM outputs.}
    option -remap \
           -detail {Remap the design to combine multiple LUTs into a single LUT to reduce the depth of the logic.}
    option -aggressive_remap \
           -detail {A more exhaustive form of -remap that may reduce more LUT levels at the expense of longer optimization runtime.}
    option -resynth_remap \
           -detail {Remap the design to improve the critical paths in timing-driven mode by re-synthesizing to reduce the depth of logic.}
    option -resynth_area \
           -detail {Perform re-synthesis in area mode to reduce the number of LUTs.}
    option -resynth_seq_area \
           -detail {Perform re-synthesis to reduce both combinational and sequential logic, a superset of the optimization provided by -resynth_area.}
    option -directive -takes directive \
           -values {Explore ExploreArea ExploreWithRemap ExploreSequentialArea RuntimeOptimized RQS Default} \
           -detail {Direct the mode of optimization with specific design objectives; only one directive can be given, values are case-sensitive, and it is not compatible with any specific optimization option, only with -quiet and -verbose.}
    option -muxf_remap \
           -detail {Convert MUXFs to LUT3s opportunistically when it can improve route-ability without affecting timing.}
    option -hier_fanout_limit -takes limit \
           -detail {Replicate net drivers whose fanout is greater than the specified limit according to the logical hierarchy; the minimum value is 512.}
    option -bufg_opt \
           -detail {Perform global buffer optimizations, inserting buffers on unbuffered clock nets and on high fanout nets and performing load-splitting when a high-fanout net drives both combinational and sequential logic.}
    option -mbufg_opt \
           -detail {Transform parallel clock buffers driven by a common driver or a clock modifying block to MBUFG.}
    option -shift_register_opt \
           -detail {For high-fanout nets originating from an SRL, add output register pipeline stages to improve timing prior to the high-fanout net replication; performed as part of the default optimization.}
    option -dsp_register_opt \
           -detail {Pull registers out of a DSP, or push registers into a DSP, to improve timing and resource utilization as needed; performed as part of the default optimization.}
    option -srl_remap_modes -takes remap_modes \
           -detail {Trigger remapping between FF chains and SRLs, either automatically by target FF and LUTRAM utilization or manually by minimum FF chain depth and maximum SRL depth; the automatic and manual modes cannot both be used in the same pass.}
    option -control_set_merge \
           -detail {Reduce the drivers of logically-equivalent control signals to a single driver, resulting in nets that are better suited for module-based replication.}
    option -control_set_opt \
           -detail {Reduce control set structure complexity by converting smaller control sets into a bigger group, introducing new LUT logic in front of flop D pins to preserve functionality; Versal only, and enabled by default in all explore strategies.}
    option -merge_equivalent_drivers \
           -detail {Merge equivalent drivers on both control signals and non-control signals to reduce logic in the design.}
    option -carry_remap -detail {Remap carry signals into LUTs.}
    option -memory_opt \
           -detail {Optimize XPM memories by converting block RAMs and LUTRAMs to improve utilization, modifying a sparse RAMB36 to RAMB18 and combining multiple RAMB18 into RAMB36.}
    option -property_opt_only \
           -detail {Drive the command only by properties on objects in the design and not by the options defined as part of the command syntax; an error is returned if additional optimizations are also specified.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {opt_design ?-retarget? ?-propconst? ?-sweep? ?-bram_power_opt? ?-remap? ?-aggressive_remap? ?-resynth_remap? ?-resynth_area? ?-resynth_seq_area? ?-directive directive? ?-muxf_remap? ?-hier_fanout_limit limit? ?-bufg_opt? ?-mbufg_opt? ?-shift_register_opt? ?-dsp_register_opt? ?-srl_remap_modes remap_modes? ?-control_set_merge? ?-control_set_opt? ?-merge_equivalent_drivers? ?-carry_remap? ?-memory_opt? ?-property_opt_only? ?-quiet? ?-verbose?}

    hover {
        summary {Optimize the current netlist, performing the retarget, propconst, sweep and bram_power_opt optimizations by default.}
        synopsis {opt_design ?-retarget? ?-propconst? ?-sweep? ?-bram_power_opt? ?-remap? ?-aggressive_remap? ?-resynth_remap? ?-resynth_area? ?-resynth_seq_area? ?-directive directive? ?-muxf_remap? ?-hier_fanout_limit limit? ?-bufg_opt? ?-mbufg_opt? ?-shift_register_opt? ?-dsp_register_opt? ?-srl_remap_modes remap_modes? ?-control_set_merge? ?-control_set_opt? ?-merge_equivalent_drivers? ?-carry_remap? ?-memory_opt? ?-property_opt_only? ?-quiet? ?-verbose?}
        description {Optimizes a design netlist for the target part, improving synthesized netlists from third-party tools or netlists that are not optimized during synthesis. Run it after synthesis but prior to implementation, and assign the DONT_TOUCH property to prevent the optimization of individual cells. The default optimizations are retarget, constant propagation, sweep, global buffer optimizations, DSP register optimizations, shift-register logic optimizations, block RAM power optimizations, and implementation of the MIG and debug cores. Using command-line options for specific optimizations makes the command perform only those optimizations and disable all others, even the ones usually performed by default.}
        example {opt_design -directive Explore}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command package_bd_design {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -vlnv -takes vlnv \
           -detail {VLNV of the created IP.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {package_bd_design ?-vlnv vlnv? repository ?-quiet? ?-verbose?}

    hover {
        summary {Package the current design into a reusable IP.}
        synopsis {package_bd_design ?-vlnv vlnv? repository ?-quiet? ?-verbose?}
        description {Packages the current block design into a reusable IP, written into the specified destination repository.}
        returns {TCL_OK, or TCL_ERROR if it failed.}
        source {Xilinx UG835 2012.2}
    }
}
command pause_hw_hbm_amon {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {pause_hw_hbm_amon ?-quiet? ?-verbose? hw_objects}

    hover {
        summary {Pause Activity Monitor runs for the specified hardware HBM(s).}
        synopsis {pause_hw_hbm_amon ?-quiet? ?-verbose? hw_objects}
        description {Pauses a running HBM activity monitor in the Vivado hardware manager that has previously been started with the run_hw_hbm_amon command. The hw_objects are the HBM activity monitor objects to pause.}
        returns {Nothing when successful, or an error when it fails.}
        example {pause_hw_hbm_amon [get_hw_hbms *HBM_2]}
        source {Xilinx UG835 2026.1}
    }
}
command phys_opt_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fanout_opt \
           -detail {Perform delay-driven optimization on high-fanout timing critical nets by replicating drivers to reduce delay; not applicable for Versal adaptive SoC devices.}
    option -placement_opt \
           -detail {Move cells to reduce delay on timing-critical nets; not applicable for Versal adaptive SoC devices.}
    option -routing_opt \
           -detail {Perform routing optimization on timing-critical nets to reduce delay.}
    option -slr_crossing_opt \
           -detail {Perform post-place or post-route optimizations to improve the path delay of inter-SLR connections, adjusting the locations of the driver, load, or both after potential replication; for UltraScale and UltraScale+ devices.}
    option -insert_negative_edge_ffs \
           -detail {Insert negative edge triggered FFs for hold optimization; not applicable for the Advanced Flow.}
    option -restruct_opt \
           -detail {Advanced LUT restructure optimization to reduce logic levels and reduce delay on critical signals.}
    option -interconnect_retime \
           -detail {Perform interconnect retiming to improve critical path timing by movement or replication of a FF or LUT-FF pair; Versal devices only.}
    option -lut_opt \
           -detail {Perform LUT movement and replication to improve critical path timing; Versal adaptive SoC devices only.}
    option -casc_opt \
           -detail {Perform LUT cascade optimization, creating new LUT cascades or moving existing ones to improve critical path timing; Versal adaptive SoC devices only.}
    option -cell_group_opt -detail {Do critical cell group optimization.}
    option -equ_drivers_opt -detail {Rewire load pins to equivalent drivers.}
    option -critical_cell_opt \
           -detail {Replicate cells on timing critical nets to reduce delays; not applicable for Versal adaptive SoC devices.}
    option -dsp_register_opt \
           -detail {Improve critical path delay by moving registers from slices to DSP blocks, or from DSP blocks to slices.}
    option -bram_register_opt \
           -detail {Improve critical path delay by moving registers from slices to block RAMs, or from block RAMs to slices.}
    option -uram_register_opt \
           -detail {Improve critical path delay by moving registers across the URAM cell boundary, from slices into URAMs or from URAMs to slices.}
    option -bram_enable_opt \
           -detail {Reverse the block RAM enable-logic power optimization to improve the slack on critical enable-logic paths; not applicable for the Advanced Flow.}
    option -shift_register_opt \
           -detail {Perform shift register optimization by extracting a register from the beginning or end of an SRL register chain into the logic fabric to improve timing on negative slack paths.}
    option -hold_fix \
           -detail {Perform optimizations to insert data path delay to fix hold time violations.}
    option -aggressive_hold_fix \
           -detail {Perform hold fix optimizations that consider significantly more hold violations than the standard hold fix algorithm.}
    option -retime \
           -detail {Re-time registers forward through combinational logic to balance path delays; this is a property-driven optimization.}
    option -force_replication_on_nets -takes nets \
           -detail {Force the drivers of the specified net objects, given by get_nets, to be replicated regardless of timing slack; not applicable for the Advanced Flow.}
    option -directive -takes directive \
           -values {Explore ExploreWithHoldFix ExploreWithAggressiveHoldFix AggressiveExplore AlternateReplication AggressiveFanoutOpt AlternateFlowWithRetiming AddRetime RuntimeOptimized RQS Default} \
           -detail {Direct the mode of physical optimization with specific design objectives; only one directive can be given, values are case-sensitive, and it is not compatible with any specific optimization option, only with -quiet and -verbose.}
    option -critical_pin_opt \
           -detail {For LUT inputs, remap logical pins to physical pins, also known as pin-swapping, so that a critical path on a slow physical pin is reassigned to a faster one; a cell with a LOCK_PINS property is skipped.}
    option -clock_opt \
           -detail {Perform clock skew optimization during post-route optimization, inserting global clock buffers to delay destination clocks to improve setup on critical paths.}
    option -path_groups -takes path_groups \
           -detail {Perform optimizations on the specified path groups only.}
    option -tns_cleanup \
           -detail {Perform a Total Negative Slack cleanup with -slr_crossing_opt, optimizing SLR crossing paths while allowing some slack degradation on other paths as long as the overall WNS does not degrade; for UltraScale and UltraScale+ devices.}
    option -sll_reg_hold_fix \
           -detail {Perform SLL register hold fix optimization, for use when the router has trouble resolving hold violations on SLR crossing paths; not applicable for Versal adaptive SoC devices.}
    option -memory_rewire_opt \
           -detail {Perform rewiring of critical signals to faster pins of block RAM or URAM, excluding cascaded and ECC enabled memories; Versal adaptive SoC devices only.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {phys_opt_design ?-fanout_opt? ?-placement_opt? ?-routing_opt? ?-slr_crossing_opt? ?-insert_negative_edge_ffs? ?-restruct_opt? ?-interconnect_retime? ?-lut_opt? ?-casc_opt? ?-cell_group_opt? ?-equ_drivers_opt? ?-critical_cell_opt? ?-dsp_register_opt? ?-bram_register_opt? ?-uram_register_opt? ?-bram_enable_opt? ?-shift_register_opt? ?-hold_fix? ?-aggressive_hold_fix? ?-retime? ?-force_replication_on_nets nets? ?-directive directive? ?-critical_pin_opt? ?-clock_opt? ?-path_groups path_groups? ?-tns_cleanup? ?-sll_reg_hold_fix? ?-memory_rewire_opt? ?-quiet? ?-verbose?}

    hover {
        summary {Optimize the current placed netlist.}
        synopsis {phys_opt_design ?-fanout_opt? ?-placement_opt? ?-routing_opt? ?-slr_crossing_opt? ?-insert_negative_edge_ffs? ?-restruct_opt? ?-interconnect_retime? ?-lut_opt? ?-casc_opt? ?-cell_group_opt? ?-equ_drivers_opt? ?-critical_cell_opt? ?-dsp_register_opt? ?-bram_register_opt? ?-uram_register_opt? ?-bram_enable_opt? ?-shift_register_opt? ?-hold_fix? ?-aggressive_hold_fix? ?-retime? ?-force_replication_on_nets nets? ?-directive directive? ?-critical_pin_opt? ?-clock_opt? ?-path_groups path_groups? ?-tns_cleanup? ?-sll_reg_hold_fix? ?-memory_rewire_opt? ?-quiet? ?-verbose?}
        description {Performs timing-driven optimization on the negative-slack paths of a design; a path should have negative slack near the worst negative slack to be considered, and no optimization is performed on designs without negative slack. This optional command can be run for post-place or post-route optimizations and cannot be run prior to placement, since physical optimization requires timing data only available after placement. Post-place runs perform high-fanout, placement-based, LUT restructure, critical-cell, DSP register, block RAM register, and URAM register optimizations and a final fanout optimization by default; post-route runs perform placement-based, routing, LUT restructure, and critical-cell optimizations. Re-timing requires -retime or -directive AddRetime, and hold fixing requires -hold_fix or -directive ExploreWithHoldFix. Replicated objects are named by appending a replica suffix and count to the original object name.}
        example {phys_opt_design -directive ExploreWithHoldFix}
        source {Xilinx UG835 2026.1}
    }
}
command place_cell {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {place_cell ?-quiet? ?-verbose? cell_site_list}

    hover {
        summary {Move or place one or more instances to new locations.}
        synopsis {place_cell ?-quiet? ?-verbose? cell_site_list}
        description {Places cells onto device resources of the target part, given a list of cells and sites in interleaved order with the cell name first and the BEL site or SLICE to place it onto second. If only the SLICE is given the tool determines an appropriate BEL within it, and when moving a placed cell it attempts to use the same BEL site in the new SLICE. The site must not already be occupied or an error is returned; the IS_OCCUPIED property of a BEL site tells whether it is in use. Sites and cells must be listed in the right order and there must be the same number of sites as cells.}
        returns {Nothing if successful, or an error if it fails.}
        example {place_cell div_cntr_reg_inferredi_4810_15889 SLICE_X49Y60/D6LUT}
        source {Xilinx UG835 2026.1}
    }
}
command place_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -directive -takes directive \
           -values {Explore EarlyBlockPlacement WLDrivenBlockPlacement ExtraNetDelay_high ExtraNetDelay_low AltSpreadLogic_high AltSpreadLogic_medium AltSpreadLogic_low ExtraPostPlacementOpt ExtraTimingOpt SSI_SpreadLogic_high SSI_SpreadLogic_low SSI_SpreadSLLs SSI_BalanceSLLs SSI_BalanceSLRs SSI_HighUtilSLRs AggressiveExplore RuntimeOptimized Quick RQS Auto_1 Auto_2 Auto_3 Default} \
           -detail {Direct placement to achieve specific design objectives; only one directive can be given, values are case-sensitive, and it is compatible only with -no_psip, -no_bufg_opt, -quiet and -verbose in the standard flow and with -no_psip, -net_delay_weight, -quiet and -verbose in the Versal advanced flow, whose supported values are Explore, AggressiveExplore, RuntimeOptimized, Quick, and Default.}
    option -subdirective -takes subdirective \
           -detail {Affect specific placer phases, spelled as a phase and sub-directive pair with an optional low, med, or high level, where the phases are Floorplan, GPlace, and DPlace; incompatible with other options except -directive, -no_psip, -clock_vtree_type, -quiet and -verbose (Versal advanced flow).}
    option -no_timing_driven \
           -detail {Disable the default timing driven placement algorithm, giving a faster placement based on wire lengths that ignores timing constraints.}
    option -eco \
           -detail {Run the placer in ECO mode, placing new cells added to the design while maintaining the placement of existing cells (Versal advanced flow).}
    option -timing_summary \
           -detail {Report the post-placement worst negative slack using results from static timing analysis rather than the estimate the placer reports by default, at the cost of additional runtime.}
    option -unplace \
           -detail {Unplace all the instances which are not locked by constraints; cells with IS_LOC_FIXED set to TRUE are not affected.}
    option -post_place_opt \
           -detail {Run only the post commit optimizer, examining the worst case timing paths and improving placement to reduce delay at the expense of additional placement and routing runtime (not applicable for the Advanced Flow).}
    option -no_psip \
           -detail {Disable Physical Synthesis In Placer optimization during placement, such as replicating drivers of high-fanout nets and drivers of loads that are far apart.}
    option -psip_options -takes psip_options \
           -detail {A list of the optimizations to switch on during the Physical Synthesis In Placer phase, such as critical_cell_opt, fanout_opt, dsp_register_opt, retime, or control_set_opt (Versal advanced flow).}
    option -sll_align_opt \
           -detail {Run only the SLL alignment optimizer in post commit optimization (not applicable for the Advanced Flow).}
    option -clock_vtree_type -takes clock_vtree_type \
           -values {balanced intraSLR interSLR} -closed \
           -detail {The v-tree template used in placement, where intraSLR minimizes clock skew within each SLR, interSLR minimizes clock skew on paths between SLRs, and balanced is the best compromise; the default is balanced for the Advanced Flow and interSLR otherwise, and the values are case sensitive (Versal advanced flow).}
    option -no_bufg_opt \
           -detail {Disable global buffer insertion during placement, reducing the routing resources consumed by high fanout nets that are not timing-critical.}
    option -ultrathreads \
           -detail {Enable ultra-threads mode to speed up placement by distributing threads across multiple SLRs, for UltraScale+ SSI and vu440 devices only (not applicable for the Advanced Flow).}
    option -no_noc_opt \
           -detail {Result in better NoC QoS during placement.}
    option -net_delay_weight -takes net_delay_weight \
           -values {low medium high} -closed \
           -detail {Increase the estimated delay of high fanout and long-distance nets, where high applies the highest level of pessimism; the default is low (Versal advanced flow).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {place_design ?-directive directive? ?-subdirective subdirective? ?-no_timing_driven? ?-eco? ?-timing_summary? ?-unplace? ?-post_place_opt? ?-no_psip? ?-psip_options psip_options? ?-sll_align_opt? ?-clock_vtree_type clock_vtree_type? ?-no_bufg_opt? ?-ultrathreads? ?-no_noc_opt? ?-net_delay_weight net_delay_weight? ?-quiet? ?-verbose?}

    hover {
        summary {Automatically place ports and leaf-level instances.}
        synopsis {place_design ?-directive directive? ?-subdirective subdirective? ?-no_timing_driven? ?-eco? ?-timing_summary? ?-unplace? ?-post_place_opt? ?-no_psip? ?-psip_options psip_options? ?-sll_align_opt? ?-clock_vtree_type clock_vtree_type? ?-no_bufg_opt? ?-ultrathreads? ?-no_noc_opt? ?-net_delay_weight net_delay_weight? ?-quiet? ?-verbose?}
        description {Places the specified ports and logic cells in the current design, or all ports and logic cells, onto device resources on the target part, optimizing placement to minimize negative timing slack and reduce overall wire length while spreading out placement to reduce routing congestion. Placement is one step of implementation, run automatically by launch_runs in Project Mode and manually alongside opt_design, phys_opt_design, power_opt_design, and route_design in Non-Project Mode. The command requires an open synthesized design, and opt_design should be run first to avoid placing a suboptimal netlist; elements can also be placed manually with place_ports or with LOC properties. UG835 2026.1 documents this command in two sections with one shared syntax: the standard flow and the Versal advanced flow, which differ in the directives they accept and in which options apply, so options carrying an advanced-flow or not-applicable-for-Advanced-Flow note are marked in their own detail.}
        example {place_design -directive Explore}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command place_pblocks {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -effort -takes effort -values {LOW MEDIUM HIGH} -closed \
           -detail {Effort level the Pblock placer should use for each Pblock, defaulting to HIGH.}
    option -utilization -takes percent \
           -detail {Percentage of device resources that should be consumed by the logic assigned to a Pblock when it is placed, where a high utilization makes the Pblock smaller but more difficult to place.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {place_pblocks ?-effort effort? ?-utilization percent? pblocks ... ?-quiet? ?-verbose?}

    hover {
        summary {Run the Pblocks placer.}
        synopsis {place_pblocks ?-effort effort? ?-utilization percent? pblocks ... ?-quiet? ?-verbose?}
        description {Places Pblocks onto the fabric of the FPGA. Pblocks must be created using the create_pblock command, and should be populated with assigned logic using the add_cells_to_pblock command. An empty Pblock will be placed as directed, but results in a Pblock covering a single CLB tile.}
        returns {Nothing.}
        example {place_pblocks -effort LOW -utilization 75 block1 block2 block3 block4 block5}
        source {Xilinx UG835 2012.2}
    }
}
command place_ports {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -skip_unconnected_ports -detail {Do not place unconnected ports.}
    option -check_only \
           -detail {Run the clock placer DRCs, also available as PLCK checks in report_drc, without placing any ports.}
    option -iobank -takes iobanks \
           -detail {Place the specified ports into the listed IO bank objects, as returned by get_iobanks.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {place_ports ?-skip_unconnected_ports? ?-check_only? ?-iobank iobanks? ?-quiet? ?-verbose? ?ports?}

    hover {
        summary {Automatically place a set of ports.}
        synopsis {place_ports ?-skip_unconnected_ports? ?-check_only? ?-iobank iobanks? ?-quiet? ?-verbose? ?ports?}
        description {Assigns ports to the pins of the AMD FPGA package, either placing ports automatically onto an available I/O or clocking site or into the specified I/O banks, or assigning ports manually when the arguments are interleaved port and package pin pairs. If no ports are given, all unplaced ports are placed; ports already placed by the user, or placed and fixed, are never moved.}
        returns {Nothing.}
        example {place_ports -iobank [get_iobanks 13] [get_ports DataOut_pad_1_o]}
        source {Xilinx UG835 2026.1}
    }
}
command platform_verify {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -reference -takes reference_dcp \
           -detail {Full path to the known good design checkpoint used as the reference for comparison (required).}
    option -untrusted -takes untrusted_dcp \
           -detail {Full path to the unqualified design checkpoint to be verified.}
    option -in_memory \
           -detail {Use the current_design for comparison, when -untrusted is not specified.}
    option -cell -takes cell_name \
           -detail {Compare the specified reconfigurable cell in the two checkpoint files.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {platform_verify -reference reference_dcp ?-untrusted untrusted_dcp? ?-in_memory? ?-cell cell_name? ?-quiet? ?-verbose?}

    hover {
        summary {Verify a platform by comparing files at the bit level.}
        synopsis {platform_verify -reference reference_dcp ?-untrusted untrusted_dcp? ?-in_memory? ?-cell cell_name? ?-quiet? ?-verbose?}
        description {Takes two design checkpoint files (DCP) and compares the binary content of the files at the bit level. Both -untrusted and -in_memory are optional, but at least one of them must be specified to indicate the untrusted design source.}
        example {platform_verify -reference C:/Data/design1/routed.dcp -in_memory}
        source {Xilinx UG835 2026.1}
    }
}
command power_opt_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {power_opt_design ?-quiet? ?-verbose?}

    hover {
        summary {Optimize dynamic power using intelligent clock gating.}
        synopsis {power_opt_design ?-quiet? ?-verbose?}
        description {Optimizes the dynamic power consumption of the design by changing clock gating to take advantage of the clock enable on a flop, over the entire design, without changing the existing logic or the clocks in a way that alters design behavior. Cells can be included or excluded with set_power_opt, and activity data read with read_saif is taken into account; running before placement gives the best results, while running after placement preserves timing but limits the available optimizations.}
        example {power_opt_design}
        source {Xilinx UG835 2026.1}
    }
}
command pr_recombine {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Syntax line brackets -cell, but the Usage table marks it
    ;# (Required); the Usage mark is taken as authoritative here.
    option -cell -takes cell_name \
           -detail {The reconfigurable container module name to re-establish as a Reconfigurable Partition (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {pr_recombine -cell cell_name ?-quiet? ?-verbose?}

    hover {
        summary {Re-establish a parent cell as a Reconfigurable Partition.}
        synopsis {pr_recombine -cell cell_name ?-quiet? ?-verbose?}
        description {Re-establishes the parent cell named by -cell as a Reconfigurable Partition while removing a lower-level Reconfigurable Partition, when using the Hierarchical Dynamic Function eXchange solution.}
        source {Xilinx UG835 2026.1}
    }
}
command pr_subdivide {
    available {tcl 8.5}
    required_package vivado

    ;# NOTE(xilinx): the Syntax line brackets -cell, -subcells and <from_dcp>,
    ;# but the Usage table marks all three (Required); the Usage marks are taken
    ;# as authoritative here.
    arity 1..

    option -cell -takes cell_name \
           -detail {The parent reconfigurable partition module name to subdivide (required).}
    option -subcells -takes subcell_names \
           -detail {The child reconfigurable partition module names to create (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {pr_subdivide -cell cell_name -subcells subcell_names ?-quiet? ?-verbose? from_dcp}

    hover {
        summary {Subdivide a Reconfigurable Partition into lower-level Reconfigurable Partitions.}
        synopsis {pr_subdivide -cell cell_name -subcells subcell_names ?-quiet? ?-verbose? from_dcp}
        description {Subdivides the Reconfigurable Partition named by -cell into one or more lower-level Reconfigurable Partitions named by -subcells, when using the Hierarchical Dynamic Function eXchange solution. The positional argument is the out-of-context synthesized checkpoint path for the reconfigurable module named by -cell.}
        source {Xilinx UG835 2026.1}
    }
}
command pr_verify {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -full_check \
           -detail {Report the complete difference in placement or routing rather than stopping at the first difference.}
    option -file -takes file_name \
           -detail {Write the comparison results into the specified file, overwriting it if one already exists, instead of sending output to the console.}
    option -initial -takes checkpoint \
           -detail {The initial design checkpoint to compare the additional checkpoints against.}
    option -additional -takes checkpoints \
           -detail {One or more additional design checkpoints to compare against the initial checkpoint, enclosed in quotes or braces.}
    option -in_memory \
           -detail {Use the in-memory design for comparison, combined with the -additional option.}
    option -segcfg_only \
           -detail {Check the Segmented Configuration partition only and bypass the DFX checks if applicable; the default is to check the DFX partition and skip the Segmented Configuration partition.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {pr_verify ?-full_check? ?-file file_name? ?-initial checkpoint? ?-additional checkpoints? ?-in_memory? ?-segcfg_only? ?-quiet? ?-verbose? ?file1? ?file2?}

    hover {
        summary {Verify whether design checkpoints are replaceable on board.}
        synopsis {pr_verify ?-full_check? ?-file file_name? ?-initial checkpoint? ?-additional checkpoints? ?-in_memory? ?-segcfg_only? ?-quiet? ?-verbose? ?file1? ?file2?}
        description {Compares routed design checkpoint files created for a Dynamic Function eXchange design to verify that all imported resources match, since the placement and routing of static logic must be consistent between all configurations. Three forms are supported: two positional checkpoints with -full_check, an -initial checkpoint compared against a list of -additional checkpoints, and -in_memory combined with -additional, which requires an open in-memory design.}
        returns {The results of the comparison, or an error if it fails.}
        example {pr_verify -full_check -initial FastConfig.dcp \
   -additional {corner1.dcp corner2.dcp}}
        source {Xilinx UG835 2026.1}
    }
}
command program_hw_cfgmem {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -svf_file -takes file_name \
           -detail {Create an SVF output file for programming SPI and BPI flash configuration memories, for use by third party tools.}
    option -force \
           -detail {Overwrite the specified SVF file if it already exists; when given with -append, the -append option is ignored.}
    option -append -detail {Append the SVF output to the specified file rather than overwriting it.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {program_hw_cfgmem ?-svf_file file_name? ?-force? ?-append? ?-quiet? ?-verbose? ?hw_cfgmems?}

    hover {
        summary {Program a hardware configuration memory object.}
        synopsis {program_hw_cfgmem ?-svf_file file_name? ?-force? ?-append? ?-quiet? ?-verbose? ?hw_cfgmems?}
        description {Erases, blank checks, programs, and verifies the specified hw_cfgmem object with the memory configuration file defined in the object's PROGRAM.FILE property, which is created by write_cfgmem and associated with the object by set_property. The PROGRAM.ADDRESS_RANGE, PROGRAM.ERASE, PROGRAM.BLANK_CHECK, PROGRAM.CFG_PROGRAM, and PROGRAM.VERIFY properties determine which steps of the process are performed; the default object is the current hardware cfgmem.}
        returns {A transcript of the process when successful, or an error if it fails.}
        example {program_hw_cfgmem [current_hw_cfgmem]}
        source {Xilinx UG835 2026.1}
    }
}
command program_hw_devices {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -key -takes key_target -values {efuse bbr none} \
           -detail {Program the encryption key into the battery-backed SRAM or the eFUSE registers of the specified device.}
    option -clear \
           -detail {Clear the encryption key from the currently programmed battery-backed SRAM, used with -key.}
    option -skip_program_keys -detail {Skip programming the keys specified in the NKY file, if any.}
    option -skip_program_rsa -detail {Skip programming the RSA key specified in the NKY file, if any.}
    option -user_efuse -takes hex_value \
           -detail {A 32-bit value to program into the FUSE_USER eFUSE register of the device or devices.}
    option -user_efuse_128 -takes hex_value \
           -detail {A 128-bit value to program into the FUSE_USER eFUSE register of the device or devices.}
    option -control_efuse -takes hex_value \
           -detail {A value to program into the FUSE_CNTL eFUSE register, 14 bits for 7 series devices or 21 bits for UltraScale devices.}
    option -security_efuse -takes hex_value \
           -detail {A 256-bit value to program into the security eFUSE register of the device or devices.}
    option -only_export_efuse \
           -detail {Do not program the eFUSE registers; just export the settings to the file given by -efuse_export_file.}
    option -svf_file -takes file_name \
           -detail {Create an SVF output file while programming the device, for use by third party tools.}
    option -efuse_export_file -takes file_name \
           -detail {Output file to store the programmed eFUSE settings, .json only for Spartan UltraScale+ and .nkz for all other devices.}
    option -disable_eos_check -detail {Disable the End of Startup check after programming.}
    option -skip_reset -detail {Skip resetting the device before programming.}
    option -force \
           -detail {Overwrite the specified SVF file or eFUSE file if one already exists; when given with -append, the -append option is ignored.}
    option -append -detail {Append the SVF output to the specified file rather than overwriting it.}
    option -type -takes file_type -values {bit bin rbt} -closed \
           -detail {The bitstream file type used for programming: a standard bitstream, a binary bitstream without header, or a raw ASCII bitstream.}
    option -mpsoc_reset -takes reset_mode -values {yes no auto} \
           -detail {System reset the MPSoC device before programming.}
    option -controls_efuse -takes control_bits \
           -detail {Space-separated list of control bits to set (Spartan UltraScale+ only).}
    option -efuse_json -takes file_name \
           -detail {JSON file path for eFUSE programming, with -select_efuse selecting which registers are written (Spartan UltraScale+ only).}
    option -select_efuse -takes register_names \
           -detail {Space-separated list of registers from the JSON file to write (Spartan UltraScale+ only).}
    option -freq_efuse -takes frequency \
           -detail {Frequency for eFUSE programming in Hz, defaulting to 0 (Spartan UltraScale+ only).}
    option -finalize_efuse \
           -detail {Required when programming PPK0, PPK1 or PPK2, or force-required control registers.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {program_hw_devices ?-key key_target? ?-clear? ?-skip_program_keys? ?-skip_program_rsa? ?-user_efuse hex_value? ?-user_efuse_128 hex_value? ?-control_efuse hex_value? ?-security_efuse hex_value? ?-only_export_efuse? ?-svf_file file_name? ?-efuse_export_file file_name? ?-disable_eos_check? ?-skip_reset? ?-force? ?-append? ?-type file_type? ?-mpsoc_reset reset_mode? ?-controls_efuse control_bits? ?-efuse_json file_name? ?-select_efuse register_names? ?-freq_efuse frequency? ?-finalize_efuse? ?-quiet? ?-verbose? ?hw_devices?}

    hover {
        summary {Program hardware devices.}
        synopsis {program_hw_devices ?-key key_target? ?-clear? ?-skip_program_keys? ?-skip_program_rsa? ?-user_efuse hex_value? ?-user_efuse_128 hex_value? ?-control_efuse hex_value? ?-security_efuse hex_value? ?-only_export_efuse? ?-svf_file file_name? ?-efuse_export_file file_name? ?-disable_eos_check? ?-skip_reset? ?-force? ?-append? ?-type file_type? ?-mpsoc_reset reset_mode? ?-controls_efuse control_bits? ?-efuse_json file_name? ?-select_efuse register_names? ?-freq_efuse frequency? ?-finalize_efuse? ?-quiet? ?-verbose? ?hw_devices?}
        description {Programs the specified hardware device object or objects on the open hardware target of the current hardware server, using the bitstream associated with the device through the PROGRAM.FILE property. Programming an encrypted bitstream is a two-step process, running the command once with -key to program the encryption key into the BBR or eFUSE registers and a second time to program the bitstream; the command can also generate a Serial Vector Format file for in-system and remote programming. If no device is specified, the current hardware device is programmed.}
        returns {Hardware devices.}
        example {program_hw_devices -key bbr -clear [current_hw_device]}
        source {Xilinx UG835 2026.1}
    }
}
command ptrace {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {ptrace ?-quiet? ?-verbose? value}

    hover {
        summary {Turn printing of the name of the HDL process being simulated on or off.}
        synopsis {ptrace ?-quiet? ?-verbose? value}
        description {Enables process tracing for simulation debugging in the Vivado integrated simulator, writing the name of each evaluated HDL process to the Tcl console along with the simulation source file and line number. A value of on, true or yes enables tracing; anything else sets it off, false or no. The same feature can be enabled with the PROCESS_TRACING property on the current simulation object.}
        returns {The state of process tracing, or an error if it fails.}
        example {ptrace true}
        source {Xilinx UG835 2026.1}
    }
}
command read_bd {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_bd ?-quiet? ?-verbose? files}

    hover {
        summary {Read one or more IP integrator design files.}
        synopsis {read_bd ?-quiet? ?-verbose? files}
        description {Reads the specified IP subsystem design files, or block designs, into the current project or the in-memory design, adding each block design file to the source fileset as it is read. Files are read and referenced from their current location and are not moved into the local project directories; use import_files instead to bring a file into the project.}
        returns {List of IP integrator design file objects that were added.}
        example {read_bd C:/Data/block_designs/design1.bd}
        source {Xilinx UG835 2026.1}
    }
}
command read_checkpoint {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -cell -takes cell_name \
           -detail {A black box cell in the current design to populate with the netlist data from the checkpoint being read; cannot be used with -incremental or its related options.}
    option -incremental \
           -detail {Load the checkpoint into an already open design to enable the incremental implementation flow, applying its placement and routing to matching netlist objects.}
    option -directive -takes directive -values {RuntimeOptimized TimingClosure Quick} -closed \
           -detail {The mode of behavior for the incremental process, defaulting to RuntimeOptimized.}
    option -auto_incremental \
           -detail {Enter automatic mode for incremental compile, using incremental algorithms only when the quality of the reference checkpoint is high; should not be used with -reuse_objects.}
    option -fix_objects -takes objects \
           -detail {With -incremental, mark the placement of the given cells, clock regions, SLRs or the current design as fixed so place_design cannot change it.}
    option -dcp_cell_list -takes cell_dcp_pairs \
           -detail {A list of cell and checkpoint pairs enclosed in curly braces, letting multiple checkpoints be read for specified cells in one run.}
    option -force_incr \
           -detail {With -incremental, force the incremental flow irrespective of the rule or ML based incremental criteria checks.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_checkpoint ?-cell cell_name? ?-incremental? ?-directive directive? ?-auto_incremental? ?-fix_objects objects? ?-dcp_cell_list cell_dcp_pairs? ?-force_incr? ?-quiet? ?-verbose? ?file?}

    hover {
        summary {Read a design checkpoint.}
        synopsis {read_checkpoint ?-cell cell_name? ?-incremental? ?-directive directive? ?-auto_incremental? ?-fix_objects objects? ?-dcp_cell_list cell_dcp_pairs? ?-force_incr? ?-quiet? ?-verbose? ?file?}
        description {Reads a design checkpoint file containing the netlist, the constraints, and optionally the placement and routing of an implemented design, without opening a design or project in memory. Use open_checkpoint to create a project from the checkpoint, or link_design after read_checkpoint to open the in-memory design. Reading with -incremental loads the physical data into the current design for incremental place and route; it does not merge two checkpoints into one design.}
        example {read_checkpoint -incremental C:/Data/routed.dcp}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command read_chipscope_cdc {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -reads

    form Default {read_chipscope_cdc file ?-quiet? ?-verbose?}

    hover {
        summary {Import a ChipScope Core Inserter CDC file.}
        synopsis {read_chipscope_cdc file ?-quiet? ?-verbose?}
        description {Reads a ChipScope Definition and Connection (CDC) file to associate with a Netlist Design in the current project. The file stores core parameters and core settings for ChipScope ILA debug cores, defining the debug core to insert, the signals to probe, and the clock domains for those signals, and can be written by the tool with write_chipscope_cdc. Parameters of the CDC file that are not acceptable to the current project, such as signals that do not exist in the current netlist, are ignored.}
        returns {Nothing.}
        example {read_chipscope_cdc C:/Data/FPGA_Design/bft.cdc}
        source {Xilinx UG835 2012.2}
    }
}
command read_csv {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet_diff_pairs \
           -detail {Suppress warnings about differential pair inference when importing I/O ports.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_csv ?-quiet_diff_pairs? ?-quiet? ?-verbose? file}

    hover {
        summary {Import package pin and port placement information.}
        synopsis {read_csv ?-quiet_diff_pairs? ?-quiet? ?-verbose? file}
        description {Imports port definitions and package pin placement information from a comma separated value file. In an I/O pin planning project the imported file replaces the current port definitions, and any design port not found in the file is removed; in all other projects the port definitions come from the source design and only the package pin assignments and port attributes are read. Ports read from the file cannot have spaces in their names.}
        example {read_csv C/Data/pinList.csv}
        source {Xilinx UG835 2026.1}
    }
}
command read_edif {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_edif ?-quiet? ?-verbose? files}

    hover {
        summary {Read one or more EDIF or NGC files.}
        synopsis {read_edif ?-quiet? ?-verbose? files}
        description {Imports an EDIF or NGC netlist file into the Design Source fileset of the current project. NGC format files are not supported for UltraScale devices; regenerate the IP with native output products, or migrate the NGC file to EDIF with the NGC2EDIF command before importing.}
        returns {List of file objects that were added.}
        example {read_edif C/Data/bft_top.edf}
        source {Xilinx UG835 2026.1}
    }
}
command read_hw_ila_data {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_hw_ila_data ?-quiet? ?-verbose? file}

    hover {
        summary {Read hardware ILA data from a file.}
        synopsis {read_hw_ila_data ?-quiet? ?-verbose? file}
        description {Reads ILA debug core sample data from the specified file, which was written by write_hw_ila_data after acquisition with upload_hw_ila_data, and creates a hw_ila_data object named after the file, adding a numbered extension if an object of that name already exists. The new object is not connected with or associated with any ILA debug cores in the design, and can be viewed in the waveform viewer with display_hw_ila_data. If the file extension is omitted, an extension of .ila is assumed.}
        returns {Name of the output file.}
        example {read_hw_ila_data C:/Data/hw_ila_data_2.ila}
        source {Xilinx UG835 2026.1}
    }
}
command read_hw_sio_scan {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_hw_sio_scan ?-quiet? ?-verbose? file ?hw_sio_scan?}

    hover {
        summary {Read hardware SIO scan data from a file.}
        synopsis {read_hw_sio_scan ?-quiet? ?-verbose? file ?hw_sio_scan?}
        description {Reads a hardware SIO scan data file, written by write_hw_sio_scan after running run_hw_sio_scan, and creates a hw_sio_scan object in the Hardware Manager. If no hw_sio_scan object is given, a new one is created and named sequentially after any existing scan objects; the data can then be plotted in the serial I/O analyzer with display_hw_sio_scan. If the file extension is omitted, an extension of .csv is assumed.}
        returns {Hardware SIO scan object.}
        example {read_hw_sio_scan C:/Data/LoopBack1.csv SCAN_0}
        source {Xilinx UG835 2026.1}
    }
}
command read_hw_sio_sweep {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_hw_sio_sweep ?-quiet? ?-verbose? directory ?hw_sio_sweep?}

    hover {
        summary {Read hardware SIO sweep data from a directory.}
        synopsis {read_hw_sio_sweep ?-quiet? ?-verbose? directory ?hw_sio_sweep?}
        description {Reads a hardware SIO sweep data directory containing multiple SIO scan data files, written by write_hw_sio_sweep after running run_hw_sio_sweep, and creates a hw_sio_sweep object in the Hardware Manager. If no hw_sio_sweep object is given, a new one is created and named sequentially after any existing sweep objects; any scan in the sweep can then be plotted in the serial I/O analyzer with display_hw_sio_scan.}
        returns {Hardware SIO sweep object.}
        example {read_hw_sio_sweep C:/Data/SWEEP_1/
display_hw_sio_scan [get_hw_sio_scans {SCAN_86}]}
        source {Xilinx UG835 2026.1}
    }
}
command read_ip {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_ip ?-quiet? ?-verbose? files}

    hover {
        summary {Read one or more IP files.}
        synopsis {read_ip ?-quiet? ?-verbose? files}
        description {Reads the specified XCI or XCO IP files and adds them by reference to the design and the current fileset, just as add_files does, so that the contents can be read into the in-memory design in Non Project mode. All output products associated with the IP core, including the design checkpoint, are read into the in-memory design; use import_ip instead to copy the files into the local project directory.}
        returns {List of IP file objects that were added.}
        example {read_ip C:/test_ip/char_fifo.xci}
        source {Xilinx UG835 2026.1}
    }
}
command read_iphys_opt_tcl {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fanout_opt \
           -detail {Apply the fanout optimizations, including very high fanout optimizations, defined in the script.}
    option -critical_cell_opt \
           -detail {Apply the cell-duplication based optimizations on timing critical nets defined in the script.}
    option -replicate_cell \
           -detail {Apply the atomic cell replication operations for interconnect retiming and LUT optimization.}
    option -reconnect \
           -detail {Reconnect loads from equivalent drivers for interconnect retiming and LUT optimization.}
    option -placement_opt \
           -detail {Apply the cell placement optimizations that move cells to reduce delay on timing-critical nets.}
    option -forward_retime -detail {Apply the forward retiming optimizations defined in the script.}
    option -backward_retime -detail {Apply the backward retiming optimizations defined in the script.}
    option -dsp_register_opt -detail {Apply the DSP register optimizations defined in the script.}
    option -bram_register_opt -detail {Apply the block RAM register optimizations defined in the script.}
    option -uram_register_opt -detail {Apply the UltraRAM register optimizations defined in the script.}
    option -shift_register_opt -detail {Apply the shift register optimizations defined in the script.}
    option -shift_register_to_pipeline \
           -detail {Apply the shift register to pipeline optimizations defined in the script.}
    option -auto_pipeline -detail {Apply the auto pipeline optimizations defined in the script.}
    option -pipeline_to_shift_register \
           -detail {Apply the pipeline to shift register optimizations defined in the script.}
    option -control_set_opt -detail {Apply the control set optimizations defined in the script.}
    option -critical_pin_opt -detail {Apply the pin swap optimizations defined in the script.}
    option -restruct_opt -detail {Apply the LUT restructuring optimizations defined in the script.}
    option -equ_drivers_opt -detail {Apply the equivalent driver rewiring defined in the script.}
    option -include_skipped_optimizations \
           -detail {Apply the optimizations that phys_opt_design identified but skipped, as well as the standard optimizations.}
    option -create_bufg -detail {Insert BUFGs to drive high fanout nets.}
    option -insert_negative_edge_ffs \
           -detail {Insert negative edge triggered flip-flops for high hold mitigation.}
    option -hold_fix -detail {Insert buffers for hold fix optimization.}
    option -slr_crossing_opt -detail {Optimize SLR crossing nets.}
    option -memory_rewire_opt -detail {Apply the memory rewire optimizations defined in the script.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_iphys_opt_tcl ?-fanout_opt? ?-critical_cell_opt? ?-replicate_cell? ?-reconnect? ?-placement_opt? ?-forward_retime? ?-backward_retime? ?-dsp_register_opt? ?-bram_register_opt? ?-uram_register_opt? ?-shift_register_opt? ?-shift_register_to_pipeline? ?-auto_pipeline? ?-pipeline_to_shift_register? ?-control_set_opt? ?-critical_pin_opt? ?-restruct_opt? ?-equ_drivers_opt? ?-include_skipped_optimizations? ?-create_bufg? ?-insert_negative_edge_ffs? ?-hold_fix? ?-slr_crossing_opt? ?-memory_rewire_opt? ?-quiet? ?-verbose? ?input?}

    hover {
        summary {Load an interactive physical optimization Tcl script and run it.}
        synopsis {read_iphys_opt_tcl ?-fanout_opt? ?-critical_cell_opt? ?-replicate_cell? ?-reconnect? ?-placement_opt? ?-forward_retime? ?-backward_retime? ?-dsp_register_opt? ?-bram_register_opt? ?-uram_register_opt? ?-shift_register_opt? ?-shift_register_to_pipeline? ?-auto_pipeline? ?-pipeline_to_shift_register? ?-control_set_opt? ?-critical_pin_opt? ?-restruct_opt? ?-equ_drivers_opt? ?-include_skipped_optimizations? ?-create_bufg? ?-insert_negative_edge_ffs? ?-hold_fix? ?-slr_crossing_opt? ?-memory_rewire_opt? ?-quiet? ?-verbose? ?input?}
        description {Reads an iphys_opt Tcl script written by write_iphys_opt_tcl and applies post-placement physical optimizations to the pre-placement netlist, so that placement can be rerun with the benefit of those optimizations. All optimizations in the script can be applied, or only the specific ones selected by the options, together with any optimizations that were defined but skipped during physical optimization.}
        returns {A transcript of the processes, or an error if it fails.}
        example {open_checkpoint C:/Data/opt_design.dcp
read_iphys_opt_tcl -shift_register_opt -placement_opt C:/Data/my_iphys_opt.tcl}
        source {Xilinx UG835 2026.1}
    }
}
command read_mem {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_mem ?-quiet? ?-verbose? files}

    hover {
        summary {Read one or more memory data files.}
        synopsis {read_mem ?-quiet? ?-verbose? files}
        description {Reads memory files of type MEM, DAT, or COE and adds them to the in-memory design or the current project, to initialize block RAM memory for behavioral simulation, synthesis and post-synthesis simulation. Memory that is not initialized in the design is initialized to all zeroes.}
        returns {List of file objects that were added.}
        example {read_mem    C:/Data/design1.mem}
        source {Xilinx UG835 2026.1}
    }
}
command read_noc_solution {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -no_update -detail {Do not run the NoC compiler after reading in the NoC solution.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_noc_solution ?-no_update? ?-quiet? ?-verbose? ?file?}

    hover {
        summary {Read a network on chip solution file.}
        synopsis {read_noc_solution ?-no_update? ?-quiet? ?-verbose? ?file?}
        description {Reads a network on chip solution file and runs the NoC compiler, unless -no_update is given. A block diagram, elaborated, synthesized or implemented design must be open before running this command.}
        example {read_noc_solution design_1_wrapper.ncr}
        source {Xilinx UG835 2026.1}
    }
}
command read_qor_suggestions {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_qor_suggestions ?-quiet? ?-verbose? file}

    hover {
        summary {Read QoR suggestions from a file.}
        synopsis {read_qor_suggestions ?-quiet? ?-verbose? file}
        description {Reads the specified file, typically ending with .rqs, and extracts the QoR suggestions it contains so they can be reported with report_qor_suggestions in the open design.}
        returns {The name of the QoR file read, or an error if it fails.}
        example {read_qor_suggestions C:/Data/qor_results.rqs}
        source {Xilinx UG835 2026.1}
    }
}
command read_saif {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -strip_path -takes instance_path \
           -detail {Strip the specified instance path prefix from elements in the SAIF file so they map properly onto instances in the current design.}
    option -no_strip -detail {Do not strip the first two levels of hierarchy from the SAIF file.}
    option -out_file -takes file_name \
           -detail {Output file where unmatched nets and other messages are reported during the import.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_saif ?-strip_path instance_path? ?-no_strip? ?-out_file file_name? ?-quiet? ?-verbose? file}

    hover {
        summary {Import simulation data in SAIF format.}
        synopsis {read_saif ?-strip_path instance_path? ?-no_strip? ?-out_file file_name? ?-quiet? ?-verbose? file}
        description {Reads a Switching Activity Interchange Format file for use during power analysis by report_power or power optimization by power_opt_design, annotating the design nodes with the activity from the file so that power is estimated appropriately. Running report_power or power_opt_design after reading the file uses those activity rates during optimization and analysis.}
        example {read_saif -strip_path design/top/F1 C:/Data/design1.saif}
        source {Xilinx UG835 2026.1}
    }
}
command read_schematic {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -name -takes window_title \
           -detail {The title of the Schematic window to open when reading the schematic file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_schematic ?-name window_title? ?-quiet? ?-verbose? file}

    hover {
        summary {Import a schematic file.}
        synopsis {read_schematic ?-name window_title? ?-quiet? ?-verbose? file}
        description {Imports a native schematic file that was previously exported from the Vivado Design Suite using the write_schematic command.}
        returns {Name of the file previously exported.}
        example {read_schematic C:/Data/mySchematic.txt -name Sheet_1}
        source {Xilinx UG835 2026.1}
    }
}
command read_twx {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -cell -takes cell_name \
           -detail {Interpret names in the report file as relative to the specified hierarchical cell, applying the timing paths to that cell.}
    option -pblock -takes pblock_name \
           -detail {Interpret names in the report file as relative to the specified Pblock.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_twx ?-cell cell_name? ?-pblock pblock_name? ?-quiet? ?-verbose? name file}

    hover {
        summary {Read timing results from the Trace STA tool.}
        synopsis {read_twx ?-cell cell_name? ?-pblock pblock_name? ?-quiet? ?-verbose? name file}
        description {Imports timing results from TWX format timing report files generated by the AMD Timing Reporter And Circuit Evaluator tool, at the top level by default or relative to a specified cell or Pblock. The first positional argument names the Timing Results view to create and the second names the TWX file; after import the results display in the Timing Results view in GUI mode.}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command read_vcd {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -strip_path -takes path \
           -detail {Strip the specified instance path prefix from elements in the VCD file so they map properly to instances in the current design.}
    option -no_strip \
           -detail {Do not strip the first two levels of hierarchy from the VCD file.}
    option -out_file -takes file_name \
           -detail {The name of an output file where unmatched nets and other messages are reported; without it the information is not saved to a file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -reads

    form Default {read_vcd ?-strip_path path? ?-no_strip? ?-out_file file_name? file ?-quiet? ?-verbose?}

    hover {
        summary {Import simulation data in VCD format.}
        synopsis {read_vcd ?-strip_path path? ?-no_strip? ?-out_file file_name? file ?-quiet? ?-verbose?}
        description {Reads a Value Change Dump (VCD) file for use during power analysis by the report_power command, annotating the design nodes with activity from the file so that running report_power afterwards uses its activity rates. Switching activity can also be read in the form of an SAIF file using the read_saif command.}
        returns {Nothing.}
        example {read_vcd C:/Data/design1.vcd}
        source {Xilinx UG835 2012.2}
    }
}
command read_verilog {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -library -takes library \
           -detail {The library the Verilog file should reference, ignored by Vivado synthesis and defaulting to the default library.}
    option -sv -detail {Read the files as a SystemVerilog compilation group.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_verilog ?-library library? ?-sv? ?-quiet? ?-verbose? files}

    hover {
        summary {Read one or more Verilog files.}
        synopsis {read_verilog ?-library library? ?-sv? ?-quiet? ?-verbose? files}
        description {Reads Verilog or SystemVerilog source files, adding each to the source fileset as it is read, so the contents can be read into the in-memory design in Non Project mode. Because SystemVerilog is a superset of Verilog this command reads both file types, but the -sv option is needed to compile in SystemVerilog mode; the tool creates a separate compilation unit for each file type, so a SystemVerilog file cannot be added to a Verilog compilation unit.}
        returns {List of file objects that were added.}
        example {read_verilog C:/Data/FPGA_Design/new_module.v}
        source {Xilinx UG835 2026.1}
    }
}
command read_vhdl {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    ;# NOTE(xilinx): the Syntax line and the Usage table both spell -library
    ;# unbracketed (required) while the Arguments prose calls it optional with a
    ;# default of xil_defaultlib; the syntax spelling is used for the form.
    option -library -takes library \
           -detail {The library the VHDL file should reference, defaulting to xil_defaultlib (required).}
    option -vhdl2008 -detail {Identify the files to be read as VHDL version 2008.}
    option -vhdl2019 -detail {Identify the files to be read as VHDL version 2019.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_vhdl -library library ?-vhdl2008? ?-vhdl2019? ?-quiet? ?-verbose? files}

    hover {
        summary {Read one or more VHDL files.}
        synopsis {read_vhdl -library library ?-vhdl2008? ?-vhdl2019? ?-quiet? ?-verbose? files}
        description {Reads VHDL source files, adding each to the source fileset as it is read and setting its Library property when -library is given, so the contents can be read into the in-memory design in Non Project mode.}
        returns {List of file objects that were added.}
        example {read_vhdl C:/Data/FPGA_Design/new_module.vhdl}
        source {Xilinx UG835 2026.1}
    }
}
command read_xdc {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -cells -takes cells \
           -detail {Apply the constraints from the file only to the specified cell instances, in which case the file is not added to the active constraint fileset.}
    option -ref -takes ref_name \
           -detail {Apply the constraints from the file to all instances of the referenced module wherever they are instantiated in the current design.}
    option -quiet_diff_pairs \
           -detail {Suppress warnings about differential pair inference when importing I/O constraints.}
    option -mode -takes mode -values {default out_of_context} -closed \
           -detail {Import the constraints as in-context with the top-level design or as out_of_context constraints for hierarchical modules and IP cores.}
    option -unmanaged \
           -detail {Treat the added files as unmanaged Tcl constraint files, which the tool will not save constraint changes back into.}
    option -no_add \
           -detail {Integrate the constraints into the in-memory design but do not add the file to the current constraint set.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {read_xdc ?-cells cells? ?-ref ref_name? ?-quiet_diff_pairs? ?-mode mode? ?-unmanaged? ?-no_add? ?-quiet? ?-verbose? files}

    hover {
        summary {Read physical and timing constraints from one or more files.}
        synopsis {read_xdc ?-cells cells? ?-ref ref_name? ?-quiet_diff_pairs? ?-mode mode? ?-unmanaged? ?-no_add? ?-quiet? ?-verbose? files}
        description {Imports physical and timing constraints from a Xilinx Design Constraints file into the current_instance level of the design hierarchy, which defaults to the top level, or into specified cells. When imported at the top level the file is added by reference to the active constraint fileset, as add_files does, rather than copied into the project directory. Constraints from the file overwrite any current constraints of the same name.}
        returns {List of files.}
        example {read_xdc file_1.xdc}
        source {Xilinx UG835 2026.1}
    }
}
command readback_hw_cfgmem {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -checksum \
           -detail {Read back and calculate a checksum for the bitstream from the device; cannot be used with -file.}
    option -force \
           -detail {Force the overwriting of the specified file if one of the same name already exists.}
    option -all -detail {Read back all the address locations on the configuration memory device.}
    option -offset -takes offset \
           -detail {Memory address offset value to begin reading back from, defaulting to 0x0.}
    option -file -takes file_name \
           -detail {Write the data read back from the hw_cfgmem object to the specified file, whose suffix should be .mcs or .bin to reflect the format (required).}
    option -format -takes format -values {mcs bin} -closed \
           -detail {File format of the readback file to create, defaulting to MCS.}
    option -datacount -takes datacount \
           -detail {The number of data units to read back, defaulting to all data from the offset address onward.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {readback_hw_cfgmem ?-checksum? ?-force? ?-all? ?-offset offset? -file file_name ?-format format? ?-datacount datacount? ?-quiet? ?-verbose? ?hw_cfgmems?}

    hover {
        summary {Read data back from a hardware configuration memory object.}
        synopsis {readback_hw_cfgmem ?-checksum? ?-force? ?-all? ?-offset offset? -file file_name ?-format format? ?-datacount datacount? ?-quiet? ?-verbose? ?hw_cfgmems?}
        description {Reads the programming data off the flash configuration memory device represented by the hw_cfgmem object and writes it to the specified file, to verify that the bitstream and any additional data files were properly programmed by program_hw_cfgmem. By default only the addresses defined by the PROGRAM.FILE property of the object are read back, subject to the -offset and -datacount options; the default object is the current hardware cfgmem.}
        example {readback_hw_cfgmem -format mcs \
   -file C:/Data/design1.mcs [current_hw_cfgmem]}
        source {Xilinx UG835 2026.1}
    }
}
command readback_hw_device {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -force \
           -detail {Force the overwriting of the specified file if one of the same name already exists.}
    option -capture \
           -detail {Enable readback capture of configuration data, which determines the content of user state elements, on UltraScale devices only.}
    option -readback_file -takes file_name \
           -detail {Write an ASCII readback file of the bitstream read from the device; not applicable for Versal.}
    option -bin_file -takes file_name \
           -detail {Write a binary file containing the programming data read back from the device.}
    option -readback_pdi -takes file_name \
           -detail {The readback PDI required to perform readback from a Versal part, generated with write_device_image.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {readback_hw_device ?-force? ?-capture? ?-readback_file file_name? ?-bin_file file_name? ?-readback_pdi file_name? ?-quiet? ?-verbose? ?hw_devices?}

    hover {
        summary {Read bitstream data back from hardware devices.}
        synopsis {readback_hw_device ?-force? ?-capture? ?-readback_file file_name? ?-bin_file file_name? ?-readback_pdi file_name? ?-quiet? ?-verbose? ?hw_devices?}
        description {Reads bitstream data from the current hardware device through the open target and writes it to the specified readback or binary file. Although both -readback_file and -bin_file are optional, one or both must be specified or the command has no output file to write to; readback is not permitted if the bitstream on the device is encrypted. If no device is specified, the current hardware device is used.}
        returns {Hardware devices.}
        example {readback_hw_device -readback_file C:/Data/readback_1.rbd [current_hw_device]}
        source {Xilinx UG835 2026.1}
    }
}
command redo {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -list -detail {Show a list of redoable tasks.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {redo ?-list? ?-quiet? ?-verbose?}

    hover {
        summary {Re-do a previously undone command.}
        synopsis {redo ?-list? ?-quiet? ?-verbose?}
        description {Redoes a command that has been previously undone, and can be used repeatedly to redo a series of commands; a command group created with startgroup and endgroup is redone as a sequence. The undo and redo commands are intended for use in the Vivado IDE and are not recommended in Tcl scripts for restoring designs to a former state, where write_checkpoint and read_checkpoint should be used instead.}
        returns {With -list, the list of redoable tasks.}
        example {redo -list}
        source {Xilinx UG835 2026.1}
    }
}
command refresh_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -part -takes part \
           -detail {The new target part for the design when it is reloaded, overriding the constraint file part in the project data on disk.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {refresh_design ?-part part? ?-quiet? ?-verbose?}

    hover {
        summary {Refresh the current design.}
        synopsis {refresh_design ?-part part? ?-quiet? ?-verbose?}
        description {Reloads the current design from the project data on the hard drive, overwriting the in-memory view of the design and so undoing any recent design changes.}
        example {refresh_design}
        source {Xilinx UG835 2026.1}
    }
}
command refresh_hw_axi {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

