    option -uphill -detail {Get the nodes uphill (driver) from the provided site_pin, node, or tiles.}
    option -downhill -detail {Get the nodes downhill (loads) from the provided site_pin, node, or tiles.}
    option -flyover -detail {Get the nodes that fly over the given tiles.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

