        synopsis {mark_objects ?-rgb rgb_list? ?-color color? objects ?-quiet? ?-verbose?}
        description {Marks the specified objects in GUI mode, placing an iconic mark to aid in locating them, displayed in the color determined by one of the color options. Objects can be unmarked with the unmark_objects command. Use only one color option; if both color options are specified, -rgb takes precedence over -color.}
        returns {Nothing.}
        example {mark_objects -color red [get_selected_objects]}
        source {Xilinx UG835 2012.2}
    }
}
command move_bd_cells {
