command generate_target {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -force \
           -detail {Force target data regeneration, overwriting existing target data files.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {generate_target ?-force? ?-quiet? ?-verbose? name objects}

    hover {
        summary {Generate target data for the specified source.}
        synopsis {generate_target ?-force? ?-quiet? ?-verbose? name objects}
        description {Generates the files needed to support an IP or block design through the FPGA design flow, for IP objects returned by get_ips or for source files such as .xci and .xco IP cores, .slx or .mdl DSP modules, and .bd block designs. The name argument lists the targets to generate, or all to generate every supported target except the example project; the standard values are all, instantiation_template, synthesis, simulation and implementation, while the targets an individual IP supports are listed in its SUPPORTED_TARGETS property or by list_targets. Without -force, target data that is up-to-date is not regenerated.}
        example {generate_target {instantiation_template synthesis} [get_ips]}
        source {Xilinx UG835 2026.1}
    }
}
command generate_vcd_ports {
