           -detail {Filter the results with an expression over HDL object property values such as NAME, SCOPE, or TYPE.}
    option -recursive -aliases {-r} \
           -detail {Apply the command to the current scope and all sub-scopes of the current scope.}
    option -regexp -detail {Search using regular expressions; items must be strings.}
    option -nocase -detail {Perform a case-insensitive match (only used with -regexp).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_objects ?-filter expr? ?-recursive|-r? ?-regexp? ?-nocase? ?-quiet? ?-verbose? ?patterns...?}

    hover {
        summary {Get a list of HDL objects in one or more HDL scopes as per the specified pattern.}
        synopsis {get_objects ?-filter expr? ?-recursive|-r? ?-regexp? ?-nocase? ?-quiet? ?-verbose? ?patterns...?}
        description {Returns a list of HDL objects matching the specified search pattern in one or more HDL scopes. HDL objects include HDL signals, variables, or constants as defined in the Verilog or VHDL testbench and source files. A pattern may be given as a bare pattern, matched in the current scope, or as scope/pattern, matched in the named scope relative to the current scope.}
        returns {All the objects found given the specified pattern.}
        example {current_scope ./cpuEngine
get_objects}
        source {Xilinx UG835 2012.2}
    }
}
