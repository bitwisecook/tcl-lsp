command generate_puf_kek {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Arguments prose marks -input_json and -output_json
    ;# (Required), but the Syntax line and the Usage table both bracket them; the
    ;# Usage table is taken as authoritative, so they are spelled optional here.
    option -input_json -takes file_name \
           -detail {Input JSON file path for PUF KEK generation, containing key and IV values in hexadecimal.}
    option -output_json -takes file_name \
           -detail {Output JSON file to store the generated PUF KEK settings.}
    option -force -detail {Overwrite the output file if it exists.}
    option -pufhd_file -takes file_name \
           -detail {Output text file to store the PUF HD data string.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Enable verbose debug output during PUF KEK generation.}

    form Default {generate_puf_kek ?-input_json file_name? ?-output_json file_name? ?-force? ?-pufhd_file file_name? ?-quiet? ?-verbose? ?hw_devices?}

    hover {
        summary {Perform PUF registration on a Spartan UltraScale+ device and write the result to a JSON file.}
        synopsis {generate_puf_kek ?-input_json file_name? ?-output_json file_name? ?-force? ?-pufhd_file file_name? ?-quiet? ?-verbose? ?hw_devices?}
        description {Generates PUF (Physically Unclonable Function) key material for the specified hardware device objects on the open hardware target of the current hardware server, using the unique physical characteristics of the device silicon. The output JSON contains the AES-encrypted black key, the red key encrypted using the internal PUF KEK and the user-supplied IV, along with PUF helper data (pufhd), PUF hash, PUF auxiliary data, PUF challenge hash, and PUF ID; the deprecated field pufkek is also emitted for backward compatibility. The PUF KEK itself is an internal device secret and is never exported. PUF-based keys are device-specific and cannot be used on a different device, even of the same part number.}
        returns {Hardware devices.}
        example {generate_puf_kek -input_json {C:/Data/puf_input.json} \
-output_json {C:/Data/puf_output.json} \
[current_hw_device]}
        source {Xilinx UG835 2026.1}
    }
}
