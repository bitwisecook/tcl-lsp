}
command update_ip_catalog {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -rebuild \
           -detail {Trigger a rebuild of the specified repository's index file, or rebuild all repositories if none is specified.}
    option -add_ip -takes ip \
           -detail {Add the specified IP into the specified repository, given as a path to the IP's component.xml or to a zip file containing the IP.}
    option -delete_ip -takes ip \
           -detail {Remove the specified IP from the specified repository, given as a path to the IP's component.xml or its VLNV.}
    option -repo_path -takes repo_path \
           -detail {The path of the repository to operate on, used in conjunction with -rebuild, -add_ip or -delete_ip.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_ip_catalog ?-rebuild? ?-add_ip ip? ?-delete_ip ip? ?-repo_path repo_path? ?-quiet? ?-verbose?}

    hover {
        summary {Update the IP catalog.}
        synopsis {update_ip_catalog ?-rebuild? ?-add_ip ip? ?-delete_ip ip? ?-repo_path repo_path? ?-quiet? ?-verbose?}
        description {Updates the IP catalog associated with the current design. The default IP catalog is found in the installation hierarchy of the tool, and custom IP is added by using set_property to set the IP_REPO_PATHS property of the current source fileset to the locations of that IP before running this command.}
        returns {True for success.}
        example {set_property ip_repo_paths C:/Data/IP_LIB [current_fileset]
update_ip_catalog -rebuild}
        source {Xilinx UG835 2012.2}
    }
}
