command config_ip_cache {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -use_cache_location -takes directory \
           -detail {Set the IP_OUTPUT_REPO property of the current project to the given directory, so that this location is used as the IP cache repository.}
    option -use_project_cache \
           -detail {Set the current project to use the default IP cache location inside the local project directory, restoring the default.}
    option -disable_cache \
           -detail {Disable the IP synthesis cache, which sets the IP_CACHE_PERMISSIONS property to disabled; re-enabling it requires setting that property again.}
    option -clear_output_repo \
           -detail {Delete from disk and from memory all cache entries in the cache designated by the current project, whether local or remote, with no prompt to confirm.}
    option -clear_local_cache \
           -detail {Delete from disk and from memory all local cache entries for this project.}
    option -cache_has_match \
           -detail {Return the cache-ID of the cache entry that would work for the specified IP instance, or the empty string.}
    option -cache_was_used \
           -detail {Return 1 if the cache was used to obtain the current synthesis results of the IP, else 0.}
    option -disable_for_ip \
           -detail {Disable cache usage for a specific IP instance.}
    option -enable_for_ip \
           -detail {Re-enable cache usage for a specific IP instance.}
    option -is_ip_disabled \
           -detail {Return 1 if cache usage is disabled for the specified IP instance, else 0.}
    option -get_id \
           -detail {Calculate and return the IP cache-ID string for the specified IP instance, which is derived from its configuration and from the current software version and settings.}
    option -get_entry_location -takes cache_id \
           -detail {Return the directory where the entry for this cache-ID is located.}
    option -disk_usage_output_repo \
           -detail {Return the total disk usage in MB of all cache entries in the IP output repository of the current project.}
    option -import_from_project \
           -detail {Import the existing synthesized IP of the current project into the cache, so that the results can be reused by other projects or design iterations.}
    option -zip_cache -takes zipfile \
           -detail {Zip all cache entries used by the IP instances of the current project into the named file; the return string lists any IP instance for which no cache entry was found.}
    option -remove \
           -detail {Remove the cache entry for the specified IP instance or cached instance, returning its cache-ID string if successful and blank otherwise.}
    option -purge \
           -detail {Delete all cache entries matching the types selected by -vlnv, -old_swvers, -unused, -num_days_old, -num_days_unused, -obs_synth_crc and -swver, returning the number of entries deleted; more than one type may be given at once.}
    option -vlnv -takes vlnv \
           -detail {The VLNV of the IP that the cache entries were created from, which may use a wildcard in one or more fields (only with -purge).}
    option -old_swvers \
           -detail {Delete cache entries created by a software version older than the one in use (only with -purge).}
    option -unused \
           -detail {Delete cache entries that have never been used (only with -purge).}
    option -swver -takes version \
           -detail {Delete cache entries created by the given software version, spelled as version.revision (only with -purge).}
    option -num_days_old -takes days \
           -detail {Delete cache entries that are this number of days old or older (only with -purge).}
    option -num_days_unused -takes days \
           -detail {Delete cache entries that have not been used for this number of days or longer (only with -purge).}
    option -obs_synth_crc \
           -detail {Delete cache entries whose component synthesis checksum differs from the current checksum of the IP catalog component (only with -purge).}
    option -report \
           -detail {Report cache statistics for the specified IP or cache object, or for the current cache location when none is given, covering the VLNV used to create the entry, how often and how recently it was used, and the synthesis runtime when it was created.}
    option -rptfile -takes file \
           -detail {The text file to write the cache statistics to (only with -report).}
    option -csvfile -takes file \
           -detail {The CSV file to write the cache statistics to in CSV format (only with -report).}
    option -dir -takes directory \
           -detail {The directory whose cache entries the statistics are reported for (only with -report).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_ip_cache ?-use_cache_location directory? ?-use_project_cache? ?-disable_cache? ?-clear_output_repo? ?-clear_local_cache? ?-cache_has_match? ?-cache_was_used? ?-disable_for_ip? ?-enable_for_ip? ?-is_ip_disabled? ?-get_id? ?-get_entry_location cache_id? ?-disk_usage_output_repo? ?-import_from_project? ?-zip_cache zipfile? ?-remove? ?-purge? ?-vlnv vlnv? ?-old_swvers? ?-unused? ?-swver version? ?-num_days_old days? ?-num_days_unused days? ?-obs_synth_crc? ?-report? ?-rptfile file? ?-csvfile file? ?-dir directory? ?-quiet? ?-verbose? ?ip?}

    hover {
        summary {Manage the IP instance synthesis cache.}
        synopsis {config_ip_cache ?-use_cache_location directory? ?-use_project_cache? ?-disable_cache? ?-clear_output_repo? ?-clear_local_cache? ?-cache_has_match? ?-cache_was_used? ?-disable_for_ip? ?-enable_for_ip? ?-is_ip_disabled? ?-get_id? ?-get_entry_location cache_id? ?-disk_usage_output_repo? ?-import_from_project? ?-zip_cache zipfile? ?-remove? ?-purge? ?-vlnv vlnv? ?-old_swvers? ?-unused? ?-swver version? ?-num_days_old days? ?-num_days_unused days? ?-obs_synth_crc? ?-report? ?-rptfile file? ?-csvfile file? ?-dir directory? ?-quiet? ?-verbose? ?ip?}
        description {Manages the out-of-context IP synthesis cache, in which the synthesis results of customized OOC IP are stored so that IP sharing a customization profile can share those results and shorten run time. The cache location is held in the IP_OUTPUT_REPO project property and may be inside the project or at an external location shared across projects, while the IP_CACHE_PERMISSIONS property, whose values are disabled, read, write, and read write, controls how the cache is used. Cache entries created by one software version are not viable in another, and local project caches are cleared automatically when a project is updated to a new release.}
        returns {A list of the entries in the IP synthesis cache when no options are given, or the value produced by the option that was given.}
        example {config_ip_cache -use_cache_location C:/Data/ip}
        source {Xilinx UG835 2026.1}
    }
}
command config_linter {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -rule -takes rule_id -detail {The linter rule ID to configure.}
    option -severity -takes severity -values {WARNING CRITICAL_WARNING ERROR} -closed \
           -detail {The severity of the linter rules; the default is WARNING.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_linter ?-rule rule_id? ?-severity severity? ?-quiet? ?-verbose?}

    hover {
        summary {Set the configuration of the RTL linter.}
        synopsis {config_linter ?-rule rule_id? ?-severity severity? ?-quiet? ?-verbose?}
        description {Configures the RTL linter by setting the severity reported for a linter rule.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command linter {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    form Default {linter files}

    hover {
        summary {Run the Vivado Tcl Store linter on Tcl script files.}
        synopsis {linter files}
        description {Runs the Vivado Tcl Store linter over the given Tcl script(s). The linter enforces the Tcl Store app rules — no global variables, mandatory meta-comments on every proc, explicit sub-namespace creation — and every error it reports must be fixed before an app can be submitted to the Tcl Store.}
        returns {Linter messages for each script.}
        source {Xilinx UG894 2026.1 (Vivado Tcl Store linter)}
    }
}
command config_timing_analysis {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -enable_input_delay_default_clock -takes value -values {true false} -closed \
           -detail {Launch SDC unclocked input delays from an internally defined clock; the default is false, and this option is not supported for UCF constraints.}
    option -enable_preset_clear_arcs -takes value -values {true false} -closed \
           -detail {Time paths through asynchronous preset or clear timing arcs, which are disabled by default, so that problems caused by the assertion of an asynchronous reset become visible.}
    option -ignore_io_paths -takes value -values {true false} -closed \
           -detail {Ignore paths from primary inputs and paths to primary outputs, which removes the net delay from the input port and to the output port from the timing path.}
    option -disable_flight_delays -takes value -values {true false} -closed \
           -detail {Do not add package delays to the I/O calculations.}
    option -merge_exceptions -takes value -values {true false} -closed \
           -detail {Allow or prevent the timing engine from merging timing exceptions.}
    option -timing_early_launch_at_borrowing_latches -takes value -values {auto true false} -closed \
           -detail {Remove clock latency pessimism from the launching enable of paths through transparent latches; the default of auto lets the timing engine decide, true compensates for optimism when CRPR is disabled, and false suits the default case where CRPR is enabled.}
    option -enable_time_borrowing_for_max_delay_exceptions -takes value -values {true false} -closed \
           -detail {Allow timing paths covered by set_max_delay timing exceptions to borrow time.}
    option -inter_slr_compensation -takes value -values {conservative relaxed} -closed \
           -detail {Choose between a conservative inter-SLR compensation mode with runtime and memory advantages and a relaxed mode with QoR advantages.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_timing_analysis ?-enable_input_delay_default_clock value? ?-enable_preset_clear_arcs value? ?-ignore_io_paths value? ?-disable_flight_delays value? ?-merge_exceptions value? ?-timing_early_launch_at_borrowing_latches value? ?-enable_time_borrowing_for_max_delay_exceptions value? ?-inter_slr_compensation value? ?-quiet? ?-verbose?}

    hover {
        summary {Configure general timing analysis settings.}
        synopsis {config_timing_analysis ?-enable_input_delay_default_clock value? ?-enable_preset_clear_arcs value? ?-ignore_io_paths value? ?-disable_flight_delays value? ?-merge_exceptions value? ?-timing_early_launch_at_borrowing_latches value? ?-enable_time_borrowing_for_max_delay_exceptions value? ?-inter_slr_compensation value? ?-quiet? ?-verbose?}
        description {Configures the general features of timing analysis, such as whether unclocked input delays are launched from an internal clock, whether asynchronous preset and clear arcs are timed, whether I/O paths and package flight delays are included, and how latch borrowing and inter-SLR compensation are handled.}
        returns {Nothing.}
        example {config_timing_analysis -disable_flight_delays true}
        source {Xilinx UG835 2026.1}
    }
}
command config_timing_corners {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table spells the corner values Slow and Fast while the
    ;# Arguments prose and the examples use slow and fast, so the set is left open.
    option -corner -takes corner -values {Slow Fast} \
           -detail {The timing corner to configure; without it the -delay_type applies to both corners.}
    option -delay_type -takes delay_type -values {none max min min_max} -closed \
           -detail {The type of path delays analyzed for the specified corner, where none excludes the corner from timing analysis.}
    option -setup \
           -detail {Enable the timing corner for setup analysis, which is equivalent to -delay_type max.}
    option -hold \
           -detail {Enable the timing corner for hold analysis, which is equivalent to -delay_type min.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_timing_corners ?-corner corner? ?-delay_type delay_type? ?-setup? ?-hold? ?-quiet? ?-verbose?}

    hover {
        summary {Configure single or multi corner timing analysis.}
        synopsis {config_timing_corners ?-corner corner? ?-delay_type delay_type? ?-setup? ?-hold? ?-quiet? ?-verbose?}
        description {Configures the Slow and Fast timing corners of the current design for single or multi-corner timing analysis, which requires a synthesized or implemented design to be open. Process, voltage and temperature together define a corner, with the fast corner representing the smallest process tolerances, highest voltage and lowest temperature and the slow corner the opposite. By default both corners are analyzed for setup and hold, and both must be configured to change or disable that quad analysis. Although -delay_type and -setup or -hold are all optional, one of them is required to configure a corner.}
        returns {Nothing.}
        example {config_timing_corners -corner slow -setup -hold
config_timing_corners -corner slow -delay_type min_max}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command config_webtalk {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -info \
           -detail {Show whether WebTalk is currently enabled or disabled; the state depends on both the user and install settings, and either one disabled disables WebTalk.}
    option -user -takes state -values {on off} -closed \
           -detail {Enable or disable WebTalk for the current user.}
    option -install -takes state -values {on off} -closed \
           -detail {Enable or disable WebTalk for all users of the current installation; when off, individual users cannot enable WebTalk with -user, and administrator rights may be needed.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_webtalk ?-info? ?-user state? ?-install state? ?-quiet? ?-verbose?}

    hover {
        summary {Enable or disable WebTalk, which sends software, IP and device usage statistics to Xilinx.}
        synopsis {config_webtalk ?-info? ?-user state? ?-install state? ?-quiet? ?-verbose?}
        description {WebTalk is a secure design data collection feature that reports how Xilinx FPGA devices, software, and IP are used. This command returns the current state of WebTalk for the current user and software installation and can enable or disable it; participation is voluntary except for the use of the WebPACK license to generate a bitstream, where transmission is mandatory and ignores the user and install preferences.}
        returns {Nothing.}
        example {config_webtalk -user on}
        source {Xilinx UG835 2012.2}
    }
}
command connect_bd_intf_net {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -intf_net -takes intf_net \
           -detail {The name of an existing interface net previously made by create_bd_intf_net, or of a new interface net to create; without it the IP integrator names the net automatically.}
    option -boundary_type -takes boundary_type -values {upper lower both} -closed \
           -detail {The search area for connecting to an interface pin of a hierarchical block: both, the default, searches the current level of hierarchy and downward, upper searches only the current level, and lower searches from the bottom of the hierarchy upward.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {connect_bd_intf_net ?-intf_net intf_net? ?-boundary_type boundary_type? ?-quiet? ?-verbose? object1 object2 ?auto?}

    hover {
        summary {Connect interface pins and interface ports in a block design.}
        synopsis {connect_bd_intf_net ?-intf_net intf_net? ?-boundary_type boundary_type? ?-quiet? ?-verbose? object1 object2 ?auto?}
        description {Connects the interface pins of an IP integrator cell to other interface pins or to external interface ports, an interface being a grouping of signals that share a common function. The command creates the interface net named by -intf_net, connects to an existing net of that name, or assigns a name when none is given.}
        returns {TCL_OK, or TCL_ERROR if it failed.}
        example {connect_bd_intf_net [get_bd_intf_pins clk_wiz_1/CLK_IN1_D] \
   [get_bd_intf_ports /diff_clock_rtl]}
        source {Xilinx UG835 2026.1}
    }
}
command connect_bd_net {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -net -takes net \
           -detail {The single net that all the objects connect to, which is created if it does not exist; it should not be given when the objects are at different levels of hierarchy, because the connection then results in several nets.}
    option -boundary_type -takes boundary_type -values {upper lower both} -closed \
           -detail {The search area for connecting to a pin of a hierarchical block: both, the default, searches the current level of hierarchy and downward, upper searches only the current level, and lower searches from the bottom of the hierarchy upward.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {connect_bd_net ?-net net? ?-boundary_type boundary_type? ?-quiet? ?-verbose? objects}

    hover {
        summary {Connect port and pin objects in a block design.}
        synopsis {connect_bd_net ?-net net? ?-boundary_type boundary_type? ?-quiet? ?-verbose? objects}
        description {Creates a new net in the current IP integrator subsystem design connecting the listed block design port and pin objects, which come from get_bd_ports and get_bd_pins, or connects an existing net to them. Pins and ports at different levels of the subsystem hierarchy can be connected, but -net cannot then be used because the completed connection consists of several nets.}
        returns {TCL_OK, or TCL_ERROR if it failed.}
        example {connect_bd_net [get_bd_pins /vidOut_1/locked] \
   [get_bd_pins /newMod1/bridge_1/fid]}
        source {Xilinx UG835 2026.1}
    }
}
command connect_debug_cores {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -master -takes master \
           -detail {A valid debug bridge or debug hub instance configured in From BSCAN To DebugHUB mode; only one master instance is allowed (required).}
    option -slaves -takes slaves \
           -detail {A list of one or more valid slave instances, which are ILA, VIO, or JTAG_to_AXI debug cores; a slave already connected to another master is first disconnected from it (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {connect_debug_cores -master master -slaves slaves ?-quiet? ?-verbose?}

    hover {
        summary {Connect debug slave instances to a debug master instance.}
        synopsis {connect_debug_cores -master master -slaves slaves ?-quiet? ?-verbose?}
        description {Connects debug slave instances to the specified master, adding them to an existing debug chain without affecting slaves already connected to it. Debug masters are the Debug Hub, which bridges the JTAG boundary scan interface of the device to the debug cores, and the Debug Bridge, which can also reach the cores remotely over Ethernet, PCIe or another Xilinx Virtual Cable transport. For partial reconfiguration designs the master and slaves must lie in the static region or in the same reconfigurable partition.}
        returns {Debug master and slave instances.}
        example {connect_debug_cores -master [get_cells inst_count/debug_bridge_0] \
-slaves [list [get_cells inst_count/ila_0] [get_cells inst_count/ila_1] ]}
        source {Xilinx UG835 2026.1}
    }
}
command connect_debug_port {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -channel_start_index -takes index \
           -detail {The channel index at which connections start to be added, numbered from 0; without it the tool uses the first available channel index.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {connect_debug_port ?-channel_start_index index? ?-quiet? ?-verbose? port nets}

    hover {
        summary {Connect nets and pins to debug port channels.}
        synopsis {connect_debug_port ?-channel_start_index index? ?-quiet? ?-verbose? port nets}
        description {Connects signals from the netlist design to a port on an ILA debug core created by create_debug_core, either at a specific channel index or on the first available channel; connecting more signals than the port has channels returns an error. The port is referenced as core_name/port_name, further ports are added with create_debug_port, port width is grown by setting the PORT_WIDTH property, and signals are removed with disconnect_debug_port. When the core is complete, implement_debug_core builds it for inclusion in the netlist.}
        returns {Nothing.}
        example {create_debug_port myCore PROBE
set_property PORT_WIDTH 8 [get_debug_ports myCore/PROBE1]
connect_debug_port myCore/PROBE1 [get_nets [list m0_ack_o m0_cyc_i \
   m0_err_o m0_rty_o m0_stb_i m0_we_i ]] -channel_start_index 2}
        source {Xilinx UG835 2026.1}
    }
}
command connect_hw_server {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -url -takes url \
           -detail {The URL of the running hw_server application, given as hostname:port_number; the default is localhost:3121.}
    option -cs_url -takes url \
           -detail {The URL to use for cs_server; when the default URL is used and no server is running there, cs_server is launched automatically on it. The default is localhost:3042.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {connect_hw_server ?-url url? ?-cs_url url? ?-quiet? ?-verbose?}

    hover {
        summary {Open a connection to a hardware server.}
        synopsis {connect_hw_server ?-url url? ?-cs_url url? ?-quiet? ?-verbose?}
        description {Connects to a hw_server that manages the connection to a physical programming target, which must be opened with the Hardware Manager first and must already be running as a separate application on the machine attached to the programmer or test board. One tool session can connect to several hardware servers, but only one connection per host name and port combination, and a second connection to the same server returns an error. The most recently connected server becomes the current one unless current_hw_server says otherwise, and disconnect_hw_server closes a connection.}
        returns {The host name of the hardware server that was connected.}
        example {connect_hw_server -url trumpet3:3121}
        source {Xilinx UG835 2026.1}
    }
}
command connect_net {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -hierarchical \
           -detail {Connect the net across different levels of the hierarchy; without it an attempt to connect to hierarchical pins fails with a warning.}
    option -basename -takes basename \
           -detail {A custom base name for the hierarchical nets and pins created to complete a connection across levels of hierarchy; without it the base name is derived from the net being connected.}
    option -net -takes net \
           -detail {The net to connect, one bit at a time for a bus; one of -net with -objects, -net_object_list, or -dict must be given.}
    option -objects -takes objects \
           -detail {The list of one or more pin or port objects to connect the net to; one of -net with -objects, -net_object_list, or -dict must be given.}
    option -net_object_list -takes net_object_pairs \
           -detail {A list of nets each followed by the pins and ports it connects to, which connects several nets in one command; nets, pins and ports may be named or given as objects.}
    option -dict -takes net_object_pairs \
           -detail {A faster alternative to -net_object_list, given as a list of net and pin or port pairs that must be objects rather than names.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-net -net_object_list}
    option_conflict {-net -dict}

    form Default {connect_net ?-hierarchical? ?-basename basename? ?-net net? ?-objects objects? ?-net_object_list net_object_pairs? ?-dict net_object_pairs? ?-quiet? ?-verbose?}

    hover {
        summary {Connect a net to pins or ports.}
        synopsis {connect_net ?-hierarchical? ?-basename basename? ?-net net? ?-objects objects? ?-net_object_list net_object_pairs? ?-dict net_object_pairs? ?-quiet? ?-verbose?}
        description {Connects a net to one or more pins or ports in the netlist of an open synthesized or implemented design, adding pins and hierarchical nets as needed to carry the connection across levels of hierarchy. Several nets and their pins and ports can be given at once with -net_object_list or -dict, which is significantly faster than repeated calls. Netlist editing changes only the in-memory view of the current design, which can be kept with write_checkpoint or exported with the write commands, and is not allowed on the elaborated RTL design.}
        returns {Nothing.}
        example {create_port -direction IN enableIn
create_pin -direction IN myDMA/en
create_net myEnable
connect_net -net myEnable -objects {enableIn myDMA/en}}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command convert_ip {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {convert_ip ?-quiet? ?-verbose? objects...}

    hover {
        summary {Convert a configurable IP from legacy to native IP.}
        synopsis {convert_ip ?-quiet? ?-verbose? objects...}
        description {Converts one or more legacy IP objects in the current project into native IP objects supported by Vivado; it does not convert IP in the catalog. Legacy IP can only be converted when a native IP of the same version also exists, and an error is returned if the specified IP is already native.}
        returns {List of files that were converted.}
        example {convert_ip [get_ips]}
        source {Xilinx UG835 2012.2}
    }
}
command convert_ips {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Force the conversion of IP that are currently locked (IS_LOCKED).}
    option -to_core_container \
           -detail {Convert existing expanded form IP into the core container format, ignoring IP already in that format.}
    option -from_core_container \
           -detail {Convert IP currently in the core container format into the expanded non-core container form, ignoring IP already in that form.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {convert_ips ?-force? ?-to_core_container? ?-from_core_container? ?-quiet? ?-verbose? objects}

    hover {
        summary {Convert specified IP to or from core container format.}
        synopsis {convert_ips ?-force? ?-to_core_container? ?-from_core_container? ?-quiet? ?-verbose? objects}
        description {Converts existing IP into the core container format, a compressed zip file that reduces the file structure in the design, or reverts core container IP into the expanded non-core container format. If neither -to_core_container nor -from_core_container is given the command converts each IP from its current format into the opposite form. User-managed IP cannot be converted, and locked IP requires -force.}
        returns {A transcript of its actions, or an error if it fails.}
        example {convert_ips -to_core_container [get_ips]}
        source {Xilinx UG835 2026.1}
    }
}
command convert_ngc {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -output_dir -takes output_dir \
           -detail {Directory to place all output; without it the output is placed beside the input NGC file.}
    option -format -takes format -values {Verilog EDIF} -closed \
           -detail {The desired output format, EDIF by default.}
    option -add_to_project \
           -detail {Add the output files to the current project; ignored when no project is open.}
    option -force \
           -detail {Force overwriting of files that already exist on disk, replacing files of the same name in the current project when -add_to_project is specified.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {convert_ngc ?-output_dir output_dir? ?-format format? ?-add_to_project? ?-force? ?-quiet? ?-verbose? files}

    hover {
        summary {Convert all provided NGC files to a supported format.}
        synopsis {convert_ngc ?-output_dir output_dir? ?-format format? ?-add_to_project? ?-force? ?-quiet? ?-verbose? files}
        description {Converts the provided NGC files to a supported format, EDIF or Verilog. This is a user-written application from the xilinxtclstore projutils category rather than a built-in Vivado command.}
        returns {Nothing.}
        example {convert_ngc ./test.ngc -add_to_project -verbose}
        source {Xilinx UG835 2026.1}
    }
}
command copy_bd_objs {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -prefix -takes prefix \
           -detail {A prefix name to apply to any cells that are copied into the hierarchical module.}
    option -from_design -takes design_name \
           -detail {The open IP integrator subsystem design that owns the specified objects; without it the objects come from the current design.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {copy_bd_objs ?-prefix prefix? ?-from_design design_name? ?-quiet? ?-verbose? parent_cell objects}

    hover {
        summary {Make copies of the objects and add the copies to the given hierarchical cell.}
        synopsis {copy_bd_objs ?-prefix prefix? ?-from_design design_name? ?-quiet? ?-verbose? parent_cell objects}
        description {Copies IP integrator objects from one open subsystem design into the top-level or an existing hierarchical module of a second subsystem design, where "/" names the top level. Because get_bd_cells and its relatives operate on the current subsystem design, the objects to copy must be stored in a Tcl variable before switching designs with current_bd_design, and -from_design must then name the source design; copying between levels of the current design needs no -from_design.}
        returns {0, or "" if it failed.}
        example {copy_bd_objs -from_design myDesign / $copyObjs}
        source {Xilinx UG835 2026.1}
    }
}
command copy_constraints {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -constrset -takes constrset \
           -detail {The constraint fileset from which files are copied.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {copy_constraints ?-constrset constrset? ?-quiet? ?-verbose? name}

    hover {
        summary {Create a copy of a given constraint set.}
        synopsis {copy_constraints ?-constrset constrset? ?-quiet? ?-verbose? name}
        description {Creates a copy of the given constraint set, copying the files of the fileset named by -constrset into a new constraint set called name.}
        returns {The copied constraint set object.}
        source {Xilinx UG835 2026.1}
    }
}
command copy_ip {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -name -takes name -detail {The name of the new IP to be created (required).}
    option -dir -takes dir \
           -detail {Path to an existing directory outside the local project in which to store the newly created IP.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {copy_ip -name name ?-dir dir? ?-quiet? ?-verbose? objects}

    hover {
        summary {Copy an existing IP.}
        synopsis {copy_ip -name name ?-dir dir? ?-quiet? ?-verbose? objects}
        description {Creates a copy of an IP core that has been previously instanced into the current project. Only a single IP core can be copied at one time, and it must be given as an IP object returned by get_ips rather than referenced by name; without -dir the new IP is added to the local project directory structure.}
        returns {The IP file object that was added to the project.}
        example {copy_ip -name newFIFO -dir C:/Data/new_IP [get_ips oldFIFO]}
        source {Xilinx UG835 2026.1}
    }
}
command copy_run {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -parent_run -takes parent_run \
           -detail {The synthesis run to use as the parent of a new implementation run, given as a run name or a run object; defaults to the same parent as the source run.}
    option -name -takes name -detail {The name of the new run (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {copy_run ?-parent_run parent_run? -name name ?-quiet? ?-verbose? run}

    hover {
        summary {Copy a run from an already existing run to a new copy of that run.}
        synopsis {copy_run ?-parent_run parent_run? -name name ?-quiet? ?-verbose? run}
        description {Copies an existing synthesis or implementation run, which can be given as a run name or as a run object returned by get_runs or current_run. This is a user-written application from the xilinxtclstore projutils category rather than a built-in Vivado command.}
        returns {The new run object.}
        example {copy_run -name synth_2 [get_runs synth_1]}
        source {Xilinx UG835 2026.1}
    }
}
command create_bd_addr_seg {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -range -takes range \
           -detail {Range, or size, of the address segment, given as a power-of-2 number of bits such as 4096 or an amount of memory such as 4K, 16M, or 1G (required).}
    option -offset -takes offset \
           -detail {Offset of the address segment, written as an integer or hexadecimal value such as 0x00000000 (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_bd_addr_seg -range range -offset offset ?-quiet? ?-verbose? ?parent_addr_space? ?slave_segment? name}

    hover {
        summary {Create a new address segment.}
        synopsis {create_bd_addr_seg -range range -offset offset ?-quiet? ?-verbose? ?parent_addr_space? ?slave_segment? name}
        description {Creates a new address segment object, bd_addr_seg, in the current IP integrator subsystem design. The parent_addr_space argument defines the parent address space of the segment and slave_segment maps a slave address segment of the master address segment being created.}
        returns {The newly created segment object, or "" if it failed.}
        example {create_bd_addr_seg -range 0x10000 -offset 0x41200000 \
   [get_bd_addr_spaces microblaze_1/Data] \
   [get_bd_addr_segs microblaze_1_axi_intc/s_axi/Reg] SEG1}
        source {Xilinx UG835 2026.1}
    }
}
command create_bd_cell {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -vlnv -takes vlnv \
           -detail {The Vendor:Library:Name:Version attribute of the cell to add from the IP integrator catalog.}
    option -type -takes type -values {IP hier container module inline_hdl} -closed \
           -detail {The kind of cell to create: an IP catalog core, a new empty hierarchical module, a block design container, a module referenced from an RTL source file, or an inline_hdl block; the default is IP.}
    option -reference -takes reference \
           -detail {Top module name or file path of the module referenced to create the cell.}
    option -revision -takes revision -detail {Core revision, -1 by default.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_bd_cell ?-vlnv vlnv? ?-type type? ?-reference reference? ?-revision revision? ?-quiet? ?-verbose? name}

    hover {
        summary {Add an IP cell from the IP catalog, or add a new hierarchical block.}
        synopsis {create_bd_cell ?-vlnv vlnv? ?-type type? ?-reference reference? ?-revision revision? ?-quiet? ?-verbose? name}
        description {Adds a cell from the Vivado Design Suite catalog to the current subsystem design, creates a new hierarchical module, or creates a module that references a module definition from an HDL source file. Use -vlnv when adding an IP core from the catalog, -type hier when creating a new hierarchical block design module, and -type module with -reference when creating a block design module that references an RTL module or entity declaration; either -vlnv or -type must be specified.}
        returns {The newly created cell object, or nothing if the command fails.}
        example {create_bd_cell -vlnv xilinx.com:ip:axi_fifo_mm_s:4.0 axi_fifo_1}
        source {Xilinx UG835 2026.1}
    }
}
command create_bd_design {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -dir -takes dir \
           -detail {Directory to write the block design file to, letting BD files be created and managed outside the current project directory structure.}
    option -cell -takes cell \
           -detail {A hierarchical bd_cell to use as the source of the new block design, given by instance name or as an object returned by get_bd_cells.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_bd_design ?-dir dir? ?-cell cell? ?-quiet? ?-verbose? name}

    hover {
        summary {Create a new design and its top level hierarchy cell with the same name.}
        synopsis {create_bd_design ?-dir dir? ?-cell cell? ?-quiet? ?-verbose? name}
        description {Creates an empty IP subsystem design module for use with the IP integrator and adds it to the source files of the current project, writing it by default to the project sources at a path derived from the given name.}
        returns {The newly created design object, or "" if it failed.}
        example {create_bd_design design_1}
        source {Xilinx UG835 2026.1}
    }
}
command create_bd_intf_net {
    available {tcl 8.5}
