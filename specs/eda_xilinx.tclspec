    ;# NOTE(xilinx): the Usage table spells the second mode "post-implementation"
    ;# while the Arguments prose and the section's example both spell it
    ;# post_implementation; the prose spelling is used here.
    option -mode -takes mode -values {behavioral post_implementation} -closed \
           -detail {Simulation mode, defaulting to behavioral.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_xsim ?-simset simset? ?-noclean_dir? ?-mode mode? ?-quiet? ?-verbose?}

    hover {
        summary {Launch simulation using XSim simulator.}
        synopsis {launch_xsim ?-simset simset? ?-noclean_dir? ?-mode mode? ?-quiet? ?-verbose?}
        description {Launches the Vivado integrated simulator. Launching it first runs xelab, the RTL elaborator, compiler, and linker used to create a simulation snapshot, and then launches the simulator on that snapshot; the command returns the transcript of xelab and xsim.}
        returns {Nothing.}
        example {launch_xsim -mode post_implementation}
        source {Xilinx UG835 2012.2}
    }
}
command limit_vcd {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -ports -detail {Control the extended VCD dump file.}
    option -file -takes file \
           -detail {The file whose ports have the dump file size limited; all dumpport files are limited by default.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {limit_vcd ?-ports? ?-file file? ?-quiet? ?-verbose? filesize}

    hover {
        summary {Limit the maximum size of the VCD file on disk, the equivalent of the dumplimit Verilog task.}
        synopsis {limit_vcd ?-ports? ?-file file? ?-quiet? ?-verbose? filesize}
        description {Specifies the size limit, in bytes, of the Value Change Dump file, operating like the Verilog dumplimit simulator directive. When the specified file size limit has been reached the dump process stops and a comment is inserted into the VCD file to indicate that the limit was reached. The open_vcd command must be run before this command.}
        example {limit_vcd 1000}
        source {Xilinx UG835 2026.1}
    }
}
command list_board_parameters {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {list_board_parameters ?-quiet? ?-verbose?}

    hover {
        summary {Get the list of parameters supported by board.xml file.}
        synopsis {list_board_parameters ?-quiet? ?-verbose?}
        description {Gets the list of parameters supported by the board.xml file of a board.}
        source {Xilinx UG835 2026.1}
    }
}
command list_features {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {list_features ?-quiet? ?-verbose?}

    hover {
        summary {List available features.}
        synopsis {list_features ?-quiet? ?-verbose?}
        description {Lists the available feature sets of the Vivado Design Suite that can be loaded with the load_features command. To reduce the memory footprint of the tool, groups of Tcl commands called features are unavailable until a command from that feature set is run or the feature is explicitly loaded. A feature that has been previously loaded is not listed as available to load.}
        returns {A list of features, or an error message.}
        example {list_features}
        source {Xilinx UG835 2026.1}
    }
}
command list_hw_samples {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {list_hw_samples ?-quiet? ?-verbose? ?hw_probe?}

    hover {
        summary {Return probe sample values.}
        synopsis {list_hw_samples ?-quiet? ?-verbose? ?hw_probe?}
        description {Writes data samples from the specified hw_probe object on the current hw_ila, where the probe is specified as an object returned by get_hw_probes. The number of captured samples returned equals the DATA_DEPTH property of the ILA core, 1024 samples by default, and the values are returned in the radix given by the DISPLAY_RADIX property of the probe. The values are listed to the standard output, or can be captured into a Tcl variable for post-processing or output to a file.}
        returns {Samples.}
        example {list_hw_samples [get_hw_probes *probe18]}
        source {Xilinx UG835 2026.1}
    }
}
command list_param {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {list_param ?-quiet? ?-verbose?}

    hover {
        summary {Get all parameter names.}
        synopsis {list_param ?-quiet? ?-verbose?}
        description {Gets a list of the user-definable configuration parameters, which configure a variety of settings and behaviors of the tool. Use report_param for more information on a specific parameter, which returns a description of the parameter as well as its current value.}
        returns {A list of the user-definable configuration parameters.}
        example {list_param}
        source {Xilinx UG835 2026.1}
    }
}
command list_property {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -class -takes class \
           -detail {Return the properties of the specified class instead of a specific object; the class argument is case sensitive and cannot be used together with an object.}
    option -regexp -detail {Treat the pattern as a regular expression.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {list_property ?-class class? ?-regexp? ?-quiet? ?-verbose? ?object? ?pattern?}

    hover {
        summary {List properties of object.}
        synopsis {list_property ?-class class? ?-regexp? ?-quiet? ?-verbose? ?object? ?pattern?}
        description {Gets a list of all properties on a specified object or class of objects. Only one object may be given, or an error is returned. The pattern applies to the property name and defaults to the wildcard character, which returns every property; the search pattern is case sensitive and most properties are upper case. The report_property command also returns a list of properties but reports the property type and value as well.}
        returns {List of property names.}
        example {list_property [get_cells cpuEngine]}
        source {Xilinx UG835 2026.1}
    }
}
command list_property_value {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -default -detail {Show only the default value for the specified class of objects.}
    option -class -takes class \
           -detail {Return the property values of the specified class instead of a specific object; the class argument is case sensitive and cannot be used together with an object.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {list_property_value ?-default? ?-class class? ?-quiet? ?-verbose? name ?object?}

    hover {
        summary {List legal property values of object.}
        synopsis {list_property_value ?-default? ?-class class? ?-quiet? ?-verbose? name ?object?}
        description {Gets a list of valid values for an enumerated type property of either a class of objects or a specific object. Only properties with an enumerated value or a predefined value set can be queried; use report_property to identify which properties are enumerated. Only one object may be given, or an error is returned.}
        returns {List of property values.}
        example {list_property_value KEEP_HIERARCHY -class cell}
        source {Xilinx UG835 2026.1}
    }
}
command list_targets {
