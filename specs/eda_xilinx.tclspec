        summary {Get a list of hardware SIO GT groups.}
        synopsis {get_hw_sio_gtgroups ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the groups of GTs, hw_sio_gtgroups, as they relate to the quads that are in use on the IBERT debug core on the current hardware device. GT groups relate to the I/O banks on the device, with the number of available banks and GT pins determined by the target device; each GT pin has its own transmitter and receiver, and a quad can also include one shared Quad PLL. The quads are defined on the IBERT debug core and can be customized when the IBERT is added into the RTL design.}
        returns {Hardware SIO GT groups.}
        example {get_hw_sio_gtgroups -of [get_hw_sio_gts *MGT_X0Y9]}
        source {Xilinx UG835 2026.1}
    }
}
command get_hw_sio_gts {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects \
