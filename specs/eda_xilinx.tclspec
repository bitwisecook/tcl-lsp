    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_marked_objects ?-rgb rgb_list? ?-color color? ?-quiet? ?-verbose?}

    hover {
        summary {Get marked objects.}
        synopsis {get_marked_objects ?-rgb rgb_list? ?-color color? ?-quiet? ?-verbose?}
        description {Gets the objects marked with the mark_objects command in the current design open in the Vivado IDE; all marked objects can be returned, or only those marked in a specified color or RGB value. This Tcl command works only when Vivado is run in GUI mode.}
        returns {A list of marked objects.}
        example {get_marked_objects -color yellow}
        source {Xilinx UG835 2026.1}
    }
}
