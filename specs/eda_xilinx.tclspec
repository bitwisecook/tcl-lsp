command report_carry_chains {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -max_chains -takes count \
           -detail {Number of chains for which the report is to be generated, defaulting to the single longest carry chain.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_carry_chains ?-file file_name? ?-append? ?-return_string? ?-max_chains count? ?-quiet? ?-verbose?}

    hover {
        summary {Report carry chains.}
        synopsis {report_carry_chains ?-file file_name? ?-append? ?-return_string? ?-max_chains count? ?-quiet? ?-verbose?}
        description {Reports the details of the carry chains used by the current open design, including the average depth of all carry chains as well as the specific depth of each carry chain reported. By default the longest carry chain is reported, but the number of chains reported can be specified with -max_chains.}
        returns {The carry chain report.}
        example {report_carry_chains -max_chains 10}
        source {Xilinx UG835 2012.2}
    }
}
command report_clock_interaction {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -delay_type -takes delay_type -values {max min min_max} -closed \
           -detail {Type of path delay to analyze, defaulting to max.}
    option -setup \
           -detail {Consider max delay timing paths, equivalent to -delay_type max.}
    option -hold \
           -detail {Consider min delay timing paths, equivalent to -delay_type min.}
    option -significant_digits -takes digits \
           -detail {Number of significant digits to display, in the range 0 to 13, defaulting to 2.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -name -takes name \
           -detail {Output the results to the GUI panel with this name, closing and reopening a Report view that already uses the name.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_clock_interaction ?-delay_type delay_type? ?-setup? ?-hold? ?-significant_digits digits? ?-file file_name? ?-append? ?-name name? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report on inter clock timing paths and unclocked registers.}
        synopsis {report_clock_interaction ?-delay_type delay_type? ?-setup? ?-hold? ?-significant_digits digits? ?-file file_name? ?-append? ?-name name? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports clock interactions and signals that cross clock domains, giving visibility into paths that can cause metastability, data loss, or incoherency. This command requires an open synthesized or implemented design. By default the report is written to the Tcl console or standard output, but the results can also be written to a file or returned as a string. Note -setup and -hold can be specified together, which is the same as specifying -delay_type min_max.}
        returns {Nothing.}
        example {report_clock_interaction -delay_type min_max -significant_digits 3 -name "results_1"}
        source {Xilinx UG835 2012.2}
    }
}
command report_clock_networks {
    dialects tcl8.5
    required_package vivado

