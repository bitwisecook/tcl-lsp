# tcl-lsp — bundled SpecTcl loadable: the AMD/Xilinx Vivado tool commands.
#
# This pack IS the source of truth for these commands. The Rust modules that
# used to hold them (rust/tcl-registry/src/commands/eda_xilinx/) were deleted when
# the EDA vendor libraries migrated to bundled `.tclspec` loadables, per
# docs/design/spec-packs.md ("the EDA vendor libraries ship as bundled
# `.tclspec` loadables … so the loader path is exercised in production from day
# one rather than reserved for private packs"). Every command was proved
# field-for-field equal to its compiled spec by the SpecTcl round-trip gate
# before the modules were removed.
#
# Discovery: the **bundled** tier — `specs/` beside the server executable, or
# wherever $TCL_LSP_SPEC_PACK_DIR points (rust/tcl-spectcl/src/discovery.rs).
# Edit this file to change the specs; there is no generator to re-run.
# Syntax: docs/design/spec-dsl-examples/README.md. The initial text was written
# by the spec studio's SpecTcl renderer (rust/tcl-spec-studio/src/render_spectcl.rs)
# from the registry modules, which reported no unwritable field on any command
# here; this file is hand-maintained from now on.
#
# Expanded to the full UG835 command surface for issue #1560's follow-on EDA
# coverage work: blocks whose `source` cites UG835 2012.2 were authored from
# the complete "Vivado Design Suite Tcl Command Reference Guide" of that
# release (supplied by the requester), with full option rows; blocks citing
# UG835 2026.1 or F5 carry newer per-command corrections and win where the
# two disagree. The SDC-shared constraint/query commands live in sdc_base,
# which rides along with the xilinx-eda-tcl profile.

speclib eda_xilinx 1.0 {

command add_bp {
    dialects tcl8.5
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_bp ?-quiet? ?-verbose? file_name line_number}

    hover {
        summary {Add a breakpoint at a line of a source file.}
        synopsis {add_bp ?-quiet? ?-verbose? file_name line_number}
        description {Adds a breakpoint at line_number of the file file_name in the Vivado integrated simulator. If a breakpoint is already set at the specified file line, the existing breakpoint object is returned instead of a new one.}
        returns {A new breakpoint object if there is not already a breakpoint set at the specified file line, else the existing breakpoint object.}
        source {Xilinx UG835 2012.2}
    }
}
command add_cells_to_pblock {
    dialects tcl8.5
    required_package vivado

    arity 2..

    option -add_primitives \
           -detail {Assign all primitives of the specified instances to the Pblock, so a block module can be given and every instance within it assigned.}
    option -clear_locs \
           -detail {Clear instance location constraints for cells that are already placed; without it, placed instances keep their placement as they are added.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_cells_to_pblock ?-add_primitives? ?-clear_locs? ?-quiet? ?-verbose? pblock cells...}

    hover {
        summary {Add cells to a Pblock.}
        synopsis {add_cells_to_pblock ?-add_primitives? ?-clear_locs? ?-quiet? ?-verbose? pblock cells...}
        description {Adds the specified logic instances to a Pblock. Once cells have been added, the Pblock can be placed onto the fabric of the FPGA with place_pblocks, moved and resized with resize_pblock, and instances can be taken back out with remove_cells_from_pblock.}
        returns {Nothing.}
        example {create_pblock pb_cpuEngine
add_cells_to_pblock pb_cpuEngine [get_cells cpuEngine] -add_primitives -clear_locs}
        source {Xilinx UG835 2012.2}
    }
}
command add_condition {
    dialects tcl8.5
    required_package vivado

    arity 2..

    option -name -takes name \
           -detail {Assign a unique name or label to the condition; two conditions cannot share a name, and without it a default label named as the condition id is created.}
    option -radix -takes radix -values {default dec bin oct hex unsigned ascii} -closed \
           -detail {Specifies which radix to use.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_condition ?-name name? ?-radix radix? ?-quiet? ?-verbose? condition_expression commands}

    hover {
        summary {Add a condition to the simulation that runs commands when its expression is true.}
        synopsis {add_condition ?-name name? ?-radix radix? ?-quiet? ?-verbose? condition_expression commands}
        description {Adds a condition to the Vivado integrated simulator so that, upon the condition expression being true, the given commands are executed.}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
command add_files {
    dialects tcl8.5
    required_package vivado

    form Default {add_files ?-fileset fileset? ?-of_objects objects? ?-norecurse? ?-copy_to dir? ?-force? ?-scan_for_includes? file_list}

    hover {
        summary {Add source files (HDL, netlist, memory-init) to a project fileset.}
        synopsis {add_files ?-fileset fileset? ?-of_objects objects? ?-norecurse? ?-copy_to dir? ?-force? ?-scan_for_includes? file_list}
        source {Xilinx UG835 2026.1}
    }
}
command add_force {
    dialects tcl8.5
    required_package vivado

    arity 2..

    option -radix -takes radix -values {default dec bin oct hex unsigned ascii} -closed \
           -detail {Specifies which radix to use.}
    option -repeat_every -takes duration -detail {Repeat the force every time duration.}
    option -cancel_after -takes offset -detail {Cancel the force after the given time offset.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_force ?-radix radix? ?-repeat_every duration? ?-cancel_after offset? ?-quiet? ?-verbose? hdl_object values...}

    hover {
        summary {Add a force to a simulation.}
        synopsis {add_force ?-radix radix? ?-repeat_every duration? ?-cancel_after offset? ?-quiet? ?-verbose? hdl_object values...}
        description {Adds a force on the specified HDL object in the Vivado integrated simulator. Each value word adds a value and an optional time offset to the force.}
        returns {The force objects added.}
        source {Xilinx UG835 2012.2}
    }
}
command add_wave {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -into -takes wcfg_object \
           -detail {The wave configuration, group, or virtual bus into which the new wave objects are inserted; a string is looked up as a group name, then a virtual bus name, then any wave configuration object name, and without it the current wave configuration is assumed.}
    option -at_wave -takes wave_object \
           -detail {Add the new wave objects at the given wave object; a string is treated as the display name of a wave object.}
    option -after_wave -takes wave_object \
           -detail {Add the new wave objects after the given wave object; a string is treated as the display name of a wave object.}
    option -before_wave -takes wave_object \
           -detail {Add the new wave objects before the given wave object; a string is treated as the display name of a wave object.}
    option -reverse -detail {Set the IS_REVERSED property of the new wave objects to true.}
    option -radix -takes radix -values {default dec bin oct hex unsigned ascii} -closed \
           -detail {Set the radix property of the new wave objects.}
    option -color -takes color \
           -detail {Set the color property of the new wave objects to a pre-defined color name or a six-digit RGB value.}
    option -name -takes custom_name \
           -detail {Set the DISPLAY_NAME property of the new wave object; it is an error for more than one new wave object to be created.}
    option -recursive \
           -detail {If a design object is a scope, create wave objects for all design objects under that scope.}
    option -r \
           -detail {If a design object is a scope, create wave objects for all design objects under that scope.}
    option -regexp \
           -detail {Search design objects by name using regular expressions, in which case items must be strings.}
    option -nocase -detail {Perform a case-insensitive match (only with -regexp).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-reverse? ?-radix radix? ?-color color? ?-name custom_name? ?-recursive? ?-r? ?-regexp? ?-nocase? ?-quiet? ?-verbose? items...}

    hover {
        summary {Create one or more design-based wave objects in the simulation waveform.}
        synopsis {add_wave ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-reverse? ?-radix radix? ?-color color? ?-name custom_name? ?-recursive? ?-r? ?-regexp? ?-nocase? ?-quiet? ?-verbose? items...}
        description {Creates one or more new design-based wave objects and reports the name of each newly created wave object. This command can only be used when running a simulation; at a minimum an item must be given, which is an HDL object or signal within the simulation project.}
        returns {Nothing.}
        example {add_wave clk}
        source {Xilinx UG835 2012.2}
    }
}
command add_wave_divider {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -into -takes wcfg_object \
           -detail {The wave configuration, group, or virtual bus into which the new wave divider is inserted; a string is looked up as a group name, then a virtual bus name, then any wave configuration object name, and without it the current wave configuration is assumed.}
    option -at_wave -takes wave_object \
           -detail {Add the wave divider at the given wave object; a string is treated as the display name of a wave object.}
    option -after_wave -takes wave_object \
           -detail {Add the wave divider after the given wave object; a string is treated as the display name of a wave object.}
    option -before_wave -takes wave_object \
           -detail {Add the wave divider before the given wave object; a string is treated as the display name of a wave object.}
    option -color -takes color \
           -detail {Set the color property of the new wave object to a pre-defined color name or a six-digit RGB value.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave_divider ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-color color? ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Create a wave divider in the waveform viewer.}
        synopsis {add_wave_divider ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-color color? ?-quiet? ?-verbose? ?name?}
        description {Creates a wave divider to separate groups of related objects for easier viewing, inserted into a specified or current waveform configuration at the specified location, or at the end when no location is given. The default display name is new_divider, and this command can only be used when running a simulation.}
        returns {Nothing.}
        example {add_wave_divider -after_wave CLK Div1}
        source {Xilinx UG835 2012.2}
    }
}
command add_wave_group {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -into -takes wcfg_object \
           -detail {The wave configuration or group into which the new wave group is inserted; a string is looked up as a group name, then a virtual bus name, then any wave configuration object name, and without it the current wave configuration is assumed.}
    option -at_wave -takes wave_object \
           -detail {Add the wave group at the given wave object; a string is treated as the display name of a wave object.}
    option -after_wave -takes wave_object \
           -detail {Add the wave group after the given wave object; a string is treated as the display name of a wave object.}
    option -before_wave -takes wave_object \
           -detail {Add the wave group before the given wave object; a string is treated as the display name of a wave object.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave_group ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Create a wave group in a waveform configuration.}
        synopsis {add_wave_group ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-quiet? ?-verbose? ?name?}
        description {Creates a wave group in a specified or current waveform configuration, into which new wave objects and wave dividers can be added to build up the waveform display. The group is inserted at the specified location, or at the end when none is given; the default display name is new_group, and this command can only be used when running a simulation.}
        returns {Nothing.}
        example {add_wave_group clk}
        source {Xilinx UG835 2012.2}
    }
}
command add_wave_marker {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -into -takes wcfg \
           -detail {The wave configuration object in which to create the marker; without it the marker is added to the current wave configuration.}
    option -name -takes name -detail {Create a marker with the specified name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave_marker ?-into wcfg? ?-name name? ?-quiet? ?-verbose? ?time? ?unit?}

    hover {
        summary {Create a wave marker at a simulation time in the current waveform configuration.}
        synopsis {add_wave_marker ?-into wcfg? ?-name name? ?-quiet? ?-verbose? ?time? ?unit?}
        description {Creates a wave marker at the given simulation runtime within the waveform, defaulting to time 0. The allowable time units are s, ms, us, ns, and ps, defaulting to the time unit used in the specified waveform configuration; this command can only be used when running a simulation.}
        returns {Nothing.}
        example {add_wave_marker 500 ns}
        source {Xilinx UG835 2012.2}
    }
}
command add_wave_virtual_bus {
    dialects tcl8.5
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Arguments prose also carries a -name customName row, but
    ;# neither the Syntax line nor the Usage table lists it for this command, so
    ;# it is read as carry-over from add_wave and omitted.
    option -into -takes wcfg_object \
           -detail {The wave configuration, group, or virtual bus into which the new virtual bus is inserted; a string is looked up as a group name, then a virtual bus name, then any wave configuration object name, and without it the current wave configuration is assumed.}
    option -at_wave -takes wave_object \
           -detail {Add the virtual bus at the given wave object; a string is treated as the display name of a wave object.}
    option -after_wave -takes wave_object \
           -detail {Add the virtual bus after the given wave object; a string is treated as the display name of a wave object.}
    option -before_wave -takes wave_object \
           -detail {Add the virtual bus before the given wave object; a string is treated as the display name of a wave object.}
    option -reverse -detail {Set the IS_REVERSED property of the new wave object to true.}
    option -radix -takes radix -values {default dec bin oct hex unsigned ascii} -closed \
           -detail {Set the radix property of the new wave object.}
    option -color -takes color \
           -detail {Set the color property of the new wave object to a pre-defined color name or a six-digit RGB value.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave_virtual_bus ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-reverse? ?-radix radix? ?-color color? ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Create a new virtual bus in a waveform configuration.}
        synopsis {add_wave_virtual_bus ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-reverse? ?-radix radix? ?-color color? ?-quiet? ?-verbose? ?name?}
        description {Creates a new virtual bus, inserted by the specified name where specified or by default at the end of the existing waveform, and reports a vb identifier for the newly created virtual bus. This command can only be used when running a simulation.}
        returns {Nothing.}
        example {add_wave_virtual_bus dout_tvalid}
        source {Xilinx UG835 2012.2}
    }
}
command all_cpus {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {all_cpus ?-quiet? ?-verbose?}

    hover {
        summary {Get a list of cpu cells in the current design.}
        synopsis {all_cpus ?-quiet? ?-verbose?}
        description {Returns a list of all CPU cell objects that have been declared in the current design, which can be assigned to a variable or passed into another command.}
        returns {List of cpu cell objects.}
        example {set_false_path -from [all_cpus] -to [all_registers]}
        source {Xilinx UG835 2012.2}
    }
}
