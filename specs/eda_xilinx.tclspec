command import_synplify {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -copy_sources \
           -detail {Copy all the sources from the Synplify project file into the created project rather than referencing them.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {import_synplify ?-copy_sources? ?-quiet? ?-verbose? file}

    hover {
        summary {Imports the given Synplify project file.}
        synopsis {import_synplify ?-copy_sources? ?-quiet? ?-verbose? file}
        description {Imports Synplify synthesis project files (.prj) into the current project, including the various source files used in the synthesis run. The default is to reference source files from their current location.}
        returns {List of file objects that were imported from the Synplify file.}
        example {create_project syn_test C:/Data/FPGA_Design/syn_test
import_synplify -copy_sources C:/Data/syn_data.prj}
        source {Xilinx UG835 2012.2}
    }
}
command import_xise {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -copy_sources \
           -detail {Copy all ISE sources into the created project rather than referencing them from their current location.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {import_xise ?-copy_sources? ?-quiet? ?-verbose? file}

    hover {
        summary {Import XISE project file settings into the created project.}
        synopsis {import_xise ?-copy_sources? ?-quiet? ?-verbose? file}
        description {Imports an ISE project file (XISE) into the current project so that ISE projects can be migrated for synthesis, simulation, and implementation. All project source files, constraint files, simulation files, and run settings are imported and recreated in the current project, so the command should be run on a new empty project.}
        returns {True.}
        source {Xilinx UG835 2012.2}
    }
}
