        synopsis {current_hw_server ?-quiet? ?-verbose? ?hw_server?}
        description {Defines the current hardware server from the list of servers connected to the Vivado Design Suite, or returns the currently connected hw_server object. Hardware servers are instances of the AMD hw_server application running locally or remotely and are connected with connect_hw_server; the server can be given by name or as an object returned by get_hw_servers. There is usually a current server defined, but disconnecting it leaves none until a new one is set.}
        returns {Hardware server.}
        example {current_hw_server picasso}
        source {Xilinx UG835 2026.1}
    }
}
command current_hw_target {
    available {tcl 8.5}
    required_package vivado

