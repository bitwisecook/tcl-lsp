        summary {Get or set the current hardware device.}
        synopsis {current_hw_device ?-quiet? ?-verbose? ?hw_device?}
        description {Sets or returns the current AMD FPGA targeted by the Hardware Manager for programming and debug. Each hardware target can hold one or more devices; the device must be specified as an object returned by get_hw_devices. Access to a device follows the sequence open_hw, connect_hw_server, current_hw_target, open_hw_target, and current_hw_device, and care should be taken that the current server, target, and device stay in sync.}
        returns {Hardware device.}
        example {current_hw_device}
        source {Xilinx UG835 2026.1}
    }
}
command current_hw_ila {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

