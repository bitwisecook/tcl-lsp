        synopsis {start_vcd ?-ports? ?-file file_name? ?-quiet? ?-verbose?}
        description {Specifies that the tool start writing Value Change Dump information into the specified VCD object, modeling the behavior of the Verilog dumpon system task. This can be used after a stop_vcd command has stopped VCD generation started by open_vcd, and open_vcd must be executed before this command.}
        returns {Nothing.}
        example {start_vcd}
        source {Xilinx UG835 2026.1}
    }
}
command startgroup {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -try -detail {Do not start a group if one has already been started.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {startgroup ?-try? ?-quiet? ?-verbose?}

    hover {
        summary {Start a set of commands that can be undone or redone as a group.}
        synopsis {startgroup ?-try? ?-quiet? ?-verbose?}
        description {Starts a sequence of commands that can be undone or redone as a series, ended with endgroup. Multiple command groups can be undone or redone, but groups cannot be nested, so endgroup must end a sequence before startgroup creates a new one. Some commands can trigger an endgroup unexpectedly, and certain commands support neither undo nor redo.}
        returns {An integer value of 0 if a group is already started, or 1 if this command has started a new group.}
        source {Xilinx UG835 2026.1}
    }
}
command step {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {step ?-quiet? ?-verbose?}

    hover {
        summary {Step simulation to the next statement.}
        synopsis {step ?-quiet? ?-verbose?}
        description {Steps the current simulation to the next executable statement in the HDL source files. The line stepping feature lets you run the simulator through the source code line-by-line, which is helpful when observing how each line of the HDL source affects the results of simulation.}
        returns {Information related to the next executable line from the HDL source file.}
        example {step}
        source {Xilinx UG835 2026.1}
    }
}
command stop {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {stop ?-quiet? ?-verbose?}

    hover {
        summary {Tell the simulation to stop when a condition is true.}
        synopsis {stop ?-quiet? ?-verbose?}
        description {Pauses the current simulation. This command can be used within a condition, defined by add_condition, to pause the simulation when the condition is true.}
        returns {A "stop" in simulation is a pause and not a quit.}
        example {add_condition -name resetLow {/testbench/reset == 0 } {
puts "Condition Reset was encountered at [current_time]. \
   Stopping simulation."
stop }}
        source {Xilinx UG835 2026.1}
    }
}
command stop_gui {
