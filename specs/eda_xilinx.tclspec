command endgroup {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {endgroup ?-quiet? ?-verbose?}

    hover {
        summary {End a set of commands that can be undone or redone as a group.}
        synopsis {endgroup ?-quiet? ?-verbose?}
        description {Ends a sequence of commands that can be undone or redone as a series; startgroup begins the sequence. There can be multiple command groups to undo or redo, but command groups cannot be nested, so endgroup must end one sequence before startgroup creates a new one.}
        returns {Nothing.}
        example {startgroup
create_pblock pblock_wbArbEngine
create_pblock pblock_usbEng
add_cells_to_pblock pblock_wbArbEngine [get_cells [list wbArbEngine]] -clear_locs
add_cells_to_pblock pblock_usbEng [get_cells [list usbEngine1/usbEngineSRAM]] -clear_locs
endgroup}
        source {Xilinx UG835 2012.2}
    }
}
