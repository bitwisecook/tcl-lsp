           -detail {Fileset to merge files into from the default reconfigurable module of the deleted partitionDef; without it all files in the default RM are removed from the project.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_partition_defs ?-merge fileset? ?-quiet? ?-verbose? partition_defs}

    hover {
        summary {Delete existing PartitionDefs.}
        synopsis {delete_partition_defs ?-merge fileset? ?-quiet? ?-verbose? partition_defs}
        description {Deletes the specified Partition Definition objects from the current project. The partitionDefs can be given by name or as objects returned by get_partition_defs, and files from the default reconfigurable module of each deleted partitionDef can be preserved by merging them into another fileset with -merge.}
        returns {A transcript of the file merge process; nothing without file merge; an error if the command fails.}
