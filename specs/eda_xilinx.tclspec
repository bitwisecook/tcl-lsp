    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_power_opt ?-cell cells? ?-file file_name? ?-format format? ?-name name? ?-append? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report power optimizations.}
        synopsis {report_power_opt ?-cell cells? ?-file file_name? ?-format format? ?-name name? ?-append? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports the power optimizations that have been performed on the design by the power_opt_design command. By default the report is written to the Tcl console or standard output, but it can also be written to a file or returned as a string.}
        returns {The power optimization report.}
        example {report_power_opt -format xml -file C:/Data/power_opt.xml}
        source {Xilinx UG835 2026.1}
    }
}
command report_pr_configuration_analysis {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -complexity \
           -detail {Perform complexity analysis of the design and report the Rent exponent, average fanout, and primitive histogram.}
    option -clocking \
           -detail {Focus the report on clock usage and loads for each reconfigurable module, to help plan the overall clocking distribution of the design.}
    option -timing \
           -detail {Focus the report on boundary interface timing details, to analyze bottlenecks in and out of reconfigurable modules.}
    option -cells -takes cells \
           -detail {Generate the report on the specified reconfigurable cells rather than the whole design or current_instance.}
    option -dcps -takes checkpoints \
           -detail {The design checkpoints for each reconfigurable cell, given in the same order as the -cells option.}
    option -rent \
           -detail {Add Rent metrics to the complexity analysis, which is runtime intensive for large designs and so not included by default.}
    option -nworst -takes count \
           -detail {Report the N worst boundary paths, defaulting to 10.}
    option -file -takes file_name \
           -detail {Write the analysis results into the specified file instead of the Tcl console, overwriting an existing file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_pr_configuration_analysis ?-complexity? ?-clocking? ?-timing? ?-cells cells? ?-dcps checkpoints? ?-rent? ?-nworst count? ?-file file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Report reconfigurable partition analysis across multiple configurations.}
        synopsis {report_pr_configuration_analysis ?-complexity? ?-clocking? ?-timing? ?-cells cells? ?-dcps checkpoints? ?-rent? ?-nworst count? ?-file file_name? ?-quiet? ?-verbose?}
        description {Reports reconfigurable partition analysis across the multiple configurations defined by create_pr_configuration, comparing each selected reconfigurable module on resource usage, floorplanning, clocking, and timing metrics to help manage the overall Dynamic Function eXchange design. The project must first be defined as a DFX project by setting its PR_FLOW property to TRUE. Each module is examined from the information in the checkpoints provided; post-synthesis checkpoints can be supplied, but the most complete information is only available after opt_design.}
        returns {The reconfigurable partition analysis report.}
        example {report_pr_configuration_analysis -complexity}
        source {Xilinx UG835 2026.1}
    }
}
command report_property {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -all \
           -detail {Return all of the properties for an object, even those whose value is not currently defined.}
    option -class -takes class \
           -detail {Return the properties of the specified class instead of a specific object; the class argument is case sensitive and most class names are lower case.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -regexp \
           -detail {The search pattern is written as a regular expression, anchored to the start of the search string unless widened with a leading or trailing ".*".}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_property ?-all? ?-class class? ?-return_string? ?-file file_name? ?-append? ?-regexp? ?-quiet? ?-verbose? ?object? ?pattern?}

    hover {
        summary {Report properties of object.}
        synopsis {report_property ?-all? ?-class class? ?-return_string? ?-file file_name? ?-append? ?-regexp? ?-quiet? ?-verbose? ?object? ?pattern?}
        description {Gets the property name, property type, and property value for all of the properties on a specified object, or on a class of objects when -class is used instead of an object; list_property returns the property names alone. A single object is given, usually from a get_* command, and specifying multiple objects is an error. The pattern applies to the property name, defaults to the wildcard *, and is case sensitive, as most property names are upper case.}
        returns {Property report.}
        example {report_property -all [get_cells cpuEngine]}
        source {Xilinx UG835 2026.1}
    }
}
command report_pulse_width {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -name -takes results_name \
           -detail {Name of the results set for the GUI, which can be deleted with delete_timing_results.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output (not with -file).}
    option -warn_on_violation \
           -detail {Issue a critical warning when the report contains a timing violation.}
    option -all_violators -detail {Report only the objects where check violations occur.}
    option -significant_digits -takes digits \
           -detail {Number of significant digits in the output results, in the range 0 to 3.}
    option -limit -takes count \
           -detail {Number of checks of a particular type to report per clock, a value of 1 or more, defaulting to 1.}
    option -min_period -detail {Report minimum period checks.}
    option -max_period -detail {Report maximum period checks.}
    option -low_pulse -detail {Report minimum low pulse width checks.}
    option -high_pulse -detail {Report minimum high pulse width checks.}
    option -max_skew -detail {Check the skew constraints between two clock pins.}
    option -min_skew -detail {Check the min skew constraints between two data pins.}
    option -clocks -takes clocks \
           -detail {Clocks for which to report pulse width and period checks, all clocks being checked by default.}
    option -no_header \
           -detail {Eliminate the report header from the results, which is useful with -return_string.}
    option -cells -takes cells \
           -detail {Generate the report for the specified hierarchical cells rather than the whole design.}
    option -rpx -takes file_name \
           -detail {File name and path of the interactive report (RPX) file to write, which open_report can reload.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_pulse_width ?-file file_name? ?-append? ?-name results_name? ?-return_string? ?-warn_on_violation? ?-all_violators? ?-significant_digits digits? ?-limit count? ?-min_period? ?-max_period? ?-low_pulse? ?-high_pulse? ?-max_skew? ?-min_skew? ?-clocks clocks? ?-no_header? ?-cells cells? ?-rpx file_name? ?-quiet? ?-verbose? ?objects?}

    hover {
        summary {Report pulse width check.}
        synopsis {report_pulse_width ?-file file_name? ?-append? ?-name results_name? ?-return_string? ?-warn_on_violation? ?-all_violators? ?-significant_digits digits? ?-limit count? ?-min_period? ?-max_period? ?-low_pulse? ?-high_pulse? ?-max_skew? ?-min_skew? ?-clocks clocks? ?-no_header? ?-cells cells? ?-rpx file_name? ?-quiet? ?-verbose? ?objects?}
        description {Reports the pulse width of the specified clock signals in the clock network and upon reaching the flip-flop, checking high pulse width with maximum delay on the rising edge and minimum delay on the falling edge, and low pulse width with minimum delay on the rising edge and maximum delay on the falling edge, so the result is a worst case analysis of the current synthesized or implemented design. The command also reports the maximum skew allowed between clock signals and the minimum skew allowed between data signals, the min skew only being reported when violations are found on a post-route design. Minimum period, maximum period, low pulse width, high pulse width, min skew, and max skew checks are all included by default, but selecting a specific check disables the others unless they are also specified.}
        returns {The pulse width report, returned to the standard output unless -file, -return_string, or -name is specified.}
        example {report_pulse_width -min_period -low_pulse -name timing_1}
        source {Xilinx UG835 2026.1}
    }
}
command report_qor_assessment {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the QoR assessment report into the specified file, overwriting it unless -append is also specified.}
    option -csv_output_dir -takes directory \
           -detail {Directory for the supporting CSV files holding timing path details and the cells and nets carrying DONT_TOUCH properties.}
    option -name -takes results_name \
           -detail {Name of the results set for the GUI panel.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -exclude_methodology_checks \
           -detail {Skip the methodology checks that are included by default, reducing the time taken to execute the command.}
    option -max_paths -takes count \
           -detail {Number of critical paths to analyze, defaulting to the 100 worst timing paths.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -full_assessment_details \
           -detail {In the Details table, report items that have passed the checks performed.}
    option -checks -takes checks \
           -detail {Run only the specified factory or custom checks, which must be qor_check objects of type assessment, instead of the default checks.}
    option -ruledecks -takes ruledecks \
           -detail {Run only the checks contained in the specified factory or custom ruledecks, which must be qor_ruledeck objects of type assessment.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_qor_assessment ?-file file_name? ?-csv_output_dir directory? ?-name results_name? ?-append? ?-exclude_methodology_checks? ?-max_paths count? ?-return_string? ?-full_assessment_details? ?-checks checks? ?-ruledecks ruledecks? ?-quiet? ?-verbose?}

    hover {
        summary {Run feasibility checks that assess the likelihood of the design meeting its goals.}
        synopsis {report_qor_assessment ?-file file_name? ?-csv_output_dir directory? ?-name results_name? ?-append? ?-exclude_methodology_checks? ?-max_paths count? ?-return_string? ?-full_assessment_details? ?-checks checks? ?-ruledecks ruledecks? ?-quiet? ?-verbose?}
        description {Looks for trouble spots in the design and assesses the likelihood of the design meeting its goals, covering design methodology, synthesis, implementation, design hierarchy, partial reconfiguration, and floorplanning, and requires an open elaborated, synthesized, or implemented design. It includes a subset of the report_methodology checks but is more comprehensive, adding checks for conditions that are not bad practice yet have low success given the structure, style, size, or complexity of the design, notably conditions that lead to congestion and performance degradation. For the violations it finds, report_qor_suggestions recommends how to avoid the issue or modify the design.}
        returns {A score from 1 to 5, where 1 is a failing grade and 5 means the design will likely pass implementation and meet timing.}
        example {report_qor_assessment -max_paths 10}
        source {Xilinx UG835 2026.1}
    }
}
command report_qor_suggestions {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the QoR report into the specified file, overwriting it unless -append is also specified.}
    option -csv_output_dir -takes directory \
           -detail {Directory for the supporting CSV files holding timing path details and the cells and nets carrying DONT_TOUCH properties.}
    option -name -takes results_name \
           -detail {Name of the view to display in the Vivado IDE, only one QoR suggestion report being open at a time (not with -file).}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -max_strategies -takes count \
           -detail {Maximum number of machine-learning strategies returned, defaulting to 3, fewer being returned when too few suitable strategies are identified.}
    option -max_paths -takes count \
           -detail {Number of critical paths to analyze per timing group, defaulting to the 100 worst timing paths.}
    option -no_split -detail {Do not split the lines in the tables when generating the report.}
    option -report_all_suggestions \
           -detail {Relax the criteria that suppress suggestions, so utilization suggestions need not save a critical resource, congestion suggestions are offered when timing is closed, and timing suggestions cover paths with WNS below 0.500.}
    option -cells -takes cells \
           -detail {Report suggestions for the specified hierarchical cells and all data paths passing through them.}
    option -of_objects -takes objects \
           -detail {Report the existing suggestion objects returned by get_qor_suggestions rather than analyzing the design for new suggestions.}
    option -checks -takes checks \
           -detail {Run only the specified factory or custom checks, which must be valid qor_check objects, instead of the default checks.}
    option -ruledecks -takes ruledecks \
           -detail {Run only the checks contained in the specified factory or custom ruledecks, which must be valid qor_ruledeck objects.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_qor_suggestions ?-file file_name? ?-csv_output_dir directory? ?-name results_name? ?-append? ?-return_string? ?-max_strategies count? ?-max_paths count? ?-no_split? ?-report_all_suggestions? ?-cells cells? ?-of_objects objects? ?-checks checks? ?-ruledecks ruledecks? ?-quiet? ?-verbose?}

    hover {
        summary {Recommend suggestions for improving the quality of results.}
        synopsis {report_qor_suggestions ?-file file_name? ?-csv_output_dir directory? ?-name results_name? ?-append? ?-return_string? ?-max_strategies count? ?-max_paths count? ?-no_split? ?-report_all_suggestions? ?-cells cells? ?-of_objects objects? ?-checks checks? ?-ruledecks ruledecks? ?-quiet? ?-verbose?}
        description {Reports design and tool option recommendations for improving quality of results, looking at timing constraints, netlist characteristics, failing timing paths, and congestion information; it can be run after synthesis or after any implementation step but requires an open design. The command creates QoR suggestion objects, which get_qor_suggestions returns and whose APPLICABLE_FOR, ENABLED, AUTO, and GENERATED_AT properties decide when a suggestion applies; suggestions are written to an RQS file with write_qor_suggestions and read back with read_qor_suggestions after resetting the flow. Strategy suggestions come from a machine-learning analysis of a routed design implemented with the Default or Explore directive throughout, do not apply to synthesis, and only one strategy suggestion can be applied per run.}
        returns {The QoR suggestions report; the command also creates the QoR suggestion objects for the suggestions it identifies.}
        example {report_qor_suggestions -max_paths 10}
        source {Xilinx UG835 2026.1}
    }
}
command report_ram_utilization {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, valid for the -file text report only and not the CSV file.}
    option -json -takes file_name \
           -detail {Output the report in JSON format, which is preferred when interacting with an AI agent and is not compatible with -file, -append, or -return_string.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting any file of the same name without warning.}
    option -csv -takes file_name \
           -detail {Write the detailed tables into the specified CSV file, overwriting any file of the same name without warning.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output (not with -file).}
    option -cells -takes cells \
           -detail {Limit the reporting to the memory arrays contained within the specified cells, which must be given as objects from get_cells.}
    option -include_lutram \
           -detail {Include LUTRAMs in the detailed tables, which by default report only block RAMs and UltraRAMs.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_ram_utilization ?-append? ?-json file_name? ?-file file_name? ?-csv file_name? ?-return_string? ?-cells cells? ?-include_lutram? ?-quiet? ?-verbose?}

    hover {
        summary {Report RAM usage in the current design.}
        synopsis {report_ram_utilization ?-append? ?-json file_name? ?-file file_name? ?-csv file_name? ?-return_string? ?-cells cells? ?-include_lutram? ?-quiet? ?-verbose?}
        description {Reports RAM usage in the current design at any stage after synthesis, the report being more accurate once opt_design has completed its optimizations, and generating to the standard output when none of -file, -csv, -json, or -return_string is given. The Summary table shows utilization by RAM type, categorized into URAM, block RAM, and LUTRAM and then into individual primitives with the inferred primitive percentage, so that imbalances between RAM types and the efficiency of the LUTRAM implementation become visible. The Memory Description table gives a synthesis view of the inferred memories sorted by total bits, and the detailed tables cover Memory Utilization, Memory Performance, and Memory Power for both inferred and instantiated primitives.}
        returns {The report, written to the Tcl console, to a file, or as a string; an error if it fails.}
        example {report_ram_utilization -csv ./ram_util.csv -file ./ram_util.txt}
        source {Xilinx UG835 2026.1}
    }
}
command report_route_status {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -return_nets \
           -detail {Return a list of nets matching -route_type, which is then required, instead of generating the report.}
    option -return_string \
           -detail {Set the result of running the report in the Tcl interpreter result variable (not with -file).}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -of_objects -takes objects \
           -detail {Report the full routing tree for the specified route, net, or xdef_net objects.}
    ;# NOTE(xilinx): the Arguments prose gives alternate spellings for several
    ;# route states, so the set is listed but not marked -closed.
    option -route_type -takes route_type \
           -values {ANTENNAS CONFLICTS HIERPORT INTRASITE INTERNAL GAPS HAS_ROUTING LOCKED_NODES FIXED
                    NODRIVER NO_DRIVERS NOLOADS NO_LOADS PARTIAL ROUTED UNPLACED UNPLACED_PINS
                    UNPLACED_ALL UNROUTED} \
           -detail {Only show routes with the specified route status, ignored when -of_objects is also specified.}
    option -list_all_nets \
           -detail {Report summary route status for every net in the design, or those selected by -route_type, and is ignored when -of_objects is specified.}
    option -show_all \
           -detail {Report all relevant pins for UNPLACED or PARTIAL routes and all relevant nodes for ANTENNAS or CONFLICTS routes, rather than only the first 15.}
    option -dump_routes \
           -detail {Report the full routing tree for every routed net in the design, which is a very long report.}
    option -has_routing \
           -detail {Return 0 when the design is unrouted and 1 when it has routing, all other options being ignored.}
    option -boolean_check -takes attribute \
           -values {PLACED_FULLY PARTIALLY_ROUTED ROUTED_FULLY ERRORS_IN_ROUTES} \
           -detail {Return 1 when the specified design attribute is true and 0 when it is not, all other options being ignored (not with -has_routing or -return_nets).}
    option -ignore_cache \
           -detail {Discard the cached route information and recalculate the route status for the entire design, which is slow.}
    option -to_load -takes load \
           -detail {Show just one branch of the given route, from the driver to the given load.}
    option -with_intent_codes -detail {Print intent codes next to nodes.}
    option -node_delay \
           -detail {Report delays for each node along with a total delay for the whole route.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_route_status ?-return_nets? ?-return_string? ?-file file_name? ?-append? ?-of_objects objects? ?-route_type route_type? ?-list_all_nets? ?-show_all? ?-dump_routes? ?-has_routing? ?-boolean_check attribute? ?-ignore_cache? ?-to_load load? ?-with_intent_codes? ?-node_delay? ?-quiet? ?-verbose?}

    hover {
        summary {Report on the status of the routing.}
        synopsis {report_route_status ?-return_nets? ?-return_string? ?-file file_name? ?-append? ?-of_objects objects? ?-route_type route_type? ?-list_all_nets? ?-show_all? ?-dump_routes? ?-has_routing? ?-boolean_check attribute? ?-ignore_cache? ?-to_load load? ?-with_intent_codes? ?-node_delay? ?-quiet? ?-verbose?}
        description {Reports the state of routing in the current design, from a simple 1 saying the design has routing through to a complete route tree for each net. The route states used by -route_type are ANTENNAS for nets with antennas or islands, CONFLICTS for nets whose routes share a node or conflict inside a site, HIERPORT for nets with no loads or no drivers that also reach a top-level port, INTRASITE for nets routed entirely inside a site, GAPS, HAS_ROUTING, LOCKED_NODES, NODRIVER, NOLOADS, PARTIAL, ROUTED, UNPLACED, UNPLACED_ALL, and UNROUTED. By default the command is iterative and only updates route information for new nets and routes as the design is implemented.}
        returns {The route status report; -has_routing and -boolean_check return 1 or 0 instead, and -return_nets returns a list of nets that other Tcl commands can process.}
        example {report_route_status -of_objects [get_nets u4*]}
        source {Xilinx UG835 2026.1}
    }
}
command report_run_status {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_run_status ?-quiet? ?-verbose? runs}

    hover {
        summary {Report the reason for the staleness of a run.}
        synopsis {report_run_status ?-quiet? ?-verbose? runs}
        description {Reports the reason for the staleness of the specified run.}
        source {Xilinx UG835 2026.1}
    }
}
command report_scopes {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_scopes ?-quiet? ?-verbose? ?hdl_scopes?}

    hover {
        summary {Print the names of the children scopes of the given scopes or of the current scope.}
        synopsis {report_scopes ?-quiet? ?-verbose? ?hdl_scopes?}
        description {Reports the names and types of the HDL scopes in the current scope of the current simulation, or of the specified scopes, the default being the current scope. An HDL scope is a declarative region of an HDL file where objects are declared: in Verilog a module, function, task, process, or other begin-end block, and in VHDL an entity and architecture pair, block, function, procedure, or process. You must have an open simulation to use this command.}
        returns {A subset of the properties of the HDL scopes, printed on the console in textual format.}
        example {report_scopes}
        source {Xilinx UG835 2026.1}
    }
}
command report_sim_device {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -part -takes part \
           -detail {Target part, the currently loaded part being used when this option is not specified.}
    option -file -takes file_name \
           -detail {Write the SIM_DEVICE report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output (not with -file).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_sim_device ?-part part? ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report the correct SIM_DEVICE attribute values for cell types in the target part.}
        synopsis {report_sim_device ?-part part? ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose?}
        description {Cells carrying the SIM_DEVICE attribute may behave slightly differently in different device families, and the value of SIM_DEVICE directs the simulator to match the behavior of the cell to the target device. This command reports the correct SIM_DEVICE attribute value to use for cell types in the target part.}
        returns {Report.}
        example {report_sim_device -part xcvu065-ffvc1517-1-i}
        source {Xilinx UG835 2026.1}
    }
}
command report_sim_env {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -version \
           -detail {Print the supported simulator and GCC version and OS platform for the current Vivado release.}
    option -file -takes file_name \
           -detail {Write the report to the specified file, which is overwritten if it already exists.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_sim_env ?-version? ?-file file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Print the simulator environment settings for the current target simulator.}
        synopsis {report_sim_env ?-version? ?-file file_name? ?-quiet? ?-verbose?}
        description {Extracts the simulation settings from the OS shell and Tcl console environment and prints them in the Tcl console, covering the simulator and GCC version, the simulator and GNU tools path, simulator-specific environment variables, and compiled library information. It reports the simulator version as VALID or INVALID against the official version supported for the current release, prints the settings variables for the simulator type such as MODELTECH for ModelSim Questa, CDS_INST_DIR and CDS_LICENSE_DIR for Xcelium, and VCS_HOME and VG_GNU_PACKAGE for VCS, and validates the compiled library path. It also prints miscellaneous information such as the simulation top, the current simulation fileset, the run mode, and the design compile mode.}
        returns {Message.}
        example {report_sim_env}
        source {Xilinx UG835 2026.1}
    }
}
command report_sim_version {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -part -takes part -detail {Part.}
    option -file -takes file_name -detail {Output file.}
    option -append -detail {Append the results to the file.}
    option -return_string -detail {Return the report as a string.}
    option -unisim -takes unisim \
           -detail {Return the SIM_VERSION for the unisim if present.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_sim_version ?-part part? ?-file file_name? ?-append? ?-return_string? ?-unisim unisim? ?-quiet? ?-verbose?}

    hover {
        summary {Report the correct SIM_VERSION attribute values for cell types in the target part.}
        synopsis {report_sim_version ?-part part? ?-file file_name? ?-append? ?-return_string? ?-unisim unisim? ?-quiet? ?-verbose?}
        description {Reports the list of correct SIM_VERSION attribute values for cell types in the target part.}
        returns {Report.}
        source {Xilinx UG835 2026.1}
    }
}
command report_simlib_info {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting it unless -append is also specified, and defaulting to report_simlib_info.log.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_simlib_info ?-file file_name? ?-append? ?-quiet? ?-verbose? path}

    hover {
        summary {Report information on the simulation libraries at a path.}
        synopsis {report_simlib_info ?-file file_name? ?-append? ?-quiet? ?-verbose? path}
        description {Reports information on the libraries compiled by the compile_simlib command, at the required path to the compiled simulation library.}
        returns {Information on the libraries compiled by the compile_simlib command.}
        example {report_simlib_info C:/Data/compiled_simlib}
        source {Xilinx UG835 2026.1}
    }
}
command report_slr_crossing {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it.}
    option -cells -takes cells \
           -detail {Target a hierarchical cell or list of hierarchical cells, generating SLL usage and cell utilization tables for each.}
    option -fanout_greater_than -takes fanout \
           -detail {Limit the fanout table to nets with fanout greater than the specified integer, used with -max_nets and defaulting to 10.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, the report going to the command line when this option is not given.}
    option -hierarchical_depth -takes depth \
           -detail {Limit the Driver table to the given depth of hierarchy below top, allowed values being integers of 1 or more, with 0 meaning the full hierarchy.}
    option -max_nets -takes count \
           -detail {Limit the fanout table to the specified number of nets ordered from the highest fanout, defaulting to 20.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_slr_crossing ?-append? ?-cells cells? ?-fanout_greater_than fanout? ?-file file_name? ?-hierarchical_depth depth? ?-max_nets count? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report on SLR crossings.}
        synopsis {report_slr_crossing ?-append? ?-cells cells? ?-fanout_greater_than fanout? ?-file file_name? ?-hierarchical_depth depth? ?-max_nets count? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports on SLR crossings, the connections between two Super Logic Regions carried by Super Long Lines, and provides an assessment on a post-place or post-route design; such crossings need analysis because fewer inter-SLR nodes are available than general routing and the timing paths carry more uncertainty. The report covers utilization by SLR, SLL usage between each pair of SLRs, clock information such as vtree template, clock extent, and calibration, the number of logic levels for each clock with its requirement, fanout requirements on a net with the SLR location of its loads, and driver information including the hierarchy and cell types.}
        returns {An SLR crossing report assessing a post-place or post-route design.}
        example {report_slr_crossing -file slr_crossing.rpt}
        source {Xilinx UG835 2026.1}
    }
}
command report_ssn {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes results_name \
           -detail {Name of the results to output to the GUI.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output (not with -file).}
    option -format -takes format -values {CSV HTML TXT} -closed \
           -detail {Format of the output file, defaulting to CSV, and applied only when -file is specified.}
    option -file -takes file_name \
           -detail {Write the SSN report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -phase \
           -detail {Consider clock switching cycles in the analysis to provide a more accurate result.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_ssn ?-name results_name? ?-return_string? ?-format format? ?-file file_name? ?-append? ?-phase? ?-quiet? ?-verbose?}

    hover {
        summary {Run simultaneous switching noise analysis on the current package and pinout.}
        synopsis {report_ssn ?-name results_name? ?-return_string? ?-format format? ?-file file_name? ?-append? ?-phase? ?-quiet? ?-verbose?}
        description {Performs a simultaneous switching noise analysis of the current design, estimating how output switching affects interface noise margins by incorporating I/O bank specific electrical characteristics; the estimates identify potential noise issues and should not be used as final design sign-off criteria. The analysis is affected by the temperature grade set with set_operating_conditions -grade, and by default assumes every port toggles asynchronously, which is a worst case that -phase relaxes by considering the period, phase shift, and duty cycle of clocks defined with create_clock and create_generated_clock. Not all parts support the command, and the SSN_REPORT property of a part says whether it does.}
        returns {The SSN report.}
        example {report_ssn -format html -file C:/Data/devSSN.html}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command report_sso {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {Name of the result set to output to the GUI panel (required).}
    option -return_string \
           -detail {Direct the output to a Tcl string, which cannot be used with -file.}
    option -file -takes file \
           -detail {Write the SSO report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the report to the specified file rather than overwriting it (only with -file).}
    option -board_thickness -takes mils \
           -detail {Thickness in mils of the PCB the FPGA device is mounted onto, defaulting to 62 mils.}
    option -via_diameter -takes mils \
           -detail {Finished diameter in mils of the breakout vias in the PCB, defaulting to 12 mils.}
    option -pad_to_via_breakout_length -takes mils \
           -detail {Length in mils of the breakout wire from the pad on the package or socket to the breakout via, defaulting to 33 mils.}
    option -breakout_width -takes mils \
           -detail {Width in mils of the breakout wire on the PCB, defaulting to 12 mils.}
    option -other_pcb_inductance -takes nanohenrys \
           -detail {Other PCB parasitic inductance in nanohenrys, defaulting to 0 nH.}
    option -socket_inductance -takes nanohenrys \
           -detail {Inductance in nanohenrys of the mounting socket between the FPGA and the PCB, defaulting to 0 nH.}
    option -ground_bounce -takes millivolts \
           -detail {Maximum allowed undershoot or overshoot voltage of the signal on the PCB in millivolts.}
    option -output_cap -takes picofarads \
           -detail {Capacitance per output driver in picofarads, defaulting to 15 pF.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_sso -name name ?-return_string? ?-file file? ?-append? ?-board_thickness mils? ?-via_diameter mils? ?-pad_to_via_breakout_length mils? ?-breakout_width mils? ?-other_pcb_inductance nanohenrys? ?-socket_inductance nanohenrys? ?-ground_bounce millivolts? ?-output_cap picofarads? ?-quiet? ?-verbose?}

    hover {
        summary {Run WASSO analysis on the current package and pinout.}
        synopsis {report_sso -name name ?-return_string? ?-file file? ?-append? ?-board_thickness mils? ?-via_diameter mils? ?-pad_to_via_breakout_length mils? ?-breakout_width mils? ?-other_pcb_inductance nanohenrys? ?-socket_inductance nanohenrys? ?-ground_bounce millivolts? ?-output_cap picofarads? ?-quiet? ?-verbose?}
        description {Performs a weighted average simultaneous switching outputs (WASSO) analysis of the current synthesized or implemented design to validate signal integrity based on the I/O pin and bank assignments in the design. The command is for Spartan-3, Virtex-4, and Virtex-5 devices and approximates switching noise for them, while report_ssn provides a more detailed SSN analysis for Spartan-6, Virtex-6, Virtex-7, Kintex-7, and Artix-7 devices. The analysis places the FPGA in the context of the system-level design, so the printed circuit board it will be mounted to is described by the various board and device arguments or left at their default values.}
        returns {Sso report.}
        example {report_sso -file C:/Data/devSSO.txt}
        source {Xilinx UG835 2012.2}
    }
}
command report_stacks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_instance -takes instance \
           -detail {Instance to report the stacks from.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_stacks ?-of_instance instance? ?-quiet? ?-verbose?}

    hover {
        summary {Print the names of the processes in a design that are waiting inside a subprogram.}
        synopsis {report_stacks ?-of_instance instance? ?-quiet? ?-verbose?}
        description {Prints the names of the HDL process scopes that are waiting inside a subprogram, in textual format.}
        returns {A string naming the HDL process scopes waiting inside a subprogram.}
        source {Xilinx UG835 2026.1}
    }
}
command report_switching_activity {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -static_probability -detail {Report static probability as part of the report.}
    option -signal_rate -detail {Report the signal rate as part of the report.}
    option -toggle_rate \
           -detail {Report the toggle rate as the switching rate of the output of synchronous logic elements compared to a given clock input.}
    option -default_static_probability \
           -detail {Report the default static probability used in power analysis on the current design, which requires no objects.}
    option -default_toggle_rate \
           -detail {Report the default toggle rate used in power analysis on the primary inputs of the current design, which requires no objects.}
    option -average -detail {Report the average switching activity for the specified objects.}
    option -file -takes file_name -detail {Write the report to the specified path and file.}
    option -return_string -detail {Return the data as a text string for assignment to a Tcl variable.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -hier \
           -detail {Report the switching activity hierarchically for signals in the specified hierarchical objects rather than at the current level of hierarchy.}
    option -all \
           -detail {Report the switching activity on nets within all instances specified by -type, and must be used with -type.}
    ;# NOTE(xilinx): the Usage table calls this the list of valid type values
    ;# while the Arguments prose says valid logic types include them, so the set
    ;# is listed but not marked -closed.
    option -type -takes types \
           -values {io_output io_bidir_enable register lut_ram lut dsp bram_enable bram_wr_enable
                    gt_txdata gt_rxdata} \
           -detail {Report the switching activity for the specified type of logic entity at the top level of the design, whose scope -all or -hier can widen.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_switching_activity ?-static_probability? ?-signal_rate? ?-toggle_rate? ?-default_static_probability? ?-default_toggle_rate? ?-average? ?-file file_name? ?-return_string? ?-append? ?-hier? ?-all? ?-type types? ?-quiet? ?-verbose? ?objects?}

    hover {
        summary {Get the switching activity on the specified objects.}
        synopsis {report_switching_activity ?-static_probability? ?-signal_rate? ?-toggle_rate? ?-default_static_probability? ?-default_toggle_rate? ?-average? ?-file file_name? ?-return_string? ?-append? ?-hier? ?-all? ?-type types? ?-quiet? ?-verbose? ?objects?}
        description {Reports the several kinds of switching activity on design nets, ports, pins, and cells in the current synthesized or implemented design, covering simple signal rate and static probability on nets, ports, and pins, and state dependent static probabilities on cells. The reported values are the ones defined with set_switching_activity. By default the report is written to the Tcl console or standard output, but it can be written to a file or returned as a string.}
        returns {The switching activity for the specified objects, or for the current design.}
        example {report_switching_activity -signal_rate -static_probability [all_outputs]}
        source {Xilinx UG835 2026.1}
    }
}
command report_synchronizer_mtbf {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting any file of the same name without warning.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output (not with -file).}
    option -warn_if_mtbf_below -takes value \
           -detail {Floating point value below which a warning is issued in addition to the report, defaulting to 1e+12.}
    option -no_header -detail {Write the report without the standard header.}
    option -report_endpoints \
           -detail {Report the total number of CDC path endpoints, the sum of the safe, unsafe, and unknown endpoints.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_synchronizer_mtbf ?-file file_name? ?-append? ?-return_string? ?-warn_if_mtbf_below value? ?-no_header? ?-report_endpoints? ?-quiet? ?-verbose?}

    hover {
        summary {Compute the mean time between failures of the synchronizer chains and display the report.}
        synopsis {report_synchronizer_mtbf ?-file file_name? ?-append? ?-return_string? ?-warn_if_mtbf_below value? ?-no_header? ?-report_endpoints? ?-quiet? ?-verbose?}
        description {Reports the mean time between failures of each clock domain crossing synchronizer chain in the design and an overall MTBF covering all synchronizers, which is the inverse of the sum of the reciprocals of the individual values; synchronizer registers must carry ASYNC_REG properties set to TRUE to be identified. For each chain the report gives the MTBF in dynamic time units, the data toggle rate and sample rate, the settling time, the sending and receiving domains, the number of stages, and the CDC net name. An MTBF is UNDEFINED when one or both clocks of the crossing are unconstrained, when a timing violation involves registers in the chain, or when a zero toggle rate is detected, in which case set_switching_activity can override the toggle rate on the CDC net. This command is supported for UltraScale devices only.}
        returns {The MTBF report, or an error if it fails.}
        example {report_synchronizer_mtbf -file C:/Data/mtbf_report.txt}
        source {Xilinx UG835 2026.1}
    }
}
command report_timing_summary {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -check_timing_verbose \
           -detail {Produce a verbose report when checking the design for potential timing problems.}
    option -delay_type -takes delay_type -values {max min min_max} -closed \
           -detail {Type of path delay to analyze, defaulting to min_max.}
    option -no_detailed_paths \
           -detail {Do not report the full timing path for each clock or path group analyzed.}
    option -setup -detail {Report max delay timing paths, equivalent to -delay_type max.}
    option -hold -detail {Report min delay timing paths, equivalent to -delay_type min.}
    option -max_paths -takes count \
           -detail {Maximum number of paths to report per clock or path group, a value of 1 or more, defaulting to 1.}
    option -nworst -takes count \
           -detail {List up to this many worst paths to an endpoint, a value of 1 or more, defaulting to 1.}
    option -unique_pins \
           -detail {For each unique set of pins, show at most one path per path group.}
    option -path_type -takes path_type \
           -values {end summary short full full_clock full_clock_expanded} -closed \
           -detail {Format for the path report, defaulting to full_clock_expanded.}
    option -no_reused_label \
           -detail {Do not label the reuse status on pins in the report for designs using incremental place and route.}
    option -input_pins \
           -detail {Show input pins in the path, for use with -path_type full, full_clock, and full_clock_expanded.}
    option -no_pr_attribute \
           -detail {For Dynamic Function eXchange designs, do not report whether netlist resources are in the static or reconfigurable regions.}
    option -no_pblock -detail {Report the timing summary without the Pblock column.}
    option -routable_nets \
           -detail {Store the number of routable nets traversed as a property on the timing paths returned.}
    ;# NOTE(xilinx): the Usage table lists only_data_crossing among the values
    ;# while the Arguments prose omits it, so the set is not marked -closed.
    option -inter_slr -takes crossing_type \
           -values {any_crossing data_crossing only_data_crossing clock_crossing no_crossing} \
           -detail {Report timing paths based on their SLR-crossing characteristics.}
    option -slack_lesser_than -takes slack \
           -detail {Display paths whose slack is less than this value, defaulting to 1e+30.}
    option -report_unconstrained \
           -detail {Report unconstrained and user ignored paths, which are excluded by default.}
    option -significant_digits -takes digits \
           -detail {Number of significant digits in the output results, in the range 0 to 3, defaulting to 3.}
    option -no_header -detail {Do not generate a report header.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -name -takes results_name \
           -detail {Name of the results set for the GUI, which can be deleted with delete_timing_results.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output (not with -file).}
    option -warn_on_violation \
           -detail {Issue a critical warning when the report contains a timing violation.}
    option -datasheet -detail {Generate data sheet information to add to the summary report.}
    option -cells -takes cells \
           -detail {Generate the timing summary on the specified hierarchical cells rather than the whole design.}
    option -rpx -takes file_name \
           -detail {File name and path of the interactive report (RPX) file to write, which open_report can reload.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_timing_summary ?-check_timing_verbose? ?-delay_type delay_type? ?-no_detailed_paths? ?-setup? ?-hold? ?-max_paths count? ?-nworst count? ?-unique_pins? ?-path_type path_type? ?-no_reused_label? ?-input_pins? ?-no_pr_attribute? ?-no_pblock? ?-routable_nets? ?-inter_slr crossing_type? ?-slack_lesser_than slack? ?-report_unconstrained? ?-significant_digits digits? ?-no_header? ?-file file_name? ?-append? ?-name results_name? ?-return_string? ?-warn_on_violation? ?-datasheet? ?-cells cells? ?-rpx file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Report a timing summary for the design.}
        synopsis {report_timing_summary ?-check_timing_verbose? ?-delay_type delay_type? ?-no_detailed_paths? ?-setup? ?-hold? ?-max_paths count? ?-nworst count? ?-unique_pins? ?-path_type path_type? ?-no_reused_label? ?-input_pins? ?-no_pr_attribute? ?-no_pblock? ?-routable_nets? ?-inter_slr crossing_type? ?-slack_lesser_than slack? ?-report_unconstrained? ?-significant_digits digits? ?-no_header? ?-file file_name? ?-append? ?-name results_name? ?-return_string? ?-warn_on_violation? ?-datasheet? ?-cells cells? ?-rpx file_name? ?-quiet? ?-verbose?}
        description {Generates a timing summary that says whether the design meets its timing requirements, running on an open synthesized or implemented design and automatically during implementation as part of launch_runs. The report contains the timer settings, the check_timing information, the design timing summary with WNS, TNS, WHS, THS, and component switching limits, the clock definitions from report_clocks, the intra-clock and inter-clock tables, the path group table, the detailed timing paths for max and min delay, and, when -datasheet is given, the report_datasheet information. The command can be multi-threaded through the general.maxThreads parameter of set_param.}
        returns {The timing summary report, available in the Tcl console or standard output, or written to a file or returned as a string.}
        example {report_timing_summary}
        source {Xilinx UG835 2026.1}
    }
}
command report_transformed_primitives {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the transformed primitives report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output (not with -file).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_transformed_primitives ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report details of the Unisim primitive transformations.}
        synopsis {report_transformed_primitives ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports the transformed primitives in the current design. As part of opening the synthesized design and loading it into memory, the tool transforms legacy netlist primitives into the supported subset of Unisim primitives.}
        returns {The transformed primitives report, written to the standard output by default, or to a file or a Tcl string.}
        example {set transPrim [ report_transformed_primitives -return_string ]}
        source {Xilinx UG835 2026.1}
    }
}
command report_utilization {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting it unless -append is also specified.}
    option -json -takes file_name \
           -detail {Output the report in JSON format, which is preferred when interacting with an AI agent and is not compatible with -file, -append, or -return_string.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -pblocks -takes pblocks \
           -detail {Report the resources utilized by a Pblock (not with -name).}
    option -evaluate_pblock \
           -detail {Perform a what-if analysis reporting the utilization of the specified Pblocks populated by the specified cells, which requires both -pblocks and -cells.}
    option -exclude_child_pblocks \
           -detail {Report utilization of the specified Pblocks excluding any nested Pblocks.}
    option -exclude_non_assigned \
           -detail {Exclude non-assigned cells from the utilization report when -pblocks is specified.}
    option -cells -takes cells \
           -detail {Report the resources utilized by one or more hierarchical cells in the current design.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output (not with -file).}
    option -slr -detail {Report the utilization for each separate SLR in devices having SLRs.}
    option -packthru \
           -detail {Report LUTs used for route through purposes, appearing as LUTs used exclusively as route-thrus.}
    option -name -takes results_name \
           -detail {Name of the results to output to the GUI, which also triggers hierarchical mode.}
    option -no_primitives \
           -detail {Remove the Primitives section, which reports the number and type of logic primitives used on the device.}
    option -omit_locs \
           -detail {Omit the Fixed column, which reports the quantity of fixed logic elements manually placed onto the device.}
    option -hierarchical \
           -detail {Report the utilization of the device categorized by the design hierarchy, which affects the report generated to a file.}
    option -spreadsheet_file -takes file_name \
           -detail {Export the utilization tables to the specified XLSX spreadsheet, available only with -name and when the report is generated in the GUI.}
    option -spreadsheet_table -takes table_name \
           -detail {Utilization table to export to the spreadsheet file, defaulting to Hierarchy and requiring -spreadsheet_file.}
    option -spreadsheet_depth -takes depth \
           -detail {Hierarchical depth from the top level to export to the spreadsheet file, defaulting to 8 and requiring -spreadsheet_file.}
    option -hierarchical_depth -takes depth \
           -detail {Depth of the hierarchy to report in the textual hierarchical report, 0 meaning the full design hierarchy.}
    option -hierarchical_percentages \
           -detail {Report the utilization data in the hierarchical report as percentages.}
    option -hierarchical_min_primitive_count -takes count \
           -detail {Minimum number of cells required before a hierarchy is reported in hierarchical mode, 0 reporting all hierarchies and the default being 50.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_utilization ?-file file_name? ?-json file_name? ?-append? ?-pblocks pblocks? ?-evaluate_pblock? ?-exclude_child_pblocks? ?-exclude_non_assigned? ?-cells cells? ?-return_string? ?-slr? ?-packthru? ?-name results_name? ?-no_primitives? ?-omit_locs? ?-hierarchical? ?-spreadsheet_file file_name? ?-spreadsheet_table table_name? ?-spreadsheet_depth depth? ?-hierarchical_depth depth? ?-hierarchical_percentages? ?-hierarchical_min_primitive_count count? ?-quiet? ?-verbose?}

    hover {
        summary {Compute the utilization of the device and display the report.}
        synopsis {report_utilization ?-file file_name? ?-json file_name? ?-append? ?-pblocks pblocks? ?-evaluate_pblock? ?-exclude_child_pblocks? ?-exclude_non_assigned? ?-cells cells? ?-return_string? ?-slr? ?-packthru? ?-name results_name? ?-no_primitives? ?-omit_locs? ?-hierarchical? ?-spreadsheet_file file_name? ?-spreadsheet_table table_name? ?-spreadsheet_depth depth? ?-hierarchical_depth depth? ?-hierarchical_percentages? ?-hierarchical_min_primitive_count count? ?-quiet? ?-verbose?}
        description {Reports resource usage on the target part by the current synthesized or implemented design, generating to the standard output when none of -file, -return_string, or -name is given; the report is available early in the design process but becomes more accurate as the design progresses from synthesis through implementation. When run in hierarchical mode, either with -hierarchical or with -name, it reports resource utilization for each hierarchy meeting the -hierarchical_min_primitive_count threshold.}
        returns {The requested information, or an error if it fails.}
        example {report_utilization -hierarchical -file util_hier.rpt}
        source {Xilinx UG835 2026.1}
    }
}
command report_values {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -radix -takes radix \
           -values {default dec bin oct hex unsigned ascii smag} -closed \
           -detail {Radix to use when returning the value of the specified objects, dec being a signed decimal.}
    option -print_type -detail {Print type information for the object.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Usage table brackets <hdl_objects> while the Arguments
    ;# prose marks it (Required); the Usage table spelling is used here.
    form Default {report_values ?-radix radix? ?-print_type? ?-quiet? ?-verbose? ?hdl_objects?}

    hover {
        summary {Print the current simulated value of the given HDL objects.}
        synopsis {report_values ?-radix radix? ?-print_type? ?-quiet? ?-verbose? ?hdl_objects?}
        description {Reports the values of the specified HDL objects, which may be given by name or returned from get_objects, at the current simulation run time; the default is the objects returned by get_objects with a * pattern. HDL objects include HDL signals, variables, or constants as declared in the Verilog or VHDL test bench and source files, so a signal covers Verilog wire and reg entities and VHDL signals, a variable covers Verilog real, realtime, time, and event, and a constant covers Verilog parameters and localparams and VHDL generics and constants.}
        returns {The name and value of the HDL objects, printed on the console in textual format.}
        example {report_values [get_objects]}
        source {Xilinx UG835 2026.1}
    }
}
command report_waivers {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the waivers report into the specified file, which is overwritten if it already exists.}
    ;# NOTE(xilinx): the Usage table lists ALL, LINT, and DESIGN_ENTRY_DRC in
    ;# addition to the three types the Arguments prose names, so the set is
    ;# listed but not marked -closed.
    option -type -takes waiver_type \
           -values {ALL DRC METHODOLOGY CDC LINT DESIGN_ENTRY_DRC} \
           -detail {Type of waiver to report, all waivers being reported when this option is not specified.}
    option -write_valid_waivers \
           -detail {Write out the waivers that were used during the last DRC, methodology, CDC, or lint run, which requires -file.}
    option -write_ignored_waivers \
           -detail {Write out the waivers that were NOT used during the last DRC, methodology, CDC, or lint run, which requires -file.}
    option -append \
           -detail {Append the output of the report to the specified file rather than overwriting it (only with -file).}
    option -return_string \
           -detail {Direct the report output to a Tcl string rather than to the standard output (not with -file).}
    option -show_msgs_with_no_waivers \
           -detail {Also list the report_drc, report_methodology, report_cdc, and report_lint messages that have no defined waivers, which are hidden by default.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_waivers ?-file file_name? ?-type waiver_type? ?-write_valid_waivers? ?-write_ignored_waivers? ?-append? ?-return_string? ?-show_msgs_with_no_waivers? ?-quiet? ?-verbose?}

    hover {
        summary {Report the status of the DRC, methodology, CDC, and lint message waivers.}
        synopsis {report_waivers ?-file file_name? ?-type waiver_type? ?-write_valid_waivers? ?-write_ignored_waivers? ?-append? ?-return_string? ?-show_msgs_with_no_waivers? ?-quiet? ?-verbose?}
        description {Reports the DRC, METHODOLOGY, and CDC violation messages and displays what waivers are in place in the current design. The report_drc, report_methodology, and report_cdc commands additionally have options to run their reports on waived violations or checks.}
        returns {A report of the DRC, METHODOLOGY, and CDC violation messages and the waivers in place in the current design.}
        example {report_waivers}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command reset_default_switching_activity {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -static_probability -detail {Reset the static probability of the specified type.}
    option -toggle_rate -detail {Reset the toggle rate of the specified type.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_default_switching_activity ?-static_probability? ?-toggle_rate? ?-quiet? ?-verbose? types}

    hover {
        summary {Reset switching activity on default types.}
        synopsis {reset_default_switching_activity ?-static_probability? ?-toggle_rate? ?-quiet? ?-verbose? types}
        description {Resets the default seed values of the switching activity on nets, ports, pins, and cells of the given types back to the tool defaults used by the vector-less propagation engine. The valid type values are input, input_set, input_reset, input_enable, register, dsp, bram_read_enable, bram_write_enable, output_enable, clock, and all. The command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {reset_default_switching_activity -toggle_rate -static_probability all}
        source {Xilinx UG835 2012.2}
    }
}
command reset_drc {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes results_name \
           -detail {Name of the DRC results to be cleared, as established by report_drc -name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_drc ?-name results_name? ?-quiet? ?-verbose?}

    hover {
        summary {Remove a DRC report.}
        synopsis {reset_drc ?-name results_name? ?-quiet? ?-verbose?}
        description {Clears the DRC results from the specified named result set, operating silently.}
        returns {Nothing.}
        example {reset_drc -name DRC1}
        source {Xilinx UG835 2026.1}
    }
}
command reset_drc_check {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Usage table brackets <checks> while the Arguments prose
    ;# marks it (Required); the Usage table spelling is used here.
    form Default {reset_drc_check ?-quiet? ?-verbose? ?checks?}

    hover {
        summary {Reset one or more DRC checks to factory defaults.}
        synopsis {reset_drc_check ?-quiet? ?-verbose? ?checks?}
        description {Resets the specified DRC checks to the defaults provided by the Vivado Design Suite, restoring the default configuration including any change to the IS_ENABLED or SEVERITY properties. IS_ENABLED can be modified on a check to disable the rule even when it is named directly in report_drc or as part of a ruledeck, and SEVERITY is a string property whose supported values are FATAL, ERROR, CRITICAL WARNING, WARNING, and ADVISORY.}
        example {reset_drc_check [get_drc_checks]}
        source {Xilinx UG835 2026.1}
    }
}
command reset_hw_axi {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Usage table brackets <hw_axis> while the Arguments
    ;# prose marks it (Required); the Usage table spelling is used here.
    form Default {reset_hw_axi ?-quiet? ?-verbose? ?hw_axis?}

    hover {
        summary {Reset the hardware AXI core state.}
        synopsis {reset_hw_axi ?-quiet? ?-verbose? ?hw_axis?}
        description {Resets the STATUS properties of the specified hw_axi objects, which must be objects returned by get_hw_axis, or of the current device, restoring the core to a known state from which to begin running AXI transactions. The properties reset are STATUS.AXI_READ_BUSY, STATUS.AXI_READ_DONE, STATUS.AXI_WRITE_BUSY, STATUS.AXI_WRITE_DONE, STATUS.BRESP giving the result of the write transfer, and STATUS.RRESP giving the result of the read transfer.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command reset_hw_ila {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -reset_compare_values -takes boolean -values {true false} -closed \
           -detail {Reset the TRIGGER_COMPARE_VALUE and CAPTURE_COMPARE_VALUE properties on the associated hw_probes, which is true by default.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_hw_ila ?-reset_compare_values boolean? ?-quiet? ?-verbose? ?hw_ilas?}

    hover {
        summary {Reset the hardware ILA control properties to their default values.}
        synopsis {reset_hw_ila ?-reset_compare_values boolean? ?-quiet? ?-verbose? ?hw_ilas?}
        description {Resets the trigger and capture configuration properties on the specified ILA debug cores, and the TRIGGER_COMPARE_VALUE and CAPTURE_COMPARE_VALUE properties on the debug probes of those cores, the current_hw_ila being reset when no hw_ila is given. The defaults restored are CONTROL.DATA_DEPTH set to the MAX_DATA_DEPTH of the core, CONTROL.TRIGGER_POSITION 0, CONTROL.WINDOW_COUNT 1, CONTROL.TRIGGER_MODE BASIC_ONLY, CONTROL.TRIGGER_CONDITION AND, CONTROL.TRIG_OUT_MODE DISABLED, CONTROL.CAPTURE_MODE ALWAYS, CONTROL.CAPTURE_CONDITION AND, and the probe compare values set to eq1'bX. The command operates silently.}
        returns {Nothing.}
        example {reset_hw_ila [get_hw_ilas]}
        source {Xilinx UG835 2026.1}
    }
}
command reset_hw_pcie {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_hw_pcie ?-quiet? ?-verbose? hw_pcie}

    hover {
        summary {Reset the PCIe core.}
        synopsis {reset_hw_pcie ?-quiet? ?-verbose? hw_pcie}
        description {Resets the PCI Express debug core object, hw_pcie, defined on the current hardware device, resetting the PCIe soft IP in hardware. The customizable LogiCORE IP PCIe core for Versal adaptive SoCs evaluates and monitors the PCIe Link Training and Status State Machine running on the gigabit transceivers, and appears in the Vivado hardware manager as a hw_pcie object usable for problems from viewing the PCIe link information to the LTSSM state transition diagram.}
        example {reset_hw_pcie [lindex [get_hw_pcies] 0]}
        source {Xilinx UG835 2026.1}
    }
}
command reset_hw_vio_activity {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_hw_vio_activity ?-quiet? ?-verbose? hw_vios}

    hover {
        summary {Reset the ACTIVITY_VALUE properties of the probes on the specified hardware VIO objects.}
        synopsis {reset_hw_vio_activity ?-quiet? ?-verbose? hw_vios}
        description {Resets the ACTIVITY_VALUE properties for all hardware probes on the specified VIO debug core objects, which may be given as objects returned by get_hw_vios or by name. The Vivado IDE uses ACTIVITY_VALUE to represent transitions on the input probes of the VIO debug cores, indicating when the values on the VIO inputs have changed between periodic updates.}
        returns {Nothing.}
        example {reset_hw_vio_activity [get_hw_vios]}
        source {Xilinx UG835 2026.1}
    }
}
command reset_hw_vio_outputs {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_hw_vio_outputs ?-quiet? ?-verbose? hw_vios}

    hover {
        summary {Reset the hardware VIO core outputs to their initial values.}
        synopsis {reset_hw_vio_outputs ?-quiet? ?-verbose? hw_vios}
        description {Restores the signal values at the output probes of the specified hw_vio debug cores to their initial, or reset, state; the objects may be given as objects returned by get_hw_vios or by name. The Virtual Input/Output debug core can both monitor and drive internal signals on a programmed FPGA in real time through hw_probe objects, and this command affects the signal on the hw_device without affecting the OUTPUT_VALUE property of the probes.}
        returns {Nothing.}
        example {reset_hw_vio_outputs [get_hw_vios {hw_vio_1}]}
        source {Xilinx UG835 2026.1}
    }
}
command reset_methodology {
    available {tcl 8.5}
