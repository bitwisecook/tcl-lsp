command include_bd_addr_seg {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {include_bd_addr_seg ?-quiet? ?-verbose? ?segment_to_include?}

    hover {
        summary {Include segment from an address space.}
        synopsis {include_bd_addr_seg ?-quiet? ?-verbose? ?segment_to_include?}
        description {Reverses the exclusion of an AXI peripheral address segment from access by the AXI master and restores the address segment to a mapped state. Address segments of AXI peripherals in a block design are unmapped, mapped, or excluded; exclude_bd_addr_seg excludes a mapped segment from access by its master, and this command restores that access. The segment is a single bd_addr_seg object.}
        returns {The newly included segment object, or the empty string if it failed.}
        example {include_bd_addr_seg [get_bd_addr_segs microblaze_1/Data/SEG_axi_gpio_1_Reg]}
        source {Xilinx UG835 2026.1}
    }
}
command infer_diff_pairs {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file_type -takes file_type -values {csv xdc} -closed \
           -detail {The type of file to import when inferring differential pairs; there is no default, so the file type must be specified.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {infer_diff_pairs ?-file_type file_type? ?-quiet? ?-verbose? ?file?}

    hover {
        summary {Infer differential pairs, typically for ports just imported from a CSV or XDC file.}
        synopsis {infer_diff_pairs ?-file_type file_type? ?-quiet? ?-verbose? ?file?}
        description {Infers differential pairs in an I/O Pin Planning project after the I/O pin information has been imported with read_csv or read_xdc. The attributes that identify differential pairs in the file are Signal Name, DiffPair Signal, DiffPair Type, and I/O Standard, and the tool identifies matching, unmatched, single-port, and inferred differential pairs from them, creating a pair only when the other attributes are compatible.}
        example {read_xdc C:/Vivado_Install/io_1.xdc
infer_diff_pairs C:/Vivado_Install/io_1.xdc -file_type xdc}
        source {Xilinx UG835 2026.1}
    }
}
command instantiate_example_design {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -design -takes design_name \
           -detail {For embedded processor example designs, the name of the open and current block design to instantiate the example design into; an error is returned if it is not specified for those designs.}
    option -hier -takes hierarchy_block \
           -detail {Hierarchy block for the example design.}
    option -project -takes project_name -detail {Project name.}
    option -project_location -takes project_location \
           -detail {Project location; the default is the current directory.}
    option -options -takes configurable_options \
           -detail {The values of configurable properties of the example design.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {instantiate_example_design ?-design design_name? ?-hier hierarchy_block? ?-project project_name? ?-project_location project_location? ?-options configurable_options? ?-quiet? ?-verbose? template}

    hover {
        summary {Creates an example design from a predefined template in an open project.}
        synopsis {instantiate_example_design ?-design design_name? ?-hier hierarchy_block? ?-project project_name? ?-project_location project_location? ?-options configurable_options? ?-quiet? ?-verbose? template}
        description {Creates an example design from a predefined template in an open project. The target part of the open project must be compatible with the example design as defined by the SUPPORTED_PARTS property of the example, or an error is returned. The embedded processor example designs base_microblaze and base_zynq must be created in an open block design in the Vivado IP integrator and require a board defined by the BOARD_PART property rather than a target part. The template is specified by name or as an object returned by get_example_designs.}
        returns {The name of the template applied.}
        example {create_project zynq1 -force
set_property BOARD_PART em.avnet.com:zed:1.3 [current_project]
create_bd_design myFirstZynq
instantiate_example_design -design myFirstZynq \
[lindex [get_example_designs] 1]}
        source {Xilinx UG835 2026.1}
    }
}
command instantiate_template_bd_design {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -design -takes design_name \
           -detail {The name of the block design to instantiate the template diagram into; it must exist and be open in the IP integrator or an error is returned (required).}
    option -hier -takes hierarchy_block \
           -detail {Hierarchy block for the template design.}
    option -options -takes configurable_options \
           -detail {Configurable options of the template design.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {instantiate_template_bd_design -design design_name ?-hier hierarchy_block? ?-options configurable_options? ?-quiet? ?-verbose? template}

    hover {
        summary {Creates a block design in IP integrator from a predefined template.}
        synopsis {instantiate_template_bd_design -design design_name ?-hier hierarchy_block? ?-options configurable_options? ?-quiet? ?-verbose? template}
        description {Creates an example design from a template block design in the IP integrator of the Vivado Design Suite. The template diagram is created in an existing and open block design, and the target part specified by the current project or in-memory project must be compatible with the template design or an error is returned. The template is specified by name or as an object returned by the template block design query command.}
        returns {The name of the template applied.}
        example {instantiate_template_bd_design -design myFirstZynq \
[lindex [get_template_bd_designs] 1]}
        source {Xilinx UG835 2026.1}
    }
}
command iphys_opt_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fanout_opt \
           -detail {Perform delay-driven fanout optimization on the specified net, including very high fanout optimizations, by replicating drivers to reduce delay.}
    option -critical_cell_opt \
           -detail {Do cell-duplication based optimization on timing critical nets.}
    option -replicate_cell \
           -detail {Atomic cell replication operation, for interconnect retiming and LUT optimization.}
    option -reconnect \
           -detail {Reconnect loads from equivalent drivers for interconnect retiming and LUT optimization.}
    option -placement_opt -detail {Move cells to reduce delay on timing-critical nets.}
    option -forward_retime -detail {Forward retiming optimization.}
    option -backward_retime -detail {Backward retiming optimization.}
    option -net -takes net -detail {The net to apply an optimization to.}
    option -cluster -takes cluster \
           -detail {A cluster of load pins (required).}
    option -place_cell -takes cell_site_list \
           -detail {Place the specified cells, or cells connected to the specified pins, on the device sites specified (required).}
    option -dsp_register_opt \
           -detail {Improve critical path delay by moving registers from slices to DSP blocks, or from DSP blocks to slices.}
    option -bram_register_opt \
           -detail {Improve critical path delay by moving registers from slices to block RAMs, or from block RAMs to slices.}
    option -uram_register_opt \
           -detail {Improve critical path delay by moving registers from slices to UltraRAMs, or from UltraRAMs to slices.}
    option -shift_register_opt \
           -detail {Perform shift register optimization to improve timing on negative slack paths between shift register cells and other logic cells.}
    option -cell -takes cell -detail {A cell to apply an optimization to.}
    option -packing -detail {Packing in DSP or block RAM.}
    option -unpacking -detail {Unpacking in DSP or block RAM.}
    option -port -takes port \
           -detail {A port on a cell to apply the optimization to.}
    option -critical_pin_opt \
           -detail {For LUT inputs, remap logical pins to physical pins, also known as pin-swapping, to improve critical path timing.}
    option -restruct_opt -detail {LUT restructuring optimization.}
    option -equ_drivers_opt -detail {Equivalent driver rewiring.}
    option -skipped_optimization \
           -detail {Define the specified optimization as not performed, as for optimizations identified by phys_opt_design that are skipped because suitable locations for optimized logic cannot be found.}
    option -create_bufg -detail {Insert a BUFG to drive high-fanout nets.}
    option -insert_negative_edge_ffs \
           -detail {Insert negative edge, or falling edge triggered flip flops to help manage hold timing.}
    option -hold_fix \
           -detail {Perform optimizations to insert data path delay buffers for hold fix optimization.}
    option -slr_crossing_opt \
           -detail {Perform post-place or post-route optimizations to improve the path delay of inter-SLR connections, for use with UltraScale and UltraScale+ devices.}
    option -shift_register_to_pipeline \
           -detail {Shift register to pipeline optimization.}
    option -auto_pipeline -detail {Auto pipeline the design.}
    option -pipeline_to_shift_register \
           -detail {Pipeline to shift register optimization.}
    option -control_set_opt -detail {Control set optimization.}
    option -memory_rewire_opt -detail {Memory rewire optimization.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {iphys_opt_design ?-fanout_opt? ?-critical_cell_opt? ?-replicate_cell? ?-reconnect? ?-placement_opt? ?-forward_retime? ?-backward_retime? ?-net net? -cluster cluster -place_cell cell_site_list ?-dsp_register_opt? ?-bram_register_opt? ?-uram_register_opt? ?-shift_register_opt? ?-cell cell? ?-packing? ?-unpacking? ?-port port? ?-critical_pin_opt? ?-restruct_opt? ?-equ_drivers_opt? ?-skipped_optimization? ?-create_bufg? ?-insert_negative_edge_ffs? ?-hold_fix? ?-slr_crossing_opt? ?-shift_register_to_pipeline? ?-auto_pipeline? ?-pipeline_to_shift_register? ?-control_set_opt? ?-memory_rewire_opt? ?-quiet? ?-verbose?}

    hover {
        summary {Interactive phys_opt_design.}
        synopsis {iphys_opt_design ?-fanout_opt? ?-critical_cell_opt? ?-replicate_cell? ?-reconnect? ?-placement_opt? ?-forward_retime? ?-backward_retime? ?-net net? -cluster cluster -place_cell cell_site_list ?-dsp_register_opt? ?-bram_register_opt? ?-uram_register_opt? ?-shift_register_opt? ?-cell cell? ?-packing? ?-unpacking? ?-port port? ?-critical_pin_opt? ?-restruct_opt? ?-equ_drivers_opt? ?-skipped_optimization? ?-create_bufg? ?-insert_negative_edge_ffs? ?-hold_fix? ?-slr_crossing_opt? ?-shift_register_to_pipeline? ?-auto_pipeline? ?-pipeline_to_shift_register? ?-control_set_opt? ?-memory_rewire_opt? ?-quiet? ?-verbose?}
        description {Describes one specific optimization that was performed by phys_opt_design, such as replicating a critical cell or pulling registers from a block RAM, and carries all the information needed to recreate both the post-optimization logical netlist and the placement changes the optimized netlist requires. Interactive physical optimization is used either to apply post-placement optimizations to the pre-placement netlist or to save the optimizations in a Tcl script to be repeated as needed; write_iphys_opt_tcl writes those scripts and read_iphys_opt_tcl reads them back. The command is intended for use inside the iphys_opt Tcl script file rather than at the command line.}
        returns {A transcript of the processes, or an error if it fails.}
        example {iphys_opt_design -shift_register_opt -cell \
   {ADUR_CORE_INST/EMIF_INTERFACE_INST/EMIF_HOST_IF_INST/DLY_INST1 \
   /PD_INST_FPGA/delay_chain_reg[9][16]_srl9} -port D}
        source {Xilinx UG835 2026.1}
    }
}
