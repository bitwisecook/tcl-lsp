}
command create_xps {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_xps ?-quiet? ?-verbose? name}

    hover {
        summary {Create an embedded source for XPS and add it to the source fileset.}
        synopsis {create_xps ?-quiet? ?-verbose? name}
        description {Creates an Embedded Processor source for use in the current project and adds it to the source files, launching Xilinx Platform Studio (XPS) so the hardware portion of the embedded processor system can be designed. On exiting XPS the files for the sub-design are written to the local project directory, project_name.srcs/sources_1/edk/name, and added to the source files. Existing Xilinx Microprocessor Project (.xmp) files can instead be brought in with add_files.}
        returns {The source file name that was created.}
        example {create_xps xpsTest1}
        source {Xilinx UG835 2012.2}
    }
}
