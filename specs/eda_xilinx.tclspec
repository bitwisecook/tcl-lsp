command delete_rpm {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_rpm ?-quiet? ?-verbose? rpm}

    hover {
        summary {Delete an RPM.}
        synopsis {delete_rpm ?-quiet? ?-verbose? rpm}
        description {Deletes the specified Relationally Placed Macro from the design. An RPM is a list of logic elements collected into a set whose placement relative to other elements of the set is controlled by Relative Location Constraints. Only user-defined RPMs can be deleted; RPMs defined by the hierarchy or in the netlist cannot be deleted by this command.}
        returns {Nothing.}
        example {delete_rpm cs_ila_0/U0}
        source {Xilinx UG835 2026.1}
