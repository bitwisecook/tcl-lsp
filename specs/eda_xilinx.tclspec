command get_pplocs {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -nets -takes nets -detail {List of nets to report the PPLOCs of (required).}
    option -pins -takes pins -detail {List of pins to report the PPLOCs of (required).}
    option -count -detail {Count the number of PPLOCs and do not report PPLOC or node names.}
    option -unlocked -detail {Report unlocked or unfixed PPLOCs only.}
    option -locked \
           -detail {Report locked or fixed PPLOCs only; use -level to specify the locked level.}
    option -level -takes level -values {placement routing} -closed \
           -detail {The locked level to report; the default is placement.}
    option -wire -detail {Get wires instead of nodes for assigned PPLOCs.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_pplocs -nets nets -pins pins ?-count? ?-unlocked? ?-locked? ?-level level? ?-wire? ?-quiet? ?-verbose?}

    hover {
        summary {Internal task that reports the PPLOCs on pins or nets.}
        synopsis {get_pplocs -nets nets -pins pins ?-count? ?-unlocked? ?-locked? ?-level level? ?-wire? ?-quiet? ?-verbose?}
        description {Reports the PPLOCs on the given objects: -nets returns the PPLOCs on the given nets, -pins returns the PPLOCs on the given pins, and if neither is specified all PPLOCs in the design are returned.}
        returns {The PPLOC nodes, or the number of PPLOCs.}
        source {Xilinx UG835 2026.1}
    }
}
