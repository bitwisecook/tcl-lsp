command report_high_fanout_nets {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -file -takes file \
           -detail {Write the report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the report to the existing file rather than overwriting it (only with -file).}
    option -ascending -detail {Report nets in ascending order.}
    option -load_types \
           -detail {Add details of the various load types on the net to the report, after placement.}
    option -clock_regions \
           -detail {Report the load distribution across clock regions, after placement.}
    option -slr -detail {Report the load distribution across SLRs, after placement.}
    option -max_nets -takes count \
           -detail {Number of nets for which the report is generated, defaulting to 10.}
    option -min_fanout -takes count \
           -detail {Report nets whose fanout is greater than or equal to the specified integer, defaulting to 1.}
    option -max_fanout -takes count \
           -detail {Report nets whose fanout is less than or equal to the specified integer, with no maximum by default.}
    option -cells -takes cells \
           -detail {Report the nets attached to the specified cells or bel_instances in the design.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_high_fanout_nets ?-file file? ?-append? ?-ascending? ?-load_types? ?-clock_regions? ?-slr? ?-max_nets count? ?-min_fanout count? ?-max_fanout count? ?-cells cells? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report high fanout nets.}
        synopsis {report_high_fanout_nets ?-file file? ?-append? ?-ascending? ?-load_types? ?-clock_regions? ?-slr? ?-max_nets count? ?-min_fanout count? ?-max_fanout count? ?-cells cells? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports the fanout of nets in the design, starting with the highest fanout nets and working down, with options controlling how many nets are reported, the fanout range of interest, the cells to restrict the report to, and whether load types, clock regions, or SLRs are detailed.}
        returns {Report.}
        example {report_high_fanout_nets -min_fanout 50 -max_nets 100}
        source {Xilinx UG835 2012.2}
    }
}
