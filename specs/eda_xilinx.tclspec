    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_methodology ?-name results_name? ?-quiet? ?-verbose?}

    hover {
        summary {Remove a methodology report.}
        synopsis {reset_methodology ?-name results_name? ?-quiet? ?-verbose?}
        description {Clears the methodology results from the specified named result set, operating silently.}
        returns {Nothing.}
        example {reset_methodology -name ultrafast_methodology_3}
        source {Xilinx UG835 2026.1}
    }
}
command reset_methodology_check {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Usage table brackets <checks> while the Arguments prose
    ;# marks it (Required); the Usage table spelling is used here.
    form Default {reset_methodology_check ?-quiet? ?-verbose? ?checks?}

    hover {
        summary {Reset one or more methodology checks to factory defaults.}
        synopsis {reset_methodology_check ?-quiet? ?-verbose? ?checks?}
        description {Resets the specified methodology checks to the defaults provided by the Vivado Design Suite, restoring the default configuration including any change to the IS_ENABLED or SEVERITY properties. IS_ENABLED can be modified on a check to disable the rule even when it is named directly in report_methodology, and SEVERITY is an enumerated property whose supported values are FATAL, ERROR, CRITICAL WARNING, WARNING, and ADVISORY.}
        example {reset_methodology_check [get_methodology_checks CHECK-4]}
        source {Xilinx UG835 2026.1}
    }
}
command reset_msg_config {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -string -takes strings \
           -detail {Apply the operation only to messages containing the given list of case-sensitive strings, which must be enclosed in braces.}
    option -id -takes message_id \
           -detail {Reset messages matching the specified message ID, such as Common 17-54, a wildcard * meaning all message IDs.}
    option -severity -takes severity \
           -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} -closed \
           -detail {Reset messages with the specified message severity.}
    option -limit \
           -detail {Reset the limit values for the message controls matching the given qualifiers for the current project.}
    option -suppress \
           -detail {Stop suppressing the messages matching the given qualifiers for the current project.}
    option -count \
           -detail {Reset the count of messages for all message controls matching the given qualifiers, so messages are not suppressed by a -limit control until the count again exceeds the limit.}
    option -default_severity \
           -detail {Restore the default message severity for the message controls matching the given qualifiers.}
    option -regexp -detail {The values used for -string are full regular expressions.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_msg_config ?-string strings? ?-id message_id? ?-severity severity? ?-limit? ?-suppress? ?-count? ?-default_severity? ?-regexp? ?-quiet? ?-verbose?}

    hover {
        summary {Reset or remove a message control rule previously defined by set_msg_config.}
        synopsis {reset_msg_config ?-string strings? ?-id message_id? ?-severity severity? ?-limit? ?-suppress? ?-count? ?-default_severity? ?-regexp? ?-quiet? ?-verbose?}
        description {Restores the default message limit or severity settings for messages returned by the Vivado tool, or unsuppresses previously suppressed messages, as configured by set_msg_config. Only one reset action may be performed per command. The string, ID, and severity qualifiers select which messages are reset and have an AND relationship, and at least one qualifier must be supplied. Use get_msg_config to report the rule configurations currently in effect.}
        returns {An error is returned if more than one reset action is attempted in a single command.}
        example {set_msg_config -id "Common 17-81" -new_severity "CRITICAL WARNING"
reset_msg_config -id "Common 17-81" -default_severity}
        source {Xilinx UG835 2026.1}
    }
}
command reset_msg_count {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_msg_count ?-quiet? ?-verbose? id}

    hover {
        summary {Reset the message count for a message ID.}
        synopsis {reset_msg_count ?-quiet? ?-verbose? id}
        description {Resets the message count for the specified message ID to 0, restarting the counter toward the message limit; specifying * resets the count of all messages. Every message delivered by the tool has a unique global message ID made of an application subsystem code and a message identifier, such as Common 17-54, Netlist 29-28, or Synth 8-3295, and get_msg_count returns the current count for one of them.}
        returns {New message count.}
        example {reset_msg_count *}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command reset_msg_limit {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table gives ALL as the default severity, which is not
    ;# among the five severities the Arguments prose lists, so the set is left open.
    option -severity -takes severity \
           -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} \
           -detail {Message severity whose limit is reset, defaulting to ALL and not valid with -id.}
    option -id -takes id \
           -detail {Unique message ID whose limit is reset, such as Common-99, and not valid with -severity.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-severity -id}

    form Default {reset_msg_limit ?-severity severity? ?-id id? ?-quiet? ?-verbose?}

    hover {
        summary {Reset the message limit.}
        synopsis {reset_msg_limit ?-severity severity? ?-id id? ?-quiet? ?-verbose?}
        description {Restores the default message limit, either for a specific message ID, for a specific message severity, or for all messages returned. The default limit for all messages returned is 4,294,967,295, and the five message severities are ERROR, CRITICAL WARNING, WARNING, INFO, and STATUS; because CRITICAL WARNING is a two word value it must be enclosed in braces or quotes.}
        returns {New message limit.}
        example {reset_msg_limit -id "Netlist 29-28"}
        source {Xilinx UG835 2012.2}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command reset_msg_severity {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_msg_severity ?-quiet? ?-verbose? id}

    hover {
        summary {Reset the message severity of a message ID.}
        synopsis {reset_msg_severity ?-quiet? ?-verbose? id}
        description {Restores the specified message ID to its default severity. Use this command after set_msg_severity to restore a specific message ID to its original severity level.}
        returns {Nothing.}
        example {reset_msg_severity common-99}
        source {Xilinx UG835 2012.2}
    }
}
command reset_operating_conditions {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -voltage -takes supplies \
           -detail {Reset the named voltage supplies to their default value, the supported supplies varying by device family.}
    option -grade -detail {Reset the temperature grade of the selected device, whose default is commercial.}
    option -process -detail {Reset the manufacturing process for the target device, whose default is typical.}
    option -junction_temp -detail {Reset the junction temperature for the target device, whose default is auto.}
    option -ambient_temp -detail {Reset the ambient temperature of the design, whose default is default.}
    option -thetaja -detail {Reset the Theta-JA thermal resistance, whose default is auto.}
    option -thetasa -detail {Reset the Theta-SA thermal resistance, whose default is auto.}
    option -airflow \
           -detail {Reset the linear feet per minute airflow, whose default varies by device family.}
    option -heatsink -detail {Reset the heatsink profile, whose default is medium.}
    option -thetajb -detail {Reset the Theta-JB thermal resistance, whose default is auto.}
    option -board -detail {Reset the board size used for modeling, whose default is medium.}
    option -board_temp -detail {Reset the board temperature to the default setting.}
    option -board_layers \
           -detail {Reset the number of board layers used for modeling to the default setting of 12to15.}
    option -design_power_budget -detail {Reset the design power budget to unspecified.}
    option -supply_current_budget -takes budgets \
           -detail {Reset the named supply current budgets to their default value, the supply names depending on the device family.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_operating_conditions ?-voltage supplies? ?-grade? ?-process? ?-junction_temp? ?-ambient_temp? ?-thetaja? ?-thetasa? ?-airflow? ?-heatsink? ?-thetajb? ?-board? ?-board_temp? ?-board_layers? ?-design_power_budget? ?-supply_current_budget budgets? ?-quiet? ?-verbose?}

    hover {
        summary {Reset the operating conditions to the tool defaults for power estimation.}
        synopsis {reset_operating_conditions ?-voltage supplies? ?-grade? ?-process? ?-junction_temp? ?-ambient_temp? ?-thetaja? ?-thetasa? ?-airflow? ?-heatsink? ?-thetajb? ?-board? ?-board_temp? ?-board_layers? ?-design_power_budget? ?-supply_current_budget budgets? ?-quiet? ?-verbose?}
        description {Resets the specified operating conditions to their default values, all of them being reset when none is specified. Operating conditions are set with set_operating_conditions and their current values reported by report_operating_conditions; the environmental operating conditions of the device are used for power analysis in report_power but not during timing analysis.}
        returns {Nothing.}
        example {reset_operating_conditions -junction_temp -ambient_temp -board_temp}
        source {Xilinx UG835 2026.1}
    }
}
command reset_param {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_param ?-quiet? ?-verbose? name}

    hover {
        summary {Reset a parameter to its default value.}
        synopsis {reset_param ?-quiet? ?-verbose? name}
        description {Restores a user-definable configuration parameter that has been changed with set_param to its default value; only one parameter can be reset at a time. Use report_param to see which parameters are currently defined.}
        returns {Original value.}
        example {reset_param tcl.statsThreshold}
        source {Xilinx UG835 2026.1}
    }
}
command reset_project {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -exclude_runs \
           -detail {Exclude the project runs folder from the reset, preserving it while the rest of the project data is removed.}
    option -exclude_ips \
           -detail {Exclude the project IP folder, which holds the IP cores and generated targets, from the reset.}
    option -exclude_sim_runs \
           -detail {Exclude the project simulation folder from the reset, preserving it while the rest of the project data is removed.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_project ?-exclude_runs? ?-exclude_ips? ?-exclude_sim_runs? ?-quiet? ?-verbose?}

    hover {
        summary {Reset the current project to its starting condition.}
        synopsis {reset_project ?-exclude_runs? ?-exclude_ips? ?-exclude_sim_runs? ?-quiet? ?-verbose?}
        description {Resets the current project to its starting condition, keeping the source and constraint files but cleaning out the output files created during synthesis, simulation, implementation, and write_bitstream, and resetting the state of the project to the start of the design flow. User-defined Tcl variables in the global namespace are not reset or cleared by this command; they persist for the invocation of Vivado and can be cleared with the unset command.}
        example {reset_project -exclude_sim_runs -verbose}
        source {Xilinx UG835 2026.1}
    }
}
command reset_property {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_property ?-quiet? ?-verbose? property_name objects}

    hover {
        summary {Reset a property on the specified objects.}
        synopsis {reset_property ?-quiet? ?-verbose? property_name objects}
        description {Restores the named property to its default value on the specified object or objects. If no default is defined for the property, the property is unassigned on the specified object.}
        returns {The value that was set if successful, or the empty string on failure.}
        example {reset_property DOB_REG [get_cells usbEngine1/usbEngineSRAM/snoopyRam_reg_19]}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command reset_run {
    available {tcl 8.5}
