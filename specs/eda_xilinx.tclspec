command apply_bd_automation {
    dialects tcl8.5
    required_package vivado

    form Default {apply_bd_automation -rule rule_name ?-config config?}

    hover {
        summary {Apply block design automation rules.}
        synopsis {apply_bd_automation -rule rule_name ?-config config?}
        source {F5}
    }
}
command archive_project {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -force \
           -detail {Overwrite an existing ZIP file of the same name; without it the tool returns an error when the file exists.}
    option -exclude_run_results \
           -detail {Exclude the results of any synthesis or implementation runs, which can greatly reduce the size of the archive.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {archive_project ?-force? ?-exclude_run_results? ?-quiet? ?-verbose? ?file?}

    hover {
        summary {Archive the current project.}
        synopsis {archive_project ?-force? ?-exclude_run_results? ?-quiet? ?-verbose? ?file?}
        description {Archives a project to store as backup, or to encapsulate the design and send it to a remote site. The tool parses the hierarchy of the design, copies the required source, include, and remote files from the library directories, copies the constraint files and the results of the various synthesis, simulation, and implementation runs, and then creates a ZIP file of the project; without a file name the archive takes the name of the project.}
        returns {True.}
        example {archive_project -force -exclude_run_results proj3.zip}
        source {Xilinx UG835 2012.2}
    }
}
command assign_bd_address {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {assign_bd_address ?-quiet? ?-verbose? ?objects...?}

    hover {
        summary {Automatically assign addresses to unmapped IP.}
        synopsis {assign_bd_address ?-quiet? ?-verbose? ?objects...?}
        description {Automatically assigns addresses to unmapped IP in the block design, optionally restricted to the specified objects.}
        returns {The newly mapped segments, "" if failed.}
        source {Xilinx UG835 2012.2}
    }
}
command auto_bd_connect {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -interactive -takes state \
           -detail {Launch the auto_connect dialog if true; the default is HDFALSE.}
    option -mode -takes mode \
           -detail {Run IP-based or Rule-based auto_connect (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {auto_bd_connect ?-interactive state? -mode mode ?-quiet? ?-verbose? cell}

    hover {
        summary {Auto connect the cell just created in the current design.}
        synopsis {auto_bd_connect ?-interactive state? -mode mode ?-quiet? ?-verbose? cell}
        description {Automatically connects the named cell in the current block design, using either IP-based or rule-based connection as selected by -mode.}
        returns {TCL_OK, TCL_ERROR if failed.}
        source {Xilinx UG835 2012.2}
    }
}
command checkpoint_vcd {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {checkpoint_vcd ?-quiet? ?-verbose? ?VCDObject?}

    hover {
        summary {Insert current HDL object signal values into the VCD file.}
        synopsis {checkpoint_vcd ?-quiet? ?-verbose? ?VCDObject?}
        description {Models the behavior of the Verilog $dumpall system task, providing the initial values of the specified signals in the Value Change Dump file, which can be used to view simulation results in a VCD viewer or to estimate design power. The open_vcd and log_vcd commands must be run first, and the simulation must be run or rerun afterwards to capture the values; without a VCDObject the tool writes to the current VCD.}
        returns {Nothing.}
        example {checkpoint_vcd foo.vcd}
        source {Xilinx UG835 2012.2}
    }
}
command close_design {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {close_design ?-quiet? ?-verbose?}

    hover {
        summary {Close the current design.}
        synopsis {close_design ?-quiet? ?-verbose?}
        description {Closes the currently active design. If the design has been modified there is no prompt to save it, so save_design or save_design_as must be run first to keep any changes; when several designs are open, current_design selects which one is closed.}
        returns {Nothing.}
        example {current_design rtl_1
close_design}
        source {Xilinx UG835 2012.2}
    }
}
