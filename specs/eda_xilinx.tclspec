    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reimport_files ?-force? ?files ...? ?-quiet? ?-verbose?}

    hover {
        summary {Reimport files when they are found out-of-date.}
        synopsis {reimport_files ?-force? ?files ...? ?-quiet? ?-verbose?}
        description {Reimports project files, updating the local project files from the original referenced source files. If no files are specified, all files in the project that are out-of-date are reimported; with -force and no files, all files in the project are reimported.}
        returns {A list of the file objects that were imported.}
        example {reimport_files -force}
        source {Xilinx UG835 2012.2}
    }
}
