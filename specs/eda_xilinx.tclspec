command reset_default_switching_activity {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -static_probability -detail {Reset the static probability of the specified type.}
    option -toggle_rate -detail {Reset the toggle rate of the specified type.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_default_switching_activity ?-static_probability? ?-toggle_rate? ?-quiet? ?-verbose? types}

    hover {
        summary {Reset switching activity on default types.}
        synopsis {reset_default_switching_activity ?-static_probability? ?-toggle_rate? ?-quiet? ?-verbose? types}
        description {Resets the default seed values of the switching activity on nets, ports, pins, and cells of the given types back to the tool defaults used by the vector-less propagation engine. The valid type values are input, input_set, input_reset, input_enable, register, dsp, bram_read_enable, bram_write_enable, output_enable, clock, and all. The command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {reset_default_switching_activity -toggle_rate -static_probability all}
        source {Xilinx UG835 2012.2}
    }
}
