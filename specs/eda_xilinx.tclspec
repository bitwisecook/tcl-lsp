        summary {Get switching activity on specified objects.}
        synopsis {report_switching_activity ?-static_probability? ?-signal_rate? ?-file file? ?-return_string? ?-quiet? ?-verbose? ?objects?}
        description {Reports the switching activity of design nets, ports, pins, and cells, covering simple signal rate and simple static probability on nets, ports, and pins, and state dependent static probabilities on cells. The reported values are defined using the set_switching_activity command, and by default the report is written to the Tcl console or standard output.}
        returns {Nothing.}
        example {report_switching_activity -signal_rate -static_probability [all_outputs]}
        source {Xilinx UG835 2012.2}
    }
}
