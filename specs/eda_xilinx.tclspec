    option -noclean_dir \
           -detail {Do not remove the run output files and directories from disk; the run is deleted from the project but its files remain in the project directory.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_run ?-noclean_dir? ?-quiet? ?-verbose? run}

    hover {
        summary {Delete an existing synthesis or implementation run.}
        synopsis {delete_run ?-noclean_dir? ?-quiet? ?-verbose? run}
        description {Deletes the specified run from the project and, unless -noclean_dir is given, deletes all results of the run from the project directory on the hard drive.}
        returns {Nothing.}
