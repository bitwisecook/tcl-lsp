command connect_net {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -net -takes net \
           -detail {The net to connect; each bit of a bus created with the -bus_from and -bus_to arguments of create_net must be connected separately (required).}
    option -objects -takes objects \
           -detail {The list of one or more pin or port objects to connect the net to (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {connect_net -net net -objects objects ?-quiet? ?-verbose?}

    hover {
        summary {Connect a net to pins or ports.}
        synopsis {connect_net -net net -objects objects ?-quiet? ?-verbose?}
        description {Connects a specified net to one or more pins or ports in the netlist of an open Synthesized or Implemented Design. Netlist editing changes the in-memory view of the netlist only, so changes must be saved with write_checkpoint or exported with the appropriate write_ command; netlist editing is not allowed on an RTL design.}
        returns {Nothing.}
        example {create_port -direction IN enableIn
create_pin -direction IN myDMA/en
create_net myEnable
connect_net -net myEnable -objects {enableIn myDMA/en}}
        source {Xilinx UG835 2012.2}
    }
}
