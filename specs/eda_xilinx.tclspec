    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -all_violators -detail {Report only the objects where check violations occur.}
    option -significant_digits -takes digits \
           -detail {Number of significant digits in the output results, from 0 to 13.}
    option -limit -takes count \
           -detail {Number of checks of a particular type to report per clock, at least 1 and defaulting to 1.}
    option -min_period -detail {Report minimum period checks only.}
    option -max_period -detail {Report maximum period checks only.}
    option -low_pulse -detail {Report minimum low pulse width checks only.}
