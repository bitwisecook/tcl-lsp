    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Returns row of this section says "Nothing" while the
    ;# section summary and Description both say a rank-ordered list of candidates
    ;# is returned; the Returns row is recorded as written.

    form Default {find_top ?-fileset fileset? ?-files files? ?-quiet? ?-verbose?}

    hover {
        summary {Find top module candidates in the supplied files, fileset, or active fileset.}
        synopsis {find_top ?-fileset fileset? ?-files files? ?-quiet? ?-verbose?}
        description {Finds the most likely candidates for the top module among the files of the current fileset, of the specified fileset, or of the specified list of files, ordered so that index 0 is the best candidate. Use lindex to select that candidate.}
