    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_hw_probe ?-quiet? ?-verbose? hw_probes}

    hover {
        summary {Delete hardware probe objects.}
        synopsis {delete_hw_probe ?-quiet? ?-verbose? hw_probes}
        description {Deletes user-defined probes from the current hw_ila. The probes must have been created by create_hw_probe and must be specified as objects returned by get_hw_probes.}
        returns {Nothing if successful; an error if it fails.}
        example {delete_hw_probe [get_hw_probe probeAR]}
        source {Xilinx UG835 2026.1}
    }
}
command delete_hw_target {
