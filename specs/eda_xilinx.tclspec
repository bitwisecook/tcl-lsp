    hover {
        summary {Set the system monitor register value.}
        synopsis {set_hw_sysmon_reg ?-quiet? ?-verbose? hw_sysmon hexaddress hexdata}
        description {Sets the register at the specified hex address on the hw_sysmon object of the current device to the specified hex data value. Some system monitor registers are read-only and cannot be set directly, and the command has no effect on those. The recommended procedure is to update properties on the hw_sysmon object with set_property and then write them with commit_hw_sysmon.}
        returns {Nothing.}
        example {set_hw_sysmon_reg [current_hw_device] 00 9D28}
        source {Xilinx UG835 2026.1}
    }
}
command set_input_jitter {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_input_jitter ?-quiet? ?-verbose? clock input_jitter}

    hover {
        summary {Set input jitter for a clock object.}
        synopsis {set_input_jitter ?-quiet? ?-verbose? clock input_jitter}
        description {Specifies additional input jitter, in nanoseconds and with a value greater than or equal to 0, for one primary clock defined with create_clock; because the command accepts a single clock, the jitter for each primary clock must be set individually. Input jitter cannot be set on generated or auto-derived clocks, although it is propagated to generated clocks from the master clock except for MMCM and PLL, and it is used in the calculation of discrete jitter. The command is ignored during synthesis.}
        returns {Clock.}
        example {set_input_jitter sysClk 0.3
set_input_jitter procClk 0.3}
        source {Xilinx UG835 2026.1}
    }
}
command set_logic_unconnected {
