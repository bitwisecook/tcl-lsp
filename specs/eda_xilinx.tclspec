command decrypt_bitstream {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -encrypted_file -takes file_name \
           -detail {AES-GCM encrypted bitstream, given as a .bit or .rbt file, to be decrypted (required).}
    option -keyfile -takes file_name \
           -detail {Encryption key file, given as a .nky or .nkz file, needed for decrypting the encrypted bitstream (required).}
    option -force -detail {Overwrite an existing file of the same name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {decrypt_bitstream -encrypted_file file_name -keyfile file_name ?-force? ?-quiet? ?-verbose? file}

    hover {
        summary {Decrypt an AES-GCM encrypted bitstream.}
        synopsis {decrypt_bitstream -encrypted_file file_name -keyfile file_name ?-force? ?-quiet? ?-verbose? file}
        description {Takes an AES-GCM encrypted bitstream file from an implemented design that incorporates the Security Monitor IP, together with an encryption key file, and writes an unencrypted bitstream so that bitstream-level verification against the golden SecMon bitstream can be completed. The output is written in standard format for .bit or without header information for .bin, into the current working directory when no path is given.}
        returns {The requested file if successful; an error if it fails.}
        example {decrypt_bitstream -encrypted_file C:/Data/myDesign.bit \
   -keyfile C:/Data/key.nky -force C:/Data/myDesign_decrypted.bit}
        source {Xilinx UG835 2026.1}
    }
}
