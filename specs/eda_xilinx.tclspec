command apply_bd_automation {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    ;# NOTE(xilinx): the Syntax line shows -dict and -opts unbracketed, but the
    ;# Arguments prose marks -dict (Optional), gives no prose for -opts, and every
    ;# documented example omits both; the conservative reading is taken here.
    option -rule -takes rule_id \
           -detail {The rule ID string naming the automation rule to run on the selected object (required).}
    option -config -takes param_value_pairs \
           -detail {A list of configuration parameter and value pairs for the IP integrator object, with the parameter name unquoted and the value quoted, enclosed in braces.}
    option -dict -takes object_param_pairs \
           -detail {A dictionary of block design objects with the configuration parameters for each object, given as object and parameter pairs in place of the objects argument and -config.}
    option -opts -takes settings \
           -detail {A list of settings that apply to all objects in this rule.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {apply_bd_automation -rule rule_id ?-config param_value_pairs? ?-dict object_param_pairs? ?-opts settings? ?-quiet? ?-verbose? objects}

    hover {
        summary {Run an automation rule on an IP integrator object.}
        synopsis {apply_bd_automation -rule rule_id ?-config param_value_pairs? ?-dict object_param_pairs? ?-opts settings? ?-quiet? ?-verbose? objects}
        description {Drives the IP integrator Designer Assistance feature, which automatically configures a selected IP integrator object and adds the relevant cells around it. Block automation covers complex blocks such as Zynq devices, MicroBlaze processors, AXI Ethernet and memory IP, while connection automation completes clock, reset, interconnect and board-level connections. The objects must be returned by commands such as get_bd_cells, get_bd_pins or get_bd_intf_pins rather than named, and must be compatible with the rule.}
        returns {Success or failure.}
        example {apply_bd_automation -rule xilinx.com:bd_rule:board \
   [get_bd_pins /clk_wiz_2/CLK_IN1_D]}
        source {Xilinx UG835 2026.1}
    }
}
command apply_board_connection {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -board_interface -takes board_interface \
           -detail {The board part interface definition to connect to the IP core interface; when it is omitted or given as an empty string, an existing connection on the IP interface pin is removed.}
    option -ip_intf -takes ip_intf \
           -detail {The interface pin of an IP core in the block design named by -diagram, given in the form core_name/interface_pin_name (required).}
    option -diagram -takes diagram \
           -detail {The name of the IP integrator block design where the IP core instance is found (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {apply_board_connection ?-board_interface board_interface? -ip_intf ip_intf -diagram diagram ?-quiet? ?-verbose?}

    hover {
        summary {Apply a board connection to an IP interface in a block design.}
        synopsis {apply_board_connection ?-board_interface board_interface? -ip_intf ip_intf -diagram diagram ?-quiet? ?-verbose?}
        description {Connects the interface pin of an IP core in the specified block design to an interface of the current board part, adding an external interface port and connection named for the board part interface. An error is returned if the project targets a part rather than a board; current_board_part identifies the board and get_board_part_interfaces lists its interfaces. Omitting -board_interface, or giving it an empty string, disconnects the IP interface pin instead.}
        returns {Success or failure status of the applied action.}
        example {apply_board_connection -board_interface "reset" \
   -ip_intf "/proc_sys_reset_0/ext_reset" -diagram "design_2"}
        source {Xilinx UG835 2026.1}
    }
}
command apply_hw_ila_trigger {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -ila_cell -takes ila_cell \
           -detail {Apply the trigger settings to the specified ILA cell, which must be given as an object from get_cells; the trigger file already names the cell it applies to, so this is only needed to retarget the file at a different ILA cell.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {apply_hw_ila_trigger ?-ila_cell ila_cell? ?-quiet? ?-verbose? ?file?}

    hover {
        summary {Apply trigger at startup settings to an ILA core in the design.}
        synopsis {apply_hw_ila_trigger ?-ila_cell ila_cell? ?-quiet? ?-verbose? ?file?}
        description {Reads a trigger configuration file written by run_hw_ila -file and applies its settings to the ILA core of the implemented design, so that the core is armed to trigger immediately after device configuration and startup. The trigger configuration then becomes part of the bitstream written by write_bitstream, which must be used rather than the Flow Navigator commands, and the device is then reprogrammed with program_hw_device.}
        returns {Nothing.}
        example {apply_hw_ila_trigger C:/Data/ila1_triggers.tas}
        source {Xilinx UG835 2026.1}
    }
}
command archive_project {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -temp_dir -takes directory \
           -detail {A temporary directory to copy files to while the archive is created; it is created if it does not exist and emptied afterwards, and by default a temporary directory inside the current working directory is used.}
    option -force \
           -detail {Overwrite an existing ZIP file of the same name, which otherwise causes an error.}
    option -exclude_run_results \
           -detail {Exclude the results of any synthesis or implementation runs, which can greatly reduce the size of the archive.}
    option -include_config_settings \
           -detail {Add any initialization Tcl commands to the archive under the config_settings folder of the project.}
    option -include_runs_in_progress \
           -detail {Include data from the directories of incomplete runs; ignored when -exclude_run_results is specified.}
    option -include_local_ip_cache \
           -detail {Include the cached IP synthesis results in the archive, which only happens when the IP cache is local to the project rather than remote.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {archive_project ?-temp_dir directory? ?-force? ?-exclude_run_results? ?-include_config_settings? ?-include_runs_in_progress? ?-include_local_ip_cache? ?-quiet? ?-verbose? ?file?}

    hover {
        summary {Archive the current project into a ZIP file.}
        synopsis {archive_project ?-temp_dir directory? ?-force? ?-exclude_run_results? ?-include_config_settings? ?-include_runs_in_progress? ?-include_local_ip_cache? ?-quiet? ?-verbose? ?file?}
        description {Archives a project for backup or transfer by walking the design hierarchy, copying the required source, include, remote and constraint files together with the results of the synthesis, simulation and implementation runs, and writing a ZIP file. The archive is named for the project when no file name is given. An alternative is write_project_tcl, which emits a script that recreates the project in its current form.}
        returns {True.}
        example {current_project project_3
archive_project -force -exclude_run_results proj3.zip}
        source {Xilinx UG835 2026.1}
    }
}
command assign_bd_address {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -target_address_space -takes address_space \
           -detail {The target address space to place the segment into; without it the IP integrator automatically assigns the segment to an available address space.}
    option -boundary \
           -detail {Assign address spaces to the hierarchical boundary of the design, mapping scoped external slave interfaces into the address space at contiguous offsets beginning at zero.}
    option -master_boundary \
           -detail {For scoped external master interfaces, create a slave segment mapped into the internal masters of the scoped diagram at the given -offset and -range.}
    option -external \
           -detail {Define a memory segment of a previously defined external address space, so several segments can be assigned to an external AXI port connecting to a slave IP outside the block design.}
    option -dict -takes offset_range_pairs \
           -detail {A dictionary of offset and range value pairs to be defined at one time.}
    option -import_from_file -takes file \
           -detail {Read address space assignments from a CSV file of address space name, slave segment, offset and range; an existing address space definition is overwritten when the file is valid, and an error returned otherwise.}
    option -export_to_file -takes file \
           -detail {Write address space assignments to a CSV file of address space name, slave segment, offset and range; an existing file is not overwritten unless -force is also given.}
    option -export_gui_to_file -takes file \
           -detail {Write the address map to a CSV file structured as the Address Editor GUI presents it.}
    option -offset -takes offset \
           -detail {The memory offset of the address space to assign the address segment to, for example 0x00000000.}
    option -range -takes range \
           -detail {The range, or size, of the address space to assign the address segment into, for example 4096, 4K, 16M, or 1G.}
    option -base_high -takes base_high \
           -detail {A colon-separated base and high offset of a range assignment, for example 0x0000:0xFFFF.}
    option -with_locktype -takes locktype -values {none local global} -closed \
           -detail {Assign the master segments with the given lock type.}
    option -with_name -takes name \
           -detail {Give the master segments the specified name.}
    option -force \
           -detail {Force the assignment without running any validity checks, and overwrite an existing CSV file when used with -export_to_file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {assign_bd_address ?-target_address_space address_space? ?-boundary? ?-master_boundary? ?-external? ?-dict offset_range_pairs? ?-import_from_file file? ?-export_to_file file? ?-export_gui_to_file file? ?-offset offset? ?-range range? ?-base_high base_high? ?-with_locktype locktype? ?-with_name name? ?-force? ?-quiet? ?-verbose? ?objects?}

    hover {
        summary {Automatically assign addresses to unmapped IP.}
        synopsis {assign_bd_address ?-target_address_space address_space? ?-boundary? ?-master_boundary? ?-external? ?-dict offset_range_pairs? ?-import_from_file file? ?-export_to_file file? ?-export_gui_to_file file? ?-offset offset? ?-range range? ?-base_high base_high? ?-with_locktype locktype? ?-with_name name? ?-force? ?-quiet? ?-verbose? ?objects?}
        description {Assigns unmapped IP address segments to address spaces in the IP integrator subsystem design. When no target address space is given the IP integrator picks an available address space on a connected AXI master, and when no bd_addr_seg objects are given every unmapped segment is assigned.}
        returns {The newly mapped segments, or the empty string if it failed.}
        example {assign_bd_address [get_bd_addr_segs \
{/microblaze_1_local_memory/ilmb_bram_if_cntlr/SLMB/Mem }]}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command auto_bd_connect {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -interactive -takes state \
           -detail {Launch the auto_connect dialog if true; the default is HDFALSE.}
    option -mode -takes mode \
           -detail {Run IP-based or Rule-based auto_connect (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {auto_bd_connect ?-interactive state? -mode mode ?-quiet? ?-verbose? cell}

    hover {
        summary {Auto connect the cell just created in the current design.}
        synopsis {auto_bd_connect ?-interactive state? -mode mode ?-quiet? ?-verbose? cell}
        description {Automatically connects the named cell in the current block design, using either IP-based or rule-based connection as selected by -mode.}
        returns {TCL_OK, TCL_ERROR if failed.}
        source {Xilinx UG835 2012.2}
    }
}
command auto_detect_xpm {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {auto_detect_xpm ?-quiet? ?-verbose?}

    hover {
        summary {Detect the XPM libraries used in the design and set the XPM_LIBRARIES property.}
        synopsis {auto_detect_xpm ?-quiet? ?-verbose?}
        description {Collects the list of Xilinx Parameterized Macros used in the RTL design files and sets the XPM_LIBRARIES property on the current project, which synthesis and simulation then use to support those macros. Because it inspects the RTL sources it must be run after those files are read or added, and it is intended for non-project mode rather than project-based flows.}
        returns {Nothing.}
        example {read_verilog ../top_bgRAM_173_0.v
read_xdc ../top_bgRAM_173_0.xdc
auto_detect_xpm}
        source {Xilinx UG835 2026.1}
    }
}
command boot_hw_device {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -disable_done_check \
           -detail {Disable the done check for the boot device, used when a programmed device is to be cleared without being reprogrammed.}
    option -timeout -takes seconds \
           -detail {The timeout in seconds after which the command stops trying to boot the device.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {boot_hw_device ?-disable_done_check? ?-timeout seconds? ?-quiet? ?-verbose? hw_device}

    hover {
        summary {Issue a JTAG program command to a hardware device.}
        synopsis {boot_hw_device ?-disable_done_check? ?-timeout seconds? ?-quiet? ?-verbose? hw_device}
        description {Triggers the FPGA boot and board startup sequence on the specified hw_device, clearing any prior programming and then loading a new program according to the mode pin settings. When the mode pins select JTAG mode, or the configuration interface is not active, the net effect is to clear the prior programming. The device must be given as an object from get_hw_devices or current_hw_device.}
        returns {1 if the DONE pin has gone HIGH or the device has been cleared, otherwise 0.}
        source {Xilinx UG835 2026.1}
    }
}
command calc_config_time {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -max -detail {Report the maximum configuration time as estimated by the command.}
    option -min -detail {Report the minimum configuration time as estimated by the command.}
    option -typical \
           -detail {Report the typical configuration time as estimated by the command; this is the default.}
    option -por_used \
           -detail {Specify that Power On Reset is used, by way of a non-zero -por_ramp; marked deprecated by the Usage table.}
    option -por_ramp -takes ramp_rate \
           -detail {The Power On Reset ramp rate, given as a value from 1 ms to 50 ms; the default is 0 ms.}
    option -clk_freq -takes frequency \
           -detail {A clock frequency in MHz for slave mode, or for master mode when an external master clock is used; the default is 0 MHz, and in master configuration modes the frequency comes from the BITSTREAM.CONFIG.CONFIGRATE property instead.}
    option -bitstream_size -takes size \
           -detail {A bitstream size in bits that overrides the size derived automatically from the bitstream of the current design; the default is 0.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Print out the calculation parameters.}

    form Default {calc_config_time ?-max? ?-min? ?-typical? ?-por_used? ?-por_ramp ramp_rate? ?-clk_freq frequency? ?-bitstream_size size? ?-quiet? ?-verbose?}

    hover {
        summary {Calculate the device configuration time in milliseconds.}
        synopsis {calc_config_time ?-max? ?-min? ?-typical? ?-por_used? ?-por_ramp ramp_rate? ?-clk_freq frequency? ?-bitstream_size size? ?-quiet? ?-verbose?}
        description {Estimates the time in milliseconds to configure the device for the current design, covering device initialization plus configuration and depending on the size of the device and the speed of the configuration logic. The configuration mode must be defined and the design opened in memory; some inputs come from properties on the current design such as BITSTREAM.CONFIG.CONFIGRATE and BITSTREAM.CONFIG.EXTMASTERCCLK_EN. Partial bitstreams are not supported natively, but their size can be taken from write_bitstream and passed with -bitstream_size when the external configuration mode is the same.}
        returns {A report of the estimated configuration time in milliseconds.}
        example {calc_config_time -max -clk_freq 50}
        source {Xilinx UG835 2026.1}
    }
}
command can_resolve_reference {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {can_resolve_reference ?-quiet? ?-verbose? modules}

    hover {
        summary {Check whether a module can be referenced.}
        synopsis {can_resolve_reference ?-quiet? ?-verbose? modules}
        description {Validates references to modules before an attempt is made to import them into the design, with each module named as it is referenced from a loaded RTL design source file. Its primary use is in generated scripts such as the output of write_bd_tcl, though it can be used in user scripts as well.}
        returns {0 if the reference cannot be resolved, or 1 if it can be resolved.}
        example {can_resolve_reference clk_div}
        source {Xilinx UG835 2026.1}
    }
}
command check_syntax {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fileset -takes fileset \
           -detail {Check the syntax of the files in the specified fileset.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to standard output, so that it can be captured in a variable and parsed.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {check_syntax ?-fileset fileset? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Check HDL syntax in a fileset.}
        synopsis {check_syntax ?-fileset fileset? ?-return_string? ?-quiet? ?-verbose?}
        description {Parses the Verilog, SystemVerilog, and VHDL source files of the given or active fileset and generates syntax warnings and error messages for the design. Syntax is also checked automatically as a file is edited or saved in the Vivado text editor.}
        returns {Warnings or errors related to the files examined, or nothing if no problems are found.}
        example {check_syntax -fileset sim_1}
        source {Xilinx UG835 2026.1}
    }
}
command checkpoint_vcd {
