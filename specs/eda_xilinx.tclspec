    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_site_pips ?-regexp? ?-nocase? ?-filter expression? ?-of_objects sites? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of site_pips from the given object.}
        synopsis {get_site_pips ?-regexp? ?-nocase? ?-filter expression? ?-of_objects sites? ?-quiet? ?-verbose? ?patterns?}
        description {Programmable interconnect points, or PIPs, provide the physical routing paths on the device used to connect logic networks. This command returns the PIPs on the specified sites that match the search patterns, requires an open design, and requires -of_objects to name the sites to return PIPs from.}
        returns {A list of site_pip objects.}
        example {get_site_pips -of_objects [get_sites SLICE_X21Y92]}
        source {Xilinx UG835 2026.1}
    }
}
command get_sites {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -of_objects -takes objects \
           -detail {Get the sites of the specified slrs, tiles, bels, site_pins, package_pins, ports, pblocks, nets, site_types, iobanks, cells, clock_regions, or drc_violation objects.}
    option -range -takes site_range \
           -detail {Match site names that fall into the range, defined by exactly two site names of the same SITE_TYPE, such as SLICE_X2Y12 SLICE_X3Y15.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_sites ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-range site_range? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of sites.}
        synopsis {get_sites ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-range site_range? ?-quiet? ?-verbose? ?patterns?}
        description {Gets the sites on the target device that match the search patterns; the default pattern is the wildcard * which gets all sites on the target device. Specifying a -range with two different site types is an error.}
        returns {A list of site objects.}
        example {get_sites -range {SLICE_X0Y0 SLICE_X1Y1}}
        source {Xilinx UG835 2026.1}
    }
}
command get_slrs {
    available {tcl 8.5}
