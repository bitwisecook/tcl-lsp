command create_ip {
    dialects tcl8.5
    required_package vivado

    form Default {create_ip -name name -vendor vendor -library library -version version ?-module_name mod_name? ?-dir dir?}

    hover {
        summary {Create an IP core instance.}
        synopsis {create_ip -name name -vendor vendor -library library -version version ?-module_name mod_name? ?-dir dir?}
        source {F5}
    }
}
command create_net {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -bus_from -takes index -detail {The starting index of a new bus.}
    option -bus_to -takes index \
           -detail {The ending index of a new bus; specifying one of -bus_from or -bus_to without the other results in a one-bit bus at the given index.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_net ?-bus_from index? ?-bus_to index? ?-quiet? ?-verbose? nets...}

    hover {
        summary {Create nets in the current design.}
        synopsis {create_net ?-bus_from index? ?-bus_to index? ?-quiet? ?-verbose? nets...}
        description {Creates new nets in the netlist of an open Synthesized or Implemented Design, at the top level or within any level of the hierarchy by giving a hierarchical net name. New nets are unconnected at creation and must be connected with connect_net; netlist editing changes the in-memory view of the netlist only and is not allowed on an RTL design.}
        returns {Nothing.}
        example {create_net tempBus -bus_from 23 -bus_to 0}
        source {Xilinx UG835 2012.2}
    }
}
command create_pblock {
    dialects tcl8.5
    arity 1
    required_package vivado

    form Default {create_pblock pblock_name}

    hover {
        summary {Define a new Pblock for floorplanning.}
        synopsis {create_pblock pblock_name}
        source {Xilinx UG835 2026.1}
    }
}
command create_pin {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -bus_from -takes index -detail {The starting index of a bus pin.}
    option -bus_to -takes index -detail {The ending index of a bus pin.}
    option -direction -takes direction -values {IN OUT INOUT} -closed \
           -detail {The direction of the pin (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_pin ?-bus_from index? ?-bus_to index? -direction direction ?-quiet? ?-verbose? pins...}

    hover {
        summary {Create pins in the current design.}
        synopsis {create_pin ?-bus_from index? ?-bus_to index? -direction direction ?-quiet? ?-verbose? pins...}
        description {Adds single pins or bus pins to the netlist of an open Synthesized or Implemented Design, with the direction, bus width, and name given. Pins must be named hierarchically from the cell instance they belong to or an error is returned; pins at the top level of the design are ports and should be created with create_port, and netlist editing is not allowed on an RTL design.}
        returns {Nothing.}
        example {create_pin -direction IN cpuEngine/inPin}
        source {Xilinx UG835 2012.2}
    }
}
command create_port {
    dialects tcl8.5
    required_package vivado

    arity 1..

    ;# NOTE(xilinx): the converted Syntax line repeats [negative_name] twice;
    ;# the Usage table lists it once, and one optional trailing word is used here.
    option -direction -takes direction -values {IN OUT INOUT} -closed \
           -detail {The direction of the port (required).}
    option -from -takes index -detail {The beginning index of a new bus, which can start from a negative index value.}
    option -to -takes index -detail {The ending index of a new bus, which can end on a negative index value.}
    option -diff_pair \
           -detail {Create the specified port as a differential pair of ports, so both a P and an N port are created for the given name.}
    option -interface -takes interface -detail {Assign the new port to this interface.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_port -direction direction ?-from index? ?-to index? ?-diff_pair? ?-interface interface? ?-quiet? ?-verbose? name ?negative_name?}

    hover {
        summary {Create a scalar or bus port.}
        synopsis {create_port -direction direction ?-from index? ?-to index? ?-diff_pair? ?-interface interface? ?-quiet? ?-verbose? name ?negative_name?}
        description {Creates a port with the given direction, width, and single-ended or differential form, optionally assigned to an existing interface. New ports are added at the top level of the design hierarchy, either in an I/O Planning project or while editing the netlist of an open Synthesized or Implemented design; netlist editing is not allowed on an RTL design.}
        returns {List of port objects that were created.}
        example {create_port -direction OUT -from 0 -to 3 -diff_pair -interface INTERFACE D_BUS}
        source {Xilinx UG835 2012.2}
    }
}
command create_project {
    dialects tcl8.5
    arity 1..
    required_package vivado

    form Default {create_project ?-part part? ?-force? ?-in_memory? ?-ip? ?-rtl_kernel? ?-quiet? ?-verbose? ?project_name? ?project_dir?}

    hover {
        summary {Create a new Vivado project.}
        synopsis {create_project ?-part part? ?-force? ?-in_memory? ?-ip? ?-rtl_kernel? ?-quiet? ?-verbose? ?project_name? ?project_dir?}
        source {F5}
    }
}
command create_property {
    dialects tcl8.5
    required_package vivado

    arity 2..

    ;# NOTE(xilinx): the Usage table lists string, int, long, double, bool while
    ;# the Arguments prose names four types without long, so the set is left open.
    option -type -takes type -values {string int long double bool} \
           -detail {Type of property to create; the default is string, int holds long integer values and errors on a decimal, double holds a floating point number, and bool holds a true (1) or false (0) value.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_property ?-type type? ?-quiet? ?-verbose? name class}

    hover {
        summary {Create a property for a class of objects.}
        synopsis {create_property ?-type type? ?-quiet? ?-verbose? name class}
        description {Creates a new property of the given type with the user-defined name for the specified class of objects, where the valid classes are design, net, cell, pin, port, and pblock and the name is case sensitive. The property can be assigned to an object of that class with set_property but is not automatically associated with all objects of the class, and report_property -all does not report it for an object until it has been assigned.}
        returns {The property that was created if success, "" if failure.}
        example {create_property -type int COUNT pin}
        source {Xilinx UG835 2012.2}
    }
}
command create_run {
    dialects tcl8.5
    arity 1..
    required_package vivado

    form Default {create_run -flow flow ?-strategy strategy? ?-constrset constrset? ?-parent_run parent? run_name}

    hover {
        summary {Create a new run.}
        synopsis {create_run -flow flow ?-strategy strategy? ?-constrset constrset? ?-parent_run parent? run_name}
        source {F5}
    }
}
command create_slack_histogram {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -to -takes clocks \
           -detail {Specify a clock name, to analyze paths that end in the specified clock domain.}
    option -delay_type -takes delay_type -values {max min min_max} -closed \
           -detail {Type of path delay to analyze when creating the slack report; the default is max.}
    option -num_bins -takes count \
           -detail {Maximum number of slack bins to divide the results into, given as a number greater than or equal to 1; the default is 10.}
    option -slack_less_than -takes value \
           -detail {Display paths with a calculated slack value less than this; the default is 1e+30.}
    option -slack_greater_than -takes value \
           -detail {Display paths with a calculated slack value greater than this; the default is -1e+30.}
    option -group -takes groups \
           -detail {Limit the report to paths in these path groups, which can be listed with get_path_groups.}
    option -report_unconstrained \
           -detail {Report delay slack on unconstrained end points, which are not analyzed by default.}
    option -significant_digits -takes digits \
           -detail {Number of significant digits to display, in the range 0 to 13; the default is 3.}
    option -scale -takes scale -values {linear logarithmic} -closed \
           -detail {Type of Y-axis scale on which to draw the histogram; the default is linear.}
    option -name -takes name \
           -detail {Output the results to the GUI panel with this name, overwriting the current results if that name is already open.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_slack_histogram ?-to clocks? ?-delay_type delay_type? ?-num_bins count? ?-slack_less_than value? ?-slack_greater_than value? ?-group groups? ?-report_unconstrained? ?-significant_digits digits? ?-scale scale? ?-name name? ?-quiet? ?-verbose?}

    hover {
        summary {Create a slack histogram.}
        synopsis {create_slack_histogram ?-to clocks? ?-delay_type delay_type? ?-num_bins count? ?-slack_less_than value? ?-slack_greater_than value? ?-group groups? ?-report_unconstrained? ?-significant_digits digits? ?-scale scale? ?-name name? ?-quiet? ?-verbose?}
        description {Creates a slack histogram grouping paths into slack ranges and displaying the results graphically. The graphical histogram requires the tool to be running in GUI mode and the -name argument to be used.}
        returns {Nothing.}
        example {create_slack_histogram -name slack1}
        source {Xilinx UG835 2012.2}
    }
}
command create_sysgen {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_sysgen ?-quiet? ?-verbose? name}

    hover {
        summary {Create DSP source for Xilinx System Generator and add it to the source fileset.}
        synopsis {create_sysgen ?-quiet? ?-verbose? name}
        description {Creates a DSP sub-module for use in the current project and adds it to the source files, launching System Generator for DSP to design the hardware portion of the embedded processor system. Existing DSP model files from System Generator can instead be brought in with add_files, and the command returns the name of the DSP module created.}
        returns {Name for the new sub module.}
        example {create_sysgen DSP_mod1}
        source {Xilinx UG835 2012.2}
    }
}
command create_violation {
    dialects tcl8.5
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table spells the third severity CRITICAL_WARNING
    ;# while the Arguments prose spells it "CRITICAL WARNING", so the set is left
    ;# open and the Usage spelling is carried here.
    option -name -takes name \
           -detail {The unique abbreviation for the rule in the violation library, typically 4 to 6 letters, matching the name given in register_drc_rule (required).}
    option -severity -takes severity \
           -values {FATAL ERROR CRITICAL_WARNING WARNING ADVISORY} \
           -detail {Severity level for the drc rule; the default for user-defined DRCs is WARNING.}
    option -msg -takes message \
           -detail {The message string for this drc rule, substituted for the $STR in the message specified in register_drc_rule, and it must match that -msg specification.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_violation -name name ?-severity severity? ?-msg message? ?-quiet? ?-verbose? ?objects...?}

    hover {
        summary {Create a DRC violation.}
        synopsis {create_violation -name name ?-severity severity? ?-msg message? ?-quiet? ?-verbose? ?objects...?}
        description {Creates a violation object and manages the collection of design objects associated with it for reporting purposes. The command belongs in the Tcl checker procedure that implements a user-defined DRC rule, and the rule should be registered with register_drc_rule before it is used with report_drc or violations are created; the objects are the cells, ports, pins, nets, clock regions, sites, and package IO banks substituted into the rule.}
        returns {Nothing.}
        example {create_violation -name RIPO -msg "RIPO Error Found:" \
   -severity ERROR $mycell1 $mycell2}
        source {Xilinx UG835 2012.2}
    }
}
