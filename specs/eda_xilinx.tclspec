        summary {Get a list of hardware SIO GTs.}
        synopsis {get_hw_sio_gts ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the Gigabit Transceiver objects, hw_sio_gt, that are in use on the IBERT debug core on the current hardware device. The customizable Integrated Bit Error Ratio Tester (IBERT) core is designed for evaluating and monitoring the GTs, enabling in-system serial I/O validation and debug; through the Dynamic Reconfiguration Port you can configure and tune the GT transmitters and receivers, changing property settings on the GTs as well as registers that control the values on the ports. This command returns a list of GT objects on the IBERT debug core, or returns an error if it fails.}
        returns {Hardware SIO GTs.}
        example {get_hw_sio_gts -of_objects [get_hw_sio_links]}
        source {Xilinx UG835 2026.1}
    }
}
command get_hw_sio_iberts {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects \
           -detail {Return the IBERT cores of the specified hw_server, hw_target, hw_device, hw_sio_gtgroup, hw_sio_gt, hw_sio_common, hw_sio_pll, hw_sio_tx, hw_sio_rx, or hw_sio_link objects; cannot be used with a search pattern.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

