command delete_property {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_property ?-quiet? ?-verbose? name class}

    hover {
        summary {Delete a user defined property for a class of objects.}
        synopsis {delete_property ?-quiet? ?-verbose? name class}
        description {Deletes the user defined property named by the case-sensitive name argument for the specified object type. Valid classes are design, net, cell, pin, port, pblock, interface, and fileset. Once a property is deleted it is no longer reported by report_property -all or list_property.}
        returns {Nothing.}
        example {delete_property INSERT_CUSTOM_IP net}
        source {Xilinx UG835 2026.1}
