    hover {
        summary {Refresh hardware AXI object status.}
        synopsis {refresh_hw_axi ?-quiet? ?-verbose? ?hw_axis?}
        description {Takes the values from the status registers of the JTAG to AXI Master on the hardware device and populates them into the STATUS properties of the specified hw_axi objects in the Hardware Manager. The STATUS properties include STATUS.AXI_READ_BUSY, STATUS.AXI_READ_DONE, STATUS.AXI_WRITE_BUSY, STATUS.AXI_WRITE_DONE, STATUS.BRESP, and STATUS.RRESP.}
        returns {Nothing.}
        example {refresh_hw_axi [get_hw_axis]}
        source {Xilinx UG835 2026.1}
    }
}
command refresh_hw_ddrmc {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -regexp -detail {The list of properties to refresh is defined using regular expressions.}
    option -properties -takes properties \
           -detail {Refresh only the specified properties of the object; by default all properties are refreshed, and a non-existent property is ignored.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {refresh_hw_ddrmc ?-regexp? ?-properties properties? ?-quiet? ?-verbose? hw_objects}

    hover {
        summary {Refresh the status of Versal DDR memory controller objects.}
        synopsis {refresh_hw_ddrmc ?-regexp? ?-properties properties? ?-quiet? ?-verbose? hw_objects}
        description {Refreshes the in-memory contents of all of the properties, or only the specified properties, of the given Versal DDR Memory Controller objects with values read from the current hardware device. At least one object is required, and any specified property that does not exist on the object is not refreshed.}
        returns {Nothing.}
        example {refresh_hw_ddrmc -properties {PHY_RANKS} [lindex [get_hw_ddrmcs] 3]}
        source {Xilinx UG835 2026.1}
    }
}
command refresh_hw_device {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -update_hw_probes -takes probes_file \
           -detail {Update the hardware probe information for the device by reading the specified probes file.}
    option -disable_done_check \
           -detail {Disable the DONE check so that the hardware manager scans for debug cores on the device even if the DONE pin status is low.}
    option -force_poll -detail {Force a poll of all targets.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {refresh_hw_device ?-update_hw_probes probes_file? ?-disable_done_check? ?-force_poll? ?-quiet? ?-verbose? ?hw_device?}

    hover {
        summary {Refresh a hardware device, reading device and core information from it.}
        synopsis {refresh_hw_device ?-update_hw_probes probes_file? ?-disable_done_check? ?-force_poll? ?-quiet? ?-verbose? ?hw_device?}
        description {Refreshes the in-memory view of the device by scanning for debug and IBERT cores on the specified hw_device object, and reads a probes file when directed. The Hardware Manager creates, deletes, or updates the hw_ila, hw_vio, hw_sio and hw_axi objects from the core information found on the device; run it after program_hw_devices to keep the in-memory debug objects in sync with the cores on the physical device.}
        example {refresh_hw_device [lindex [get_hw_devices] 0]}
        source {Xilinx UG835 2026.1}
    }
}
command refresh_hw_hbm {
