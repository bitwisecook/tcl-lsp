    hover {
        summary {Save an existing IP subsystem design to disk file.}
        synopsis {save_bd_design ?-quiet? ?-verbose? ?name?}
        description {Saves any changes to the current or specified IP subsystem design in the IP integrator of the Vivado Design Suite. If a name is not specified, the current IP subsystem design is saved.}
        returns {TCL_OK, TCL_ERROR if failed.}
        example {save_bd_design}
        source {Xilinx UG835 2026.1}
    }
}
command save_bd_design_as {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -dir -takes directory \
           -detail {Directory path for the remote block design to be created and managed; required if a name is not specified.}
    option -ignore_comments -detail {Do not save user comments.}
    option -freeze_boundary -detail {Freeze the boundary for the new design.}
    option -force -detail {Overwrite an existing block design of the same name if one exists.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {save_bd_design_as ?-dir directory? ?-ignore_comments? ?-freeze_boundary? ?-force? ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Save a copy of the existing IP subsystem design to a specified disk file with a different name.}
        synopsis {save_bd_design_as ?-dir directory? ?-ignore_comments? ?-freeze_boundary? ?-force? ?-quiet? ?-verbose? ?name?}
        description {Saves a copy of an existing block design from the IP integrator to a new location, or with a different name; the generated output products of the block design are not saved to the new block design. Although -dir is optional, either -dir or a name must be specified, and a block design that has locked IP cannot be copied until the IP is unlocked.}
        returns {TCL_OK, TCL_ERROR if failed.}
        example {save_bd_design_as -dir C:/Data new_Block}
        source {Xilinx UG835 2026.1}
    }
}
command save_constraints {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -force \
           -detail {Save the active constraints files regardless of whether any changes have been made, overwriting the current target constraints file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {save_constraints ?-force? ?-quiet? ?-verbose?}

    hover {
        summary {Save the current design's constraints.}
        synopsis {save_constraints ?-force? ?-quiet? ?-verbose?}
        description {Saves any changes to the constraints files of the active constraints set. The command writes any changes to the constraints files to the project data on the hard drive, saving work in progress and committing any changes.}
        returns {Nothing.}
        example {save_constraints -force}
        source {Xilinx UG835 2026.1}
    }
}
command save_constraints_as {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -dir -takes directory \
           -detail {The directory into which constraints files are saved; if not specified, the new constraints set is located in the project sources directory.}
    option -target_constrs_file -takes file_name \
           -detail {Specifies a new target constraints file for the new constraints fileset, created in the fileset directory when no path is given.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {save_constraints_as ?-dir directory? ?-target_constrs_file file_name? ?-quiet? ?-verbose? name}

    hover {
        summary {Save the current design's constraints as a new set of constraints files.}
        synopsis {save_constraints_as ?-dir directory? ?-target_constrs_file file_name? ?-quiet? ?-verbose? name}
        description {Copies the active constraints set to create a new constraints set, with local copies of any constraints files that are part of the constraints set, and optionally a new target constraints file. The new constraints set is not active in the design although it is referenced by it; set the CONSTRSET property on specific runs to make it active.}
        returns {Nothing.}
        example {save_constraints_as -dir C:/Data/con1 \
   -target_constrs_file rev1.xdc constrs_2}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
