    hover {
        summary {Register a Tcl proc with Vivado.}
        synopsis {register_proc ?-quiet? ?-verbose? proc ?tasknm?}
        description {Registers a Tcl procedure, which must already be defined and loaded into the session, with the Vivado Tcl command interpreter so that it is known to the Vivado help system. Comment lines in the proc beginning with Summary, Argument Usage, Return Value and Categories define the help text returned by the help system for the registered command. If no task name is given, the proc is registered under its root name without namespaces.}
        returns {Nothing.}
        example {register_proc findCommand findCmd}
        source {Xilinx UG835 2026.1}
    }
}
command reimport_files {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -force \
           -detail {Reimport files even when the local project files may be newer than their referenced source files.}
