command update_clock_routing {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -pin -takes pin -detail {A single pin, which should already be unrouted.}
    option -net -takes net -detail {A single net, which should already be unrouted.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_clock_routing ?-pin pin? ?-net net? ?-quiet? ?-verbose?}

    hover {
        summary {Update clock routing on global clocks if they are modified after placement.}
        synopsis {update_clock_routing ?-pin pin? ?-net net? ?-quiet? ?-verbose?}
        description {An advanced command that manually updates the routing structures of all global clocks in the design, operating on all global clocks rather than individual ones. Global clock routing takes two steps: the placer assigns the routing resources from the clock source to the destination clock regions, producing gap trees, and the router then fills in the routing gaps. Global clock routing is handled automatically during implementation, but this command may be needed when the clock tree changes afterwards, for instance by modifying the USER_CLOCK_ROOT property of a clock net.}
        returns {Nothing.}
        example {set_property USER_CLOCK_ROOT X1Y0 [get_nets {clk1 clk2}]
route_design -unroute -nets [get_nets {clk1 clk2}]
update_clock_routing}
        source {Xilinx UG835 2026.1}
    }
}
command update_compile_order {
