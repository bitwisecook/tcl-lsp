command get_property {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -min \
           -detail {When multiple objects are specified, return the smallest value of the named property, sorting numeric properties by value and all others as strings.}
    option -max \
           -detail {When multiple objects are specified, return the largest value of the named property, sorting numeric properties by value and all others as strings.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_property ?-min? ?-max? ?-quiet? ?-verbose? name object}

    hover {
        summary {Get properties of object.}
        synopsis {get_property ?-min? ?-max? ?-quiet? ?-verbose? name object}
        description {Gets the current value of the named property from the specified object or objects, returning a list of values when multiple objects are given. If the property is not assigned to the object, or is assigned without a value, nothing is returned for that object; the property name is not case sensitive.}
        returns {The property value.}
        example {get_property NAME [lindex [get_cells] 3]}
        source {Xilinx UG835 2026.1}
    }
}
