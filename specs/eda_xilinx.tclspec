    hover {
        summary {Get a list of example designs.}
        synopsis {get_example_designs ?-regexp? ?-nocase? ?-filter expression? ?-all? ?-quiet? ?-verbose? ?patterns?}
        description {Returns a list of the example designs available in the current release of the Vivado Design Suite, or returns an error if it fails. Example designs can be opened, or instantiated into the Vivado Design Suite, onto specific target hardware devices or boards. The default search pattern is the wildcard *, or .* when -regexp is specified.}
        returns {List of design objects.}
        example {foreach x [get_example_designs] {
puts "********* Design $x **************"
report_property -all $x}}
        source {Xilinx UG835 2026.1}
    }
}
command get_files {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -compile_order -takes compile_order -values {sources constraints} -closed \
           -detail {Return the source design files, or the constraint files, sorted according to the order of compilation (only with -used_in).}
    option -used_in -takes step -values {synthesis simulation implementation} \
           -detail {Return the files matching this value of the USED_IN property on the file objects (only with -compile_order).}
    option -references \
           -detail {Get the files referenced in the provided objects (only with -of_objects).}
    option -all -detail {Return all of the files in the design, including internal files in support of IP and other objects.}
    option -of_objects -takes objects \
           -detail {Get the files associated with the specified file, fileset, ip, or reconfig_module objects; with -compile_order and -used_in only a single fileset or sub-design is accepted, and this option cannot be used with a search pattern.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_files ?-regexp? ?-nocase? ?-filter expression? ?-compile_order compile_order? ?-used_in step? ?-references? ?-all? ?-of_objects objects? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of source files.}
        synopsis {get_files ?-regexp? ?-nocase? ?-filter expression? ?-compile_order compile_order? ?-used_in step? ?-references? ?-all? ?-of_objects objects? ?-quiet? ?-verbose? ?patterns?}
        description {Returns a machine readable list of the files in the current project, in a design, or in a sub-design such as an IP core or block design, filtered by -of_objects, -compile_order, -used_in, and -filter. The -compile_order and -used_in options must be used together to return files from the sources or constraints filesets used in synthesis, simulation, or implementation, sorted by the order of evaluation, and they apply complex ordering rules that can change with header files, include files, or other language options. Files can also be filtered on the USED_IN property with -filter instead of -used_in, and report_compile_order generates a report of all such files sorted into sections.}
        returns {List of file objects.}
        example {get_files -compile_order sources -used_in simulation}
        source {Xilinx UG835 2026.1}
    }
}
