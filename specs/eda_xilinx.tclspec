    option -filter -takes expression \
           -detail {Filter the patterns according to the specified property-matching expressions.}
    option -recursive -aliases {-r} \
           -detail {If the design object is a scope, wave objects for all design objects under that scope are created.}
    option -long_name -detail {Search wave objects using the long form of their names.}
    option -short_name -detail {Search wave objects using the short form of their names.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_waves ?-of wave_container? ?-regexp? ?-nocase? ?-filter expression? ?-recursive? ?-long_name? ?-short_name? ?-quiet? ?-verbose? patterns}

