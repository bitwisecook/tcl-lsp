}
command filter {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -regexp -detail {Operators =~ and !~ use regular expressions.}
    option -nocase \
           -detail {Perform case-insensitive matching (only with -regexp).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {filter ?-regexp? ?-nocase? ?-quiet? ?-verbose? ?objects? ?filter?}

    hover {
        summary {Filter a list, resulting in a new list.}
        synopsis {filter ?-regexp? ?-nocase? ?-quiet? ?-verbose? ?objects? ?filter?}
        description {Takes a list of objects, usually obtained from one of the get_* commands, and returns a reduced list of those objects that match the specified filter expression. The expression compares property values on the objects with the operators ==, !=, =~ and !~ for strings, the numeric comparisons <, >, <= and >=, and the connectives && and ||; boolean properties can be evaluated directly.}
        returns {New list.}
        example {filter [get_parts] {speed == -3}}
        source {Xilinx UG835 2026.1}
    }
}
command finalize_eco {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {finalize_eco ?-quiet? ?-verbose?}

    hover {
        summary {Ensure valid placement after ECO connectivity changes and before ECO routing.}
        synopsis {finalize_eco ?-quiet? ?-verbose?}
        description {Run after completing ECO connectivity changes to ensure valid placement before ECO routing; invalid placement resulting from the ECO changes is fixed by finalize_eco. If the ECO operation adds new cells, finalize_eco is not required and place_design -eco can be run to place the cells before routing; otherwise run finalize_eco before route_design -eco. This command is available only in the Advanced Flow.}
        returns {Object report.}
        source {Xilinx UG835 2026.1}
    }
}
command find_bd_objs {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -relation -takes relation \
           -values {connected_to addressable_slave addressing_master} -closed \
           -detail {Relation of the objects to find to the input objects (required).}
    ;# NOTE(xilinx): the Usage table gives the -boundary_type values as empty
    ;# string, lower or all, while the Arguments prose gives upper, lower or all;
    ;# the set is left open because the two spellings disagree.
    option -boundary_type -takes boundary_type \
           -detail {Boundary to search from when the source object is a hierarchical block's pin or interface pin (only with -relation connected_to).}
    option -thru_hier -detail {Ignore the boundary of hierarchical blocks when searching.}
    option -stop_at_interconnect \
           -detail {Stop at the axi_interconnect's boundary when -thru_hier is used.}
    option -stop_at_container -detail {Stop at the container's boundary when -thru_hier is used.}
    option -end_type -takes end_type \
           -detail {Which end connections to return for pins, ports, and bus interface pins or ports (only with -relation connected_to).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {find_bd_objs -relation relation ?-boundary_type boundary_type? ?-thru_hier? ?-stop_at_interconnect? ?-stop_at_container? ?-end_type end_type? ?-quiet? ?-verbose? objects}

    hover {
        summary {Find a list of pins, ports or interfaces with a given relationship to the given object.}
        synopsis {find_bd_objs -relation relation ?-boundary_type boundary_type? ?-thru_hier? ?-stop_at_interconnect? ?-stop_at_container? ?-end_type end_type? ?-quiet? ?-verbose? objects}
        description {Finds the pins, ports or interfaces that have the requested relationship to the specified seed objects: connected_to finds the objects connected to the given sources, addressable_slave finds the objects addressable as slaves by them, and addressing_master finds the objects that address them as masters. The search stays within the level of the seed objects unless -thru_hier or -boundary_type widens it.}
        returns {List of pins, ports or interface objects, "" if failed.}
        example {find_bd_objs -relation connected_to -thru_hier \
[get_bd_pins /proc_sys_reset_1/peripheral_aresetn]}
        source {Xilinx UG835 2026.1}
    }
}
command find_routing_path {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -from -takes start_node \
           -detail {Start of the routing path, a node or site_pin object.}
    option -to -takes end_node -detail {End of the routing path, a node or site_pin object.}
    option -max_nodes -takes count \
           -detail {Maximum number of nodes, including the from and to nodes, allowed in the solution.}
    option -min_nodes -takes count \
           -detail {Minimum number of nodes, including the from and to nodes, allowed in the solution.}
    option -exclude_nodes -takes nodes -detail {Exclude the specified nodes from the routing path.}
    option -include_nodes -takes nodes -detail {Nodes which must exist in the path.}
    option -sort_include_nodes -detail {Sort the given nodes which must exist in the path.}
    option -ignore_all_routing \
           -detail {The solution may include nodes used in any existing route, including fixed routes.}
    option -show_fixed_routes -detail {The solution will mark fixed routes with an asterisk.}
    option -allow_overlap \
           -detail {The solution may include nodes used in existing non-fixed routes.}
    option -node_delay -detail {Report the delay of each node and of the whole path.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {find_routing_path ?-from start_node? ?-to end_node? ?-max_nodes count? ?-min_nodes count? ?-exclude_nodes nodes? ?-include_nodes nodes? ?-sort_include_nodes? ?-ignore_all_routing? ?-show_fixed_routes? ?-allow_overlap? ?-node_delay? ?-quiet? ?-verbose?}

    hover {
        summary {Find a routing path between two nodes.}
        synopsis {find_routing_path ?-from start_node? ?-to end_node? ?-max_nodes count? ?-min_nodes count? ?-exclude_nodes nodes? ?-include_nodes nodes? ?-sort_include_nodes? ?-ignore_all_routing? ?-show_fixed_routes? ?-allow_overlap? ?-node_delay? ?-quiet? ?-verbose?}
        description {Finds a routing solution between two nodes on an unrouted, or partially routed, net in an implemented design. The start and end points must be specified as node objects returned by get_nodes, and the maximum and minimum node counts bound the length of the path. The returned list of nodes can be assigned to the FIXED_ROUTE property of a net with set_property and saved to the XDC file for later reuse.}
        returns {A list of nodes representing the route path found from the start point to the end point, or "no path found" when the command runs but has no result.}
        example {set fndPath [find_routing_path -from [lindex [get_nodes -of \
   [get_site_pins -of [get_nets wbOutputData_OBUF[14]]]] 0] -to \
   [lindex [get_nodes -of [get_site_pins -of \
   [get_nets wbOutputData_OBUF[14]]]] 1]]
set_property FIXED_ROUTE $fndPath [get_nets wbOutputData_OBUF[14]]}
        source {Xilinx UG835 2026.1}
    }
}
command find_top {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fileset -takes fileset -detail {Fileset to parse to search for top candidates.}
    option -files -takes files -detail {Files to parse to search for top candidates.}
    option -return_file_paths \
           -detail {For each top returned, also include the associated file path, alternating top names and file paths in a single list.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {find_top ?-fileset fileset? ?-files files? ?-return_file_paths? ?-quiet? ?-verbose?}

    hover {
        summary {Find top module candidates in the supplied files, fileset, or active fileset.}
        synopsis {find_top ?-fileset fileset? ?-files files? ?-return_file_paths? ?-quiet? ?-verbose?}
        description {Finds the most likely candidates for the top module in the files of the current fileset, of the fileset named by -fileset, or of the list of files given with -files. The result is ordered best first, so lindex with index 0 selects the best candidate for the top module.}
        returns {A rank ordered list of top module candidates.}
        example {find_top -files [get_files -filter {NAME =~ *or1200*}]}
        source {Xilinx UG835 2026.1}
    }
}
command flush_vcd {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -ports -detail {Control the extended VCD dump file.}
    option -file -takes file_name \
           -detail {File the scope specific ports are to be flushed to; the default flushes out all dumpport files.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {flush_vcd ?-ports? ?-file file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Flush VCD simulation output to the VCD output file.}
        synopsis {flush_vcd ?-ports? ?-file file_name? ?-quiet? ?-verbose?}
        description {Flushes the HDL signal information currently in memory into the specified Value Change Dump (VCD) file, the equivalent of the Verilog $dumpflush system task. The VCD file is an ASCII file of header information, variable definitions, and value change details that can be viewed in a VCD viewer or used to estimate power consumption. A VCD file must be opened with open_vcd before flush_vcd is used.}
        example {flush_vcd}
        source {Xilinx UG835 2026.1}
    }
}
command generate_base_platform {
