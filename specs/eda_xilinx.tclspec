command close_saif {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {close_saif ?-quiet? ?-verbose?}

    hover {
        summary {Flush activity data and close the SAIF file.}
        synopsis {close_saif ?-quiet? ?-verbose?}
        description {Flushes the collected switching activity data and closes the Switching Activity Interchange Format file.}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
