# tcl-lsp — bundled SpecTcl loadable: the AMD/Xilinx Vivado tool commands.
#
# This pack IS the source of truth for these commands. The Rust modules that
# used to hold them (rust/tcl-registry/src/commands/eda_xilinx/) were deleted when
# the EDA vendor libraries migrated to bundled `.tclspec` loadables, per
# docs/design/spec-packs.md ("the EDA vendor libraries ship as bundled
# `.tclspec` loadables … so the loader path is exercised in production from day
# one rather than reserved for private packs"). Every command was proved
# field-for-field equal to its compiled spec by the SpecTcl round-trip gate
# before the modules were removed.
#
# Discovery: the **bundled** tier — `specs/` beside the server executable, or
# wherever $TCL_LSP_SPEC_PACK_DIR points (rust/tcl-spectcl/src/discovery.rs).
# Edit this file to change the specs; there is no generator to re-run.
# Syntax: docs/design/spec-dsl-examples/README.md. The initial text was written
# by the spec studio's SpecTcl renderer (rust/tcl-spec-studio/src/render_spectcl.rs)
# from the registry modules, which reported no unwritable field on any command
# here; this file is hand-maintained from now on.
#
# Rebuilt to the full current UG835 command surface for issue #1560's
# follow-on EDA coverage work: every block citing UG835 2026.1 was authored
# from the complete "Vivado Design Suite Tcl Command Reference Guide"
# v2026.1 (June 2026, supplied by the requester), with full option rows.
# Blocks still citing UG835 2012.2 are commands that release documented and
# 2026.1 no longer does — kept for older scripts, each marked with a NOTE.
# The SDC-shared constraint/query commands live in sdc_base, which rides
# along with the xilinx-eda-tcl profile.

speclib eda_xilinx 2.0 {

display_name {AMD Xilinx Vivado}

environment xilinx-eda-tcl {
    display_name    {Xilinx EDA Tcl}
    core            tcl 8.5
    version_ceiling 8.5
    editor_identity tcl-xilinx
    ambient         sdc keyed SdcVersion
    ambient         upf keyed UpfVersion
    ambient         vivado keyed ToolVersion
    file_extension  xdc -name {Xilinx Design Constraints}
    help_terms      {xilinx vivado vitis amd fpga ise}
}

command add_bp {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_bp ?-quiet? ?-verbose? file_name line_number}

    hover {
        summary {Add a breakpoint at a line of an HDL source file.}
        synopsis {add_bp ?-quiet? ?-verbose? file_name line_number}
        description {Adds a breakpoint to an HDL source file so that simulation of the design pauses at that line, letting values be examined and design behavior verified. Breakpoints in the current simulation are listed by report_bps and removed by remove_bps.}
        returns {A new breakpoint object if there is not already a breakpoint set at the specified file line, else the existing breakpoint object.}
        example {add_bp C:/Data/ug937/sources/sinegen.vhd 137}
        source {Xilinx UG835 2026.1}
    }
}
command add_cells_to_pblock {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -top \
           -detail {Add the top level instance, to create a Pblock for the whole design.}
    option -add_primitives \
           -detail {Assign to the Pblock only the primitive cells of the specified list of cells, so a hierarchical module can be selected and only its leaf cells assigned.}
    option -clear_locs \
           -detail {Clear instance location constraints for cells that are already placed; without it, placed instances keep their placement as they are added.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-top -add_primitives}

    form Default {add_cells_to_pblock ?-top? ?-add_primitives? ?-clear_locs? ?-quiet? ?-verbose? pblock ?cells?}

    hover {
        summary {Add cells to a Pblock.}
        synopsis {add_cells_to_pblock ?-top? ?-add_primitives? ?-clear_locs? ?-quiet? ?-verbose? pblock ?cells?}
        description {Adds the specified logic instances to a Pblock in an open implemented design. Either cells or -top must be given, and the two cannot be combined. Once cells have been added the Pblock can be placed onto the device fabric with resize_pblock, and instances are taken back out with remove_cells_from_pblock.}
        returns {Nothing.}
        example {create_pblock pb_cpuEngine
add_cells_to_pblock pb_cpuEngine [get_cells cpuEngine/*] \
   -add_primitives -clear_locs}
        source {Xilinx UG835 2026.1}
    }
}
command add_condition {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    arg 1 -role Body -layout BlockScript

    option -name -takes name \
           -detail {Assign a unique name, or label, to the condition; two conditions cannot share a name, and without it a default label of the form condition_id is created.}
    option -radix -takes radix -values {default dec bin oct hex unsigned ascii smag} -closed \
           -detail {The radix used for the value of the condition, where dec is a signed decimal and unsigned is used for unsigned data.}
    option -notrace -detail {Turn off the logging of the condition commands that are run.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_condition ?-name name? ?-radix radix? ?-notrace? ?-quiet? ?-verbose? condition_expression commands}

    hover {
        summary {Conditionally execute Tcl commands during simulation.}
        synopsis {add_condition ?-name name? ?-radix radix? ?-notrace? ?-quiet? ?-verbose? condition_expression commands}
        description {Adds a condition to the Vivado integrated simulator that is evaluated whenever a signal change is detected, running the braced Tcl commands when the condition expression becomes TRUE. The expression may use the comparison operators == and != as well as the numeric operators <, >, <= and >=, joined by AND and OR. The command body may contain standard Tcl and simulation commands, but not run, restart or step.}
        returns {The condition object created.}
        example {add_condition -name resetLow {/testbench/reset == 0 } {
puts "Condition Reset was encountered at [current_time]. Stopping simulation."
stop }}
        source {Xilinx UG835 2026.1}
    }
}
command add_drc_checks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes ruledecks \
           -detail {Add the rule checks of the specified drc_ruledeck objects, which has the effect of copying the rules of one rule deck into another; the objects must come from a get_* command and cannot be combined with a search pattern.}
    option -regexp \
           -detail {Treat the search patterns and the -filter expression as full regular expressions, anchored to the start of the search string.}
    option -nocase \
           -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression \
           -detail {Filter the returned list with an expression over the property values of the rule check objects.}
    option -ruledeck -takes ruledeck \
           -detail {The name of the DRC rule deck to add the specified design rule checks to (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_drc_checks ?-of_objects ruledecks? ?-regexp? ?-nocase? ?-filter expression? -ruledeck ruledeck ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Add DRC rule check objects to a rule deck.}
        synopsis {add_drc_checks ?-of_objects ruledecks? ?-regexp? ?-nocase? ?-filter expression? -ruledeck ruledeck ?-quiet? ?-verbose? ?patterns?}
        description {Adds design rule checks to the specified drc_ruledeck object, which is a collection of checks grouped for convenience so that report_drc can run them at a stage of the flow such as I/O planning or placement. Both factory-defined checks and checks made with create_drc_check can be added; get_drc_checks lists the available checks and remove_drc_checks takes them back out. The default pattern is the wildcard *, which adds all rule checks.}
        returns {The drc_check objects that were added to the rule deck.}
        example {add_drc_checks -ruledeck project_rules {*DCI* *BUF*}}
        source {Xilinx UG835 2026.1}
    }
}
command add_files {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fileset -takes fileset \
           -detail {The fileset the source files are added to; an error is returned if it does not exist, and without it the files go to the source fileset.}
    option -of_objects -takes objects \
           -detail {The filesets, sub-designs, or reconfigurable modules to add the files to.}
    option -norecurse \
           -detail {Do not recurse through the subdirectories of any specified directory.}
    option -copy_to -takes directory \
           -detail {Copy the selected files to the specified directory before adding them to the project.}
    option -force \
           -detail {Overwrite existing files of the same name in the destination directory (only with -copy_to).}
    option -scan_for_includes \
           -detail {Scan the Verilog sources for include statements and add the referenced files to the fileset, which is not done by default.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_files ?-fileset fileset? ?-of_objects objects? ?-norecurse? ?-copy_to directory? ?-force? ?-scan_for_includes? ?-quiet? ?-verbose? ?files?}

    hover {
        summary {Add sources to a project fileset.}
        synopsis {add_files ?-fileset fileset? ?-of_objects objects? ?-norecurse? ?-copy_to directory? ?-force? ?-scan_for_includes? ?-quiet? ?-verbose? ?files?}
        description {Adds one or more source files, or the source file contents of one or more directories, to the specified fileset of the current project. Valid sources include HDL, netlist, and memory interface files; IP and block design sources are handled by import_ip, read_bd and read_ip instead. Files are added by reference rather than copied, which is what distinguishes this command from import_files, and their contents are not read until they are needed.}
        returns {List of file objects that were added.}
        example {add_files -norecurse C:/Data/ip/c_addsub_v11_0_0.xci}
        source {Xilinx UG835 2026.1}
    }
}
command add_force {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -radix -takes radix -values {default dec bin oct hex unsigned ascii smag} -closed \
           -detail {The radix used when specifying the values; the default radix is binary unless the HDL object type defines an overriding radix.}
    option -repeat_every -takes duration \
           -detail {Repeat the force over the given increment of time, which must be greater than the period covered by the value and time pairs.}
    option -cancel_after -takes offset \
           -detail {Cancel the force after the given period of time from the current time, as though remove_forces had been used then.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_force ?-radix radix? ?-repeat_every duration? ?-cancel_after offset? ?-quiet? ?-verbose? hdl_object values}

    hover {
        summary {Force the value of a signal, wire, or reg during simulation.}
        synopsis {add_force ?-radix radix? ?-repeat_every duration? ?-cancel_after offset? ?-quiet? ?-verbose? hdl_object values}
        description {Forces a single HDL object to hold a value for a period of time, or until released by -cancel_after or by remove_forces, with the same effect as the Verilog force and release statements and overriding any such statement in the test bench. Each value word is a value with an optional time offset relative to the current simulation time, and the times must increase and may not repeat. Time units may be fs, ps, ns, us, ms, or s; a bare number uses the simulation TIME_UNIT.}
        returns {The force objects added.}
        example {set for10 [ add_force reset 1 300 ]}
        source {Xilinx UG835 2026.1}
    }
}
command add_hw_hbm_pc {
    available {tcl 8.5}
    required_package vivado

    arity 3..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_hw_hbm_pc ?-quiet? ?-verbose? mc_num pc_num hw_objects}

    hover {
        summary {Add a pseudo channel to the activity monitor of a hardware HBM.}
        synopsis {add_hw_hbm_pc ?-quiet? ?-verbose? mc_num pc_num hw_objects}
        description {Selects one of the eight memory channels, numbered 0 to 7, and one of its two 64-bit pseudo channels, numbered 0 or 1, of the specified High Bandwidth Memory controller for monitoring by the HBM activity monitor, ahead of a run_hw_hbm_amon call. The memory channel number is given first and the pseudo channel number second, and the activity monitor must not be running while channels are added or removed.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command add_hw_probe_enum {
    available {tcl 8.5}
    required_package vivado

    arity 3..

    option -no_gui_update \
           -detail {Do not update the Vivado logic analyzer display to reflect the enumerated values of the probe.}
    option -dict -takes name_value_pairs \
           -detail {A dictionary of enumerated name and value pairs to assign at once, given in place of the name and value arguments and enclosed in quotes or braces.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_hw_probe_enum ?-no_gui_update? ?-dict name_value_pairs? ?-quiet? ?-verbose? name value hw_probe}

    hover {
        summary {Add an enumerated name-value pair to a hw_probe enumeration.}
        synopsis {add_hw_probe_enum ?-no_gui_update? ?-dict name_value_pairs? ?-quiet? ?-verbose? name value hw_probe}
        description {Associates a case-insensitive enumerated name with a bit value on a hardware probe, adding it as an ENUM.NAME property on the hw_probe object so that state machine and similar probes can be read and triggered symbolically in the Vivado logic analyzer. Values may be binary, octal, hex, signed or unsigned, but the binary bit value x and the edge bit values F, B and RT cannot be used.}
        returns {The enumerated name property.}
        example {add_hw_probe_enum -dict {ZERO eq5'h00 RED eq5'h12 GREEN eq5'h13 \
  BLUE eq5'h14 WHITE eq5'h15 YELLOW eq5'h16 GREY eq5'h17} \
  [get_hw_probes op1 -of_objects [current_hw_ila]]}
        source {Xilinx UG835 2026.1}
    }
}
command add_peripheral_interface {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    ;# NOTE(xilinx): the Syntax line and the Usage table show -interface_mode and
    ;# -axi_type unbracketed, but the Arguments prose marks both (Optional); the
    ;# conservative reading is taken here.
    option -interface_mode -takes mode -values {master slave} -closed \
           -detail {Whether the interface is a master, which generates out-bound AXI transactions, or a slave, which receives in-bound ones.}
    option -axi_type -takes type -values {lite full stream} -closed \
           -detail {The type of AXI interface to add, where full is the memory mapped AXI4 interface, lite is the register-style subset of it, and stream is the unidirectional master-to-slave transfer protocol.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_peripheral_interface ?-interface_mode mode? ?-axi_type type? ?-quiet? ?-verbose? name peripheral}

    hover {
        summary {Add a new AXI bus interface to a peripheral.}
        synopsis {add_peripheral_interface ?-interface_mode mode? ?-axi_type type? ?-quiet? ?-verbose? name peripheral}
        description {Adds an AXI bus interface of the given user-specified name to a peripheral created by create_peripheral. The peripheral object is the one returned by create_peripheral, which should be captured in a Tcl variable so that it can be passed to this and related commands.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command add_qor_checks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -ruledeck -takes ruledeck \
           -detail {The name of the rule deck to add the QoR checks to (required).}
    option -type -takes type -values {suggestion assessment} -closed \
           -detail {The type of check to add, either suggestion, which is the default, or assessment; only one type is added at a time and the type must match both the rule deck and the check.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Syntax line and the Usage table bracket <IDs> while the
    ;# Arguments prose marks it (Required); the Syntax spelling is used for the form.
    form Default {add_qor_checks -ruledeck ruledeck ?-type type? ?-quiet? ?-verbose? ?IDs?}

    hover {
        summary {Add a QoR check to a rule deck.}
        synopsis {add_qor_checks -ruledeck ruledeck ?-type type? ?-quiet? ?-verbose? ?IDs?}
        description {Adds one or more QoR checks, named by their check IDs, to a QoR rule deck created by create_qor_ruledeck. Checks themselves are defined with create_qor_check, and get_qor_checks reports which checks a rule deck now holds.}
        returns {The QoR check added to the rule deck.}
        source {Xilinx UG835 2026.1}
    }
}
command add_to_power_rail {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -power_sources -takes power_sources \
           -detail {The list of power sources to add, which can be power rails and/or power supplies.}
    option -phased_power_source -takes phased_source \
           -detail {A pair of a phased power source and its phase value, where the power source may itself be a phased power rail.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_to_power_rail ?-power_sources power_sources? ?-phased_power_source phased_source? ?-quiet? ?-verbose? power_rail}

    hover {
        summary {Add power sources to a power rail.}
        synopsis {add_to_power_rail ?-power_sources power_sources? ?-phased_power_source phased_source? ?-quiet? ?-verbose? power_rail}
        description {Adds power sources to the named power rail. Plain sources, which may be power rails or power supplies, are given with -power_sources, while -phased_power_source gives a source paired with its phase value.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command add_wave {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -into -takes wcfg_object \
           -detail {The wave configuration, group, or virtual bus the new wave objects are inserted into; a string is looked up as a group name of the current wave configuration, then as a virtual bus name, then as a wave configuration name, and without it the current wave configuration is assumed.}
    option -at_wave -takes wave_object \
           -detail {Insert the new wave objects into the given wave object, or after it if it is not a group or virtual bus; a string is treated as a display name.}
    option -after_wave -takes wave_object \
           -detail {Insert the new wave objects after the given wave object.}
    option -before_wave -takes wave_object \
           -detail {Insert the new wave objects before the given wave object.}
    option -reverse \
           -detail {Reverse the displayed bit order of the new wave objects by setting their IS_REVERSED property to true.}
    option -radix -takes radix -values {default dec bin oct hex unsigned ascii smag} -closed \
           -detail {Set the displayed radix of the new wave objects.}
    option -color -takes color \
           -detail {Set the displayed color of the new wave objects, given either as a standard color name or as a six-digit RGB string of the form #RRGGBB.}
    option -name -takes name \
           -detail {Set the DISPLAY_NAME property of the single new wave object; it is an error for more than one wave object to be created.}
    option -recursive -aliases {-r} \
           -detail {When a design object is a scope, create wave objects for all design objects and sub-scopes under that scope.}
    option -regexp \
           -detail {Interpret the items as regular expressions, anchored to the start of the search string.}
    option -nocase \
           -detail {Perform case-insensitive matching (only with -regexp).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-reverse? ?-radix radix? ?-color color? ?-name name? ?-recursive? ?-regexp? ?-nocase? ?-quiet? ?-verbose? items}

    hover {
        summary {Add new waves to a wave configuration.}
        synopsis {add_wave ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-reverse? ?-radix radix? ?-color color? ?-name name? ?-recursive? ?-regexp? ?-nocase? ?-quiet? ?-verbose? items}
        description {Creates one or more design-based wave objects from the named HDL objects of the current simulation and inserts them into a wave configuration. This command can only be used while a simulation is running, and at a minimum one item must be given, which is an HDL object of the simulation project.}
        returns {The new waves.}
        example {add_wave dout_tvalid /rsb_design_testbench/dout_tvalid}
        source {Xilinx UG835 2026.1}
    }
}
command add_wave_divider {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -into -takes wcfg_object \
           -detail {The wave configuration or group the new divider is inserted into; a string is looked up as a group name of the current wave configuration, then as a virtual bus name, then as a wave configuration name, and without it the current wave configuration is assumed.}
    option -at_wave -takes wave_object \
           -detail {Insert the new divider into the given wave object, or after it if it is not a group.}
    option -after_wave -takes wave_object \
           -detail {Insert the new divider after the given wave object.}
    option -before_wave -takes wave_object \
           -detail {Insert the new divider before the given wave object.}
    option -color -takes color \
           -detail {Set the displayed color of the new divider, given either as a standard color name or as a six-digit RGB string of the form #RRGGBB.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave_divider ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-color color? ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Add a new divider to a wave configuration.}
        synopsis {add_wave_divider ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-color color? ?-quiet? ?-verbose? ?name?}
        description {Creates a wave divider in the waveform viewer, which separates groups of related objects for easier viewing. The divider is inserted at the specified location of the given or current wave configuration, or at the end of it when no location is given, and takes the display name new_divider by default. This command can only be used while a simulation is running.}
        returns {The new divider.}
        example {add_wave_divider -after_wave CLK Div1}
        source {Xilinx UG835 2026.1}
    }
}
command add_wave_group {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -into -takes wcfg_object \
           -detail {The wave configuration or group the new group is inserted into; a string is looked up as a group name of the current wave configuration, then as a virtual bus name, then as a wave configuration name, and without it the current wave configuration is assumed.}
    option -at_wave -takes wave_object \
           -detail {Insert the new group into the given wave object, or after it if it is not a group.}
    option -after_wave -takes wave_object \
           -detail {Insert the new group after the given wave object.}
    option -before_wave -takes wave_object \
           -detail {Insert the new group before the given wave object.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave_group ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Add a new group to a wave configuration.}
        synopsis {add_wave_group ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-quiet? ?-verbose? ?name?}
        description {Creates a wave group in the given or current waveform configuration, into which wave objects and dividers can then be added to build up the waveform display. The group is inserted at the specified location, or at the end of the wave configuration when none is given, and takes the display name new_group by default. This command can only be used while a simulation is running.}
        returns {The new group.}
        source {Xilinx UG835 2026.1}
    }
}
command add_wave_marker {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Returns block names the created marker while the section's
    ;# Description says the command returns nothing; the Returns block is used here.
    option -into -takes wcfg_object \
           -detail {The wave configuration object the new marker is inserted into; without it the marker is added to the current wave configuration.}
    option -name -takes name \
           -detail {Create the marker with the given name; the default name is new_marker.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave_marker ?-into wcfg_object? ?-name name? ?-quiet? ?-verbose? ?time? ?unit?}

    hover {
        summary {Create a new wave marker.}
        synopsis {add_wave_marker ?-into wcfg_object? ?-name name? ?-quiet? ?-verbose? ?time? ?unit?}
        description {Creates a wave marker at the given simulation time within the waveform of the current wave configuration, defaulting to time 0. The time unit may be fs, ps, ns, us, ms, or s, and defaults to the time unit of the wave configuration. This command can only be used while a simulation is running.}
        returns {The new created marker.}
        example {add_wave_marker 500 ns}
        source {Xilinx UG835 2026.1}
    }
}
command add_wave_virtual_bus {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -into -takes wcfg_object \
           -detail {The wave configuration, group, or virtual bus the new virtual bus is inserted into; a string is looked up as a group name of the current wave configuration, then as a virtual bus name, then as a wave configuration name, and without it the current wave configuration is assumed.}
    option -at_wave -takes wave_object \
           -detail {Insert the new virtual bus into the given wave object, or after it if it is not a group or virtual bus.}
    option -after_wave -takes wave_object \
           -detail {Insert the new virtual bus after the given wave object.}
    option -before_wave -takes wave_object \
           -detail {Insert the new virtual bus before the given wave object.}
    option -reverse \
           -detail {Reverse the displayed bit order of the new virtual bus by setting its IS_REVERSED property to true.}
    option -radix -takes radix -values {default dec bin oct hex unsigned ascii smag} -closed \
           -detail {Set the displayed radix of the new virtual bus.}
    option -color -takes color \
           -detail {Set the displayed color of the new virtual bus, given either as a standard color name or as a six-digit RGB string of the form #RRGGBB.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {add_wave_virtual_bus ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-reverse? ?-radix radix? ?-color color? ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Add a new virtual bus to a wave configuration.}
        synopsis {add_wave_virtual_bus ?-into wcfg_object? ?-at_wave wave_object? ?-after_wave wave_object? ?-before_wave wave_object? ?-reverse? ?-radix radix? ?-color color? ?-quiet? ?-verbose? ?name?}
        description {Creates a new virtual bus of the given name and inserts it into the wave configuration where specified, or by default at the bottom of the existing wave configuration, setting its DISPLAY_NAME property to the given name. The default name is new_virtual_bus. This command can only be used while a simulation is running.}
        returns {The new virtual bus.}
        example {add_wave_virtual_bus dout_tvalid}
        source {Xilinx UG835 2026.1}
    }
}
command all_cpus {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {all_cpus ?-quiet? ?-verbose?}

    hover {
        summary {Get a list of CPU cells in the current design.}
        synopsis {all_cpus ?-quiet? ?-verbose?}
        description {Returns all CPU cell objects declared in the current design. The list can be narrowed with the filter command using properties of the CPU cells, which report_property and list_property enumerate. The command is scoped hierarchically from the level of the current instance, which is the top of the design unless current_instance says otherwise.}
        returns {List of cpu cell objects.}
        example {set_false_path -from [all_cpus] -to [all_registers]}
        source {Xilinx UG835 2026.1}
    }
}
command all_dsps {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {all_dsps ?-quiet? ?-verbose?}

    hover {
        summary {Get a list of DSP cells in the current design.}
        synopsis {all_dsps ?-quiet? ?-verbose?}
        description {Returns all DSP cell objects declared in the current design. The list can be narrowed with the filter command using properties of the DSP cells, which report_property and list_property enumerate. The command is scoped hierarchically from the level of the current instance, which is the top of the design unless current_instance says otherwise.}
        returns {List of dsp cell objects.}
        example {filter [all_dsps] {SITE == DSP48_X1Y6}}
        source {Xilinx UG835 2026.1}
    }
}
command all_ffs {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {all_ffs ?-quiet? ?-verbose?}

    hover {
        summary {Get a list of flip flop cells in the current design.}
        synopsis {all_ffs ?-quiet? ?-verbose?}
        description {Returns all flip flop instances in the current design. The get_cells command, or the filter command over the result, narrows the list to flops matching particular properties. The command is scoped hierarchically from the level of the current instance, which is the top of the design unless current_instance says otherwise.}
        returns {List of flip flop cell objects.}
        example {filter [all_ffs] {REF_NAME == FDRE}}
        source {Xilinx UG835 2026.1}
    }
}
command all_hsios {
