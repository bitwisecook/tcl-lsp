command get_sites {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -regexp -detail {Patterns are full regular expressions.}
    ;# NOTE(xilinx): -nocase is documented in this section's Arguments prose but
    ;# is absent from its Syntax line and Usage table; it is kept here because
    ;# every sibling get_* command carries it.
    option -nocase -detail {Perform case-insensitive matching (valid only when -regexp is specified).}
    option -filter -takes expr \
           -detail {Filter the list with an expression over site property values such as SITE_TYPE, IS_OCCUPIED, NUM_INPUTS, or NUM_OUTPUTS.}
    option -range -takes range \
           -detail {Match site names which fall into the range, defined by exactly two site names of the same SITE_TYPE.}
    option -of_objects -takes objects \
           -detail {Get the sites of these objects; only Tile, Bel, Pin, Package Pin, and I/O Bank objects are supported.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_sites ?-regexp? ?-nocase? ?-filter expr? ?-range range? ?-of_objects objects? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of Sites.}
        synopsis {get_sites ?-regexp? ?-nocase? ?-filter expr? ?-range range? ?-of_objects objects? ?-quiet? ?-verbose? ?patterns?}
        description {Gets a list of sites on the target device that match a specified search pattern; the default is to get all sites on the target device. Bonded sites also match on package pin names, and a range of sites is given as two site values of the same SITE_TYPE.}
        returns {List of site objects.}
        example {get_sites}
        source {Xilinx UG835 2012.2}
    }
}
