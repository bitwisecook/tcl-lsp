           -detail {The default behavior is to report the first difference only; when this option is set to true, complete differences are reported.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {tandem_verify -reference_dcp dcp_file -untrusted_dcp dcp_file ?-full_check boolean? ?-quiet? ?-verbose?}

    hover {
        summary {Tcl task to verify Tandem Stage-1 PDIs.}
        synopsis {tandem_verify -reference_dcp dcp_file -untrusted_dcp dcp_file ?-full_check boolean? ?-quiet? ?-verbose?}
        description {Verifies Tandem Stage-1 PDIs by comparing an untrusted design checkpoint against a trusted reference design checkpoint.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command terminate_runs {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {terminate_runs ?-quiet? ?-verbose? runs}

    hover {
        summary {Terminate the runs.}
        synopsis {terminate_runs ?-quiet? ?-verbose? runs}
        description {Terminates the specified runs. No files or directories under the run directory are deleted, and the state of each run changes to error, reported as user canceled. A terminated run must be reset with reset_runs before it can be re-launched.}
        returns {Nothing.}
        example {terminate_runs impl_1}
        source {Xilinx UG835 2026.1}
