command report_clocks {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_clocks ?-file file_name? ?-append? ?-return_string? ?clocks? ?-quiet? ?-verbose?}

    hover {
        summary {Report clocks.}
        synopsis {report_clocks ?-file file_name? ?-append? ?-return_string? ?clocks? ?-quiet? ?-verbose?}
        description {Returns a table showing all the clocks in a design, including propagated clocks, generated and auto-generated clocks, virtual clocks, and inverted clocks in the current synthesized or implemented design. The clocks argument matches clocks against the specified patterns, defaulting to the wildcard * which returns all clocks. More detailed information about each clock net can be obtained with the report_clock_utilization command.}
        returns {Nothing.}
        example {report_clocks *Clock*}
        source {Xilinx UG835 2012.2}
    }
}
command report_conditions {
    dialects tcl8.5
    required_package vivado

