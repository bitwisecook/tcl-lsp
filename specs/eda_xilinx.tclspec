command verify_hw_devices {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -key -takes key -values {efuse} \
           -detail {Verify that the encryption key is programmed on the specified hw_device in eFUSE registers.}
    option -user_efuse -takes user_efuse \
           -detail {Verify that the provided hexadecimal value is programmed into the FUSE_USER register on the hw_device.}
    option -control_efuse -takes control_efuse \
           -detail {Verify that the provided hexadecimal value is programmed into the FUSE_CNTL register on the hw_device.}
    option -security_efuse -takes security_efuse \
           -detail {Verify that the provided hexadecimal value is programmed into the FUSE_SEC register on the hw_device.}
    option -readback_pdi -takes readback_pdi \
           -detail {Readback PDI for readback, applicable only for Spartan UltraScale+ devices.}
    option -bit_file -takes bit_file \
           -detail {Bitstream file for verification, applicable only for Spartan UltraScale+ devices.}
    option -mask_file -takes mask_file \
           -detail {Mask file for verification, applicable only for Spartan UltraScale+ devices.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Report eFUSE register values when verifying the device.}

    form Default {verify_hw_devices ?-key key? ?-user_efuse user_efuse? ?-control_efuse control_efuse? ?-security_efuse security_efuse? ?-readback_pdi readback_pdi? ?-bit_file bit_file? ?-mask_file mask_file? ?hw_device? ?-quiet? ?-verbose?}

    hover {
        summary {Verify hardware devices.}
        synopsis {verify_hw_devices ?-key key? ?-user_efuse user_efuse? ?-control_efuse control_efuse? ?-security_efuse security_efuse? ?-readback_pdi readback_pdi? ?-bit_file bit_file? ?-mask_file mask_file? ?hw_device? ?-quiet? ?-verbose?}
        description {For EFUSE encrypted devices, compares the bitstream assigned to the PROGRAM.FILE property on the specified hw_device with the bitstream programmed into the device by program_hw_devices, filtered through the mask file associated with the hw_device so that only the bits marked as important are compared. A mask file can be created along with the bitstream by write_bitstream and associated with the hw_device by create_hw_bitstream. Verification cannot be performed on devices programmed with encrypted bitstreams, other than to verify that the key has been programmed.}
        returns {Hardware devices.}
        example {verify_hw_devices [current_hw_device]}
        source {Xilinx UG835 2026.1}
    }
}
