        summary {Get a list of hardware targets.}
        synopsis {get_hw_targets ?-of_objects hw_servers? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the available hardware targets of the connected hardware servers. A hardware target is a system board containing a JTAG chain of one or more devices that can be programmed with a bitstream or used to debug the design, connected to the tool through the hardware server application and connect_hw_server. Use open_hw_target to open a connection to one of the available targets, which then becomes the current target, or set the current target first with current_hw_target; programming and debug commands are directed to the open target.}
        returns {Hardware targets.}
        example {get_hw_targets}
        source {Xilinx UG835 2026.1}
    }
}
command get_hw_vios {
    available {tcl 8.5}
    required_package vivado

