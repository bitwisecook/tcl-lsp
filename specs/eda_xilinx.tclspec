command report_place_status {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -return_sites \
           -detail {Return the list of sites matching -site_type, which is required with it, instead of generating the report output.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, which is overwritten unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it.}
    option -of_objects -takes sites \
           -detail {Report detailed placement status for these sites, which must be specified with the get_sites command.}
    option -site_type -takes site_type \
           -values {FIXED_CELLS HAS_INVERTED_IN HAS_ROUTE_THRUS HAS_TIE_OFFS ILLEGAL_PL INVALID_RS PLACED ROUTE_THRU_SITE TIE_OFF_SITE} -closed \
           -detail {Show only sites with the specified placement status, and ignored if -of_objects is also specified.}
    option -list_all_sites \
           -detail {Report summary placement status for every site in the design, and ignored if -of_objects is also specified.}
    option -dump_placement \
           -detail {Report the full placement information for every used site in the design, which is a very long report and takes time to generate.}
    ;# NOTE(xilinx): the Usage table spells the placement types as a closed set
    ;# while the Arguments prose introduces them with "include", so the set is
    ;# left open.
    option -placement_type -takes placement_type \
           -values {PLACEDB PREROUTE WITH_ROUTING} \
           -detail {The design attributes to check.}
    option -post_route_check -detail {Check the routing information.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-return_sites -return_string}
    option_conflict {-return_sites -of_objects}
    option_conflict {-return_sites -dump_placement}

    form Default {report_place_status ?-return_sites? ?-return_string? ?-file file_name? ?-append? ?-of_objects sites? ?-site_type site_type? ?-list_all_sites? ?-dump_placement? ?-placement_type placement_type? ?-post_route_check? ?-quiet? ?-verbose?}

    hover {
        summary {Report on status of the placement.}
        synopsis {report_place_status ?-return_sites? ?-return_string? ?-file file_name? ?-append? ?-of_objects sites? ?-site_type site_type? ?-list_all_sites? ?-dump_placement? ?-placement_type placement_type? ?-post_route_check? ?-quiet? ?-verbose?}
        description {Reports the state of placement in the current design. The report can cover the sites given by -of_objects, only the sites with a given placement status, every site in the design, or the full placement information of every used site; with -return_sites the command instead returns the list of sites matching the -site_type given with it.}
        returns {The placement status report, or the list of matching sites when -return_sites is used.}
        example {report_place_status -of_objects [ get_sites AIE* ]}
        source {Xilinx UG835 2026.1}
    }
}
command report_power_opt {
    available {tcl 8.5}
