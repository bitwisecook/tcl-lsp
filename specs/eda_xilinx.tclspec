command report_objects {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_objects ?-quiet? ?-verbose? ?hdl_objects?}

    hover {
        summary {Print details of the given HDL objects (variable, signal, wire, or reg).}
        synopsis {report_objects ?-quiet? ?-verbose? ?hdl_objects?}
        description {Reports the type, name, and language of the specified HDL objects to the Tcl console or shell, which requires an open simulation. HDL objects include HDL signals, variables, or constants defined in the Verilog or VHDL test bench and source files: signals include Verilog wire and reg entities and VHDL signals, variables include Verilog real, realtime, time, and event, and constants include Verilog parameters and localparams and VHDL generics and constants. Objects can be specified by name or returned by get_objects, and all objects of the current simulation scope are reported by default; describe returns more detailed information.}
        returns {Print name, type, data_type of the HDL objects on console in textual format.}
        example {report_objects [get_objects GPIO*]}
        source {Xilinx UG835 2026.1}
    }
}
command report_operating_conditions {
