        summary {Set user columns on one or more package pins.}
        synopsis {set_package_pin_val ?-quiet? ?-verbose? column value package_pins}
        description {Creates user-defined package pin attributes and assigns values to specific pins on the package. The case-sensitive column name creates a new attribute for package pins when it does not already exist, and the command can be repeated to assign different values to different pins in the same column. Use set_property to set tool-defined properties of a package pin.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command set_param {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_param ?-quiet? ?-verbose? name value}

    hover {
        summary {Set a parameter value.}
        synopsis {set_param ?-quiet? ?-verbose? name value}
        description {Sets the value of a user-definable configuration parameter that configures and controls the behavior of the tool; only one parameter can be set at a time. Refer to report_param for a description of currently defined parameters, and use reset_param to restore a modified parameter to its default setting. Setting a parameter value to -1 disables the feature.}
        returns {Newly set parameter value.}
        example {set_param general.maxThreads 4}
        source {Xilinx UG835 2026.1}
    }
}
command set_part {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_part ?-quiet? ?-verbose? part}

    hover {
        summary {Set the part on the current project, creating a diskless project if no project is open.}
        synopsis {set_part ?-quiet? ?-verbose? part}
        description {Changes the part used by the current project for subsequent elaboration, synthesis, implementation, and analysis, creating an in-memory project for a non-project based design or assigning the part to the existing in-memory project. The part is changed for the current project only and not for the in-memory design; project-based designs should instead set the PART property on the project. Use get_parts to list the available parts.}
        returns {The part that the in-memory project is set to use.}
        example {set_part xc7vx485tffg1158-2}
        source {Xilinx UG835 2026.1}
    }
}
command set_power_opt {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -include_cells -takes cells \
           -detail {Include only these instances for clock gating; the default is all cells.}
    option -exclude_cells -takes cells \
           -detail {Exclude these instances from clock gating, applying only to the currently included cells when -include_cells has been specified.}
    option -clocks -takes clocks \
           -detail {Clock gate instances clocked by these clocks only; the default is all clocks in the design.}
    option -cell_types -takes cell_types -values {all bram reg srl none} -closed \
           -detail {Clock gate these cell types only, specified either as all or none to reset prior commands, or as one or more of bram, reg, and srl; the default is all.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_power_opt ?-include_cells cells? ?-exclude_cells cells? ?-clocks clocks? ?-cell_types cell_types? ?-quiet? ?-verbose?}

    hover {
        summary {Set constraints for power optimization.}
        synopsis {set_power_opt ?-include_cells cells? ?-exclude_cells cells? ?-clocks clocks? ?-cell_types cell_types? ?-quiet? ?-verbose?}
        description {Specifies cell instances to include in or exclude from power optimization, which is performed by power_opt_design. The effect of multiple set_power_opt commands is cumulative, so a broad class of cell types can be selected, specific hierarchical cells included, and cells within the included hierarchy excluded to refine the optimization. Block RAM optimizations are performed by default with opt_design, and cells can be excluded from that optimization with this command as well; report_power_opt reports the optimizations performed.}
        returns {Nothing.}
        example {set_power_opt -cell_types bram
power_opt_design}
        source {Xilinx UG835 2026.1}
    }
}
command set_property {
    available {tcl 8.5}
    required_package vivado

    arity 3..

    option -dict -takes name_value_pairs \
           -detail {A list of name and value pairs of properties to set on the object with a single command, enclosed in quotes or braces; not valid with the name and value arguments.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_property ?-dict name_value_pairs? ?-quiet? ?-verbose? name value objects}

    hover {
        summary {Set a property on one or more objects.}
        synopsis {set_property ?-dict name_value_pairs? ?-quiet? ?-verbose? name value objects}
        description {Assigns the defined property name and value to the specified objects, where the case-sensitive name is either one of the object's predefined properties or a custom property, and the value is checked against the property type. Use report_property, list_property, or list_property_values to determine the defined set of properties on an object, and get_property to validate properties that have been set. When a value contains special characters such as a dash, the explicit -name, -value, and -objects arguments must be used instead of the positional arguments.}
        returns {Nothing.}
        example {set_property internal_vref {0.75} [get_iobanks 0]}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command set_speed_grade {
    available {tcl 8.5}
    required_package vivado

