command log_saif {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {log_saif hdl_objects ... ?-quiet? ?-verbose?}

    hover {
        summary {Select which hdl_objects to track in the SAIF file.}
        synopsis {log_saif hdl_objects ... ?-quiet? ?-verbose?}
        description {Selects the HDL objects whose switching activity is tracked in the SAIF file opened by open_saif.}
        returns {Does not return any object.}
        source {Xilinx UG835 2012.2}
    }
}
command log_vcd {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -into -takes vcd_object \
           -detail {The VCD object to write values into; if not specified, the current VCD object is used.}
    option -level -takes levels \
           -detail {Number of levels of design hierarchy to traverse when locating HDL objects to write, where the default of 0 dumps the level defined by hdl_objects and all levels below it.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {log_vcd ?-into vcd_object? ?-level levels? ?hdl_objects ...? ?-quiet? ?-verbose?}

    hover {
        summary {Log VCD for the specified hdl_objects.}
        synopsis {log_vcd ?-into vcd_object? ?-level levels? ?hdl_objects ...? ?-quiet? ?-verbose?}
        description {Indicates which HDL objects to write into the Value Change Dump (VCD) file, modeling the behavior of the Verilog $dumpvars system task. HDL objects include HDL signals, variables, or constants as defined in the Verilog or VHDL testbench and source files, and the level of hierarchy is represented in the hdl_objects pattern. The actual values of the objects are written to the VCD file when you run the checkpoint_vcd or flush_vcd commands at a specific time during simulation, and open_vcd must be used before any other *_vcd command.}
        returns {Does not return any object.}
        example {log_vcd -into vcd1 [get_objects filter { type == port } /tb/UUT/* ]}
        source {Xilinx UG835 2012.2}
    }
}
command log_wave {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -recursive -aliases {-r} -detail {Searches recursively for objects.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {log_wave ?-recursive? ?-quiet? ?-verbose? hdl_objects}

    hover {
        summary {Turn on waveform tracing for the specified HDL objects.}
        synopsis {log_wave ?-recursive? ?-quiet? ?-verbose? hdl_objects}
        description {Enables monitoring of transitions on the specified hdl_objects in the Vivado integrated simulator, logging them into the waveform database (wdb); unlike add_wave it does not add the objects to the waveform viewer.}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
