    hover {
        summary {Delete I/O port interfaces from the project.}
        synopsis {delete_interface ?-all? ?-quiet? ?-verbose? interfaces}
        description {Deletes existing I/O port interfaces and, with -all, also deletes all of the associated ports and buses using the interface.}
        returns {Nothing.}
