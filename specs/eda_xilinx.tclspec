    hover {
        summary {Remove a list of cluster configurations.}
        synopsis {remove_cluster_configurations ?-quiet? ?-verbose? cluster_configurations}
        description {Removes the given list of cluster configuration objects, which can be obtained with get_cluster_configurations. Only user-defined cluster configurations can be removed, not the Vivado default ones; the IS_DEFAULT property tells the two apart. The supported cluster management tools are LSF, Sun Grid Engine, and SLURM.}
        example {remove_cluster_configurations [get_cluster_configurations lsf_medium]}
        source {Xilinx UG835 2026.1}
    }
}
command remove_conditions {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -all \
           -detail {Remove all conditions in the current simulation, without warning, even if other options are specified.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_conditions ?-all? ?-quiet? ?-verbose? ?conditions?}

    hover {
        summary {Remove conditions from a simulation.}
        synopsis {remove_conditions ?-all? ?-quiet? ?-verbose? ?conditions?}
        description {Removes the specified conditions, given as condition objects, IDs or names returned by add_condition, from the current simulation; the names can be specified as Tcl glob patterns and an open simulation is required. The conditions in the current simulation can be listed with report_conditions.}
        returns {Nothing.}
        example {remove_conditions condition3}
        source {Xilinx UG835 2026.1}
    }
}
command remove_drc_checks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes drc_ruledecks \
           -detail {Remove the rule checks of the specified drc_ruledeck objects from the target rule deck; cannot be combined with a search pattern.}
    option -regexp -detail {The search patterns are written as full regular expressions.}
    option -nocase \
           -detail {Perform case-insensitive matching, valid only when -regexp is specified.}
    option -filter -takes expression \
           -detail {Filter the results list with the specified expression, based on property values of the objects.}
    option -ruledeck -takes ruledeck \
           -detail {The name of the DRC rule deck to remove the specified design rule checks from (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_drc_checks ?-of_objects drc_ruledecks? ?-regexp? ?-nocase? ?-filter expression? -ruledeck ruledeck ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Remove DRC rule check objects from a user rule deck.}
        synopsis {remove_drc_checks ?-of_objects drc_ruledecks? ?-regexp? ?-nocase? ?-filter expression? -ruledeck ruledeck ?-quiet? ?-verbose? ?patterns?}
        description {Removes the design rule checks matching the specified patterns, defaulting to the wildcard that matches all of them, from the named drc_ruledeck object. Rule decks group design rule checks to be run by report_drc at different stages of the flow, and checks are added to them with add_drc_checks. A check can also be disabled without removing it by setting its IS_ENABLED property to false.}
        returns {Drc_check.}
        example {remove_drc_checks -ruledeck my_rules}
        source {Xilinx UG835 2026.1}
    }
}
command remove_files {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -fileset -takes fileset \
           -detail {The fileset to locate the specified files in, defaulting to the current fileset as defined by current_fileset.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_files ?-fileset fileset? ?-quiet? ?-verbose? files}

    hover {
        summary {Remove files or directories from a fileset.}
        synopsis {remove_files ?-fileset fileset? ?-quiet? ?-verbose? files}
        description {Removes the specified file objects from the current or specified fileset, removing them from the project but not from disk. Files can be given as name strings, which are looked for in the current or specified fileset, or as file objects returned by get_files, in which case the object defines the fileset and -fileset is ignored. An error is returned if the specified file is not found.}
        returns {List of files that were removed.}
        example {remove_files -fileset constrs_1 C:/Design/top.xdc}
        source {Xilinx UG835 2026.1}
    }
}
command remove_forces {
    available {tcl 8.5}
    required_package vivado

