    arity 1..

    option -radix -takes radix -values {default dec bin oct hex unsigned ascii} -closed \
           -detail {The radix to use when returning the value of the specified object.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_value ?-radix radix? ?-quiet? ?-verbose? hdl_object}

    hover {
        summary {Gets the current value of the selected hdl_object.}
        synopsis {get_value ?-radix radix? ?-quiet? ?-verbose? hdl_object}
        description {Gets the value of the specified HDL object at the current simulation run time. HDL objects include HDL signals, variables, or constants as defined in the Verilog or VHDL testbench and source files, and may be named directly or returned as an object from get_objects.}
        returns {A string representation of the value of a hdl_object.}
        example {get_value sysClk}
        source {Xilinx UG835 2012.2}
    }
}
command get_wave_config {
    dialects tcl8.5
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): this section's one-line heading text in UG835 is a copy of
    ;# the help command's ("Display help for one or more topics"); the summary
    ;# below is taken from the Usage table's patterns row instead.
    option -regexp -detail {Search using regular expressions; items must be strings.}
    option -nocase -detail {Perform a case-insensitive match (only used with -regexp).}
    option -filter -takes expr \
           -detail {Filter the results list with an expression over wave configuration property values such as has_time or needs_save.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_wave_config ?-regexp? ?-nocase? ?-filter expr? ?-quiet? ?-verbose? ?patterns...?}

    hover {
        summary {Search all wave configurations for the ones whose name property matches the patterns.}
        synopsis {get_wave_config ?-regexp? ?-nocase? ?-filter expr? ?-quiet? ?-verbose? ?patterns...?}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
command get_wires {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (valid only when -regexp is specified).}
    option -filter -takes expr \
           -detail {Filter the list with an expression over wire property values such as NAME, NUM_DOWNHILL_PIPS, or NUM_UPHILL_PIPS.}
    option -of_objects -takes objects -detail {Get the wires of these tiles, nodes, or pips.}
    option -uphill -detail {Get the wires uphill from the provided pip.}
    option -downhill -detail {Get the wires downhill from the provided pip.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_wires ?-regexp? ?-nocase? ?-filter expr? ?-of_objects objects? ?-uphill? ?-downhill? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of wires.}
        synopsis {get_wires ?-regexp? ?-nocase? ?-filter expr? ?-of_objects objects? ?-uphill? ?-downhill? ?-quiet? ?-verbose? ?patterns?}
        description {Returns a list of wires in the design that match a specified search pattern in an open design; the default is to get all wires in the design. The get_* commands return a container list holding a single type of object, so only objects of that same type may be appended to the result.}
        returns {Wires.}
        example {get_wires -of_objects [get_tiles IO_INT_INTERFACE_L_X0Y198]}
        source {Xilinx UG835 2012.2}
    }
}
command group_bd_cells {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -prefix -takes prefix -detail {Prefix name to add to cells.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {group_bd_cells ?-prefix prefix? ?-quiet? ?-verbose? ?target_cell_name? ?cells...?}

    hover {
        summary {Create a hierarchical cell and move a group of cells into it.}
        synopsis {group_bd_cells ?-prefix prefix? ?-quiet? ?-verbose? ?target_cell_name? ?cells...?}
        description {Creates a hierarchical cell, and then moves the group of cells into the hierarchy cell. The connections between these cells are maintained; the connections between these cells and other cells are maintained through the crossing hierarchy cell.}
        returns {0 if success.}
        source {Xilinx UG835 2012.2}
    }
}
command help {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -category -takes category -detail {Search for topics in the specified category.}
    option -args -detail {Display arguments description.}
    option -syntax -detail {Display syntax description.}
    option -long -detail {Display long help description.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {help ?-category category? ?-args? ?-syntax? ?-long? ?-quiet? ?-verbose? ?pattern?}

    hover {
        summary {Display help for one or more topics.}
        synopsis {help ?-category category? ?-args? ?-syntax? ?-long? ?-quiet? ?-verbose? ?pattern?}
        description {Returns a brief or long description of the specified Tcl command, a list of available Xilinx Tcl command categories, or a list of commands matching a specific pattern. The default help command without any arguments returns a list of Tcl command categories that can be further explored.}
        returns {Nothing.}
        example {help}
        source {Xilinx UG835 2012.2}
    }
}
command highlight_objects {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -color_index -takes color_index \
           -detail {The color index to use for highlighting, as defined by the Highlight category of the theme options.}
    option -rgb -takes rgb \
           -detail {The color to use given as an RGB code specified as a three element list of R G B values.}
    option -color -takes color -values {red green blue magenta yellow cyan orange} -closed \
           -detail {The color to use for highlighting the specified objects.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {highlight_objects ?-color_index color_index? ?-rgb rgb? ?-color color? ?-quiet? ?-verbose? objects}

    hover {
        summary {Highlight objects in different colors.}
        synopsis {highlight_objects ?-color_index color_index? ?-rgb rgb? ?-color color? ?-quiet? ?-verbose? objects}
        description {Highlights the specified object or objects in a color determined by one of the color options; objects can be unhighlighted with the unhighlight_objects command. Only one color option should be used, but if more than one is specified the order of precedence is -rgb, -color_index, and -color.}
        returns {Nothing.}
        example {highlight_objects -color red [get_selected_objects]}
        source {Xilinx UG835 2012.2}
    }
}
command implement_debug_core {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {implement_debug_core ?-quiet? ?-verbose? ?cores...?}

    hover {
        summary {Implement ChipScope debug core.}
        synopsis {implement_debug_core ?-quiet? ?-verbose? ?cores...?}
        description {Implements the ChipScope debug cores in the CORE Generator tool, running it once for any ILA debug cores specified and once more for the ICON controller core if all cores are specified. All debug cores are implemented if no cores are given; debug core implementation is also automatic when an implementation run is launched with launch_runs.}
        returns {Nothing.}
        example {implement_debug_core [get_debug_cores]}
        source {Xilinx UG835 2012.2}
    }
}
command import_files {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -fileset -takes fileset \
           -detail {The fileset to which the specified source files should be added, defaulting to the source fileset.}
    option -force -detail {Overwrite files of the same name in the project directory and in the fileset.}
    option -norecurse -detail {Disable the default behavior of recursive directory searches.}
    option -flat -detail {Import the files into a flat directory structure without preserving their relative paths.}
    option -relative_to -takes dir \
           -detail {Import the files with respect to the given relative directory; ignored when -flat is also specified.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {import_files ?-fileset fileset? ?-force? ?-norecurse? ?-flat? ?-relative_to dir? ?-quiet? ?-verbose? ?files...?}

    hover {
        summary {Import files and/or directories into the active fileset.}
        synopsis {import_files ?-fileset fileset? ?-force? ?-norecurse? ?-flat? ?-relative_to dir? ?-quiet? ?-verbose? ?files...?}
        description {Imports one or more files, or the source file contents of one or more directories, into the specified fileset. Unlike add_files, which adds files by reference, this command copies the files into the local project folders under the fileset imports directory and then adds them to the fileset.}
        returns {A list of file objects that were imported.}
        example {import_files -fileset constrs_1 top.ucf}
        source {Xilinx UG835 2012.2}
    }
}
