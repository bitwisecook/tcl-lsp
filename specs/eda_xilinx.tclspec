    option -verbose -detail {Suspend message limits during command execution.}

    form Default {checkpoint_vcd ?-ports? ?-file file? ?-quiet? ?-verbose?}

    hover {
        summary {Create a VCD checkpoint.}
        synopsis {checkpoint_vcd ?-ports? ?-file file? ?-quiet? ?-verbose?}
        description {Inserts the current HDL object signal values into the Value Change Dump file, which is the equivalent of the Verilog dumpall system task and provides the initial values of the specified signals. The open_vcd and log_vcd commands must be run first, and the simulation must be run or rerun afterwards to capture the signal values.}
        returns {Nothing.}
        example {checkpoint_vcd}
        source {Xilinx UG835 2026.1}
    }
}
