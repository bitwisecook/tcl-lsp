    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {list_targets ?-quiet? ?-verbose? files}

    hover {
        summary {List applicable targets for the specified source.}
        synopsis {list_targets ?-quiet? ?-verbose? files}
        description {Lists the targets that are available for a specified IP core, DSP module, or IP subsystem, given a files object returned by get_files rather than a file name. The accepted file types are .xci, .xco, .mdl, .bd, and .bxml. Use generate_targets to generate the listed targets. Nothing is returned if no targets are available for the specified file objects.}
        returns {List of targets.}
        example {list_targets [get_files *.mdl]}
        source {Xilinx UG835 2026.1}
    }
}
