command close_bd_design {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {close_bd_design ?-quiet? ?-verbose? name}

    hover {
        summary {Close an IP subsystem design.}
        synopsis {close_bd_design ?-quiet? ?-verbose? name}
        description {Closes the named IP subsystem design in the IP integrator. There is no prompt to save a modified design, so save_bd_design must be run first to keep any changes.}
        returns {The design object, or the empty string if it failed.}
        example {close_bd_design [current_bd_design]}
        source {Xilinx UG835 2026.1}
    }
}
