    option -copy -takes hw_target \
           -detail {Make the new SVF target a copy of an existing physical or SVF hw_target as returned by get_hw_targets.}
    option -svf -detail {Create the target in SVF mode.}
    option -stapl -detail {Create the target in STAPL mode.}
    option -import -takes file -detail {File specifying the JTAG chain to create.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_hw_target ?-copy hw_target? ?-svf? ?-stapl? ?-import file? ?-quiet? ?-verbose? target_name}

    hover {
        summary {Create a hw_target (JTAG chain) and set its name.}
        synopsis {create_hw_target ?-copy hw_target? ?-svf? ?-stapl? ?-import file? ?-quiet? ?-verbose? target_name}
        description {Creates a Serial Vector Format (SVF) hw_target object on the current hw_server as a platform for programming devices and exporting the programming commands to an SVF file with write_hw_svf. The target is queried and managed like other hw_targets, is identified by the boolean IS_SVF property, and does not require a connection to an actual board, so a local hw_server is recommended. The command returns nothing when it succeeds and an error if it fails.}
        returns {Hardware targets.}
        example {create_hw_target -copy [get_hw_targets *210203327996A] svfTarget}
        source {Xilinx UG835 2026.1}
    }
}
command create_interface {
    available {tcl 8.5}
    required_package vivado

    arity 1..

