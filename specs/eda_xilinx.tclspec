        description {Removes one or more ChipScope debug cores from the current project. The debug cores may have been added by create_debug_core or imported by read_chipscope_cdc; in either case the core is removed from the current project.}
        returns {Nothing.}
        example {delete_debug_core myCore}
        source {Xilinx UG835 2012.2}
    }
}
command delete_debug_port {
