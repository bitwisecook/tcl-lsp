        source {Xilinx UG835 2012.2}
    }
}
command delete_pblocks {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -hier \
           -detail {Also delete Pblocks nested inside the specified Pblock, which are otherwise moved up one level.}
