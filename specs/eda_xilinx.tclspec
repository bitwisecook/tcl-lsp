        summary {Create a new interface net.}
        synopsis {create_bd_intf_net ?-quiet? ?-verbose? name}
        description {Creates a new IP integrator interface net for the current subsystem design.}
        returns {The newly created intf_net object, or "" if it failed.}
        example {create_bd_intf_net diff_clock_rtl}
        source {Xilinx UG835 2026.1}
    }
}
command create_bd_intf_pin {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -vlnv -takes vlnv \
           -detail {The Vendor:Library:Name:Version attribute of the interface pin object to add, identifying it in the IP integrator catalog.}
    option -mode -takes mode \
           -values {Master Slave System MirroredMaster MirroredSlave MirroredSystem Monitor} -closed \
           -detail {The mode of the interface pin.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_bd_intf_pin ?-vlnv vlnv? ?-mode mode? ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Create a new interface pin.}
        synopsis {create_bd_intf_pin ?-vlnv vlnv? ?-mode mode? ?-quiet? ?-verbose? ?name?}
        description {Creates a new interface pin on an IP integrator hierarchical module, where an interface is a grouping of individual signals and buses that share a common function. The hierarchical module must be made the current instance with current_bd_instance, since the current instance is the target of this command; use create_bd_pin for a single connection pin or standard bus pin.}
        returns {The newly created intf_pin object, or "" if it failed.}
        example {current_bd_instance [get_bd_cells /newMod1]
create_bd_intf_pin -mode Slave -vlnv xilinx.com:user:dma_rtl:1.0 data_in}
        source {Xilinx UG835 2026.1}
    }
}
command create_bd_intf_port {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -vlnv -takes vlnv \
           -detail {The Vendor:Library:Name:Version attribute of the interface port object to add, identifying it in the IP integrator catalog.}
    option -mode -takes mode \
           -values {Master Slave System MirroredMaster MirroredSlave MirroredSystem Monitor} -closed \
           -detail {The mode of the interface port.}
    option -default_portmap \
           -detail {Create default port-maps for this external bus-interface, as given by the bus-interface definition in the Vivado IP catalog.}
    option -board_intf -takes board_intf \
           -detail {Create port-maps for this external bus-interface using the specified interface of the current board.}
    option -portmaps -takes portmaps \
           -detail {Create port-maps for this external bus-interface from the specified information in dictionary form, each logical port naming a physical_name and direction and optionally left and right indices.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_bd_intf_port ?-vlnv vlnv? ?-mode mode? ?-default_portmap? ?-board_intf board_intf? ?-portmaps portmaps? ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Create a new interface port.}
        synopsis {create_bd_intf_port ?-vlnv vlnv? ?-mode mode? ?-default_portmap? ?-board_intf board_intf? ?-portmaps portmaps? ?-quiet? ?-verbose? ?name?}
        description {Creates a new IP integrator subsystem design interface port, where an interface is a grouping of individual signals and buses that share a common function. Use create_bd_port for a single connection port or common bus port.}
        returns {The newly created interface port object, or "" if it failed.}
        example {create_bd_intf_port -vlnv xilinx.com:interface:diff_clock_rtl:1.0 \
   -mode Slave diff_clock_rtl}
        source {Xilinx UG835 2026.1}
    }
}
command create_bd_intf_tlm_port {
    available {tcl 8.5}
