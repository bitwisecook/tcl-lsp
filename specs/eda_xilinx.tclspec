        summary {Delete a hw_target.}
        synopsis {delete_hw_target ?-quiet? ?-verbose? ?target_object?}
        description {Deletes an SVF or virtual hardware target from the current hardware server. The target must be a virtual target created by the create_hw_target command or an error is returned; if no target is given, the Vivado hardware manager attempts to delete the current_hw_target.}
        returns {Nothing if successful; an error if it fails.}
        example {delete_hw_target [lindex [get_hw_targets] 1]}
        source {Xilinx UG835 2026.1}
    }
}
command delete_interface {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -all \
           -detail {Delete all ports, buses, or nested interfaces associated with the specified interface.}
