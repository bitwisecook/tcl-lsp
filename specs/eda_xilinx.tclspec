command get_primitives {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -part -takes part -detail {Get a list of primitives for the specified part.}
    option -retarget \
           -detail {Include primitive types that are automatically retargeted to the current or specified part.}
    option -macro \
           -detail {Include primitive types that always convert into more basic, natively supported primitives, such as logic gates.}
    option -hierarchy \
           -detail {Include primitive types that are automatically expanded into a hierarchy of leaf cells during implementation.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_primitives ?-regexp? ?-nocase? ?-filter expression? ?-part part? ?-retarget? ?-macro? ?-hierarchy? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of available unisim primitives for a part.}
        synopsis {get_primitives ?-regexp? ?-nocase? ?-filter expression? ?-part part? ?-retarget? ?-macro? ?-hierarchy? ?-quiet? ?-verbose? ?patterns?}
        description {Gets the supported primitives for the specified device, taking the part from an open elaborated, synthesized, or implemented design unless -part is given. By default only the native primitives that can be placed on the target part without modification are returned; -retarget, -macro, and -hierarchy each add further primitives to the list.}
        returns {A list of primitive types.}
        example {get_primitives -macro}
        source {Xilinx UG835 2026.1}
    }
}
