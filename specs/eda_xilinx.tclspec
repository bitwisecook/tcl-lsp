command wait_on_hw_ila {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -timeout -takes timeout \
           -detail {Wait this many minutes, given as a decimal value, for all data on the ILA debug cores to be captured before terminating the wait; by default there is no timeout.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {wait_on_hw_ila ?-timeout timeout? ?hw_ilas? ?-quiet? ?-verbose?}

    hover {
        summary {Wait until all hardware ILA data has been captured.}
        synopsis {wait_on_hw_ila ?-timeout timeout? ?hw_ilas? ?-quiet? ?-verbose?}
        description {Suspends Tcl script or Tcl command processing after run_hw_ila until the ILA debug core memory is filled by captured data samples, after which processing continues and the captured samples can be moved into a hw_ila_data object with upload_hw_ila_data. The hw_ila objects must be specified as objects returned by get_hw_ilas or current_hw_ila; without them the current_hw_ila is used.}
        returns {Nothing if successful; an error if it fails.}
        example {run_hw_ila hw_ila_1 -trigger_now 1
wait_on_hw_ila hw_ila_1
display_hw_ila_data [upload_hw_ila_data hw_ila_1]}
        source {Xilinx UG835 2026.1}
    }
}
command wait_on_hw_sio_scan {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -timeout -takes timeout \
           -detail {Wait this many minutes, given as a decimal value, for the serial I/O analyzer scan to complete before terminating the wait; by default there is no timeout.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {wait_on_hw_sio_scan ?-timeout timeout? hw_sio_scans ?-quiet? ?-verbose?}

    hover {
        summary {Wait until a hardware SIO scan has completed.}
        synopsis {wait_on_hw_sio_scan ?-timeout timeout? hw_sio_scans ?-quiet? ?-verbose?}
        description {Suspends a Tcl script or Tcl command processing after run_hw_sio_scan until the specified serial I/O analyzer scan is complete, after which processing continues. The hw_sio_scan objects must be specified as objects returned by create_hw_sio_scan or get_hw_sio_scans (required).}
        returns {Nothing if successful; an error if it fails.}
        example {run_hw_sio_scan [lindex [get_hw_sio_scans {SCAN_0}] 0]
wait_on_hw_sio_scan [lindex [get_hw_sio_scans {SCAN_0}] 0]}
        source {Xilinx UG835 2026.1}
    }
}
