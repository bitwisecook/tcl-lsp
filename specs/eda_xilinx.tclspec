}
command report_ip_status {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {The name to assign to the results when run in GUI mode.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -license_status \
           -detail {Limit the report to the requirements and state of the licenses for IP used in the design.}
    option -resource_data \
           -detail {Report the resource data usage for each IP instance in the design, obtained from the synthesis results.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_ip_status ?-name name? ?-file file_name? ?-append? ?-return_string? ?-license_status? ?-resource_data? ?-quiet? ?-verbose?}

    hover {
        summary {Report on the status of the IP instances in the project.}
        synopsis {report_ip_status ?-name name? ?-file file_name? ?-append? ?-return_string? ?-license_status? ?-resource_data? ?-quiet? ?-verbose?}
        description {Examines the IP cores in the current project and reports the state of each with regard to the latest IP catalog, giving the instance name, IP status, recommendation, lock status, change log reference, IP name, IP version, new version, new license, and original part. IP cores that are out of date or locked may need to be upgraded and their output products regenerated. The command also checks the available licenses on the local machine or license server for all IP cores in the project and prints whether a license was found.}
        returns {True for success.}
        example {report_ip_status -file C:/Data/reports/ip_status.txt -append}
        source {Xilinx UG835 2026.1}
    }
}
command report_methodology {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {The name to assign to the results when run in GUI mode.}
    option -cells -takes cells \
           -detail {The hierarchical modules to run the methodology checks on instead of the top cell, given by name or as objects returned by get_cells.}
    option -checks -takes checks \
           -detail {The rule checks to run against the current design, listed by group name or full key, which creates a temporary user-defined rule deck for the run.}
    option -file -takes file_name \
           -detail {Write the methodology report into the specified file, overwriting an existing file unless -append is also used.}
    option -rpx -takes file_name \
           -detail {Write an interactive report (RPX) file that can be reloaded into memory with open_report; a .rpx file extension should be given as the tool assigns none.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -waived \
           -detail {Run and report only the methodology checks waived by create_waiver, returning the actual violation rather than the waiver definition.}
    option -no_waivers \
           -detail {Ignore the waivers defined by create_waiver and report all methodology violations.}
    option -slack_lesser_than -takes slack \
           -detail {Report SYNTH methodology violations only when the calculated slack on a path is less than the specified value in ns, defaulting to 2.0.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -merge_exceptions -takes mode -values {auto true false} -closed \
           -detail {Allow or prevent the timing engine from merging timing exceptions, defaulting to auto, which leaves them unmerged when the tool estimates that the constraint complexity would cost significant runtime.}
    option -json -takes file_name \
           -detail {Write the results in JSON format to the specified file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_methodology ?-name name? ?-cells cells? ?-checks checks? ?-file file_name? ?-rpx file_name? ?-append? ?-waived? ?-no_waivers? ?-slack_lesser_than slack? ?-return_string? ?-merge_exceptions mode? ?-json file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Run methodology checks.}
        synopsis {report_methodology ?-name name? ?-cells cells? ?-checks checks? ?-file file_name? ?-rpx file_name? ?-append? ?-waived? ?-no_waivers? ?-slack_lesser_than slack? ?-return_string? ?-merge_exceptions mode? ?-json file_name? ?-quiet? ?-verbose?}
        description {Checks the current open design against a set of methodology checks and reports the errors or violations found. Methodology checks are a special class of design rule check reached through this separate command, and are a mandatory part of the design flow after implementation and before generating the bitstream. Violations are returned as Vivado objects that can be listed with get_methodology_violations and are associated with cells, pins, ports, nets, and sites. The methodology rule deck is run unless -checks names the checks, a rule whose IS_ENABLED property is false is skipped, and current results can be cleared with reset_methodology.}
        returns {A report of the violations found by the methodology checks.}
        example {report_methodology -file C:/Data/methodology_Rpt1.txt -append}
        source {Xilinx UG835 2026.1}
    }
}
