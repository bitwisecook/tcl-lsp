    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_speed_grade value ?-quiet? ?-verbose?}

    hover {
        summary {Set the speed grade used for timing analysis.}
        synopsis {set_speed_grade value ?-quiet? ?-verbose?}
        description {Sets the speed grade for the target device in the current design, for the purpose of timing analysis. It must be run on an opened Synthesized or Implemented Design, usually prior to report_timing or other timing commands. Valid values are -1, -2, or -3.}
        returns {String result.}
        example {set_speed_grade -1}
        source {Xilinx UG835 2012.2}
    }
}
command set_switching_activity {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -toggle_rate -takes rate \
           -detail {The rate at which the output of a synchronous logic element switches compared to a given clock input, modeled as a percentage between 0 and 200; must be specified with -static_probability.}
    option -default_toggle_rate -takes rate \
           -detail {The default toggle rate used in power analysis on the primary inputs whose switching activity is not otherwise specified, where 0 <= value < 200 and the default is 12.5; cannot be specified with objects.}
    option -type -takes type \
           -values {io_output io_bidir_enable register lut_ram lut dsp bram_enable bram_wr_enable gt_txdata gt_rxdata} -closed \
           -detail {Specify nodes in a specific category, valid only when setting -toggle_rate or -signal_rate.}
    option -all -detail {Used together with -type, set switching activity on -type nets within an instance.}
    option -static_probability -takes probability \
           -detail {Static probability value for the specified objects, where 0 <= value <= 1 and the default is 0.5.}
    option -default_static_probability -takes probability \
           -detail {The default static probability used in power analysis on the primary inputs whose switching activity is not otherwise specified, where 0 <= value <= 1 and the default is 0.5; cannot be specified with objects.}
    option -signal_rate -takes rate \
           -detail {The number of times an element changed state per second, expressed as millions of transitions per second, with a default of 0.0; must be specified with -static_probability.}
    option -hier \
           -detail {Hierarchically sets the switching activity on a hierarchical instance provided through the objects argument.}
    option -deassert_resets \
           -detail {Automatically de-assert all set, reset, preset, and clear signals that do not have conflicted polarities, by setting the signal static probability to 0.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_switching_activity ?-toggle_rate rate? ?-default_toggle_rate rate? ?-type type? ?-all? ?-static_probability probability? ?-default_static_probability probability? ?-signal_rate rate? ?-hier? ?-deassert_resets? ?-quiet? ?-verbose? ?objects?}

    hover {
        summary {Set switching activity on specified objects or default types.}
        synopsis {set_switching_activity ?-toggle_rate rate? ?-default_toggle_rate rate? ?-type type? ?-all? ?-static_probability probability? ?-default_static_probability probability? ?-signal_rate rate? ?-hier? ?-deassert_resets? ?-quiet? ?-verbose? ?objects?}
        description {Sets the signal rate and switching probability used when performing power estimation on the current synthesized or implemented design, including simple signal rate and static probability on nets, ports, and pins, and state dependent static probabilities on cells. The command can specify default activity rates for the whole design or define the activity of one or more signals or a specified module. Current attributes can be found with report_switching_activity and reset with reset_switching_activity; this command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {set_switching_activity -default_static_probability .75}
        source {Xilinx UG835 2026.1}
    }
}
command set_system_jitter {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_system_jitter ?-quiet? ?-verbose? system_jitter}

    hover {
        summary {Set system jitter.}
        synopsis {set_system_jitter ?-quiet? ?-verbose? system_jitter}
        description {Sets the system jitter, specified in nanoseconds with a value greater than or equal to 0, for all clocks in the design including primary and generated clocks, accounting for noise such as power supply and board noise that affects every clock in the FPGA. System jitter is a component of the Total System Jitter used in the calculation of clock uncertainty for a path. The default system jitter is technology-dependent and predefined for each FPGA family, and overriding it with this command is not recommended; use set_input_jitter to specify additional jitter for a specific primary clock.}
        returns {System_jitter.}
        example {create_clock -period 10 -name sysClk [get_ports sysClk]
set_system_jitter 0.1}
        source {Xilinx UG835 2026.1}
    }
}
command set_value {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -radix -takes radix -values {default dec bin oct hex unsigned ascii smag} -closed \
           -detail {Specifies the radix to use for interpreting the value, where dec indicates a signed decimal.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_value ?-radix radix? ?-quiet? ?-verbose? hdl_object value}

    hover {
        summary {Set the current value of an HDL object to a specified value.}
        synopsis {set_value ?-radix radix? ?-quiet? ?-verbose? hdl_object value}
        description {Specifies the value of a single HDL object, such as a variable, signal, wire, or reg, at the current simulation run time. The object can be given by name or returned by get_objects, and the accepted value depends on the object type: for logic types the value is interpreted with the given radix and is zero extended when too short, while for floating point, VHDL enumerated, and VHDL integral types the -radix option is ignored.}
        returns {Nothing.}
        example {set_value sysClk Z}
        source {Xilinx UG835 2026.1}
    }
}
command setup_pr_configurations {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -partitions -takes partition_pairs \
           -detail {A list of partition instance and reconfigurable module pairs, specified as partitionInstance:RM pairs.}
    option -use_netlist \
           -detail {Use the netlist for getting instances of partition_defs to create PR configurations.}
    option -force \
           -detail {Delete the active parent implementation run's PR configuration and its child runs and PR configurations, then create new PR configurations and runs.}
    option -run -takes run \
           -detail {Parent implementation run to which child implementation runs and PR configurations need to be created.}
    option -dfx_mode -takes mode \
           -detail {Specifies the Dynamic Function eXchange mode, either STANDARD, which takes the full design into consideration, or ABSTRACT SHELL, which uses the shell for a single reconfigurable partition; the default is STANDARD.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {setup_pr_configurations ?-partitions partition_pairs? ?-use_netlist? ?-force? ?-run run? ?-dfx_mode mode? ?-quiet? ?-verbose?}

    hover {
        summary {Create minimum PR configurations and child implementation runs automatically from the combination of partition instances and reconfigurable modules.}
        synopsis {setup_pr_configurations ?-partitions partition_pairs? ?-use_netlist? ?-force? ?-run run? ?-dfx_mode mode? ?-quiet? ?-verbose?}
        description {Automatically creates the minimum PR configurations and child implementation runs based on the combination of partition instances and reconfigurable modules. In the Dynamic Function eXchange design flow a PR configuration assigns a reconfigurable module to a specific instance of a partition definition, and implementing each configuration produces partial bitstreams for the modules and complete bitstreams for each integrated configuration.}
        returns {Nothing.}
        example {setup_pr_configurations}
        source {Xilinx UG835 2026.1}
    }
}
command show_objects {
