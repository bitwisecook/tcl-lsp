    option -grade -detail {Report the temperature grade of the target device.}
    option -process \
           -detail {Report the manufacturing process characteristics to be assumed.}
    option -junction_temp \
           -detail {Report the device junction temperature used for modeling.}
    option -ambient_temp -detail {Report the environment ambient temperature.}
    option -thetaja \
           -detail {Report the Theta-JA thermal resistance used for modeling.}
    option -thetasa \
           -detail {Report the Theta-SA thermal resistance used for modeling.}
    option -airflow \
           -detail {Report the linear feet per minute airflow to be used for modeling.}
    option -heatsink -detail {Report the heatsink type to be used for modeling.}
    option -thetajb \
           -detail {Report the Theta-JB thermal resistance used for modeling.}
    option -board -detail {Report the board size to be used for modeling.}
    option -board_temp \
           -detail {Report the board temperature in degrees Centigrade to be used for modeling.}
    option -board_layers \
           -detail {Report the number of board layers to be used for modeling.}
    option -design_power_budget \
           -detail {Report the design power budget in Watts, which report_power uses to report the difference between the calculated on-chip power and the budget.}
    option -all \
           -detail {Report the current values of all operating conditions rather than each condition separately.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -supply_current_budget -takes supplies \
           -detail {Report the list of supply name and current budget pairs; the supported voltage supplies vary by family.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_operating_conditions ?-voltage voltage_supplies? ?-voltage_range voltage_supplies? ?-grade? ?-process? ?-junction_temp? ?-ambient_temp? ?-thetaja? ?-thetasa? ?-airflow? ?-heatsink? ?-thetajb? ?-board? ?-board_temp? ?-board_layers? ?-design_power_budget? ?-all? ?-file file_name? ?-return_string? ?-append? ?-supply_current_budget supplies? ?-quiet? ?-verbose?}

    hover {
        summary {Get operating conditions values for power estimation.}
        synopsis {report_operating_conditions ?-voltage voltage_supplies? ?-voltage_range voltage_supplies? ?-grade? ?-process? ?-junction_temp? ?-ambient_temp? ?-thetaja? ?-thetasa? ?-airflow? ?-heatsink? ?-thetajb? ?-board? ?-board_temp? ?-board_layers? ?-design_power_budget? ?-all? ?-file file_name? ?-return_string? ?-append? ?-supply_current_budget supplies? ?-quiet? ?-verbose?}
        description {Displays the real-world operating conditions used when performing analysis of the design, whose values can be defined with set_operating_conditions. The environmental operating conditions of the device are used for power analysis when running report_power, but are not used during timing analysis. By default the report is written to the Tcl console or standard output, but it can also be written to a file or returned as a string.}
        returns {The operating conditions report.}
        example {report_operating_conditions -voltage_range {VCCINT VCCAUX}}
        source {Xilinx UG835 2026.1}
    }
}
