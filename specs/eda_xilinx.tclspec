}
command write_debug_probes {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -cell -takes cell \
           -detail {The hierarchical name of a reconfigurable partition cell to export a partial probe file for.}
    option -no_partial_ltxfile -detail {Do not generate partial LTX files.}
    option -force -detail {Overwrite the specified file if it already exists.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_debug_probes ?-cell cell? ?-no_partial_ltxfile? ?-force? file ?-quiet? ?-verbose?}

    hover {
        summary {Write debug probes to a file.}
        synopsis {write_debug_probes ?-cell cell? ?-no_partial_ltxfile? ?-force? file ?-quiet? ?-verbose?}
        description {Writes a Vivado logic analyzer probes file, typically with a .ltx extension, containing the ILA debug cores and signal probes added to the current design by create_debug_core, create_debug_port, and connect_debug_port.}
        returns {Name of the output file.}
        example {write_debug_probes C:/Data/designProbes.ltx}
        source {Xilinx UG835 2026.1}
    }
}
command write_device_image {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite an existing file.}
    option -raw_partitions -detail {Write raw CFI and NPI partition files (.rcfi and .rnpi).}
    option -mask_file -detail {Write a mask file (.msk_cfi).}
    option -logic_location_file -detail {Write a logic location file (.ll).}
    option -compact_logic_location_file \
           -detail {Write a compact logic location file and static RAM bitmap files.}
    option -cell -takes cell \
           -detail {Create only a partial device image for this named cell.}
    option -no_pdi -detail {Do not generate the PDI file.}
    option -no_partial_pdifile \
           -detail {Do not write partial PDI files for a Dynamic Function eXchange design.}
    option -save_state -detail {Save the state of the device image writer in the given file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Print the write_device_image options.}

    option_conflict {-logic_location_file -compact_logic_location_file}

    form Default {write_device_image ?-force? ?-raw_partitions? ?-mask_file? ?-logic_location_file? ?-compact_logic_location_file? ?-cell cell? ?-no_pdi? ?-no_partial_pdifile? ?-save_state? file ?-quiet? ?-verbose?}

    hover {
        summary {Write a programmable device image.}
        synopsis {write_device_image ?-force? ?-raw_partitions? ?-mask_file? ?-logic_location_file? ?-compact_logic_location_file? ?-cell cell? ?-no_pdi? ?-no_partial_pdifile? ?-save_state? file ?-quiet? ?-verbose?}
        description {Writes the programmable device image (PDI) for the current design, optionally alongside raw CFI and NPI partition files, a mask file, and a logic location file. If an extension is included on the file name, the only allowed extension is .pdi.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command write_edif {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -pblocks -takes pblocks \
           -detail {Output the contents of these Pblocks as separate EDIF netlist files, which can be added as design source files to netlist projects but are not intended to be read in with update_design.}
    option -cell -takes cell \
           -detail {Output the contents of this hierarchical cell as EDIF netlist files, for use with update_design; only one cell can be specified.}
    option -force -detail {Overwrite the EDIF file if it already exists.}
    option -security_mode -takes security_mode -values {multifile all} -closed \
           -detail {Write multiple EDIF files when encrypted IP is found in the design (multifile, the default), or write both encrypted and unencrypted cells to a single file (all).}
    option -logic_function_stripped \
           -detail {Convert the INIT strings on LUTs and block RAMs to fixed values, creating a netlist for debug purposes that will not behave properly in simulation or synthesis.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-pblocks -cell}

    form Default {write_edif ?-pblocks pblocks? ?-cell cell? ?-force? ?-security_mode security_mode? ?-logic_function_stripped? file ?-quiet? ?-verbose?}

    hover {
        summary {Export the current netlist as an EDIF file.}
        synopsis {write_edif ?-pblocks pblocks? ?-cell cell? ?-force? ?-security_mode security_mode? ?-logic_function_stripped? file ?-quiet? ?-verbose?}
        description {Writes the current netlist as an EDIF file, or outputs the contents of specific Pblocks or hierarchical cells as EDIF netlist files. When -pblocks or -cell is used the file argument names a directory that must already exist, and each output file is named after the Pblock or cell it holds. The default file extension for an EDIF netlist is .edn.}
        returns {The name of the output file or directory.}
        example {write_edif C:/Data/edifOut.edn}
        source {Xilinx UG835 2026.1}
    }
}
command write_hw_ila_data {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite an existing file of the same name.}
    option -csv_file \
           -detail {Export the ILA data as a comma separated values (CSV) file only, rather than the default binary ILA file format.}
    option -vcd_file \
           -detail {Export the ILA data as a value change dump (VCD) file only, rather than the default binary ILA file format.}
    option -legacy_csv_file -detail {Export a CSV file without radix information.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_hw_ila_data ?-force? ?-csv_file? ?-vcd_file? ?-legacy_csv_file? file ?hw_ila_data? ?-quiet? ?-verbose?}

    hover {
        summary {Write hardware ILA data to a file.}
        synopsis {write_hw_ila_data ?-force? ?-csv_file? ?-vcd_file? ?-legacy_csv_file? file ?hw_ila_data? ?-quiet? ?-verbose?}
        description {Writes the ILA debug core sample data stored in the specified hw_ila_data object to a file on disk for later review, and the data can be read back into the Vivado logic analyzer with read_hw_ila_data. The hw_ila_data object must be specified as an object returned by get_hw_ila_datas or current_hw_ila_data; without one the current hw_ila_data is written. The default extension is .ila, or .csv with -csv_file and .vcd with -vcd_file.}
        returns {Name of the output file.}
        example {write_hw_ila_data -force design1_ila_data [upload_hw_ila_data hw_ila_1]}
        source {Xilinx UG835 2026.1}
    }
}
command write_hw_platform {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fixed \
           -detail {Write a fixed shell XSA, which enables the platform for use in the software development flow but not for acceleration.}
    option -force -detail {Overwrite the XSA file if it already exists.}
    option -include_bit \
           -detail {Include the bitstream for the current design in the shell, which is otherwise discarded in favor of MCS files.}
    option -include_bin -detail {Include bin files in the shell.}
    option -include_sim_content \
           -detail {Export the data needed to support hardware emulation while creating the XSA, which requires special features of the hardware platform.}
    option -minimal \
           -detail {Include only the files required to run the Vitis flow, ignoring other options that add content to the XSA.}
    option -hw -detail {Write a shell that can only be used in a hardware only platform.}
    option -hw_emu -detail {Write a shell that can only be used in a hardware emulation only platform.}
    option -rp -takes instance_path \
           -detail {Write the shell for the reconfigurable module at this instance path, with the specific module selected by the active configuration or by -rm; valid for Versal designs only.}
    option -rm -takes module_name \
           -detail {The name of a reconfigurable module for use with -rp; valid for Versal designs only.}
    option -static \
           -detail {Write the shell for the static portion of a DFX design; valid for Versal designs only.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_hw_platform ?-fixed? ?-force? ?-include_bit? ?-include_bin? ?-include_sim_content? ?-minimal? ?-hw? ?-hw_emu? ?-rp instance_path? ?-rm module_name? ?-static? ?file? ?-quiet? ?-verbose?}

    hover {
        summary {Write the Xilinx Shell Archive for the current design.}
        synopsis {write_hw_platform ?-fixed? ?-force? ?-include_bit? ?-include_bin? ?-include_sim_content? ?-minimal? ?-hw? ?-hw_emu? ?-rp instance_path? ?-rm module_name? ?-static? ?file? ?-quiet? ?-verbose?}
        description {Writes a Xilinx support archive (XSA) of the current design for use as a hardware platform. The design used to create an XSA is an IP integrator subsystem design with the required board interface IP cores configured and connected to the device I/Os, and the project must also carry the required XSA and PFM properties. The file name uses alphanumeric characters and the .xsa extension.}
        returns {The name of the Shell file.}
        example {write_hw_platform -force C:/Data/vck190.xsa}
        source {Xilinx UG835 2026.1}
    }
}
command write_hw_platform_metadata {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_hw_platform_metadata ?file? ?-quiet? ?-verbose?}

    hover {
        summary {Write the unified JSON metadata file for the current design.}
        synopsis {write_hw_platform_metadata ?file? ?-quiet? ?-verbose?}
        description {Writes a JSON metadata file for the platform represented by the current design. The file name must use the .json extension, and if no path is given the file is written into the current working directory.}
        returns {The name of the unified JSON metadata file.}
        example {write_hw_platform_metadata C:/Data/zc102_platform.json}
        source {Xilinx UG835 2026.1}
    }
}
command write_hw_sio_scan {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -force -detail {Overwrite the specified file if it already exists.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_hw_sio_scan ?-force? file hw_sio_scan ?-quiet? ?-verbose?}

    hover {
        summary {Write hardware SIO scan data to a file.}
        synopsis {write_hw_sio_scan ?-force? file hw_sio_scan ?-quiet? ?-verbose?}
        description {Writes the hw_sio_scan object populated by run_hw_sio_scan to disk as a CSV file of the values observed while running the scan, which is useful when analyzing the margin of a link with the Eye Scan hardware of UltraScale devices or 7 series FPGAs. The hw_sio_scan must be specified as an object returned by get_hw_sio_scans, and a default suffix of .csv is assigned if none is given.}
        returns {Name of the output file.}
        example {write_hw_sio_scan -force C:/Data/Vivado_Debug/LoopBack_1.csv \
[get_hw_sio_scans {SCAN_3}]}
        source {Xilinx UG835 2026.1}
    }
}
