        summary {Legacy: reset a run to its initial state.}
        synopsis {reset_run run_name}
        source {F5}
    }
}
command reset_runs {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -prev_step -detail {Reset the last run step.}
    option -from_step -takes step -detail {First step to reset.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_runs ?-prev_step? ?-from_step step? ?-quiet? ?-verbose? runs}

    hover {
        summary {Reset existing runs.}
        synopsis {reset_runs ?-prev_step? ?-from_step step? ?-quiet? ?-verbose? runs}
        description {Resets the specified existing runs, optionally only the last run step or every step from the named step onward.}
        source {Xilinx UG835 2026.1}
    }
}
command reset_simulation {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -mode -takes mode \
           -values {behavioral post-synthesis post-implementation} -closed \
           -detail {Simulation mode whose generated data is removed, defaulting to behavioral.}
    option -type -takes type -values {functional timing} -closed \
           -detail {Remove the data for functional simulation of just the netlist or timing simulation of the netlist and SDF file, and cannot be used with -mode behavioral.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_simulation ?-mode mode? ?-type type? ?-quiet? ?-verbose? ?simset?}

    hover {
        summary {Reset an existing simulation run.}
        synopsis {reset_simulation ?-mode mode? ?-type type? ?-quiet? ?-verbose? ?simset?}
        description {Resets the current simulation to its starting condition by cleaning out the output files created during compilation and simulation for the specified simulation fileset, which defaults to sim_1; local files are removed from the project simulation folders without warning. Post-synthesis timing simulation uses SDF component delays from synth_design, and post-implementation timing simulation uses SDF delays from place_design and route_design.}
        returns {Nothing.}
        example {reset_simulation -mode post-synthesis -type timing sim_2}
        source {Xilinx UG835 2026.1}
    }
}
command reset_ssn {
    available {tcl 8.5}
