command report_config_timing {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -name -takes name \
           -detail {Output the results to the GUI panel with this name.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -all \
           -detail {Report the state of all timing related attributes and constraints in the design rather than the limited set of important settings.}
    option -no_header \
           -detail {Do not generate the report header, which otherwise lists the report type, design, part, version, date, and command.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_config_timing ?-file file_name? ?-append? ?-name name? ?-return_string? ?-all? ?-no_header? ?-quiet? ?-verbose?}

    hover {
        summary {Report settings affecting timing analysis.}
        synopsis {report_config_timing ?-file file_name? ?-append? ?-name name? ?-return_string? ?-all? ?-no_header? ?-quiet? ?-verbose?}
        description {Reports the configuration of timing constraints of the current design. By default the report is abbreviated, containing only a few key timing constraints; use the -all argument to return all timing related configuration.}
        returns {Nothing.}
        example {set timeConfig [report_config_timing -all -no_header -return_string]
puts $timeConfig}
        source {Xilinx UG835 2012.2}
    }
}
command report_control_sets {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -file -takes file \
           -detail {Write the report into the specified file, overwriting an existing file of that name.}
    option -append -detail {Append the report to the existing file rather than overwriting it.}
    option -sort_by -takes criteria -values {clk clkEn set} -closed \
           -detail {Sort the detailed report produced by -verbose according to the specified criteria.}
    option -cells -takes cells \
           -detail {Report control sets for the specified cell or bel_instance objects.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose \
           -detail {Provide a detailed report listing all control sets and suspend message limits during command execution.}

    form Default {report_control_sets ?-file file? ?-append? ?-sort_by criteria? ?-cells cells? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report the unique control sets in the design.}
        synopsis {report_control_sets ?-file file? ?-append? ?-sort_by criteria? ?-cells cells? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports the control sets of the current design, where a control set is the collection of control signals (Clock, CE, SR) for slice registers and LUTs; registers must belong to the same control set to be packed into the same device resource, and a high number of control sets can make the design difficult to fit and cause routing congestion and timing issues. By default an abbreviated report giving only the number of unique control sets is returned, while -verbose returns a detailed report of all control sets for the whole design or for the specified cells.}
        returns {Report.}
        example {report_control_sets -verbose -sort_by {clk clkEn}}
        source {Xilinx UG835 2012.2}
    }
}
command report_datasheet {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -significant_digits -takes digits \
           -detail {Number of digits to display, from 0 to 13, defaulting to 3.}
    option -file -takes file \
           -detail {Write the report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the report to the specified file rather than overwriting it (only with -file).}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -sort_by -takes order -values {clock port} -closed \
           -detail {Sorting order of the report, defaulting to clock.}
    option -show_all_corners -detail {Report all process corners.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_datasheet ?-significant_digits digits? ?-file file? ?-append? ?-return_string? ?-sort_by order? ?-show_all_corners? ?-quiet? ?-verbose?}

    hover {
        summary {Report the data sheet of the current design.}
        synopsis {report_datasheet ?-significant_digits digits? ?-file file? ?-append? ?-return_string? ?-sort_by order? ?-show_all_corners? ?-quiet? ?-verbose?}
        description {Creates a datasheet report giving the timing characteristics of the current design at the I/O pads, similar to what is reported in the .twr file: setup and hold times of input I/Os in relation to clocks, max and min delays from clocks to output pads, and skews of input and output buses.}
        returns {Nothing.}
        example {report_datasheet -sort_by port -show_all_corners}
        source {Xilinx UG835 2012.2}
    }
}
command report_debug_core {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -file -takes file \
