command report_operating_conditions {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -voltage -takes supplies \
           -detail {Report the list of voltage pairs, where the supported voltage supplies vary by family.}
    option -grade -detail {Report the temperature grade of the target device.}
    option -process -detail {Report the manufacturing process characteristics to be assumed.}
    option -junction_temp -detail {Report the device junction temperature used for modeling.}
    option -ambient_temp -detail {Report the environment ambient temperature.}
    option -thetaja -detail {Report the Theta-JA thermal resistance used for modeling.}
    option -thetasa -detail {Report the Theta-SA thermal resistance used for modeling.}
    option -airflow \
           -detail {Report the Linear Feet Per Minute (LFM) airflow to be used for modeling.}
    option -heatsink -detail {Report the heatsink type to be used for modeling.}
    option -thetajb -detail {Report the Theta-JB thermal resistance used for modeling.}
    option -board -detail {Report the board size to be used for modeling.}
    option -board_temp \
           -detail {Report the board temperature in degrees Centigrade to be used for modeling.}
    option -board_layers -detail {Report the number of board layers to be used for modeling.}
    option -all \
           -detail {Report the current values of all operating conditions rather than each condition separately.}
    option -file -takes file -detail {Write the report into the specified file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_operating_conditions ?-voltage supplies? ?-grade? ?-process? ?-junction_temp? ?-ambient_temp? ?-thetaja? ?-thetasa? ?-airflow? ?-heatsink? ?-thetajb? ?-board? ?-board_temp? ?-board_layers? ?-all? ?-file file? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Get operating conditions values for power estimation.}
        synopsis {report_operating_conditions ?-voltage supplies? ?-grade? ?-process? ?-junction_temp? ?-ambient_temp? ?-thetaja? ?-thetasa? ?-airflow? ?-heatsink? ?-thetajb? ?-board? ?-board_temp? ?-board_layers? ?-all? ?-file file? ?-return_string? ?-quiet? ?-verbose?}
        description {Displays the real-world operating conditions used when analyzing the design. The environmental operating conditions of the device are used for power analysis when running report_power but are not used during timing analysis, and their values are defined by the set_operating_conditions command.}
        returns {Nothing.}
        example {report_operating_conditions -grade -junction_temp -return_string -file \
~/conditions.txt}
        source {Xilinx UG835 2012.2}
    }
}
