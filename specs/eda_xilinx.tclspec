command delete_timing_results {
    dialects tcl8.5
    required_package vivado

    arity 1..

    ;# NOTE(xilinx): the Usage table spells the fifth value min_pulse_width while
    ;# the Arguments prose spells it pulse_width; the Usage "Values:" list is used
    ;# here. The section's example also passes the report name as -name, which the
    ;# Syntax line records as a positional argument.
    option -type -takes type \
           -values {timing_path slack_histogram clock_interaction check_timing min_pulse_width timing_summary} -closed \
           -detail {Type of timing results to clear; the default is timing_path, which deletes reports generated by report_timing.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_timing_results ?-type type? ?-quiet? ?-verbose? name}

    hover {
        summary {Clear a set of timing results from memory.}
        synopsis {delete_timing_results ?-type type? ?-quiet? ?-verbose? name}
        description {Clears the specified timing results from the named result set. Both the type of the timing report and the name of the timing report must be specified, or the command fails.}
        returns {Nothing.}
        example {delete_timing_results -type clock_interaction -name clkNets}
        source {Xilinx UG835 2012.2}
    }
}
