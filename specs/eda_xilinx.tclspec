command write_project_tcl {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -paths_relative_to -takes reference_directory \
           -detail {Override the reference directory variable used for the relative paths of source files, defaulting to the script output directory path.}
    option -origin_dir_override -takes origin_dir \
           -detail {Set the origin_dir directory variable to this value, defaulting to the value given with -paths_relative_to.}
    option -ip_repo_path -takes ip_repo_dir -detail {Set ip_repo_dir to this value.}
    option -target_proj_dir -takes target_proj_dir \
           -detail {The directory where the project is to be restored, defaulting to the current project directory path.}
    option -force -detail {Overwrite an existing project script file of the same name.}
    option -all_properties \
           -detail {Write all properties, both default and non-default, for the project objects; by default only non-default properties are written.}
    option -no_copy_sources \
           -detail {Do not import sources even if they were local in the original project, which requires -use_bd_files for designs containing block diagrams.}
    option -absolute_remote_path -detail {Write remote sources with absolute paths.}
    option -no_ip_version \
           -detail {Do not include the IP version as part of the IP VLNV in the create_bd_cell commands.}
    option -absolute_path \
           -detail {Make all file paths absolute with regard to the original project directory.}
    option -dump_project_info \
           -detail {Write files holding the current values of all objects in the design and their default values, to aid in debugging the recreated project.}
    option -use_bd_files \
           -detail {Use the block design sources directly instead of writing out procs to recreate them, so that they are copied or referenced like other design sources.}
    option -no_bd_xlnoc -detail {Do not create the block design xlnoc cell.}
    option -internal -detail {Print basic header information in the generated Tcl script.}
    option -validate \
           -detail {Run a validate script before recreating the project, to test whether the files and paths referenced in the Tcl file exist.}
    option -ignore_msg_control_rules \
           -detail {Do not import the message control rules into the Tcl script.}
    option -quiet -detail {Ignore command errors.}
    option -ignore_utils -detail {Ignore the util filesets.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_project_tcl ?-paths_relative_to reference_directory? ?-origin_dir_override origin_dir? ?-ip_repo_path ip_repo_dir? ?-target_proj_dir target_proj_dir? ?-force? ?-all_properties? ?-no_copy_sources? ?-absolute_remote_path? ?-no_ip_version? ?-absolute_path? ?-dump_project_info? ?-use_bd_files? ?-no_bd_xlnoc? ?-internal? ?-validate? ?-ignore_msg_control_rules? ?-ignore_utils? file ?-quiet? ?-verbose?}

    hover {
        summary {Export a Tcl script for re-creating the current project.}
        synopsis {write_project_tcl ?-paths_relative_to reference_directory? ?-origin_dir_override origin_dir? ?-ip_repo_path ip_repo_dir? ?-target_proj_dir target_proj_dir? ?-force? ?-all_properties? ?-no_copy_sources? ?-absolute_remote_path? ?-no_ip_version? ?-absolute_path? ?-dump_project_info? ?-use_bd_files? ?-no_bd_xlnoc? ?-internal? ?-validate? ?-ignore_msg_control_rules? ?-ignore_utils? file ?-quiet? ?-verbose?}
        description {A user-written application that creates a Tcl script to recreate the current project, containing the commands for creating the project, setting the project type, creating filesets, adding or importing source files, and defining runs and run properties. The new project is created in the working directory the generated script is sourced from, so source it from the directory it was created in or set the origin_dir variable to the alternate directory to keep the relative paths to the source files valid. An extension of .tcl is applied if none is supplied.}
        returns {True (0) if success, false (1) otherwise.}
        example {write_project_tcl recreate.tcl}
        source {Xilinx UG835 2026.1}
    }
}
command write_qor_suggestions {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -strategy_dir -takes strategy_dir \
           -detail {A directory in which one set of RQS and Tcl files is created for each suggested implementation strategy based on machine learning.}
    option -tcl_output_dir -takes tcl_output_dir \
           -detail {A directory in which Tcl scripts containing the XDC commands for the property based suggestions are created.}
    option -force -detail {Overwrite the specified file if it already exists.}
    option -of_objects -takes qor_suggestions \
           -detail {Write these QoR suggestion objects, as returned by get_qor_suggestions; without this option all suggestions are written.}
    option -disable_dont_touch \
           -detail {Allow suggestions that reset the DONT_TOUCH property, which may lead to slightly lower MTBF and to signals no longer being available.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_qor_suggestions ?-strategy_dir strategy_dir? ?-tcl_output_dir tcl_output_dir? ?-force? ?-of_objects qor_suggestions? ?-disable_dont_touch? file ?-quiet? ?-verbose?}

    hover {
        summary {Write QoR suggestions to the given file.}
        synopsis {write_qor_suggestions ?-strategy_dir strategy_dir? ?-tcl_output_dir tcl_output_dir? ?-force? ?-of_objects qor_suggestions? ?-disable_dont_touch? file ?-quiet? ?-verbose?}
        description {Writes the QoR suggestions generated by report_qor_suggestions, optionally combined with suggestions brought in by read_qor_suggestions so that all suggestions are managed in a single RQS file. With -strategy_dir, multiple Tcl files and one RQS file are written per strategy and the main RQS file should not be used, because the suggestions live in the run specific files along with the strategy information. At least one of -strategy_dir, -tcl_output_dir, or a file must be given, and the default extension is .rqs.}
        returns {The name of the output file created; an error if it fails.}
        example {report_qor_suggestions
write_qor_suggestions C:/Data/qor_results.rqs}
        source {Xilinx UG835 2026.1}
    }
}
command write_schematic {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite the specified schematic file if it already exists.}
    ;# NOTE(xilinx): the Usage table lists native and pdf while the Arguments
    ;# prose also lists svg, so the value set is left open here.
    option -format -takes format -values {native pdf svg} \
           -detail {The output file format, defaulting to native, which read_schematic can read back into the tool; svg is scalable vector graphics and pdf is portable document format, and the value is case sensitive.}
    option -orientation -takes orientation -values {landscape portrait} -closed \
           -detail {Write the schematic in a horizontal (landscape) or vertical (portrait) orientation, defaulting to portrait.}
    option -scope -takes scope -values {current_page visible all} -closed \
           -detail {Write the current page of the schematic, the content displayed in the schematic window, or all of the schematic, defaulting to current_page.}
    option -name -takes name \
           -detail {The title of the open schematic window to write, used when more than one schematic window is open; without it the first opened window is written.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_schematic ?-force? ?-format format? ?-orientation orientation? ?-scope scope? ?-name name? file ?-quiet? ?-verbose?}

    hover {
        summary {Export a schematic window to a file.}
        synopsis {write_schematic ?-force? ?-format format? ?-orientation orientation? ?-scope scope? ?-name name? file ?-quiet? ?-verbose?}
        description {Outputs the currently opened, or the specified, schematic window in the Vivado IDE to a file, either as a native ASCII file that read_schematic can read back or as a PDF or SVG file for use outside the Vivado Design Suite, which is useful when documenting IP cores from the IP packager flow or from the IP integrator.}
        returns {Name of the output file.}
        example {write_schematic -name Schematic C:/Data/mySchematic.txt -force}
        source {Xilinx UG835 2026.1}
    }
}
command write_sdf {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -process_corner -takes process_corner -values {slow fast} -closed \
           -detail {The process corner to write delays for, where delays are greater in the slow corner, which is the default, than in the fast corner.}
    option -cell -takes cell \
           -detail {The root of the design hierarchy to write, defaulting to the whole design.}
    option -filter_cell -takes filter_cell \
           -detail {Confine the SDF instances to those contained within this hierarchical cell and to nets with at least one pin within it, defaulting to the whole design.}
    option -rename_top -takes rename_top \
           -detail {Replace the name of the top module in the output with this custom name.}
    option -force -detail {Overwrite an existing SDF file of the same name.}
    option -mode -takes mode -values {timesim sta} -closed \
           -detail {Write the SDF file for timing simulation (timesim, the default) or for static timing analysis (sta).}
    option -gzip -detail {Write a gzipped SDF file.}
    option -multithread -takes threads \
           -detail {Run in multithread mode with this number of threads, defaulting to -1.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_sdf ?-process_corner process_corner? ?-cell cell? ?-filter_cell filter_cell? ?-rename_top rename_top? ?-force? ?-mode mode? ?-gzip? ?-multithread threads? file ?-quiet? ?-verbose?}

    hover {
        summary {Generate flat SDF delay files for event simulation.}
        synopsis {write_sdf ?-process_corner process_corner? ?-cell cell? ?-filter_cell filter_cell? ?-rename_top rename_top? ?-force? ?-mode mode? ?-gzip? ?-multithread threads? file ?-quiet? ?-verbose?}
        description {Writes the timing delays for cells in the design to a Standard Delay Format (SDF) file. The output file is referenced from a Verilog netlist through the -sdf_anno and -sdf_file arguments of write_verilog, for static timing analysis and timing simulation.}
        returns {Nothing.}
        example {write_sdf C:/Data/FPGA_Design/designOut.sdf}
        source {Xilinx UG835 2026.1}
    }
}
command write_verilog {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -cell -takes cell \
           -detail {Write the Verilog netlist from this cell or block level of the design hierarchy, defaulting to the whole design.}
    option -mode -takes mode \
           -values {design pin_planning synth_stub sta funcsim timesim} -closed \
           -detail {The mode to write the Verilog file in, defaulting to design, which is a snapshot of the whole design including post placement, implementation, and routing information.}
    option -lib -detail {Write each library used by the design into a separate file, which is only meaningful for simulation.}
    option -port_diff_buffers \
           -detail {Add the differential pair buffers and their internal wires to the output port list, valid only with -mode pin_planning or -mode synth_stub.}
    ;# NOTE(xilinx): the Syntax line and Usage table spell -write_all_overrides as
    ;# a flag while the Arguments prose shows a true/false value; the flag
    ;# reading is used here.
    option -write_all_overrides \
           -detail {Write the parameter overrides on Xilinx primitives even when the override value is the same as the primitive default, which makes the output more verbose without changing the result.}
    option -keep_vcc_gnd \
           -detail {Preserve the VCC and GND primitives instead of replacing them and the nets they drive with literal constants on each load terminal, for simulation modes only.}
    option -rename_top -takes rename_top \
           -detail {Replace the top module name in the output with this custom name, which works only with -mode funcsim or -mode timesim.}
    option -sdf_anno -takes sdf_anno -values {true false} \
           -detail {Add the sdf_annotate system task statement to the Verilog netlist, which works only with -mode timesim and is false by default.}
    option -sdf_file -takes sdf_file \
           -detail {The path and file name of the SDF file named by the sdf_annotate statement, defaulting to the Verilog output name with an .sdf extension; the SDF file itself is written separately with write_sdf.}
    option -force -detail {Overwrite the Verilog files if they already exist.}
    option -include_xilinx_libs \
           -detail {Write the simulation models directly into the output netlist instead of linking to the libraries by reference.}
    option -logic_function_stripped \
           -detail {Convert the INIT strings on LUTs and block RAMs to fixed values, creating a netlist for debug purposes that will not behave properly in simulation or synthesis.}
    option -skip_clock_attributes \
           -detail {Omit the special synthesis directive normally written for clock signals in synth_stub mode, treating those module terminals as regular terminals.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_verilog ?-cell cell? ?-mode mode? ?-lib? ?-port_diff_buffers? ?-write_all_overrides? ?-keep_vcc_gnd? ?-rename_top rename_top? ?-sdf_anno sdf_anno? ?-sdf_file sdf_file? ?-force? ?-include_xilinx_libs? ?-logic_function_stripped? ?-skip_clock_attributes? file ?-quiet? ?-verbose?}

    hover {
        summary {Export the current netlist in Verilog format.}
        synopsis {write_verilog ?-cell cell? ?-mode mode? ?-lib? ?-port_diff_buffers? ?-write_all_overrides? ?-keep_vcc_gnd? ?-rename_top rename_top? ?-sdf_anno sdf_anno? ?-sdf_file sdf_file? ?-force? ?-include_xilinx_libs? ?-logic_function_stripped? ?-skip_clock_attributes? file ?-quiet? ?-verbose?}
        description {Writes a Verilog netlist of the current design, or of a specific cell, to the specified file or directory as an IEEE 1364-2001 compliant Verilog HDL file containing the netlist information obtained from the input design files. The output can be a complete netlist, a port list for pin planning or a synthesis stub, or a netlist for static timing analysis, functional simulation, or timing simulation.}
        returns {The name of the output file or directory.}
        example {write_verilog C:/Data/my_verilog.v}
        source {Xilinx UG835 2026.1}
    }
}
command write_vhdl {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -cell -takes cell \
           -detail {Write the VHDL netlist from this cell or block level of the design hierarchy, defaulting to the whole design.}
    option -mode -takes mode -values {funcsim pin_planning synth_stub} -closed \
           -detail {The mode to write the VHDL file in, defaulting to funcsim, a functional simulation model that is not suitable for synthesis.}
    option -lib -detail {Write each library used by the design into a separate file.}
    option -port_diff_buffers \
           -detail {Add the differential pair buffers and their internal wires to the output port list, valid only with -mode pin_planning or -mode synth_stub.}
    ;# NOTE(xilinx): the Syntax line and Usage table spell -write_all_overrides as
    ;# a flag while the Arguments prose shows a true/false value; the flag
    ;# reading is used here.
    option -write_all_overrides \
           -detail {Write the parameter overrides in the design even when the value is the same as the primitive default, which makes the output more verbose without changing the result.}
    option -keep_vcc_gnd \
           -detail {Preserve the VCC and GND primitives instead of replacing them and the nets they drive with literal constants on each load terminal, for simulation modes only.}
    option -rename_top -takes rename_top \
           -detail {Replace the top module name in the output with this custom name, which works only with -mode funcsim.}
    option -arch_only \
           -detail {Suppress the entity definition of the top module and output the architecture only, simplifying use with a separate test bench.}
    option -force -detail {Overwrite the VHDL files if they already exist.}
    option -include_xilinx_libs \
           -detail {Write the simulation models directly into the output netlist instead of linking to the libraries by reference.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_vhdl ?-cell cell? ?-mode mode? ?-lib? ?-port_diff_buffers? ?-write_all_overrides? ?-keep_vcc_gnd? ?-rename_top rename_top? ?-arch_only? ?-force? ?-include_xilinx_libs? file ?-quiet? ?-verbose?}

    hover {
        summary {Export the current netlist in VHDL format.}
        synopsis {write_vhdl ?-cell cell? ?-mode mode? ?-lib? ?-port_diff_buffers? ?-write_all_overrides? ?-keep_vcc_gnd? ?-rename_top rename_top? ?-arch_only? ?-force? ?-include_xilinx_libs? file ?-quiet? ?-verbose?}
        description {Writes a VHDL netlist of the current design, or of a specific cell, to the specified file or directory as a VHDL IEEE 1076.4 VITAL-2000 compliant file containing the netlist information obtained from the input design files. If the file name has neither a .vhd nor a .vhdl extension the name is taken as a directory, and the file is named after the top module.}
        returns {The name of the output file or directory.}
        example {write_vhdl C:/Data/bft_top.vhd}
        source {Xilinx UG835 2026.1}
    }
}
command write_waivers {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table lists ALL, DRC, METHODOLOGY, CDC and LINT
    ;# while the Arguments prose says only DRC, METHODOLOGY and CDC are
    ;# currently supported, so the value set is left open here.
    option -type -takes type -values {ALL DRC METHODOLOGY CDC LINT} \
           -detail {The type of waivers to write to the file.}
    option -objects -takes waivers \
           -detail {The list of DRC, METHODOLOGY or CDC waiver objects to write, as specified by get_waivers.}
    option -return_string \
           -detail {Direct the output to a Tcl string that can be captured in a variable and parsed or otherwise processed.}
    option -force \
           -detail {Force the writing of the waivers to the file even when a message says the counts would be invalid.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_waivers ?-type type? ?-objects waivers? ?-return_string? ?-force? ?file? ?-quiet? ?-verbose?}

    hover {
        summary {Write out DRC, METHODOLOGY or CDC message waivers in command form.}
        synopsis {write_waivers ?-type type? ?-objects waivers? ?-return_string? ?-force? ?file? ?-quiet? ?-verbose?}
        description {Writes one or more message waivers as an XDC file of waiver commands, which is how waivers are carried from one design session to the next; read the file back with read_xdc when the design is reopened.}
        returns {Nothing.}
        example {write_waivers -type DRC C:/Data/drc_waivers.xdc}
        source {Xilinx UG835 2026.1}
    }
}
command write_xdc {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -no_fixed_only \
           -detail {Export both fixed and unfixed placement LOCs, where by default only the fixed LOCs from user-assigned placements are written.}
    option -constraints -takes constraints -values {valid invalid all} -closed \
           -detail {Export constraints that are flagged valid, invalid, or both, defaulting to valid.}
    option -cell -takes cell \
           -detail {The hierarchical cell in the current design to export the constraints from, written relative to that cell; a design must be open to use this option.}
    option -sdc \
           -detail {Export only the timing constraints, in a fully SDC compatible format, and no other defined constraints.}
    option -no_tool_comments \
           -detail {Do not add the verbose tool generated comments to the XDC when translating from UCF.}
    option -force -detail {Overwrite a file of the same name if one already exists.}
    option -exclude_timing \
           -detail {Do not export timing constraints, leaving an XDC file that contains only physical constraints.}
    option -include_noc \
           -detail {Export the NoC constraints, so that all constraints in the design including the modular NoC constraints are written.}
    option -exclude_physical \
           -detail {Do not export physical constraints, leaving an XDC file that contains only timing constraints.}
    option -add_netlist_placement \
           -detail {Include the placement constraints defined in the netlist file in the written XDC file.}
    option -logic_function_stripped \
           -detail {Include the set_disable_timing constraints needed to preserve constant propagation and timing signoff after the logic function of the LUTs has been stripped, for use with write_edif -logic_function_stripped.}
    option -type -takes types -values {timing io misc waiver physical noc} -closed \
           -detail {The types of constraint to export, of which several may be given at once; if not specified all constraints are exported.}
    option -write_id \
           -detail {Include the constraint position number before each timing constraint, as also reported by the Timing Constraints Editor.}
    option -exclude_cells -takes cells \
           -detail {Do not export constraints scoped to or below these hierarchical cells; constraints that refer hierarchically to those cells but are scoped above them are still exported.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_xdc ?-no_fixed_only? ?-constraints constraints? ?-cell cell? ?-sdc? ?-no_tool_comments? ?-force? ?-exclude_timing? ?-include_noc? ?-exclude_physical? ?-add_netlist_placement? ?-logic_function_stripped? ?-type types? ?-write_id? ?-exclude_cells cells? ?file? ?-quiet? ?-verbose?}

    hover {
        summary {Write the design constraints to a Xilinx Design Constraints (XDC) file.}
        synopsis {write_xdc ?-no_fixed_only? ?-constraints constraints? ?-cell cell? ?-sdc? ?-no_tool_comments? ?-force? ?-exclude_timing? ?-include_noc? ?-exclude_physical? ?-add_netlist_placement? ?-logic_function_stripped? ?-type types? ?-write_id? ?-exclude_cells cells? ?file? ?-quiet? ?-verbose?}
        description {Writes the constraints of the design to an XDC file, from the top level by default or from a specific hierarchical cell, in the same order the constraints were added to or executed in the design. Writing the invalid constraints as well makes it quick to report the constraints the tool ignored because of the way they were written or applied. All constraints from the active constraint fileset are exported even when they come from several files, which lets an XDC file be created from a design using UCF files, though not all UCF constraints are converted. The default file extension is .xdc.}
        returns {Nothing.}
        example {write_xdc -no_fixed_only -constraints all C:/Data/design.xdc}
        source {Xilinx UG835 2026.1}
    }
}
command write_xsim_coverage {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -cov_db_name -takes cov_db_name \
           -detail {The database folder name inside the coverage database directory, defaulting to the simulation snapshot name.}
    option -cov_db_dir -takes cov_db_dir \
           -detail {The output coverage database directory the database is saved into, defaulting to the current directory.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_xsim_coverage ?-cov_db_name cov_db_name? ?-cov_db_dir cov_db_dir? ?-quiet? ?-verbose?}

    hover {
        summary {Dump the current coverage database to disk.}
        synopsis {write_xsim_coverage ?-cov_db_name cov_db_name? ?-cov_db_dir cov_db_dir? ?-quiet? ?-verbose?}
        description {Saves the coverage databases held by the XSim simulator kernel to disk, covering both functional coverage and code coverage; the code coverage database is only written when the design was compiled with one of the xelab code coverage options enabled. A subsequent export_xsim_coverage generates the corresponding coverage report.}
        returns {Nothing.}
        example {write_xsim_coverage -cov_db_dir cov_db1 -cov_db_name iter1}
        source {Xilinx UG835 2026.1}
    }
}
command xsim {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -view -takes wcfg_files \
           -detail {Open a wave configuration file listing the wave objects to display and their display properties (repeatable).}
    option -autoloadwcfg \
           -detail {For a wave database file named name.wdb, automatically open all wave config files named name followed by a number and .wcfg; ignored when -view is present.}
    option -runall -aliases {-R} \
           -detail {Run the simulation until completion and then quit, which is the equivalent of run -all followed by exit.}
    option -maxdeltaid -takes max_delta \
           -detail {The maximum number of delta cycles, given as an integer greater than 0 and defaulting to 10000, above which the simulator reports an error.}
    option -nolog \
           -detail {Ignored, and provided for compatibility with the xsim command-line tool.}
    option -maxlogsize -takes max_log_size \
           -detail {The maximum size a log file can reach in MBytes, where the default of -1 means unlimited.}
    option -onfinish -takes action -values {quit stop} -closed \
           -detail {The behavior at the end of simulation, defaulting to stop.}
    option -onerror -takes action -values {quit stop} -closed \
           -detail {The behavior upon a simulation run-time error, defaulting to stop.}
    option -tclbatch -aliases {-t} -takes tcl_files \
           -detail {The Tcl script file to run the simulator in batch mode.}
    option -testplusarg -takes plusargs \
           -detail {Plusargs to be used by the test$plusargs and value$plusargs system functions, distinguished from other simulator arguments by a leading plus character.}
    option -vcdfile -takes vcd_file -detail {The value change dump (VCD) output file.}
    option -vcdunit -takes vcd_unit \
           -detail {The time unit for the VCD output, defaulting to the simulation engine precision unit.}
    option -wdb -takes wdb_file \
           -detail {The waveform database output file, which can be reopened later with open_wave_database.}
    option -tp -detail {Enable printing of the hierarchical names of the processes being executed.}
    option -tl \
           -detail {Enable printing of the file name and line number of the statements being executed.}
    option -nosignalhandlers \
           -detail {Run with no OS-level signal handlers, to avoid conflict with security software, at the cost of fatal errors crashing the simulation with little indication of the failure.}
    option -ieeewarnings \
           -detail {Enable the warnings from VHDL IEEE functions, which are disabled by default.}
    option -stats -detail {Display memory and CPU statistics upon exiting.}
    option -clear_child_on_exit \
           -detail {Clear child processes upon exiting the simulation, applicable to Linux only.}
    option -scNoLogFile -detail {Keep the SystemC output separate from the XSim output.}
    option -sv_seed -takes seed \
           -detail {The seed for constraint random stimulus, defaulting to 1.}
    option -disable_multi_driver_resolution_scheduling \
           -detail {Revert to the original multi driver resolution flow when scheduling the processes.}
    option -disable_dormant_process_check_opt \
           -detail {Turn off the optimization of always processes when they are in a dormant state.}
    option -disable_constraint_preimply_flow \
           -detail {Turn off the preimply flow for constraint randomization, which gives precedence to solving absolute constraint expressions.}
    option -disable_circular_dependency_check \
           -detail {Disable the runtime error for cyclic or circular dependency in constraint randomization.}
    option -protoinst -takes protoinst_files \
           -detail {A .protoinst file for protocol analysis.}
    option -cov_db_dir -takes cov_db_dir \
           -detail {The SystemVerilog coverage run directory, defaulting to the current directory or to the value set in the similar xelab option.}
    option -cov_db_name -takes cov_db_name \
           -detail {The SystemVerilog coverage run name, defaulting to the snapshot name or to the value set in the similar xelab option.}
    option -ignore_assertions \
           -detail {Ignore the SystemVerilog concurrent assertion constructs at runtime.}
    option -ignore_coverage -detail {Ignore SystemVerilog functional coverage at runtime.}
    option -downgrade_error2info \
           -detail {Downgrade SystemVerilog message severity from error to info level.}
    option -downgrade_error2warning \
           -detail {Downgrade SystemVerilog message severity from error to warning level.}
    option -downgrade_fatal2info \
           -detail {Downgrade SystemVerilog message severity from fatal to info level.}
    option -downgrade_fatal2warning \
           -detail {Downgrade SystemVerilog message severity from fatal to warning level.}
    option -ignore_feature -takes features -values {assertion} -closed \
           -detail {The SystemVerilog feature to be ignored at runtime.}
    option -downgrade_severity -takes severities \
           -values {error2warning error2info fatal2warning fatal2info} -closed \
           -detail {Downgrade the severity level of SystemVerilog HDL messages.}
    option -cosim_hostname -takes hostname -detail {The hardware cosimulation server name.}
    option -cosim_portno -takes port_number -detail {The hardware cosimulation port number.}
    option -xsimdir -takes xsim_dir \
           -detail {The location of the xsim.dir directory, defaulting to ./xsim.dir in the current run directory.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {xsim ?-view wcfg_files...? ?-autoloadwcfg? ?-runall? ?-maxdeltaid max_delta? ?-nolog? ?-maxlogsize max_log_size? ?-onfinish action? ?-onerror action? ?-tclbatch tcl_files? ?-testplusarg plusargs? ?-vcdfile vcd_file? ?-vcdunit vcd_unit? ?-wdb wdb_file? ?-tp? ?-tl? ?-nosignalhandlers? ?-ieeewarnings? ?-stats? ?-clear_child_on_exit? ?-scNoLogFile? ?-sv_seed seed? ?-disable_multi_driver_resolution_scheduling? ?-disable_dormant_process_check_opt? ?-disable_constraint_preimply_flow? ?-disable_circular_dependency_check? ?-protoinst protoinst_files? ?-cov_db_dir cov_db_dir? ?-cov_db_name cov_db_name? ?-ignore_assertions? ?-ignore_coverage? ?-downgrade_error2info? ?-downgrade_error2warning? ?-downgrade_fatal2info? ?-downgrade_fatal2warning? ?-ignore_feature features? ?-downgrade_severity severities? ?-cosim_hostname hostname? ?-cosim_portno port_number? ?-xsimdir xsim_dir? snapshot ?-quiet? ?-verbose?}

    hover {
        summary {Load a simulation snapshot for simulation and return a simulation object.}
        synopsis {xsim ?-view wcfg_files...? ?-autoloadwcfg? ?-runall? ?-maxdeltaid max_delta? ?-nolog? ?-maxlogsize max_log_size? ?-onfinish action? ?-onerror action? ?-tclbatch tcl_files? ?-testplusarg plusargs? ?-vcdfile vcd_file? ?-vcdunit vcd_unit? ?-wdb wdb_file? ?-tp? ?-tl? ?-nosignalhandlers? ?-ieeewarnings? ?-stats? ?-clear_child_on_exit? ?-scNoLogFile? ?-sv_seed seed? ?-disable_multi_driver_resolution_scheduling? ?-disable_dormant_process_check_opt? ?-disable_constraint_preimply_flow? ?-disable_circular_dependency_check? ?-protoinst protoinst_files? ?-cov_db_dir cov_db_dir? ?-cov_db_name cov_db_name? ?-ignore_assertions? ?-ignore_coverage? ?-downgrade_error2info? ?-downgrade_error2warning? ?-downgrade_fatal2info? ?-downgrade_fatal2warning? ?-ignore_feature features? ?-downgrade_severity severities? ?-cosim_hostname hostname? ?-cosim_portno port_number? ?-xsimdir xsim_dir? snapshot ?-quiet? ?-verbose?}
        description {Loads a simulation snapshot to run a batch mode simulation, or to provide a GUI or Tcl-based interactive simulation environment. The snapshot must have been generated by the xelab command, and a WDB file given instead must have been saved by the -wdb option of an earlier xsim run.}
        returns {Current simulation object.}
        example {xsim C:/Data/project_xsim/project_xsim.sim/sim_1/behav/testbench_behav}
        source {Xilinx UG835 2026.1}
    }
}
}
