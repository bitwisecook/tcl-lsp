command report_ssn {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {Output the results to a GUI panel with this name.}
    option -return_string \
           -detail {Direct the output to a Tcl string, which cannot be used with -file.}
    ;# NOTE(xilinx): the Usage table spells the format values CSV and HTML while the
    ;# Arguments prose spells them csv and html; the Arguments spelling is used here.
    option -format -takes format -values {csv html} -closed \
           -detail {Format of the output file as comma-separated values or HTML, defaulting to csv and ignored without -file.}
    option -file -takes file \
           -detail {Write the SSN report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the report to the specified file rather than overwriting it (only with -file).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_ssn ?-name name? ?-return_string? ?-format format? ?-file file? ?-append? ?-quiet? ?-verbose?}

    hover {
        summary {Run SSN analysis on the current package and pinout.}
        synopsis {report_ssn ?-name name? ?-return_string? ?-format format? ?-file file? ?-append? ?-quiet? ?-verbose?}
        description {Performs a simultaneous switching noise (SSN) analysis of the current synthesized or implemented design, estimating the disruption that simultaneously switching outputs can cause on other output ports in the I/O bank, and on input ports in the case of Spartan-6 devices, by incorporating I/O bank-specific electrical characteristics into the prediction. The command provides a detailed SSN analysis for Spartan-6, Virtex-6, Virtex-7, Kintex-7, and Artix-7 devices, while report_sso approximates switching noise for Spartan-3, Virtex-4, and Virtex-5 devices; the estimates are not intended as final design sign-off criteria. The report is returned to the standard output unless -file, -return_string, or -name is specified.}
        returns {Ssn report.}
        example {report_ssn -format html -file C:/Data/devSSN.html}
        source {Xilinx UG835 2012.2}
    }
}
command report_sso {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {Name of the result set to output to the GUI panel (required).}
    option -return_string \
           -detail {Direct the output to a Tcl string, which cannot be used with -file.}
    option -file -takes file \
           -detail {Write the SSO report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the report to the specified file rather than overwriting it (only with -file).}
    option -board_thickness -takes mils \
           -detail {Thickness in mils of the PCB the FPGA device is mounted onto, defaulting to 62 mils.}
    option -via_diameter -takes mils \
           -detail {Finished diameter in mils of the breakout vias in the PCB, defaulting to 12 mils.}
    option -pad_to_via_breakout_length -takes mils \
           -detail {Length in mils of the breakout wire from the pad on the package or socket to the breakout via, defaulting to 33 mils.}
    option -breakout_width -takes mils \
           -detail {Width in mils of the breakout wire on the PCB, defaulting to 12 mils.}
    option -other_pcb_inductance -takes nanohenrys \
           -detail {Other PCB parasitic inductance in nanohenrys, defaulting to 0 nH.}
    option -socket_inductance -takes nanohenrys \
           -detail {Inductance in nanohenrys of the mounting socket between the FPGA and the PCB, defaulting to 0 nH.}
    option -ground_bounce -takes millivolts \
           -detail {Maximum allowed undershoot or overshoot voltage of the signal on the PCB in millivolts.}
    option -output_cap -takes picofarads \
           -detail {Capacitance per output driver in picofarads, defaulting to 15 pF.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_sso -name name ?-return_string? ?-file file? ?-append? ?-board_thickness mils? ?-via_diameter mils? ?-pad_to_via_breakout_length mils? ?-breakout_width mils? ?-other_pcb_inductance nanohenrys? ?-socket_inductance nanohenrys? ?-ground_bounce millivolts? ?-output_cap picofarads? ?-quiet? ?-verbose?}

    hover {
        summary {Run WASSO analysis on the current package and pinout.}
        synopsis {report_sso -name name ?-return_string? ?-file file? ?-append? ?-board_thickness mils? ?-via_diameter mils? ?-pad_to_via_breakout_length mils? ?-breakout_width mils? ?-other_pcb_inductance nanohenrys? ?-socket_inductance nanohenrys? ?-ground_bounce millivolts? ?-output_cap picofarads? ?-quiet? ?-verbose?}
        description {Performs a weighted average simultaneous switching outputs (WASSO) analysis of the current synthesized or implemented design to validate signal integrity based on the I/O pin and bank assignments in the design. The command is for Spartan-3, Virtex-4, and Virtex-5 devices and approximates switching noise for them, while report_ssn provides a more detailed SSN analysis for Spartan-6, Virtex-6, Virtex-7, Kintex-7, and Artix-7 devices. The analysis places the FPGA in the context of the system-level design, so the printed circuit board it will be mounted to is described by the various board and device arguments or left at their default values.}
        returns {Sso report.}
        example {report_sso -file C:/Data/devSSO.txt}
        source {Xilinx UG835 2012.2}
    }
}
command report_switching_activity {
