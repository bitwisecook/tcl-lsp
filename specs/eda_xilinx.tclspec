        summary {Stop capturing VCD output.}
        synopsis {stop_vcd ?-ports? ?-file file_name? ?-quiet? ?-verbose?}
        description {Stops writing the simulation values to the current Value Change Dump file, modeling the behavior of the Verilog dumpoff system task. Output to the file is suspended until the process is resumed using the start_vcd command, and open_vcd must be executed before this command.}
        returns {Nothing.}
        example {stop_vcd}
        source {Xilinx UG835 2026.1}
    }
}
command swap_locs {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {swap_locs ?-quiet? ?-verbose? aloc bloc}

    hover {
        summary {Swap two locations.}
        synopsis {swap_locs ?-quiet? ?-verbose? aloc bloc}
        description {Swaps the LOC constraints assigned to two similar logic elements, each specified as a port, a cell, or a device site of the same type as the other. Some DRC checking is performed to ensure that the two selected elements can be assigned to their new locations, and the command fails with an error if the location of either element is invalid.}
        returns {Nothing.}
        example {swap_locs [get_sites {OLOGIC_X2Y1}] [get_sites {OLOGIC_X2Y0}]}
        source {Xilinx UG835 2026.1}
    }
}
command synth_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes design_name \
           -detail {The name assigned to the synthesized design when it is opened after synthesis has completed.}
    option -part -takes part \
           -detail {The target device to use for the design; the default part assigned to the project is used when omitted.}
    option -constrset -takes constraint_fileset \
           -detail {The name of an existing XDC constraint fileset to use when synthesizing the design.}
    option -top -takes top_module -detail {Specify the top module name of the design hierarchy.}
    option -include_dirs -takes directories \
           -detail {Specify the Verilog search directories for include files.}
    option -generic -takes name_value \
           -detail {Specify the value of a VHDL generic or Verilog parameter at the top level of the design, as name=value; repeat the option for each value to be defined (repeatable).}
    option -define -takes macro \
           -detail {Specify Verilog and VHDL defines, as macro_name or macro_name=macro_text (repeatable).}
    option -verilog_define -takes macro \
           -detail {Set values for Verilog define and ifdef statements, as macro_name or macro_name=macro_text (repeatable).}
    option -vhdl_define -takes macro \
           -detail {Specify VHDL defines, as macro_name or macro_name=macro_text (repeatable).}
    option -flatten_hierarchy -takes mode -values {full none rebuilt} -closed \
           -detail {Flatten the hierarchy during LUT mapping, where rebuilt attempts to rebuild the original RTL hierarchy after synthesis; the default is rebuilt.}
    option -gated_clock_conversion -takes mode -values {off on auto} -closed \
           -detail {Convert clock gating logic to use the flop enable pins when available; the default is off.}
    option -directive -takes directive \
           -values {default RuntimeOptimized AreaOptimized_high AreaOptimized_medium AlternateRoutability \
                    AreaMapLargeShiftRegToBRAM AreaMultThresholdDSP FewerCarryChains PerformanceOptimized \
                    LogicCompaction PowerOptimized_high PowerOptimized_medium} -closed \
           -detail {Direct synthesis to achieve specific design objectives; only one case-sensitive directive can be specified per command and the default is default.}
    option -rtl -detail {Elaborate the HDL source files and open the RTL design.}
    option -lint \
           -detail {Run the RTL Linter on the source files, recommended before RTL simulation and synthesis to identify potential issues early in the design cycle.}
    option -file -takes file_name \
           -detail {Linter filename to output results to; output is sent to the console when -file is not used.}
    option -bufg -takes count \
           -detail {Maximum number of global clock buffers used by synthesis, specified as a value >= 1 that should not exceed the BUFG count of the target device; the default is 12.}
    option -no_lc -detail {Disable LUT combining, so LUT pairs are not combined into single dual output LUTs.}
    option -lut_cascade \
           -detail {Enable LUT cascading in synthesis, packing more logic into the same slice at the cost of area.}
    option -shreg_min_size -takes length \
           -detail {Minimum length for a chain of registers to be mapped onto SRL; the default is 3.}
    option -mode -takes mode -values {default out_of_context} -closed \
           -detail {The design mode, where out_of_context turns off I/O buffer insertion and marks the module as OOC; the default is default.}
    option -fsm_extraction -takes encoding \
           -values {off one_hot sequential johnson gray user_encoding auto} -closed \
           -detail {Enable finite state machine identification and specify the encoding to apply, where auto lets the tool choose the best encoding for each state machine; the default is auto.}
    option -rtl_skip_mlo \
           -detail {Skip mandatory logic optimization for RTL elaboration of the design; requires the -rtl option.}
    option -rtl_skip_ip \
           -detail {Exclude subdesign checkpoints in the RTL elaboration of the design, loading stub files so out-of-context modules are treated as black boxes; requires the -rtl option.}
    option -rtl_skip_constraints \
           -detail {Do not load and validate constraints against the elaborated design; requires the -rtl option.}
    option -srl_style -takes style -values {register srl srl_reg reg_srl reg_srl_reg} -closed \
           -detail {Static SRL implementation style.}
    option -keep_equivalent_registers \
           -detail {Prevent registers sourced by the same logic from being merged, working like the KEEP attribute.}
    option -resource_sharing -takes mode -values {auto on off} -closed \
           -detail {Share arithmetic operators such as adders between different signals rather than creating new operators; the default is auto.}
    option -cascade_dsp -takes mode -values {auto tree force} -closed \
           -detail {Controls how adders summing DSP block outputs are implemented; the default is auto.}
    option -control_set_opt_threshold -takes threshold \
           -detail {Threshold for synchronous control set optimization, specified as auto or a non-negative integer, where a higher number performs more optimization and 0 disables it; the default is auto.}
    option -incremental_mode -takes mode -values {aggressive default off quick} -closed \
           -detail {Mode of incremental synthesis; the default is default.}
    option -max_bram -takes count \
           -detail {Maximum number of block RAM allowed in the design, where -1 lets the tool choose the maximum allowed for the part; the default is -1.}
    option -max_uram -takes count \
           -detail {Maximum number of Ultra RAM blocks allowed in the design, where -1 lets the tool choose the maximum allowed for the part; the default is -1.}
    option -max_dsp -takes count \
           -detail {Maximum number of DSP blocks allowed in the design, where -1 lets the tool choose the maximum allowed for the part; the default is -1.}
    option -max_bram_cascade_height -takes count \
           -detail {Controls the maximum number of block RAM that can be cascaded by the tool, where -1 lets the tool choose the maximum allowed for the part; the default is -1.}
    option -max_uram_cascade_height -takes count \
           -detail {Controls the maximum number of URAM that can be cascaded by the tool, where -1 lets the tool choose the maximum allowed for the part; the default is -1.}
    option -global_retiming -takes mode -values {auto on off} -closed \
           -detail {Improves circuit performance for intra-clock sequential paths by automatically moving registers across combinatorial gates or LUTs, maintaining the original behavior and latency; the default is auto.}
    option -no_srlextract \
           -detail {Prevents the extraction of shift registers so that they are implemented as simple registers.}
    option -assert \
           -detail {Enable VHDL assert statements to be evaluated, where a severity level of failure stops the synthesis flow and produces an error.}
    option -no_timing_driven -detail {Do not run in timing driven mode.}
    option -sfcu -detail {Run in single-file compilation unit mode.}
    option -debug_log -detail {Print detailed log files for debugging.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the four rows below are documented in the section's Arguments
    ;# prose but appear in neither the Syntax line nor the Usage table, so they are
    ;# carried as options while the form stays faithful to the Syntax line.
    option -dataflow \
           -detail {Elaborate the HDL source files and open the Dataflow design, an abstracted view of the RTL that omits low level logic but displays cells such as RAMs, DSPs, and other IP blocks.}
    option -incremental -takes dcp_file \
           -detail {Specify a DCP file for the incremental compilation flow, whose netlist is applied to the design objects in the current design to reuse existing synthesis results when possible.}
    option -retiming \
           -detail {For non-Versal devices, improve circuit performance for intra-clock sequential paths by automatically moving registers across combinatorial gates or LUTs.}
    option -no_retiming \
           -detail {For Versal devices, where retiming is on by default, turn off the retiming feature.}

    form Default {synth_design ?-name design_name? ?-part part? ?-constrset constraint_fileset? ?-top top_module? ?-include_dirs directories? ?-generic name_value? ?-define macro? ?-verilog_define macro? ?-vhdl_define macro? ?-flatten_hierarchy mode? ?-gated_clock_conversion mode? ?-directive directive? ?-rtl? ?-lint? ?-file file_name? ?-bufg count? ?-no_lc? ?-lut_cascade? ?-shreg_min_size length? ?-mode mode? ?-fsm_extraction encoding? ?-rtl_skip_mlo? ?-rtl_skip_ip? ?-rtl_skip_constraints? ?-srl_style style? ?-keep_equivalent_registers? ?-resource_sharing mode? ?-cascade_dsp mode? ?-control_set_opt_threshold threshold? ?-incremental_mode mode? ?-max_bram count? ?-max_uram count? ?-max_dsp count? ?-max_bram_cascade_height count? ?-max_uram_cascade_height count? ?-global_retiming mode? ?-no_srlextract? ?-assert? ?-no_timing_driven? ?-sfcu? ?-debug_log? ?-quiet? ?-verbose?}

    hover {
        summary {Synthesize a design using Vivado synthesis and open that design.}
        synopsis {synth_design ?-name design_name? ?-part part? ?-constrset constraint_fileset? ?-top top_module? ?-include_dirs directories? ?-generic name_value? ?-define macro? ?-verilog_define macro? ?-vhdl_define macro? ?-flatten_hierarchy mode? ?-gated_clock_conversion mode? ?-directive directive? ?-rtl? ?-lint? ?-file file_name? ?-bufg count? ?-no_lc? ?-lut_cascade? ?-shreg_min_size length? ?-mode mode? ?-fsm_extraction encoding? ?-rtl_skip_mlo? ?-rtl_skip_ip? ?-rtl_skip_constraints? ?-srl_style style? ?-keep_equivalent_registers? ?-resource_sharing mode? ?-cascade_dsp mode? ?-control_set_opt_threshold threshold? ?-incremental_mode mode? ?-max_bram count? ?-max_uram count? ?-max_dsp count? ?-max_bram_cascade_height count? ?-max_uram_cascade_height count? ?-global_retiming mode? ?-no_srlextract? ?-assert? ?-no_timing_driven? ?-sfcu? ?-debug_log? ?-quiet? ?-verbose?}
        description {Directly launches the Vivado synthesis engine to compile and synthesize a design in either Project Mode or Non-Project Mode. In Non-Project Mode synthesis is launched directly with this command; in Project Mode synthesis should be launched from an existing synthesis run created with create_run and started with launch_runs, which in turn calls synth_design. The command can also elaborate RTL source files and open an elaborated design with -rtl, and it can be multi-threaded through the general.maxThreads parameter.}
        returns {Design object.}
        example {synth_design -top [lindex [find_top] 0]}
        source {Xilinx UG835 2026.1}
    }
}
command synth_ip {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force \
           -detail {Force re-synthesis of the specified IP objects, even if the generated output products are all current.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {synth_ip ?-force? ?-quiet? ?-verbose? objects}

    hover {
        summary {Generate a synthesis netlist for an IP.}
        synopsis {synth_ip ?-force? ?-quiet? ?-verbose? objects}
        description {Used in the non-project flow to create a synthesized design checkpoint file to support the out-of-context IP flow, or to synthesize and implement an IP module in the OOC hierarchical design flow. IP objects are specified by get_ips, or as XCI files specified by get_files, and the IP core must be marked for OOC generation by setting the GENERATE_SYNTH_CHECKPOINT property to true. Required target files are generated automatically before synthesis, and newly generated OOC target files are registered with the associated IP core.}
        returns {Nothing.}
        example {synth_ip [get_ips char_fifo] -force}
        source {Xilinx UG835 2026.1}
    }
}
