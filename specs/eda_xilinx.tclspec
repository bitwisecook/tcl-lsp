command reset_msg_count {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_msg_count ?-quiet? ?-verbose? id}

    hover {
        summary {Reset the message count for a message ID.}
        synopsis {reset_msg_count ?-quiet? ?-verbose? id}
        description {Resets the message count for the specified message ID to 0, restarting the message counter toward the message limit, and accepts * to reset the count of all messages. Every message delivered by the tool has a unique global message ID made up of an application sub-system code and a message identifier, such as "Common 17-54", "Netlist 29-28", or "Synth 8-3295"; the current count for an ID is available from get_msg_count.}
        returns {New message count.}
        source {Xilinx UG835 2012.2}
    }
}
command reset_msg_limit {
    dialects tcl8.5
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table gives ALL as the default severity, which is not
    ;# among the five severities the Arguments prose lists, so the set is left open.
    option -severity -takes severity \
           -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} \
           -detail {Message severity whose limit is reset, defaulting to ALL and not valid with -id.}
    option -id -takes id \
           -detail {Unique message ID whose limit is reset, such as Common-99, and not valid with -severity.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-severity -id}

    form Default {reset_msg_limit ?-severity severity? ?-id id? ?-quiet? ?-verbose?}

    hover {
        summary {Reset the message limit.}
        synopsis {reset_msg_limit ?-severity severity? ?-id id? ?-quiet? ?-verbose?}
        description {Restores the default message limit, either for a specific message ID, for a specific message severity, or for all messages returned. The default limit for all messages returned is 4,294,967,295, and the five message severities are ERROR, CRITICAL WARNING, WARNING, INFO, and STATUS; because CRITICAL WARNING is a two word value it must be enclosed in braces or quotes.}
        returns {New message limit.}
        example {reset_msg_limit -id "Netlist 29-28"}
        source {Xilinx UG835 2012.2}
    }
}
command reset_msg_severity {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_msg_severity ?-quiet? ?-verbose? id}

    hover {
        summary {Reset the message severity of a message ID.}
        synopsis {reset_msg_severity ?-quiet? ?-verbose? id}
        description {Restores the specified message ID to its default severity. Use this command after set_msg_severity to restore a specific message ID to its original severity level.}
        returns {Nothing.}
        example {reset_msg_severity common-99}
        source {Xilinx UG835 2012.2}
    }
}
command reset_operating_conditions {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -voltage -takes supplies \
           -detail {Reset the voltage pairs, where the supported voltage supplies vary by family.}
    option -grade \
           -detail {Reset the temperature grade of the selected device to the default value commercial.}
    option -process \
           -detail {Reset the manufacturing process for the target device to the default process typical.}
    option -junction_temp \
           -detail {Reset the junction temperature for the target device to the default value auto.}
    option -ambient_temp \
           -detail {Reset the ambient temperature of the design to the default setting default.}
    option -thetaja \
           -detail {Reset the Theta-JA thermal resistance to the default setting auto.}
    option -thetasa \
           -detail {Reset the Theta-SA thermal resistance to the default setting auto.}
    option -airflow \
           -detail {Reset the Linear Feet Per Minute (LFM) airflow, whose default setting varies by device family.}
    option -heatsink -detail {Reset the heatsink profile to the default setting medium.}
    option -thetajb \
           -detail {Reset the Theta-JB thermal resistance to the default setting auto.}
    option -board \
           -detail {Reset the board size to be used for modeling to the default value medium.}
    option -board_temp -detail {Reset the board temperature to the default setting.}
    option -board_layers \
           -detail {Reset the number of board layers to be used for modeling to the default setting 8to11.}
    option -all \
           -detail {Reset all operating conditions to their default value rather than each condition separately.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_operating_conditions ?-voltage supplies? ?-grade? ?-process? ?-junction_temp? ?-ambient_temp? ?-thetaja? ?-thetasa? ?-airflow? ?-heatsink? ?-thetajb? ?-board? ?-board_temp? ?-board_layers? ?-all? ?-quiet? ?-verbose?}

    hover {
        summary {Reset operating conditions to the tool default for power estimation.}
        synopsis {reset_operating_conditions ?-voltage supplies? ?-grade? ?-process? ?-junction_temp? ?-ambient_temp? ?-thetaja? ?-thetasa? ?-airflow? ?-heatsink? ?-thetajb? ?-board? ?-board_temp? ?-board_layers? ?-all? ?-quiet? ?-verbose?}
        description {Resets the specified operating conditions to their default values. The environmental operating conditions of the device are used for power analysis when running report_power but are not used during timing analysis; they can be set with set_operating_conditions and inspected with report_operating_conditions. The command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {reset_operating_conditions -junction_temp -ambient_temp -board_temp}
        source {Xilinx UG835 2012.2}
    }
}
