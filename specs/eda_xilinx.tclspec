    hover {
        summary {Limit time borrowing for latches.}
        synopsis {set_max_time_borrow delay objects ?-quiet? ?-verbose?}
        description {Sets the maximum amount of time that can be borrowed between nets when analyzing the timing on latches. The delay is a floating point number >= 0 in the units of time defined by set_units, and applies to the listed clocks, cells, data pins, or clock pins. This command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {set_max_time_borrow 0.0 [all_clocks]}
        source {Xilinx UG835 2012.2}
    }
}
command set_msg_limit {
    dialects tcl8.5
    required_package vivado

    arity 1..

    ;# NOTE(xilinx): the Arguments prose names five severities, but the Usage
    ;# table gives ALL as the default, so the set is not marked -closed.
    option -severity -takes severity -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} \
           -detail {Message severity to be set, not valid with -id.}
    option -id -takes id -detail {Unique message id to be set, not valid with -severity.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-severity -id}

    form Default {set_msg_limit ?-severity severity? ?-id id? count ?-quiet? ?-verbose?}

    hover {
        summary {Set the limit on the number of messages returned by the tool.}
        synopsis {set_msg_limit ?-severity severity? ?-id id? count ?-quiet? ?-verbose?}
        description {Defines the number of messages returned by the tool during a design session, or single invocation. You can set the limit of a specific message ID such as "Common 17-54", or the limit for a specific message severity such as "CRITICAL WARNING", or, when neither is given, the limit for the total number of messages returned. The count is a value >= 1; a count of -1 restores the messaging.defaultLimit parameter value, as does reset_msg_limit.}
        returns {New message limit.}
        example {set_msg_limit -severity WARNING 50000}
        source {Xilinx UG835 2012.2}
    }
}
command set_msg_severity {
    dialects tcl8.5
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_msg_severity id severity ?-quiet? ?-verbose?}

    hover {
        summary {Set the severity of a message by its message ID.}
        synopsis {set_msg_severity id severity ?-quiet? ?-verbose?}
        description {Sets the severity of a specified message ID from one type, such as WARNING, to another type, such as ERROR. The five severities are ERROR, CRITICAL WARNING, WARNING, INFO, and STATUS; a two word severity must be enclosed in braces or quotes. STATUS messages have no message ID, so their severity cannot be changed. The original severity of a message ID is restored with reset_msg_severity.}
        returns {Nothing.}
        example {set_msg_severity "Common 17-54" WARNING}
        source {Xilinx UG835 2012.2}
    }
}
command set_package_pin_val {
    dialects tcl8.5
    required_package vivado

    arity 3..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the section's examples spell the three positional words as
    ;# -column, -value and -package_pins options, which the Syntax and Usage
    ;# entries do not document; the positional Syntax spelling is used here and
    ;# the contradictory examples are dropped.
    form Default {set_package_pin_val column value package_pins ... ?-quiet? ?-verbose?}

    hover {
        summary {Set user columns on one or more package pins.}
        synopsis {set_package_pin_val column value package_pins ... ?-quiet? ?-verbose?}
        description {Creates user-defined package pin attributes and assigns values to specific pins on the package. The case-sensitive column name creates a new attribute when it does not already exist, and the value is assigned to the named package pins, which can be selected with get_package_pins. User-defined pin attributes can also be defined in a CSV file and imported with read_csv, or exported with write_csv; use set_property for tool-defined properties of a package pin.}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
command set_param {
    dialects tcl8.5
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_param name value ?-quiet? ?-verbose?}

    hover {
        summary {Set a parameter value.}
        synopsis {set_param name value ?-quiet? ?-verbose?}
        description {Sets the value of a user-definable configuration parameter that controls the behavior of the tool. Only one parameter can be set at a time; report_param describes the currently defined parameters and reset_param restores a modified parameter to its default. Setting a parameter value to -1 disables the feature.}
        returns {Newly set parameter value.}
        example {set_param tcl.statsThreshold 15}
        source {Xilinx UG835 2012.2}
    }
}
command set_power_opt {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -include_cells -takes cells \
           -detail {Include only these instances for clock gating, the default being all cells.}
    option -exclude_cells -takes cells \
           -detail {Exclude these instances from clock gating, applying only to the currently included cells.}
    option -clocks -takes clocks \
           -detail {Clock gate instances clocked by these clocks only, the default being all clocks.}
    ;# NOTE(xilinx): the Usage table spells the fourth value srl while the
    ;# Arguments prose spells it slr; the examples use srl and also pass a list
    ;# of types, so the set is offered without -closed.
    option -cell_types -takes cell_types -values {all bram reg srl none} \
           -detail {Clock gate these cell types only, where all or none clears any prior set_power_opt commands.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_power_opt ?-include_cells cells? ?-exclude_cells cells? ?-clocks clocks? ?-cell_types cell_types? ?-quiet? ?-verbose?}

    hover {
        summary {Set constraints for power optimization.}
        synopsis {set_power_opt ?-include_cells cells? ?-exclude_cells cells? ?-clocks clocks? ?-cell_types cell_types? ?-quiet? ?-verbose?}
        description {Specifies the cell instances to include in power optimization, which are then optimized by power_opt_design. The effect of multiple set_power_opt commands is cumulative, so a broad class of cell types can be specified, then specific hierarchical cells included, then cells within the included hierarchy excluded to refine the optimization. The optimizations performed are reported by report_power_opt.}
        returns {Nothing.}
        example {set_power_opt -cell_types bram
power_opt_design}
        source {Xilinx UG835 2012.2}
    }
}
