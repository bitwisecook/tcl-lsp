;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command wait_on_run {
    available {tcl 8.5}
    arity 1
    required_package vivado
    deprecated_replacement wait_on_runs

    form Default {wait_on_run ?-timeout minutes? run_name}

    hover {
        summary {Legacy: wait for a run to complete.}
        synopsis {wait_on_run ?-timeout minutes? run_name}
        source {F5}
    }
}
command wait_on_runs {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -timeout -takes timeout \
           -detail {The maximum time in minutes to wait for the runs to complete, where the default of -1 places no limit on the wait.}
    option -exit_condition -takes exit_condition \
           -values {ALL ANY_ONE ANY_ONE_MET_TIMING} -closed \
           -detail {The exit condition for the wait, defaulting to ALL.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {wait_on_runs ?-timeout timeout? ?-exit_condition exit_condition? runs ?-quiet? ?-verbose?}

    hover {
        summary {Block execution of further Tcl commands until the specified runs complete.}
        synopsis {wait_on_runs ?-timeout timeout? ?-exit_condition exit_condition? runs ?-quiet? ?-verbose?}
        description {Blocks the execution of Tcl commands until the specified runs have completed either successfully or in error, or until the specified amount of time has elapsed. It reports that the run has terminated but not the result; query the PROGRESS property of the run to determine whether it completed successfully. The runs must already have been launched or an error is returned, and the command is ignored when running interactively from the GUI.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command write_abstract_shell {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -cell -takes cell \
           -detail {Create an abstract shell for this reconfigurable cell (required).}
    option -force -detail {Overwrite an existing checkpoint file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_abstract_shell -cell cell ?-force? file ?-quiet? ?-verbose?}

    hover {
        summary {Write an abstract shell checkpoint of the current design.}
        synopsis {write_abstract_shell -cell cell ?-force? file ?-quiet? ?-verbose?}
        description {Writes an abstract shell checkpoint of the current design for the reconfigurable cell named by -cell, into a design checkpoint file whose name uses alphanumeric characters and the .dcp extension.}
        returns {The name of the checkpoint file.}
        source {Xilinx UG835 2026.1}
    }
}
command write_bd_layout {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite an existing file of the specified name.}
    option -format -takes format -values {native pdf svg} -closed \
           -detail {The output file format, defaulting to native, an internal format that regenerate_bd_layout can use to recreate the block design layout; svg is scalable vector graphics and pdf is portable document format.}
    option -orientation -takes orientation -values {landscape portrait} -closed \
           -detail {The orientation of the graphic file, either horizontal (landscape) or vertical (portrait), defaulting to portrait.}
    option -scope -takes scope -values {visible all} -closed \
           -detail {The scope of the block design written, either the currently displayed limits of the design canvas (visible) or the whole block design (all), which is the default.}
    option -hierarchy -takes hierarchy \
           -detail {Output the drawing of this hierarchical bd_cell, as specified by get_bd_cells.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_bd_layout ?-force? ?-format format? ?-orientation orientation? ?-scope scope? ?-hierarchy hierarchy? file ?-quiet? ?-verbose?}

    hover {
        summary {Export the block design layout in native, PDF, or SVG format.}
        synopsis {write_bd_layout ?-force? ?-format format? ?-orientation orientation? ?-scope scope? ?-hierarchy hierarchy? file ?-quiet? ?-verbose?}
        description {Writes the currently open block design in the Vivado IP integrator to the specified file format, so that the block design can be printed, output as a vector graphic file for design documentation, or recreated in the IP integrator design canvas with regenerate_bd_layout. An existing file of the same name requires -force or an error is returned.}
        returns {Name of the output file.}
        example {write_bd_layout -format pdf -orientation landscape C:/Data/microblaze.pdf}
        source {Xilinx UG835 2026.1}
    }
}
command write_bd_tcl {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite an existing bd_tcl file of the same name.}
    option -bd_name -takes bd_name \
           -detail {The name to assign to the block diagram in the bd_tcl file, defaulting to the current name of the block diagram.}
    option -no_mig_contents \
           -detail {Do not include the memory IP PRJ contents in the generated Tcl script, loading the PRJ from the working directory instead.}
    option -no_ip_version \
           -detail {Do not include the version in the IP VLNV used by create_bd_cell commands, which can have significant design implications when the IP has undergone major version changes.}
    option -ignore_minor_versions \
           -detail {Do not include the minor version in the IP VLNV, so the script uses the latest minor revision while preserving the major version.}
    option -bd_folder -takes bd_folder \
           -detail {The folder where the block design will be generated when the Tcl script is sourced.}
    option -boundary_of -takes boundary_of \
           -detail {Generate only the boundary, meaning the external interfaces and external ports, of the given current design or hierarchical block, with no cell objects or connections; other arguments are ignored when this is used, and / names the current design.}
    option -check_ips -takes boolean \
           -detail {Check whether the IP or modules exist in the IP catalog or project before reconstructing the design, which is the default; accepted spellings include true/false, yes/no, and 1/0.}
    option -hier_blks -takes hier_blks \
           -detail {A comma separated list of hierarchical blocks the Tcl script will generate, including any sub-hierarchical blocks within them, without creating the top-level design portion.}
    option -include_layout \
           -detail {Include the GUI layout information of the design in the generated Tcl script, which is not included by default; ignored when -hier_blks is used.}
    option -exclude_layout \
           -detail {Do not include the layout information in the generated Tcl script, supported for backwards compatibility.}
    option -keep_paths_as_is \
           -detail {Leave path values as is instead of converting relative paths to absolute paths; absolute paths remain absolute.}
    option -make_local \
           -detail {Write a remote block design out as a local block design.}
    option -no_project_wrapper \
           -detail {Write the block design creation Tcl procs without any project wrapper.}
    option -exclude_pfm \
           -detail {Exclude the PFM attributes used in defining a Vitis platform from the generated script.}
    option -updated_pfm_attrs \
           -detail {Update the PFMs to remove connected ports and interfaces from the values.}
    option -export_inline_hdl \
           -detail {Convert utility IP to inline HDL blocks.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_bd_tcl ?-force? ?-bd_name bd_name? ?-no_mig_contents? ?-no_ip_version? ?-ignore_minor_versions? ?-bd_folder bd_folder? ?-boundary_of boundary_of? ?-check_ips boolean? ?-hier_blks hier_blks? ?-include_layout? ?-exclude_layout? ?-keep_paths_as_is? ?-make_local? ?-no_project_wrapper? ?-exclude_pfm? ?-updated_pfm_attrs? ?-export_inline_hdl? tcl_filename ?-quiet? ?-verbose?}

    hover {
        summary {Export the current block design to a Tcl file on disk.}
        synopsis {write_bd_tcl ?-force? ?-bd_name bd_name? ?-no_mig_contents? ?-no_ip_version? ?-ignore_minor_versions? ?-bd_folder bd_folder? ?-boundary_of boundary_of? ?-check_ips boolean? ?-hier_blks hier_blks? ?-include_layout? ?-exclude_layout? ?-keep_paths_as_is? ?-make_local? ?-no_project_wrapper? ?-exclude_pfm? ?-updated_pfm_attrs? ?-export_inline_hdl? tcl_filename ?-quiet? ?-verbose?}
        description {Exports the current IP integrator subsystem design as a Tcl script file, letting the design be recreated, reused, and customized without archiving the original subsystem design. Any directory in the specified path must already exist or the script is not created, and a suffix of .tcl is supplied if none is given. The output script must be used to create a block design in the same software release it was generated in, after which the created block design can be migrated to a newer release.}
        returns {TCL_OK, TCL_ERROR if failed.}
        example {write_bd_tcl C:/Data/myDesign.tcl}
        source {Xilinx UG835 2026.1}
    }
}
command write_bitstream {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Force the overwrite of an existing bitstream file of the same name.}
    option -raw_bitfile \
           -detail {Write a raw bit file (.rbt) containing the same information as the binary bitstream file but in ASCII format.}
    option -no_binary_bitfile \
           -detail {Do not write the binary bitstream file (.bit), for use when generating the ASCII bitstream, mask file, or bitstream report alone.}
    option -mask_file \
           -detail {Write a mask file (.msk) that has mask data in place of the configuration data, determining which bits of the bitstream are compared to readback data for verification.}
    option -readback_file \
           -detail {Write the readback files (.rbd, .msd) needed to perform the readback function.}
    option -logic_location_file \
           -detail {Write an ASCII logic location file (.ll) showing the bitstream position of latches, flip-flops, LUTs, block RAMs, and I/O block inputs and outputs.}
    option -bin_file \
           -detail {Write a binary file (.bin) containing only the device programming data, without the header information found in the standard bit file.}
    option -reference_bitfile -takes reference_bitfile \
           -detail {Read this reference bitstream and output an incremental bitstream containing only the differences from it, for incrementally programming an existing device.}
    option -cell -takes cell \
           -detail {Write a partial bitstream for this cell or block level of the design hierarchy only.}
    option -no_partial_bitfile \
           -detail {Do not write partial bit files for a Dynamic Function eXchange design.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Print the write_bitstream options applied to the bitstream.}

    form Default {write_bitstream ?-force? ?-raw_bitfile? ?-no_binary_bitfile? ?-mask_file? ?-readback_file? ?-logic_location_file? ?-bin_file? ?-reference_bitfile reference_bitfile? ?-cell cell? ?-no_partial_bitfile? file ?-quiet? ?-verbose?}

    hover {
        summary {Write a bitstream for the current design.}
        synopsis {write_bitstream ?-force? ?-raw_bitfile? ?-no_binary_bitfile? ?-mask_file? ?-readback_file? ?-logic_location_file? ?-bin_file? ?-reference_bitfile reference_bitfile? ?-cell cell? ?-no_partial_bitfile? file ?-quiet? ?-verbose?}
        description {Writes a bitstream file for the current project, and must be run on an open implemented design. Besides the binary bit file the command can generate a raw ASCII bit file, a mask file, readback files, a logic location file, a headerless bin file, and an incremental bitstream relative to a reference bit file. Compression is enabled by the BITSTREAM.GENERAL.COMPRESS property and encryption by the BITSTREAM.ENCRYPTION properties on the implemented design; the file extension must be .bit if one is given.}
        returns {Nothing.}
        example {write_bitstream -raw_bitfile C:/Data/design1}
        source {Xilinx UG835 2026.1}
    }
}
command write_bmm {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite the BMM file if it already exists.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_bmm ?-force? file ?-quiet? ?-verbose?}

    hover {
        summary {Write a BMM file.}
        synopsis {write_bmm ?-force? file ?-quiet? ?-verbose?}
        description {Exports the block RAM memory map (BMM) information from the current design to the specified file, describing how individual block RAMs are grouped into a contiguous address space called an address block. For implemented designs the BMM file includes placement information, and the data2mem command uses the file to translate programming data for simulation, device programming, or software development.}
        returns {The name of the bmm file.}
        example {write_bmm C:/Data/design1.bmm}
        source {Xilinx UG835 2026.1}
    }
}
command write_bsdl {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite an existing BSDL file of the same name.}
    option -bsd -takes bsd_file \
           -detail {An existing generic BSDL file to update with post-configuration data from the current design.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_bsdl ?-force? ?-bsd bsd_file? file ?-quiet? ?-verbose?}

    hover {
        summary {Generate a design specific post-configuration BSDL file.}
        synopsis {write_bsdl ?-force? ?-bsd bsd_file? file ?-quiet? ?-verbose?}
        description {Generates a Boundary Scan Description Language (BSDL) file (.bsd) for the current design that reflects the post-configuration boundary scan architecture of the target device, because configuration can change certain connections between the boundary scan registers and pads. The command reads a pre-configuration BSDL file for the target part from the installation area and combines it with post-configuration data from the current design; the .bsd extension on the output name is optional.}
        returns {Name of the output file.}
        example {write_bsdl -force C:/Data/project/design1.bsd}
        source {Xilinx UG835 2026.1}
    }
}
command write_cfgmem {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite a file of the same name if one exists.}
    option -format -takes format -values {BIN HEX MCS} -closed \
           -detail {The format of the memory configuration file to write (required).}
    option -size -takes size \
           -detail {The size limit in MBytes of the targeted PROM device, which must be a power of 2 (required).}
    ;# NOTE(xilinx): the Arguments prose introduces the interface list with
    ;# "Valid values include", which does not assert a complete set, so the
    ;# values are left open here.
    option -interface -takes interface \
           -values {SMAPx8 SMAPx16 SMAPx32 SERIALx1 SPIx1 SPIx2 SPIx4 SPIx8 BPIx8 BPIx16} \
           -detail {The interface used to program the PROM device, defaulting to SMAPx8, which also determines whether byte swapping is enabled.}
    option -checksum \
           -detail {Calculate a 32-bit checksum for each file, filling device memory with the default value of 0xFF unless a different byte value is specified.}
    option -disablebitswap \
           -detail {Disable the default bit swapping of the bits within a byte for bit files.}
    option -loadbit -takes loadbit \
           -detail {Load bit files into memory from the given address, given as a string of the form "up|down 0x0 bitfile1.bit bitfile2.bit" whose arguments may repeat to load from different starting addresses.}
    option -loaddata -takes loaddata \
           -detail {Load data files into memory from the given address, given in the same string form as -loadbit, with the data added as is and no additional formatting.}
    option -loadpdi -takes loadpdi \
           -detail {Load PDI files into memory from the given address.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_cfgmem ?-force? -format format -size size ?-interface interface? ?-checksum? ?-disablebitswap? ?-loadbit loadbit? ?-loaddata loaddata? ?-loadpdi loadpdi? file ?-quiet? ?-verbose?}

    hover {
        summary {Create files for programming flash memory.}
        synopsis {write_cfgmem ?-force? -format format -size size ?-interface interface? ?-checksum? ?-disablebitswap? ?-loadbit loadbit? ?-loaddata loaddata? ?-loadpdi loadpdi? file ?-quiet? ?-verbose?}
        description {Formats a design specific configuration bitstream file, and any specified data files, into a memory configuration file in MCS, BIN, or HEX format that program_hw_cfgmem can program into a flash memory device. Although both -loadbit and -loaddata are marked optional, at least one must be used to provide the data for the file, and the bitstream and data files must fit into the available memory without colliding or the command fails. By default the bits within a byte are bit-swapped compared to the input bitstream unless -disablebitswap is given.}
        returns {Nothing.}
        example {write_cfgmem -format MCS -size 64 -loadbit "up 0x0 \
C:/Data/Vivado_Debug/project_debug/project_debug.runs/impl_1/sinegen_demo.bit" \
config_memory1}
        source {Xilinx UG835 2026.1}
    }
}
command write_checkpoint {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -force -detail {Overwrite an existing checkpoint file of the same name.}
    option -cell -takes cell \
           -detail {Write a checkpoint of this hierarchical cell only; only one cell can be specified.}
    option -logic_function_stripped \
           -detail {Convert the INIT strings on LUTs and block RAMs to fixed values, hiding them and leaving a netlist that is nonfunctional in simulation or synthesis.}
    option -encrypt \
           -detail {Encrypt unprotected modules using IEEE 1735 IP security version 2.}
    option -key -takes key_file \
           -detail {The key file to use with -encrypt; without it the Xilinx public key is used.}
    ;# NOTE(xilinx): -incremental_synth is documented in the Arguments prose but
    ;# appears in neither the Syntax line nor the Usage table, so it is recorded
    ;# as an option row and left out of the form.
    option -incremental_synth \
           -detail {Enable the synthesis checkpoint to be used for subsequent incremental synthesis runs (not listed in the Syntax line).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_checkpoint ?-force? ?-cell cell? ?-logic_function_stripped? ?-encrypt? ?-key key_file? ?file? ?-quiet? ?-verbose?}

    hover {
        summary {Write a checkpoint of the current design.}
        synopsis {write_checkpoint ?-force? ?-cell cell? ?-logic_function_stripped? ?-encrypt? ?-key key_file? ?file? ?-quiet? ?-verbose?}
        description {Saves the design at any point in the design process into a design checkpoint (DCP) that can contain the netlist, the constraints, and any placement and routing information from the implemented design, so it can be imported again with read_checkpoint. In project mode a DCP has no timing constraints after synthesis, so create the checkpoint after opt_design or after the implementation run completes to capture them. A .dcp extension is added if none is specified.}
        returns {The name of the checkpoint file.}
        example {write_checkpoint C:/Data/checkpoint1 -force}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command write_chipscope_cdc {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_chipscope_cdc file ?-quiet? ?-verbose?}

    hover {
        summary {Export nets that are connected to debug ports.}
        synopsis {write_chipscope_cdc file ?-quiet? ?-verbose?}
        description {Writes a ChipScope Definition and Connection (CDC) file containing the debug cores, ports, and signals defined in the current project, as added by create_debug_core. The CDC file stores information about source files, destination files, core parameters, and core settings for the ChipScope Pro Analyzer, and can be read back into other projects with read_chipscope_cdc. If the path is not specified as part of the file name, the file is written into the current working directory.}
        returns {Name of the output file.}
        example {write_chipscope_cdc bft.cdc}
        source {Xilinx UG835 2012.2}
    }
}
command write_csv {
