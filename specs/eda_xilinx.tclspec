command save_design {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -force \
           -detail {Save the active constraint files regardless of whether any changes have been made, overwriting the target UCF if necessary.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -writes

    form Default {save_design ?-force? ?-quiet? ?-verbose?}

    hover {
        summary {Save the current design.}
        synopsis {save_design ?-force? ?-quiet? ?-verbose?}
        description {Saves any changes to the constraint files of the active constraint set, writing them to the project data on disk so that work in progress is saved and changes are committed.}
        returns {Nothing.}
        example {save_design -force}
        source {Xilinx UG835 2012.2}
    }
}
command save_design_as {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -dir -takes dir \
           -detail {Directory into which the constraint files of the active constraint set are copied, preserving relative paths.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -writes

    form Default {save_design_as ?-dir dir? ?-quiet? ?-verbose? name}

    hover {
        summary {Save the current design as a new set of constraints.}
        synopsis {save_design_as ?-dir dir? ?-quiet? ?-verbose? name}
        description {Saves the active constraint set as a new constraint set with local copies of any constraint files that are part of it, leaving the design name unchanged, which allows what-if development of design constraints without affecting the current constraint files. The new constraint set is referenced by the design but is not active until the constrset property of specific runs is set to point at it.}
        returns {Nothing.}
        example {save_design_as -dir C:/Data/con1 newCon}
        source {Xilinx UG835 2012.2}
    }
}
