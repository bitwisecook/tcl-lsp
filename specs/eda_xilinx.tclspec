    required_package vivado

    arity 0..

    option -base_platform -takes checkpoint -detail {Base platform DCP path.}
    option -wrapper -takes checkpoint -detail {Wrapper DCP path.}
    option -output -takes file_name -detail {Output DCP name.}
    option -reconfig_platform -takes platform_name -detail {Reconfigurable platform name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {generate_shx_platform ?-base_platform checkpoint? ?-wrapper checkpoint? ?-output file_name? ?-reconfig_platform platform_name? ?-quiet? ?-verbose?}

    hover {
        summary {Move HD.RECONFIGURABLE and related properties to sub-cells.}
        synopsis {generate_shx_platform ?-base_platform checkpoint? ?-wrapper checkpoint? ?-output file_name? ?-reconfig_platform platform_name? ?-quiet? ?-verbose?}
        description {Moves the HD.RECONFIGURABLE property and the properties related to it from the reconfigurable platform onto its sub-cells, writing the result to the output DCP.}
