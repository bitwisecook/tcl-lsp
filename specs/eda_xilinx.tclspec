}
command delete_waivers {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -scoped \
           -detail {Interpret object wildcards in the waiver as scoped to the current_instance that is set.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_waivers ?-scoped? ?-quiet? ?-verbose? ?objects?}

    hover {
        summary {Delete one or more DRC, methodology, or CDC message waivers.}
        synopsis {delete_waivers ?-scoped? ?-quiet? ?-verbose? ?objects?}
        description {Removes waivers from the design, taking a list of waiver objects as returned by get_waivers, or a list of message objects such as cells, nets, or sites for which DRC or methodology waivers were set. Waivers are created with create_waiver to let violations reported by report_drc, report_methodology, or report_cdc be passed over so the design flow can move forward.}
        returns {Nothing.}
        example {delete_waivers [get_waivers -type DRC]}
        source {Xilinx UG835 2026.1}
    }
}
command describe {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {describe ?-quiet? ?-verbose? hdl_object}

    hover {
        summary {Describe an HDL object by printing type and declaration information.}
        synopsis {describe ?-quiet? ?-verbose? hdl_object}
        description {Describes a single HDL object such as a variable, signal, wire, or reg by printing type and declaration information as well as the path and file information for its HDL source. HDL objects include Verilog wire and reg entities and VHDL signals, Verilog real, realtime, time, and event variables, and constants such as Verilog parameters and localparams and VHDL generics and constants. Use report_objects for a brief report on multiple HDL objects.}
        returns {The description of the selected objects.}
        source {Xilinx UG835 2026.1}
    }
}
command detect_hw_sio_links {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -force \
           -detail {Delete existing link objects and re-detect links by examining all GTs so the current hardware configuration is properly reflected.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {detect_hw_sio_links ?-force? ?-quiet? ?-verbose?}

    hover {
        summary {Automatically detect links between RX and TX endpoints and create a new link group to contain them.}
        synopsis {detect_hw_sio_links ?-force? ?-quiet? ?-verbose?}
        description {Detects existing or previously defined communication pathways between GT transmitters and receivers defined on the open hardware target, using changing transmit patterns and detecting links on received patterns. A transmitter or receiver of an individual GT on the IBERT debug core can only be used in one hw_sio_link at a time, so GTs already used in links are not checked unless -force clears the existing links first. The command defines the found links and creates a link group to associate them.}
        returns {A new hardware SIO link group of found links.}
        example {detect_hw_sio_links}
        source {Xilinx UG835 2026.1}
    }
}
command disconnect_bd_intf_net {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {disconnect_bd_intf_net ?-quiet? ?-verbose? intf_net objects}

    hover {
        summary {Disconnect an interface net.}
        synopsis {disconnect_bd_intf_net ?-quiet? ?-verbose? intf_net objects}
        description {Disconnects a single interface net in the IP integrator subsystem design from the specified interface pin or port objects, without deleting the whole net; use delete_bd_objs to delete the net itself. The net can be given by name or as a single object returned by get_bd_intf_nets, while the pins and ports must be given as objects returned by get_bd_intf_pins or get_bd_intf_ports.}
        returns {TCL_OK, TCL_ERROR if failed.}
        example {disconnect_bd_intf_net [get_bd_intf_nets] \
[get_bd_intf_pins -of_objects [get_bd_intf_nets]] \
[get_bd_intf_ports -of_objects [get_bd_intf_nets]]}
        source {Xilinx UG835 2026.1}
    }
}
command disconnect_bd_net {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {disconnect_bd_net ?-quiet? ?-verbose? net objects}

    hover {
        summary {Disconnect a net from the specified objects.}
        synopsis {disconnect_bd_net ?-quiet? ?-verbose? net objects}
        description {Disconnects a single net in the IP integrator subsystem design from the specified pin or port objects, without deleting the whole net; use delete_bd_objs to delete the net itself. The net can be given by name or as a single object returned by get_bd_nets, while the pins and ports must be given as objects returned by get_bd_pins or get_bd_ports.}
        returns {TCL_OK, TCL_ERROR if failed.}
        example {disconnect_bd_net /vidout1_locked [get_bd_pins {vidOut1/locked newMod1/t1}]}
        source {Xilinx UG835 2026.1}
    }
}
command disconnect_debug_port {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -channel_index -takes index \
           -detail {Channel index of the port to disconnect; the entire port is disconnected when it is not specified.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {disconnect_debug_port ?-channel_index index? ?-quiet? ?-verbose? port}

    hover {
        summary {Disconnect nets and pins from debug port channels.}
        synopsis {disconnect_debug_port ?-channel_index index? ?-quiet? ?-verbose? port}
        description {Disconnects signals from a debug port, named as core_name/port_name, that were connected with the connect_debug_port command. A port can also be removed from the debug core altogether with delete_debug_port. Use get_debug_ports to list all ports on a core, and report_debug_core to list all cores in the project and their parameters.}
        returns {Nothing.}
        example {disconnect_debug_port myCore/PROBE1}
        source {Xilinx UG835 2026.1}
    }
}
command disconnect_hw_server {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {disconnect_hw_server ?-quiet? ?-verbose? ?hw_server?}

    hover {
        summary {Close a connection to a hardware server.}
        synopsis {disconnect_hw_server ?-quiet? ?-verbose? ?hw_server?}
        description {Disconnects the current or specified hardware server from the Vivado Design Suite. The server must be given as a hw_server object returned by get_hw_servers or current_hw_server; if none is given, the current_hw_server is disconnected, after which there is no defined current hardware server until a new one is set.}
        returns {Nothing if successful; an error if it fails.}
        example {disconnect_hw_server [get_hw_server picasso]}
        source {Xilinx UG835 2026.1}
    }
}
command disconnect_net {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -prune \
           -detail {Remove the net and any pin or net chain up to the pin on any primitive instance, as long as each object in the chain has only one remaining connection.}
    option -net -takes net \
           -detail {Net to disconnect; when not specified the net attached to the first pin or port object is used.}
    option -objects -takes names \
           -detail {String list of pin and port names to disconnect, where string expressions representing patterns are supported.}
    option -pinlist -takes pins \
           -detail {List of pin and port objects to disconnect, recommended over -objects because first-class objects are processed much faster.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {disconnect_net ?-prune? ?-net net? ?-objects names? ?-pinlist pins? ?-quiet? ?-verbose?}

    hover {
        summary {Disconnect a net from pins or ports.}
        synopsis {disconnect_net ?-prune? ?-net net? ?-objects names? ?-pinlist pins? ?-quiet? ?-verbose?}
        description {Disconnects a specified net from one or more pins or ports in the netlist of an open synthesized or implemented design. Netlist editing changes the in-memory view of the netlist in the current design only; changes can be saved with write_checkpoint or exported with the appropriate write command, and are not allowed on the elaborated RTL design. Each bit of a bus must be disconnected separately.}
        returns {Nothing.}
        example {disconnect_net -net dataBus[1] -objects {dataIN[1] myDMA/data[1]}}
        source {Xilinx UG835 2026.1}
    }
}
command display_hw_ila_data {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -wcfg -takes wave_config \
           -detail {View the ILA data using this Wave Config file created by save_wave_config; without it a default wave configuration is used.}
    option -reset \
           -detail {Reset the waveform window to the default configuration and display the specified ILA data.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {display_hw_ila_data ?-wcfg wave_config? ?-reset? ?-quiet? ?-verbose? ?hw_ila_datas?}

    hover {
        summary {Display hardware ILA data in the viewer.}
        synopsis {display_hw_ila_data ?-wcfg wave_config? ?-reset? ?-quiet? ?-verbose? ?hw_ila_datas?}
        description {Displays the specified ILA debug core data objects in a wave config window of the Vivado logic analyzer, defaulting to the current_hw_ila_data object. ILA debug sample data is acquired from a running device with upload_hw_ila_data and can be written to disk with write_hw_ila_data. Display characteristics are determined by the Wave Config file, which lists the wave objects to display, their display properties, and markers.}
        returns {Nothing.}
        example {read_hw_ila_data C:/hw_ila_file.ila
display_hw_ila_data [get_hw_ila_datas hw_ila_file]}
        source {Xilinx UG835 2026.1}
    }
}
command display_hw_sio_scan {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {display_hw_sio_scan ?-quiet? ?-verbose? hw_sio_scans}

    hover {
        summary {Display an existing hardware SIO scan.}
        synopsis {display_hw_sio_scan ?-quiet? ?-verbose? hw_sio_scans}
        description {Displays the specified SIO scan data objects in Scan Plots windows of the Vivado IDE, for use with the graphical serial I/O analyzer feature. The scan data can be read from a file with read_hw_sio_scan or come from a hw_sio_scan object created by run_hw_sio_scan; the type of plot displayed is determined by the scan type of the object.}
        returns {Nothing.}
        example {display_hw_sio_scan [read_hw_sio_scan C:/Data/loopback1.csv]}
        source {Xilinx UG835 2026.1}
    }
}
command encrypt {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -key -takes key_file \
           -detail {RSA key file that includes the Xilinx public key; without it the tool looks for IEEE 1735 pragmas embedded within the specified files.}
    option -lang -takes lang -values {vhdl verilog} -closed \
           -detail {HDL language of the input and output files (required).}
    option -batch -takes batch_file \
           -detail {Input file containing a list of files to be encrypted.}
    option -ext -takes extension \
           -detail {Extension to use for the encrypted output files, preserving the original source files.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {encrypt ?-key key_file? -lang lang ?-batch batch_file? ?-ext extension? ?-quiet? ?-verbose? ?files?}

    hover {
        summary {Encrypt files in place with a language specific key file in IEEE 1735.}
        synopsis {encrypt ?-key key_file? -lang lang ?-batch batch_file? ?-ext extension? ?-quiet? ?-verbose? ?files?}
        description {Encrypts Verilog or VHDL files using the IEEE 1735 encryption standard, so that third-party IP providers can protect their intellectual property while the Vivado Design Suite can still read the files for synthesis and simulation. Unless -ext is used, the specified files are encrypted in place, overwriting the input files. The command is provided with limited access and requires a special license to use.}
        returns {Nothing.}
        example {encrypt -lang verilog -key C:/Data/xilinx_rsa_key.txt C:/Data/design_1.v}
        source {Xilinx UG835 2026.1}
    }
}
command endgroup {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {endgroup ?-quiet? ?-verbose?}

    hover {
        summary {End a set of commands that can be undone or redone as a group.}
        synopsis {endgroup ?-quiet? ?-verbose?}
        description {Ends a sequence of commands started by startgroup that can be undone or redone as a series with the undo and redo commands. Multiple command groups can be undone or redone, but groups cannot be nested, so endgroup must end a sequence before startgroup begins a new one. Some Tcl commands can trigger an endgroup unexpectedly and certain commands support neither undo nor redo; the limitations are not fully defined.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command exclude_bd_addr_seg {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -target_address_space -takes address_space \
           -detail {Target address space to exclude the slave segment from.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {exclude_bd_addr_seg ?-target_address_space address_space? ?-quiet? ?-verbose? ?segment_to_exclude?}

    hover {
        summary {Exclude segment from an address space.}
        synopsis {exclude_bd_addr_seg ?-target_address_space address_space? ?-quiet? ?-verbose? ?segment_to_exclude?}
        description {Excludes the specified AXI peripheral address segment from access by the AXI master it is mapped to, in order to support sparse connectivity and eliminate unneeded device resources. Address segments are unmapped, mapped, or excluded; an excluded segment is mapped and assigned an address but is not accessible to the master, so the muxing and decoding resources needed to provide access can be eliminated. When -target_address_space names a master address space and a slave segment is given, the slave is first mapped into that space and then excluded from access by the master.}
        returns {The newly excluded segment object, "" if failed.}
        example {assign_bd_address [get_bd_addr_segs {axi_gpio_1/S_AXI/Reg }]
exclude_bd_addr_seg [get_bd_addr_segs microblaze_1/Data/SEG_axi_gpio_1_Reg]}
        source {Xilinx UG835 2026.1}
    }
}
command execute_hw_svf {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {execute_hw_svf ?-quiet? ?-verbose? file_name}

    hover {
        summary {Execute SVF file on current_hw_target.}
        synopsis {execute_hw_svf ?-quiet? ?-verbose? file_name}
        description {Converts the Serial Vector Format (SVF) commands in the named file into Vivado Tcl commands and executes them on the specified target. The command requires an open, current hw_target object whose JTAG chain matches the device chain specified in the SVF file, and is not a general purpose SVF reader: it should only be used to read and execute SVF files written by the Vivado tools with write_hw_svf.}
        returns {A transcript of its process; an error if it fails.}
        example {open_hw_target {houdini26:3121/xilinx_tcf/Digilent/210203327996A}
execute_hw_svf -verbose C:/Data/k7_design.svf}
        source {Xilinx UG835 2026.1}
    }
}
command export_as_example_design {
