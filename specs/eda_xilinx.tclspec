command get_msg_count {
    dialects tcl8.5
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the five severities are spelled out in the Arguments prose,
    ;# but the Usage table also documents ALL as the default value, so the value
    ;# set is left open.
    option -severity -takes severity -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} \
           -detail {Message severity to query, defaulting to ALL (not valid with -id).}
    option -id -takes message_id \
           -detail {Unique message id to be queried, for example Common-99 (not valid with -severity).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-severity -id}

    form Default {get_msg_count ?-severity severity? ?-id message_id? ?-quiet? ?-verbose?}

    hover {
        summary {Get message count.}
        synopsis {get_msg_count ?-severity severity? ?-id message_id? ?-quiet? ?-verbose?}
        description {Gets the number of messages, of a specific severity or message ID, that have been returned by the tool since it was invoked. By default the count for all messages is returned; the current message limit can be checked with get_msg_limit and changed with set_msg_limit.}
        returns {Message count.}
        example {get_msg_count -id "Netlist 29-28"}
        source {Xilinx UG835 2012.2}
    }
}
command get_msg_limit {
    dialects tcl8.5
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): as for get_msg_count, ALL is documented as the default
    ;# value alongside the five named severities, so the set is left open.
    option -severity -takes severity -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} \
           -detail {Message severity to query, defaulting to ALL (not valid with -id).}
    option -id -takes message_id \
           -detail {Unique message id to be queried, for example Common-99 (not valid with -severity).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-severity -id}

    form Default {get_msg_limit ?-severity severity? ?-id message_id? ?-quiet? ?-verbose?}

    hover {
        summary {Get message limit.}
        synopsis {get_msg_limit ?-severity severity? ?-id message_id? ?-quiet? ?-verbose?}
        description {Gets the number of messages that will be reported by the tool while invoked; when the limit is reached the tool stops reporting messages. The default value is 4,294,967,295 and can be changed with the set_msg_limit command.}
        returns {Message limit.}
        example {get_msg_limit -severity {CRITICAL WARNING}}
        source {Xilinx UG835 2012.2}
    }
}
