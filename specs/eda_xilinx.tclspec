}
command launch_modelsim {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -simset -takes simset \
           -detail {Name of the simulation fileset to simulate, defaulting to the current simulation fileset.}
    option -mode -takes mode -values {behavioral timing} -closed \
           -detail {Simulation mode, defaulting to behavioral.}
    option -noclean_dir -detail {Do not remove simulation run directory files prior to launching the simulator.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_modelsim ?-simset simset? ?-mode mode? ?-noclean_dir? ?-quiet? ?-verbose?}

    hover {
        summary {Launch simulation using ModelSim simulator.}
        synopsis {launch_modelsim ?-simset simset? ?-mode mode? ?-noclean_dir? ?-quiet? ?-verbose?}
        description {Launches the Mentor Graphics ModelSim or Questa Advanced Simulator tool, which must be installed and on the PATH, with the project target_simulator property set to ModelSim. The Xilinx simulation libraries must first be compiled for the target simulator with compile_simlib, and the simulator references them through the modelsim.ini file; the command returns the transcript of the simulator.}
        returns {Nothing.}
        example {launch_modelsim -mode timing}
        source {Xilinx UG835 2012.2}
    }
}
