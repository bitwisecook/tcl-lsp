    option -no_ip_version \
           -detail {Do not include the IP version as part of the IP VLNV in create_bd_cell commands.}
    option -force -detail {Create a directory if it does not exist.}
    option -directory -takes directory \
           -detail {Destination directory in which the example design needs to be generated (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {export_as_example_design -vlnv vlnv ?-no_ip_version? ?-force? -directory directory ?-quiet? ?-verbose?}

    hover {
        summary {Export current design as a static example design.}
        synopsis {export_as_example_design -vlnv vlnv ?-no_ip_version? ?-force? -directory directory ?-quiet? ?-verbose?}
        description {Writes the current design into the specified destination directory as a static example design carrying the given VLNV.}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command export_bd_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -dir -takes directory \
           -detail {Export directory.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -writes

    form Default {export_bd_design ?-dir directory? ?-quiet? ?-verbose?}

    hover {
        summary {Export a block design to SDK.}
        synopsis {export_bd_design ?-dir directory? ?-quiet? ?-verbose?}
        description {Exports the block design for use by SDK, into the directory given by -dir.}
        returns {The design object; "" if failed.}
        source {Xilinx UG835 2012.2}
