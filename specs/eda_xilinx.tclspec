command get_dfx_footprint {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -of_objects -takes object \
           -detail {The reconfigurable module cell instance or device tile the footprint is queried for; accepts one object as input and cannot be used with a search pattern.}
    option -place -detail {Return the placement footprint of the cell specified by -of_objects.}
    option -route \
           -detail {Return the routing footprint of the cell specified by -of_objects, which is a superset of the placement footprint.}
    option -pu \
           -detail {Return the programmable unit of the tile specified by -of_objects, the minimum resource set required for partial reconfiguration.}
    option -bli_tiles \
           -detail {Return the boundary logic interface (BLI) tiles connected to the given HSR tile.}
    option -frame \
           -detail {Return the tiles included within the frame of the tile specified by -of_objects.}
    option -half_frame \
           -detail {Return the tiles included within the half frame of the tile specified by -of_objects, which aligns with half of the clock region boundary.}
    option -shared \
           -detail {Return the tiles of the given cell that are shared with another reconfigurable pblock.}
    option -cell_type -takes cell_type -values {non_clock clock clock_control} -closed \
           -detail {Return the cells of this type from the reconfigurable module given by -of_objects; used only for disjoint pblocks.}
    option -site_type -takes site_type -values {hsr fsr fsr_hsr} -closed \
           -detail {Return the sites of this type from the reconfigurable module given by -of_objects; used only for disjoint pblocks.}
    option -overlap \
           -detail {Return the overlapped tiles of the routing footprint of the given cell.}
    option -prohibit \
           -detail {Return the prohibited sites of the reconfigurable module specified by -of_objects.}
    option -illegal_nodes \
           -detail {Return the illegal nodes of the reconfigurable module specified by -of_objects, or the nodes prohibited for static if no cell is specified.}
    option -illegal_clock_nodes \
           -detail {Return the illegal clock nodes of the clock net specified by -of_objects, a subset of the illegal nodes.}
    option -snapped_tiles \
           -detail {Return the tiles of the given cell that are in derived ranges by snapping and not in the XDC constraints.}
    option -is_reconfigurable \
           -detail {Return true for a reconfigurable tile specified by -of_objects, or false for a non-reconfigurable tile.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_dfx_footprint ?-regexp? ?-nocase? ?-filter expression? ?-of_objects object? ?-place? ?-route? ?-pu? ?-bli_tiles? ?-frame? ?-half_frame? ?-shared? ?-cell_type cell_type? ?-site_type site_type? ?-overlap? ?-prohibit? ?-illegal_nodes? ?-illegal_clock_nodes? ?-snapped_tiles? ?-is_reconfigurable? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get footprint tiles for different DFX flows.}
        synopsis {get_dfx_footprint ?-regexp? ?-nocase? ?-filter expression? ?-of_objects object? ?-place? ?-route? ?-pu? ?-bli_tiles? ?-frame? ?-half_frame? ?-shared? ?-cell_type cell_type? ?-site_type site_type? ?-overlap? ?-prohibit? ?-illegal_nodes? ?-illegal_clock_nodes? ?-snapped_tiles? ?-is_reconfigurable? ?-quiet? ?-verbose? ?patterns?}
        description {Used in the Dynamic Function eXchange (DFX) flow to highlight the placement and routing footprints of reconfigurable pblocks and display the overlapping tiles, and useful for debugging and analysis of DFX DRCs. It returns tiles, sites, and cells objects that are then used by create_pblock and resize_pblock to create valid reconfigurable pblocks; most arguments take the reconfigurable module cell name as the value of -of_objects, and the reconfigurable pblock must be defined before the command is run. The command is supported for Versal devices only, except that -place, -route, and -illegal_nodes are supported for UltraScale and UltraScale+ devices.}
        returns {Tiles, sites, cells, nodes.}
        example {get_dfx_footprint -pu -of_objects [get_tiles CLE_E_CORE_X27Y4]}
        source {Xilinx UG835 2026.1}
    }
}
command get_drc_checks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes ruledecks \
           -detail {Get the design rule checks associated with the specified drc_ruledeck objects, as returned by get_drc_ruledecks; cannot be used with a search pattern.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -max_abbrev -takes abbrev -detail {Get the largest ID for the abbrev.}
    option -abbrevs -takes abbrevs \
           -detail {Leading text of the DRC rule check abbreviations, getting the checks associated with the specified rule name or abbreviation.}
    option -ruledecks -takes ruledecks \
           -detail {Get the design rule checks associated with the specified rule decks; the default is the default rule deck.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_drc_checks ?-of_objects ruledecks? ?-regexp? ?-nocase? ?-filter expression? ?-max_abbrev abbrev? ?-abbrevs abbrevs? ?-ruledecks ruledecks? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of DRC rule check objects.}
        synopsis {get_drc_checks ?-of_objects ruledecks? ?-regexp? ?-nocase? ?-filter expression? ?-max_abbrev abbrev? ?-abbrevs abbrevs? ?-ruledecks ruledecks? ?-quiet? ?-verbose? ?patterns?}
        description {Gets a list of the currently defined DRC checks, including both the factory defined design rule checks and the user-defined checks created by create_drc_check. The default pattern is the wildcard * which gets all rule checks, and more than one pattern can be specified to find checks on different search criteria.}
        returns {List of DRC rule_check objects.}
        example {get_drc_checks AVAL*}
        source {Xilinx UG835 2026.1}
    }
}
command get_drc_ruledecks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes rule_checks \
           -detail {Get the DRC ruledeck objects of the associated rule check objects.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_drc_ruledecks ?-of_objects rule_checks? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of DRC rule deck objects.}
        synopsis {get_drc_ruledecks ?-of_objects rule_checks? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}
        description {Gets a list of the currently defined rule decks for use with the report_drc command. A rule deck is a collection of design rule checks grouped for convenience, to be run at different stages of the design flow such as I/O planning or placement; the tool ships a set of factory defined rule decks, and new ones can be created with create_drc_ruledeck and populated with add_drc_checks.}
        returns {Drc_ruledeck.}
        example {get_drc_ruledecks}
        source {Xilinx UG835 2026.1}
    }
}
command get_drc_violations {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {Get the violations associated with the named DRC result set, which requires report_drc to have been run with -name.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_drc_violations ?-name name? ?-regexp? ?-filter expression? ?-nocase? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of DRC violations from a previous report_drc run.}
        synopsis {get_drc_violations ?-name name? ?-regexp? ?-filter expression? ?-nocase? ?-quiet? ?-verbose? ?patterns?}
        description {Gets the violation objects found in the design when report_drc is run, either by the built-in design rule checks or by create_drc_violation inside a user-defined check. The properties of an individual violation object can be queried with report_property or list_property, and the design objects associated with a violation can be obtained through the -of_objects option of the appropriate get_ command such as get_cells or get_nets. The default search pattern is the wildcard *, or .* when -regexp is specified.}
        returns {List of DRC violation objects.}
        example {report_property [lindex [get_drc_violations] 0]}
        source {Xilinx UG835 2026.1}
    }
}
command get_example_designs {
    available {tcl 8.5}
    required_package vivado

