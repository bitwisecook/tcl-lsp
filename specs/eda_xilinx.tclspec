command connect_debug_port {
    dialects tcl8.5
    required_package vivado

    arity 2..

    option -channel_start_index -takes index \
           -detail {The channel index at which connections start to be added, numbered from 0; without it the tool uses the first available channel index.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {connect_debug_port ?-channel_start_index index? ?-quiet? ?-verbose? port nets...}

    hover {
        summary {Connect nets and pins to debug port channels.}
        synopsis {connect_debug_port ?-channel_start_index index? ?-quiet? ?-verbose? port nets...}
        description {Connects signals from the Netlist design to a port on a ChipScope debug core, either at a specific channel index or on any available channel; connecting too many signals for the available channels returns an error. The port is referenced as core_name/port_name, more ports are added with create_debug_port, port width is grown with the set_property port_width command, and signals are removed with disconnect_debug_port.}
        returns {Nothing.}
        example {create_debug_port myCore TRIG
set_property port_width 8 [get_debug_ports myCore/TRIG0]
connect_debug_port myCore/TRIG0 [get_nets [list m0_ack_o m0_cyc_i m0_err_o \
  m0_rty_o m0_stb_i m0_we_i ]] -channel_start_index 2}
        source {Xilinx UG835 2012.2}
    }
}
