        source {Xilinx UG835 2026.1}
    }
}
command set_max_time_borrow {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_max_time_borrow ?-quiet? ?-verbose? delay objects}

    hover {
        summary {Limit time borrowing for latches.}
        synopsis {set_max_time_borrow ?-quiet? ?-verbose? delay objects}
        description {Sets the maximum amount of time in nanoseconds that can be borrowed between nets when analyzing the timing on latches. The delay is a floating point number greater than or equal to 0, with a default of 0, and the objects are a list of clocks, cells, data pins, or clock pins. This command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {set_max_time_borrow 0.0 [all_clocks]}
        source {Xilinx UG835 2026.1}
    }
}
command set_msg_config {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -id -takes message_id \
           -detail {A qualifier applying the selected operation only to messages that match the given message id pattern, such as {Common 17-35}; the default is to match any id.}
    option -string -takes strings \
           -detail {A qualifier applying the selected operation only to messages that contain the given list of case-sensitive strings.}
    option -severity -takes severity -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} -closed \
           -detail {A qualifier applying the selected operation only to messages at the given severity level; the default is to match any severity.}
    ;# NOTE(xilinx): the Syntax line prints -limit unbracketed while the
    ;# Arguments prose marks it (Optional); the form follows the Syntax line and
    ;# the detail follows the prose, so no (required) marker is claimed here.
    option -limit -takes count \
           -detail {For the messages that match the qualifiers, limit the number of messages displayed to the given integer value greater than or equal to 1, or -1 to restore messaging.defaultLimit; can only be used in conjunction with one of -id or -severity.}
    option -new_severity -takes severity -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} -closed \
           -detail {For the messages that match the qualifiers, change the severity to the given value for the current project.}
    option -suppress \
           -detail {For the messages that match the qualifiers, suppress any messages for the current project.}
    option -regexp -detail {The values used for -string are full regular expressions.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_msg_config ?-id message_id? ?-string strings? ?-severity severity? -limit count ?-new_severity severity? ?-suppress? ?-regexp? ?-quiet? ?-verbose?}

    hover {
        summary {Configure how the Vivado tool will display and manage specific messages, based on message ID, string, or severity.}
        synopsis {set_msg_config ?-id message_id? ?-string strings? ?-severity severity? -limit count ?-new_severity severity? ?-suppress? ?-regexp? ?-quiet? ?-verbose?}
        description {Changes the severity of messages, limits the number of times a message is reported, or suppresses a message altogether in the current project; only one of these actions can be performed by a single command, and an error is returned if more than one is attempted. At least one qualifier of -id, -string, or -severity must be supplied, multiple qualifiers have an AND relationship, and wildcards are not supported in qualifiers. Message configuration rules are project specific, persist with the project, and are passed automatically to subordinate processes, so this command should not be used in pre and post Tcl scripts; an ERROR message cannot be downgraded to less than an error.}
        returns {Nothing.}
        example {set_msg_config -id {[Common 17-81]} -new_severity "CRITICAL WARNING"}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command set_msg_limit {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    ;# NOTE(xilinx): the Arguments prose names five severities, but the Usage
    ;# table gives ALL as the default, so the set is not marked -closed.
    option -severity -takes severity -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} \
           -detail {Message severity to be set, not valid with -id.}
    option -id -takes id -detail {Unique message id to be set, not valid with -severity.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-severity -id}

    form Default {set_msg_limit ?-severity severity? ?-id id? count ?-quiet? ?-verbose?}

    hover {
        summary {Set the limit on the number of messages returned by the tool.}
        synopsis {set_msg_limit ?-severity severity? ?-id id? count ?-quiet? ?-verbose?}
        description {Defines the number of messages returned by the tool during a design session, or single invocation. You can set the limit of a specific message ID such as "Common 17-54", or the limit for a specific message severity such as "CRITICAL WARNING", or, when neither is given, the limit for the total number of messages returned. The count is a value >= 1; a count of -1 restores the messaging.defaultLimit parameter value, as does reset_msg_limit.}
        returns {New message limit.}
        example {set_msg_limit -severity WARNING 50000}
        source {Xilinx UG835 2012.2}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command set_msg_severity {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_msg_severity id severity ?-quiet? ?-verbose?}

    hover {
        summary {Set the severity of a message by its message ID.}
        synopsis {set_msg_severity id severity ?-quiet? ?-verbose?}
        description {Sets the severity of a specified message ID from one type, such as WARNING, to another type, such as ERROR. The five severities are ERROR, CRITICAL WARNING, WARNING, INFO, and STATUS; a two word severity must be enclosed in braces or quotes. STATUS messages have no message ID, so their severity cannot be changed. The original severity of a message ID is restored with reset_msg_severity.}
        returns {Nothing.}
        example {set_msg_severity "Common 17-54" WARNING}
        source {Xilinx UG835 2012.2}
    }
}
command set_noc_phase {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -phase_group -takes group_name \
           -detail {Name of the phase group which will include or already contains the provided phase; the default is Group_Default.}
    option -phase -takes phase_name \
           -detail {Name of the phase to add or modify; the default is Phase_Default.}
    option -master_instance -takes instance \
           -detail {The master instance of the traffic path to add or modify the provided phase.}
    option -slave_instance -takes instance \
           -detail {The slave instance of the traffic path to add or modify the provided phase.}
    option -read_bandwidth -takes bandwidth \
           -detail {The read bandwidth of the phase to add or modify; the default is 0.}
    option -write_bandwidth -takes bandwidth \
           -detail {The write bandwidth of the phase to add or modify; the default is 0.}
    option -read_burst_len -takes length \
           -detail {Optional read burst length to set for the default or specified phase, applied when greater than 0; the default is -1.}
    option -write_burst_len -takes length \
           -detail {Optional write burst length to set for the default or specified phase, applied when greater than 0; the default is -1.}
    option -mode -takes mode -values {READ WRITE ALL} -closed \
           -detail {Determines whether this is a read or write phase or both; the default is ALL.}
    option -port -takes port \
           -detail {Specifies the port of a slave instance the traffic path connects to; the default is PORT0.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_noc_phase ?-phase_group group_name? ?-phase phase_name? ?-master_instance instance? ?-slave_instance instance? ?-read_bandwidth bandwidth? ?-write_bandwidth bandwidth? ?-read_burst_len length? ?-write_burst_len length? ?-mode mode? ?-port port? ?-quiet? ?-verbose?}

    hover {
        summary {Add or modify a phase to all traffic paths within the provided phase group.}
        synopsis {set_noc_phase ?-phase_group group_name? ?-phase phase_name? ?-master_instance instance? ?-slave_instance instance? ?-read_bandwidth bandwidth? ?-write_bandwidth bandwidth? ?-read_burst_len length? ?-write_burst_len length? ?-mode mode? ?-port port? ?-quiet? ?-verbose?}
        description {Adds or modifies a phase on all traffic paths within the provided phase group, describing the read and write bandwidth and optional burst lengths of a traffic path between a master instance and a port of a slave instance.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command set_package_pin_val {
    available {tcl 8.5}
    required_package vivado

    arity 3..

