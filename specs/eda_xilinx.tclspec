    option -return_string \
           -detail {Return the data as a text string for assignment to a Tcl variable.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_switching_activity ?-static_probability? ?-signal_rate? ?-file file? ?-return_string? ?-quiet? ?-verbose? ?objects?}

