        synopsis {get_hw_pcies ?-of_objects objects? ?-regexp? ?-nocase? ?-patterns patterns? ?-filter expression? ?-quiet? ?-verbose?}
        description {Gets all the Peripheral Component Interconnect Express (PCIe) debug core objects, hw_pcie objects, defined on the current hardware device. The customizable PCIe core for Versal devices is designed for evaluating and monitoring the PCIe Link Training and Status State Machine (LTSSM) running on the Gigabit Transceivers, and in the Vivado Hardware Manager the soft cores implemented in the design are represented as hw_pcie objects. This command returns a list of PCIe debug core objects on the device, or returns an error if it fails.}
        returns {PCIe cores.}
        example {get_hw_pcies}
        source {Xilinx UG835 2026.1}
    }
}
command get_hw_probes {
