command get_waivers {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table lists LINT and ALL among the -type values while
    ;# the Arguments prose names only DRC, METHODOLOGY, and CDC, so the set is left open.
    option -type -takes waiver_type -values {DRC METHODOLOGY CDC LINT ALL} \
           -detail {The type of waiver to get.}
    option -id -takes message_id \
           -detail {The ID of the DRC, METHODOLOGY, CDC, or LINT message being waived.}
    option -of_objects -takes objects \
           -detail {Get the waivers associated with the specified objects, such as cells, nets, pins, or sites.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_waivers ?-type waiver_type? ?-id message_id? ?-of_objects objects? ?-regexp? ?-filter expression? ?-nocase? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get one or more DRC/METHODOLOGY/CDC/LINT message waivers.}
        synopsis {get_waivers ?-type waiver_type? ?-id message_id? ?-of_objects objects? ?-regexp? ?-filter expression? ?-nocase? ?-quiet? ?-verbose? ?patterns?}
        description {Queries the waiver objects defined in the current design by create_waiver, which waive individual DRC, methodology, or CDC violations or rule checks so that the design flow can move forward. The command can be formed to return specific types of waivers or the waivers associated with specific objects; waivers can be reported with report_waivers and removed with delete_waivers.}
        returns {A list of waiver objects.}
        example {get_waivers -type DRC *}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command get_wave_config {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): this section's one-line heading text in UG835 is a copy of
    ;# the help command's ("Display help for one or more topics"); the summary
    ;# below is taken from the Usage table's patterns row instead.
    option -regexp -detail {Search using regular expressions; items must be strings.}
    option -nocase -detail {Perform a case-insensitive match (only used with -regexp).}
    option -filter -takes expr \
           -detail {Filter the results list with an expression over wave configuration property values such as has_time or needs_save.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_wave_config ?-regexp? ?-nocase? ?-filter expr? ?-quiet? ?-verbose? ?patterns...?}

    hover {
        summary {Search all wave configurations for the ones whose name property matches the patterns.}
        synopsis {get_wave_config ?-regexp? ?-nocase? ?-filter expr? ?-quiet? ?-verbose? ?patterns...?}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
