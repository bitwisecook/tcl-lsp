    hover {
        summary {Unhighlight objects that are currently highlighted.}
        synopsis {unhighlight_objects ?-color_index color_index? ?-rgb rgb_list? ?-color color? ?-leaf_cells? ?-quiet? ?-verbose? ?objects?}
        description {Unhighlights the specified objects that were previously highlighted by the highlight_objects command, for use in GUI mode. If no objects are specified, all highlighted objects of the specified color are unhighlighted; if no color is specified, all highlighted objects are unhighlighted.}
        returns {Nothing.}
        example {unhighlight_objects -color yellow}
        source {Xilinx UG835 2026.1}
    }
}
