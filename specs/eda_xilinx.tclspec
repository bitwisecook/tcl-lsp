        source {Xilinx UG835 2026.1}
    }
}
command delete_ip_run {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Force the deletion of the block fileset and run.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_ip_run ?-force? ?-quiet? ?-verbose? objects}

    hover {
        summary {Delete the block fileset and run associated with a given IP.}
        synopsis {delete_ip_run ?-force? ?-quiet? ?-verbose? objects}
        description {Deletes the out-of-context synthesis and implementation runs for the specified IP module, removing the contents of the run directory as well as the run. Output products copied to the IP sources folder, such as the DCP file and the Verilog and VHDL structural netlists, are not deleted, so reset_target or generate_target must be used to update them. The command requires an IP object from get_ips or get_files and will not delete a run named by a run name or a run object.}
        returns {Nothing.}
        example {delete_ip_run [get_ips add1]}
        source {Xilinx UG835 2026.1}
    }
}
command delete_macros {
