command update_bd_boundaries {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -from_bd -takes block_design \
           -detail {The block design from which the boundary is copied; optional for a block design container cell, whose active variant block design is the default.}
    option -check_only \
           -detail {Report only the changes that would be made when the boundary is copied, without saving the changes to disk.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_bd_boundaries ?-from_bd block_design? ?-check_only? ?-quiet? ?-verbose? ?of_objects?}

    hover {
        summary {Update the boundary of a block design or of the source designs of a block design container cell.}
        synopsis {update_bd_boundaries ?-from_bd block_design? ?-check_only? ?-quiet? ?-verbose? ?of_objects?}
        description {Copies the boundary ports, interfaces, port maps, port widths, and all parameters of ports and interfaces of a block design from another block design. The command may add or remove boundary ports and interfaces, which can affect existing connectivity that then has to be updated manually, and the block design whose boundary is updated must be opened first. It also updates the boundary of the variant source designs of a block design container cell from its active variant source design or a specified one; this command is not supported by undo.}
        returns {TCL_OK on success, TCL_ERROR on failure.}
        example {update_bd_boundaries [get_bd_cells /slaves]}
        source {Xilinx UG835 2026.1}
    }
}
