    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_pblock ?-hier? ?-quiet? ?-verbose? pblocks...}

    hover {
        summary {Remove Pblocks from the design.}
        synopsis {delete_pblock ?-hier? ?-quiet? ?-verbose? pblocks...}
        description {Deletes the specified Pblocks from the design. Pblocks are created with the create_pblock command.}
        returns {Nothing.}
