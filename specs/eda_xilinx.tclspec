        description {Saves the current or specified wave configuration object to a filename with a .wcfg suffix, which is assigned automatically if no other suffix is supplied. If the object has no FILE_PATH property the filename is required and the object is renamed to match it; if it has one, the filename may be omitted and the object is written to its current location.}
        returns {The wave configuration object saved.}
        example {save_wave_config -object [get_wave_configs test.wcfg] \
C:/Data/project/newTest}
        source {Xilinx UG835 2026.1}
    }
}
command scan_dr_hw_jtag {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -tdi -takes hex_value \
           -detail {The value to be scanned into the target, expressed as a hex value; the value from the last scan_dr_hw_jtag command is used when omitted.}
    option -tdo -takes hex_value \
           -detail {The hex value to be compared against the actual TDO value scanned out of the hw_jtag data register; no comparison is performed when omitted.}
    option -mask -takes hex_mask \
           -detail {Hex value mask applied when comparing TDO values, where a 1 marks a bit position to compare.}
    option -smask -takes hex_mask \
           -detail {Hex value mask applied to the TDI value, where a 1 marks a significant bit position.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {scan_dr_hw_jtag ?-tdi hex_value? ?-tdo hex_value? ?-mask hex_mask? ?-smask hex_mask? ?-quiet? ?-verbose? length}

    hover {
        summary {Perform shift DR on hw_jtag.}
        synopsis {scan_dr_hw_jtag ?-tdi hex_value? ?-tdo hex_value? ?-mask hex_mask? ?-smask hex_mask? ?-quiet? ?-verbose? length}
        description {Specifies a scan pattern to be scanned into the target data register of the hw_jtag object created when the hw_target is opened with open_hw_target -jtag_mode. The last defined HDR header property is pre-pended and the last defined TDR trailer property appended to the data pattern, the JTAG TAP is moved from its current stable state to DRSHIFT, and after the last bit is shifted the TAP moves to IDLE or to the stable state defined by run_state_hw_jtag. An error that can be trapped by catch is raised if the captured TDO data does not match the specified -tdo argument.}
        returns {Hardware TDO.}
        example {scan_dr_hw_jtag 24 -tdi 3f}
        source {Xilinx UG835 2026.1}
    }
}
command scan_ir_hw_jtag {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -tdi -takes hex_value \
           -detail {The value to be scanned into the target, expressed as a hex value; the value from the last scan_ir_hw_jtag command is used when omitted.}
    option -tdo -takes hex_value \
           -detail {The hex value to be compared against the actual TDO value scanned out of the hw_jtag instruction register; no comparison is performed when omitted.}
    option -mask -takes hex_mask \
           -detail {Hex value mask applied when comparing TDO values, where a 1 marks a bit position to compare.}
    option -smask -takes hex_mask \
           -detail {Hex value mask applied to the TDI value, where a 1 marks a significant bit position.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {scan_ir_hw_jtag ?-tdi hex_value? ?-tdo hex_value? ?-mask hex_mask? ?-smask hex_mask? ?-quiet? ?-verbose? length}

    hover {
        summary {Perform shift IR on hw_jtag.}
        synopsis {scan_ir_hw_jtag ?-tdi hex_value? ?-tdo hex_value? ?-mask hex_mask? ?-smask hex_mask? ?-quiet? ?-verbose? length}
        description {Specifies a scan pattern to be scanned into the target instruction register of the hw_jtag object created when the hw_target is opened with open_hw_target -jtag_mode. The last defined HIR header property is pre-pended and the last defined TIR trailer property appended to the data pattern, the JTAG TAP is moved from its current stable state to IRSHIFT, and after the last bit is shifted the TAP moves to IDLE or to the stable state defined by run_state_hw_jtag. An error that can be trapped by catch is raised if the captured TDO data does not match the specified -tdo argument.}
        returns {Hardware TDO.}
        example {scan_ir_hw_jtag 24 -tdi 3f}
        source {Xilinx UG835 2026.1}
    }
}
