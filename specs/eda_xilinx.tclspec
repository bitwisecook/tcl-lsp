        description {Returns the receiver objects, hw_sio_rx, of the Gigabit Transceivers that are in use on the IBERT debug core on the current hardware device. Each GT includes an independent receiver consisting of a PCS and a PMA, through which high-speed serial data flows from traces on the board into the PMA, into the PCS, and finally into the FPGA logic. This command returns a list of receiver objects on the device, or returns an error if it fails.}
        returns {Hardware SIO RXs.}
        example {get_hw_sio_rxs -of [get_hw_sio_links]}
        source {Xilinx UG835 2026.1}
    }
}
