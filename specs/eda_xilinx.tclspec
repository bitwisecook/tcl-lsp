           -detail {Specify the color to unhighlight as an RGB code given as a list of three values.}
    option -color -takes color -values {red green blue magenta yellow cyan orange} -closed \
           -detail {Specify the color to unhighlight by name.}
    option -leaf_cells -detail {Unhighlight the leaf cells of the specified objects.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

