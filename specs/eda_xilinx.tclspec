    }
}
command delete_timing_results {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    ;# NOTE(xilinx): the Usage table spells the CDC value clock_domain_crossings
    ;# while the Arguments list writes clock_domain_crossing; the Usage spelling
    ;# is used here.
    option -type -takes type \
           -values {bus_skew check_timing clock_interaction clock_domain_crossings config_timing datasheet pulse_width slack_histogram timing_path timing_summary} -closed \
           -detail {Type of timing results to clear; the default is timing_path, which deletes reports generated by report_timing.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_timing_results ?-type type? ?-quiet? ?-verbose? name}

    hover {
        summary {Clear a set of timing results from memory.}
        synopsis {delete_timing_results ?-type type? ?-quiet? ?-verbose? name}
        description {Clears the specified timing results from the named result set. Both the type of the timing report and the name of the timing report must be specified or the command will fail.}
        returns {Nothing.}
        example {delete_timing_results -type clock_interaction clkNets}
        source {Xilinx UG835 2026.1}
    }
}
