    hover {
        summary {Specify the size limit, in bytes, of the Value Change Dump (VCD) file.}
        synopsis {limit_vcd ?-quiet? ?-verbose? filesize ?VCDObject?}
        description {Models the behavior of the Verilog $dumplimit system task, limiting the size of the VCD file. If a VCDObject is not specified the command applies to the current VCD object of the active simulation; open_vcd must be run before limit_vcd.}
        returns {Nothing.}
        example {limit_vcd 1000}
        source {Xilinx UG835 2012.2}
    }
}
