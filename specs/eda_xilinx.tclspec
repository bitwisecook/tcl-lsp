command generate_mem_files {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite existing .mem files.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {generate_mem_files ?-force? ?-quiet? ?-verbose? directory}

    hover {
        summary {Write all the simulation .mem files.}
        synopsis {generate_mem_files ?-force? ?-quiet? ?-verbose? directory}
        description {For embedded processor based designs with associated Executable Linkable Files (ELF), merges the Block Memory Map (BMM) for the design with the program data in the ELF file to generate memory (MEM) files for use during simulation. A MEM file describes how individual block RAMs are grouped into a contiguous address block with the ELF data mapped into it; the file names and the number of files generated are determined by the memory map data of the processor system IP cores or IP integrator block designs.}
        returns {The name of the directory.}
        example {generate_mem_files C:/Data/gen_mem}
        source {Xilinx UG835 2026.1}
    }
}
command generate_ml_strategies {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -jobs -takes count \
           -detail {Number of parallel jobs to run on the local host; the default is 1.}
    option -details -detail {Print job details such as host, memory, and user id.}
    option -force -detail {Force regeneration of the ML strategies, overwriting previous ones.}
    option -keep_launch_dir -detail {Keep the launch directory and files for analysis.}
    option -suggestions_filter -takes expression \
           -detail {Filter for the internal call to write_qor_suggestion; the default is Category==Strategy.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {generate_ml_strategies ?-jobs count? ?-details? ?-force? ?-keep_launch_dir? ?-suggestions_filter expression? ?-quiet? ?-verbose? runs}

    hover {
        summary {Generate ML strategies for a run.}
        synopsis {generate_ml_strategies ?-jobs count? ?-details? ?-force? ?-keep_launch_dir? ?-suggestions_filter expression? ?-quiet? ?-verbose? runs}
        description {Generates ML strategies for a completed implementation run in two steps: first the ML strategy RQS files are created in the MLStrategy sub-directory of the run, then implementation runs referencing those files can be created. Flow criteria must be met for strategies to be generated: opt_design must have run with the Default or Explore directive, and place_design, phys_opt_design and route_design must have run with the same directive, either Default or Explore. This command is not supported in non-project mode.}
        example {generate_ml_strategies [get_runs impl_1] -suggestions_filter {APPLIED || Category==Strategy}}
        source {Xilinx UG835 2026.1}
    }
}
command generate_parallel_reports {
