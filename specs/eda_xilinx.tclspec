command update_design {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -cells -takes cells \
           -detail {List of hierarchical instance names or cell objects to update with a new sub-netlist (required).}
    option -strict \
           -detail {Require an exact ports match for the replacing cell, where otherwise extra ports are allowed.}
    option -from_file -takes file \
           -detail {Name of the file containing the new sub-netlist, as a structured Verilog or EDIF netlist.}
    ;# NOTE(xilinx): the Syntax line and Usage table mark -from_design as
    ;# required, while the Arguments prose says -from_file and -from_design are
    ;# mutually exclusive; both facts are recorded as documented.
    option -from_design -takes design \
           -detail {Name of an open netlist design containing the new sub-netlist (required).}
    option -from_cell -takes cell \
           -detail {Name of the cell in the from_design which defines the new sub-netlist (only with -from_design).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-from_file -from_design}

    form Default {update_design -cells cells ?-strict? ?-from_file file? -from_design design ?-from_cell cell? ?-quiet? ?-verbose?}

    hover {
        summary {Update the netlist of the current design.}
        synopsis {update_design -cells cells ?-strict? ?-from_file file? -from_design design ?-from_cell cell? ?-quiet? ?-verbose?}
        description {Updates the in-memory design, replacing the current netlist in the specified cells with a netlist from a file or from another open design. The command can update a single instance, a list of instances, or all instances of a master cell. Only the in-memory view of the design is changed, so the design must be saved with write_checkpoint or the updates are lost when the project is closed.}
        returns {Nothing.}
        example {update_design -cells arnd4 -from_file C:/Data/round_4.v}
        source {Xilinx UG835 2012.2}
    }
}
