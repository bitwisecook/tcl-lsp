command set_switching_activity {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -toggle_rate -takes toggle_rate \
           -detail {The toggle rate describing how often the output switches relative to the controlling clock, valid between 0 and 200 percent with a default of 0.0.}
    option -type -takes types \
           -values {registers inputs outputs inouts ports outputEnable three_states dsps brams bramWrite bramEnable clockEnable} \
           -detail {The type of logic entity the switching activity applies to, used with RTL power estimation.}
    option -static_probability -takes static_probability \
           -detail {The switching probability used in analysis, valid between 0 and 1 with a default of 0.0.}
    option -signal_rate -takes signal_rate \
           -detail {The signal frequency used for analysis, with a default of 0.0.}
    option -hier \
           -detail {Apply the switching activity to signals at all levels of a hierarchical instance, which should be used only with the objects argument.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_switching_activity ?-toggle_rate toggle_rate? ?-type types? ?-static_probability static_probability? ?-signal_rate signal_rate? ?-hier? ?objects...? ?-quiet? ?-verbose?}

    hover {
        summary {Set switching activity on specified objects or default types.}
        synopsis {set_switching_activity ?-toggle_rate toggle_rate? ?-type types? ?-static_probability static_probability? ?-signal_rate signal_rate? ?-hier? ?objects...? ?-quiet? ?-verbose?}
        description {Sets the signal rate and the switching probability used when performing power estimation, covering simple signal rate and static probability on nets, ports, and pins, and state dependent static probabilities on cells. One or both of -static_probability and -signal_rate must be specified. The current switching activity attributes are reported by report_switching_activity and restored to their defaults by reset_switching_activity. This command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {set_switching_activity -signal_rate 55 -static_probability .27 [get_ports]
report_switching_activity [get_ports]}
        source {Xilinx UG835 2012.2}
    }
}
command set_system_jitter {
    dialects tcl8.5
    required_package vivado

    arity 1..

