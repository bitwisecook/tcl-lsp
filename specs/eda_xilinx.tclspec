command get_wires {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -of_objects -takes objects \
           -detail {Get the wires of the specified tiles, nodes, pips, or nets.}
    option -uphill -detail {Get the wires uphill from the provided pip.}
    option -downhill -detail {Get the wires downhill from the provided pip.}
    option -from -takes start_points \
           -detail {Return the ordered list of wires beginning at these pip or site_pin objects; may be combined with -uphill, and the default is downhill.}
    option -to -takes end_points \
           -detail {Return the ordered list of wires ending at these wire or site_pin objects; may be combined with -uphill, and the default is downhill.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_wires ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-uphill? ?-downhill? ?-from start_points? ?-to end_points? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of wires.}
        synopsis {get_wires ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-uphill? ?-downhill? ?-from start_points? ?-to end_points? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the wires in the design that match the search patterns in an open design; the default pattern is the wildcard * which gets all wires in the design.}
        returns {A list of wire objects.}
        example {get_wires -of_objects [get_tiles IO_INT_INTERFACE_L_X0Y198]}
        source {Xilinx UG835 2026.1}
    }
}
command group_bd_cells {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -prefix -takes prefix \
           -detail {A prefix name to apply to any cells that are moved into the hierarchical module.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {group_bd_cells ?-prefix prefix? ?-quiet? ?-verbose? ?target_cell_name? ?cells?}

    hover {
        summary {Create a hierarchical cell and move a group of cells into it.}
        synopsis {group_bd_cells ?-prefix prefix? ?-quiet? ?-verbose? ?target_cell_name? ?cells?}
        description {Creates a new hierarchical module in the current IP integrator subsystem design and moves the specified cells into it. The connections between the moved cells are maintained, and connections between those cells and cells that are not moved are maintained automatically by IP integrator adding pins and ports to cross the hierarchical boundary; cells can also be moved with move_bd_cells after the module has been created.}
        returns {0 if success.}
        example {group_bd_cells -prefix M1_ module1 [get_bd_cells /microblaze_1_xlconcat] \
[get_bd_cells /microblaze_1_axi_intc] [get_bd_cells /proc_sys_reset_1]}
        source {Xilinx UG835 2026.1}
    }
}
command has_dedicated_connection {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes pins \
           -detail {The pins to check, accepting only boundary pins of an instance as input.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {has_dedicated_connection ?-of_objects pins? ?-quiet? ?-verbose?}

    hover {
        summary {Check dedicated connectivity.}
        synopsis {has_dedicated_connection ?-of_objects pins? ?-quiet? ?-verbose?}
        description {Checks the dedicated connectivity of the pins given to -of_objects, which accepts only boundary pins of an instance as input.}
        returns {The result of the dedicated connectivity check.}
        source {Xilinx UG835 2026.1}
    }
}
command help {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -category -takes category \
           -detail {Get a list of the commands grouped under the specified command category.}
    option -args \
           -detail {Get abbreviated help text for the specified command instead of the extended help.}
    option -syntax \
           -detail {Return only the syntax line for the command as a quick reminder of its proper form.}
    option -long \
           -detail {Return the extended help description for the command, including the syntax, a brief description of the arguments, and a more detailed description with examples; this is the default.}
    option -prop -takes property \
           -detail {Return the specified property of an object class, or the properties assigned to a specific object in the current design (requires -class or a single design object).}
    option -class -takes class -detail {Return information related to the specified class of objects.}
    option -message -takes message_id \
           -detail {Return information about the message with the given unique global message ID, such as Common 17-24, which consists of an application sub-system code and a message identifier.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {help ?-category category? ?-args? ?-syntax? ?-long? ?-prop property? ?-class class? ?-message message_id? ?-quiet? ?-verbose? ?pattern_or_object?}

    hover {
        summary {Display help for one or more topics.}
        synopsis {help ?-category category? ?-args? ?-syntax? ?-long? ?-prop property? ?-class class? ?-message message_id? ?-quiet? ?-verbose? ?pattern_or_object?}
        description {Returns a long description of the specified Tcl command, or a list of available Tcl command categories, or a list of commands matching a pattern; with no arguments it returns the command categories, which group commands performing a specific function. Some features are only loaded into memory when used, so load_features may be needed before their commands and help text are reachable, and -prop with -class returns help for the properties assignable to design objects.}
        returns {The specified help text, or an error.}
        example {help *file*}
        source {Xilinx UG835 2026.1}
    }
}
command highlight_objects {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -color_index -takes color_index \
           -detail {The color index to use for highlighting, given as an integer from 1 to 20 and configured under the Highlight color settings.}
    option -rgb -takes rgb_list \
           -detail {The color to use given as an RGB code specified as a three element list of R G B values, for instance 255 255 0 for yellow.}
    option -color -takes color -values {red green blue magenta yellow cyan orange} -closed \
           -detail {The color to use for highlighting the specified objects.}
    option -leaf_cells -detail {Highlight the leaf cells of the specified objects.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {highlight_objects ?-color_index color_index? ?-rgb rgb_list? ?-color color? ?-leaf_cells? ?-quiet? ?-verbose? objects}

    hover {
        summary {Highlight objects in different colors.}
        synopsis {highlight_objects ?-color_index color_index? ?-rgb rgb_list? ?-color color? ?-leaf_cells? ?-quiet? ?-verbose? objects}
        description {Highlights the specified or selected objects in a color determined by one of the color options; only one color option should be used, but if more than one is given the order of precedence is -rgb, -color_index, and -color. Selected objects are automatically unselected so they can be displayed in the highlight color, and objects can be unhighlighted with unhighlight_objects.}
        returns {Nothing.}
        example {highlight_objects -color red [get_selected_objects]}
        source {Xilinx UG835 2026.1}
    }
}
command implement_debug_core {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {implement_debug_core ?-quiet? ?-verbose? ?cores?}

    hover {
        summary {Implement debug core.}
        synopsis {implement_debug_core ?-quiet? ?-verbose? ?cores?}
        description {Implements the AMD Vivado logic analyzer debug cores in the current project, running the tools once for any ILA debug cores specified and once more for the Debug Hub core if all cores are specified. Debug Hub and ILA cores are created initially as black boxes and must be implemented prior to place and route; implementation is automatic when an implementation run is launched with launch_runs or during opt_design, but this command implements one or more cores without implementing the whole design.}
        example {implement_debug_core [get_debug_cores]}
        source {Xilinx UG835 2026.1}
    }
}
command implement_mig_cores {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -output_dir -takes output_dir \
           -detail {Target output directory for the generated output products of the memory IP; the output is written to the current project folders if not specified.}
    option -rtl_only \
           -detail {Run the complete process to generate the PHY RTL code but do not replace the PHY core netlist.}
    option -force \
           -detail {Implement all non-optimized memory cores; when used with -rtl_only, optimized cores are included as well.}
    option -debug_output -detail {Enable the debugging feature of the memory IP.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {implement_mig_cores ?-output_dir output_dir? ?-rtl_only? ?-force? ?-debug_output? ?-quiet? ?-verbose?}

    hover {
        summary {Call IP Services to regenerate an IP, then stitch it into the current netlist.}
        synopsis {implement_mig_cores ?-output_dir output_dir? ?-rtl_only? ?-force? ?-debug_output? ?-quiet? ?-verbose?}
        description {Implements the memory IP cores in the current project, generating the RTL information for the physical interface of the memory controller and integrating the synthesized netlist of the memory controller into the top-level design. Implementation of the memory IP and debug core is automatic when an implementation run is launched with launch_runs or when opt_design is run, but this command integrates the memory IP without implementing the whole design. All pins of the memory controller must be assigned before running it, or an error is returned.}
        returns {A transcript of the process, or an error if it fails.}
        example {implement_mig_cores}
        source {Xilinx UG835 2026.1}
    }
}
command implement_xphy_cores {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -output_dir -takes output_dir \
           -detail {Target output directory for the generated output products of the memory IP; the output is generated to the current project folders if not specified.}
    option -rtl_only \
           -detail {Run the complete process to generate the PHY RTL code but do not replace the PHY core netlist.}
    option -force \
           -detail {Implement all non-optimized memory cores; when used with -rtl_only, optimized cores are included as well.}
    option -debug_output -detail {Enable the debugging feature of the memory IP.}
    option -update_delay_value_only \
           -detail {Update the latest delay value of either input or output data pins of the PHY IP in picoseconds.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {implement_xphy_cores ?-output_dir output_dir? ?-rtl_only? ?-force? ?-debug_output? ?-update_delay_value_only? ?-quiet? ?-verbose?}

    hover {
        summary {Call IP Services to regenerate an IP, then stitch it into the current netlist.}
        synopsis {implement_xphy_cores ?-output_dir output_dir? ?-rtl_only? ?-force? ?-debug_output? ?-update_delay_value_only? ?-quiet? ?-verbose?}
        description {Implements the memory IP cores and Advanced IO Wizard cores in the current project which use XPHY Logic, generating the RTL information for the physical interface of the memory controller or Advanced IO Wizard interface and integrating the synthesized netlist into the top-level design. Launching an implementation run with launch_runs or running opt_design implements these cores automatically; this command integrates them without implementing the entire design. All pins of the memory controller and Advanced IO Wizard interface must be assigned first, otherwise it returns an error.}
        returns {A transcript of the process, or an error if it fails.}
        example {implement_xphy_cores}
        source {Xilinx UG835 2026.1}
    }
}
command implement_xpm_cores {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -cells -takes cells \
           -detail {List of cells to update with a new sub-netlist (required).}
    option -param_list -takes param_list \
           -detail {Parameter lists for the provided cells; empty by default.}
    option -connectivity -takes json_file \
           -detail {JSON file defining connectivities for the dina, doutb, wea, addra, and addrb ports in case there are interface changes.}
    option -output_dir -takes output_dir \
           -detail {Target output directory for the generated XPM files.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {implement_xpm_cores -cells cells ?-param_list param_list? ?-connectivity json_file? ?-output_dir output_dir? ?-quiet? ?-verbose?}

    hover {
        summary {Call IP Services to regenerate an XPMs, then stitch it into the current netlist.}
        synopsis {implement_xpm_cores -cells cells ?-param_list param_list? ?-connectivity json_file? ?-output_dir output_dir? ?-quiet? ?-verbose?}
        description {Regenerates the Xilinx Parameterized Macros for the cells given by -cells and stitches the resulting sub-netlists into the current netlist. Parameter values for those cells are supplied with -param_list, port connectivity changes with a JSON file given to -connectivity, and the generated files are written to the directory given by -output_dir.}
        source {Xilinx UG835 2026.1}
    }
}
command import_files {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fileset -takes fileset_name \
           -detail {The fileset to which the specified source files should be added; the source fileset is used by default and an error is returned if the specified fileset does not exist.}
    option -force \
           -detail {Overwrite files of the same name in the local project directory and in the fileset.}
    option -of_objects -takes reconfig_modules \
           -detail {Reconfigurable Modules to import the files to.}
    option -norecurse \
           -detail {Do not recurse through subdirectories of any specified directories when searching for source files.}
    option -flat \
           -detail {Import all files into the imports folder without preserving their relative paths.}
    option -relative_to -takes directory \
           -detail {Import the files relative to the specified directory, preserving that path inside the local project; ignored if -flat is also specified.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {import_files ?-fileset fileset_name? ?-force? ?-of_objects reconfig_modules? ?-norecurse? ?-flat? ?-relative_to directory? ?-quiet? ?-verbose? ?files?}

    hover {
        summary {Import files and/or directories into the active fileset.}
        synopsis {import_files ?-fileset fileset_name? ?-force? ?-of_objects reconfig_modules? ?-norecurse? ?-flat? ?-relative_to directory? ?-quiet? ?-verbose? ?files?}
        description {Imports one or more files, or the source file contents of one or more directories, into the specified fileset. Unlike add_files, which adds files by reference, this command copies the files into the local project folders under the imports directory of the fileset and then adds them to the fileset. Importing many files one at a time degrades performance noticeably, so pass a single list of files to one import_files command.}
        returns {A list of file objects that were imported.}
        example {import_files -fileset constrs_1 top.ucf}
        source {Xilinx UG835 2026.1}
    }
}
command import_ip {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -srcset -takes source_set \
           -detail {The source file set to import the IP files into; the default source file set is sources_1.}
    option -name -takes name \
           -detail {A replacement name to assign to the imported IP object; may only be used when a single file is specified.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {import_ip ?-srcset source_set? ?-name name? ?-quiet? ?-verbose? ?files?}

    hover {
        summary {Import an IP file and add it to the fileset.}
        synopsis {import_ip ?-srcset source_set? ?-name name? ?-quiet? ?-verbose? ?files?}
        description {Adds an existing XCI or XCO file as an IP source into the current project and copies it into the local project directory structure. An XCI file is an IP-XACT format file containing the IP parameterization; an XCO file is a CORE Generator log file recording the customization parameters used to create the IP core. Use read_ip or add_files to add IP files by reference instead, and create_ip to create new IP from the current catalog.}
        returns {List of file objects that were added.}
        example {import_ip C:/Data/FPGA_Design/10gig_eth.xci -name IP_block1}
        source {Xilinx UG835 2026.1}
    }
}
command import_synplify {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -copy_sources \
           -detail {Copy the Synplify project source files to the local project directory structure rather than referencing them from their current location.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {import_synplify ?-copy_sources? ?-quiet? ?-verbose? file}

    hover {
        summary {Imports the given Synplify project file.}
        synopsis {import_synplify ?-copy_sources? ?-quiet? ?-verbose? file}
        description {Imports a Synplify synthesis project file with a .prj extension into the current project, including the various source files used in the synthesis run. The default is to reference the source files from their current location.}
        returns {List of file objects that were imported from the Synplify file.}
        example {create_project syn_test C:/Data/FPGA_Design/syn_test
import_synplify -copy_sources C:/Data/syn_data.prj}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
