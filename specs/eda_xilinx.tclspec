    option -norecurse -detail {Do not recursively search in the specified directories.}
    option -to_files -takes files -detail {Existing project files and directories to limit updates to.}
    option -filesets -takes filesets -detail {Fileset name.}
    option -force -detail {Overwrite imported files in the project, even if read-only, if possible.}
    option -report_only \
           -detail {Do no actual file updates, but report on updates that otherwise would have been made.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_files ?-from_files files? ?-norecurse? ?-to_files files? ?-filesets filesets? ?-force? ?-report_only? ?-quiet? ?-verbose?}

    hover {
        summary {Update files in the project with same named files from the files or directories specified.}
