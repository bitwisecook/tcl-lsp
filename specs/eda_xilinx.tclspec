command open_vcd {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -writes

    form Default {open_vcd ?file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Open a VCD file for capturing simulation output.}
        synopsis {open_vcd ?file_name? ?-quiet? ?-verbose?}
        description {Creates or opens a Value Change Dump (VCD) file and assigns it to a VCD object for the tool to capture simulation output, modeling the Verilog $dumpfile system task. When a filename is not specified the default of dump.vcd is used, and an existing VCD file is reset to a new state, overwriting its current contents. Value changes are written with checkpoint_vcd, flush_vcd, or log_vcd, collection is paused and resumed with stop_vcd and start_vcd, the size is limited with limit_vcd, and the file is closed with close_vcd; open_vcd must be used before any other *_vcd command.}
        returns {A Vcd object; the current VCD is set to this object so that current_vcd returns it.}
        source {Xilinx UG835 2012.2}
    }
}
