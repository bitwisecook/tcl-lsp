        summary {Update a fileset compile order, and possibly the top module, based on a design graph.}
        synopsis {update_compile_order ?-force_gui? ?-fileset fileset? ?-quiet? ?-verbose?}
        description {Updates the compile order of the design sources in the current project, or in the specified fileset.}
        returns {Nothing.}
        example {update_compile_order -fileset sim_1}
        source {Xilinx UG835 2026.1}
    }
}
command update_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -cells -takes cells \
           -detail {A list of names or cell objects to update with a new sub-netlist (required).}
    option -strict \
           -detail {Require an exact ports match for the replacing cell; without it, extra ports are allowed.}
    option -from_file -takes file_name \
           -detail {Name of the file containing the new sub-netlist, either a structured Verilog netlist or an EDIF netlist file.}
    option -from_design -takes design \
           -detail {Name of an open netlist design in the current project containing the new sub-netlist.}
    option -from_cell -takes cell \
           -detail {Name of the cell in the -from_design which defines the new sub-netlist, defaulting to the top-level cell (only with -from_design).}
    option -black_box -detail {Update the cell to a black box.}
    option -buffer_ports -detail {Insert buffers for all the ports of the black box.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-from_file -from_design}

    form Default {update_design -cells cells ?-strict? ?-from_file file_name? ?-from_design design? ?-from_cell cell? ?-black_box? ?-buffer_ports? ?-quiet? ?-verbose?}

    hover {
        summary {Update the netlist of the current design.}
        synopsis {update_design -cells cells ?-strict? ?-from_file file_name? ?-from_design design? ?-from_cell cell? ?-black_box? ?-buffer_ports? ?-quiet? ?-verbose?}
        description {Updates the in-memory design, replacing the current netlist in the specified cells with a netlist from a file, from another open design, or from a specified cell of a design, or converting the cell to a black box. A single instance or all instances of a master cell can be updated. Only the in-memory view of the design is changed, so the design must be saved with write_checkpoint or the updates are lost when the project is closed.}
        returns {Nothing.}
        example {update_design -cell arnd4 -from_file C:/Data/round_4.v}
        source {Xilinx UG835 2026.1}
    }
}
command update_files {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -from_files -takes files \
           -detail {An ordered list of new files and directories to use when updating the -to_files.}
    option -norecurse -detail {Disable recursive searching through the specified sub-directories.}
    option -to_files -takes files \
           -detail {The path and filename of the existing project files and directories to limit updates to.}
    option -filesets -takes filesets \
           -detail {Overwrite the files in the specified fileset with the -from_files.}
    option -force \
           -detail {Overwrite imported files in the project even if they are read-only or write restricted.}
    option -report_only \
           -detail {Do no actual file updates, but report on the updates that otherwise would have been made.}
    option -of_objects -takes objects -detail {Reconfig Module objects to update.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_files ?-from_files files? ?-norecurse? ?-to_files files? ?-filesets filesets? ?-force? ?-report_only? ?-of_objects objects? ?-quiet? ?-verbose?}

    hover {
        summary {Update files in the project based on the files or directories specified.}
        synopsis {update_files ?-from_files files? ?-norecurse? ?-to_files files? ?-filesets filesets? ?-force? ?-report_only? ?-of_objects objects? ?-quiet? ?-verbose?}
        description {Updates the specified files with the contents of specified remote files. Use this command to update a local file with the contents of its original remote file, or to replace it with the contents of a different remote file.}
        returns {List of the files updated.}
        source {Xilinx UG835 2026.1}
    }
}
command update_hw_firmware {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file_path -takes file_path \
           -detail {Optional path to the BOOT.BIN file; the default BOOT.BIN is used when omitted.}
    option -config_path -takes file_path \
           -detail {Optional path to the config.ini file; no config.ini is updated when omitted.}
    option -skip_update -detail {Skip writing the BOOT.BIN to the SmartLynq.}
    option -reset \
           -detail {Reset the SmartLynq cable after any other operations to complete the update, disconnecting the hw_server.}
    option -format \
           -detail {Format the SmartLynq cable EMMC prior to any other operations, losing any files on the cable.}
    option -flash \
           -detail {Flash the SmartLynq cable QSPI, updating the primary FSBL and Safe Mode images.}
    option -flash_only \
           -detail {Flash the SmartLynq cable QSPI, but only update the primary FSBL image.}
    option -safe_only \
           -detail {Flash the SmartLynq cable QSPI, but only update the Safe Mode image.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_hw_firmware ?-file_path file_path? ?-config_path file_path? ?-skip_update? ?-reset? ?-format? ?-flash? ?-flash_only? ?-safe_only? ?-quiet? ?-verbose? ?hw_server?}

    hover {
        summary {Update the SmartLynq firmware image.}
        synopsis {update_hw_firmware ?-file_path file_path? ?-config_path file_path? ?-skip_update? ?-reset? ?-format? ?-flash? ?-flash_only? ?-safe_only? ?-quiet? ?-verbose? ?hw_server?}
        description {Updates the firmware image of the SmartLynq cable on the specified hardware server, which defaults to the current hardware server.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command update_hw_gpio {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_hw_gpio ?-quiet? ?-verbose? ?output_enable_mask? ?output_pin_values? ?hw_server?}

    hover {
        summary {Update the SmartLynq GPIO PMOD pin values.}
        synopsis {update_hw_gpio ?-quiet? ?-verbose? ?output_enable_mask? ?output_pin_values? ?hw_server?}
        description {Updates the GPIO PMOD pin values on the specified hardware server, which defaults to the current hardware server. The output enable mask is an 8 bit hex mask that enables output pins on the GPIO, defaulting to all output pins disabled, and the output pin values are an 8 bit hex value, defaulting to all output pins driven low.}
        returns {All GPIO PMOD pin values.}
        source {Xilinx UG835 2026.1}
    }
}
command update_ip_catalog {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -rebuild \
           -detail {Rebuild the complete IP catalog index, or just the index for the repository specified by -repo_path.}
    option -add_ip -takes ip \
           -detail {Add the specified IP into the specified repository, given as a path to the IP's component.xml or to a zip file containing the IP; requires -repo_path.}
    option -delete_ip -takes ip \
           -detail {Remove the specified IP from the specified repository, given as a path to the IP's component.xml or its VLNV; requires -repo_path.}
    option -delete_mult_ip -takes ips \
           -detail {Remove the specified IPs from the specified repository, given as a list of paths to component.xml files or of VLNVs; requires -repo_path.}
    option -disable_ip -takes ip \
           -detail {Disable the specified IP from the specified repository, given as a path to the IP's component.xml or its VLNV; requires -repo_path.}
    option -enable_ip -takes ip \
           -detail {Enable the specified disabled IP from the specified repository, given as a path to the IP's component.xml or its VLNV; requires -repo_path.}
    option -add_interface -takes file_path \
           -detail {Add the specified user-defined AXI interface into the repository, given as a path to the interface's XML file.}
    option -create_index \
           -detail {Cache the specified repository's data on disk to improve load time; requires -repo_path.}
    option -repo_path -takes repo_path \
           -detail {Used in conjunction with -rebuild, -add_ip, -delete_ip, -delete_mult_ip, -disable_ip, or -create_index to specify the directory of the repository on which to operate.}
    option -update_module_ref \
           -detail {Update module references from their source, such as an HDL file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_ip_catalog ?-rebuild? ?-add_ip ip? ?-delete_ip ip? ?-delete_mult_ip ips? ?-disable_ip ip? ?-enable_ip ip? ?-add_interface file_path? ?-create_index? ?-repo_path repo_path? ?-update_module_ref? ?-quiet? ?-verbose?}

    hover {
        summary {Update the IP catalog.}
        synopsis {update_ip_catalog ?-rebuild? ?-add_ip ip? ?-delete_ip ip? ?-delete_mult_ip ips? ?-disable_ip ip? ?-enable_ip ip? ?-add_interface file_path? ?-create_index? ?-repo_path repo_path? ?-update_module_ref? ?-quiet? ?-verbose?}
        description {Updates the IP catalog associated with the current design, letting you add, delete, disable, or enable individual IP cores in the catalog. Individual cores are referenced either by the path to their component.xml file or by their VLNV property. Before executing this command, repository paths can be set with set_property IP_REPO_PATHS on the current fileset.}
        returns {True for success.}
        example {set_property IP_REPO_PATHS C:/Data/IP_LIB [current_fileset]
update_ip_catalog -rebuild}
        source {Xilinx UG835 2026.1}
    }
}
command update_macro {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -absolute_grid \
           -detail {Indicates that the relative locations are specified in the absolute RPM_GRID.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_macro ?-absolute_grid? ?-quiet? ?-verbose? macro rlocs}

    hover {
        summary {Update a macro.}
        synopsis {update_macro ?-absolute_grid? ?-quiet? ?-verbose? macro rlocs}
        description {Populates a previously created macro with leaf cells and their relative placements, given as interleaved cell and site name pairs such as {cell0 XmYn cell1 XmYn}. The coordinates are relative to each other unless -absolute_grid is specified, in which case they are the RPM_X and RPM_Y coordinates of actual slices on the target device. A cell can belong to only one macro and non-primitive cells are rejected; to change the contents of an existing macro it must be deleted with delete_macro, recreated with create_macro, and updated again.}
        returns {Nothing.}
        example {create_macro usbMacro0
current_instance usbEngine0/u0
update_macro usbMacro0 {rx_active_reg X0Y0 \
   rx_err_reg X0Y0 rx_valid_reg X0Y1}}
        source {Xilinx UG835 2026.1}
    }
}
command update_module_reference {
