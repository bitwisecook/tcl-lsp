command place_pblocks {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -effort -takes effort -values {LOW MEDIUM HIGH} -closed \
           -detail {Effort level the Pblock placer should use for each Pblock, defaulting to HIGH.}
    option -utilization -takes percent \
           -detail {Percentage of device resources that should be consumed by the logic assigned to a Pblock when it is placed, where a high utilization makes the Pblock smaller but more difficult to place.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {place_pblocks ?-effort effort? ?-utilization percent? pblocks ... ?-quiet? ?-verbose?}

    hover {
        summary {Run the Pblocks placer.}
        synopsis {place_pblocks ?-effort effort? ?-utilization percent? pblocks ... ?-quiet? ?-verbose?}
        description {Places Pblocks onto the fabric of the FPGA. Pblocks must be created using the create_pblock command, and should be populated with assigned logic using the add_cells_to_pblock command. An empty Pblock will be placed as directed, but results in a Pblock covering a single CLB tile.}
        returns {Nothing.}
        example {place_pblocks -effort LOW -utilization 75 block1 block2 block3 block4 block5}
        source {Xilinx UG835 2012.2}
    }
}
