command launch_xsim {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -simset -takes simset \
           -detail {Name of the simulation fileset to simulate, defaulting to the current simulation fileset.}
    option -noclean_dir -detail {Do not remove simulation run directory files prior to launching the simulator.}
    ;# NOTE(xilinx): the Usage table spells the second mode "post-implementation"
    ;# while the Arguments prose and the section's example both spell it
    ;# post_implementation; the prose spelling is used here.
    option -mode -takes mode -values {behavioral post_implementation} -closed \
           -detail {Simulation mode, defaulting to behavioral.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_xsim ?-simset simset? ?-noclean_dir? ?-mode mode? ?-quiet? ?-verbose?}

    hover {
        summary {Launch simulation using XSim simulator.}
        synopsis {launch_xsim ?-simset simset? ?-noclean_dir? ?-mode mode? ?-quiet? ?-verbose?}
        description {Launches the Vivado integrated simulator. Launching it first runs xelab, the RTL elaborator, compiler, and linker used to create a simulation snapshot, and then launches the simulator on that snapshot; the command returns the transcript of xelab and xsim.}
        returns {Nothing.}
        example {launch_xsim -mode post_implementation}
        source {Xilinx UG835 2012.2}
    }
}
command limit_vcd {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

