    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_target ?-quiet? ?-verbose? name objects}

    hover {
        summary {Reset target data for the specified source.}
        synopsis {reset_target ?-quiet? ?-verbose? name objects}
        description {Removes the current target data for the specified IP core objects, deleting any files that were delivered when the targets were generated. The core is not removed from the current project, only the associated target data at its referenced location. Valid target names are all, synthesis, simulation, and instantiation_template; the simulation target is only available in Vivado and returns an error in PlanAhead.}
        returns {Nothing.}
        example {reset_target instantiation_template [get_ips blk_mem*]}
        source {Xilinx UG835 2012.2}
    }
}
command reset_timing {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_timing ?-quiet? ?-verbose?}

    hover {
        summary {Reset the timing information on the current design.}
        synopsis {reset_timing ?-quiet? ?-verbose?}
        description {Clears the in-memory timing data for the current design, forcing the timing engine to reevaluate the design comprehensively rather than iteratively. The command deletes the in-memory timing view, not the timing report; use delete_timing_results to delete the reported timing information.}
        returns {Nothing.}
        example {reset_timing}
        source {Xilinx UG835 2012.2}
    }
}
command reset_ucf {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_ucf ?-quiet? ?-verbose? file}

    hover {
        summary {Clear floorplan constraints read in from a file.}
        synopsis {reset_ucf ?-quiet? ?-verbose? file}
        description {Clears the placement constraints defined in the specified UCF constraints file from the current design, which requires an open design. The constraints are removed from the design but not immediately saved; the constraint file is updated when save_design rewrites the constraints, and write_ucf saves them to a new file without saving the design. The tool looks for the specified file in the constraint filesets.}
        returns {Nothing.}
        example {reset_ucf top_full.ucf}
        source {Xilinx UG835 2012.2}
    }
}
command resize_pblock {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -add -takes ranges \
           -detail {Add the specified range of slices, given as a rectangle from one corner to the diagonally opposite corner, to the Pblock.}
    option -remove -takes ranges \
           -detail {Remove the specified range of slices from the Pblock, which may break the Pblock into multiple smaller rectangles.}
    option -from -takes ranges \
           -detail {The slice or range of slices to relocate, which must be used together with -to.}
    option -to -takes ranges \
           -detail {The slice or range of slices to relocate to, which must be used with -from and must match its size.}
    option -replace \
           -detail {Remove all existing ranges, unplacing the Pblock so that it can be replaced with place_pblocks.}
    option -locs -takes treatment \
           -values {keep_all keep_only_fixed keep_none move move_unfixed trim trim_unfixed} -closed \
           -detail {How placed logic in the Pblock is handled as the Pblock is moved or resized, defaulting to keep_all.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {resize_pblock ?-add ranges? ?-remove ranges? ?-from ranges? ?-to ranges? ?-replace? ?-locs treatment? ?-quiet? ?-verbose? pblock}

    hover {
        summary {Move, resize, and add or remove UCF ranges of a Pblock.}
        synopsis {resize_pblock ?-add ranges? ?-remove ranges? ?-from ranges? ?-to ranges? ?-replace? ?-locs treatment? ?-quiet? ?-verbose? pblock}
        description {Resizes, moves, or removes the specified Pblock, which must have been created with create_pblock and placed onto the fabric of the FPGA with place_pblocks. A Pblock is a collection of slices defined by one or more independent or overlapping rectangles, and a slice is the smallest area that can be specified, so the options add slices to a rectangle, remove slices from a rectangle, or define a new rectangle for the existing Pblock.}
        returns {Nothing.}
        example {resize_pblock block3 -add SLICE_X6Y67:SLICE_X11Y71 -remove SLICE_X6Y71:SLICE_X7Y71 \
-locs keep_all}
        source {Xilinx UG835 2012.2}
    }
}
command restart {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {restart ?-quiet? ?-verbose?}

    hover {
        summary {Rewind the simulation to the post loading state, setting time to 0.}
        synopsis {restart ?-quiet? ?-verbose?}
        description {Rewinds the Vivado integrated simulator to the state just after the design was loaded, as if the design had been reloaded, and sets the simulation time to 0.}
        returns {Restart retains breakpoints, Tcl forces, and settings in the waveform viewer but clears up the effects of all other Tcl commands.}
        source {Xilinx UG835 2012.2}
    }
}
