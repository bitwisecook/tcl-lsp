command get_nodes {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects \
           -detail {Return the nodes of the specified net, tile, node, bel_pin, site_pin, wire, speed_model, or pip objects.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -uphill \
           -detail {Return the nodes uphill of the objects given to -of_objects, which precede them in the logic network.}
    option -downhill \
           -detail {Return the nodes downhill of the objects given to -of_objects, which follow them in the logic network.}
    option -flyover -detail {Return the nodes that pass through, or fly over, the specified tiles.}
    option -from -takes start_points \
           -detail {Return the nodes beginning at these pip or site_pin objects; may be combined with -uphill, and the default is downhill.}
    option -to -takes end_points \
           -detail {Return the nodes ending at these pip or site_pin objects; may be combined with -uphill, and the default is downhill.}
    option -slls_between -takes slrs \
           -detail {Take two SLRs and return the intermediate SLL nodes; may be used with -filter.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_nodes ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-uphill? ?-downhill? ?-flyover? ?-from start_points? ?-to end_points? ?-slls_between slrs? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of nodes in the device.}
        synopsis {get_nodes ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-uphill? ?-downhill? ?-flyover? ?-from start_points? ?-to end_points? ?-slls_between slrs? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the nodes on the device that match the search patterns in an open design; the default pattern is the wildcard * which gets all nodes on the device.}
        returns {A list of node objects.}
        example {get_nodes -of_objects [get_tiles CLBLM_R_X11Y158]}
        source {Xilinx UG835 2026.1}
    }
}
command get_objects {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -filter -takes expression \
           -detail {Filter the patterns according to the specified property-matching expressions.}
    ;# NOTE(xilinx): the Syntax line and Usage table spell this option -r while the
    ;# Arguments prose and every example spell it -recursive; both spellings are one
    ;# option, written here with -recursive as the row name.
    option -recursive -aliases {-r} \
           -detail {Search recursively, applying the command to the current scope and all sub-scopes of it.}
    option -local \
           -detail {Search objects in the subprogram frame selected for the current scope.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_objects ?-filter expression? ?-recursive? ?-local? ?-regexp? ?-nocase? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of HDL objects in one or more HDL scopes as per the specified pattern.}
        synopsis {get_objects ?-filter expression? ?-recursive? ?-local? ?-regexp? ?-nocase? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the HDL objects matching the search patterns in one or more HDL scopes, where HDL objects are the signals, variables, and constants defined in the Verilog or VHDL test bench and source files. A pattern may be given as a bare pattern, matched in the current scope, or as scope/pattern, naming a scope relative to the current scope; the default pattern is the wildcard * which returns all children of the current scope.}
        returns {All the objects found given the specified pattern.}
        example {current_scope ./cpuEngine
get_objects}
        source {Xilinx UG835 2026.1}
    }
}
