command reset_switching_activity {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -default \
           -detail {Reset the static probability and signal rate of the specified object.}
    ;# NOTE(xilinx): the Usage table calls this the list of valid type values
    ;# while the Arguments prose says valid logic types include them, so the set
    ;# is listed but not marked -closed.
    option -type -takes types \
           -values {io_output io_bidir_enable register lut_ram lut dsp bram_enable bram_wr_enable
                    gt_txdata gt_rxdata} \
           -detail {Reset the switching activity for the specified type of logic entity at the top level of the design, whose scope -all or -hier can widen.}
    option -hier \
           -detail {Reset the switching activity across all levels of the specified hierarchical object rather than at the current level of the hierarchy.}
    option -all \
           -detail {Reset the switching activity on nets within all instances of the specified type, and must be used with -type.}
    option -no_deassert_resets \
           -detail {Undo the -deassert_resets option if it was previously enabled with set_switching_activity.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_switching_activity ?-default? ?-type types? ?-hier? ?-all? ?-no_deassert_resets? ?-quiet? ?-verbose? ?objects?}

    hover {
        summary {Reset the switching activity on the specified objects.}
        synopsis {reset_switching_activity ?-default? ?-type types? ?-hier? ?-all? ?-no_deassert_resets? ?-quiet? ?-verbose? ?objects?}
        description {Resets the attributes of the switching activity on the specified nets, ports, pins, and cells in the design, and on all objects when none is specified. The switching activity is defined with set_switching_activity and reported with report_switching_activity; to change or reset the design defaults use set_switching_activity -default_toggle_rate or -default_static_probability instead. The command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {reset_switching_activity -default [all_outputs]}
        source {Xilinx UG835 2026.1}
    }
}
command reset_target {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_target ?-quiet? ?-verbose? name objects}

    hover {
        summary {Reset the target data for the specified source.}
        synopsis {reset_target ?-quiet? ?-verbose? name objects}
        description {Removes the current target data for the specified IP core objects, deleting the files delivered when the named targets were generated; this does not remove the core from the current project but does remove the associated target data from its referenced location. The valid target names are all to reset every target for the core, synthesis to remove the netlist files, simulation to reset the simulation netlist, and instantiation_template to reset the instantiation template.}
        example {reset_target instantiation_template [get_ips blk_mem*]}
        source {Xilinx UG835 2026.1}
    }
}
command reset_timing {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -invalid \
           -detail {Remove the invalid timing constraints as well as the valid ones, so constraints containing an error or assigned to missing objects are lost unless previously saved to a file.}
    option -clock_reservation \
           -detail {Reset the clock name reservations for auto-derived clocks as well as the valid timing constraints, so their names can be regenerated without regard to prior reserved names.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_timing ?-invalid? ?-clock_reservation? ?-quiet? ?-verbose?}

    hover {
        summary {Reset the timing information on the current design.}
        synopsis {reset_timing ?-invalid? ?-clock_reservation? ?-quiet? ?-verbose?}
        description {Clears the in-memory timing data and constraints for the current design and forces the timing engine to reevaluate the design comprehensively rather than iteratively. After clearing the constraints you must reload any needed constraints with read_xdc, as the tool does not reload them automatically. The command deletes the in-memory timing view rather than the timing report, which delete_timing_results removes.}
        example {reset_timing -invalid}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command reset_ucf {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reset_ucf ?-quiet? ?-verbose? file}

    hover {
        summary {Clear floorplan constraints read in from a file.}
        synopsis {reset_ucf ?-quiet? ?-verbose? file}
        description {Clears the placement constraints defined in the specified UCF constraints file from the current design, which requires an open design. The constraints are removed from the design but not immediately saved; the constraint file is updated when save_design rewrites the constraints, and write_ucf saves them to a new file without saving the design. The tool looks for the specified file in the constraint filesets.}
        returns {Nothing.}
        example {reset_ucf top_full.ucf}
        source {Xilinx UG835 2012.2}
    }
}
command resize_net_bus {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes index -detail {New starting index of the specified bus net.}
    option -to -takes index -detail {New ending index of the specified bus net.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {resize_net_bus ?-from index? ?-to index? ?-quiet? ?-verbose? net_bus_names}

    hover {
        summary {Resize a net bus in the current design.}
        synopsis {resize_net_bus ?-from index? ?-to index? ?-quiet? ?-verbose? net_bus_names}
        description {Resizes an existing bus net to grow it, shrink it, or renumber its current range of indexes, only one such operation being possible per command. Growing the bus by giving a range outside the current one leaves existing bits connected as they are, shrinking it by giving a range inside the current one eliminates connections to removed bits, and renumbering with a range of the same width changes the bus bit identifiers without otherwise changing connections. Netlist editing changes the in-memory view of the netlist only, not the source fileset or the design on disk, and is not allowed on the elaborated RTL design.}
        returns {Nothing.}
        example {create_net tempBus -from 23 -to 0
resize_net_bus tempBus -from -12 -to 11
resize_net_bus tempBus -from 0 -to 7}
        source {Xilinx UG835 2026.1}
    }
}
command resize_pblock {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -add -takes site_ranges \
           -detail {Add the specified range of sites to the Pblock, given as a rectangle from one corner to the diagonally opposite corner over SLICE, DSP48, RAMB18, RAMB36, or CLOCKREGION objects.}
    option -remove -takes site_ranges \
           -detail {Remove the specified range of sites from the Pblock, which may break the Pblock into several smaller rectangles.}
    option -locs -takes locs \
           -values {keep_all keep_only_fixed keep_none move move_unfixed trim trim_unfixed} -closed \
           -detail {How the placed logic in the Pblock is handled as the Pblock is moved or resized, defaulting to keep_all.}
    option -include_site_types -takes site_types \
           -detail {List of site types to include for a tile-based Pblock.}
    option -exclude_site_types -takes site_types \
           -detail {List of site types to exclude for a tile-based Pblock.}
    option -replace -detail {Remove all rectangles associated with the Pblock.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {resize_pblock ?-add site_ranges? ?-remove site_ranges? ?-locs locs? ?-include_site_types site_types? ?-exclude_site_types site_types? ?-replace? ?-quiet? ?-verbose? pblock}

    hover {
        summary {Move, resize, add, and remove Pblock site-range constraints.}
        synopsis {resize_pblock ?-add site_ranges? ?-remove site_ranges? ?-locs locs? ?-include_site_types site_types? ?-exclude_site_types site_types? ?-replace? ?-quiet? ?-verbose? pblock}
        description {Places, resizes, moves, or removes the specified Pblock, which must have been created with create_pblock. A Pblock is a group of cells assigned to one or more independent or overlapping rectangles, and the options add sites to a rectangle, remove sites from a rectangle, or define a new rectangle associated with an existing Pblock; multiple site types are added as separate rectangles.}
        example {resize_pblock pblock_1 -add {CLOCKREGION_X0Y10:CLOCKREGION_X1Y11}}
        source {Xilinx UG835 2026.1}
    }
}
command resize_pin_bus {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes index -detail {New starting index of the specified bus pin.}
    option -to -takes index -detail {New ending index of the specified bus pin.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {resize_pin_bus ?-from index? ?-to index? ?-quiet? ?-verbose? pin_bus_names}

    hover {
        summary {Resize a pin bus in the current design.}
        synopsis {resize_pin_bus ?-from index? ?-to index? ?-quiet? ?-verbose? pin_bus_names}
        description {Resizes an existing bus pin to grow it, shrink it, or renumber its current range of pin indexes, only one such operation being possible per command; pin names must be given hierarchically from the cell instance the pin is assigned to, and pins created at the top level of the design are ports resized with resize_port_bus. Growing the bus leaves existing pins connected as they are, shrinking it eliminates connections to removed bus pins, and renumbering with a range of the same width changes the pin index without otherwise changing connections. Netlist editing changes the in-memory view of the netlist only, and is not allowed on the elaborated RTL design.}
        returns {Nothing.}
        example {resize_pin_bus -from 0 -to 31 usbEngine0/myDMA/dataBus}
        source {Xilinx UG835 2026.1}
    }
}
command resize_port_bus {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes index -detail {New starting index of the specified bus port.}
    option -to -takes index -detail {New ending index of the specified bus port.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {resize_port_bus ?-from index? ?-to index? ?-quiet? ?-verbose? port_bus_names}

    hover {
        summary {Resize a port bus in the current design.}
        synopsis {resize_port_bus ?-from index? ?-to index? ?-quiet? ?-verbose? port_bus_names}
        description {Resizes an existing bus port to grow it, shrink it, or renumber its current range of port indexes, only one such operation being possible per command. Growing the bus leaves existing port indexes connected as they are, shrinking it eliminates connections to removed bus ports, and renumbering with a range of the same width changes the port index without otherwise changing connections. Netlist editing changes the in-memory view of the netlist only, not the source fileset or the design on disk, and is not allowed on the elaborated RTL design.}
        returns {Nothing.}
        example {resize_port_bus -from -16 -to 15 outPorts}
        source {Xilinx UG835 2026.1}
    }
}
command restart {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {restart ?-quiet? ?-verbose?}

    hover {
        summary {Rewind the simulation to its post-loading state, setting the time to 0.}
        synopsis {restart ?-quiet? ?-verbose?}
        description {Returns the current simulation to its initial state, as if the design had been reloaded, resetting the current simulation time to 0. The command retains breakpoints, Tcl forces, and settings in the waveform configuration window, but resets all simulation values and clears all other Tcl commands.}
        returns {Restart retains breakpoints, Tcl forces, and settings in the waveform viewer but clears up the effects of all other Tcl commands.}
        example {restart}
        source {Xilinx UG835 2026.1}
    }
}
command resume_hw_hbm_amon {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {resume_hw_hbm_amon ?-quiet? ?-verbose? hw_objects}

    hover {
        summary {Resume paused activity monitor runs for the specified hardware HBMs.}
        synopsis {resume_hw_hbm_amon ?-quiet? ?-verbose? hw_objects}
        description {Restarts a running HBM activity monitor in the Vivado hardware manager that was previously paused with pause_hw_hbm_amon, for the specified HBM activity monitor objects.}
        returns {Nothing.}
        example {resume_hw_hbm_amon [get_hw_hbms *HBM_2]}
        source {Xilinx UG835 2026.1}
    }
}
command route_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -unroute \
           -detail {Unroute the nets in the design, or those given by -nets, -pins, or -physical_nets, and route nothing.}
    option -release_memory \
           -detail {Free router memory resources for subsequent route passes without running any route pass, and is not compatible with any other option.}
    option -nets -takes nets \
           -detail {Route or unroute only the specified net objects, which must be given by get_nets.}
    option -physical_nets -detail {Route or unroute only the logic zero and logic one nets.}
    option -pins -takes pins \
           -detail {Route or unroute to the specified input pins, only the route segment between the net and pin being affected on a multiple fanout net.}
    option -directive -takes directive \
           -values {Explore AggressiveExplore NoTimingRelaxation MoreGlobalIterations HigherDelayCost
                    AdvancedSkewModeling AlternateCLBRouting RuntimeOptimized Quick Default} -closed \
           -detail {Case-sensitive routing strategy, only one being allowed per command, and compatible only with -preserve, -tns_cleanup, -quiet, and -verbose.}
    option -tns_cleanup \
           -detail {Run an optional phase at the end of routing that attempts to fix the failing paths other than the WNS path, which may reduce TNS at the cost of runtime.}
    option -no_timing_driven \
           -detail {Disable the default timing driven routing algorithm, giving faster results but ignoring timing constraints.}
    option -preserve \
           -detail {Preserve existing completed routes from the rip-up and reroute phase, for the current route_design command only.}
    option -delay \
           -detail {Direct the router to achieve the shortest routed interconnect delay while still ignoring timing constraints (only with -nets or -pins).}
    option -auto_delay \
           -detail {Direct the router to prioritize setup and hold critical paths using the defined timing constraints (only with -nets or -pins).}
    ;# NOTE(xilinx): the Syntax line and Usage table leave -max_delay and
    ;# -min_delay unbracketed, but the Arguments prose marks both (Optional) and
    ;# the section's own examples omit them; they are spelled optional here.
    option -max_delay -takes delay \
           -detail {Interconnect delay in picoseconds that the router tries not to exceed, which implies -delay and can only be used with -pins.}
    option -min_delay -takes delay \
           -detail {Interconnect delay in picoseconds that the router tries to meet or exceed, which implies -delay and can only be used with -pins.}
    option -timing_summary \
           -detail {Launch the static timing analyzer to report the post-route timing summary from actual routed delays rather than the router internal estimates.}
    option -finalize \
           -detail {Complete any partially routed connections when routing interactively.}
    option -ultrathreads \
           -detail {Enable Turbo mode routing, reducing runtime at the expense of repeatability between otherwise identical runs.}
    option -eco \
           -detail {Run the router in incremental mode after an ECO modification on a routed netlist, letting it modify existing nets as well as route new ones.}
    option -no_psir \
           -detail {Skip the Physical Synthesis in Router optimization, which by default performs interconnect retiming and clock, critical pin, LUT restructure, placement, and routing optimizations.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {route_design ?-unroute? ?-release_memory? ?-nets nets? ?-physical_nets? ?-pins pins? ?-directive directive? ?-tns_cleanup? ?-no_timing_driven? ?-preserve? ?-delay? ?-auto_delay? ?-max_delay delay? ?-min_delay delay? ?-timing_summary? ?-finalize? ?-ultrathreads? ?-eco? ?-no_psir? ?-quiet? ?-verbose?}

    hover {
        summary {Route the current design.}
        synopsis {route_design ?-unroute? ?-release_memory? ?-nets nets? ?-physical_nets? ?-pins pins? ?-directive directive? ?-tns_cleanup? ?-no_timing_driven? ?-preserve? ?-delay? ?-auto_delay? ?-max_delay delay? ?-min_delay delay? ?-timing_summary? ?-finalize? ?-ultrathreads? ?-eco? ?-no_psir? ?-quiet? ?-verbose?}
        description {Routes the nets in the current design to complete the logic connections on the target part, either automatically or iteratively so that critical nets are routed first and the level of effort and timing algorithms vary between passes; predefined strategies are selected with -directive. Routing is one step of implementation, run automatically through launch_runs in Project Mode and manually alongside opt_design, place_design, phys_opt_design, and power_opt_design in Non-Project Mode, and it can be multi-threaded through the general.maxThreads parameter of set_param. The command requires a placed design, and optimizing with opt_design before placement is recommended.}
        example {route_design -directive Explore}
        source {Xilinx UG835 2026.1}
    }
}
command run {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -all \
           -detail {Run the simulation until no event is left in the event queue, a breakpoint or valid condition is encountered, or a run time exception occurs, which is the default when no other option is given.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {run ?-all? ?-quiet? ?-verbose? ?time? ?unit?}

    hover {
        summary {Run the simulation for the specified time.}
        synopsis {run ?-all? ?-quiet? ?-verbose? ?time? ?unit?}
        description {Runs the current simulation from the current time to the specified time, or until the simulation stops; a running simulation can stop at a predetermined time, at a breakpoint in the HDL source, on a TRUE condition, when no events remain, or on a runtime error such as an out-of-bounds value. The time is a floating point number in the current simulation units, or the keyword all which is the same as -all, and the optional unit is fs, ps, ns, us, ms, or sec, defaulting to the value of time_unit.}
        example {run 300 us}
        source {Xilinx UG835 2026.1}
    }
}
command run_hw_axi {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -queue \
           -detail {Run the transactions in queue mode, allowing up to 16 read and 16 write transactions to be queued in the JTAG to AXI Master FIFO and issued back to back.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {run_hw_axi ?-queue? ?-quiet? ?-verbose? hw_axi_txns}

    hover {
        summary {Run hardware AXI read and write transactions and update the transaction status.}
        synopsis {run_hw_axi ?-queue? ?-quiet? ?-verbose? hw_axi_txns}
        description {Runs the specified hardware AXI read and write transactions on the AXI bus of the JTAG to AXI Master core and updates the transaction status on the associated hw_axi object. The transactions are created with create_hw_axi_txns and the objects can be returned by get_hw_axi_txns.}
        example {run_hw_axi [get_hw_axi_txns [get_hw_axis]]}
        source {Xilinx UG835 2026.1}
    }
}
command run_hw_hbm_amon {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {run_hw_hbm_amon ?-quiet? ?-verbose? hw_objects}

    hover {
        summary {Enable activity monitor runs for the specified hardware HBMs.}
        synopsis {run_hw_hbm_amon ?-quiet? ?-verbose? hw_objects}
        description {Runs an HBM activity monitor in the Vivado hardware manager that has been previously configured with add_hw_hbm_pc, for the specified HBM activity monitor objects. The activity monitor gives real-time access to the performance counters and temperature sensors of the integrated High-Bandwidth Memory controller on certain UltraScale+ devices, displaying read, write, and overall data throughput as well as device temperature, and capturing and exporting the data while it runs.}
        returns {The file path and name of the CSV file the collected data will be written to, or an error if it fails.}
        example {run_hw_hbm_amon [get_hw_hbms *HBM_2]}
        source {Xilinx UG835 2026.1}
    }
}
command run_hw_ila {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -trigger_now \
           -detail {Immediately trigger the ILA debug cores regardless of trigger conditions, to capture sample data at the debug ports right away.}
    option -compile_only \
           -detail {Compile the trigger state machine file to check its syntax and report compiler errors and warnings without loading or arming the device, supported only in advanced trigger mode.}
    option -file -takes file_name \
           -detail {Export the current trigger and probe configuration to a file for apply_hw_ila_trigger when TRIGGER_MODE is BASIC_ONLY, which prevents the command from arming the core and allows only one hw_ila.}
    option -force -detail {Overwrite the specified trigger file if it already exists.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {run_hw_ila ?-trigger_now? ?-compile_only? ?-file file_name? ?-force? ?-quiet? ?-verbose? ?hw_ilas?}

    hover {
        summary {Arm the hardware ILA debug cores.}
        synopsis {run_hw_ila ?-trigger_now? ?-compile_only? ?-file file_name? ?-force? ?-quiet? ?-verbose? ?hw_ilas?}
        description {Arms the triggers and runs the specified Integrated Logic Analyzer debug cores on the current hardware device, the current_hw_ila being used when none is given; the trigger configurations held in the hw_ila and hw_probe objects are written to the target device and the cores are armed. The core is configured beforehand with set_property on CONTROL properties such as DATA_DEPTH, WINDOW_COUNT, TRIGGER_POSITION, TRIGGER_MODE, TRIGGER_CONDITION, TSM_FILE, TRIG_OUT_MODE, CAPTURE_MODE, and CAPTURE_CONDITION. With the core armed, wait_on_hw_ila suspends the script until the sample buffers fill, upload_hw_ila_data brings the captured data into a hw_ila_data object, display_hw_ila_data shows it in the waveform window, and reset_hw_ila restores the defaults.}
        example {run_hw_ila -file C:/Data/trigger_config1}
        source {Xilinx UG835 2026.1}
    }
}
command run_hw_sio_scan {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {run_hw_sio_scan ?-quiet? ?-verbose? hw_sio_scans}

    hover {
        summary {Run hardware serial I/O analyzer link scans.}
        synopsis {run_hw_sio_scan ?-quiet? ?-verbose? hw_sio_scans}
        description {Runs analysis on the specified serial I/O analyzer link scan objects, which must be objects returned by create_hw_sio_scan or get_hw_sio_scans; scanning a link with the specialized Eye Scan hardware of UltraScale devices or 7 series FPGAs helps analyze its margin. In a Tcl script wait_on_hw_sio_scan suspends the script while the scan completes, stop_hw_sio_scan stops a running scan, write_hw_sio_scan saves it to disk, and remove_hw_sio_scan removes the scan object.}
        returns {The hw_sio_scan object, or an error if the command fails.}
        example {run_hw_sio_scan [lindex [get_hw_sio_scans {SCAN_3}] 0]}
        source {Xilinx UG835 2026.1}
    }
}
command run_hw_sio_sweep {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {run_hw_sio_sweep ?-quiet? ?-verbose? hw_sio_sweeps}

    hover {
        summary {Run hardware serial I/O analyzer link sweeps.}
        synopsis {run_hw_sio_sweep ?-quiet? ?-verbose? hw_sio_sweeps}
        description {Runs analysis on the specified serial I/O analyzer sweep scan objects, which must be objects returned by get_hw_sio_sweeps; a sweep is a collection of link scans run across a range of GT configuration settings, which helps determine which settings suit the design. In a Tcl script wait_on_hw_sio_sweep suspends the script while the sweep completes, stop_hw_sio_sweep stops a running sweep, write_hw_sio_sweep saves it to disk, and remove_hw_sio_sweep removes the sweep object.}
        returns {The hw_sio_sweep object, or an error if the command fails.}
        example {run_hw_sio_sweep [lindex [get_hw_sio_sweeps {SWEEP_0}] 0]}
        source {Xilinx UG835 2026.1}
    }
}
command run_noc_compiler {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {run_noc_compiler ?-quiet? ?-verbose?}

    hover {
        summary {Execute the NOC compiler.}
        synopsis {run_noc_compiler ?-quiet? ?-verbose?}
        description {Executes the network on chip compiler.}
        source {Xilinx UG835 2026.1}
    }
}
command run_state_hw_jtag {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    ;# NOTE(xilinx): the Arguments prose says valid states include the listed
    ;# ones, so the set is listed but not marked -closed.
    option -state -takes states \
           -values {IDLE RESET DRSELECT DRCAPTURE DRSHIFT DRPAUSE DREXIT1 DREXIT2 DRUPDATE
                    IRSELECT IRCAPTURE IRSHIFT IRPAUSE IREXIT1 IREXIT2 IRUPDATE} \
           -detail {Valid path sequence of states to transition the hw_jtag object from its current state to the target stable state.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {run_state_hw_jtag ?-state states? ?-quiet? ?-verbose? stable_state}

    hover {
        summary {Change to a stable state of a specified transition.}
        synopsis {run_state_hw_jtag ?-state states? ?-quiet? ?-verbose? stable_state}
        description {Transitions the hw_jtag object of the current hardware target to the specified TAP stable state, which must be IDLE, RESET, DRPAUSE, or IRPAUSE; the hw_jtag object is created when a hardware target is opened in JTAG mode with open_hw_target -jtag_mode. When -state gives a path list it must contain every state needed to reach the target state or the command returns an error, and when it is omitted the command uses the tool's own state transition paths from the current state to the target state.}
        returns {The target stable state when successful, or an error if it fails.}
        example {run_state_hw_jtag RESET}
        source {Xilinx UG835 2026.1}
    }
}
command runtest_hw_jtag {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -wait_state -takes stable_state \
           -values {IDLE RESET IRPAUSE DRPAUSE} -closed \
           -detail {TAP stable state to go to while waiting, defaulting to IDLE.}
    option -end_state -takes stable_state \
           -values {IDLE RESET IRPAUSE DRPAUSE} -closed \
           -detail {TAP stable state to transition into after the wait operation has completed, defaulting to IDLE.}
    option -sec -takes seconds \
           -detail {32-bit decimal integer specifying the minimum number of seconds to wait.}
    option -max_wait -takes seconds \
           -detail {Maximum number of seconds to wait in the wait state, acting as a timeout.}
    option -tck -takes cycles \
           -detail {32-bit decimal integer specifying the number of JTAG clock cycles to wait.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {runtest_hw_jtag ?-wait_state stable_state? ?-end_state stable_state? ?-sec seconds? ?-max_wait seconds? ?-tck cycles? ?-quiet? ?-verbose?}

    hover {
        summary {Force the IEEE 1149.1 TAP state machine to a stable state for a specified wait period.}
        synopsis {runtest_hw_jtag ?-wait_state stable_state? ?-end_state stable_state? ?-sec seconds? ?-max_wait seconds? ?-tck cycles? ?-quiet? ?-verbose?}
        description {Specifies a wait operation for the hw_jtag state machine, naming the TAP stable state to wait in, the wait time as a number of TCK cycles or as a minimum and optional maximum time in seconds, and the stable state to go to once the wait completes. Both -wait_state and -end_state default to IDLE, and when either is given the hw_jtag object first transitions to the wait state and afterwards to the end state, with subsequent commands reusing the same states until they are changed. If the command cannot meet the wait time specification it raises an exception that the Tcl catch command can trap.}
        returns {The end stable state, or an error if it fails.}
        example {runtest_hw_jtag -tck 1000 -end_state DRPAUSE}
        source {Xilinx UG835 2026.1}
    }
}
command save_bd_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

