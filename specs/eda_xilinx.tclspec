    hover {
        summary {Select objects in the GUI.}
        synopsis {select_objects ?-add? ?-quiet? ?-verbose? objects}
        description {Selects the specified objects in the appropriate open views in GUI mode, for display purposes only; use get_selected_objects to return the selected objects for use in other commands, and unselect_objects to unselect them. Secondary objects may be selected in addition to the primary object, controlled by the Selection Rules defined under Tools then Options.}
        returns {Nothing.}
        example {select_objects [get_sites SLICE_X56Y214]}
        source {Xilinx UG835 2012.2}
    }
}
command set_default_switching_activity {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -toggle_rate -takes rate \
           -detail {The toggle rate describing how often the output switches relative to the controlling clock, valid between 0 and 200 percent.}
    option -static_probability -takes value \
           -detail {The switching probability to use in analysis, valid between 0 and 1.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_default_switching_activity ?-toggle_rate rate? ?-static_probability value? ?-quiet? ?-verbose? types}

    hover {
        summary {Set default switching activity on specified types.}
        synopsis {set_default_switching_activity ?-toggle_rate rate? ?-static_probability value? ?-quiet? ?-verbose? types}
        description {Sets the default seed values of the switching activity used by the vector-less propagation engine for a broad class of signals during power estimation, where the valid types are input, input_set, input_reset, input_enable, register, dsp, bram_read_enable, bram_write_enable, output_enable, clock, and all. Static power is often dependent on logic state transitions and dynamic power is directly proportional to the toggle rate; the current values can be inspected with report_default_switching_activity and restored with reset_default_switching_activity, while set_switching_activity defines the activity of individual signals. The command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {set_default_switching_activity -toggle_rate 85 dsp}
        source {Xilinx UG835 2012.2}
    }
}
command set_delay_model {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -interconnect -takes model -values {estimated actual none} -closed \
           -detail {Interconnect delay model used for timing analysis, defaulting to actual.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_delay_model ?-interconnect model? ?-quiet? ?-verbose?}

    hover {
        summary {Set the interconnect delay model for timing analysis.}
        synopsis {set_delay_model ?-interconnect model? ?-quiet? ?-verbose?}
        description {Sets the interconnect delay model for timing analysis to actual, estimated, or none. With actual, the delay from the routed interconnect is used, with estimated delay covering any unrouted portion of a partially routed design; with estimated, the delay is estimated from the placement and connectivity of the design even when it is fully routed; with none, no interconnect delay is included and only logic delay is applied. The command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {set_delay_model -interconnect estimated}
        source {Xilinx UG835 2012.2}
    }
}
command set_external_delay {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -from -takes from_port -detail {The output port name (required).}
    option -to -takes to_port -detail {The input port name (required).}
    option -min \
           -detail {The delay_value is a minimum delay value for hold time analysis.}
    option -max -detail {The delay_value is a maximum delay value for setup analysis.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_external_delay -from from_port -to to_port ?-min? ?-max? ?-quiet? ?-verbose? delay_value}

    hover {
        summary {Set the external delay between an output and an input port.}
        synopsis {set_external_delay -from from_port -to to_port ?-min? ?-max? ?-quiet? ?-verbose? delay_value}
        description {Sets the external feedback delay between an output and an input port, which is used in the calculation of the PLL or MMCM compensation delay for PLLs and MMCMs with external feedback. By default the value applies to both the min (hold) and max (setup) compensation delays, and the delay value defaults to 0.}
        returns {Nothing.}
        example {set_external_delay -from [get_ports ClkOut] -to [get_ports ClkFb] 1.0}
        source {Xilinx UG835 2012.2}
    }
}
command set_input_jitter {
