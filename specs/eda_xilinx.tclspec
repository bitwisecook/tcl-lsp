    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -of_objects -takes objects \
           -detail {Get the SLRs of the specified device, tiles, sites, bels, site_pins, bel_pins, clock_regions, nodes, pips, pins, package_pins, iobanks, or cells.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_slrs ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of slrs.}
        synopsis {get_slrs ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-quiet? ?-verbose? ?patterns?}
        description {Gets the super logic regions (SLRs) on the target device that match the search patterns; the default pattern is the wildcard * which gets all SLRs in the current design. On devices that do not contain multiple SLRs, SLR0 is returned.}
        returns {A list of slr objects.}
        example {get_property NUM_SLLS [get_slrs SLR0]}
        source {Xilinx UG835 2026.1}
    }
}
command get_speed_models {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects \
           -detail {Get the speed models for the specified node, bel, pip, or cell objects.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -patterns -takes patterns \
           -detail {Match the speed_model objects against these patterns; the default is the wildcard *.}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -speed_pattern -takes speed_pattern \
           -detail {Return the single model that exactly matches this pattern.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_speed_models ?-of_objects objects? ?-regexp? ?-nocase? ?-patterns patterns? ?-filter expression? ?-speed_pattern speed_pattern? ?-quiet? ?-verbose?}

    hover {
        summary {Get a list of speed_models in the device.}
        synopsis {get_speed_models ?-of_objects objects? ?-regexp? ?-nocase? ?-patterns patterns? ?-filter expression? ?-speed_pattern speed_pattern? ?-quiet? ?-verbose?}
        description {Gets the speed models for UltraScale architecture device resources in the current design. Speed files are provided for each device and speed grade and contain the speed models for nodes, pips, and bels, covering setup and hold, propagation delays, and jitter; the objects returned are the models associated with specific physical resources and can include capacitance and resistance values and buffer models, with delays given in nanoseconds.}
        returns {A list of speed_model objects.}
        example {set x [get_speed_models -of [get_bels SLICE_X0Y0/A6LUT]]
puts [format "%6.3f : %s" [get_property DELAY [lindex $x 0 ]] \
[get_property NAME [lindex $x 0 ]]]}
        source {Xilinx UG835 2026.1}
    }
}
command get_stacks {
