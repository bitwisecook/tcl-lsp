command create_ip {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -vlnv -takes vlnv \
           -detail {The colon-delimited Vendor:Library:Name:Version string of the catalog IP the new IP is created from, mapping to the IPDEF property.}
    option -module_name -takes module_name \
           -detail {The name for the new IP instance added to the project (required).}
    option -dir -takes dir \
           -detail {The directory to write the IP core files into; without it they are written under the project sources directory.}
    option -force \
           -detail {Overwrite an existing IP instance of the same module name, allowed only with -dir.}
    option -allow_hidden -detail {Allow hidden cores to be instantiated.}
    option -vendor -takes vendor -detail {The vendor name of the IP creator.}
    option -library -takes library -detail {The IP library from which the core should be added.}
    option -name -takes name -detail {The name of the IP core in the catalog.}
    option -version -takes version -detail {The version number of the IP core.}
    option -revision -takes revision -detail {The IP core revision.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_ip ?-vlnv vlnv? -module_name module_name ?-dir dir? ?-force? ?-allow_hidden? ?-vendor vendor? ?-library library? ?-name name? ?-version version? ?-revision revision? ?-quiet? ?-verbose?}

    hover {
        summary {Create an instance of a configurable IP and add it to the fileset.}
        synopsis {create_ip ?-vlnv vlnv? -module_name module_name ?-dir dir? ?-force? ?-allow_hidden? ?-vendor vendor? ?-library library? ?-name name? ?-version version? ?-revision revision? ?-quiet? ?-verbose?}
        description {Creates an XCI file for a configurable IP core from the IP catalog and adds it to the source files of the current project, creating an IP source object that must be instantiated in the HDL design. Either -vlnv or all of -vendor, -library, -name, and -version must be given. Use create_ip once per customization of the same core, and import_ip to read existing XCI and XCO files without going through a catalog.}
        returns {The list of file objects that were added.}
        example {create_ip -vlnv xilinx.com:ip:c_addsub:11.0 -module_name test_addr}
        source {Xilinx UG835 2026.1}
    }
}
command create_ip_run {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force \
           -detail {Force the creation of an IP run even if the generated output products for the IP are all current.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_ip_run ?-force? ?-quiet? ?-verbose? objects}

    hover {
        summary {Create a run for the given IP.}
        synopsis {create_ip_run ?-force? ?-quiet? ?-verbose? objects}
        description {Defines synthesis and implementation runs for a single IP object from get_ips or a single IP core file from get_files, used to generate the synthesis design checkpoint supporting the out-of-context IP flow. Two runs are created and named after the IP core and run type, the required IP source files are copied into the IP run directory, and the run attributes can then be configured with set_property.}
        returns {The name of the synthesis run created for the IP module.}
        example {create_ip_run [get_ips add1]}
        source {Xilinx UG835 2026.1}
    }
}
command create_macro {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_macro ?-quiet? ?-verbose? name}

    hover {
        summary {Create a macro for the relative placement of cells.}
        synopsis {create_macro ?-quiet? ?-verbose? name}
        description {Defines a macro in an open synthesized or implemented design for relative placement by place_design, like an RPM defined by the RLOC constraint in RTL sources, to place small groups of associated cells together. Cells are assigned to the macro with update_macro; an existing macro cannot be overwritten, so it must be removed with delete_macro and recreated, and get_macros lists the currently defined macros.}
        returns {Nothing.}
        example {create_macro usbMacro1}
        source {Xilinx UG835 2026.1}
    }
}
command create_net {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes from -detail {The starting index of a new bus.}
    option -to -takes to \
           -detail {The ending index of a new bus; giving one of -from or -to without the other results in a one-bit bus at that index.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_net ?-from from? ?-to to? ?-quiet? ?-verbose? nets}

    hover {
        summary {Create nets in the current design.}
        synopsis {create_net ?-from from? ?-to to? ?-quiet? ?-verbose? nets}
        description {Creates new nets in the netlist of an open Synthesized or Implemented Design, at the top level or within any level of the hierarchy by giving a hierarchical net name, with increasing or decreasing bus indexes. New nets are unconnected at creation and must be connected with connect_net; netlist editing changes the in-memory view of the netlist only, is not allowed on the elaborated RTL design, and nets cannot be added to library macros or macro-primitives.}
        returns {Nothing.}
        example {create_net tempBus -from 23 -to 0}
        source {Xilinx UG835 2026.1}
    }
}
command create_noc_connection {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -source -takes source -detail {The source NoC master interface (required).}
    option -target -takes target -detail {The target NoC slave interface (required).}
    option -fileset -takes fileset -detail {Fileset to use for the block model.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_noc_connection -source source -target target ?-fileset fileset? ?-quiet? ?-verbose? ?path?}

    hover {
        summary {Create a NoC connection.}
        synopsis {create_noc_connection -source source -target target ?-fileset fileset? ?-quiet? ?-verbose? ?path?}
        description {Creates a NoC connection between two NoC endpoints in the modular NoC flow, where NoC XPMs are connected to AXI endpoints in RTL, allowing connections between NMUs and NSUs in the NoC XPMs, memory controller ports, and other NoC endpoints. The endpoints are obtained with get_noc_interfaces, and NoC QoS attributes are added as properties of the created connection object.}
        returns {The created NoC connection object.}
        example {set con_1 [create_noc_connection \
-source [get_noc_interfaces /my_design/M_AXI_nmu] \
-target [get_noc_interfaces /my_design/M_AXI_nsu]]}
        source {Xilinx UG835 2026.1}
    }
}
command create_noc_interface {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -type -takes type -detail {The NoC interface type, AXIMM by default.}
    option -mode -takes mode -detail {The NoC interface mode, NMU or NSU (required).}
    option -category -takes category -detail {The NoC interface category, PL by default.}
    option -fileset -takes fileset -detail {Fileset to use for the block model.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_noc_interface ?-type type? -mode mode ?-category category? ?-fileset fileset? ?-quiet? ?-verbose? path}

    hover {
        summary {Create a NoC interface.}
        synopsis {create_noc_interface ?-type type? -mode mode ?-category category? ?-fileset fileset? ?-quiet? ?-verbose? path}
        description {Creates a NoC interface, most commonly on the module boundary of a DFX region, to break a NoC connection into two segments: one inside the reconfigurable partition up to the interface, and a second from the interface in the static region. For a NoC connection to cross a reconfigurable partition, the interface name created in the reconfigurable module and the one created in the static region must match.}
        returns {Nothing.}
        example {create_noc_interface -mode vnsu my_interface_name}
        source {Xilinx UG835 2026.1}
    }
}
command create_partition_def {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name -detail {The name to assign to the new partitionDef (required).}
    option -module -takes module \
           -detail {The name of the hierarchical cell or module that defines the partitionDef and its hierarchical boundary (required).}
    option -library -takes library \
           -detail {The library name to assign to the partitionDef, xil_defaultlib when omitted.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_partition_def -name name -module module ?-library library? ?-quiet? ?-verbose?}

    hover {
        summary {Create a new PartitionDef.}
        synopsis {create_partition_def -name name -module module ?-library library? ?-quiet? ?-verbose?}
        description {Defines a partition definition object in a Dynamic Function eXchange project from a hierarchical cell, giving the partition hierarchy that reconfigurable modules are assigned to for a specific configuration. The project must first be made a DFX project by setting the PR_FLOW property on the project to TRUE; reconfigurable modules are then defined to fit within the hierarchical boundary of the partitionDef.}
        returns {The name of the newly created partitionDef, or an error if the command fails.}
        example {create_partition_def -name partDef1 -module fftTop \
-library xil_defaultlib}
        source {Xilinx UG835 2026.1}
    }
}
command create_pblock {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_pblock ?-quiet? ?-verbose? name}

    hover {
        summary {Create a new Pblock.}
        synopsis {create_pblock ?-quiet? ?-verbose? name}
        description {Defines a Pblock to which logic instances can be added for floorplanning purposes. Logic elements are added with add_cells_to_pblock and the Pblock is placed, moved, and resized on the device fabric with resize_pblock; Pblocks can be nested for hierarchical floorplanning by setting the PARENT property with set_property.}
        returns {A new pblock object.}
        example {create_pblock pb_cpuEngine}
        source {Xilinx UG835 2026.1}
    }
}
command create_peripheral {
    available {tcl 8.5}
    required_package vivado

    arity 4..

    option -dir -takes dir \
           -detail {An output directory to store the AXI peripheral data files, outside the project source directory structure.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_peripheral ?-dir dir? ?-quiet? ?-verbose? vendor library name version}

    hover {
        summary {Create a peripheral with a VLNV.}
        synopsis {create_peripheral ?-dir dir? ?-quiet? ?-verbose? vendor library name version}
        description {Creates an AXI peripheral to add to the IP repository with the specified Vendor:Library:Name:Version attribute, which identifies it in the IP catalog. The created peripheral is only a framework until interfaces are added with add_peripheral_interface and it is generated with generate_peripheral; a peripheral stored outside the project should have its directory added to the IP_REPO_PATHS property of the current fileset to appear in the catalog.}
        returns {The created AXI peripheral object.}
        example {create_peripheral {myCompany.com} {user} {testAXI1} {1.3} -dir {C:/Data/new_periph}}
        source {Xilinx UG835 2026.1}
    }
}
command create_pin {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes from -detail {The starting index of a bus pin.}
    option -to -takes to -detail {The ending index of a bus pin.}
    option -direction -takes direction -values {IN OUT INOUT} -closed \
           -detail {The direction of the pin (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_pin ?-from from? ?-to to? -direction direction ?-quiet? ?-verbose? pins}

    hover {
        summary {Create pins in the current design.}
        synopsis {create_pin ?-from from? ?-to to? -direction direction ?-quiet? ?-verbose? pins}
        description {Adds single pins or bus pins to the netlist of an open Synthesized or Implemented Design, with increasing or decreasing bus indexes. Pin names must be given hierarchically from the cell instance the pin belongs to, or an error is returned; a pin at the top level of the design is a port and must be created with create_port. Netlist editing changes the in-memory view of the netlist only, is not allowed on the elaborated RTL design, and pins cannot be added to library macros or macro-primitives.}
        returns {Nothing.}
        example {create_pin -direction IN cpuEngine/inPin}
        source {Xilinx UG835 2026.1}
    }
}
command create_port {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -direction -takes direction -values {IN OUT INOUT} -closed \
           -detail {The direction of the port (required).}
    option -from -takes from \
           -detail {The beginning index of a new bus, which may be a negative index value.}
    option -to -takes to \
           -detail {The ending index of a new bus, which may be a negative index value.}
    option -diff_pair \
           -detail {Create the port as a differential pair, adding a positive side port and a negative side port named after negative_name or after name with an _N suffix.}
    option -interface -takes interface \
           -detail {Assign the port to the specified interface, which must first be defined with create_interface.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_port -direction direction ?-from from? ?-to to? ?-diff_pair? ?-interface interface? ?-quiet? ?-verbose? name ?negative_name?}

    hover {
        summary {Create a scalar or bus port.}
        synopsis {create_port -direction direction ?-from from? ?-to to? ?-diff_pair? ?-interface interface? ?-quiet? ?-verbose? name ?negative_name?}
        description {Creates a port at the top level of the design hierarchy with the given direction, width, and single-ended or differential form, optionally assigned to an existing interface. The command can be used in an I/O Planning project or while editing the netlist of an open Synthesized or Implemented design; netlist editing changes the in-memory view of the netlist only and is not allowed on the elaborated RTL design.}
        returns {The list of port objects that were created.}
        example {create_port -direction IN PORT0}
        source {Xilinx UG835 2026.1}
    }
}
command create_port_on_reconfigurable_module {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -cell -takes cell \
           -detail {The HD.RECONFIGURABLE cell name for port punching (required).}
    option -port -takes port \
           -detail {The name of the port newly added on the given HD.RECONFIGURABLE cell (required).}
    option -direction -takes direction -values {INPUT OUTPUT INOUT} -closed \
           -detail {The direction of the port (required).}
    option -from -takes from -detail {The lower boundary of the port bus, -1 by default.}
    option -to -takes to -detail {The higher boundary of the port bus, -1 by default.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_port_on_reconfigurable_module -cell cell -port port -direction direction ?-from from? ?-to to? ?-quiet? ?-verbose?}

    hover {
        summary {Generate a port on a given reconfigurable cell.}
        synopsis {create_port_on_reconfigurable_module -cell cell -port port -direction direction ?-from from? ?-to to? ?-quiet? ?-verbose?}
        description {Punches a new port of the given name and direction onto the specified HD.RECONFIGURABLE cell, optionally as a bus delimited by the lower and higher boundaries given by -from and -to.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command create_power_rail {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -power_sources -takes power_sources \
           -detail {A list of power sources, which can be power rails and power supplies.}
    option -phased_power_source -takes phased_power_source \
           -detail {A pair of a phased power source and its phase value, where the power source can be a phased power rail.}
    option -direct -detail {Indicate that the power rail is a direct rail.}
    option -num_phases -takes num_phases -detail {The number of phases.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_power_rail ?-power_sources power_sources? ?-phased_power_source phased_power_source? ?-direct? ?-num_phases num_phases? ?-quiet? ?-verbose? name}

    hover {
        summary {Create a new power rail.}
        synopsis {create_power_rail ?-power_sources power_sources? ?-phased_power_source phased_power_source? ?-direct? ?-num_phases num_phases? ?-quiet? ?-verbose? name}
        description {Creates a new power rail object of the given name, fed by the listed power sources or by a phased power source and its phase value, and optionally marked as a direct rail with a given number of phases.}
        returns {A new power_rail object.}
        source {Xilinx UG835 2026.1}
    }
}
command create_pr_configuration {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name -detail {The name to give to the new PR configuration (required).}
    option -partitions -takes partitions \
           -detail {The partition instance and reconfigurable module pairs of the configuration, each written as partitionInstance:RM and given as a list when several pairs are defined.}
    option -greyboxes -takes greyboxes \
           -detail {Partition instances to be defined as greyboxes, populated with LUT1s and signal buffers.}
    option -use_netlist \
           -detail {Use the netlist to get the instances of partition definitions when creating configurations.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_pr_configuration -name name ?-partitions partitions? ?-greyboxes greyboxes? ?-use_netlist? ?-quiet? ?-verbose?}

    hover {
        summary {Create a new PR configuration.}
        synopsis {create_pr_configuration -name name ?-partitions partitions? ?-greyboxes greyboxes? ?-use_netlist? ?-quiet? ?-verbose?}
        description {Defines the combination of static logic and reconfigurable modules that forms a unique configuration of a Partial Reconfiguration design, which is the design that gets implemented and has a bitstream generated for it. The project must first be made a PR project by setting the PR_FLOW property on the project to TRUE, and implementation runs for the configuration are created with create_run -pr_config.}
        returns {The name of the newly created PR configuration, or an error if the command fails.}
        example {create_pr_configuration -name prConfig1 -partitions fftEngine:fftTop}
        source {Xilinx UG835 2026.1}
    }
}
command create_project {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -part -takes part \
           -detail {The target part for the project, which can be changed later; not supported in Vivado Lab Edition.}
    option -force -detail {Overwrite an existing project directory of the same name.}
    option -in_memory \
           -detail {Create the project in the in-memory database to support the Non-Project design flow, writing no project file or directory to disk.}
    option -ip \
           -detail {Create a project for the Managed IP flow; not supported in Vivado Lab Edition.}
    option -rtl_kernel \
           -detail {Create the project for defining an RTL kernel for the Vitis core development kit.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_project ?-part part? ?-force? ?-in_memory? ?-ip? ?-rtl_kernel? ?-quiet? ?-verbose? ?name? ?dir?}

    hover {
        summary {Create a new project.}
        synopsis {create_project ?-part part? ?-force? ?-in_memory? ?-ip? ?-rtl_kernel? ?-quiet? ?-verbose? ?name? ?dir?}
        description {Creates a Vivado Design Suite project file (.xpr), or a Vivado Lab Edition project file (.lpr), in the specified directory, along with a project data folder. The first argument without a preceding keyword is the project name and the second is the directory, which is created if it does not exist. The default project is an RTL project; the project type is changed by setting the DESIGN_MODE property on the current fileset to RTL, GateLvl, or PinPlanning.}
        returns {A new project object.}
        example {create_project project1 myDesigns}
        source {Xilinx UG835 2026.1}
    }
}
command create_property {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -description -takes description \
           -detail {A description of the property being created, returned by the Vivado help system when the property is queried.}
    ;# NOTE(xilinx): the Usage table and the Arguments prose list different type
    ;# literals (file only in the table; string_list, int_list, and double_list only in
    ;# the prose), so no value set is given.
    option -type -takes type \
           -detail {The type of property to create, such as string, int, long, double, bool, or enum; string by default.}
    option -enum_values -takes enum_values \
           -detail {A braced, space-separated list of the values an enumerated property can have, usable only with -type enum.}
    option -default_value -takes default_value \
           -detail {The default value to assign to the property, for string, int, bool, and enum type properties.}
    option -file_types -takes file_types -detail {File type extensions, written without the dot.}
    option -display_text -takes display_text \
           -detail {Text to display when selecting the file in the file browser.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_property ?-description description? ?-type type? ?-enum_values enum_values? ?-default_value default_value? ?-file_types file_types? ?-display_text display_text? ?-quiet? ?-verbose? name class}

    hover {
        summary {Create a property for a class of objects.}
        synopsis {create_property ?-description description? ?-type type? ?-enum_values enum_values? ?-default_value default_value? ?-file_types file_types? ?-display_text display_text? ?-quiet? ?-verbose? name class}
        description {Creates a new property of the given type with a user-defined, case sensitive name for the specified class of objects: design, net, cell, pin, port, pblock, interface, or fileset. The property can then be assigned to an object of that class with set_property, but is not automatically associated with all objects of the class, and report_property -all does not report it for an object until it has been assigned.}
        returns {The property that was created, or "" on failure.}
        example {create_property -type int COUNT pin}
        source {Xilinx UG835 2026.1}
    }
}
command create_qor_check {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {The check ID to create, recommended to follow the format RQS_category_company-number for a suggestion or RQA_category_company-number for an assessment (required).}
    option -type -takes type -values {suggestion assessment} -closed \
           -detail {The type of QoR check to create, suggestion by default.}
    option -rule_body -takes rule_body \
           -detail {The name of the Tcl proc to execute as part of the check, which must already be sourced and visible in Vivado (required).}
    option -property_values -takes property_values \
           -detail {The properties of the new check, given as a Tcl list of key value pairs, including the mandatory ones for the check type (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_qor_check -name name ?-type type? -rule_body rule_body -property_values property_values ?-quiet? ?-verbose?}

    hover {
        summary {Create a new report_qor_suggestion or report_qor_assessment check.}
        synopsis {create_qor_check -name name ?-type type? -rule_body rule_body -property_values property_values ?-quiet? ?-verbose?}
        description {Registers a user-defined Quality of Results check, associating a Tcl proc with a unique check ID and setting the properties of the check. Suggestion checks analyze a design and offer suggestions to improve synthesis and implementation results, while assessment checks are guiding metrics that report when recommended limits of a part are exceeded. The proc must be sourced so it is visible in Vivado before registering; mandatory properties such as DESCRIPTION and CATEGORY must be set at creation time, the check can be added to a ruledeck with add_qor_checks, and it is then run by report_qor_suggestions or report_qor_assessment.}
        returns {Nothing.}
        example {create_qor_check -type suggestion -name RQS_NETLIST_AMD-1 -rule_body unroll_srl_to_input \
-property_values [list APPLICABLE_FOR $af CATEGORY $cat DESCRIPTION $desc SUMMARY $sum]}
        source {Xilinx UG835 2026.1}
    }
}
command create_qor_ruledeck {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -type -takes type -values {suggestion assessment} -closed \
           -detail {The type of QoR ruledeck to create, suggestion by default.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_qor_ruledeck ?-type type? ?-quiet? ?-verbose? ruledecks}

    hover {
        summary {Create new QoR ruledecks.}
        synopsis {create_qor_ruledeck ?-type type? ?-quiet? ?-verbose? ruledecks}
        description {Creates one or more user-defined QoR rule decks, which group QoR checks for use when running report_qor_suggestions or report_qor_assessment. A rule deck only contains checks with the same TYPE property, checks are added with add_qor_checks and cannot be removed, and a whole rule deck can be removed with delete_qor_ruledeck. The same name may be used for both an assessment and a suggestion rule deck, so -type assessment is needed to retrieve the assessment one.}
        returns {The QoR rule decks created.}
        example {create_qor_ruledeck -type suggestion AMD_Netlist_OptDesign}
        source {Xilinx UG835 2026.1}
    }
}
command create_reconfig_module {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {The name for the reconfigurable module being created (required).}
    option -top -takes top \
           -detail {The top-level cell, given by name, that defines the hierarchy of the reconfigurable module.}
    option -gate_level \
           -detail {Indicate that the module is defined by a netlist file (EDIF or DCP) rather than by RTL source files, allowing only DCP and EDIF files to be added.}
    option -partition_def -takes partition_def \
           -detail {The partitionDef the reconfigurable module is assigned to, given by name or as an object from get_partition_defs (required).}
    option -define_from -takes define_from \
           -detail {The hierarchical cell in the current project whose source files define the contents of the reconfigurable module.}
    option -define_from_file -takes define_from_file \
           -detail {The full path of the netlist or DCP file that defines the source for a gate-level reconfigurable module.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_reconfig_module -name name ?-top top? ?-gate_level? -partition_def partition_def ?-define_from define_from? ?-define_from_file define_from_file? ?-quiet? ?-verbose?}

    hover {
        summary {Create a new reconfigurable module.}
        synopsis {create_reconfig_module -name name ?-top top? ?-gate_level? -partition_def partition_def ?-define_from define_from? ?-define_from_file define_from_file? ?-quiet? ?-verbose?}
        description {Defines a reconfigurable module from a hierarchical cell or design file and assigns it to the specified Partition Definition in the current project, which must first be made a PR project by setting the PR_FLOW property on the project to TRUE. A single partitionDef can have multiple reconfigurable modules holding different netlists, constraints, or implementations, and each instance of the partitionDef can be assigned a different module to support many configurations.}
        returns {The hierarchical name of the newly created reconfigurable module, or an error if the command failed.}
        example {create_reconfig_module -name fftBottom -partition_def \
[get_partition_defs partDef1 ] -top fftTop}
        source {Xilinx UG835 2026.1}
    }
}
command create_report_config {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -report_name -takes report_name \
           -detail {The name to assign to the report when it is generated; it is derived automatically from the runs, steps, and report type when omitted, and cannot be given when creating multiple report objects.}
    option -report_type -takes report_type \
           -detail {The report command run by the report object, which may be most of the report_* Tcl commands.}
    option -steps -takes steps \
           -detail {The synthesis or implementation process steps to associate the report object with, such as synth_design, opt_design, place_design, or route_design (required).}
    option -runs -takes runs \
           -detail {The synthesis or implementation design runs to associate the report object with (required).}
    option -options -takes options \
           -detail {Command line options for the report_* command being run, stored on the OPTIONS.MORE_OPTIONS property and not checked for correctness.}
    option -copy_of -takes copy_of \
           -detail {An existing configurable report object to use as a template for the new one.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-report_type -copy_of}
    option_conflict {-options -copy_of}

    form Default {create_report_config ?-report_name report_name? ?-report_type report_type? -steps steps -runs runs ?-options options? ?-copy_of copy_of? ?-quiet? ?-verbose?}

    hover {
        summary {Create configurable report objects.}
        synopsis {create_report_config ?-report_name report_name? ?-report_type report_type? -steps steps -runs runs ?-options options? ?-copy_of copy_of? ?-quiet? ?-verbose?}
        description {Creates configurable report objects to add to synthesis and implementation runs or to Report Strategies, where a report object defines the report type and options run every time a given step of a run completes. Each object carries the OPTIONS.MORE_OPTIONS property holding the command line options of its report_* command, which can be given with -options or set later with set_property; associating an object with several steps or runs makes the report name automatic.}
        returns {The list of configurable report objects.}
        example {create_report_config -report_name post_route_datasheet -report_type report_datasheet \
-steps route_design -runs impl_1}
        source {Xilinx UG835 2026.1}
    }
}
command create_rqs_runs {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table brackets -reference_run as optional while the
    ;# Arguments prose marks it (Required); the bracketed Syntax spelling is used
    ;# here and the conflict is recorded in the option detail.
    option -reference_run -takes run \
           -detail {Reference implementation run object holding RQS strategy files in its MLStrategy folder, described as required by the Arguments prose.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_rqs_runs ?-reference_run run? ?-quiet? ?-verbose?}

    hover {
        summary {Create ML Strategy implementation runs.}
        synopsis {create_rqs_runs ?-reference_run run? ?-quiet? ?-verbose?}
        description {Creates up to three implementation runs using ML Strategies selected from an analysis of critical features in a reference design run. This is the second step of a two-step process: step one creates the ML Strategy RQS files, and this step creates the runs that reference them, copying required properties such as Tcl hooks from the reference run and setting up the directives to use RQS. It can only be used in Project mode implementation runs and for the UltraScale and UltraScale+ families.}
        returns {Nothing.}
        example {create_rqs_runs -reference_run [get_runs impl_1]}
        source {Xilinx UG835 2026.1}
    }
}
command create_run {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -constrset -takes constrset \
           -detail {Constraint set to use for the synthesis or implementation run.}
    option -parent_run -takes parent_run \
           -detail {Run that defines the netlist for this run, required for implementation runs in an RTL sources project and describing the synthesis run, implementation run, or PR configuration in the Dynamic Function eXchange flow.}
    option -part -takes part_name \
           -detail {AMD part to be used for the run; when omitted the default part defined for the project is used.}
    option -flow -takes flow_name \
           -detail {Tool flow and release version for the synthesis tool, such as Vivado Synthesis 2026 or Vivado Implementation 2026 (required).}
    option -strategy -takes strategy \
           -detail {Strategy to employ for the run; when omitted, Synthesis Defaults or Implementation Defaults is used as appropriate.}
    option -report_strategy -takes report_strategy \
           -detail {Report strategy defining a collection of report objects to run at different stages of the design flow.}
    option -pr_config -takes pr_config \
           -detail {Partition configuration to apply to the new run, as defined by create_pr_configuration.}
    option -dfx_mode -takes dfx_mode \
           -detail {Dynamic Function eXchange mode, given as Standard, Abstract Shell, or Both; Standard is the default.}
    option -rm_instance -takes rm_instance \
           -detail {Reconfigurable module instance information needed when a run is in Abstract Shell mode, in the format partition_cell:reconfigurable_module.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_run ?-constrset constrset? ?-parent_run parent_run? ?-part part_name? -flow flow_name ?-strategy strategy? ?-report_strategy report_strategy? ?-pr_config pr_config? ?-dfx_mode dfx_mode? ?-rm_instance rm_instance? ?-quiet? ?-verbose? name}

    hover {
        summary {Define a synthesis or implementation run for the current project.}
        synopsis {create_run ?-constrset constrset? ?-parent_run parent_run? ?-part part_name? -flow flow_name ?-strategy strategy? ?-report_strategy report_strategy? ?-pr_config pr_config? ?-dfx_mode dfx_mode? ?-rm_instance rm_instance? ?-quiet? ?-verbose? name}
        description {Defines a synthesis or implementation run named by the positional name argument, using the tool flow given by -flow. The attributes of the run can be further configured with the set_property command. For netlist-based projects -parent_run is not required; for an RTL sources project it must be specified for implementation runs but not for synthesis runs.}
        returns {Run object.}
        example {create_run -flow {Vivado Synthesis 2013} synth_1}
        source {Xilinx UG835 2026.1}
    }
}
command create_single_pass_run {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -reference_run -takes run \
           -detail {Top level completed Intelligent Design Run whose result is exported into a single run (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_single_pass_run -reference_run run ?-quiet? ?-verbose? name}

    hover {
        summary {Export an intelligent design run result into a single run for the current project.}
        synopsis {create_single_pass_run -reference_run run ?-quiet? ?-verbose? name}
        description {Generates a single pass design run equivalent to the multi-pass Intelligent Design Run named by -reference_run. Because Intelligent Design Runs can take the compile time of many single pass runs, the output run allows faster iterations when the design changes. The new run name must not already exist.}
        returns {Run object.}
        example {create_single_pass_run -reference_run [get_runs i_impl_1_1] new_impl_1}
        source {Xilinx UG835 2026.1}
    }
}
command create_slack_histogram {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -to -takes clocks \
           -detail {Clock name, to analyze paths that end in the specified clock domain.}
    option -delay_type -takes delay_type -values {max min min_max} -closed \
           -detail {Type of path delay to analyze when creating the slack report; the default is max.}
    option -num_bins -takes count \
           -detail {Number of slack bins to divide the results into, in the range 1 to 100; the default is 10.}
    option -max_paths -takes count \
           -detail {Maximum number of paths to analyze, specified as a value greater than or equal to 1; by default all existing critical paths are reported.}
    option -slack_less_than -takes value \
           -detail {Report slack on paths with a calculated slack value less than this; the default is 1e+30.}
    option -slack_greater_than -takes value \
           -detail {Report slack on paths with a calculated slack value greater than this; the default is -1e+30.}
    option -group -takes groups \
           -detail {Report slack for paths in these path groups, which can be listed with get_path_groups.}
    option -significant_digits -takes digits \
           -detail {Number of significant digits in the output results, in the range 0 to 3; the default is 3.}
    option -scale -takes scale -values {linear logarithmic} -closed \
           -detail {Y-axis scale to use when presenting the slack histogram in the GUI report; the default is linear.}
    option -file -takes file_name \
           -detail {Write the report into this file, overwriting an existing file unless -append is also specified.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it (only with -file).}
    option -details \
           -detail {Provide a detailed table of the analyzed timing paths, listing each endpoint pin or port with its source and destination clock and timing corner.}
    option -no_header -detail {Do not write a header to the report.}
    option -name -takes name \
           -detail {Output the results to the GUI panel with this name, overwriting the current results if that name is already open.}
    option -cells -takes cells \
           -detail {Generate the report for these hierarchical cells rather than the whole design or current instance.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_slack_histogram ?-to clocks? ?-delay_type delay_type? ?-num_bins count? ?-max_paths count? ?-slack_less_than value? ?-slack_greater_than value? ?-group groups? ?-significant_digits digits? ?-scale scale? ?-file file_name? ?-append? ?-details? ?-no_header? ?-name name? ?-cells cells? ?-quiet? ?-verbose?}

    hover {
        summary {Create a slack histogram.}
        synopsis {create_slack_histogram ?-to clocks? ?-delay_type delay_type? ?-num_bins count? ?-max_paths count? ?-slack_less_than value? ?-slack_greater_than value? ?-group groups? ?-significant_digits digits? ?-scale scale? ?-file file_name? ?-append? ?-details? ?-no_header? ?-name name? ?-cells cells? ?-quiet? ?-verbose?}
        description {Creates a slack histogram grouping paths into slack ranges and displaying the results graphically or in text format. The text report generates slack tables based on the timing corners and number of paths analyzed, with an optional detailed table giving specific information for all analyzed endpoints. The graphical histogram requires the tool to be running in GUI mode.}
        returns {Nothing.}
        example {create_slack_histogram -name slack1}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command create_sysgen {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_sysgen ?-quiet? ?-verbose? name}

    hover {
        summary {Create DSP source for Xilinx System Generator and add it to the source fileset.}
        synopsis {create_sysgen ?-quiet? ?-verbose? name}
        description {Creates a DSP sub-module for use in the current project and adds it to the source files, launching System Generator for DSP to design the hardware portion of the embedded processor system. Existing DSP model files from System Generator can instead be brought in with add_files, and the command returns the name of the DSP module created.}
        returns {Name for the new sub module.}
        example {create_sysgen DSP_mod1}
        source {Xilinx UG835 2012.2}
    }
}
command create_testbench {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {Name of the testbench module; the default is testbench.}
    ;# NOTE(xilinx): the Usage table spells the middle simulation mode
    ;# post-synthesis while the Arguments prose writes port-synthesis; the Usage
    ;# spelling is used here.
    option -mode -takes mode -values {behavioral post-synthesis post-implementation} -closed \
           -detail {Simulation mode; the default is behavioral.}
    option -type -takes type -values {functional timing} -closed \
           -detail {Netlist type, which is not applicable for behavioral mode.}
    option -add_to_simset -takes simset \
           -detail {Simulation fileset to add the generated testbench to; when omitted the currently active simulation fileset is used.}
    option -runtime -takes runtime -detail {Set the simulation runtime.}
    option -set_as_top \
           -detail {Set the generated testbench module as top in the simulation fileset where it is added.}
    option -force -detail {Overwrite an existing testbench source file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_testbench ?-name name? ?-mode mode? ?-type type? ?-add_to_simset simset? ?-runtime runtime? ?-set_as_top? ?-force? ?-quiet? ?-verbose?}

    hover {
        summary {Create a testbench for a design unit instance.}
        synopsis {create_testbench ?-name name? ?-mode mode? ?-type type? ?-add_to_simset simset? ?-runtime runtime? ?-set_as_top? ?-force? ?-quiet? ?-verbose?}
        description {Creates a functional SystemVerilog testbench for the scoped hierarchical instance, containing port and signal specification, parameter declaration, a stimuli vector include file, and a module instantiation of the selected instance as the design under test. The testbench can be added to an existing or new simulation fileset from which the simulation can be launched, and is simulator independent.}
        returns {Nothing.}
        example {create_testbench -name fifo -add_to_simset sub_design_fifo}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command create_violation {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table spells the third severity CRITICAL_WARNING
    ;# while the Arguments prose spells it "CRITICAL WARNING", so the set is left
    ;# open and the Usage spelling is carried here.
    option -name -takes name \
           -detail {The unique abbreviation for the rule in the violation library, typically 4 to 6 letters, matching the name given in register_drc_rule (required).}
    option -severity -takes severity \
           -values {FATAL ERROR CRITICAL_WARNING WARNING ADVISORY} \
           -detail {Severity level for the drc rule; the default for user-defined DRCs is WARNING.}
    option -msg -takes message \
           -detail {The message string for this drc rule, substituted for the $STR in the message specified in register_drc_rule, and it must match that -msg specification.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_violation -name name ?-severity severity? ?-msg message? ?-quiet? ?-verbose? ?objects...?}

    hover {
        summary {Create a DRC violation.}
        synopsis {create_violation -name name ?-severity severity? ?-msg message? ?-quiet? ?-verbose? ?objects...?}
        description {Creates a violation object and manages the collection of design objects associated with it for reporting purposes. The command belongs in the Tcl checker procedure that implements a user-defined DRC rule, and the rule should be registered with register_drc_rule before it is used with report_drc or violations are created; the objects are the cells, ports, pins, nets, clock regions, sites, and package IO banks substituted into the rule.}
        returns {Nothing.}
        example {create_violation -name RIPO -msg "RIPO Error Found:" \
   -severity ERROR $mycell1 $mycell2}
        source {Xilinx UG835 2012.2}
    }
}
command create_waiver {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table lists LINT among the waiver types while the
    ;# Arguments prose says only DRC, METHODOLOGY, and CDC are supported, so the
    ;# value set is left open.
    option -type -takes type -values {DRC METHODOLOGY CDC LINT} \
           -detail {Type of waiver to create.}
    option -id -takes id \
           -detail {ID of the check or violation being waived, not needed when -of_objects is used.}
    option -objects -takes objects \
           -detail {Inserted message objects for which a DRC or methodology waiver will be set, given with the convention of the violation definition or as wildcards.}
    option -from -takes pins \
           -detail {Source driver pins or ports for which a CDC waiver will be set.}
    option -to -takes pins \
           -detail {Target load pins or ports for which a CDC waiver will be set.}
    option -strings -takes strings \
           -detail {Inserted message string values for which a DRC or methodology waiver will be set.}
    option -rtl_name -takes rtl_names \
           -detail {List of rtl_name values for the LINT waiver.}
    option -rtl_hierarchy -takes rtl_hierarchies \
           -detail {List of rtl_hierarchy values for the LINT waiver.}
    option -rtl_file -takes rtl_files \
           -detail {List of rtl_file values for the LINT waiver.}
    option -of_objects -takes violations \
           -detail {DRC, methodology, or CDC violation objects for which waivers will be set, as returned by get_drc_violations, get_methodology_violations, or get_cdc_violations.}
    option -user -takes user \
           -detail {User ID of the person creating the waiver, taken from the environment USER name when not specified.}
    option -description -takes description \
           -detail {Brief description of the cause for the waiver (required).}
    option -tags -takes tags \
           -detail {One or more user-defined strings to aid in subsequent waiver identification or categorization.}
    option -timestamp -takes timestamp \
           -detail {Original time of the waiver, given in the form "SUN Aug 6 17:02:21 GMT 2017"; the current time is used when omitted.}
    option -scoped \
           -detail {Interpret object wildcards in the waiver as scoped to the current_instance that is set.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_waiver ?-type type? ?-id id? ?-objects objects? ?-from pins? ?-to pins? ?-strings strings? ?-rtl_name rtl_names? ?-rtl_hierarchy rtl_hierarchies? ?-rtl_file rtl_files? ?-of_objects violations? ?-user user? -description description ?-tags tags? ?-timestamp timestamp? ?-scoped? ?-quiet? ?-verbose?}

    hover {
        summary {Create a DRC, methodology, CDC, or lint message waiver.}
        synopsis {create_waiver ?-type type? ?-id id? ?-objects objects? ?-from pins? ?-to pins? ?-strings strings? ?-rtl_name rtl_names? ?-rtl_hierarchy rtl_hierarchies? ?-rtl_file rtl_files? ?-of_objects violations? ?-user user? -description description ?-tags tags? ?-timestamp timestamp? ?-scoped? ?-quiet? ?-verbose?}
        description {Selects individual violations or specific checks reported by report_drc, report_methodology, or report_cdc that can be waived for a design, letting the flow move forward. A waiver must be assigned to a specific object, a specific violation ID, or to paths using -from and -to, so although many arguments are described as optional some form of identifier is required. Rerun the report after creating a waiver for it to be considered, use write_waivers and read_xdc to carry waivers between sessions, and use delete_waivers to remove them.}
        returns {Waiver.}
        example {create_waiver -id TIMING-18 -user samwise -description {waive rule check}}
        source {Xilinx UG835 2026.1}
    }
}
command create_wave_config {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_wave_config ?-quiet? ?-verbose? ?name?}

    hover {
        summary {Create a new wave config.}
        synopsis {create_wave_config ?-quiet? ?-verbose? ?name?}
        description {Creates a new wave configuration object in the current simulation, opens it in the Vivado IDE, and makes it the current wave configuration. The Wave Config file holds the list of wave objects to display, their display properties, and markers; it can be populated further with commands like add_wave and add_wave_divider and saved with save_wave_config. When no name is given, an untitled configuration called "Untitled #" is created, where # is a numerical sequence beginning at 1.}
        returns {The new wave config.}
        example {create_wave_config testbench1}
        source {Xilinx UG835 2026.1}
    }
}
command create_xps {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_xps ?-quiet? ?-verbose? name}

    hover {
        summary {Create an embedded source for XPS and add it to the source fileset.}
        synopsis {create_xps ?-quiet? ?-verbose? name}
        description {Creates an Embedded Processor source for use in the current project and adds it to the source files, launching Xilinx Platform Studio to design the hardware portion of the embedded processor system. After exiting XPS the created files are written to the local project directory and added to the source files. The section notes that this flow is not supported anymore and that the Vivado IP integrator should be used instead.}
        returns {Source file name that was created.}
        example {create_xps xpsTest1}
        source {Xilinx UG835 2026.1}
    }
}
command current_bd_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {current_bd_design ?-quiet? ?-verbose? ?design?}

    hover {
        summary {Set or get the current IP subsystem design.}
        synopsis {current_bd_design ?-quiet? ?-verbose? ?design?}
        description {Defines the current IP subsystem design for use with the IP integrator, or returns the name of the current design in the active project when no design is given. The current IP subsystem design and current IP subsystem instance are the target of most IP integrator Tcl commands and design changes; the current instance is defined with current_bd_instance, and get_bd_designs lists the open subsystem designs.}
        returns {The current design object, "" if failed.}
        example {current_bd_design design_1}
        source {Xilinx UG835 2026.1}
    }
}
command current_bd_instance {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {current_bd_instance ?-quiet? ?-verbose? ?instance?}

    hover {
        summary {Set or get the current cell instance.}
        synopsis {current_bd_instance ?-quiet? ?-verbose? ?instance?}
        description {Sets or gets the current hierarchical cell instance in the current IP integrator subsystem design defined by current_bd_design, referenced from the top level of the subsystem hierarchy. The instance is specified relative to the presently defined current instance using the defined hierarchy separator; '..' moves up one level, omitting the instance resets to the top module, and '.' returns the current instance name without changing it.}
        returns {The current cell instance object, "" if failed.}
        example {current_bd_instance module2}
        source {Xilinx UG835 2026.1}
    }
}
command current_board {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {current_board ?-quiet? ?-verbose?}

    hover {
        summary {Get the current board object.}
        synopsis {current_board ?-quiet? ?-verbose?}
        description {Returns the board in use in the current project, giving the Vendor:Board_Name:File_Version attributes of the current board as defined in the BOARD_PART property. The board provides a representation of the overall system the device is part of and can help define clock constraints, I/O port assignments, and supported interfaces. Nothing is returned when the project targets an AMD FPGA instead of a board, or when BOARD_PART has not been defined.}
        returns {Current board object.}
        example {set_property BOARD_PART xilinx.com:kc705:1.0 [current_project]
current_board}
        source {Xilinx UG835 2026.1}
    }
}
command current_board_part {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {current_board_part ?-quiet? ?-verbose?}

    hover {
        summary {Get the current board_part object.}
        synopsis {current_board_part ?-quiet? ?-verbose?}
        description {Returns the NAME property of the current board part, which represents the AMD device in the context of the board-level system and corresponds to the part0 component in the Board Interface file. A warning is returned when the project targets an AMD FPGA instead of a board, or when the BOARD_PART property has not been defined. Setting BOARD_PART with set_property also changes the target part to match the part required by the board.}
        returns {Current board_part object.}
        example {set_property BOARD_PART xilinx.com:kc705:part0:1.0 [current_project]
current_board_part}
        source {Xilinx UG835 2026.1}
    }
}
command current_fileset {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -constrset -detail {Return the currently active constraint set.}
    option -simset -detail {Return or set the currently active simulation fileset.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {current_fileset ?-constrset? ?-simset? ?-quiet? ?-verbose? ?filesets?}

    hover {
        summary {Get the current fileset of any type, or set the current simulation fileset.}
        synopsis {current_fileset ?-constrset? ?-simset? ?-quiet? ?-verbose? ?filesets?}
        description {Gets the active source, constraint, or simulation fileset within the current project. Used without options, current_fileset sets and returns sources_1 as the active fileset; the positional argument names a simulation fileset to make active in projects with multiple filesets. Use set_property CONSTRSET to define the active constraint set on a synthesis or implementation run.}
        returns {Current fileset (the current srcset by default).}
        example {current_fileset -constrset}
        source {Xilinx UG835 2026.1}
    }
}
command current_frame {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -up \
           -detail {Select the stack frame of the caller process or subprogram one hop away from the current frame as the current frame.}
    option -down \
           -detail {Select the stack frame of the callee subprogram one hop away from the current frame as the current frame.}
    option -set -takes index \
           -detail {Select the frame with this index of the currently selected call stack as the current frame; the default is 0, the deepest level of the selected call stack.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {current_frame ?-up? ?-down? ?-set index? ?-quiet? ?-verbose?}

    hover {
        summary {Get or set the selected subprogram frame in the call stack of the current HDL process scope.}
        synopsis {current_frame ?-up? ?-down? ?-set index? ?-quiet? ?-verbose?}
        description {Returns the index of the frame selected as the current frame in the subprogram call stack of the current HDL process scope, or current_scope. By default the most recently called subprogram frame is the current frame, with frame index 0, and -up, -down, and -set select other frames in the call stack. The command strictly follows current_scope: if current_scope is not an HDL process scope waiting inside a subprogram, it reports that the current process has no associated subprogram stack.}
        returns {Returns index of the selected subprogram frame in the call stack of the current_scope.}
        source {Xilinx UG835 2026.1}
    }
}
command current_hw_cfgmem {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table brackets -hw_device as optional while the
    ;# Arguments prose marks it (Required); the bracketed Syntax spelling is used
    ;# here.
    option -hw_device -takes hw_devices \
           -detail {Hardware device object to set the current_hw_cfgmem on, as returned by current_hw_device or get_hw_devices, described as required by the Arguments prose.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {current_hw_cfgmem ?-hw_device hw_devices? ?-quiet? ?-verbose? ?hw_cfgmem?}

    hover {
        summary {Get or set the current hardware cfgmem.}
        synopsis {current_hw_cfgmem ?-hw_device hw_devices? ?-quiet? ?-verbose? ?hw_cfgmem?}
        description {Sets or returns the current hardware cfgmem object, the flash memory device defined by create_hw_cfgmem for configuring and booting the FPGA. A newly created hw_cfgmem becomes the current one; passing a hw_cfgmem object returned by get_hw_cfgmems changes the current object. Once associated with the hw_device, the configuration memory can be programmed by program_hw_cfgmem with data from a memory configuration file created by write_cfgmem.}
        returns {Hardware cfgmem.}
        example {current_hw_cfgmem}
        source {Xilinx UG835 2026.1}
    }
}
command current_hw_device {
    available {tcl 8.5}
    required_package vivado

    arity 0..

