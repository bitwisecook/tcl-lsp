}
command show_schematic {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -add -detail {Add the specified objects to the existing schematic view.}
    option -remove -detail {Remove the specified objects from the existing schematic view.}
    option -regenerate -detail {Regenerate the layout of the schematic view.}
    option -pin_pairs \
           -detail {Treat the objects as pairs of connected pins, showing the pins and the wire between them, which can be useful to display paths.}
    option -name -takes window_title \
           -detail {Defines a name for the schematic window opened in the GUI, used to add to, remove from, or regenerate the schematic.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {show_schematic ?-add? ?-remove? ?-regenerate? ?-pin_pairs? ?-name window_title? ?-quiet? ?-verbose? objects}

    hover {
        summary {Show netlist items in the schematic view.}
        synopsis {show_schematic ?-add? ?-remove? ?-regenerate? ?-pin_pairs? ?-name window_title? ?-quiet? ?-verbose? objects}
        description {Creates a schematic view containing the specified design objects when the tool is invoked in GUI mode. The scope of the schematic depends on the objects specified: cells show the cells and any connections between them, pins show the pin objects, and nets show the nets as well as the cells and ports connected to them. To display multiple levels of hierarchy, set the level of interest with current_instance and use -hierarchical when specifying objects with a get_ command.}
        returns {Nothing.}
        example {show_schematic [get_nets]}
        source {Xilinx UG835 2026.1}
    }
}
command split_diff_pair_ports {
