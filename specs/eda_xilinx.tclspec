command create_bd_pin {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes begin_index \
           -detail {The starting index of a standard bus pin, unspecified for single bit pins.}
    option -to -takes end_index \
           -detail {The ending index of a standard bus pin, unspecified for single bit pins.}
    option -dir -takes dir -values {I O IO} -closed \
           -detail {The direction of the pin: I for input, O for output, IO for bidirectional (required).}
    option -type -takes type \
           -detail {The type of the pin as a clock (CLK), reset (RST), clock enable (CE), interrupt (INTR), or data (DATA) pin; undefined (UNDEF) when not given.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_bd_pin ?-from begin_index? ?-to end_index? -dir dir ?-type type? ?-quiet? ?-verbose? name}

    hover {
        summary {Create a new pin.}
        synopsis {create_bd_pin ?-from begin_index? ?-to end_index? -dir dir ?-type type? ?-quiet? ?-verbose? name}
        description {Creates a new pin to add to an IP integrator hierarchical module. The name is referenced from the hierarchical module the pin is added to, as in /modName/pinname.}
        returns {The newly created pin object, or "" if it failed.}
        example {create_bd_pin -dir I -type rst /newMod1/rst}
        source {Xilinx UG835 2026.1}
    }
}
command create_bd_port {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes begin_index \
           -detail {The starting index of a standard bus port, unspecified for single bit ports.}
    option -to -takes end_index \
           -detail {The ending index of a standard bus port, unspecified for single bit ports.}
    option -dir -takes dir -values {I O IO} -closed \
           -detail {The direction of the port: I for input, O for output, IO for bidirectional (required).}
    option -type -takes type -values {clk ce rst intr data} -closed \
           -detail {The type of the port as a clock, clock enable, reset, interrupt, or data port; undefined (UNDEF) when not given.}
    ;# NOTE(xilinx): the Syntax line and Usage table show -freq_hz unbracketed, but the
    ;# Arguments prose marks it (Optional) and the section's own bus-port example omits
    ;# it, so it is spelled optional here.
    option -freq_hz -takes freq_hz \
           -detail {The frequency in Hertz for clock ports, 100 MHz when not given.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {create_bd_port ?-from begin_index? ?-to end_index? -dir dir ?-type type? ?-freq_hz freq_hz? ?-quiet? ?-verbose? name}

    hover {
        summary {Create a new port for an IP subsystem design.}
        synopsis {create_bd_port ?-from begin_index? ?-to end_index? -dir dir ?-type type? ?-freq_hz freq_hz? ?-quiet? ?-verbose? name}
        description {Creates a new port to add to an IP integrator subsystem design, providing a connection to signals external to the subsystem design.}
        returns {The newly created port object, or nothing if the command fails.}
        example {create_bd_port -dir I -type clk -freq_hz 125000000 my_clock}
        source {Xilinx UG835 2026.1}
    }
}
command create_bd_tlm_port {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

