command set_bus_skew {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes startpoints \
           -detail {The starting points of the timing paths to set bus skew on, specified as pins, cells, or a clock object.}
    option -rise_from -takes startpoints \
           -detail {Set bus skew on the timing paths with rising edge transitions at the specified startpoints.}
    option -fall_from -takes startpoints \
           -detail {Set bus skew on the timing paths with falling edge transitions at the specified startpoints.}
    option -to -takes endpoints \
           -detail {The endpoints of the timing paths to define the bus skew on, specified as pins, cells, or a clock object.}
    option -rise_to -takes endpoints \
           -detail {Set bus skew on the timing paths with rising edge transitions at the specified endpoints.}
    option -fall_to -takes endpoints \
           -detail {Set bus skew on the timing paths with falling edge transitions at the specified endpoints.}
    option -through -takes through_points \
           -detail {Set bus skew only on paths through the specified pins, cell instances, or nets, where the order of successive through points defines the path.}
    option -rise_through -takes through_points \
           -detail {Set bus skew on the timing paths with rising edge transitions at the specified through points.}
    option -fall_through -takes through_points \
           -detail {Set bus skew on the timing paths with falling edge transitions at the specified through points.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_bus_skew ?-from startpoints? ?-rise_from startpoints? ?-fall_from startpoints? ?-to endpoints? ?-rise_to endpoints? ?-fall_to endpoints? ?-through through_points? ?-rise_through through_points? ?-fall_through through_points? ?-quiet? ?-verbose? value}

    hover {
        summary {Define bus skew.}
        synopsis {set_bus_skew ?-from startpoints? ?-rise_from startpoints? ?-fall_from startpoints? ?-to endpoints? ?-rise_to endpoints? ?-fall_to endpoints? ?-through through_points? ?-rise_through through_points? ?-fall_through through_points? ?-quiet? ?-verbose? value}
        description {Sets the bus skew requirement, in nanoseconds, on bus signals that cross clock domains, defining the maximum skew spread between the fastest and slowest signals of the bus without considering the overall datapath delay. Although the path options are listed as optional, a path must be defined using a form of -from and -to; bus skew constraints are not overridden by clock groups, max delay, or false path. To avoid over-constraining, the value should be approximately the smallest period of the two clock domains, and report_bus_skew reports the calculated skew.}
        returns {Nothing.}
        example {set_bus_skew -from [get_pins gray_coded_read_ptr[*]/C] \
   -to [get_pins gray_coded_write_ptr[*]/D] 2.5}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command set_default_switching_activity {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -toggle_rate -takes rate \
           -detail {The toggle rate describing how often the output switches relative to the controlling clock, valid between 0 and 200 percent.}
    option -static_probability -takes value \
           -detail {The switching probability to use in analysis, valid between 0 and 1.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_default_switching_activity ?-toggle_rate rate? ?-static_probability value? ?-quiet? ?-verbose? types}

    hover {
        summary {Set default switching activity on specified types.}
        synopsis {set_default_switching_activity ?-toggle_rate rate? ?-static_probability value? ?-quiet? ?-verbose? types}
        description {Sets the default seed values of the switching activity used by the vector-less propagation engine for a broad class of signals during power estimation, where the valid types are input, input_set, input_reset, input_enable, register, dsp, bram_read_enable, bram_write_enable, output_enable, clock, and all. Static power is often dependent on logic state transitions and dynamic power is directly proportional to the toggle rate; the current values can be inspected with report_default_switching_activity and restored with reset_default_switching_activity, while set_switching_activity defines the activity of individual signals. The command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {set_default_switching_activity -toggle_rate 85 dsp}
        source {Xilinx UG835 2012.2}
    }
}
command set_delay_model {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -interconnect -takes delay_model -values {estimated actual none} -closed \
           -detail {Interconnect delay model used for timing analysis; the default setting is actual.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_delay_model ?-interconnect delay_model? ?-quiet? ?-verbose?}

    hover {
        summary {Set the interconnect delay model for timing analysis.}
        synopsis {set_delay_model ?-interconnect delay_model? ?-quiet? ?-verbose?}
        description {Sets the interconnect delay model used for timing analysis. With actual, the delay from the routed interconnect is used, with estimated delay filling in for any unrouted portion; with estimated, the interconnect delay is estimated from placement and connectivity even when the design is fully routed; with none, no interconnect delay is included and only logic delay is applied. This command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {set_delay_model -interconnect estimated}
        source {Xilinx UG835 2026.1}
    }
}
command set_external_delay {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -from -takes output_port -detail {The output port name (required).}
    option -to -takes input_port -detail {The input port name (required).}
    option -min -detail {Specifies the delay_value is a minimum delay value for hold time analysis.}
    option -max -detail {Specifies the delay_value is a maximum delay value for setup analysis.}
    option -add -detail {Add the specified delay to the existing external delay value.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {set_external_delay -from output_port -to input_port ?-min? ?-max? ?-add? ?-quiet? ?-verbose? delay_value}

    hover {
        summary {Set external delay.}
        synopsis {set_external_delay -from output_port -to input_port ?-min? ?-max? ?-add? ?-quiet? ?-verbose? delay_value}
        description {Sets the external feedback delay in nanoseconds between an output and an input port, which is used in the calculation of the PLL or MMCM compensation delay for PLLs and MMCMs with external feedback. A min or max value can be specified; by default the value applies to both the min hold and max setup compensation delays. The default delay value is 0.}
        returns {The defined delay.}
        example {set_external_delay -from [get_ports ClkOut] -to [get_ports ClkFb] 1.0}
        source {Xilinx UG835 2026.1}
    }
}
command set_hw_sysmon_reg {
    available {tcl 8.5}
    required_package vivado

    arity 3..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

