    hover {
        summary {Save the current design as a new set of constraints.}
        synopsis {save_design_as ?-dir dir? ?-quiet? ?-verbose? name}
        description {Saves the active constraint set as a new constraint set with local copies of any constraint files that are part of it, leaving the design name unchanged, which allows what-if development of design constraints without affecting the current constraint files. The new constraint set is referenced by the design but is not active until the constrset property of specific runs is set to point at it.}
        returns {Nothing.}
        example {save_design_as -dir C:/Data/con1 newCon}
        source {Xilinx UG835 2012.2}
    }
}
command save_project_as {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -scan_for_includes \
           -detail {Scans all source files and adds any referenced Verilog include files into the project structure.}
    option -exclude_run_results \
           -detail {Exclude run results in the new project, stripping the project of its current run results.}
    option -include_local_ip_cache \
           -detail {Include IP cache results in the new project, retaining the out-of-context synthesis cache.}
    option -force -detail {Overwrite the existing project directory.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {save_project_as ?-scan_for_includes? ?-exclude_run_results? ?-include_local_ip_cache? ?-force? ?-quiet? ?-verbose? name ?dir?}

    hover {
        summary {Save the current project under a new name.}
        synopsis {save_project_as ?-scan_for_includes? ?-exclude_run_results? ?-include_local_ip_cache? ?-force? ?-quiet? ?-verbose? name ?dir?}
        description {Saves a currently open project file under a new name in the specified directory, or in the current working directory if no other directory is specified. The project is written as name.xpr in the Vivado Design Suite, or name.lpr in the Vivado Lab Edition, and the directory is created if it does not exist.}
        returns {Saved project object.}
        example {save_project_as myProject myProjectDir}
        source {Xilinx UG835 2026.1}
    }
}
command save_wave_config {
    available {tcl 8.5}
    required_package vivado

