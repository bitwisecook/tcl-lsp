command report_hw_pcie {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, given with its full path.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    ;# NOTE(xilinx): the Arguments prose marks the hw_pcie word (Required) but
    ;# then says the report covers all available PCIe cores when it is not
    ;# provided, so the arity minimum is left at zero.
    form Default {report_hw_pcie ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose? hw_pcie}

    hover {
        summary {Formatted report for PCIe core.}
        synopsis {report_hw_pcie ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose? hw_pcie}
        description {Generates a report for the Peripheral Component Interconnect Express (PCIe) debug core object, hw_pcie, defined on the current hardware device. Versal PCIe soft cores implemented in the design are represented as hw_pcie objects in the Vivado hardware manager and are used to evaluate and monitor the PCIe Link Training and Status State Machine running on the gigabit transceivers. The report carries general information about the PCIe core, the LTSSM state visitation status, and the trace data for the LTSSM transition graph.}
        returns {A report of the PCIe core information, LTSSM state visitation status, and LTSSM transition graph trace data.}
        example {report_hw_pcie [lindex [get_hw_pcies] 0]}
        source {Xilinx UG835 2026.1}
    }
}
command report_hw_softmc {
