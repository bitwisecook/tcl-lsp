}
command delete_qor_checks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -type -takes type -values {suggestion assessment} -closed \
           -detail {Type of QoR check to delete; the default is suggestion, so the -type assessment switch is needed to delete assessment type checks.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_qor_checks ?-type type? ?-quiet? ?-verbose? ?ids?}

    hover {
        summary {Delete a list of user QoR checks.}
        synopsis {delete_qor_checks ?-type type? ?-quiet? ?-verbose? ?ids?}
        description {Removes one or more QoR checks from Vivado, matching check names against the given names. The command only operates on user-created checks; factory checks cannot be deleted. The same name can be assigned to both assessment and suggestion checks, so -type selects which of the two is removed.}
        returns {Nothing.}
        example {delete_qor_checks -type suggestion RQS_NETLIST_AMD-1}
        source {Xilinx UG835 2026.1}
    }
}
command delete_qor_ruledecks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

