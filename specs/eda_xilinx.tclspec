        synopsis {current_pr_configuration ?-quiet? ?-verbose? ?configs?}
        description {Returns the PR configuration that is current or active in the design, or makes the specified configuration active. In the Dynamic Function eXchange flow a PR configuration assigns a reconfigurable module to a specific instance of a Partition Definition, letting you create unique configurations of the design from the core design and one or more RMs. The configuration can be given by name or as an object returned by get_pr_configurations.}
        returns {List of PartitionDef objects.}
        example {current_pr_configuration clockHigh}
        source {Xilinx UG835 2026.1}
    }
}
command current_project {
