}
command remove_hw_hbm_pc {
    available {tcl 8.5}
    required_package vivado

    arity 3..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_hw_hbm_pc ?-quiet? ?-verbose? mc_num pc_num hw_objects}

    hover {
        summary {De-select a pseudo channel from the HBM activity monitor.}
        synopsis {remove_hw_hbm_pc ?-quiet? ?-verbose? mc_num pc_num hw_objects}
        description {Removes a memory channel and pseudo channel pair that was previously added to an HBM activity monitor with add_hw_hbm_pc. The memory controller number, one of the 8 memory channels numbered 0 to 7, is given first, followed by the pseudo channel number, 0 or 1, and then the hw_hbm objects; the activity monitor must not be running while pseudo channels are added or removed.}
        returns {Nothing.}
        example {remove_hw_hbm_pc 2 0 [get_hw_hbms *HBM_2]
run_hw_hbm_amon [get_hw_hbms *HBM_2]}
        source {Xilinx UG835 2026.1}
    }
}
command remove_hw_probe_enum {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -no_gui_update \
           -detail {Defer the GUI update, so the logic analyzer is not updated to remove the enumerated values of the probe.}
    option -list -takes enum_names \
           -detail {The list of enumerated names to remove from the specified hardware probe.}
    option -remove_all \
           -detail {Remove the whole enumeration for the hardware probe; cannot be used with -list.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-list -remove_all}

    form Default {remove_hw_probe_enum ?-no_gui_update? ?-list enum_names? ?-remove_all? ?-quiet? ?-verbose? hw_probe}

    hover {
        summary {Remove enumerated name-value pairs from a hardware probe enumeration.}
        synopsis {remove_hw_probe_enum ?-no_gui_update? ?-list enum_names? ?-remove_all? ?-quiet? ?-verbose? hw_probe}
        description {Removes the enumerated name and value pairs, held in the ENUM property and added with add_hw_probe_enum, from the specified ILA hw_probe object. The names to remove can be given as a list object or a simple list of names, or the whole enumeration can be removed with -remove_all.}
        returns {Nothing.}
        example {remove_hw_probe_enum -list {WHITE YELLOW GREY} \
[get_hw_probes op1 -of_objects [current_hw_ila]]}
        source {Xilinx UG835 2026.1}
    }
}
command remove_hw_sio_link {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_hw_sio_link ?-quiet? ?-verbose? hw_sio_links}

    hover {
        summary {Remove an existing hardware SIO link.}
        synopsis {remove_hw_sio_link ?-quiet? ?-verbose? hw_sio_links}
        description {Removes the specified communication links between TX and RX objects on the GTs of the IBERT debug core defined on the current hardware device. The links define the communication paths and protocols used by the link-based serial I/O analyzer, and must be specified as objects returned by create_hw_sio_link or get_hw_sio_links.}
        returns {A list of link objects on the IBERT debug core, or an error if it fails.}
        example {remove_hw_sio_link [get_hw_sio_links -filter {DESCRIPTION == "Link2"}]}
        source {Xilinx UG835 2026.1}
    }
}
command remove_hw_sio_linkgroup {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_hw_sio_linkgroup ?-quiet? ?-verbose? hw_sio_linkgroups}

    hover {
        summary {Remove an existing hardware SIO link group.}
        synopsis {remove_hw_sio_linkgroup ?-quiet? ?-verbose? hw_sio_linkgroups}
        description {Removes the specified link groups, which associate communication links between TX and RX objects on the GTs of the IBERT debug core so that properties can be configured and scans run collectively. Removing a link group removes the association but not the underlying communication links, which are removed with remove_hw_sio_link.}
        returns {Nothing.}
        example {remove_hw_sio_linkgroup [get_hw_sio_linkgroups {LINKGROUP_0}]}
        source {Xilinx UG835 2026.1}
    }
}
command remove_hw_sio_scan {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_hw_sio_scan ?-quiet? ?-verbose? hw_sio_scans}

    hover {
        summary {Remove an existing hardware SIO scan.}
        synopsis {remove_hw_sio_scan ?-quiet? ?-verbose? hw_sio_scans}
        description {Removes the specified serial I/O analyzer scan objects, which must be specified as objects returned by create_hw_sio_scan or get_hw_sio_scans.}
        returns {Nothing.}
        example {remove_hw_sio_scan [get_hw_sio_scans {SCAN_2}]}
        source {Xilinx UG835 2026.1}
    }
}
command remove_hw_sio_sweep {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_hw_sio_sweep ?-quiet? ?-verbose? hw_sio_sweeps}

    hover {
        summary {Remove an existing hardware SIO sweep.}
        synopsis {remove_hw_sio_sweep ?-quiet? ?-verbose? hw_sio_sweeps}
        description {Removes the specified serial I/O analyzer sweep scan objects, which must be specified as objects returned by create_hw_sio_sweep or get_hw_sio_sweeps.}
        returns {Nothing.}
        example {remove_hw_sio_sweep [get_hw_sio_sweeps {SWEEP_3}]}
        source {Xilinx UG835 2026.1}
    }
}
command remove_net {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -prune \
           -detail {Remove any hierarchical pins, ports or nets left unconnected as a result of the net removal.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_net ?-prune? ?-quiet? ?-verbose? nets}

    hover {
        summary {Remove nets from the current design.}
        synopsis {remove_net ?-prune? ?-quiet? ?-verbose? nets}
        description {Removes the specified nets from the netlist of an open synthesized or implemented design; nets cannot be removed from library macros. To remove a bus, give the primary bus name without a bus index so that the whole bus is removed; use resize_net_bus to eliminate individual bits. Netlist editing changes only the in-memory view of the netlist and is not allowed on the elaborated RTL design.}
        example {remove_net topnet -prune}
        source {Xilinx UG835 2026.1}
    }
}
command remove_pin {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_pin ?-quiet? ?-verbose? pins}

    hover {
        summary {Remove pins from the current design.}
        synopsis {remove_pin ?-quiet? ?-verbose? pins}
        description {Removes pins, specified hierarchically by the cell instance they are found on, from the current netlist in an open synthesized or implemented design; pins cannot be removed from library macros. To remove a bus pin, give the primary pin name without a bus index so that the whole bus pin is removed; use resize_pin_bus to eliminate individual bits. Netlist editing is not allowed on the elaborated RTL design.}
        example {remove_pin cpuEngine/inPin}
        source {Xilinx UG835 2026.1}
    }
}
command remove_port {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_port ?-quiet? ?-verbose? ports}

    hover {
        summary {Remove the given list of top-level ports from the netlist.}
        synopsis {remove_port ?-quiet? ?-verbose? ports}
        description {Removes the specified ports or bus ports, which must have been added with create_port; ports defined in the RTL or netlist design cannot be deleted. To remove a bus port, give the primary port name without a bus index so that the whole bus port is removed, and use resize_port_bus to eliminate individual bits. Deleting either side of a differential pair also deletes the other side.}
        example {remove_port PORT0}
        source {Xilinx UG835 2026.1}
    }
}
command remove_wave {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -of -takes wave_container \
           -detail {The wave configuration, group, or virtual bus to search, defaulting to the current wave configuration.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_wave ?-of wave_container? ?-quiet? ?-verbose? items}

    hover {
        summary {Remove wave objects from the current wave configuration.}
        synopsis {remove_wave ?-of wave_container? ?-quiet? ?-verbose? items}
        description {Removes the specified wave objects from the current wave configuration, or from the wave configuration, group, or virtual bus named by -of.}
        source {Xilinx UG835 2026.1}
    }
}
command rename_cell {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -to -takes new_name \
           -detail {The new name to assign to the specified cell, which cannot contain Tcl special characters (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {rename_cell -to new_name ?-quiet? ?-verbose? cell}

    hover {
        summary {Rename a cell.}
        synopsis {rename_cell -to new_name ?-quiet? ?-verbose? cell}
        description {Renames a single hierarchical or leaf-level cell in the current synthesized or implemented design; cells with the DONT_TOUCH property set to true cannot be renamed. Renaming also affects the design constraints in the in-memory design, which are modified automatically to target the new object name but are not written back to the source XDC file; write_checkpoint saves both the renamed objects and the modified constraints. Netlist editing is not allowed on the elaborated RTL design.}
        returns {Nothing.}
        example {rename_cell -to or1200_gpu or1200_cpu}
        source {Xilinx UG835 2026.1}
    }
}
command rename_net {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -to -takes new_name \
           -detail {The new name to assign to the specified net, which cannot contain Tcl special characters (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {rename_net -to new_name ?-quiet? ?-verbose? net}

    hover {
        summary {Rename a net.}
        synopsis {rename_net -to new_name ?-quiet? ?-verbose? net}
        description {Renames a net in the current synthesized or implemented design; nets with the DONT_TOUCH or MARK_DEBUG properties set to true cannot be renamed, and individual bits of a bus net cannot be renamed although the whole bus can. Renaming also affects the design constraints in the in-memory design, which are modified automatically to target the new object name but are not written back to the source XDC file. Netlist editing is not allowed on the elaborated RTL design.}
        returns {Nothing.}
        example {rename_net -to dataOut dout}
        source {Xilinx UG835 2026.1}
    }
}
command rename_pin {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -to -takes new_name \
           -detail {The new name to assign to the specified pin, given as the pin name rather than the whole hierarchical name, and containing no Tcl special characters (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {rename_pin -to new_name ?-quiet? ?-verbose? pins}

    hover {
        summary {Rename a pin.}
        synopsis {rename_pin -to new_name ?-quiet? ?-verbose? pins}
        description {Renames the specified pin on a hierarchical cell in the current synthesized or implemented design. Pins on primitive cells and pins on a hierarchical cell inside a DONT_TOUCH cell cannot be renamed, and individual bits of a bus pin cannot be renamed although the whole bus can. Netlist editing changes only the in-memory view of the netlist, and constraints referring to the object are updated in memory but not written back to the source XDC file.}
        returns {Nothing if successful, or an error if it fails.}
        example {rename_pin -to in1 egressLoop[0].egressFifo/I1}
        source {Xilinx UG835 2026.1}
    }
}
command rename_port {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -to -takes new_name \
           -detail {The new name to assign to the specified port, containing no Tcl special characters (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {rename_port -to new_name ?-quiet? ?-verbose? ports}

    hover {
        summary {Rename a port.}
        synopsis {rename_port -to new_name ?-quiet? ?-verbose? ports}
        description {Renames a single port in the current synthesized or implemented design. Individual bits of a bus port cannot be renamed, but the whole bus can be renamed collectively. Netlist editing changes only the in-memory view of the netlist, and constraints referring to the object are updated in memory but not written back to the source XDC file.}
        returns {Nothing if successful, or an error if it fails.}
        example {rename_port -to wbInputData wbInDat}
        source {Xilinx UG835 2026.1}
    }
}
command rename_ref {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -ref -takes ref_name \
           -detail {The current reference name of a non-primitive cell.}
    option -to -takes new_name \
           -detail {Change the reference name to the specified value.}
    option -prefix_all -takes prefix \
           -detail {Apply the specified prefix to the reference names of all non-primitive cells in the current design, except the top module.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {rename_ref ?-ref ref_name? ?-to new_name? ?-prefix_all prefix? ?-quiet? ?-verbose?}

    hover {
        summary {Rename a cell ref.}
        synopsis {rename_ref ?-ref ref_name? ?-to new_name? ?-prefix_all prefix? ?-quiet? ?-verbose?}
        description {Renames the reference name of a single non-primitive cell, or applies a reference prefix to all non-primitive cells in the current synthesized or implemented design. This provides a mechanism to change non-primitive reference names so that they do not collide with the reference names of another design, letting two modules or designs be synthesized or simulated together.}
        returns {Nothing when renaming the reference of a single cell, the number of cells renamed when used with -prefix_all, or an error if it fails.}
        example {rename_ref -ref usbf_top -to MOD1_usbf_top}
        source {Xilinx UG835 2026.1}
    }
}
command reorder_files {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -fileset -takes fileset \
           -detail {The fileset in which to reorder files; the default is the sources_1 source fileset.}
    option -before -takes file_name \
           -detail {Place the specified files before this file in the fileset, given by its full path name in the fileset.}
    option -after -takes file_name \
           -detail {Place the specified files after this file in the fileset, given by its full path name in the fileset.}
    option -front \
           -detail {Place the specified files at the front of the list of files in the fileset; this is the default.}
    option -back \
           -detail {Place the specified files at the back of the list of files in the fileset.}
    option -auto \
           -detail {Enable automatic reordering based on the hierarchy requirements of the current top module in the project.}
    option -disable_unused \
           -detail {Disable any files not currently used by the hierarchy of the top module.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {reorder_files ?-fileset fileset? ?-before file_name? ?-after file_name? ?-front? ?-back? ?-auto? ?-disable_unused? ?-quiet? ?-verbose? files}

    hover {
        summary {Change the order of source files in the active fileset.}
        synopsis {reorder_files ?-fileset fileset? ?-before file_name? ?-after file_name? ?-front? ?-back? ?-auto? ?-disable_unused? ?-quiet? ?-verbose? files}
        description {Reorders source files in the specified fileset, taking the files indicated and placing them at the front of, the back of, or before or after other files within the fileset. An auto reorder feature reorders the files based on the requirements of the current top module in the design. Files must be specified by their full path name in the fileset, and are reordered in the order they are specified.}
        returns {Nothing.}
        example {reorder_files -front {C:/Data/FPGA/file1.vhdl C:/Data/FPGA/file2.vhdl}}
        source {Xilinx UG835 2026.1}
    }
}
command replace_bd_cell {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -preserve_name \
           -detail {Apply the name of the current cell to the new cell that is replacing it, renaming the existing cell as instance_old.}
    option -preserve_configuration \
           -detail {Apply the configuration settings of the current cell to the new cell that is replacing it, warning about and skipping any setting that cannot be applied.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Syntax line brackets both cell words and spells the
    ;# second as repeatable, while the Arguments prose marks cell1 (Required)
    ;# and describes exactly one replacement cell; the Syntax bracketing is kept
    ;# and the repetition is not.
    form Default {replace_bd_cell ?-preserve_name? ?-preserve_configuration? ?-quiet? ?-verbose? ?cell1? ?cell2?}

    hover {
        summary {Replace one IP integrator cell with another, moving its connections to the new cell.}
        synopsis {replace_bd_cell ?-preserve_name? ?-preserve_configuration? ?-quiet? ?-verbose? ?cell1? ?cell2?}
        description {Moves the connections currently assigned to one IP integrator cell to another IP integrator cell in the current design, to quickly replace one cell with another. The existing cell is relocated from its position in the block design and the replacing cell is placed at that location; connections to pins and interface pins are preserved where possible, and a Critical Warning is returned when connections must be removed. This command is not supported by the UNDO command.}
        returns {TCL_OK, TCL_ERROR if failed.}
        source {Xilinx UG835 2026.1}
    }
}
command report_bd_diffs {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -format -takes format -values {text html} -closed \
           -detail {The format of the difference report; text returns the report to the Tcl console and html writes diff.html in the current working directory unless -file is given, and the default is text.}
    option -file -takes file_name \
           -detail {Write the difference report into the specified file; a suffix of .htm implies HTML output unless -format text is given.}
    option -open_html \
           -detail {Open the HTML report in the default web browser, implying a report format of HTML and conflicting with -format text.}
    option -brief \
           -detail {Return a brief message indicating whether the two designs differ without detailing how, usable as a pre-check for scripting purposes.}
    option -strict \
           -detail {Examine and report all changes as functional changes, including metadata changes such as tool version that are ignored by default.}
    option -fast \
           -detail {Perform a quick compare by reading the BD JSON files directly rather than opening in-memory block designs, skipping bus interface parameters from .XIT files.}
    option -return_string \
           -detail {Direct the text output to a Tcl string rather than to the standard output.}
    option -depth -takes depth \
           -detail {The depth of the design hierarchy to report when the designs are equal, defaulting to 4 and implying HTML format; differences are always reported regardless of this option.}
    option -crossprobe \
           -detail {Add cross-probing links to the HTML report so items can be selected from an open block design, implying HTML format and -open_html.}
    option -repository -takes repository \
           -detail {A user IP repository needed to resolve references to IP from outside the AMD IP catalog.}
    option -take_snapshot \
           -detail {Take an in-memory snapshot of the current open block design, requiring no design names or additional options.}
    option -diff_snapshot \
           -detail {Compare the current open block design against a previous in-memory snapshot of the block design.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    ;# NOTE(xilinx): the Syntax line writes both design words as required while
    ;# the Arguments prose marks each (Optional) and -take_snapshot needs
    ;# neither, so the arity minimum is left at zero.
    form Default {report_bd_diffs ?-format format? ?-file file_name? ?-open_html? ?-brief? ?-strict? ?-fast? ?-return_string? ?-depth depth? ?-crossprobe? ?-repository repository? ?-take_snapshot? ?-diff_snapshot? ?-quiet? ?-verbose? design1 design2}

    hover {
        summary {Report differences between two block designs.}
        synopsis {report_bd_diffs ?-format format? ?-file file_name? ?-open_html? ?-brief? ?-strict? ?-fast? ?-return_string? ?-depth depth? ?-crossprobe? ?-repository repository? ?-take_snapshot? ?-diff_snapshot? ?-quiet? ?-verbose? design1 design2}
        description {Performs a non-graphical comparison of two block design files (.bd) so revisions can be compared from within revision control systems. Designs are specified as BD objects returned by current_bd_design or get_bd_designs, or by path and file name, and an error is returned if both refer to the same design. The differences reported include additions or changes to the IP in use, design properties or parameters, design hierarchy, connectivity, and memory addressing. This Tcl command may compare bus interface parameters from IP .xit files that are not reported by the stand-alone diffbd executable.}
        returns {0 if no functional differences, >0 if different, -1 on error.}
        example {report_bd_diffs -take_snapshot}
        source {Xilinx UG835 2026.1}
    }
}
command report_bps {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_bps ?-quiet? ?-verbose? ?breakpoint_objects?}

    hover {
        summary {Print details of the given breakpoint objects.}
        synopsis {report_bps ?-quiet? ?-verbose? ?breakpoint_objects?}
        description {Reports a specific breakpoint object, or all breakpoints in the current simulation, which must be open for the command to return anything. A breakpoint is a user-determined stopping point in the source code used for debugging the design, and each breakpoint object is the one returned by add_bp when the breakpoint was added.}
        returns {Print the breakpoints id, file_name and line_number to the console in textual format.}
        example {report_bps bp1 bp2 bp5}
        source {Xilinx UG835 2026.1}
    }
}
command report_bus_skew {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table gives max, min, min_max with a min_max
    ;# default while the Arguments prose adds the four rise/fall values and
    ;# names max as the default, so the set is left open.
    option -delay_type -takes delay_type \
           -values {max min min_max max_rise max_fall min_rise min_fall} \
           -detail {The type of delay to analyze when running the bus skew report.}
    option -setup -detail {Check for setup violations, the same as -delay_type max.}
    option -hold \
           -detail {Check for hold violations, the same as -delay_type min; giving both -setup and -hold is the same as -delay_type min_max.}
    option -no_detailed_paths \
           -detail {Disable the detailed path analysis that the bus skew report includes by default, reporting only the top level summary table.}
    option -max_paths -takes count \
           -detail {The maximum number of paths to report per bus skew constraint, one or greater, defaulting to 1.}
    option -nworst -takes count \
           -detail {List up to this many worst paths per endpoint per constraint, one or greater, defaulting to 1.}
    option -unique_pins \
           -detail {Show at most one timing path per bus skew constraint for each unique set of pins.}
    option -path_type -takes path_type \
           -values {short full full_clock full_clock_expanded} -closed \
           -detail {The path data to output in the bus skew report, defaulting to full_clock_expanded.}
    option -sort_by_slack \
           -detail {Sort the summary and per-constraint sections of the report by slack.}
    option -input_pins \
           -detail {Show input pins in the timing path report, for use with -path_type full, full_clock, and full_clock_expanded.}
    option -no_header -detail {Do not write a header to the report.}
    option -significant_digits -takes digits \
           -detail {The number of significant digits in the output results, in the range 0 to 3, defaulting to 3.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -warn_on_violation \
           -detail {Generate a Critical Warning when the report contains a timing violation.}
    option -rpx -takes file_name \
           -detail {Write an interactive report (RPX) file that can be reloaded into memory with open_report; a .rpx file extension should be given as the tool assigns none.}
    option -cells -takes cells \
           -detail {Generate the report for the specified hierarchical cells rather than the whole design.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_bus_skew ?-delay_type delay_type? ?-setup? ?-hold? ?-no_detailed_paths? ?-max_paths count? ?-nworst count? ?-unique_pins? ?-path_type path_type? ?-sort_by_slack? ?-input_pins? ?-no_header? ?-significant_digits digits? ?-file file_name? ?-append? ?-return_string? ?-warn_on_violation? ?-rpx file_name? ?-cells cells? ?-quiet? ?-verbose?}

    hover {
        summary {Report the calculated bus skew among the signals constrained by set_bus_skew.}
        synopsis {report_bus_skew ?-delay_type delay_type? ?-setup? ?-hold? ?-no_detailed_paths? ?-max_paths count? ?-nworst count? ?-unique_pins? ?-path_type path_type? ?-sort_by_slack? ?-input_pins? ?-no_header? ?-significant_digits digits? ?-file file_name? ?-append? ?-return_string? ?-warn_on_violation? ?-rpx file_name? ?-cells cells? ?-quiet? ?-verbose?}
        description {Reports the calculated bus skew among the signals constrained by set_bus_skew. The bus skew requirement applies to both the slow and fast corners: the tool determines the earliest and latest arrival among all signals of the bus, calculates the bus skew for both process corners, and reports the worst case skew, with each signal reported relative to a reference signal from the same bus that can differ per signal. The report can be written to the Tcl console, assigned to a return string, or saved to a file.}
        returns {The bus skew report as specified, or an error if it fails.}
        example {report_bus_skew -max 32 -nworst 1 -path_type full -input_pins}
        source {Xilinx UG835 2026.1}
    }
}
command report_carry_chains {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file.}
    option -append \
           -detail {Append the output of the report to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -cell -takes cells \
           -detail {Limit the analysis to the specified hierarchical cell and any sub-modules of that cell.}
    option -max_chains -takes count \
           -detail {The number of chains to report; by default the longest carry chain is reported.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_carry_chains ?-file file_name? ?-append? ?-return_string? ?-cell cells? ?-max_chains count? ?-quiet? ?-verbose?}

    hover {
        summary {Report carry chains.}
        synopsis {report_carry_chains ?-file file_name? ?-append? ?-return_string? ?-cell cells? ?-max_chains count? ?-quiet? ?-verbose?}
        description {Reports the details of the carry chains used by the current open design, including the average depth of all carry chains as well as the specific depth of each carry chain reported. By default only the longest carry chain is reported, but the number of chains reported can be specified.}
        returns {Report.}
        example {report_carry_chains -max_chains 10}
        source {Xilinx UG835 2026.1}
    }
}
command report_cdc {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -from -takes clocks \
           -detail {Report clock domain crossing from the specified clock domain, named or as returned by get_clocks.}
    option -to -takes clocks \
           -detail {Report clock domain crossing into the specified clock domain, named or as returned by get_clocks.}
    option -cells -takes cells \
           -detail {Generate the report on the specified hierarchical cells rather than the whole design.}
    option -details \
           -detail {Provide a detailed report listing a summary table of the CDC paths and then the source and destination clocks and CDC paths for each clock pair.}
    option -summary \
           -detail {Report a summary by clocks of the CDC, giving message severity, clock pair, safe CDC, unknown CDC, and endpoint counts; this is the default report.}
    option -all_checks_per_endpoint \
           -detail {Report all violations for each endpoint of a CDC path instead of only the most critical violation per endpoint.}
    option -severity -takes severity -values {Critical Warning Info} -closed \
           -detail {Report only the CDC paths with the specified severity level.}
    option -no_header \
           -detail {Eliminate the report header from the results, which is useful when returning the results as a string.}
    option -show_waiver \
           -detail {Used with -details, add the waived CDC paths to the report along with a Waived column indicating which paths have been waived.}
    option -no_waiver \
           -detail {Ignore the waivers defined by create_waiver and report all CDC paths.}
    option -waived \
           -detail {Report only the CDC paths waived by create_waiver, returning the actual violation rather than the waiver definition.}
    option -file -takes file_name \
           -detail {Write the report into the specified file.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -name -takes name \
           -detail {The name of the Clock Domain Crossing report view to display in the Vivado IDE when run in GUI mode, closing and reopening a report view that already uses the name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_cdc ?-from clocks? ?-to clocks? ?-cells cells? ?-details? ?-summary? ?-all_checks_per_endpoint? ?-severity severity? ?-no_header? ?-show_waiver? ?-no_waiver? ?-waived? ?-file file_name? ?-append? ?-return_string? ?-name name? ?-quiet? ?-verbose?}

    hover {
        summary {Report the clock domain crossing (CDC) paths in the current design.}
        synopsis {report_cdc ?-from clocks? ?-to clocks? ?-cells cells? ?-details? ?-summary? ?-all_checks_per_endpoint? ?-severity severity? ?-no_header? ?-show_waiver? ?-no_waiver? ?-waived? ?-file file_name? ?-append? ?-return_string? ?-name name? ?-quiet? ?-verbose?}
        description {Reports in detail the clock domain crossing paths of the current synthesized or implemented design, analyzing paths between asynchronous clocks or clocks with no common period as well as synchronous paths ignored because of false path or max delay datapath_only exceptions. All clock domain crossings are reported unless -from and -to limit the clocks of interest, and only paths where both source and destination clocks are defined are reported, so check_timing should be run first. An unknown synchronization topology is Critical, a double register synchronizer missing the ASYNC_REG property is a Warning, clock enable, MUX, and MUX hold structures are Warnings, and other CDC paths are Info.}
        returns {The CDC report, giving severity, source clock, destination clock, CDC type, exceptions, endpoints, safe, unknown, and missing ASYNC_REG property.}
        example {report_cdc -from clk_pin_p -to [get_clocks clk_rx_clk_core]}
        source {Xilinx UG835 2026.1}
    }
}
command report_clock_interaction {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -from -takes clocks \
           -detail {The source clocks of the clock pair relationship between which the clock interactions are analyzed, given as clock names or clock objects.}
    option -to -takes clocks \
           -detail {The destination clocks of the clock pair relationship between which the clock interactions are analyzed, given as clock names or clock objects.}
    option -delay_type -takes delay_type -values {max min min_max} -closed \
           -detail {The type of delay to analyze when running the clock interaction report, defaulting to max.}
    option -setup -detail {Check for setup violations, the same as -delay_type max.}
    option -hold \
           -detail {Check for hold violations, the same as -delay_type min; giving both -setup and -hold is the same as -delay_type min_max.}
    option -significant_digits -takes digits \
           -detail {The number of significant digits in the output results, in the range 0 to 3, defaulting to 2.}
    option -no_header -detail {Do not write a header to the report.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -name -takes name \
           -detail {The name of the Clock Interaction Report view to display in GUI mode, closing and reopening a report view that already uses the name.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -cells -takes cells \
           -detail {Generate the report for the specified hierarchical cells rather than the whole design.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_clock_interaction ?-from clocks? ?-to clocks? ?-delay_type delay_type? ?-setup? ?-hold? ?-significant_digits digits? ?-no_header? ?-file file_name? ?-append? ?-name name? ?-return_string? ?-cells cells? ?-quiet? ?-verbose?}

    hover {
        summary {Report on clock timing paths and unclocked registers.}
        synopsis {report_clock_interaction ?-from clocks? ?-to clocks? ?-delay_type delay_type? ?-setup? ?-hold? ?-significant_digits digits? ?-no_header? ?-file file_name? ?-append? ?-name name? ?-return_string? ?-cells cells? ?-quiet? ?-verbose?}
        description {Reports clock interactions and signals that cross clock domains, to identify potential problems such as metastability, data loss, or incoherency where visibility into the paths that cross clock domains is beneficial. This command requires an open synthesized or implemented design. By default the report is written to the Tcl console or standard output, but it can also be written to a file or returned as a string.}
        returns {The clock interaction report.}
        example {set_delay_model -interconnect none
report_clock_interaction -delay_type min_max \
   -significant_digits 3 -name "results_1"}
        source {Xilinx UG835 2026.1}
    }
}
command report_clock_networks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the clock network report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -name -takes name \
           -detail {The name of the results to output to the GUI, giving a hierarchical tree view of the clock network.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -endpoints_only \
           -detail {Report the clock network endpoints, bucketed by cell type and sorted by clock pins and non-clock pins; cannot be used with -levels.}
    option -levels -takes levels \
           -detail {Expand the clock network through the specified number of levels of instances, greater than 0 and defaulting to 0; cannot be used with -endpoints_only.}
    option -expand_buckets \
           -detail {Expand all of the endpoint buckets returned by -endpoints_only or -levels so that all clock endpoints are reported; works only with one of those two options.}
    option -suppress_endpoints -takes endpoint_type -values {clock nonclock} -closed \
           -detail {Suppress reported paths from the clock root to clock pins or to non-clock endpoint pins.}
    option -clocks -takes clocks \
           -detail {The clock objects to include in the clock network report; when not specified all clocks are included.}
    option -unconstrained_roots -takes roots \
           -detail {For UltraScale devices and architectures with clock roots, the unconstrained clock root pins or ports to include; when not specified all unconstrained clock roots are reported.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-endpoints_only -levels}
    option_conflict {-file -return_string}

    form Default {report_clock_networks ?-file file_name? ?-append? ?-name name? ?-return_string? ?-endpoints_only? ?-levels levels? ?-expand_buckets? ?-suppress_endpoints endpoint_type? ?-clocks clocks? ?-unconstrained_roots roots? ?-quiet? ?-verbose?}

    hover {
        summary {Report clock networks.}
        synopsis {report_clock_networks ?-file file_name? ?-append? ?-name name? ?-return_string? ?-endpoints_only? ?-levels levels? ?-expand_buckets? ?-suppress_endpoints endpoint_type? ?-clocks clocks? ?-unconstrained_roots roots? ?-quiet? ?-verbose?}
        description {Reports the network fanout of each clock net in the open synthesized or implemented design. The default report simply gives the clock net names and the instance pins that are the startpoint of the clock, while the graphical form returned with -name provides a hierarchical tree view of the clock network. The report is returned to the standard output unless -file, -return_string, or -name is specified.}
        returns {The clock network report.}
        example {report_clock_networks -endpoints_only -clocks wbClk}
        source {Xilinx UG835 2026.1}
    }
}
command report_clock_uncertainty {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects \
        -detail {Reports the clock uncertainty on the specified timing path objects, used with get_timing_paths; do not use with -from, -to, -setup, or -hold.}
    option -from -takes clocks \
        -detail {The source clocks of the clock pairs relationship which analyzes the clock uncertainty, as clock names or clock objects.}
    option -rise_from -takes clocks \
        -detail {Like -from, but considers only the rising edge of the source clocks.}
    option -fall_from -takes clocks \
        -detail {Like -from, but considers only the falling edge of the source clocks.}
    option -to -takes clocks \
        -detail {The destination clocks of the clock pairs relationship, as clock names or clock objects.}
    option -rise_to -takes clocks \
        -detail {Like -to, but considers only the rising edge of the destination clocks.}
    option -fall_to -takes clocks \
        -detail {Like -to, but considers only the falling edge of the destination clocks.}
    option -setup -detail {Report the clock uncertainty for setup analysis; may be combined with -hold.}
    option -hold -detail {Report the clock uncertainty for hold analysis; may be combined with -setup.}
    option -details -detail {Provide a detailed breakdown report on the timing paths or clock pairs instead of only the summary table.}
    option -significant_digits -takes digits \
        -detail {The number of significant digits in the output results, from 0 to 3; the default is 3.}
    option -no_header -detail {Do not write a header to the report.}
    option -file -takes filename \
        -detail {Writes the report into the specified file, overwriting it unless -append is given.}
    option -append -detail {Append the output to the -file file rather than overwriting it (only with -file).}
    option -return_string \
        -detail {Directs the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_clock_uncertainty ?-of_objects objects? ?-from clocks? ?-rise_from clocks? ?-fall_from clocks? ?-to clocks? ?-rise_to clocks? ?-fall_to clocks? ?-setup? ?-hold? ?-details? ?-significant_digits digits? ?-no_header? ?-file filename? ?-append? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report the components of the total clock uncertainty.}
        synopsis {report_clock_uncertainty ?-of_objects objects? ?-from clocks? ?-rise_from clocks? ?-fall_from clocks? ?-to clocks? ?-rise_to clocks? ?-fall_to clocks? ?-setup? ?-hold? ?-details? ?-significant_digits digits? ?-no_header? ?-file filename? ?-append? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports the components of the total clock uncertainty for specific timing paths or between clock pairs, requiring an open synthesized or implemented design; applicable only on Versal devices. The Period, Transfer, and System Jitter columns report the key values for each clock pair.}
        returns {The clock uncertainty report, to the Tcl console, a file, or a string.}
        example {report_clock_uncertainty -from clk_pin_p -to [get_clocks clk_rx_clk_core]}
        source {Xilinx UG835 2026.1}
    }
}
command report_clock_utilization {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -write_xdc -takes file_name \
           -detail {Write XDC location constraints for the various clock resources to the specified file, so the placement of clock resources can be preserved for future iterations of the design.}
    option -cells -takes cells \
           -detail {Base the details of the report on the specified cells or bel instances rather than the whole design.}
    option -clock_roots_only \
           -detail {For UltraScale and architectures with clock roots, limit the report to the clock root assignments for each clock net; not supported for 7 series devices.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -name -takes name \
           -detail {The name of the Clock Utilization report view to display in the Vivado IDE when run in GUI mode, closing and reopening a report view that already uses the name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_clock_utilization ?-file file_name? ?-append? ?-write_xdc file_name? ?-cells cells? ?-clock_roots_only? ?-return_string? ?-name name? ?-quiet? ?-verbose?}

    hover {
        summary {Report information about clock nets in design.}
        synopsis {report_clock_utilization ?-file file_name? ?-append? ?-write_xdc file_name? ?-cells cells? ?-clock_roots_only? ?-return_string? ?-name name? ?-quiet? ?-verbose?}
        description {Returns information related to clock nets in the design and clock resource usage on the target device. With -write_xdc the report also generates placement constraints for the currently placed clock resources, which can be used to preserve that placement in later design iterations; for UltraScale devices use the BUFGCE LOC properties to recreate the placement exactly, or the equivalent CLOCK_REGION properties to leave the tool some flexibility. By default the report is written to the Tcl console or standard output, but it can also be written to a file or returned as a string.}
        returns {Report.}
        example {report_clock_utilization -write_xdc clock_util_xdc.txt}
        source {Xilinx UG835 2026.1}
    }
}
command report_clocks {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_clocks ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose? ?clocks?}

    hover {
        summary {Report clocks.}
        synopsis {report_clocks ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose? ?clocks?}
        description {Returns a table showing all the clocks in the current synthesized or implemented design, including propagated clocks, generated and auto-generated clocks, virtual clocks, and inverted clocks. The clocks to report are matched against the specified patterns, defaulting to the wildcard * which returns every clock, and more than one pattern can be given. More detailed information about each clock net can be obtained with report_clock_utilization.}
        returns {A table showing all the clocks in the design.}
        example {report_clocks *Clock*}
        source {Xilinx UG835 2026.1}
    }
}
command report_compile_order {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -fileset -takes fileset -detail {Limit the report to the specified fileset.}
    option -missing_instances \
           -detail {Return the list of cells that are missing source files in the current or specified fileset.}
    option -constraints \
           -detail {Report the compilation order of the constraint files in the current design, including constraints for any IP in the design.}
    option -sources \
           -detail {Report the compilation order of files found in the sources_1 fileset of design sources.}
    ;# NOTE(xilinx): the Arguments prose introduces the USED_IN values with
    ;# "include the following", so the set is left open.
    option -used_in -takes used_in -values {synthesis simulation implementation} \
           -detail {Return the files whose USED_IN property matches the specified value.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -of_objects -takes objects \
           -detail {Report the files associated with the specified filesets, sub-designs, or reconfiguration modules, given as objects returned by a get_* command rather than by name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_compile_order ?-fileset fileset? ?-missing_instances? ?-constraints? ?-sources? ?-used_in used_in? ?-file file_name? ?-append? ?-of_objects objects? ?-quiet? ?-verbose?}

    hover {
        summary {Report the compile order by analyzing files and constructing a hierarchy.}
        synopsis {report_compile_order ?-fileset fileset? ?-missing_instances? ?-constraints? ?-sources? ?-used_in used_in? ?-file file_name? ?-append? ?-of_objects objects? ?-quiet? ?-verbose?}
        description {Reports the compilation order of files in the active filesets: constraints, design sources, and simulation sources. The report can be limited to a fileset of interest with -fileset, or to constraints or sources with -constraints and -sources, and -used_in reports the processing order of files used in synthesis, simulation, or one of the implementation steps according to the USED_IN property. By default the report is returned to the Tcl console or standard output, but it can also be written to a file.}
        returns {The order of file processing for synthesis, implementation, and simulation.}
        example {report_compile_order -constraints}
        source {Xilinx UG835 2026.1}
    }
}
command report_conditions {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_conditions ?-quiet? ?-verbose? ?condition_objects?}

    hover {
        summary {Print details of the given condition objects.}
        synopsis {report_conditions ?-quiet? ?-verbose? ?condition_objects?}
        description {Reports a specific simulation condition, or all conditions in the current simulation, which must be open for the command to return anything. Conditions can be defined before the simulation starts; the simulator evaluates each condition expression whenever a signal change is detected and runs the condition commands when the expression becomes TRUE. The condition identifiers reported are the ones returned by add_condition.}
        returns {Prints name, id, condition_expression and commands of each condition object on the console.}
        example {report_conditions}
        source {Xilinx UG835 2026.1}
    }
}
command report_config_flows {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -force \
           -detail {Overwrite an existing file without prompting, for use with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -no_header \
           -detail {Do not generate the report header of tool version, date, design, device, and speed file information, leaving only the settings table.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    ;# NOTE(xilinx): the Syntax line writes -no_header after -quiet and
    ;# -verbose; the pack keeps -quiet and -verbose last in the form.
    form Default {report_config_flows ?-file file_name? ?-append? ?-force? ?-return_string? ?-no_header? ?-quiet? ?-verbose?}

    hover {
        summary {Report Config Flow Configurations.}
        synopsis {report_config_flows ?-file file_name? ?-append? ?-force? ?-return_string? ?-no_header? ?-quiet? ?-verbose?}
        description {Reports the current configuration settings for design flows, displaying flow parameters and their values in a formatted table of option names, allowable values, current value, default value, parameter type, and description. The report is displayed in the console by default, written to a file with -file, or captured as a Tcl variable with -return_string. Design, device, and speed file information appears in the header when a design is open, and hidden and advanced parameters are shown only when they have non-default values.}
        returns {The config flows report.}
        example {report_config_flows -file config_settings.txt}
        source {Xilinx UG835 2026.1}
    }
}
command report_config_implementation {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the configuration parameters report to the specified file, which is not overwritten unless -force is also used.}
    option -force -detail {Overwrite the specified file if it already exists.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_config_implementation ?-file file_name? ?-force? ?-append? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report Implementation flow Config param.}
        synopsis {report_config_implementation ?-file file_name? ?-force? ?-append? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports the user-definable implementation flow configuration parameters for the implementation processes, which are the parameters that can be modified with config_implementation. The command returns the selected report or the name of the output file, or an error if it fails.}
        returns {Report.}
        example {report_config_implementation}
        source {Xilinx UG835 2026.1}
    }
}
command report_config_timing {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the timing constraints configuration report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -name -takes name -detail {The name of the results to output to the GUI.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -all \
           -detail {Report the state of all timing related attributes and constraints in the design rather than the limited set of important attributes reported by default.}
    option -no_header \
           -detail {Disable the report header of report type, design, part, version, date, and command options.}
    option -rpx -takes file_name \
           -detail {Write an interactive report (RPX) file that can be reloaded into memory with open_report; a .rpx file extension should be given as the tool assigns none.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_config_timing ?-file file_name? ?-append? ?-name name? ?-return_string? ?-all? ?-no_header? ?-rpx file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Report settings affecting timing analysis.}
        synopsis {report_config_timing ?-file file_name? ?-append? ?-name name? ?-return_string? ?-all? ?-no_header? ?-rpx file_name? ?-quiet? ?-verbose?}
        description {Reports the configuration of the timing constraints of the current design. By default the report is abbreviated and contains only a few key timing constraints; -all returns all timing related configuration.}
        returns {The timing configuration report.}
        example {set timeConfig [report_config_timing -all -no_header -return_string]
puts $timeConfig}
        source {Xilinx UG835 2026.1}
    }
}
command report_constant_paths {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -max_paths_per_endpoint -takes count \
           -detail {The maximum number of paths to report per constant endpoint object, defaulting to 1.}
    ;# NOTE(xilinx): the Usage table gives variable_width as the default column
    ;# style while the Arguments prose names anchor_left, so no default is
    ;# claimed here.
    option -column_style -takes column_style \
           -values {variable_width anchor_left fixed_width} -closed \
           -detail {The format of the timing path portion of the report output.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it.}
    option -no_header \
           -detail {Do not print the header that carries tool, system, device, and design information at the top of the report.}
    option -of_objects -takes constant_paths \
           -detail {Report the specified constant paths, which can be retrieved with get_constant_paths.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Syntax line brackets the objects word while the
    ;# Arguments prose marks it (Required); the Syntax bracketing is kept.
    form Default {report_constant_paths ?-max_paths_per_endpoint count? ?-column_style column_style? ?-file file_name? ?-append? ?-no_header? ?-of_objects constant_paths? ?-return_string? ?-quiet? ?-verbose? ?objects?}

    hover {
        summary {Report constant paths.}
        synopsis {report_constant_paths ?-max_paths_per_endpoint count? ?-column_style column_style? ?-file file_name? ?-append? ?-no_header? ?-of_objects constant_paths? ?-return_string? ?-quiet? ?-verbose? ?objects?}
        description {Reports the constant path objects that meet the specified criteria, where the objects are the endpoint pins or design cells to report. By default one path per constant endpoint is traced.}
        returns {The constant paths report.}
        example {report_constant_paths [get_pins cpuEngine/or1200_cpu/or1200_sprs/esr/D]}
        source {Xilinx UG835 2026.1}
    }
}
command report_control_sets {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -hierarchical \
           -detail {Generate a text-based hierarchical report of the control sets in the design.}
    option -hierarchical_depth -takes depth \
           -detail {The depth of the hierarchy to report when -hierarchical is enabled, defaulting to 0 which reports the full design hierarchy.}
    option -sort_by -takes sort_criteria -values {clk clkEn set} -closed \
           -detail {Sort the detailed report generated by -verbose according to the specified criteria, and used only with -verbose.}
    option -cells -takes cells \
           -detail {Report control sets for the specified cell or bel instance objects.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_control_sets ?-file file_name? ?-append? ?-hierarchical? ?-hierarchical_depth depth? ?-sort_by sort_criteria? ?-cells cells? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report the unique control sets in design.}
        synopsis {report_control_sets ?-file file_name? ?-append? ?-hierarchical? ?-hierarchical_depth depth? ?-sort_by sort_criteria? ?-cells cells? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports the control sets of the current design, where a control set is the list of control signals (clock, CE, SR) for SLICE registers and LUTs. Registers must belong to the same control set to be packed into the same device resource, and a high number of control sets can make the device hard to fit and cause routing congestion and timing issues. By default an abbreviated report gives only the number of unique control sets, while -verbose returns a detailed report of all control sets for the whole design or for the specified cells.}
        returns {Report.}
        example {report_control_sets -verbose -sort_by {clk clkEn}}
        source {Xilinx UG835 2026.1}
    }
}
command report_datasheet {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -significant_digits -takes digits \
           -detail {The number of digits to display, in the range 0 to 3, defaulting to 3.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -sort_by -takes sort_order -values {clock port} -closed \
           -detail {The sorting order of the report, defaulting to sorting by clocks.}
    option -name -takes name \
           -detail {The name of the Datasheet report view to display in the Vivado IDE when run in GUI mode, closing and reopening a report view that already uses the name.}
    option -show_all_corners -detail {Report all process corners.}
    option -show_oe_timing \
           -detail {Report max and min values for paths using output enable, showing both ON and OFF states.}
    option -group -takes ports \
           -detail {A custom group of port objects as returned by get_ports, whose first port is the reference for the skew calculation; multiple groups can be given, each with its own reference clock port.}
    option -rpx -takes file_name \
           -detail {Write an interactive report (RPX) file that can be reloaded into memory with open_report; a .rpx file extension should be given as the tool assigns none.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_datasheet ?-significant_digits digits? ?-file file_name? ?-append? ?-return_string? ?-sort_by sort_order? ?-name name? ?-show_all_corners? ?-show_oe_timing? ?-group ports? ?-rpx file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Report data sheet.}
        synopsis {report_datasheet ?-significant_digits digits? ?-file file_name? ?-append? ?-return_string? ?-sort_by sort_order? ?-name name? ?-show_all_corners? ?-show_oe_timing? ?-group ports? ?-rpx file_name? ?-quiet? ?-verbose?}
        description {Creates a datasheet report for the current design, giving the setup and hold times of input I/Os in relation to clocks, the max and min delays from clocks to output pads, and the skews of input and output buses. The report carries the timing characteristics of the design at the package balls and pads, including package trace flight times, which can be disabled with config_timing_analysis -disable_flight_delays true. Source synchronous output skew is calculated automatically when -group lists all the ports of a data bus with the sourced clock output port first.}
        returns {The datasheet report.}
        example {report_datasheet -sort_by port -show_all_corners}
        source {Xilinx UG835 2026.1}
    }
}
command report_debug_core {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Return the report as a string rather than writing it to the standard output.}
    option -full_path \
           -detail {Display the net names using the full hierarchical path of the net.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_debug_core ?-file file_name? ?-append? ?-return_string? ?-full_path? ?-quiet? ?-verbose?}

    hover {
        summary {Report details on debug cores.}
        synopsis {report_debug_core ?-file file_name? ?-append? ?-return_string? ?-full_path? ?-quiet? ?-verbose?}
        description {Writes a report of the various Vivado debug cores in the current project and the parameters of those cores; debug cores are added to a project with create_debug_core. By default the report is written to the Tcl console or standard output, but it can also be written to a file or returned as a string.}
        returns {The debug core report.}
        example {report_debug_core -file C:/Data/FPGA_Design/project_1_cores.txt}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command report_default_switching_activity {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -static_probability \
           -detail {Include static probability in the report but do not include toggle rate.}
    option -toggle_rate \
           -detail {Include toggle rate in the report but do not include static probability.}
    option -type -takes types \
           -values {input input_set input_reset input_enable register dsp bram_read_enable bram_write_enable output_enable clock all} -closed \
           -detail {The component types whose default seed values for the vector-less propagation engine are reported (required).}
    option -file -takes file \
           -detail {Write the report into the specified file, overwriting an existing file of that name.}
    option -return_string -detail {Return the report as a string rather than a data set.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_default_switching_activity ?-static_probability? ?-toggle_rate? -type types ?-file file? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Get default switching activity on specified default types.}
        synopsis {report_default_switching_activity ?-static_probability? ?-toggle_rate? -type types ?-file file? ?-return_string? ?-quiet? ?-verbose?}
        description {Displays the default switching activity currently configured for the specified element types, as defined with the set_default_switching_activity command. Both toggle rate and static probability are reported unless -toggle_rate or -static_probability is given to limit the results, and by default the report is written to the Tcl console or standard output rather than to a file or a string.}
        returns {Nothing.}
        example {set swa1 [report_default_switching_activity -type all -return_string]}
        source {Xilinx UG835 2012.2}
    }
}
command report_design_analysis {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the analysis results into the specified file, overwriting an existing file unless -append is also used.}
    option -csv -takes file_name \
           -detail {Write a CSV file showing the timing paths and analysis features, overwriting an existing file.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -complexity \
           -detail {Perform complexity analysis of the design and report the Rent exponent, average fanout, and primitive histogram.}
    option -cells -takes cells \
           -detail {The hierarchical modules to analyze instead of the top cell, given by name or as objects returned by get_cells; cannot be used with -hierarchical_depth.}
    option -bounding_boxes -takes bounding_boxes \
           -detail {Regions of the device to analyze for complexity, each given as a pair of device tiles naming the lower-left and upper-right corners, which limits the area and the analysis time.}
    option -hierarchical_depth -takes depth \
           -detail {Perform the complexity analysis on the hierarchy of the design or cell to the specified depth rather than only the top level, defaulting to 1 and requiring -complexity.}
    option -rent_greater_than -takes value \
           -detail {The minimum value of Rent to be reported, defaulting to 0.6 and valid only with -complexity.}
    option -instances_greater_than -takes count \
           -detail {The minimum number of instances in a hierarchy for a Rent calculation to be performed, defaulting to 15000 and valid only with -complexity.}
    option -instances_lesser_than -takes count \
           -detail {The maximum number of instances in a hierarchy for a Rent calculation to be performed, used with -instances_greater_than to create a range and valid only with -complexity.}
    option -av_fanout_greater_than -takes value \
           -detail {The minimum average fanout within a hierarchical module for a Rent calculation to be performed, defaulting to 3.0 and valid only with -complexity.}
    option -congestion \
           -detail {Report the vertical and horizontal routing congestion of the placed design per tile, which can only be run after place_design or implementation and always covers the whole design.}
    option -min_congestion_level -takes level \
           -detail {The minimum congestion level to show, an integer between 3 and 8 defaulting to 5.}
    option -timing \
           -detail {Run design analysis in timing mode to report setup and hold characteristics of critical paths, which is the default when no other options are given, and which cannot be used with -cells or -hierarchical_depth.}
    option -setup \
           -detail {Limit the reporting scope to setup path characteristics, requiring -timing.}
    option -hold \
           -detail {Limit the reporting scope to hold path characteristics, requiring -timing; with -extend two side-by-side setup and hold reports are generated for the same paths.}
    option -show_all \
           -detail {Add more characteristics to the timing characteristics report.}
    option -full_logical_pin \
           -detail {Output the full hierarchical pin name in the design analysis report.}
    option -routed_vs_estimated \
           -detail {Report the estimated and actual routed delays side by side for the same path, which requires set_delay_model -interconnect actual.}
    option -logic_level_distribution \
           -detail {Report the logic level distribution of the timing report to help identify the longer paths in the design; it is runtime intensive and not reported by default.}
    option -logic_level_dist_paths -takes count \
           -detail {The number of critical paths for analyzing logic level distribution, one or greater and defaulting to 1000, used with -logic_level_distribution.}
    option -min_level -takes level \
           -detail {Group all timing paths with logic levels or routes below the specified value into a single bin; the value must be at least 1.}
    option -max_level -takes level \
           -detail {Group all timing paths with logic levels or routes above the specified value into a single bin; the value must be greater than -min_level, or zero.}
    option -return_timing_paths \
           -detail {Return timing_path objects as well as the analysis report, for use with -end_point_clocks and -logic_levels; specifying it disables -timing so no timing results are returned.}
    option -of_timing_paths -takes timing_paths \
           -detail {Report the characteristics of the specified timing path objects, as returned by get_timing_paths, instead of the most critical paths; requires -timing.}
    option -max_paths -takes count \
           -detail {The number of paths to report for critical path analysis, defaulting to 1.}
    option -extend \
           -detail {Perform an extended setup analysis reporting the path ending at the critical path start point, the critical path, and the path starting at the critical path endpoint; requires -timing.}
    option -routes \
           -detail {Report the path distribution with respect to the number of routes per end point clock instead of logic levels.}
    option -end_point_clocks -takes clocks \
           -detail {Limit the timing paths under consideration to those in the specified clock group, given by name or as returned by get_clocks.}
    option -logic_levels -takes levels \
           -detail {Filter timing paths by the specified number of logic levels, usable with -end_point_clocks to further limit paths by clock domain.}
    option -qor_summary -detail {Include a summary of the QoR for the design.}
    option -json -takes file_name \
           -detail {Write the QoR summary in JSON format to the specified file, overwriting an existing file, and usable only with -qor_summary, -complexity, and -logic_level_distribution.}
    option -name -takes name \
           -detail {The name of the Design Analysis Report view to display in GUI mode, closing and reopening a report view that already uses the name.}
    option -no_pr_attribute \
           -detail {Report the design analysis without partial reconfiguration attributes.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Arguments prose says -timing cannot be used with -cells
    ;# or -hierarchical_depth, but a worked example in the same section combines
    ;# -complexity -hierarchical_depth with -timing, so only the -cells and
    ;# -hierarchical_depth conflict is declared here.
    option_conflict {-cells -hierarchical_depth}
    option_conflict {-file -return_string}

    form Default {report_design_analysis ?-file file_name? ?-csv file_name? ?-append? ?-return_string? ?-complexity? ?-cells cells? ?-bounding_boxes bounding_boxes? ?-hierarchical_depth depth? ?-rent_greater_than value? ?-instances_greater_than count? ?-instances_lesser_than count? ?-av_fanout_greater_than value? ?-congestion? ?-min_congestion_level level? ?-timing? ?-setup? ?-hold? ?-show_all? ?-full_logical_pin? ?-routed_vs_estimated? ?-logic_level_distribution? ?-logic_level_dist_paths count? ?-min_level level? ?-max_level level? ?-return_timing_paths? ?-of_timing_paths timing_paths? ?-max_paths count? ?-extend? ?-routes? ?-end_point_clocks clocks? ?-logic_levels levels? ?-qor_summary? ?-json file_name? ?-name name? ?-no_pr_attribute? ?-quiet? ?-verbose?}

    hover {
        summary {Report design analysis.}
        synopsis {report_design_analysis ?-file file_name? ?-csv file_name? ?-append? ?-return_string? ?-complexity? ?-cells cells? ?-bounding_boxes bounding_boxes? ?-hierarchical_depth depth? ?-rent_greater_than value? ?-instances_greater_than count? ?-instances_lesser_than count? ?-av_fanout_greater_than value? ?-congestion? ?-min_congestion_level level? ?-timing? ?-setup? ?-hold? ?-show_all? ?-full_logical_pin? ?-routed_vs_estimated? ?-logic_level_distribution? ?-logic_level_dist_paths count? ?-min_level level? ?-max_level level? ?-return_timing_paths? ?-of_timing_paths timing_paths? ?-max_paths count? ?-extend? ?-routes? ?-end_point_clocks clocks? ?-logic_levels levels? ?-qor_summary? ?-json file_name? ?-name name? ?-no_pr_attribute? ?-quiet? ?-verbose?}
        description {Provides timing data on critical path characteristics and complexity of the design, to identify and analyze problem areas subject to timing closure issues and routing congestion. The command has three modes: timing mode calls the static timing engine and reports the characteristics of each critical path, such as clock skew, placement obstacles, and physical constraints; complexity mode reports the Rent exponent, average fanout, and primitive histogram of the design or of hierarchical levels of it; and congestion mode analyzes the placed design for routing congestion so placement can be changed to avoid hot spots.}
        returns {The file created, the analysis results returned to the Tcl console, or an error if it fails.}
        example {report_design_analysis -complexity -cells {cpuEngine fftEngine}}
        source {Xilinx UG835 2026.1}
    }
}
command report_dfx_summary {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file instead of the Tcl console.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it.}
    ;# NOTE(xilinx): -force is described in this section's Arguments prose but is
    ;# absent from its Syntax line and Usage table; it is kept here because the
    ;# prose documents it for this command.
    option -force -detail {Overwrite the specified file if it already exists.}
    option -name -takes name \
           -detail {The name of the results to output to the GUI.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_dfx_summary ?-file file_name? ?-return_string? ?-append? ?-force? ?-name name? ?-quiet? ?-verbose?}

    hover {
        summary {Report DFX summary.}
        synopsis {report_dfx_summary ?-file file_name? ?-return_string? ?-append? ?-force? ?-name name? ?-quiet? ?-verbose?}
        description {Reports information for a dynamic function exchange design on reconfigurable Pblocks, static and RP utilization, PPLOCs, clock utilization, and a detailed RP table that also includes prohibit site count, shared tiles count, and overlap tiles count. It can be used at any stage of the implementation flow for standard DFX, abstract shell, and Both mode designs, and each RP is assigned a unique Partition ID used consistently across all report tables. The command is supported for Versal adaptive SoC devices only.}
        returns {The DFX summary report.}
        example {report_dfx_summary -file dfx_summary.txt}
        source {Xilinx UG835 2026.1}
    }
}
command report_disable_timing {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -user_disabled \
           -detail {Report only the timing arcs that have been disabled by the user with set_disable_timing.}
    option -column_style -takes column_style -values {variable_width anchor_left} -closed \
           -detail {The alignment of the columns in the report, defaulting to variable_width.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -cells -takes cells \
           -detail {Base the details of the report on the specified cells rather than the whole design.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_disable_timing ?-user_disabled? ?-column_style column_style? ?-file file_name? ?-append? ?-cells cells? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report disabled timing arcs.}
        synopsis {report_disable_timing ?-user_disabled? ?-column_style column_style? ?-file file_name? ?-append? ?-cells cells? ?-return_string? ?-quiet? ?-verbose?}
        description {Displays a report of the timing paths that will be excluded from timing analysis in the current synthesized or implemented design. The report has columns for the cell or port associated with the timing path, the From and To points, the condition, and the reason for exclusion, which is one of constraint for a set_disable_timing constraint, constant for a logic constant, loop for breaking a logic loop, bidirect instance path for a feedback path through bidirectional instances, or bidirect net path for a feedback path on nets with bidirectional pins.}
        returns {The report of timing paths excluded from timing analysis.}
        example {report_disable_timing}
        source {Xilinx UG835 2026.1}
    }
}
command report_drc {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -name -takes name \
           -detail {The name to assign to the results when run in GUI mode.}
    ;# NOTE(xilinx): the Syntax line and Usage table spell -upgrade_cw as a flag
    ;# while the Arguments prose writes it as -upgrade_cw <arg>; the Syntax
    ;# spelling is used here.
    option -upgrade_cw \
           -detail {Report all found Critical Warning violations as Errors for this report.}
    option -checks -takes checks \
           -detail {The rule checks to run against the current design, listed by group name or full key, which creates a temporary user-defined rule deck for the run.}
    option -ruledecks -takes ruledecks \
           -detail {The name of one or more factory or user-defined DRC rule decks whose rules the design is checked against; the default rule deck is used when neither this nor -checks is given.}
    option -file -takes file_name \
           -detail {Write the DRC report into the specified file, overwriting an existing file unless -append is also used.}
    option -rpx -takes file_name \
           -detail {Write an interactive report (RPX) file that can be reloaded into memory with open_report; a .rpx file extension should be given as the tool assigns none.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -waived \
           -detail {Run and report only the DRC checks waived by create_waiver, returning the actual violation rather than the waiver definition.}
    option -no_waivers \
           -detail {Ignore the waivers defined by create_waiver and report all DRC violations.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -json -takes file_name \
           -detail {Write the results in JSON format to the specified file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-checks -ruledecks}
    option_conflict {-file -return_string}

    form Default {report_drc ?-name name? ?-upgrade_cw? ?-checks checks? ?-ruledecks ruledecks? ?-file file_name? ?-rpx file_name? ?-append? ?-waived? ?-no_waivers? ?-return_string? ?-json file_name? ?-quiet? ?-verbose?}

    hover {
        summary {Run DRC.}
        synopsis {report_drc ?-name name? ?-upgrade_cw? ?-checks checks? ?-ruledecks ruledecks? ?-file file_name? ?-rpx file_name? ?-append? ?-waived? ?-no_waivers? ?-return_string? ?-json file_name? ?-quiet? ?-verbose?}
        description {Checks the current open design against a specified set of design rule checks, or rule decks, and reports the errors or violations found. Violations are returned as Vivado objects that can be listed with get_drc_violations and are associated with cells, pins, ports, nets, and sites of the design. Predefined checks are listed by get_drc_checks and custom ones created with create_drc_check, while rule decks group checks for a stage of the design flow and are listed by get_drc_ruledecks. A rule whose IS_ENABLED property is false is not run whether named by -checks or reached through -ruledecks, and current results can be cleared with reset_drc.}
        returns {A report of the violations found by the design rule checks.}
        example {report_drc -ruledecks placer_checks -file C:/Data/DRC_Rpt1.txt}
        source {Xilinx UG835 2026.1}
    }
}
command report_drivers {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_drivers ?-quiet? ?-verbose? hdl_object}

    hover {
        summary {Print drivers along with current driving values for an HDL wire or signal object.}
        synopsis {report_drivers ?-quiet? ?-verbose? hdl_object}
        description {Prints the name and value of the driving signal as well as the current value of a signal type HDL object, so that the signal or process driving a specific HDL signal or net object can be determined; a driver of a signal is the statement in the HDL source file performing assignment to it. The HDL objects can be specified by name or returned by get_objects, and the values reported depend on the state of the simulation.}
        returns {A report of the drivers on the specified objects, or an error if it fails.}
        example {report_drivers [get_objects leds_n]}
        source {Xilinx UG835 2026.1}
    }
}
command report_environment {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the system information into the specified file, overwriting an existing file unless -append is also used.}
    option -format -takes format -values {text xml} -closed \
           -detail {The format of the output report, defaulting to text; xml is valid only with -file and cannot be used with -append.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Return the report content as a Tcl string rather than writing it to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_environment ?-file file_name? ?-format format? ?-append? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report system information.}
        synopsis {report_environment ?-file file_name? ?-format format? ?-append? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports the details of the system environment the tool is running under, including operating system version, CPU, memory, available disk space, and the settings of various environment variables. The default is to write the report to the standard output, but it can be written to a file instead.}
        returns {The system environment report.}
        example {report_environment -file C:/Data/toolEnv.txt}
        source {Xilinx UG835 2026.1}
    }
}
command report_exceptions {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -from -takes objects \
           -detail {The start points on the timing path to report exceptions on, given as pins, ports, cells, or clocks.}
    option -rise_from -takes objects \
           -detail {The start points to report exceptions on for the rising edge of the path.}
    option -fall_from -takes objects \
           -detail {The start points to report exceptions on for the falling edge of the path.}
    option -to -takes objects \
           -detail {The end points of the timing path to report exceptions on, given as pins, ports, cells, or clocks.}
    option -rise_to -takes objects \
           -detail {The end points to report exceptions on for the rising edge of the path.}
    option -fall_to -takes objects \
           -detail {The end points to report exceptions on for the falling edge of the path.}
    option -through -takes objects \
           -detail {The pins, cells, or nets through which the timing path passes.}
    option -rise_through -takes objects \
           -detail {The pins, cells, or nets through which the rising edge timing path passes.}
    option -fall_through -takes objects \
           -detail {The pins, cells, or nets through which the falling edge timing path passes.}
    option -ignored \
           -detail {Report only the timing exceptions fully ignored by the timing engine; partially overridden exceptions are not reported.}
    option -scope_override \
           -detail {Report only scoped timing exceptions fully or partially overridden by top-level constraints, not those overridden by other scoped constraints.}
    option -summary -detail {Report a summary of all timing exceptions.}
    option -coverage \
           -detail {Report the coverage of all timing exceptions as the percentage of pins reached by the exception compared to the pins specified by -from, -through, and -to.}
    option -ignored_objects \
           -detail {Report the start point and end point objects that are part of timing exceptions and ignored by the timing engine.}
    option -count_objects \
           -detail {Report the number of objects in the timing exceptions.}
    option -write_merged_exceptions \
           -detail {Write the merged timing exceptions, which include both the valid and the invalid exceptions.}
    option -write_valid_exceptions \
           -detail {Write only the valid timing exceptions, which are those with valid start points and end points.}
    option -no_header -detail {Do not write a header to the report.}
    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -name -takes name \
           -detail {The name of the report view to display in the Vivado IDE when run in GUI mode, closing and reopening a report view that already uses the name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_exceptions ?-from objects? ?-rise_from objects? ?-fall_from objects? ?-to objects? ?-rise_to objects? ?-fall_to objects? ?-through objects? ?-rise_through objects? ?-fall_through objects? ?-ignored? ?-scope_override? ?-summary? ?-coverage? ?-ignored_objects? ?-count_objects? ?-write_merged_exceptions? ?-write_valid_exceptions? ?-no_header? ?-file file_name? ?-append? ?-return_string? ?-name name? ?-quiet? ?-verbose?}

    hover {
        summary {Report timing exceptions.}
        synopsis {report_exceptions ?-from objects? ?-rise_from objects? ?-fall_from objects? ?-to objects? ?-rise_to objects? ?-fall_to objects? ?-through objects? ?-rise_through objects? ?-fall_through objects? ?-ignored? ?-scope_override? ?-summary? ?-coverage? ?-ignored_objects? ?-count_objects? ?-write_merged_exceptions? ?-write_valid_exceptions? ?-no_header? ?-file file_name? ?-append? ?-return_string? ?-name name? ?-quiet? ?-verbose?}
        description {Reports all timing exceptions applied to setup and hold checks by the timing constraints of the current design, or the exceptions on the specified timing paths. Timing exceptions are defined by constraints such as set_false_path or set_multicycle_path that change the default assumptions for timing paths. Using -from, -through, and -to only matches exceptions defined with the same options, and the cell, pin, and port objects must be the same even when the patterns differ. The exceptions are reported to the standard output by default, but can be redirected to a file or to a Tcl string.}
        returns {The timing exceptions report.}
        example {report_exceptions -ignored}
        source {Xilinx UG835 2026.1}
    }
}
command report_frames {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose \
           -detail {Suspend message limits during command execution, and give the source line and file information, with absolute path, for every call.}

    form Default {report_frames ?-quiet? ?-verbose?}

    hover {
        summary {Print, in textual format, stack frames when current_scope is a process waiting inside a subprogram.}
        synopsis {report_frames ?-quiet? ?-verbose?}
        description {Returns a list of strings of sub-program names and the calling HDL process in the sub-program call hierarchy for the current HDL process scope, starting with the HDL process and running to the most recent sub-program. Each frame has a frame index, with the most recent sub-program shown at the top with index 0, and the symbol -> marking the current frame, which defaults to the most recently called sub-program and can be changed with current_frame. The command strictly follows current_scope, and returns an empty list when the current scope is not an HDL process scope waiting inside a sub-program.}
        returns {A string.}
        source {Xilinx UG835 2026.1}
    }
}
command report_high_fanout_nets {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used.}
    option -format -takes format -values {text xml} -closed \
           -detail {The format of the output report, defaulting to text; xml is valid only with -file and cannot be used with -append.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -ascending -detail {Report nets in ascending order.}
    option -timing \
           -detail {Add timing data showing the worst slack and worst delay on high fanout nets, which slows the run time and is not supported with -histogram.}
    option -histogram \
           -detail {Format the report as a histogram showing the number of fanouts and the number and percentage of nets in the design with that many fanouts.}
    option -load_types \
           -detail {Report the load types on the net, sorted both by load type and by the device resource at which the loads are placed; only the load type is reported on an unplaced synthesized design.}
    option -clock_regions \
           -detail {Report the load distribution across clock regions, which can only be used after placement.}
    option -slr \
           -detail {Report the load distribution across SLRs, which can only be used after placement.}
    option -max_nets -takes count \
           -detail {The number of nets to report, defaulting to 10.}
    option -fanout_greater_than -takes fanout \
           -detail {Report only nets whose fanout is greater than the specified integer, defaulting to 0.}
    option -fanout_lesser_than -takes fanout \
           -detail {Report only nets whose fanout is less than the specified integer, defaulting to INT_MAX.}
    option -name -takes name \
           -detail {The name of the High Fanout Nets Report view to display in the Vivado IDE when run in GUI mode, closing and reopening a report view that already uses the name.}
    option -cells -takes cells \
           -detail {Report the nets attached to the specified cell instances, given by name or as objects returned by get_cells.}
    option -clocks -takes clocks \
           -detail {Report the nets of the specified clocks, given by name or as objects returned by get_clocks.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-histogram -ascending}
    option_conflict {-histogram -timing}
    option_conflict {-histogram -load_types}
    option_conflict {-histogram -clock_regions}
    option_conflict {-histogram -slr}
    option_conflict {-histogram -max_nets}
    option_conflict {-histogram -fanout_greater_than}
    option_conflict {-histogram -fanout_lesser_than}
    option_conflict {-load_types -clock_regions -slr}
    option_conflict {-file -return_string}

    form Default {report_high_fanout_nets ?-file file_name? ?-format format? ?-append? ?-ascending? ?-timing? ?-histogram? ?-load_types? ?-clock_regions? ?-slr? ?-max_nets count? ?-fanout_greater_than fanout? ?-fanout_lesser_than fanout? ?-name name? ?-cells cells? ?-clocks clocks? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report high fanout nets.}
        synopsis {report_high_fanout_nets ?-file file_name? ?-format format? ?-append? ?-ascending? ?-timing? ?-histogram? ?-load_types? ?-clock_regions? ?-slr? ?-max_nets count? ?-fanout_greater_than fanout? ?-fanout_lesser_than fanout? ?-name name? ?-cells cells? ?-clocks clocks? ?-return_string? ?-quiet? ?-verbose?}
        description {Reports the fanout of nets in the design, starting with the highest fanout nets and working down, with options controlling various aspects of the report. The command can be run on an implemented design or on the synthesized netlist, although the results are more complete on the implemented design.}
        returns {Report.}
        example {report_high_fanout_nets -clocks [get_clocks gt*]}
        source {Xilinx UG835 2026.1}
    }
}
command report_hw_axi_txn {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -w -takes bytes_per_line \
           -detail {The number of data bytes per output line, defaulting to 8.}
    option -t -takes data_format \
           -detail {The form and size of the output data, given as d, b, o, u, or x followed by the number of bytes per integer for signed decimal, binary, octal, unsigned decimal, or hexadecimal, and defaulting to x4.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_hw_axi_txn ?-w bytes_per_line? ?-t data_format? ?-quiet? ?-verbose? hw_axi_txns}

    hover {
        summary {Report formatted hardware AXI transaction data.}
        synopsis {report_hw_axi_txn ?-w bytes_per_line? ?-t data_format? ?-quiet? ?-verbose? hw_axi_txns}
        description {Reports the results of the specified AXI transactions on the JTAG to AXI Master, hw_axi. It is used after creating hw_axi_txn objects on existing hw_axi objects with create_hw_axi_txns and running the hw_axi to exercise the defined transaction; the core should be reset with reset_hw_axi before issuing transactions. The transaction objects must be specified as returned by get_hw_axi_txns.}
        returns {The transaction data in the specified format, or an error if it fails.}
        example {reset_hw_axi [get_hw_axis hw_axi_1]
create_hw_axi_txn read_txn [get_hw_axis hw_axi_1] -type READ \
   -address 00000000 -size 32 -len 4 -cache 3 -id 0
run_hw_axi [get_hw_axi_txns [get_hw_axis]]
report_hw_axi_txn [get_hw_axi_txns read_txn]}
        source {Xilinx UG835 2026.1}
    }
}
command report_hw_ddrmc {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, given with its full path.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    ;# NOTE(xilinx): the Syntax line writes the hw_objects word as required
    ;# while the Arguments prose marks it (Optional), so the arity minimum is
    ;# left at zero.
    form Default {report_hw_ddrmc ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose? hw_objects}

    hover {
        summary {Report Versal integrated and soft memory controller (DDRMC) configuration, calibration, and margin data.}
        synopsis {report_hw_ddrmc ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose? hw_objects}
        description {Reports formatted information on memory IP hardware configuration, calibration, and margin, without the graphical margin scan plots available in the Vivado logic analyzer or Vivado Lab Edition. Versal memory controllers implemented in a design are associated with hw_ddrmc objects, as returned by get_hw_ddrmcs, and let the calibration and the read and write window margins of a memory interface design be verified.}
        returns {The reported data, or an error if it fails.}
        example {report_hw_ddrmc -file C:/Data/ddrmc_report.txt [get_hw_ddrmcs]}
        source {Xilinx UG835 2026.1}
    }
}
command report_hw_mig {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, given with its full path.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    ;# NOTE(xilinx): the Syntax line writes the hw_objects word as required
    ;# while the Arguments prose marks it (Optional), so the arity minimum is
    ;# left at zero.
    form Default {report_hw_mig ?-file file_name? ?-append? ?-return_string? ?-quiet? ?-verbose? hw_objects}

