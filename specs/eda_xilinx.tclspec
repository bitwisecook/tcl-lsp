command read_saif {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -strip_path -takes path \
           -detail {Strip the specified instance path prefix from elements in the SAIF file so they map properly to instances in the current design.}
    option -no_strip \
           -detail {Do not strip the first two levels of hierarchy from the SAIF file.}
    option -out_file -takes file_name \
           -detail {The name of an output file where unmatched nets and other messages are reported; without it the information is not saved to a file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -reads

    form Default {read_saif ?-strip_path path? ?-no_strip? ?-out_file file_name? file ?-quiet? ?-verbose?}

    hover {
        summary {Import simulation data in SAIF format.}
        synopsis {read_saif ?-strip_path path? ?-no_strip? ?-out_file file_name? file ?-quiet? ?-verbose?}
        description {Reads a Switching Activity Interchange Format (SAIF) file for use during power analysis by the report_power command, so that running report_power after reading the file uses its activity rates. Switching activity can also be read in the form of a VCD file using the read_vcd command.}
        returns {Nothing.}
        example {read_saif -strip_path /design//top/F1 C:/Data/design1.saif}
        source {Xilinx UG835 2012.2}
    }
}
command read_twx {
    dialects tcl8.5
    required_package vivado

    arity 2..

    option -cell -takes cell \
           -detail {Interpret names in the report file as relative to the specified hierarchical cell, applying the timing paths to that cell.}
    option -pblock -takes pblock \
           -detail {Interpret names in the report file as relative to the specified Pblock.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -reads

    form Default {read_twx ?-cell cell? ?-pblock pblock? name file ?-quiet? ?-verbose?}

    hover {
        summary {Read timing results from the Trace STA tool.}
        synopsis {read_twx ?-cell cell? ?-pblock pblock? name file ?-quiet? ?-verbose?}
        description {Imports timing results from the TWX format timing report files generated by the Xilinx Timing Reporter And Circuit Evaluator (TRACE) tool. The TWX file can be imported at the top-level, which is the default, or at a specific cell-level or relative to a specific Pblock. Both name, the name of the Timing Results view to create, and file are required positional arguments, with name given first; after import the timing results display in the Timing Results view in GUI mode.}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
command read_vcd {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -strip_path -takes path \
           -detail {Strip the specified instance path prefix from elements in the VCD file so they map properly to instances in the current design.}
    option -no_strip \
           -detail {Do not strip the first two levels of hierarchy from the VCD file.}
    option -out_file -takes file_name \
           -detail {The name of an output file where unmatched nets and other messages are reported; without it the information is not saved to a file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

