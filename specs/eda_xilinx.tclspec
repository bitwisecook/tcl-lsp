command export_hardware {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -bitstream \
           -detail {Export the bitstream and BMM model data to the SDK export directory in addition to the hardware specification file; an error is returned if the bitstream file does not exist.}
    option -dir -takes directory \
           -detail {Export directory; by default the hardware files are written under project_name.sdk/SDK/SDK_Export/hw in the local project directory.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    side_effect FileIo -writes

    form Default {export_hardware ?-bitstream? ?-dir directory? ?-quiet? ?-verbose? files ?run?}

    hover {
        summary {Export the system hardware platform for SDK.}
        synopsis {export_hardware ?-bitstream? ?-dir directory? ?-quiet? ?-verbose? files ?run?}
        description {Exports the Embedded Processor system hardware platform so SDK can support software design for the embedded processor sources in the project. The files argument is a files object holding the XPS project files (.xmp) to export, obtained with get_files, and the optional run argument names an implementation run to export. By default the hardware specification file (.xml) is written for each specified embedded processor, and its output can be used to invoke SDK with launch_sdk.}
        returns {Nothing.}
        example {export_hardware -bitstream [get_files *.xmp]}
        source {Xilinx UG835 2012.2}
    }
}
command filter {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -regexp \
           -detail {Operators =~ and !~ use regular expressions, which are always anchored to the start of the search string.}
    option -nocase \
           -detail {Perform case-insensitive matching (only with -regexp).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {filter ?-regexp? ?-nocase? ?-quiet? ?-verbose? ?objects? ?filter?}

    hover {
        summary {Filter a list of objects, resulting in a new list.}
        synopsis {filter ?-regexp? ?-nocase? ?-quiet? ?-verbose? ?objects? ?filter?}
        description {Takes a list of objects, usually obtained from one of the get_ commands, and returns a reduced list of objects that match the specified filter expression. The expression filters on property values of the objects; the operators are == and != for equals and not-equals, =~ and !~ for contains and not-contains, the numeric comparisons <, >, <= and >=, and && and || to join expressions. Boolean properties can be evaluated directly as true or not true.}
        returns {A new list.}
        example {filter [get_parts] {speed == -3}}
        source {Xilinx UG835 2012.2}
    }
}
