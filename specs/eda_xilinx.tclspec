command config_timing_analysis {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -disable_paths_between_unrelated_ucf_clocks -takes state -values {true false} -closed \
           -detail {Disable timing paths between unrelated UCF clocks, which has the effect of a false path between them and disables cross-clock domain analysis; the default is false and the option is not supported for SDC constraints.}
    option -enable_input_delay_default_clock -takes state -values {true false} -closed \
           -detail {Launch SDC unclocked input delays from an internally defined clock; the default is false and the option is not supported for UCF constraints.}
    option -enable_preset_clear_arcs -takes state -values {true false} -closed \
           -detail {Time paths through asynchronous preset or clear timing arcs; the default is false.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_timing_analysis ?-disable_paths_between_unrelated_ucf_clocks state? ?-enable_input_delay_default_clock state? ?-enable_preset_clear_arcs state? ?-quiet? ?-verbose?}

    hover {
        summary {Configure timing analysis general settings.}
        synopsis {config_timing_analysis ?-disable_paths_between_unrelated_ucf_clocks state? ?-enable_input_delay_default_clock state? ?-enable_preset_clear_arcs state? ?-quiet? ?-verbose?}
        description {Configures general features of timing analysis. This command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {config_timing_analysis -disable_paths_between_unrelated_ucf_clocks true}
        source {Xilinx UG835 2012.2}
    }
}
command config_timing_corners {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -corner -takes corner -values {Slow Fast} -closed \
           -detail {Name of the timing corner to be modified; the corner names are case sensitive.}
    ;# NOTE(xilinx): the Usage table lists none, max, min, min_max while the
    ;# Arguments prose names only max, min, and min_max, so the set is left open.
    option -delay_type -takes delay_type -values {none max min min_max} \
           -detail {Type of path delays to be analysed for the specified timing corner.}
    option -setup \
           -detail {Enable the timing corner for setup analysis, equivalent to -delay_type max.}
    option -hold \
           -detail {Enable the timing corner for hold analysis, equivalent to -delay_type min; giving both -setup and -hold is the same as -delay_type min_max.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_timing_corners ?-corner corner? ?-delay_type delay_type? ?-setup? ?-hold? ?-quiet? ?-verbose?}

    hover {
        summary {Configure single or multi corner timing analysis settings.}
        synopsis {config_timing_corners ?-corner corner? ?-delay_type delay_type? ?-setup? ?-hold? ?-quiet? ?-verbose?}
        description {Configures the Slow and Fast timing corners for single or multi-corner timing analysis. This command operates silently and does not return direct feedback of its operation.}
        returns {Nothing.}
        example {config_timing_corners -corner Fast -delay_type min}
        source {Xilinx UG835 2012.2}
    }
}
command config_webtalk {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -info \
           -detail {Show whether WebTalk is currently enabled or disabled; the state depends on both the user and install settings, and either one disabled disables WebTalk.}
    option -user -takes state -values {on off} -closed \
           -detail {Enable or disable WebTalk for the current user.}
    option -install -takes state -values {on off} -closed \
           -detail {Enable or disable WebTalk for all users of the current installation; when off, individual users cannot enable WebTalk with -user, and administrator rights may be needed.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_webtalk ?-info? ?-user state? ?-install state? ?-quiet? ?-verbose?}

    hover {
        summary {Enable or disable WebTalk, which sends software, IP and device usage statistics to Xilinx.}
        synopsis {config_webtalk ?-info? ?-user state? ?-install state? ?-quiet? ?-verbose?}
        description {WebTalk is a secure design data collection feature that reports how Xilinx FPGA devices, software, and IP are used. This command returns the current state of WebTalk for the current user and software installation and can enable or disable it; participation is voluntary except for the use of the WebPACK license to generate a bitstream, where transmission is mandatory and ignores the user and install preferences.}
        returns {Nothing.}
        example {config_webtalk -user on}
        source {Xilinx UG835 2012.2}
    }
}
