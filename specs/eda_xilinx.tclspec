    option -verbose -detail {Suspend message limits during command execution.}

    form Default {delete_qor_ruledecks ?-type type? ?-quiet? ?-verbose? ?ids?}

    hover {
        summary {Delete one or more user defined QoR rule deck objects.}
        synopsis {delete_qor_ruledecks ?-type type? ?-quiet? ?-verbose? ?ids?}
        description {Removes one or more QoR rule decks from Vivado, matching rule deck names against the given names. The command only operates on user-created rule decks and does not delete factory rule decks. The same name can be assigned to both assessment and suggestion rule decks, though unique names are recommended.}
        returns {Nothing.}
        example {delete_qor_ruledecks AMD_Netlist_OptDesign}
        source {Xilinx UG835 2026.1}
    }
}
command delete_qor_suggestions {
    available {tcl 8.5}
    required_package vivado

