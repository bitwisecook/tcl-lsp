command get_timing_arcs {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -from -takes startpoints \
           -detail {The starting points of the timing arcs to return; ports, pins, or nets can be specified.}
    option -to -takes endpoints \
           -detail {The endpoints of the timing arcs to return; ports, pins, or nets can be specified.}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -of_objects -takes cells \
           -detail {Get the timing arcs of the specified cell objects; if a cell is given, all cell_arcs of that cell are returned.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_timing_arcs ?-from startpoints? ?-to endpoints? ?-filter expression? ?-of_objects cells? ?-quiet? ?-verbose?}

    hover {
        summary {Get a list of timing arcs.}
        synopsis {get_timing_arcs ?-from startpoints? ?-to endpoints? ?-filter expression? ?-of_objects cells? ?-quiet? ?-verbose?}
        description {Gets the timing arcs for the specified objects, optionally filtered on their properties. A timing arc is part of a timing path and can be a wire between two pins, or the internal path of a logic instance between an input pin and an output pin, or between clock input and data output pins.}
        returns {A list of timing arc objects.}
        example {report_property -all [get_timing_arcs -of_objects [get_cells go_IBUF_inst]]}
        source {Xilinx UG835 2026.1}
    }
}
command get_timing_paths {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -from -takes startpoints \
           -detail {The startpoints of the timing paths to analyze, given as pins, ports, cells, or clocks; for a clock, all startpoints clocked by it are analyzed.}
    option -rise_from -takes startpoints \
           -detail {As -from, but considers only the rising edge of signals coming from the startpoints.}
    option -fall_from -takes startpoints \
           -detail {As -from, but considers only the falling edge of signals coming from the startpoints.}
    option -to -takes endpoints \
           -detail {The endpoints of the timing paths to analyze, given as pins, ports, cells, or clocks; for a clock, all endpoints clocked by it are analyzed.}
    option -rise_to -takes endpoints \
           -detail {As -to, but considers only the rising edge of signals going to the endpoints.}
    option -fall_to -takes endpoints \
           -detail {As -to, but considers only the falling edge of signals going to the endpoints.}
    option -through -takes through_points \
           -detail {Consider only paths through the specified pins, cells, or nets; the order of successive -through points defines a specific path, and one -through with multiple objects passes through any of them.}
    option -rise_through -takes through_points \
           -detail {As -through, but analyzes paths with a rising transition at the specified objects.}
    option -fall_through -takes through_points \
           -detail {As -through, but analyzes paths with a falling transition at the specified objects.}
    option -delay_type -takes delay_type \
           -values {max min min_max max_rise max_fall min_rise min_fall} -closed \
           -detail {The type of path delay to analyze; the default is max.}
    option -setup -detail {Get max delay timing paths, equivalent to -delay_type max.}
    option -hold -detail {Get min delay timing paths, equivalent to -delay_type min.}
    option -max_paths -takes max_paths \
           -detail {The maximum number of paths to return when sorted by slack, or per path group when sorted by group; the value must be at least 1 and the default is 1.}
    option -nworst -takes nworst \
           -detail {The number of worst paths to show to each endpoint; the value must be at least 1 and the default is 1.}
    option -unique_pins \
           -detail {For each unique set of pins, show at most one path per path group.}
    option -slack_lesser_than -takes slack \
           -detail {Include paths with slack less than this value; the default is 1e+30.}
    option -slack_greater_than -takes slack \
           -detail {Include paths with slack greater than this value; the default is -1e+30.}
    option -group -takes path_groups -detail {Limit the paths to those in these path groups.}
    option -no_report_unconstrained -detail {Do not get unconstrained paths.}
    option -user_ignored \
           -detail {Only report paths which have infinite slack because of set_false_path or set_clock_groups timing constraints.}
    option -routable_nets \
           -detail {Store the number of routable nets traversed as a property on the returned timing paths.}
    ;# NOTE(xilinx): the Usage table lists only_data_crossing among the -inter_slr
    ;# values while the Arguments prose omits it, so the set is left open.
    option -inter_slr -takes crossing_type \
           -values {any_crossing data_crossing only_data_crossing clock_crossing no_crossing} \
           -detail {Report timing paths crossing between SLRs, selected by their SLR-crossing characteristics.}
    option -sort_by -takes sort_order -values {group slack} -closed \
           -detail {The sorting order of the returned paths; the default is slack.}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -regexp -detail {Patterns specified in the filter are full regular expressions.}
    option -nocase \
           -detail {Perform case-insensitive matching for patterns specified in the filter (only with -regexp).}
    option -cell -takes cells \
           -detail {Apply the command to the specified cell, given by name or as an object returned by get_cells.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_timing_paths ?-from startpoints? ?-rise_from startpoints? ?-fall_from startpoints? ?-to endpoints? ?-rise_to endpoints? ?-fall_to endpoints? ?-through through_points? ?-rise_through through_points? ?-fall_through through_points? ?-delay_type delay_type? ?-setup? ?-hold? ?-max_paths max_paths? ?-nworst nworst? ?-unique_pins? ?-slack_lesser_than slack? ?-slack_greater_than slack? ?-group path_groups? ?-no_report_unconstrained? ?-user_ignored? ?-routable_nets? ?-inter_slr crossing_type? ?-sort_by sort_order? ?-filter expression? ?-regexp? ?-nocase? ?-cell cells? ?-quiet? ?-verbose?}

    hover {
        summary {Get timing paths.}
        synopsis {get_timing_paths ?-from startpoints? ?-rise_from startpoints? ?-fall_from startpoints? ?-to endpoints? ?-rise_to endpoints? ?-fall_to endpoints? ?-through through_points? ?-rise_through through_points? ?-fall_through through_points? ?-delay_type delay_type? ?-setup? ?-hold? ?-max_paths max_paths? ?-nworst nworst? ?-unique_pins? ?-slack_lesser_than slack? ?-slack_greater_than slack? ?-group path_groups? ?-no_report_unconstrained? ?-user_ignored? ?-routable_nets? ?-inter_slr crossing_type? ?-sort_by sort_order? ?-filter expression? ?-regexp? ?-nocase? ?-cell cells? ?-quiet? ?-verbose?}
        description {Gets the timing path objects that meet the specified criteria, so that paths can be predefined for report_timing or used for custom reporting and analysis. The command is very similar to report_timing, but returns timing path objects to query for properties or to pass to other Tcl commands where report_timing returns a file or a string; -setup and -hold may be given together, which is the same as -delay_type min_max.}
        returns {Timing path objects that meet the specified criteria.}
        example {get_timing_paths -max_paths 1000 -filter {LOGIC_LEVELS > 1}}
        source {Xilinx UG835 2026.1}
    }
}
command get_value {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -radix -takes radix \
           -values {default dec bin oct hex unsigned ascii smag} -closed \
           -detail {The radix to use when returning the value; dec is a signed decimal, so specify unsigned when dealing with unsigned data.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_value ?-radix radix? ?-quiet? ?-verbose? hdl_object}

    hover {
        summary {Get current value of the selected HDL object (variable, signal, wire, reg).}
        synopsis {get_value ?-radix radix? ?-quiet? ?-verbose? hdl_object}
        description {Gets the value of a single HDL object at the current simulation run time, where the object is named or is returned as an object by get_objects. HDL objects include HDL signals, variables, and constants as defined in the Verilog or VHDL test bench and source files; use report_values to return the values of more than one HDL object.}
        returns {A string representation of the value of an hdl_object.}
        example {get_value sysClk}
        source {Xilinx UG835 2026.1}
    }
}
