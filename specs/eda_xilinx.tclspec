command commit_hw_sio {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {commit_hw_sio ?-quiet? ?-verbose? hw_objects}

    hover {
        summary {Commit property changes on serial I/O hardware objects to the device.}
        synopsis {commit_hw_sio ?-quiet? ?-verbose? hw_objects}
        description {Writes the current property values of the specified serial I/O hardware objects to the hardware device connected to the hardware server. The SIO IBERT core follows a set and commit model, where set_property changes values on the objects and this command drives them onto the device, while refresh_hw_sio does the reverse. Objects may be any serial I/O object such as GTs, RXs, TXs, PLLs or Commons, along with device, target or server objects, but not hw_sio_scan or hw_sio_sweep objects.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
