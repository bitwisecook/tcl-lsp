command write_hw_svf {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite an existing file of the same name.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_hw_svf ?-force? file_name ?-quiet? ?-verbose?}

    hover {
        summary {Generate an SVF file for the current hardware target.}
        synopsis {write_hw_svf ?-force? file_name ?-quiet? ?-verbose?}
        description {Writes a Serial Vector Format (SVF) file, an ASCII file of programming instructions and configuration data used by ATE machines and embedded controllers to perform boundary-scan operations. The SVF commands generated while programming devices on an SVF target are cached to a temporary file, and this command saves that cache under the given file name and then clears it so that new device commands are captured afresh. A suffix of .svf should be given, as none is assigned automatically.}
        returns {A message indicating success; an error if it fails.}
        example {program_hw_devices [lindex [get_hw_devices] 0]
write_hw_svf C:/Data/k7_design.svf}
        source {Xilinx UG835 2026.1}
    }
}
command write_ibis {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Overwrite the IBIS file if it already exists.}
    option -allmodels \
           -detail {Export all buffer models available for the target architecture; by default only the buffer models used by the floorplan are included.}
    option -nopin \
           -detail {Disable per-pin modeling of the path from the die pad to the package pin, reducing the package to a single RLC transmission line model in the Package section that applies to all pins.}
    option -no_pin_mapping \
           -detail {Do not output the Pin Mapping section for UltraScale, UltraScale+, and Versal devices.}
    option -truncate -takes truncate -values {20 40 0} -closed \
           -detail {The maximum length for a signal name in the output file, where 0 means unlimited and the default of 40 characters follows the IBIS version 4.2 specification.}
    option -component_name -takes component_name \
           -detail {A new component name to replace the default, which is the device family, for use in multiple FPGA designs.}
    option -ibs -takes ibs_file \
           -detail {An updated generic IBIS models file that overrides the models found in the installation parts directory, required for parts that have no generic models there.}
    option -pkg -takes pkg_file \
           -detail {An updated per pin parasitic package data file that overrides the package file found in the installation parts directory, required for parts that have no generic models there.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_ibis ?-force? ?-allmodels? ?-nopin? ?-no_pin_mapping? ?-truncate truncate? ?-component_name component_name? ?-ibs ibs_file? ?-pkg pkg_file? file ?-quiet? ?-verbose?}

    hover {
        summary {Write IBIS models for the current floorplan.}
        synopsis {write_ibis ?-force? ?-allmodels? ?-nopin? ?-no_pin_mapping? ?-truncate truncate? ?-component_name component_name? ?-ibs ibs_file? ?-pkg pkg_file? file ?-quiet? ?-verbose?}
        description {Writes the IBIS models for the target device in the current design, combining the netlist and implementation details of the design with the per-pin parasitic package information to create a custom IBIS model. Because design information is incorporated into the model, an RTL, netlist, or implemented design must be open when running this command. The .ibs extension on the output name is optional.}
        returns {Name of the output file.}
        example {write_ibis -allmodels -truncate 0 C:/Data/FPGA_Design/ibisOut.txt}
        source {Xilinx UG835 2026.1}
    }
}
command write_inferred_xdc {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -force -detail {Overwrite the specified output file if it already exists.}
    option -all \
           -detail {Write all inferred constraints for the current design except missing clocks, which are obtained separately with -clocks.}
    option -append \
           -detail {Append the constraints to the file rather than overwriting it.}
    option -async_clocks \
           -detail {Find asynchronous clock groups that should be defined with set_clock_groups -asynchronous.}
    option -all_async_reg \
           -detail {Find the missing ASYNC_REG properties for safe and unsafe clock domain crossings.}
    option -clock_groups \
           -detail {Find asynchronous and exclusive clock groups, equivalent to specifying both -async_clocks and -excl_clocks.}
    option -clocks \
           -detail {Find missing clock and generated clock definitions that should be defined by create_clock and create_generated_clock, which is the default report when no other constraint option is given.}
    option -excl_clocks \
           -detail {Find logically and physically exclusive clock groups that should be defined with set_clock_groups -physically_exclusive or -logically_exclusive.}
    option -exceptions \
           -detail {Find missing timing exceptions such as set_false_path or set_multicycle_path.}
    option -io_constraints \
           -detail {Find missing input and output delays such as set_input_delay and set_output_delay.}
    option -merge_existing_constraints \
           -detail {Report the existing user-defined constraints matching the type of inferred constraints being reported, written to the file as comments.}
    option -name -takes name \
           -detail {The name of the results set that the reported constraints are returned to when running in the Vivado IDE.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_inferred_xdc ?-force? ?-all? ?-append? ?-async_clocks? ?-all_async_reg? ?-clock_groups? ?-clocks? ?-excl_clocks? ?-exceptions? ?-io_constraints? ?-merge_existing_constraints? ?-name name? ?file? ?-quiet? ?-verbose?}

    hover {
        summary {Write a file with inferred XDC timing constraints.}
        synopsis {write_inferred_xdc ?-force? ?-all? ?-append? ?-async_clocks? ?-all_async_reg? ?-clock_groups? ?-clocks? ?-excl_clocks? ?-exceptions? ?-io_constraints? ?-merge_existing_constraints? ?-name name? ?file? ?-quiet? ?-verbose?}
        description {Finds constraints that should be defined in the open synthesized or implemented design and writes the timing constraints generated automatically by the timing engine rather than defined in an existing XDC file. Run -clocks first to obtain the suggested clock and generated clock constraints, which are written with a period of 1 ns for editing, then add the edited file to the design with read_xdc or add_files followed by update_timing. The command may need to be run several times with different options to capture every inferred constraint. A file extension should be given as part of the name, as none is supplied.}
        returns {A transcript of the process; an error if it fails.}
        example {write_inferred_xdc -clocks C:/Data/design1_inferred_clocks.xdc}
        source {Xilinx UG835 2026.1}
    }
}
command write_ip_tcl {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -force -detail {Overwrite an existing IP Tcl file of the same name.}
    option -no_ip_version \
           -detail {Do not include the IP version in the IP VLNV of the create_ip commands, which can have implications when there are major IP version changes.}
    option -ip_name -takes ip_name \
           -detail {Use this name instead of the current name for the IP, so that sourcing the script creates an IP of that name; not supported for multiple IP.}
    option -multiple_files \
           -detail {Create one Tcl file per IP object given, each named after the IP it writes, instead of a single file for all of them.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_ip_tcl ?-force? ?-no_ip_version? ?-ip_name ip_name? ?-multiple_files? ?objects? ?tcl_filenames? ?-quiet? ?-verbose?}

    hover {
        summary {Write a Tcl script on disk that will recreate a given IP.}
        synopsis {write_ip_tcl ?-force? ?-no_ip_version? ?-ip_name ip_name? ?-multiple_files? ?objects? ?tcl_filenames? ?-quiet? ?-verbose?}
        description {Exports the given IP as a Tcl script that recreates a configured instance of the IP from the original sources. The script must be sourced in the same software release it was generated in so that the needed IP versions are available, after which the created IP can be migrated with the upgrade_ip flow. IP objects representing block design cells are not part of the generated file, and any directory path given must already exist.}
        returns {IP TCL file.}
        example {write_ip_tcl [get_ips] my_ips.tcl}
        source {Xilinx UG835 2026.1}
    }
}
command write_iphys_opt_tcl {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -place \
           -detail {Write out the placement data for optimized cells alongside the physical optimization commands, which the default script does not include.}
    option -binary -detail {Write out the script in binary format.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_iphys_opt_tcl ?-place? ?-binary? ?output? ?-quiet? ?-verbose?}

    hover {
        summary {Write an interactive physical optimization Tcl script.}
        synopsis {write_iphys_opt_tcl ?-place? ?-binary? ?output? ?-quiet? ?-verbose?}
        description {Writes the physical optimizations performed on the post-placed design as a Tcl script of iphys_opt_design commands, which can be applied to the design netlist prior to placement or replayed as needed. The command can only be run after placement on a design that has had physical optimizations performed, and the script records the optimizations only, not placement and routing changes.}
        returns {Nothing if successful; an error if it fails.}
        example {write_iphys_opt_tcl C:/Data/myDesign_physopt.tcl}
        source {Xilinx UG835 2026.1}
    }
}
command write_mem_info {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -cell -takes cell -detail {Create only a partial MMI file for this named cell.}
    option -no_partial_mmi \
           -detail {Do not write partial files for a Dynamic Function eXchange design.}
    option -force_detect_xpm -detail {Traverse the netlist and check for XPM.}
    option -force -detail {Overwrite an existing memory info file if one exists.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_mem_info ?-cell cell? ?-no_partial_mmi? ?-force_detect_xpm? ?-force? file ?-quiet? ?-verbose?}

    hover {
        summary {Write the memory map information of the design to an MMI file.}
        synopsis {write_mem_info ?-cell cell? ?-no_partial_mmi? ?-force_detect_xpm? ?-force? file ?-quiet? ?-verbose?}
        description {Writes a memory information (MMI) file describing how individual block RAMs are grouped into a contiguous address space called an address block, together with their placement and address ranges. An implemented design must be open so that the placement data is available. The updatemem command reads the MMI file to identify the physical block RAM resource that maps to a specific address range and to merge it with a bitstream. The default extension of .mmi is used if none is given.}
        returns {The name of the .mmi file.}
        example {write_mem_info C:/Data/design1.mmi}
        source {Xilinx UG835 2026.1}
    }
}
command write_messages {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Usage table and the Arguments prose give different
    ;# severity lists (the prose adds CRITICAL), so no value set is declared.
    option -severity -takes severity \
           -detail {The message severity list to query, such as ERROR, CRITICAL WARNING, WARNING, INFO, STATUS, ALL, or OUTPUT, where ALL covers every severity and OUTPUT covers the message types reported in the vivado.log file.}
    option -force -detail {Overwrite an existing file if one exists.}
    option -message_db -takes message_db \
           -detail {The message source file name, for example xst.xmsgs or rds.pb.}
    option -suppression -takes suppression -values {SUPPRESSED UNSUPPRESSED ALL} -closed \
           -detail {Write only suppressed messages, only unsuppressed messages, or both, defaulting to ALL.}
    option -modified_severity -takes modified_severity -values {MODIFIED UNMODIFIED ALL} -closed \
           -detail {Write only messages whose severity was changed, only unchanged ones, or both, defaulting to ALL.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_messages ?-severity severity? ?-force? ?-message_db message_db? ?-suppression suppression? ?-modified_severity modified_severity? ?file? ?-quiet? ?-verbose?}

    hover {
        summary {Write Vivado messages to the specified file.}
        synopsis {write_messages ?-severity severity? ?-force? ?-message_db message_db? ?-suppression suppression? ?-modified_severity modified_severity? ?file? ?-quiet? ?-verbose?}
        description {Writes the messages of the current session to the specified file, filtered by severity, by message source database, by whether the messages were suppressed, and by whether their severity was modified. If no path is given the file is written into the current working directory.}
        returns {The name of the output file; an error if it fails.}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
