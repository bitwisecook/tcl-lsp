        description {Returns the hardware server objects that are connected to the current instance of the Vivado Design Suite through connect_hw_server; the open_hw command must be used to open the Hardware Manager before this command is used. Hardware servers are instances of the hw_server application running remotely or on the local machine, and manage connections to a hardware target such as a board containing a JTAG chain of devices to be programmed and debugged.}
        returns {Hardware servers.}
        example {get_hw_servers}
        source {Xilinx UG835 2026.1}
    }
}
command get_hw_sio_commons {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects \
           -detail {Return the QPLL objects of the specified hw_server, hw_target, hw_device, hw_sio_ibert, hw_sio_gtgroup, or hw_sio_pll objects; cannot be used with a search pattern.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_hw_sio_commons ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of hardware SIO GT commons.}
        synopsis {get_hw_sio_commons ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the QPLL objects, hw_sio_commons, defined on the IBERT debug core on the current hardware device. Each serial transceiver channel has a ring Channel PLL (CPLL), and UltraScale and 7 series high-speed transceivers add a shared Quad PLL (QPLL) per quad to support high speed, high performance, and low power multi-lane applications; on the device the GTXE2_CHANNEL component holds the transceiver and CPLL units while GTXE2_COMMON holds the QPLL unit.}
        returns {Hardware SIO GT commons.}
        example {get_hw_sio_commons -of [get_hw_sio_iberts]}
        source {Xilinx UG835 2026.1}
    }
}
command get_hw_sio_gtgroups {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects \
           -detail {Return the hw_sio_gtgroup objects of the specified hw_server, hw_target, hw_device, hw_sio_ibert, hw_sio_common, hw_sio_pll, hw_sio_gt, hw_sio_tx, or hw_sio_rx objects; cannot be used with a search pattern.}
