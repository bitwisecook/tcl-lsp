        description {Writes a report of the various ChipScope debug cores in the current project and the parameters of those cores, where debug cores are added to a project with create_debug_core or read_chipscope_cdc. By default the report is written to the Tcl console or standard output, but it can also be written to a file or returned as a string.}
        returns {Nothing.}
        example {report_debug_core -file C:/Data/FPGA_Design/project_1_cores.txt}
        source {Xilinx UG835 2012.2}
    }
}
command report_default_switching_activity {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -static_probability \
           -detail {Include static probability in the report but do not include toggle rate.}
    option -toggle_rate \
           -detail {Include toggle rate in the report but do not include static probability.}
    option -type -takes types \
           -values {input input_set input_reset input_enable register dsp bram_read_enable bram_write_enable output_enable clock all} -closed \
           -detail {The component types whose default seed values for the vector-less propagation engine are reported (required).}
    option -file -takes file \
           -detail {Write the report into the specified file, overwriting an existing file of that name.}
    option -return_string -detail {Return the report as a string rather than a data set.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_default_switching_activity ?-static_probability? ?-toggle_rate? -type types ?-file file? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Get default switching activity on specified default types.}
        synopsis {report_default_switching_activity ?-static_probability? ?-toggle_rate? -type types ?-file file? ?-return_string? ?-quiet? ?-verbose?}
        description {Displays the default switching activity currently configured for the specified element types, as defined with the set_default_switching_activity command. Both toggle rate and static probability are reported unless -toggle_rate or -static_probability is given to limit the results, and by default the report is written to the Tcl console or standard output rather than to a file or a string.}
        returns {Nothing.}
        example {set swa1 [report_default_switching_activity -type all -return_string]}
        source {Xilinx UG835 2012.2}
    }
}
