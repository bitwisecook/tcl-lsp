    hover {
        summary {Delete a list of available QoR suggestions.}
        synopsis {delete_qor_suggestions ?-quiet? ?-verbose? ?ids?}
        description {Removes QoR suggestion objects that are currently in memory, matching suggestion names against the given IDs. Suggestion objects are generated by running report_qor_suggestions without -of_objects and by reading an RQS file with read_qor_suggestions; the IDs can be returned by get_qor_suggestions.}
        returns {Nothing.}
        example {delete_qor_suggestions [get_qor_suggestions]}
        source {Xilinx UG835 2026.1}
    }
}
