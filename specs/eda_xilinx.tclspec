        summary {Get a list of Pblocks in the current design.}
        synopsis {get_pblocks ?-regexp? ?-nocase? ?-filter expression? ?-of_objects cells? ?-include_nested_pblocks? ?-quiet? ?-verbose? ?patterns?}
        description {Gets the Pblocks defined in the current project that match the search patterns; the default pattern is the wildcard * which returns all Pblocks in the project.}
        returns {A list of Pblock objects.}
        example {get_pblocks -include_nested_pblocks usbTop}
        source {Xilinx UG835 2026.1}
    }
}
command get_pips {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes objects \
           -detail {Return the PIPs of the specified site, net, tile, node, wire, or pip objects; always recommended, since the number of PIPs returned can otherwise be considerable.}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -uphill \
           -detail {Return the PIPs uphill of the provided wire or PIPs, which precede them in the logic network.}
    option -downhill \
           -detail {Return the PIPs downhill of the provided wire or PIPs, which follow them in the logic network.}
    option -from -takes start_points \
           -detail {Return the ordered list of PIPs beginning at these pip or site_pin objects; may be combined with -uphill, and the default is downhill.}
    option -to -takes end_points \
           -detail {Return the ordered list of PIPs ending at these wire or site_pin objects; may be combined with -uphill, and the default is downhill.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_pips ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-uphill? ?-downhill? ?-from start_points? ?-to end_points? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of pips in the device.}
        synopsis {get_pips ?-of_objects objects? ?-regexp? ?-nocase? ?-filter expression? ?-uphill? ?-downhill? ?-from start_points? ?-to end_points? ?-quiet? ?-verbose? ?patterns?}
        description {Programmable interconnect points, or PIPs, provide the physical routing paths on the device used to connect logic networks. This command returns the PIPs on the device that match the search patterns and requires an open design; the default pattern is the wildcard * which gets all PIPs, which is not recommended given their number, so -of_objects should be used to limit the result.}
        returns {A list of pip objects.}
        example {get_pips -of_object [get_tiles DSP_R_X9Y75]}
        source {Xilinx UG835 2026.1}
    }
}
command get_pkgpin_bytegroups {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -of_objects -takes objects \
           -detail {Get the pkgpin_bytegroups of the specified package_pin, iobank, site, or port objects.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_pkgpin_bytegroups ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of package pin byte groups.}
        synopsis {get_pkgpin_bytegroups ?-regexp? ?-nocase? ?-filter expression? ?-of_objects objects? ?-quiet? ?-verbose? ?patterns?}
        description {Gets the byte groups on the I/O banks of the current UltraScale device. On UltraScale devices the I/O bank hierarchy adds byte groups and nibbles to the 7 series division into I/O banks and package pins: an iobank has 2 or 4 bytegroups, each pkgpin_bytegroup has an upper and a lower nibble and 13 package pins, and each pkgpin_nibble has 6 or 7 pins.}
        returns {A list of pin_group objects.}
        example {get_pkgpin_bytegroups -of [get_iobanks 44]}
        source {Xilinx UG835 2026.1}
    }
}
