command infer_diff_pairs {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -file_type -takes file_type -values {csv ucf xdc} -closed \
           -detail {Input file type to import when inferring differential pairs (required).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {infer_diff_pairs -file_type file_type ?-quiet? ?-verbose? file}

    hover {
        summary {Infer differential pairs, for ports just imported from a CSV, UCF, or XDC file.}
        synopsis {infer_diff_pairs -file_type file_type ?-quiet? ?-verbose? file}
        description {Infers differential pairs in an I/O Pin Planning project after the I/O pin information has been imported with read_csv, read_ucf, or read_xdc. Pairs are identified from the Signal Name, DiffPair Signal, DiffPair Type, and I/O Standard attributes as matching, unmatched, single port, or inferred differential pairs.}
        returns {Nothing.}
        example {read_xdc C:/Vivado_Install/io_1.xdc
infer_diff_pairs C:/Vivado_Install/io_1.xdc -file_type xdc}
        source {Xilinx UG835 2012.2}
    }
}
