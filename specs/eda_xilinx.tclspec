        summary {Create a new net.}
        synopsis {create_bd_net ?-quiet? ?-verbose? name}
        description {Creates a new net in the current IP integrator subsystem design. Net names can be given from the top level as a name only, or within the design hierarchy as a hierarchical net name.}
        returns {The newly created net object, or "" if it failed.}
        example {create_bd_net net1}
        source {Xilinx UG835 2026.1}
    }
