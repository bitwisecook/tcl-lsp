        description {Saves the specified wave configuration object, or the wave configuration object associated with the specified wave window object, to the named file; if no object is specified the wave configuration object of the last active wave window is saved. When -object is given as a string rather than an object, a string containing a colon names a wave window and any other string names a WCFG object.}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
command select_objects {
