command make_wrapper {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -top \
           -detail {Create a top-level Verilog or VHDL wrapper that instantiates the specified source as the top of the design hierarchy.}
    option -testbench \
           -detail {Create a simulation testbench for the specified source, including the DUT module instantiation.}
    option -inst_template \
           -detail {Create an instantiation template for the specified source, which is not added to the project and is generated for reference purposes only.}
    option -fileset -takes fileset \
           -detail {The fileset to add the wrapper to when importing it into the project.}
    option -import \
           -detail {Import the generated wrapper file into the project, adding it to the appropriate fileset.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {make_wrapper ?-top? ?-testbench? ?-inst_template? ?-fileset fileset? ?-import? files ?-quiet? ?-verbose?}

    hover {
        summary {Generate an HDL wrapper for the specified source.}
        synopsis {make_wrapper ?-top? ?-testbench? ?-inst_template? ?-fileset fileset? ?-import? files ?-quiet? ?-verbose?}
        description {Creates a Verilog or VHDL wrapper for instantiating an IP core, DSP module, or Embedded Processor sub-design into a project. The wrapper is generated in Verilog or VHDL according to the TARGET_LANGUAGE property on the project.}
        returns {Nothing.}
        example {make_wrapper -inst_template -fileset [get_filesets sources_1] \
   [get_files C:/Data/edk/xpsTest1/xpsTest1.xmp]}
        source {Xilinx UG835 2012.2}
    }
}
command manage_user_drc_rule {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -action -takes action -values {register unregister} -closed \
           -detail {Select register to enable, or unregister to disable, a user-defined DRC rule previously registered with register_drc_rule; without this option the rules are disabled by default.}
    option -abbrev -takes abbrev \
           -detail {The unique abbreviation for the user-defined rule in the violation library, matching the name given to register_drc_rule (required).}
    option -rules -takes rules \
           -detail {The list of Tcl proc names, the rules, to enable or disable for the specified abbreviation.}
    option -list_rules -takes scope -values {all enabled} -closed \
           -detail {List the rules associated with the specified abbreviation, either all rules or only those currently enabled.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-action -list_rules}

    form Default {manage_user_drc_rule ?-action action? -abbrev abbrev ?-rules rules? ?-list_rules scope? ?-quiet? ?-verbose?}

    hover {
        summary {Manage and report or list all the user defined DRC rules.}
        synopsis {manage_user_drc_rule ?-action action? -abbrev abbrev ?-rules rules? ?-list_rules scope? ?-quiet? ?-verbose?}
        description {Provides a utility to manage user-defined DRC rules created by writing a Tcl checker procedure and registering it with register_drc_rule. The command enables or disables previously registered rules for a specific DRC abbreviation, where enabled rules are checked for violations when report_drc is run, and -list_rules lists the currently registered rules available for that abbreviation. Note -list_rules and -action cannot be used together.}
        returns {Nothing.}
        example {manage_user_drc_rule -abbrev ABCD -list_rules all}
        source {Xilinx UG835 2012.2}
    }
}
command mark_objects {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -rgb -takes rgb_list \
           -detail {The color to use as an RGB code specified as a list of three values, for instance 255 255 0 for yellow.}
    option -color -takes color \
           -values {red green blue magenta yellow cyan orange} -closed \
           -detail {The color to use for marking the specified objects.}
