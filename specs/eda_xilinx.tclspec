command update_timing {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -full -detail {Perform a full timing update instead of an incremental one.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {update_timing ?-full? ?-quiet? ?-verbose?}

    hover {
        summary {Update timing for the current design.}
        synopsis {update_timing ?-full? ?-quiet? ?-verbose?}
        description {Updates the timing data to reflect any timing constraints added to the design since the timing engine was last run, updating the in-memory view of the timing database without incurring the time of a full timing analysis. Timing is updated automatically by commands that change or need timing information, such as report_timing; this command triggers the update manually. The default is an incremental analysis that updates only out-of-date information, and -full should be used only when a comprehensive review is needed.}
        returns {Nothing.}
        example {update_timing -full}
        source {Xilinx UG835 2026.1}
    }
}
command upgrade_bd_cells {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    ;# NOTE(xilinx): the Syntax line writes -latest with a value placeholder, while
    ;# the Usage table and the Arguments prose both describe it as a bare flag;
    ;# the flag reading is used here.
    option -latest \
           -detail {Upgrade the specified cells to the latest available version from the IP catalog, which is the default behavior.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {upgrade_bd_cells ?-latest? objects ?-quiet? ?-verbose?}

    hover {
        summary {Upgrade configurable IP integrator cells to a later version.}
        synopsis {upgrade_bd_cells ?-latest? objects ?-quiet? ?-verbose?}
        description {Upgrades IP integrator cells to the latest version available in the IP integrator catalog, letting an IP integrator subsystem design from an earlier release use the IP cores from the latest catalog. The cells must be specified as objects returned by get_bd_cells and cannot be referenced by name; a user-defined hierarchical module cannot be upgraded directly.}
        returns {List of IPIntegrator cell names those were upgraded, "" if failed.}
        example {upgrade_bd_cells [get_bd_cells {vidOut1 cmpy_1 newMod1}]}
        source {Xilinx UG835 2026.1}
    }
}
command upgrade_ip {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -srcset -takes source_set \
           -detail {The source file set containing the IP to upgrade, defaulting to the current source fileset.}
    option -vlnv -takes vlnv \
           -detail {The Vendor:Library:Name:Version attribute identifying the catalog IP to upgrade to, matched strictly against the IPDEF property, defaulting to the latest version of the current IP.}
    option -log -takes log_file \
           -detail {A file to which the IP upgrade report is concatenated; by default no log is written.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {upgrade_ip ?-srcset source_set? ?-vlnv vlnv? ?-log log_file? objects ?-quiet? ?-verbose?}

    hover {
        summary {Upgrade a configurable IP to a later version.}
        synopsis {upgrade_ip ?-srcset source_set? ?-vlnv vlnv? ?-log log_file? objects ?-quiet? ?-verbose?}
        description {Upgrades the specified IP cores from an older version to the latest version in the IP catalog. Only IP that explicitly supports upgrading can be upgraded, as indicated by the UPGRADE_VERSIONS property on the ipdef object. The command also accepts block design cell IP instances as bd_cell objects and upgrades them within the block design without requiring the diagram to be open.}
        returns {A return code indicating success or failure.}
        example {upgrade_ip [get_ips]}
        source {Xilinx UG835 2026.1}
    }
}
command upgrade_project {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -migrate_output_products \
           -detail {Migrate the output products directory structure to the latest Vivado structure.}
    option -log -takes log_file \
           -detail {A file to which the project upgrade report is concatenated; by default no log is written.}
    option -migrate_to_inline_hdl \
           -detail {Migrate the utility IP in all user block designs to inline HDL.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {upgrade_project ?-migrate_output_products? ?-log log_file? ?-migrate_to_inline_hdl? ?-quiet? ?-verbose?}

    hover {
        summary {Upgrade a project from a previous release to use the latest Vivado features.}
        synopsis {upgrade_project ?-migrate_output_products? ?-log log_file? ?-migrate_to_inline_hdl? ?-quiet? ?-verbose?}
        description {Upgrades a project created in a previous release so that it uses the latest Vivado features, optionally migrating the output products directory structure and converting the utility IP in user block designs to inline HDL.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command upload_hw_ila_data {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {upload_hw_ila_data ?hw_ilas? ?-quiet? ?-verbose?}

    hover {
        summary {Stop capturing and upload any captured hardware ILA data.}
        synopsis {upload_hw_ila_data ?hw_ilas? ?-quiet? ?-verbose?}
        description {Uploads the captured data from the memory buffers of the specified ILA debug cores on the hardware device and moves it into a hw_ila_data object in the Vivado logic analyzer, named after the hw_ila core it came from. Each hw_ila object has only one matching hw_ila_data object, which is overwritten each time this command runs for that core. The hw_ila objects can be given as objects returned by get_hw_ilas or current_hw_ila, or by name; without them the current_hw_ila is used.}
        returns {Hardware ILA data objects.}
        example {run_hw_ila -trigger_now [current_hw_ila]
wait_on_hw_ila [current_hw_ila]
upload_hw_ila_data [current_hw_ila]}
        source {Xilinx UG835 2026.1}
    }
}
command validate_bd_design {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -force -detail {Force re-run of validation on the block design.}
    option -design -takes design_name \
           -detail {The IP integrator subsystem design to validate; without it the current design is validated.}
    option -include_pfm \
           -detail {Also validate the DSA and PFM attributes on a block design created as the hardware portion of a Vitis platform.}
    option -steps -takes steps -values {addressing noc-drc noc-compile} -closed \
           -detail {The list of steps to execute, which does not put the design in a validated state.}
    option -assign_dfx_addressing \
           -detail {Assign addressing for variants of DFX block design containers.}
    option -limit -takes iteration_limit \
           -detail {Iteration limit for parameter propagation, defaulting to the value of bd.propagate.maxIteration.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {validate_bd_design ?-force? ?-design design_name? ?-include_pfm? ?-steps steps? ?-assign_dfx_addressing? ?-limit iteration_limit? ?-quiet? ?-verbose?}

    hover {
        summary {Run parameter propagation for a design or for a specific cell.}
        synopsis {validate_bd_design ?-force? ?-design design_name? ?-include_pfm? ?-steps steps? ?-assign_dfx_addressing? ?-limit iteration_limit? ?-quiet? ?-verbose?}
        description {Validates an IP integrator subsystem design, or an IP cell or hierarchical module, by running parameter propagation over it. Errors are returned if the platform properties are not properly defined when -include_pfm is used.}
        returns {TCL_OK, TCL_ERROR if failed.}
        example {validate_bd_design -force}
        source {Xilinx UG835 2026.1}
    }
}
command validate_board_files {
