    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_hw_axis ?-of_objects hw_devices? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}

    hover {
        summary {Get a list of hardware AXI objects.}
        synopsis {get_hw_axis ?-of_objects hw_devices? ?-regexp? ?-nocase? ?-filter expression? ?-quiet? ?-verbose? ?patterns?}
        description {Returns the JTAG to AXI Master core objects, or hw_axi objects, defined on the current hardware device. The core supports all memory-mapped AXI interfaces except AXI4-Stream and supports the AXI-Lite protocol, with the interface and data bus width customizable as properties of the core. The related instances of the debug cores in the design netlist can be found with get_debug_cores; this command returns a list of hw_axi objects on the hw_device, or returns an error if it fails.}
        returns {Hw_axi.}
        example {get_hw_axis -of_objects [current_hw_device]}
        source {Xilinx UG835 2026.1}
    }
}
