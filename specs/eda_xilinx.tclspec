command get_msg_config {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -id -takes message_id \
           -detail {The message ID to match, such as Common 17-54; used with -limit or -count.}
    option -severity -takes severity \
           -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} -closed \
           -detail {The message severity to match; used with -limit or -count.}
    option -rules \
           -detail {Show a table of all message control rules currently in effect for the project, as defined by set_msg_config.}
    option -limit \
           -detail {Show the limit for the number of messages matching either -id or -severity that will be displayed.}
    option -count \
           -detail {Show the number of messages matching either -id or -severity that have been displayed.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_msg_config ?-id message_id? ?-severity severity? ?-rules? ?-limit? ?-count? ?-quiet? ?-verbose?}

    hover {
        summary {Return the current message count, limit, or message configuration rules.}
        synopsis {get_msg_config ?-id message_id? ?-severity severity? ?-rules? ?-limit? ?-count? ?-quiet? ?-verbose?}
        description {Returns the current message limit or count applied to a message ID or severity, or all message configuration rules defined in the current project by set_msg_config. Only the limit, the count, or the rules can be returned by a single command, and an error is returned if more than one action is attempted; the count covers only the original CPU process from which Vivado was launched, not sub-processes such as those used by launch_runs.}
        returns {The current message count, limit, or the message configuration rules previously defined by the set_msg_config command.}
        example {get_msg_config -id "Common 17-81" -count}
        source {Xilinx UG835 2026.1}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command get_msg_count {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the five severities are spelled out in the Arguments prose,
    ;# but the Usage table also documents ALL as the default value, so the value
    ;# set is left open.
    option -severity -takes severity -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} \
           -detail {Message severity to query, defaulting to ALL (not valid with -id).}
    option -id -takes message_id \
           -detail {Unique message id to be queried, for example Common-99 (not valid with -severity).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-severity -id}

    form Default {get_msg_count ?-severity severity? ?-id message_id? ?-quiet? ?-verbose?}

    hover {
        summary {Get message count.}
        synopsis {get_msg_count ?-severity severity? ?-id message_id? ?-quiet? ?-verbose?}
        description {Gets the number of messages, of a specific severity or message ID, that have been returned by the tool since it was invoked. By default the count for all messages is returned; the current message limit can be checked with get_msg_limit and changed with set_msg_limit.}
        returns {Message count.}
        example {get_msg_count -id "Netlist 29-28"}
        source {Xilinx UG835 2012.2}
    }
}
;# NOTE(xilinx): absent from UG835 2026.1 — kept for older scripts; last
;# documented in the release its source row cites.
command get_msg_limit {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): as for get_msg_count, ALL is documented as the default
    ;# value alongside the five named severities, so the set is left open.
    option -severity -takes severity -values {ERROR {CRITICAL WARNING} WARNING INFO STATUS} \
           -detail {Message severity to query, defaulting to ALL (not valid with -id).}
    option -id -takes message_id \
           -detail {Unique message id to be queried, for example Common-99 (not valid with -severity).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-severity -id}

    form Default {get_msg_limit ?-severity severity? ?-id message_id? ?-quiet? ?-verbose?}

    hover {
        summary {Get message limit.}
        synopsis {get_msg_limit ?-severity severity? ?-id message_id? ?-quiet? ?-verbose?}
        description {Gets the number of messages that will be reported by the tool while invoked; when the limit is reached the tool stops reporting messages. The default value is 4,294,967,295 and can be changed with the set_msg_limit command.}
        returns {Message limit.}
        example {get_msg_limit -severity {CRITICAL WARNING}}
        source {Xilinx UG835 2012.2}
    }
}
command get_net_delays {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -of_objects -takes nets \
           -detail {Get the net delays of the specified net objects (required).}
    option -regexp -detail {Patterns are full regular expressions.}
    option -nocase -detail {Perform case-insensitive matching (only with -regexp).}
    option -patterns -takes patterns \
           -detail {Match the net_delay objects against these patterns; the default is the wildcard *.}
    option -filter -takes expression -detail {Filter the result list with the given expression.}
    option -to -takes endpoints \
           -detail {Get the delay of the net to the given terminals or ports; pin, port, and pip objects can be specified as endpoints.}
    option -interconnect_only \
           -detail {Include only interconnect delays; the default is to also include the intra-site delay.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_net_delays -of_objects nets ?-regexp? ?-nocase? ?-patterns patterns? ?-filter expression? ?-to endpoints? ?-interconnect_only? ?-quiet? ?-verbose?}

    hover {
        summary {Get the routed or estimated delays in picoseconds on a net from the driver to each load pin.}
        synopsis {get_net_delays -of_objects nets ?-regexp? ?-nocase? ?-patterns patterns? ?-filter expression? ?-to endpoints? ?-interconnect_only? ?-quiet? ?-verbose?}
        description {Gets delay objects for the specified nets, from the driver to each load pin or to specified load pins. The delay object carries the maximum and minimum delays for the fast and slow process corners as properties, specified in picoseconds rather than the nanoseconds most Vivado commands use; values are actual delays for routed interconnect and estimates for unrouted nets.}
        returns {A list of net_delay objects.}
        example {report_property -all [lindex [get_net_delays -interconnect_only \
-of_objects [get_nets control_reg[*]]] 16 ]}
        source {Xilinx UG835 2026.1}
    }
}
