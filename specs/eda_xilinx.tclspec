           -detail {Maximum number of netlist objects to trace through before reaching the endpoint; the default is 10.}
    option -min_depth -takes depth \
           -detail {Minimum number of netlist objects to trace through before reaching the endpoint; the default is 1.}
    option -min_width -takes width \
           -detail {Minimum width of any bus net returned; the default is 1.}
    option -from -takes cells \
           -detail {Startpoint cell or list of cells the returned path starts from; accepts cell objects only.}
    option -to -takes cells \
           -detail {Endpoint cell or list of cells the returned path ends at; accepts cell objects only.}
    option -through -takes cells \
           -detail {Midpoint cell or list of cells to trace paths through; accepts cell objects only.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {get_dataflow_paths ?-filter expression? ?-max_paths count? ?-max_depth depth? ?-min_depth depth? ?-min_width width? ?-from cells? ?-to cells? ?-through cells? ?-quiet? ?-verbose?}

    hover {
        summary {Get a list of dataflow paths.}
        synopsis {get_dataflow_paths ?-filter expression? ?-max_paths count? ?-max_depth depth? ?-min_depth depth? ?-min_width width? ?-from cells? ?-to cells? ?-through cells? ?-quiet? ?-verbose?}
        description {Returns a list of dataflow path objects, useful for generating a group of paths to analyze within the Dataflow Design view. A dataflow design is an optimized netlist with low level objects trimmed out that focuses on sparse netlist objects and wide buses, and a dataflow path object is a path extracted from it. The command works when a dataflow design is open and the Dataflow view is selected, iterating through dataflow primitives such as memories, DSP, and other IP blocks until -max_depth is reached.}
        returns {List of dataflow paths.}
        example {show_objects -name dfv_1 [get_dataflow_paths]}
        source {Xilinx UG835 2026.1}
    }
}
