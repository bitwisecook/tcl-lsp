command report_disable_timing {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -file -takes file \
           -detail {Write the report into the specified file, overwriting it unless -append is also specified.}
    option -append \
           -detail {Append the report to the specified file rather than overwriting it (only with -file).}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {report_disable_timing ?-file file? ?-append? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Report disabled timing arcs.}
        synopsis {report_disable_timing ?-file file? ?-append? ?-return_string? ?-quiet? ?-verbose?}
        description {Displays a report of the timing paths that will be excluded from timing analysis in the current synthesized or implemented design, organized into columns for the cell or port associated with the path, the From and To ends of the path, the condition, and the reason for the exclusion. The reasons are constraint (a set_disable_timing constraint is specified), constant (logic constant), loop (breaks a logic loop), bidirect instance path, and bidirect net path.}
        returns {Nothing.}
        example {report_disable_timing}
        source {Xilinx UG835 2012.2}
    }
}
