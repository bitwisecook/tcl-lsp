        summary {Remove cells from the current design.}
        synopsis {remove_cell ?-quiet? ?-verbose? cells}
        description {Removes cells from the current netlist in an open synthesized or implemented design; cells cannot be removed from library macros. Netlist editing changes only the in-memory view of the netlist, not the source fileset or the design on disk, and is not allowed on the elaborated RTL design; save the result with write_checkpoint or export it with the appropriate write command.}
        example {remove_cell fftEngine}
        source {Xilinx UG835 2026.1}
    }
}
command remove_cells_from_pblock {
    available {tcl 8.5}
    required_package vivado

    arity 2..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {remove_cells_from_pblock ?-quiet? ?-verbose? pblock cells}

    hover {
        summary {Remove cells from a Pblock.}
        synopsis {remove_cells_from_pblock ?-quiet? ?-verbose? pblock cells}
        description {Removes the specified logic instances from the named Pblock, which they were added to with add_cells_to_pblock. Cells that have been placed are not unplaced as they are removed, and any current LOC assignments are left intact.}
        example {remove_cells_from_pblock pb_cpuEngine [get_cells cpuEngine/cpu_dwb_dat_o/*]}
        source {Xilinx UG835 2026.1}
    }
}
command remove_cluster_configurations {
