    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_impact ?-run run? ?-ipf ipf? ?-quiet? ?-verbose?}

    hover {
        summary {Launch iMPACT configuration tool for a run.}
        synopsis {launch_impact ?-run run? ?-ipf ipf? ?-quiet? ?-verbose?}
        description {Launches iMPACT to configure the device and generate programming files, and to read back and verify design configuration data, debug configuration problems, or execute XSVF files. The bitstream file must be generated with write_bitstream before using iMPACT; the command returns the list of files read.}
        returns {Nothing.}
