command launch_chipscope_analyzer {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -run -takes run \
           -detail {Implemented run to launch ChipScope Analyzer with; the run must have a bitstream file generated.}
    option -csproject -takes csproject \
           -detail {The ChipScope project to open, defaulting to csdefaultproj.cpj.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {launch_chipscope_analyzer ?-run run? ?-csproject csproject? ?-quiet? ?-verbose?}

    hover {
        summary {Launch ChipScope Analyzer tool for a run.}
        synopsis {launch_chipscope_analyzer ?-run run? ?-csproject csproject? ?-quiet? ?-verbose?}
        description {Launches the ChipScope Pro Analyzer tool for the active run or a specified implemented design run. A netlist design is set up for ChipScope before implementation with create_debug_core, create_debug_port, and connect_debug_port, and the implemented design must have a bitstream file generated by BitGen or an error is returned.}
        returns {Nothing.}
        example {launch_chipscope_analyzer -run impl_3 -csproject impl_3_cs_project}
        source {Xilinx UG835 2012.2}
    }
}
command launch_impact {
    dialects tcl8.5
    required_package vivado

    arity 0..

    option -run -takes run \
