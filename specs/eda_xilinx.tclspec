        summary {Write hardware VIO probe OUTPUT_VALUE properties to the VIO cores.}
        synopsis {commit_hw_vio ?-quiet? ?-verbose? hw_objects}
        description {Drives the current OUTPUT_VALUE properties of VIO debug core probes onto the signals of the hardware device. The VIO core follows a set and commit model, where set_property assigns OUTPUT_VALUE on the output probes and this command writes them to the device. Either individual hw_probe objects or a whole hw_vio object may be given, obtained from get_hw_probes or get_hw_vios rather than named.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command compile_c {
    available {tcl 8.5}
    required_package vivado

    arity 1..

    option -force -detail {Force regeneration of the RTL in the HLS-based IP.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {compile_c ?-force? ?-quiet? ?-verbose? objects}

    hover {
        summary {Compile the C sources of an IP core into RTL.}
        synopsis {compile_c ?-force? ?-quiet? ?-verbose? objects}
        description {Detects the C, C++, and SystemC files of IP cores imported from Vivado HLS and converts them to RTL for synthesis, importing the resulting sources back into the design. HLS-based IP cores deliver only the C source, so this conversion runs when such IP is synthesized either out of context or with the top-level design. The tool calls this command automatically when it encounters IP with HLS C code, so it does not normally need to be called by hand.}
        returns {Nothing.}
        example {compile_c [get_ips instance_name]}
        source {Xilinx UG835 2026.1}
    }
}
command compile_simlib {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -directory -takes directory \
           -detail {The directory path for saving the compiled results; by default the libraries are saved in the current working directory in non-project mode and under the project cache in project mode.}
    option -family -takes family \
           -values {all kintex7 virtex7 artix7 spartan7 zynq spartanuplus kintexu kintexuplus \
                    virtexu virtexuplus artixuplus zynquplus zynquplusrfsoc versal} -closed \
           -detail {Compile the simulation libraries for the specified device family; without it the libraries for all families are compiled.}
    option -force -detail {Overwrite the current pre-compiled libraries.}
    option -language -takes language -values {verilog vhdl all} -closed \
           -detail {Compile the base simulation libraries for this language, needed only with -no_ip_compile; without it the language follows the simulator named by -simulator, and both languages are compiled for multi-language simulators.}
    option -library -takes library -values {all unisim simprim} -closed \
           -detail {The simulation library to compile, defaulting to all; repeat the option to name several libraries (repeatable).}
    option -print_library_info -takes library_info \
           -detail {Print the library information for the compiled simulation library.}
    option -simulator -takes simulator \
           -values {modelsim questa xcelium vcs riviera activehdl} -closed \
           -detail {Compile the simulation libraries for the specified simulator (required).}
    option -simulator_exec_path -takes directory \
           -detail {The directory holding the third-party compiler and simulator executables, required when the simulator is not on the search path or when that path is to be overridden.}
    option -gcc_exec_path -takes directory \
           -detail {The directory holding the third-party simulator GCC executables; without it the path comes from GCC_SIM_EXE_PATH, then from the simulator installation, then from the search path.}
    option -source_library_path -takes directory \
           -detail {A directory searched for the library source files before the default paths named by the installation environment variables; not to be used unless technical support says so.}
    option -no_ip_compile \
           -detail {Disable compilation of the static simulation files for the IP of the design and of any added user or third-party repositories, which are compiled by default.}
    option -no_systemc_compile \
           -detail {Disable compilation of the SystemC, C++ and C based IP models used for system simulation.}
    option -skip_libraries -takes libraries \
           -detail {A list of libraries whose compilation is to be skipped.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {compile_simlib ?-directory directory? ?-family family? ?-force? ?-language language? ?-library library...? ?-print_library_info library_info? -simulator simulator ?-simulator_exec_path directory? ?-gcc_exec_path directory? ?-source_library_path directory? ?-no_ip_compile? ?-no_systemc_compile? ?-skip_libraries libraries? ?-quiet? ?-verbose?}

    hover {
        summary {Compile the simulation libraries for a third-party simulator.}
        synopsis {compile_simlib ?-directory directory? ?-family family? ?-force? ?-language language? ?-library library...? ?-print_library_info library_info? -simulator simulator ?-simulator_exec_path directory? ?-gcc_exec_path directory? ?-source_library_path directory? ?-no_ip_compile? ?-no_systemc_compile? ?-skip_libraries libraries? ?-quiet? ?-verbose?}
        description {Compiles the behavioral and timing simulation models shipped with the tool for use by a third-party simulator before the design is simulated. The libraries generally have to be recompiled with each new software release, and whenever a new third-party simulator or tool update is installed. When run from an open project the device family, target language and library settings of the project supply the defaults; the compilation directives themselves are edited with config_compile_simlib.}
        returns {Information related to the compiled libraries.}
        example {compile_simlib -simulator modelsim -family virtex7 -library unisim \
   -library simprim -language vhdl}
        source {Xilinx UG835 2026.1}
    }
}
command config_compile_simlib {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -cfgopt -takes config_string \
           -detail {The configuration options for one simulator, language and library combination, given as a braced string of the form simulator.language.library followed by the options (repeatable).}
    option -cfgval -takes config_key \
           -detail {Get the configuration value of the option named by a braced string of the form simulator.language.library.}
    option -simulator -takes simulator \
           -detail {Return only the configuration options associated with the specified simulator.}
    option -reset -detail {Restore all configuration settings to the factory default value.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_compile_simlib ?-cfgopt config_string...? ?-cfgval config_key? ?-simulator simulator? ?-reset? ?-quiet? ?-verbose?}

    hover {
        summary {Configure the settings used by compile_simlib.}
        synopsis {config_compile_simlib ?-cfgopt config_string...? ?-cfgval config_key? ?-simulator simulator? ?-reset? ?-quiet? ?-verbose?}
        description {Changes the pre-defined compilation options that compile_simlib passes to a third-party simulator for a particular simulator, language and library combination. Valid simulators are modelsim, questa, xcelium, vcs, riviera and activehdl; valid languages are verilog, vhdl, g++, gcc, or a named compiler; valid libraries include axi_bfm, ieee, simprim, xpm, xilinx_vip, std, synopsys, unisim, secureip, vl, global, or a named IP.}
        returns {The current configuration options, when the command is run with no arguments.}
        example {config_compile_simlib -simulator questa}
        source {Xilinx UG835 2026.1}
    }
}
command config_design_analysis {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -max_common_paths -takes count \
           -detail {The number of setup timing paths to consider when examining the distribution of common paths across phases of implementation, given as an integer below 20000; the default is 1000.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_design_analysis ?-max_common_paths count? ?-quiet? ?-verbose?}

    hover {
        summary {Configure general features of design analysis.}
        synopsis {config_design_analysis ?-max_common_paths count? ?-quiet? ?-verbose?}
        description {Configures features of the report_design_analysis command, whose report analyzes timing paths at the synthesis, optimization, placement and routing stages of the flow. The -max_common_paths option sets how many setup timing paths are captured at each stage.}
        returns {Nothing.}
        source {Xilinx UG835 2026.1}
    }
}
command config_flows {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    ;# NOTE(xilinx): the Syntax line shows -disable_imux_register_optimization
    ;# unbracketed, but the section gives it no Arguments prose marking it
    ;# (Required); the conservative reading is taken here.
    option -mark_debug -takes mode -values {enable disable synthesis_only} -closed \
           -detail {Whether nets carrying MARK_DEBUG, from HDL attributes or XDC constraints, may be optimized: enable preserves them and is the default, disable lets synthesis and implementation optimize them freely, and synthesis_only preserves them through synthesis only.}
    option -disable_imux_register_optimization -takes value \
           -detail {Instruct implementation to skip optimizations that use imux registers.}
    option -impl_strategy -takes strategy \
           -values {{Vivado Advanced Implementation Defaults} {Vivado Implementation Defaults} \
                    Performance_Auto_1 Performance_Auto_2 Performance_Auto_3 Performance_Explore \
                    Performance_AggressiveExplore Performance_ExplorePostRoutePhysOpt \
                    Performance_ExploreWithRemap Performance_WLBlockPlacement \
                    Performance_WLBlockPlacementFanoutOpt Performance_EarlyBlockPlacement \
                    Performance_NetDelay_high Performance_NetDelay_medium Performance_NetDelay_low \
                    Performance_Retiming Performance_ExtraTimingOpt Performance_RefinePlacement \
                    Performance_SpreadSLLs Performance_BalanceSLLs Performance_BalanceSLRs \
                    Performance_HighUtilSLRs Congestion_SpreadLogic_high \
                    Congestion_SpreadLogic_medium Congestion_SpreadLogic_low \
                    Congestion_SSI_SpreadLogic_high Congestion_SSI_SpreadLogic_medium \
                    Congestion_SSI_SpreadLogic_low Area_Explore Area_ExploreSequential \
                    Area_ExploreWithRemap Power_DefaultOpt Power_ExploreArea Flow_RunPhysOpt \
                    Flow_RunPostRoutePhysOpt Flow_RuntimeOptimized Flow_Quick} -closed \
           -detail {Set the implementation strategy for non-project flows, which configures the options passed to each implementation step; only one strategy may be given, and explicit options on opt_design, place_design, phys_opt_design or route_design override it.}
    option -synth_strategy -takes strategy \
           -values {{Vivado Synthesis Defaults} Flow_AreaOptimized_high Flow_AreaOptimized_medium \
                    Flow_AreaMultThresholdDSP Flow_AlternateRoutability Flow_PerfOptimized_high \
                    Flow_PerfThresholdCarry Flow_RuntimeOptimized} -closed \
           -detail {Set the synthesis strategy for non-project flows, which configures the options passed to synth_design; only one strategy may be given, and explicit options on synth_design override it.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {config_flows ?-mark_debug mode? ?-disable_imux_register_optimization value? ?-impl_strategy strategy? ?-synth_strategy strategy? ?-quiet? ?-verbose?}

    hover {
        summary {Configure the Vivado core design flow.}
        synopsis {config_flows ?-mark_debug mode? ?-disable_imux_register_optimization value? ?-impl_strategy strategy? ?-synth_strategy strategy? ?-quiet? ?-verbose?}
        description {Configures tool behavior across the stages of the core design flow from IP integrator to bitstream generation, affecting synthesis, constraints and hardware debug; report_config_flows reports the current configuration. The -mark_debug setting must be applied before design runs are opened or launched. The -synth_strategy and -impl_strategy settings are session specific and are not saved in design checkpoints, so they must be reapplied in a new session before any flow command is run.}
        returns {Nothing.}
        example {config_flows -synth_strategy Flow_PerfOptimized_high}
        source {Xilinx UG835 2026.1}
    }
}
