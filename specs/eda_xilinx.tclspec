command report_incremental_reuse {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -file -takes file_name \
           -detail {Write the report into the specified file, overwriting an existing file unless -append is also used; by default the report goes to the Tcl console.}
    option -append \
           -detail {Append the output of the command to the specified file rather than overwriting it, and can only be used with -file.}
    option -cells -takes cells \
           -detail {The cells to use from the design checkpoint file.}
    option -hierarchical \
           -detail {Generate a text-based hierarchical incremental reuse report.}
    option -hierarchical_depth -takes depth \
           -detail {The depth level for the text-based hierarchical incremental reuse report, defaulting to 0.}
    option -return_string \
           -detail {Direct the output to a Tcl string rather than to the standard output.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-file -return_string}

    form Default {report_incremental_reuse ?-file file_name? ?-append? ?-cells cells? ?-hierarchical? ?-hierarchical_depth depth? ?-return_string? ?-quiet? ?-verbose?}

    hover {
        summary {Compute achievable incremental reuse for the given design checkpoint and report.}
        synopsis {report_incremental_reuse ?-file file_name? ?-append? ?-cells cells? ?-hierarchical? ?-hierarchical_depth depth? ?-return_string? ?-quiet? ?-verbose?}
        description {For the incremental implementation flow, reports the amount of design overlap between the current design and an incremental checkpoint loaded with read_checkpoint -incremental, so that it can be judged whether the two are sufficiently correlated to drive incremental placement and routing. A low correlation discourages using the checkpoint, in which case the original design can be restored with open_run or read_checkpoint, or a different incremental checkpoint loaded. For Dynamic Function eXchange designs the percentages of cells matching, reused, and fixed in reconfigurable modules are reported along with a Reconfigurable Modules Summary table.}
        returns {The incremental reuse report.}
        example {read_checkpoint -incremental C:/Data/reuse_checkpoint1.dcp
report_incremental_reuse}
        source {Xilinx UG835 2026.1}
    }
}
