command generate_black_key {
    available {tcl 8.5}
    required_package vivado

    arity 0..

    option -input_json -takes file_name \
           -detail {Input JSON file path containing the key and IV for PUF registration.}
    option -output_json -takes file_name \
           -detail {Output JSON file path to store the generated black key and PUF data.}
    option -force -detail {Overwrite the output file if it exists.}
    option -pufhd_file -takes file_name \
           -detail {Output text file to store the PUF HD (helper data) string.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Enable verbose debug output during black key generation.}

    form Default {generate_black_key ?-input_json file_name? ?-output_json file_name? ?-force? ?-pufhd_file file_name? ?-quiet? ?-verbose? ?hw_devices?}

    hover {
        summary {Perform PUF registration on a Spartan UltraScale+ device and write the result to a JSON file.}
        synopsis {generate_black_key ?-input_json file_name? ?-output_json file_name? ?-force? ?-pufhd_file file_name? ?-quiet? ?-verbose? ?hw_devices?}
        description {Performs PUF registration on a Spartan UltraScale+ device and writes the result to a JSON file. The output JSON contains the AES-encrypted black key, the red key encrypted using the internal PUF KEK and the user-supplied IV, along with PUF helper data (pufhd), PUF hash, and related fields; the output fields are black_key, iv, key, pufhd, pufhash, pufaux, pufchash and pufid. The PUF KEK is an internal device secret and is never exported from the device. This command replaces the deprecated generate_puf_kek command. The device list defaults to the current hardware device.}
        returns {Hardware devices.}
        source {Xilinx UG835 2026.1}
    }
}
