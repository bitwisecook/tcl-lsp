command write_chipscope_cdc {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_chipscope_cdc file ?-quiet? ?-verbose?}

    hover {
        summary {Export nets that are connected to debug ports.}
        synopsis {write_chipscope_cdc file ?-quiet? ?-verbose?}
        description {Writes a ChipScope Definition and Connection (CDC) file containing the debug cores, ports, and signals defined in the current project, as added by create_debug_core. The CDC file stores information about source files, destination files, core parameters, and core settings for the ChipScope Pro Analyzer, and can be read back into other projects with read_chipscope_cdc. If the path is not specified as part of the file name, the file is written into the current working directory.}
        returns {Name of the output file.}
        example {write_chipscope_cdc bft.cdc}
        source {Xilinx UG835 2012.2}
    }
}
command write_csv {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -force -detail {Overwrite the existing file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_csv ?-force? file ?-quiet? ?-verbose?}

    hover {
        summary {Export package pin and port placement information.}
        synopsis {write_csv ?-force? file ?-quiet? ?-verbose?}
        description {Writes package pin and port placement information into a comma separated value (CSV) file, in the format described by the PlanAhead User Guide. If the path is not specified as part of the file name, the file is written into the current working directory.}
        returns {Name of the output file.}
        example {write_csv C:/Data/pinList.csv}
        source {Xilinx UG835 2012.2}
    }
}
command write_debug_probes {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -force -detail {Overwrite the existing file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_debug_probes ?-force? file ?-quiet? ?-verbose?}

    hover {
        summary {Write debug probes to a file.}
        synopsis {write_debug_probes ?-force? file ?-quiet? ?-verbose?}
        description {Writes the debug probes of the current design to the named file, whose default extension is .ltx.}
        returns {Name of the output file.}
        source {Xilinx UG835 2012.2}
    }
}
command write_edif {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -pblocks -takes pblocks \
           -detail {Export the netlist for these pblocks, writing each pblock to a separate file, not valid with -cell.}
    option -cell -takes cell \
           -detail {Export the netlist for this cell, not valid with -pblocks.}
    option -force -detail {Overwrite the existing file.}
    option -security_mode -takes security_mode -values {multifile all} -closed \
           -detail {With all, a design needing encryption is written whole to a single encrypted file, where multifile, the default, writes the secured module to a separate encrypted file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    option_conflict {-pblocks -cell}

    form Default {write_edif ?-pblocks pblocks? ?-cell cell? ?-force? ?-security_mode security_mode? file ?-quiet? ?-verbose?}

    hover {
        summary {Export the current netlist as an EDIF file.}
        synopsis {write_edif ?-pblocks pblocks? ?-cell cell? ?-force? ?-security_mode security_mode? file ?-quiet? ?-verbose?}
        description {Writes the current netlist as an EDIF file, or outputs the contents of specific pblocks or hierarchical cells as EDIF netlist files. When -pblocks or -cell is used, the file argument names a directory in which one EDIF file per pblock or cell is written, named after that pblock or cell, and the tool returns an error if the directory does not exist. The default file extension for an EDIF netlist is .edn.}
        returns {The name of the output file or directory.}
        example {write_edif C:/Data/edifOut.edn}
        source {Xilinx UG835 2012.2}
    }
}
command write_hw_ila_data {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -force -detail {Overwrite the existing file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the Syntax line repeats the optional hw_ila_data word twice,
    ;# a conversion artifact; the Usage table lists one optional data object.
    form Default {write_hw_ila_data ?-force? file ?hw_ila_data? ?-quiet? ?-verbose?}

    hover {
        summary {Write hw_ila_data to a file.}
        synopsis {write_hw_ila_data ?-force? file ?hw_ila_data? ?-quiet? ?-verbose?}
        description {Writes the named hw_ila_data data object, defaulting to the current hw_ila_data, to the named file.}
        returns {Name of the output file.}
        source {Xilinx UG835 2012.2}
    }
}
command write_ibis {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -force -detail {Overwrite the existing .ibs file.}
    option -allmodels \
           -detail {Include all available buffer models for this architecture, where by default only the buffer models used by the floorplan are included.}
    option -nopin \
           -detail {Disable per-pin modeling of the path from the die pad to the package pin, writing a single RLC transmission line model for all pins instead.}
    option -truncate -takes truncate -values {20 40 0} -closed \
           -detail {The maximum length for a signal name in the output file, where 0 is unlimited and the default of 40 follows the IBIS version 4.2 specification.}
    option -ibs -takes ibs \
           -detail {An updated generic IBIS models file overriding the models found in the tool installation, required for parts that have no generic models there.}
    option -pkg -takes pkg \
           -detail {An updated per pin parasitic package data file overriding the file found in the tool installation, required for parts that have no generic models there.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_ibis ?-force? ?-allmodels? ?-nopin? ?-truncate truncate? ?-ibs ibs? ?-pkg pkg? file ?-quiet? ?-verbose?}

    hover {
        summary {Write IBIS models for the current floorplan.}
        synopsis {write_ibis ?-force? ?-allmodels? ?-nopin? ?-truncate truncate? ?-ibs ibs? ?-pkg pkg? file ?-quiet? ?-verbose?}
        description {Writes the IBIS models for the target device in the current design, combining the netlist and implementation details of the design with the per-pin parasitic package information to create a custom IBIS model. An RTL, Netlist, or Implemented Design must be open when running this command.}
        returns {Name of the output file.}
        example {write_ibis -allmodels -truncate 0 C:/Data/FPGA_Design/ibisOut.txt}
        source {Xilinx UG835 2012.2}
    }
}
command write_ncd {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -force -detail {Overwrite the existing file.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_ncd ?-force? file ?-quiet? ?-verbose?}

    hover {
        summary {Export the placement to an NCD file.}
        synopsis {write_ncd ?-force? file ?-quiet? ?-verbose?}
        description {Exports a Xilinx Native Circuit Description (NCD) file from an implemented design. The NCD file is created by MAP and PAR during implementation, and converts the logical netlist design into a physical design implementing the targeted Xilinx device architecture.}
        returns {Name of the output file.}
        example {write_ncd C:/Data/FPGA_Design/designOut.ncd}
        source {Xilinx UG835 2012.2}
    }
}
command write_sdf {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -process_corner -takes process_corner -values {slow fast} -closed \
           -detail {The process corner to write delays for, where delays are greater in the slow corner, which is the default, than in the fast corner.}
    option -cell -takes cell \
           -detail {The root of the design hierarchy to write, defaulting to the whole design.}
    option -rename_top -takes rename_top \
           -detail {Replace the name of the top module in the output with this custom name.}
    option -force -detail {Overwrite the existing SDF file.}
    option -mode -takes mode -values {timesim sta} -closed \
           -detail {Write the SDF file for timing simulation (timesim, the default) or for static timing analysis (sta).}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_sdf ?-process_corner process_corner? ?-cell cell? ?-rename_top rename_top? ?-force? ?-mode mode? file ?-quiet? ?-verbose?}

    hover {
        summary {Generate flat SDF delay files for event simulation.}
        synopsis {write_sdf ?-process_corner process_corner? ?-cell cell? ?-rename_top rename_top? ?-force? ?-mode mode? file ?-quiet? ?-verbose?}
        description {Writes the timing delays for cells in the design to a Standard Delay Format (SDF) file. The output SDF file is referenced from a Verilog netlist through the -sdf_anno and -sdf_file arguments of the write_verilog command, for static timing analysis and timing simulation.}
        returns {Nothing.}
        example {write_sdf C:/Data/FPGA_Design/designOut.sdf}
        source {Xilinx UG835 2012.2}
    }
}
command write_verilog {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -cell -takes cell \
           -detail {The root of the design hierarchy to write, defaulting to the whole design.}
    option -mode -takes mode -values {design port sta funcsim timesim} -closed \
           -detail {The mode to use when writing the Verilog file, defaulting to design.}
    option -lib -detail {Write each library into a separate file.}
    option -port_diff_buffers \
           -detail {Output differential buffers and their internal wires in the ports list, valid only with -mode port.}
    ;# NOTE(xilinx): the Syntax line and Usage table spell -write_all_overrides as
    ;# a flag while the Arguments prose describes a true or false value; the flag
    ;# spelling of the Syntax line is used here.
    option -write_all_overrides \
           -detail {Write parameter overrides on Xilinx primitives even if the override value is the same as the default value.}
    option -rename_top -takes rename_top \
           -detail {Replace the top module name in the output with this custom name, working only with -mode funcsim or -mode timesim.}
    option -sdf_anno -takes sdf_anno -values {true false} \
           -detail {Specify whether the sdf_annotate system task statement is generated, working only with -mode timesim and false by default.}
    option -sdf_file -takes sdf_file \
           -detail {Full path to the SDF file location, defaulting to the output file name with an .sdf extension.}
    option -force -detail {Overwrite the existing file.}
    option -include_xilinx_libs \
           -detail {Include simulation models directly in the netlist instead of linking to the library by reference.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_verilog ?-cell cell? ?-mode mode? ?-lib? ?-port_diff_buffers? ?-write_all_overrides? ?-rename_top rename_top? ?-sdf_anno sdf_anno? ?-sdf_file sdf_file? ?-force? ?-include_xilinx_libs? file ?-quiet? ?-verbose?}

    hover {
        summary {Export the current netlist in Verilog format.}
        synopsis {write_verilog ?-cell cell? ?-mode mode? ?-lib? ?-port_diff_buffers? ?-write_all_overrides? ?-rename_top rename_top? ?-sdf_anno sdf_anno? ?-sdf_file sdf_file? ?-force? ?-include_xilinx_libs? file ?-quiet? ?-verbose?}
        description {Writes a Verilog netlist of the current design, or of a specific cell of the design, to the specified file or directory. The output is an IEEE 1364-2001 compliant Verilog HDL file containing netlist information obtained from the input design files. The mode selects a complete netlist of the design or cell, a port list for the design, or a netlist for simulation or static timing analysis. A file name without a .v or .ver extension is treated as a directory, into which a file named after the top module is written.}
        returns {The name of the output file or directory.}
        example {write_verilog C:/Data/my_verilog.v}
        source {Xilinx UG835 2012.2}
    }
}
command write_vhdl {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -cell -takes cell \
           -detail {The root of the design hierarchy to write, defaulting to the whole design.}
    option -mode -takes mode -values {funcsim port} -closed \
           -detail {The output mode to use when writing the VHDL file, defaulting to funcsim.}
    option -lib -detail {Write each library into a separate file.}
    option -port_diff_buffers \
           -detail {Output differential buffers and their internal wires in the ports list, valid only with -mode port.}
    ;# NOTE(xilinx): the Syntax line and Usage table spell -write_all_overrides as
    ;# a flag while the Arguments prose describes a true or false value; the flag
    ;# spelling of the Syntax line is used here.
    option -write_all_overrides \
           -detail {Write parameter overrides on Xilinx primitives even if the override value is the same as the default value.}
    option -rename_top -takes rename_top \
           -detail {Replace the top module name in the output with this custom name, working only with -mode funcsim.}
    option -arch_only \
           -detail {Write only the architecture, suppressing the entity declaration for the top cell.}
    option -force -detail {Overwrite the existing file.}
    option -include_xilinx_libs \
           -detail {Include simulation models directly in the netlist instead of linking to the library by reference.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    form Default {write_vhdl ?-cell cell? ?-mode mode? ?-lib? ?-port_diff_buffers? ?-write_all_overrides? ?-rename_top rename_top? ?-arch_only? ?-force? ?-include_xilinx_libs? file ?-quiet? ?-verbose?}

    hover {
        summary {Export the current netlist in VHDL format.}
        synopsis {write_vhdl ?-cell cell? ?-mode mode? ?-lib? ?-port_diff_buffers? ?-write_all_overrides? ?-rename_top rename_top? ?-arch_only? ?-force? ?-include_xilinx_libs? file ?-quiet? ?-verbose?}
        description {Writes a VHDL netlist of the current design, or of a specific cell of the design, to the specified file or directory. The output is a VHDL IEEE 1076.4 VITAL-2000 compliant file containing netlist information obtained from the input design files, and can be a complete netlist of the design or cell, or only the I/O ports in the entity declaration for the top module. A file name without a .vhd or .vhdl extension is treated as a directory, into which a file named after the top module is written.}
        returns {The name of the output file or directory.}
        example {write_vhdl C:/Data/bft_top.vhd}
        source {Xilinx UG835 2012.2}
    }
}
command write_xdc {
    dialects tcl8.5
    required_package vivado

    form Default {write_xdc ?-no_fixed_only? ?-constraints type? ?-cell cell? ?-sdc? ?-no_tool_comments? ?-force? ?-exclude_timing? ?-exclude_physical? ?file_name?}

    hover {
        summary {Write the current design's constraints out to an XDC or SDC file.}
        synopsis {write_xdc ?-no_fixed_only? ?-constraints type? ?-cell cell? ?-sdc? ?-no_tool_comments? ?-force? ?-exclude_timing? ?-exclude_physical? ?file_name?}
        source {Xilinx UG835 2026.1}
    }
}
command xsim {
    dialects tcl8.5
    required_package vivado

    arity 1..

    option -gui -detail {Ignored, for compatibility with the xsim command-line tool.}
    option -log -takes log -detail {Ignored, for compatibility with the xsim command-line tool.}
    option -maxdeltaid -takes maxdeltaid \
           -detail {The maximum delta number, defaulting to 10000, above which an error is reported for exceeding the maximum simulation loops at the same time.}
    option -nolog -detail {Ignored, for compatibility with the xsim command-line tool.}
    option -onfinish -takes onfinish -values {quit stop} -closed \
           -detail {The behavior at the end of simulation, defaulting to stop.}
    option -onerror -takes onerror -values {quit stop} -closed \
           -detail {The behavior upon a simulation run-time error, defaulting to stop.}
    option -tclbatch -takes tclbatch -detail {The Tcl file for batch mode execution.}
    option -t -takes tclbatch -detail {The Tcl file for batch mode execution.}
    option -runall -detail {Run the simulation until completion, then quit, performing run -all followed by exit.}
    option -R -detail {Run the simulation until completion, then quit, performing run -all followed by exit.}
    option -testplusarg -takes testplusarg \
           -detail {Plusargs to be used by the test plusargs and value plusargs system functions.}
    option -vcdfile -takes vcdfile -detail {The VCD output file.}
    option -vcdunit -takes vcdunit \
           -detail {The VCD output unit, defaulting to the engine precision unit.}
    option -view -takes view \
           -detail {Open a wave configuration file, to be used together with -gui.}
    option -wdb -takes wdb -detail {The waveform database output file.}
    option -tp -detail {Enable printing of hierarchical names of the process being executed.}
    option -tl -detail {Enable printing of the file name and line number of statements being executed.}
    option -quiet -detail {Ignore command errors.}
    option -verbose -detail {Suspend message limits during command execution.}

    ;# NOTE(xilinx): the section's one-line description reads "Display help for one
    ;# or more topics", which belongs to the help command; the summary below is
    ;# taken from the Syntax line, the Usage table and the Simulation category.
    form Default {xsim ?-gui? ?-log log? ?-maxdeltaid maxdeltaid? ?-nolog? ?-onfinish onfinish? ?-onerror onerror? ?-tclbatch tclbatch? ?-t tclbatch? ?-runall? ?-R? ?-testplusarg testplusarg? ?-vcdfile vcdfile? ?-vcdunit vcdunit? ?-view view? ?-wdb wdb? ?-tp? ?-tl? snapshot ?-quiet? ?-verbose?}

    hover {
        summary {Simulate the named design snapshot with the Vivado integrated simulator.}
        synopsis {xsim ?-gui? ?-log log? ?-maxdeltaid maxdeltaid? ?-nolog? ?-onfinish onfinish? ?-onerror onerror? ?-tclbatch tclbatch? ?-t tclbatch? ?-runall? ?-R? ?-testplusarg testplusarg? ?-vcdfile vcdfile? ?-vcdunit vcdunit? ?-view view? ?-wdb wdb? ?-tp? ?-tl? snapshot ?-quiet? ?-verbose?}
        returns {Nothing.}
        source {Xilinx UG835 2012.2}
    }
}
}
