command dbGet {
    dialects tcl8.4
    required_package cadence-innovus

    form Default {dbGet object_spec.attribute ?-regexp pattern? ?-e?}

    hover {
        summary {Get a design database object attribute (legacy UI).}
        synopsis {dbGet object_spec.attribute ?-regexp pattern? ?-e?}
        description {"Legacy UI" here names the pre-common-UI command set, not an obsolete command: dbGet, dbQuery and dbShape are still serviced in current releases (all three appear by exact name in Cadence's Innovus 19.1 CCR fixed-bug list, alongside get_db/set_db) and remain the primary low-level object-model accessors. They coexist with the common-UI get_db/set_db rather than being superseded by them.}
        source {F5}
    }
}

