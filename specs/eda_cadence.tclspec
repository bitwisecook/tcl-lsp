command time_design {
    dialects tcl8.4
    required_package cadence-innovus

    form Default {time_design ?-pre_cts? ?-post_cts? ?-post_route? ?-hold? ?-report_prefix prefix?}

    hover {
        summary {Perform timing analysis.}
        synopsis {time_design ?-pre_cts? ?-post_cts? ?-post_route? ?-hold? ?-report_prefix prefix?}
        source {F5}
    }
}

