command write_db {
    dialects tcl8.4
    required_package cadence-common

    form Default {write_db file_name}

    hover {
        summary {Save the design to a common-UI database.}
        synopsis {write_db file_name}
        description {The common-UI database writer, paired with read_db; together they replace the legacy saveDesign / restoreDesign (saveDesign -relativePath is a confirmed legacy flag). Available across the common-UI tools (Innovus, Genus, Tempus).}
        source {Cadence release notes / RAK}
    }
}

