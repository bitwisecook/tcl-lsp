;# NOTE(eda): this bare underscored spelling is UNCONFIRMED. It appears in no
;# Cadence-authored source checked: ~350 Innovus 19.1 CCR bug titles carry the
;# legacy optDesign (-postRoute, -postCTS -hold, -drv) and the common-UI
;# place_opt_design instead, and no tutorial uses opt_design. Kept because
;# absence of evidence is not proof of non-existence; re-check against a
;# primary source (Innovus Stylus Common UI Text Command Reference).
command opt_design {
    dialects tcl8.4
    required_package cadence-innovus

    form Default {opt_design ?-post_route? ?-setup? ?-hold? ?-drv?}

    hover {
        summary {Optimize the design (post-route).}
        synopsis {opt_design ?-post_route? ?-setup? ?-hold? ?-drv?}
        source {F5}
    }
}

