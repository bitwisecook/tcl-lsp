# tcl-lsp — bundled SpecTcl loadable: the Cadence tool commands (Genus, Innovus, Xcelium, Conformal).
#
# This pack IS the source of truth for these commands. The Rust modules that
# used to hold them (rust/tcl-registry/src/commands/eda_cadence/) were deleted when
# the EDA vendor libraries migrated to bundled `.tclspec` loadables, per
# docs/design/spec-packs.md ("the EDA vendor libraries ship as bundled
# `.tclspec` loadables … so the loader path is exercised in production from day
# one rather than reserved for private packs"). Every command was proved
# field-for-field equal to its compiled spec by the SpecTcl round-trip gate
# before the modules were removed.
#
# Discovery: the **bundled** tier — `specs/` beside the server executable, or
# wherever $TCL_LSP_SPEC_PACK_DIR points (rust/tcl-spectcl/src/discovery.rs).
# Edit this file to change the specs; there is no generator to re-run.
# Syntax: docs/design/spec-dsl-examples/README.md. The initial text was written
# by the spec studio's SpecTcl renderer (rust/tcl-spec-studio/src/render_spectcl.rs)
# from the registry modules, which reported no unwritable field on any command
# here; this file is hand-maintained from now on.

speclib eda_cadence 1.1 {

command add_endcap {
    dialects tcl8.4
    required_package cadence-innovus

    form Default {add_endcap ?-pre_endcap cell? ?-post_endcap cell?}

    hover {
        summary {Add endcap cells.}
        synopsis {add_endcap ?-pre_endcap cell? ?-post_endcap cell?}
        source {F5}
    }
}

command add_filler {
    dialects tcl8.4
    required_package cadence-innovus

    form Default {add_filler ?-cell cell_list? ?-prefix prefix?}

    hover {
        summary {Add filler cells.}
        synopsis {add_filler ?-cell cell_list? ?-prefix prefix?}
        source {F5}
    }
}

command add_stripes {
    dialects tcl8.4
    required_package cadence-innovus

    form Default {add_stripes}

    hover {
        summary {Add power/ground stripes to the power grid.}
        synopsis {add_stripes}
        description {Common-UI power-planning command; the legacy spelling is the singular camelCase addStripe. Option literals are not carried here because no Cadence-authored source confirmed them.}
        source {Cadence release notes / RAK}
    }
}

command add_tieoffs {
    dialects tcl8.4
    required_package cadence-innovus

    form Default {add_tieoffs}

    hover {
        summary {Tie off unused or floating pins to logic constants.}
        synopsis {add_tieoffs}
        description {Connects floating/constant pins to tie-high and tie-low cells (or directly to the power and ground nets). Option literals are not carried here because no Cadence-authored source confirmed them.}
        source {Cadence release notes / RAK}
    }
}

