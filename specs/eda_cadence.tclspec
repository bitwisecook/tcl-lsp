# tcl-lsp — bundled SpecTcl loadable: the Cadence tool commands (Genus, Innovus, Xcelium, Conformal).
#
# This pack IS the source of truth for these commands. The Rust modules that
# used to hold them (rust/tcl-registry/src/commands/eda_cadence/) were deleted when
# the EDA vendor libraries migrated to bundled `.tclspec` loadables, per
# docs/design/spec-packs.md ("the EDA vendor libraries ship as bundled
# `.tclspec` loadables … so the loader path is exercised in production from day
# one rather than reserved for private packs"). Every command was proved
# field-for-field equal to its compiled spec by the SpecTcl round-trip gate
# before the modules were removed.
#
# Discovery: the **bundled** tier — `specs/` beside the server executable, or
# wherever $TCL_LSP_SPEC_PACK_DIR points (rust/tcl-spectcl/src/discovery.rs).
# Edit this file to change the specs; there is no generator to re-run.
# Rendered from the tcl-lsp command registry by the spec studio's SpecTcl
#   renderer (rust/tcl-spec-studio/src/render_spectcl.rs).
# The syntax is docs/design/spec-dsl-examples/README.md. Every `TODO(spectcl)`
#   line below names a field the source spec sets that a pack cannot yet say.

speclib eda_cadence 1.0 {

command add_endcap {
    dialects tcl8.4
    required_package cadence-innovus

    form Default {add_endcap ?-pre_endcap cell? ?-post_endcap cell?}

    hover {
        summary {Add endcap cells.}
        synopsis {add_endcap ?-pre_endcap cell? ?-post_endcap cell?}
        source {F5}
    }
}

