command list_paths {
    arity 0..

    option -analysis -takes value -values {max min} \
           -detail {Whether the timing analysis is max-delay (setup check) or min-delay (hold check).}
    option -format -takes value -values {text csv} \
           -detail {List format, text by default for display or csv for parsing.}
    option -set -takes name \
           -detail {List paths from the named set, as an alternative to naming a set with -clock and -type.}
    option -clock -takes clock_name \
           -detail {List paths from the specified clock domain (only with -type).}
    option -type -takes set_type \
           -values {reg_to_reg async_to_reg reg_to_async external_recovery external_removal external_setup external_hold clock_to_out} \
           -detail {Type of paths to include (only with -clock).}
    option -from_clock -takes clock_name \
           -detail {List the paths of the inter-clock domain starting at this clock (only with -to_clock).}
    option -to_clock -takes clock_name \
           -detail {List the paths of the inter-clock domain ending at this clock (only with -from_clock).}
    option -in_to_out -detail {List the paths between input and output ports.}
    option -from -takes pattern \
           -detail {Keep only paths starting from ports or pins matching the pattern.}
    option -to -takes pattern \
           -detail {Keep only paths ending at ports or pins matching the pattern.}

    option_conflict {-set -clock}

    form Default {list_paths ?-analysis value? ?-format value? ?-set name? ?-clock clock_name -type set_type? ?-from_clock clock_name -to_clock clock_name? ?-in_to_out? ?-from pattern? ?-to pattern?}

    hover {
        summary {Return a list of the worst timing paths matching the arguments.}
        synopsis {list_paths ?-analysis value? ?-format value? ?-set name? ?-clock clock_name -type set_type? ?-from_clock clock_name -to_clock clock_name? ?-in_to_out? ?-from pattern? ?-to pattern?}
        description {Lists the n worst paths of the selected set in the same tabular form SmartTime shows. The number of paths returned is governed by set_options -limit_max_paths; expand_path shows the details of a listed path.}
        returns {A list of the worst paths matching the arguments.}
        example {puts [ list_paths -clock clk1 -type reg_to_reg ]}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

