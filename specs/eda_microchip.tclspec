command smartpower_init_setofpins_values {
    arity 0..

    option -domain_name -takes name -values {IOsEnableSet MemoriesEnableSet} -closed \
           -detail {Specifies which set of pins is initialized.}
    option -freq -takes value -detail {Specifies the user input frequency in Hz, MHz, or KHz.}
    option -proba -takes value -detail {Specifies the user input probability in percent.}

    form Default {smartpower_init_setofpins_values ?-domain_name name? ?-freq value? ?-proba value?}

    hover {
        summary {Initialize the frequency and probability of a set of pins.}
        synopsis {smartpower_init_setofpins_values ?-domain_name name? ?-freq value? ?-proba value?}
        description {Sets the frequency and probability used when the IOsEnableSet or MemoriesEnableSet set of pins is initialized, applying to a preceding smartpower_init_do run with -othersets true. This command is associated with the functionality of the Initialize frequencies and probabilities dialog box.}
        returns {The empty string.}
        example {smartpower_init_setofpins_values -domain_name {IOsEnableSet} -freq {10 MHz} -proba {20}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_remove_all_annotations {
    arity 0..

    option -opmode -takes value \
           -detail {Specifies the mode whose initialization annotations are removed, either Active or Flash*Freeze.}

    form Default {smartpower_remove_all_annotations ?-opmode value?}

    hover {
        summary {Remove all initialization annotations for a mode.}
        synopsis {smartpower_remove_all_annotations ?-opmode value?}
        description {Removes every initialization annotation recorded for the operating mode named by -opmode, so its frequencies and probabilities fall back to their defaults. This command is associated with the functionality of the Initialize frequencies and probabilities dialog box.}
        returns {The empty string.}
        example {smartpower_remove_all_annotations -opmode {Active}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_remove_file {
    arity 0..

    option -file -takes value -detail {Specifies the file to be removed (required).}
    option -format -takes value -values {VCD} \
           -detail {Specifies that the type to be removed is a VCD file (required).}
    option -opmode -takes value -values {Active Standby Flash*Freeze} \
           -detail {Specifies the operating mode the file is removed from, where Standby sets the operating mode to Static; omitting it removes the file from all operating modes.}

    form Default {smartpower_remove_file -file value -format VCD ?-opmode value?}

    hover {
        summary {Remove a VCD file from one operating mode or from all of them.}
        synopsis {smartpower_remove_file -file value -format VCD ?-opmode value?}
        description {Removes the VCD file named by -file from the operating mode named by -opmode, or from every operating mode when -opmode is omitted. The frequency and probability information of the signals that file annotated is set back to the default value.}
        returns {The empty string.}
        example {smartpower_remove_file -file "test.vcd" -format VCD -opmode "Active"
smartpower_remove_file -file "power1.vcd" -format VCD}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_remove_pin_probability {
    arity 0..

    option -pin_name -takes pin_name \
           -detail {Specifies the name of the pin whose probability is removed, which must be the direct driver of an enable pin.}

    form Default {smartpower_remove_pin_probability ?-pin_name pin_name?}

    hover {
        summary {Remove the probability value associated with a specific pin.}
        synopsis {smartpower_remove_pin_probability ?-pin_name pin_name?}
        description {Removes the probability value previously set on the pin named by -pin_name, after which that pin takes the default probability of the domain set it belongs to. The pin must be the direct driver of an enable pin.}
        returns {The empty string.}
        example {smartpower_remove_pin_probability -pin_name mybibuf/U0/U1:EOUT}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_remove_scenario {
    arity 0..

    option -name -takes value -detail {Specifies the name of the scenario.}

    form Default {smartpower_remove_scenario ?-name value?}

    hover {
        summary {Remove a scenario from the current design.}
        synopsis {smartpower_remove_scenario ?-name value?}
        description {Removes the power scenario named by -name from the current design.}
        returns {The empty string.}
        example {smartpower_remove_scenario -name myscenario}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_report_power {
    arity 1..

    side_effect FileIo -writes

    option -powerunit -takes value -values {W mW uW} \
           -detail {Specifies the unit in which power is set, watts, milliwatts, or microwatts.}
    option -frequnit -takes value -values {Hz kHz MHz} \
           -detail {Specifies the unit in which frequency is set, hertz, kilohertz, or megahertz.}
    option -opcond -takes value -values {worst typical best} \
           -detail {Specifies the operating condition, where worst and best are available only for certain families and devices.}
    ;# NOTE(libero): the guide's -opmode table lists Active, Standby and
    ;# Flash*Freeze, while the same section's Notes also name Sleep and Shutdown
    ;# as modes available on certain families, so the set is left open.
    option -opmode -takes value -values {Active Standby Flash*Freeze} \
           -detail {Specifies the operating mode, where Flash*Freeze, Sleep, and Shutdown are available only for certain families and devices.}
    option -toggle -takes value -values {true false} -detail {Specifies the toggle.}
    option -power_summary -takes value -values {true false} \
           -detail {Includes the power summary, which shows the static and dynamic values, in the report.}
    option -rail_breakdown -takes value -values {true false} \
           -detail {Includes the breakdown by rail summary in the report.}
    option -type_breakdown -takes value -values {true false} \
           -detail {Includes the breakdown by type summary in the report.}
    option -clock_breakdown -takes value -values {true false} \
           -detail {Includes the breakdown by clock domain summary in the report.}
    option -thermal_summary -takes value -values {true false} \
           -detail {Includes the thermal summary in the report.}
    option -battery_life -takes value -values {true false} \
           -detail {Includes the battery life summary in the report.}
    option -opcond_summary -takes value -values {true false} \
           -detail {Includes the operating conditions summary in the report.}
    option -clock_summary -takes value -values {true false} \
           -detail {Includes the clock domains summary in the report.}
    option -style -takes value -values {Text CSV} \
           -detail {Specifies the format in which the report will be exported, a text file or a CSV file.}
    option -sortorder -takes value -values {ascending descending} \
           -detail {Specifies the sort order of the values in the report.}
    option -sortby -takes value -values {{power values} alphabetical} \
           -detail {Specifies how to sort the values in the report, by power value or alphabetically.}
    option -instance_breakdown -takes value -values {true false} \
           -detail {Includes the breakdown by instance in the report.}
    option -power_threshold -takes value -values {true false} \
           -detail {Includes only the instances that consume power above a minimum value, in which case -min_power must also be given.}
    option -filter_instance -takes value -values {true false} \
           -detail {Limits the number of instances included in the Power report, in which case -max_instance must also be given.}
    option -min_power -takes number \
           -detail {Specifies which block to expand based on the minimum power value of a block.}
    option -max_instance -takes integer \
           -detail {Sets the maximum number of instances included in the Power report to an integer greater than or equal to zero.}
    option -activity_sortorder -takes value -values {ascending descending} \
           -detail {Specifies the sort order for the activity summary.}
    option -activity_sortby -takes value -values {{pin name} {net name} domain frequency source} \
           -detail {Specifies how to sort the values for the activity summary.}
    option -activity_summary -takes value -values {true false} \
           -detail {Includes the activity summary in the report.}
    option -frequency_threshold -takes value -values {true false} \
           -detail {Adds a frequency threshold to the report.}
    option -filter_pin -takes value -values {true false} \
           -detail {Filters by maximum number of pins.}
    option -min_frequency -takes value \
           -detail {Sets the minimum frequency as a decimal value optionally followed by a Hz, KHz, or MHz unit.}
    option -max_pin -takes value -detail {Sets the maximum number of pins.}
    option -enablerates_sortorder -takes value -values {ascending descending} \
           -detail {Specifies the sort order for the probabilities summary.}
    option -enablerates_sortby -takes value -values {{pin name} {net name} domain frequency source} \
           -detail {Specifies how to sort the values for the probabilities summary.}
    option -enablerates_summary -takes value -values {true false} \
           -detail {Includes the probabilities summary in the report.}
    option -with_annotation_coverage -takes value -values {true false} \
           -detail {Includes the annotation coverage summary in the report.}

    form Default {smartpower_report_power ?-powerunit value? ?-frequnit value? ?-opcond value? ?-opmode value? ?-toggle value? ?-power_summary value? ?-rail_breakdown value? ?-type_breakdown value? ?-clock_breakdown value? ?-thermal_summary value? ?-battery_life value? ?-opcond_summary value? ?-clock_summary value? ?-style value? ?-sortorder value? ?-sortby value? ?-instance_breakdown value? ?-power_threshold value? ?-filter_instance value? ?-min_power number? ?-max_instance integer? ?-activity_sortorder value? ?-activity_sortby value? ?-activity_summary value? ?-frequency_threshold value? ?-filter_pin value? ?-min_frequency value? ?-max_pin value? ?-enablerates_sortorder value? ?-enablerates_sortby value? ?-enablerates_summary value? ?-with_annotation_coverage value? filename}

    hover {
        summary {Create a Power report for the design.}
        synopsis {smartpower_report_power ?-powerunit value? ?-frequnit value? ?-opcond value? ?-opmode value? ?-toggle value? ?-power_summary value? ?-rail_breakdown value? ?-type_breakdown value? ?-clock_breakdown value? ?-thermal_summary value? ?-battery_life value? ?-opcond_summary value? ?-clock_summary value? ?-style value? ?-sortorder value? ?-sortby value? ?-instance_breakdown value? ?-power_threshold value? ?-filter_instance value? ?-min_power number? ?-max_instance integer? ?-activity_sortorder value? ?-activity_sortby value? ?-activity_summary value? ?-frequency_threshold value? ?-filter_pin value? ?-min_frequency value? ?-max_pin value? ?-enablerates_sortorder value? ?-enablerates_sortby value? ?-enablerates_summary value? ?-with_annotation_coverage value? filename}
        description {Creates a Power report, written to the named file, that shows whether the design has any power consumption problems. It carries the global device and SmartPower preferences selection and hierarchical detail down to gates, blocks and nets, with a block-by-block, gate-by-gate and net-by-net power summary of the SmartPower results, and each summary section, sort order and threshold is selected by its own option. The removed arguments -annotated_pins, -stat_pow and -dyn_pow are now ignored with a warning.}
        returns {The empty string.}
        example {smartpower_report_power -powerunit "uW" -frequnit "MHz" -opcond "Typical" \
    -opmode "Active" -toggle "TRUE" -rail_breakdown "TRUE" -battery_life "TRUE" \
    -style "Text" -power_summary "TRUE" -activity_sortby "Source" text_report.txt}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_report_power_activity_map {
    arity 1..

    side_effect FileIo -writes

    option -vcd_file -takes path -detail {Specifies the path to the VCD file to import.}
    option -style -takes value -values {Text CSV} \
           -detail {Specifies the format in which the report will be exported, a text file or a CSV file.}
    option -partial_parse -takes value -values {true false} \
           -detail {Partially parses the VCD file.}
    option -start_time -takes value \
           -detail {Specifies the start time in ns at which to begin parsing the VCD file (only with -partial_parse).}
    option -end_time -takes value \
           -detail {Specifies the end time in ns at which to stop parsing the VCD file (only with -partial_parse).}
    option -auto_detect_top_level_name -takes value -values {true false} \
           -detail {Automatically detects the top-level name.}
    option -top_level_name -takes name -detail {Specifies the top-level name.}
    option -report_type -takes value -values {activity power {activity and power}} \
           -detail {Specifies the report query type, choosing whether each net carries activity information, power information, or both.}
    option -report_query -takes value \
           -values {{Report by Net - summary} {Report by Net - detailed} {Report by Cycle - summary} {Report by cycle - detailed}} \
           -detail {Specifies the report type, a summary or detailed report organized by net or by cycle.}
    option -sortby -takes value \
           -values {{total power} {spurious power} {functional power} {spurious transitions} {functional transitions}} \
           -detail {Specifies how to sort the values in the report.}
    option -sortorder -takes value -values {descending ascending} \
           -detail {Specifies the sort order of the values in the report.}
    option -max_net -takes value \
           -detail {Specifies the maximum number of nets to report, limiting total entries in a net report and per-cycle nets in a cycle details report.}
    option -max_cycle -takes value \
           -detail {Specifies the maximum number of cycles to report, limiting total entries in a cycle report and per-net cycles in a net details report.}
    option -clock_settings -takes value \
           -detail {Specifies the settings for the clock in the form clock_name:active_edge, where the active edge is rising, falling, both, or not_active to not use the signal as a clock.}
    option -glitch_filtering -takes value -values {true auto false} \
           -detail {Controls glitch filtering, where auto enables automatic filtering and ignores any value given for -glitch_threshold.}
    option -glitch_threshold -takes value \
           -detail {Specifies the glitch filtering value in ps (only with -glitch_filtering true).}
    option -auto_construct_clock_domain -takes value -values {true false} \
           -detail {Automatically constructs the clock domain.}
    option -clock_period -takes value \
           -detail {Specifies a virtual clock period in ps, to be used when -auto_construct_clock_domain is false.}
    option -clock_offset -takes value \
           -detail {Specifies the time in ps of the first active edge of the virtual clock, to be used when -auto_construct_clock_domain is false.}
    option -opmode -takes value -values {Active Standby Flash*Freeze} \
           -detail {Specifies the mode from which the operating conditions are extracted to generate the report.}

    form Default {smartpower_report_power_activity_map ?-vcd_file path? ?-style value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name name? ?-report_type value? ?-report_query value? ?-sortby value? ?-sortorder value? ?-max_net value? ?-max_cycle value? ?-clock_settings value? ?-glitch_filtering value? ?-glitch_threshold value? ?-auto_construct_clock_domain value? ?-clock_period value? ?-clock_offset value? ?-opmode value? filename}

    hover {
        summary {Create an activity and hazards power report from a VCD file.}
        synopsis {smartpower_report_power_activity_map ?-vcd_file path? ?-style value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name name? ?-report_type value? ?-report_query value? ?-sortby value? ?-sortorder value? ?-max_net value? ?-max_cycle value? ?-clock_settings value? ?-glitch_filtering value? ?-glitch_threshold value? ?-auto_construct_clock_domain value? ?-clock_period value? ?-clock_offset value? ?-opmode value? filename}
        description {Reads the VCD file given by -vcd_file and writes to the named file a report of the transitions and hazards seen in each clock cycle. The report can be organized by net or by cycle and as a summary or in detail through -report_type and -report_query, capped with -max_net and -max_cycle, and its cycle boundaries come either from -clock_settings or from a virtual clock defined by -clock_period and -clock_offset.}
        returns {The empty string.}
        example {smartpower_report_power_activity_map -partial_parse "TRUE" -start_time "1.0" \
    -end_time "3.0" -auto_detect_top_level_name "TRUE" -top_level_name "mytopmodule" \
    -glitch_filtering "auto" -style "Text" -opmode "Active" -vcd_file power.vcd \
    -report_query "Report by Net - summary" -clock_period "2000.0" \
    -clock_offset "10.0" "report_power_activity_map_partial.txt"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_report_power_peak_analyzer {
    arity 1..

    side_effect FileIo -writes

    option -type -takes value -values {power_cycle_accurate} \
           -detail {Specifies that the type of report to generate is a cycle accurate power report.}
    option -vcd_file -takes path -detail {Specifies the path to the VCD file to import.}
    option -style -takes value -values {Text CSV} \
           -detail {Specifies the format in which the report will be exported, a text file or a CSV file.}
    option -partial_parse -takes value -values {true false} \
           -detail {Partially parses the VCD file.}
    option -start_time -takes value \
           -detail {Specifies the start time in ns at which to begin parsing the VCD file (only with -partial_parse).}
    option -end_time -takes value \
           -detail {Specifies the end time in ns at which to stop parsing the VCD file (only with -partial_parse).}
    option -auto_detect_top_level_name -takes value -values {true false} \
           -detail {Automatically detects the top-level name.}
    option -top_level_name -takes name -detail {Specifies the top-level name.}
    option -glitch_filtering -takes value -values {true auto false} \
           -detail {Controls glitch filtering, where auto enables automatic filtering and ignores any value given for -glitch_threshold.}
    option -glitch_threshold -takes value \
           -detail {Specifies the glitch filtering value in ps (only with -glitch_filtering true).}
    option -power_summary -takes value -values {true false} \
           -detail {Includes the power summary, which shows the static and dynamic values, in the report.}
    option -auto_detect_sampling_period -takes value -values {true false} \
           -detail {Automatically detects the sampling period.}
    option -sampling_clock -takes value -detail {Specifies the sampling clock.}
    option -sampling_rate_per_period -takes value -values {true false} \
           -detail {Specifies the sampling rate per period when true and per half period when false.}
    option -sampling_offset -takes value \
           -detail {Specifies the offset in ps used to calculate the sampling offset.}
    option -sampling_period -takes value \
           -detail {Specifies the offset in ps used to calculate the sampling period.}
    option -use_only_local_extrema -takes value -values {true false} \
           -detail {Limits the history size by keeping only local extrema.}
    option -use_power_threshold -takes value -values {true false} \
           -detail {Limits the history size by setting a power threshold.}
    option -power_threshold -takes value -detail {Sets the power threshold value.}
    option -opmode -takes value -values {Active Standby Flash*Freeze} \
           -detail {Specifies the mode from which the operating conditions are extracted to generate the report.}

    form Default {smartpower_report_power_peak_analyzer ?-type power_cycle_accurate? ?-vcd_file path? ?-style value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name name? ?-glitch_filtering value? ?-glitch_threshold value? ?-power_summary value? ?-auto_detect_sampling_period value? ?-sampling_clock value? ?-sampling_rate_per_period value? ?-sampling_offset value? ?-sampling_period value? ?-use_only_local_extrema value? ?-use_power_threshold value? ?-power_threshold value? ?-opmode value? filename}

    hover {
        summary {Create a cycle accurate power report from a VCD file.}
        synopsis {smartpower_report_power_peak_analyzer ?-type power_cycle_accurate? ?-vcd_file path? ?-style value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name name? ?-glitch_filtering value? ?-glitch_threshold value? ?-power_summary value? ?-auto_detect_sampling_period value? ?-sampling_clock value? ?-sampling_rate_per_period value? ?-sampling_offset value? ?-sampling_period value? ?-use_only_local_extrema value? ?-use_power_threshold value? ?-power_threshold value? ?-opmode value? filename}
        description {Writes to the named file a power waveform carrying one power value per clock period or half-period, instead of a single average power for the whole simulation read from -vcd_file. The sampling grid comes either from -auto_detect_sampling_period or from -sampling_clock with -sampling_rate_per_period, -sampling_offset and -sampling_period, and the recorded history can be trimmed with -use_only_local_extrema or -use_power_threshold together with -power_threshold.}
        returns {The empty string.}
        example {smartpower_report_power_peak_analyzer -partial_parse "TRUE" -vcd_file "power.vcd" \
    -style "Text" -start_time "0.05" -end_time "1.00" \
    -auto_detect_top_level_name "TRUE" -glitch_filtering "FALSE" \
    -glitch_threshold "100" -auto_detect_sampling_period "TRUE" \
    -sampling_clock "clk" -sampling_rate_per_period "TRUE" -sampling_offset "0.00" \
    -sampling_period "10000.00" -use_only_local_extrema "TRUE" \
    -use_power_threshold "TRUE" -power_threshold "0.00" -opmode "Active" \
    "report_power_cycle_based.txt"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_report_power_sequencer {
    arity 1..

    side_effect FileIo -writes

    option -powerunit -takes value -values {W mW uW} \
           -detail {Specifies the unit in which power is set, watts, milliwatts, or microwatts.}
    option -frequnit -takes value -values {Hz kHz MHz} \
           -detail {Specifies the unit in which frequency is set, hertz, kilohertz, or megahertz.}
    option -opcond -takes value \
           -detail {Specifies the operating condition, where Worst and Best are available only for certain families and devices.}
    option -toggle -takes value -values {true false} -detail {Specifies the toggle.}
    option -scenario -takes value -detail {Specifies the scenario that the report is generated from.}
    option -style -takes value -values {Text CSV} \
           -detail {Specifies the format in which the report will be exported, a text file or a CSV file.}
    option -battery_life -takes value -values {true false} \
           -detail {Includes the battery life summary in the report.}
    option -battery_capacity -takes value -detail {Specifies the battery capacity in A*H.}
    option -rail_breakdown -takes value -values {true false} \
           -detail {Includes the breakdown by rail summary in the report, off by default.}
    option -type_breakdown -takes value -values {true false} \
           -detail {Includes the breakdown by type summary in the report, off by default.}
    option -mode_breakdown -takes value -values {true false} \
           -detail {Includes the breakdown by mode in the report, off by default.}
    option -opcond_summary -takes value -values {true false} \
           -detail {Includes the operating conditions summary in the report.}

    form Default {smartpower_report_power_sequencer ?-powerunit value? ?-frequnit value? ?-opcond value? ?-toggle value? ?-scenario value? ?-style value? ?-battery_life value? ?-battery_capacity value? ?-rail_breakdown value? ?-type_breakdown value? ?-mode_breakdown value? ?-opcond_summary value? filename}

    hover {
        summary {Create a scenario power report for a previously defined scenario.}
        synopsis {smartpower_report_power_sequencer ?-powerunit value? ?-frequnit value? ?-opcond value? ?-toggle value? ?-scenario value? ?-style value? ?-battery_life value? ?-battery_capacity value? ?-rail_breakdown value? ?-type_breakdown value? ?-mode_breakdown value? ?-opcond_summary value? filename}
        description {Writes to the named file a power report for the scenario named by -scenario, carrying the global device and SmartPower preferences selection together with the average power consumption and the expected battery life for that sequence. Breakdowns by rail, by type and by mode are off by default and are each enabled by their own option. Flash*Freeze, Sleep, and Shutdown modes, and the Worst and Best operating conditions, are available only for certain families and devices.}
        returns {The empty string.}
        example {smartpower_report_power_sequencer -scenario my_scenario -rail_breakdown true \
    -type_breakdown true -mode_breakdown true -style text -battery_capacity 10 report.txt}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

