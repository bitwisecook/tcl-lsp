}

command rename_file {
    arity 0..

    option -file -takes filename -detail {Original name of the file (required).}
    option -target -takes new_filename -detail {New name of the file (required).}

    form Default {rename_file -file filename -target new_filename}

    hover {
        summary {Rename a constraint file.}
        synopsis {rename_file -file filename -target new_filename}
        description {Renames the constraint file named by -file to the name given by -target. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {0 on success and 1 on failure.}
        example {rename_file -file {c:/user/a.sdc} -target {c:/user/b.sdc}}
