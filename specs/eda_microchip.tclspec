command st_set_options {
    arity 0..

    option -max_opcond -takes value -values {worst typ best} \
           -detail {Operating condition used for maximum delay analysis.}
    option -min_opcond -takes value -values {best typ worst} \
           -detail {Operating condition used for minimum delay analysis.}
    option -interclockdomain_analysis -takes value -values {yes no} \
           -detail {Enable or disable inter-clock domain analysis.}
    option -use_bibuf_loopbacks -takes value -values {yes no} \
           -detail {Enable or disable loopback in bidirectional buffers.}
    option -enable_recovery_removal_checks -takes value -values {yes no} \
           -detail {Enable or disable recovery and removal checks.}
    option -break_at_async -takes value -values {yes no} \
           -detail {Enable or disable breaking paths at asynchronous ports.}
    option -filter_when_slack_below -takes value \
           -detail {Do not show paths whose slack is below this value.}
    option -filter_when_slack_above -takes value \
           -detail {Do not show paths whose slack is above this value.}
    option -remove_slack_filters -detail {Remove all existing slack filters.}
    option -limit_max_paths -takes value \
           -detail {Limit path reporting commands to this many paths, a value of zero or higher.}
    option -expand_clock_network -takes value -values {yes no} \
           -detail {Enable or disable expanded clock network information in expanded paths.}
    option -expand_parallel_paths -takes value \
           -detail {Expand at most this many parallel paths; zero or one expands a single path.}
    option -analysis_scenario -takes value \
           -detail {Timing constraint scenario used for both maximum and minimum delay analysis; it does not affect the TDPR scenario.}
    option -tdpr_scenario -takes value \
           -detail {Timing constraint scenario used by the place-and-route engine; it does not affect the analysis scenario.}
    option -reset \
           -detail {Reset all options to their default values, leaving the analysis and TDPR scenarios unchanged.}

    form Default {st_set_options ?-max_opcond value? ?-min_opcond value? ?-interclockdomain_analysis value? ?-use_bibuf_loopbacks value? ?-enable_recovery_removal_checks value? ?-break_at_async value? ?-filter_when_slack_below value? ?-filter_when_slack_above value? ?-remove_slack_filters? ?-limit_max_paths value? ?-expand_clock_network value? ?-expand_parallel_paths value? ?-analysis_scenario value? ?-tdpr_scenario value? ?-reset?}

    hover {
        summary {Set the SmartTime timing analysis options.}
        synopsis {st_set_options ?-max_opcond value? ?-min_opcond value? ?-interclockdomain_analysis value? ?-use_bibuf_loopbacks value? ?-enable_recovery_removal_checks value? ?-break_at_async value? ?-filter_when_slack_below value? ?-filter_when_slack_above value? ?-remove_slack_filters? ?-limit_max_paths value? ?-expand_clock_network value? ?-expand_parallel_paths value? ?-analysis_scenario value? ?-tdpr_scenario value? ?-reset?}
        description {The SmartFusion, IGLOO, ProASIC3, and Fusion form of set_options; for those families these options also affect timing-driven place-and-route. Called with no parameters it displays the current setting of every option.}
        returns {The current settings of the options when the command is called with no parameters.}
        example {st_set_options -limit_max_paths 50 -remove_slack_filters -filter_when_slack_above 3}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command timer_get_clock_actuals {
    arity 0..

    option -clock -takes clock_name \
           -detail {Name of the clock whose actual frequency or period is displayed (required).}

    form Default {timer_get_clock_actuals -clock clock_name}

    hover {
        summary {Display the actual clock frequency in the Log window.}
        synopsis {timer_get_clock_actuals -clock clock_name}
        description {Reports the frequency the timing analysis tool computed for the named clock once analysis has been run; timer_get_clock_constraints reports the constrained values instead.}
        returns {Nothing; the actual clock frequency is displayed in the Log window.}
        example {timer_get_clock_actuals -clock clk1}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command timer_get_clock_constraints {
