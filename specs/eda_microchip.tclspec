}

command set_clock_to_output {
    arity 1..

    option -clock -takes clock_ref \
           -detail {Reference clock the clock-to-output delay is related to (required).}
    option -max \
           -detail {The delay value is the maximum clock to output at the specified output; with neither -max nor -min the two are assumed equal.}
    option -min \
           -detail {The delay value is the minimum clock to output at the specified output; with neither -max nor -min the two are assumed equal.}

    form Default {set_clock_to_output delay_value -clock clock_ref ?-max? ?-min? output_list}

    hover {
        summary {Define the timing budget available inside the FPGA for an output relative to a clock.}
        synopsis {set_clock_to_output delay_value -clock clock_ref ?-max? ?-min? output_list}
        description {The delay value, in nanoseconds, is the time available inside the FPGA between the active clock edge and the data change at the output port. The output list names the output ports of the current design the value is assigned to.}
        returns {Not documented in the command reference.}
        example {set_clock_to_output 5.0 -clock CLK1 -max {OUT1}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_current_scenario {
    arity 1

    form Default {set_current_scenario name}

    hover {
        summary {Specify the timing scenario the Timing Analyzer uses.}
        synopsis {set_current_scenario name}
        description {Every command that follows applies to the named timing scenario, whose constraints can then be listed, added, or removed and checked, and which is used to compute timing analysis. Setting the scenario that is already current has no effect.}
        returns {Not documented in the command reference.}
        example {set_current_scenario scenario_A}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_debug_device {
    arity 0..

    option -name -takes device_name \
           -detail {Device name, not required when only one device is in the current configuration.}

    form Default {set_debug_device -name device_name}

    hover {
        summary {Identify the device to be debugged.}
        synopsis {set_debug_device -name device_name}
        description {SmartDebug command that selects the device subsequent debug commands act on, so their own -name option can then be omitted. (SmartFusion2, IGLOO2, SmartFusion, IGLOO, ProASIC3 and Fusion.)}
        returns {The empty string.}
        example {set_debug_device -name {A3P250}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_debug_programmer {
    arity 0..

    option -name -takes programmer_name \
           -detail {Programmer name, the serial number on the bar code label of the FlashPro programmer (required).}

    form Default {set_debug_programmer -name programmer_name}

    hover {
        summary {Identify the programmer to use for debugging.}
        synopsis {set_debug_programmer -name programmer_name}
        description {SmartDebug command that selects which attached FlashPro programmer is used for debugging when more than one is present; the name is the serial number on the programmer's bar code label, and get_programmer_info lists the connected programmers. (SmartFusion, IGLOO, ProASIC3 and Fusion.)}
        returns {The empty string.}
        example {set_debug_programmer -name {10841}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_design {
    arity 0..

    option -name -takes design_name \
           -detail {Name of the design, used as the base name for most of the files Designer generates (required).}
    option -family -takes family_name \
           -detail {Device family the design is targeted at (required).}
    option -path -takes path_name \
           -detail {Physical path of the directory in which the design files are created (required).}

    form Default {set_design -name design_name -family family_name -path path_name}

    hover {
        summary {Specify the design name, family and path Designer works in.}
        synopsis {set_design -name design_name -family family_name -path path_name}
        description {Specifies the design name, family and path in which Designer processes the design; all three arguments are needed and this step is required before importing the source files.}
        returns {The guide documents no return value; a failure is a catchable Tcl error.}
        example {set_design -name "test" -family "Axcelerator" -path {.}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_device {
    arity 0..

    option -family -takes family_name \
           -detail {Name of the FPGA device family.}
    option -die -takes die_name \
           -detail {Part name of the die.}
    option -package -takes package_name \
           -detail {Package selected for the device.}
    option -speed -takes speed_grade \
           -detail {Speed grade of the part.}
    option -voltage -takes voltage \
           -detail {Core voltage of the device, which may also define the I/O voltage of the part as in -voltage 3.3/2.5.}
    option -voltrange -takes volt_range \
           -detail {Voltage range applied to the device, usually MIL, COM or IND, or custom best, typical and worst values such as "1.60 1.50 1.40".}
    option -temprange -takes temp_range \
           -detail {Temperature range applied to the device, usually MIL, COM or IND, or Automotive, TGrade1 or TGrade2 for automotive applications.}
    option -iostd -takes default_io_std \
           -detail {Default I/O standard of the part.}
    option -pci -takes value -values {yes no} -closed \
           -detail {Configures the I/Os for the PCI specification.}
    option -jtag -takes value -values {yes no} -closed \
           -detail {Reserves pins for JTAG.}
    option -probe -takes value -values {yes no} -closed \
           -detail {Preserves pins for probing.}
    option -trst -takes value -values {yes no} -closed \
           -detail {Reserves pins for JTAG test reset.}
    option -radexp -takes value \
           -detail {Radiation value in Krad for radiation tolerant devices.}
    option -vcci_1.2_voltrange -takes value \
           -detail {Voltage range for VCCI1.2, given as MIL, COM or IND or as custom best, typical and worst values.}
    option -vcci_1.2_widerange -takes value -values {yes no} -closed \
           -detail {Specifies the voltage range for VCCI1.2 as wide range, setting the def variable IS_VCCI_1.2_WR to 1.}
    option -vcci_1.5_voltrange -takes value \
           -detail {Voltage range for VCCI1.5, given as MIL, COM or IND or as custom best, typical and worst values.}
    option -vcci_1.8_voltrange -takes value \
           -detail {Voltage range for VCCI1.8, given as MIL, COM or IND or as custom best, typical and worst values.}
    option -vcci_2.5_voltrange -takes value \
           -detail {Voltage range for VCCI2.5, given as MIL, COM or IND or as custom best, typical and worst values.}
    option -vcci_3.3_voltrange -takes value \
           -detail {Voltage range for VCCI3.3, given as MIL, COM or IND or as custom best, typical and worst values.}
    option -vcci_3.3_widerange -takes value -values {yes no} -closed \
           -detail {Specifies the voltage range for VCCI3.3 as wide range, setting the def variable IS_VCCI_3.3_WR to 1.}

    form Default {set_device ?-family family_name? ?-die die_name? ?-package package_name? ?-speed speed_grade? ?-voltage voltage? ?-voltrange volt_range? ?-temprange temp_range? ?-iostd default_io_std? ?-pci value? ?-jtag value? ?-probe value? ?-trst value? ?-radexp value? ?-vcci_1.2_voltrange value? ?-vcci_1.2_widerange value? ?-vcci_1.5_voltrange value? ?-vcci_1.8_voltrange value? ?-vcci_2.5_voltrange value? ?-vcci_3.3_voltrange value? ?-vcci_3.3_widerange value?}

    hover {
        summary {Specify the device and its parameters.}
        synopsis {set_device ?-family family_name? ?-die die_name? ?-package package_name? ?-speed speed_grade? ?-voltage voltage? ?-voltrange volt_range? ?-temprange temp_range? ?-iostd default_io_std? ?-pci value? ?-jtag value? ?-probe value? ?-trst value? ?-radexp value? ?-vcci_1.2_voltrange value? ?-vcci_1.2_widerange value? ?-vcci_1.5_voltrange value? ?-vcci_1.8_voltrange value? ?-vcci_2.5_voltrange value? ?-vcci_3.3_voltrange value? ?-vcci_3.3_widerange value?}
        description {Specifies the type of device and its parameters, including die, package, speed grade, voltage and temperature ranges, default I/O standard, pin reservations and the per-VCCI voltage ranges. At least one option must be given, and options covering features a family does not support do not apply to it.}
        returns {The guide documents no return value.}
        example {set_device -die "APA075" -package "208 PQFP" -speed "STD" -voltage "2.5" \
-jtag "yes" -trst "yes" -temprange "COM" -voltrange "COM" \
-vcci_1.2_voltrange "COM" -vcci_1.2_widerange "no" -vcci_1.5_voltrange "1.60 1.50 1.40"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_external_check {
    arity 1..

    option -clock -takes clock_ref \
           -detail {Reference clock the external check is related to (required).}
    option -setup \
           -detail {The delay value is the setup check at the specified input; either -setup or -hold must be given.}
    option -hold \
           -detail {The delay value is the hold check at the specified input; either -setup or -hold must be given.}

    form Default {set_external_check delay_value -clock clock_ref ?-setup? ?-hold? input_list}

    hover {
        summary {Define the external setup and hold delays for an input relative to a clock.}
        synopsis {set_external_check delay_value -clock clock_ref ?-setup? ?-hold? input_list}
        description {The delay value, in nanoseconds, is the external setup or external hold delay, that is the time available inside the FPGA for the specified input after a clock edge. The input list names the input ports of the current design the value is assigned to.}
        returns {Not documented in the command reference.}
        example {set_external_check 2.0 -clock CLK1 -setup {IN1}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_live_probe {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration or set for debug.}
    option -probeA -takes probe_name \
           -detail {Specifies the target probe point for probe channel A.}
    option -probeB -takes probe_name \
           -detail {Specifies the target probe point for probe channel B.}

    form Default {set_live_probe ?-deviceName device_name? ?-probeA probe_name? ?-probeB probe_name?}

    hover {
        summary {Set the live probe channels to the specified probe points.}
        synopsis {set_live_probe ?-deviceName device_name? ?-probeA probe_name? ?-probeB probe_name?}
        description {SmartDebug command that connects live probe channel A and/or B to exact probe point names; at least one probe point must be given and no search pattern is allowed. Setting one channel affects the other, so both must be set in the same call. The array must be programmed and active, active probe reads and writes disturb the live probe settings because they share the device's probe circuitry, security locks may disable the function, and the ProbeA and ProbeB I/Os must be reserved for live probe. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {set_live_probe -deviceName sf2 -probeA A12}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_modelsim_options {
    arity 0..

    option -use_automatic_do_file -takes value -values {TRUE FALSE} -closed \
           -detail {Uses the default automatic.do file in your project when TRUE, or a different DO file named by the other options when FALSE.}
    option -user_do_file -takes path -detail {Location of your user-defined DO file.}
    option -sim_runtime -takes value \
           -detail {Simulation runtime given as a number and a unit of time, such as 1000ns.}
    option -tb_module_name -takes value -detail {Your testbench module name.}
    option -tb_top_level_name -takes value -detail {Top-level instance name in the testbench.}
    option -include_do_file -takes value -values {TRUE FALSE} -closed \
           -detail {Includes the DO file named by -included_do_file when TRUE.}
    option -included_do_file -takes value -detail {Path of the included DO file.}
    option -type -takes value -values {min typ max} -closed \
           -detail {Resolution type: minimum, typical, or maximum.}
    option -resolution -takes value -detail {Your resolution value, such as 1ps.}
    option -add_vsim_options -takes value -detail {Additional vsim options.}
    option -display_dut_wave -takes value -values {0 1} -closed \
           -detail {Displays the signal for the top-level testbench when 0, or the signals for the tested design when 1.}
    option -log_all_signals -takes value -values {TRUE FALSE} -closed \
           -detail {Logs all your signals during simulation when TRUE.}
    option -do_file_args -takes value -detail {DO file command parameters.}
    option -dump_vcd -takes value -values {TRUE FALSE} -closed \
           -detail {Dumps the VCD file when simulation is complete.}
    option -vcd_file -takes value -detail {Name of the dumped VCD file.}

    form Default {set_modelsim_options ?-use_automatic_do_file value? ?-user_do_file path? ?-sim_runtime value? ?-tb_module_name value? ?-tb_top_level_name value? ?-include_do_file value? ?-included_do_file value? ?-type value? ?-resolution value? ?-add_vsim_options value? ?-display_dut_wave value? ?-log_all_signals value? ?-do_file_args value? ?-dump_vcd value? ?-vcd_file value?}

    hover {
        summary {Set your ModelSim simulation options.}
        synopsis {set_modelsim_options ?-use_automatic_do_file value? ?-user_do_file path? ?-sim_runtime value? ?-tb_module_name value? ?-tb_top_level_name value? ?-include_do_file value? ?-included_do_file value? ?-type value? ?-resolution value? ?-add_vsim_options value? ?-display_dut_wave value? ?-log_all_signals value? ?-do_file_args value? ?-dump_vcd value? ?-vcd_file value?}
        description {Configures the ModelSim run: which DO file is used, the testbench module and top-level names, the runtime, resolution and resolution type, extra vsim options, waveform display and signal logging, and VCD dumping.}
        returns {The guide does not document a return value.}
        example {set_modelsim_options -use_automatic_do_file 1 -sim_runtime {1000ns} \
  -tb_module_name {testbench} -include_do_file 0 -type {max} -resolution {1ps} \
  -display_dut_wave 0 -log_all_signals 0 -dump_vcd 0 -vcd_file {power.vcd}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_option {
    arity 0..

    option -synth -takes value -values {TRUE FALSE} -closed \
           -detail {Runs synthesis when TRUE.}
    option -fhb -takes value -values {TRUE FALSE} -closed \
           -detail {Enables or disables FPGA Hardware Breakpoint Auto Instantiation.}
    option -module -takes module_name \
           -detail {Identifies the module on which you will run synthesis.}

    form Default {set_option ?-synth value? ?-fhb value? ?-module module_name?}

    hover {
        summary {Set the synthesis and FPGA Hardware Breakpoint options on a module.}
        synopsis {set_option ?-synth value? ?-fhb value? ?-module module_name?}
        description {Controls whether synthesis runs for a module and whether FPGA Hardware Breakpoint Auto Instantiation is enabled for it.}
        returns {The guide does not document a return value.}
        example {set_option -synth TRUE -module module_name}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_options {
    arity 0..

    option -max_opcond -takes value -values {worst typical best} \
           -detail {Operating condition used for maximum delay analysis, worst by default.}
    option -min_opcond -takes value -values {best typical worst} \
           -detail {Operating condition used for minimum delay analysis, best by default.}
    option -interclockdomain_analysis -takes value -values {yes no} \
           -detail {Enable inter-clock domain analysis, yes by default.}
    option -use_bibuf_loopbacks -takes value -values {yes no} \
           -detail {Treat the loopback path in bidirectional buffers as a false path, yes by default.}
    option -enable_recovery_removal_checks -takes value -values {yes no} \
           -detail {Include recovery checks in max-delay analysis and removal checks in min-delay analysis, yes by default.}
    option -break_at_async -takes value -values {yes no} \
           -detail {Allow timing analysis to cross asynchronous pins such as clear and reset, no by default.}
    option -filter_when_slack_below -takes value \
           -detail {Minimum slack value for paths reported by list_paths; not set by default.}
    option -filter_when_slack_above -takes value \
           -detail {Maximum slack value for paths reported by list_paths; not set by default.}
    option -remove_slack_filters \
           -detail {Remove the minimum and maximum set with -filter_when_slack_below and -filter_when_slack_above.}
    option -limit_max_paths -takes value \
           -detail {Maximum number of paths reported by list_paths, 100 by default.}
    option -expand_clock_network -takes value -values {yes no} \
           -detail {Report clock network details in expand_path, yes by default.}
    option -expand_parallel_paths -takes value \
           -detail {Number of parallel paths, that is paths sharing their end points, to include in expand_path, 1 by default.}
    option -analysis_scenario -takes value \
           -detail {Constraint scenario used for timing analysis, Primary by default.}
    option -tdpr_scenario -takes value \
           -detail {Constraint scenario used for timing-driven place-and-route, Primary by default.}
    option -reset \
           -detail {Reset all options to their default values, leaving the analysis and TDPR scenarios unchanged.}

    form Default {set_options ?-max_opcond value? ?-min_opcond value? ?-interclockdomain_analysis value? ?-use_bibuf_loopbacks value? ?-enable_recovery_removal_checks value? ?-break_at_async value? ?-filter_when_slack_below value? ?-filter_when_slack_above value? ?-remove_slack_filters? ?-limit_max_paths value? ?-expand_clock_network value? ?-expand_parallel_paths value? ?-analysis_scenario value? ?-tdpr_scenario value? ?-reset?}

    hover {
        summary {Set the SmartTime options used for timing analysis.}
        synopsis {set_options ?-max_opcond value? ?-min_opcond value? ?-interclockdomain_analysis value? ?-use_bibuf_loopbacks value? ?-enable_recovery_removal_checks value? ?-break_at_async value? ?-filter_when_slack_below value? ?-filter_when_slack_above value? ?-remove_slack_filters? ?-limit_max_paths value? ?-expand_clock_network value? ?-expand_parallel_paths value? ?-analysis_scenario value? ?-tdpr_scenario value? ?-reset?}
        description {Sets the same parameters the SmartTime Options dialog box exposes; some of them, notably -tdpr_scenario, also affect timing-driven place-and-route (SmartFusion2, IGLOO2, and RTG4 only, the other families using st_set_options). Use save to write the changed options into the Libero project.}
        returns {Not documented in the command reference.}
        example {set_options -max_opcond {best} -min_opcond {best}
set_options -tdpr_scenario {My_TDPR_Scenario}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_root {
    arity 1

    form Default {set_root module_name}

    hover {
        summary {Set the specified module as the root.}
        synopsis {set_root module_name}
        description {Makes the named module the root of the design hierarchy for the project.}
        returns {The guide does not document a return value.}
        example {set_root mux8}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command set_user_lib_options {
    arity 0..

    option -name -takes value -detail {Name of your user library.}
    option -path -takes path -detail {Pathname of your user library.}
    option -option -takes value \
           -values {do_not_compile refresh compile recompile refresh_and_compile} -closed \
           -detail {Sets your default compile options on your user library.}

    form Default {set_user_lib_options -name value -path path -option value}

    hover {
        summary {Set your user library options during simulation.}
        synopsis {set_user_lib_options -name value -path path -option value}
        description {Names a custom simulation library, its path, and how it is treated at simulation time. If you do not use a custom library these options are not available.}
        returns {The guide does not document a return value.}
        example {set_user_lib_options -name {test1} -path {c:/msemi_des_files/libraries/test1} -option {do_not_compile}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_add_new_scenario {
    arity 0..

    option -name -takes value -detail {Specifies the name of the new scenario.}
    option -description -takes value -detail {Specifies the description of the new scenario.}
    option -mode -takes value \
           -detail {Specifies one operating mode and its duration for the scenario, written as operating_mode:duration (repeatable).}

    form Default {smartpower_add_new_scenario ?-name value? ?-description value? ?-mode operating_mode:duration...?}

    hover {
        summary {Create a new SmartPower scenario.}
        synopsis {smartpower_add_new_scenario ?-name value? ?-description value? ?-mode operating_mode:duration...?}
        description {Creates a new power scenario, naming it with -name and describing it with -description. Each -mode gives one operating mode and the duration it contributes to the scenario, written as operating_mode:duration, and the option is repeated once per mode in the sequence.}
        returns {The empty string.}
        example {smartpower_add_new_scenario -name "MyScenario" -mode "Custom_1:50.00" \
    "Custom_2:25.00" -mode "Active:25.00"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_add_pin_in_domain {
    arity 0..

    option -pin_name -takes pin_name -detail {Specifies the name of the pin to add to the domain.}
    option -pin_type -takes value -values {clock data} -closed \
           -detail {Specifies the type of the pin to add, either a clock pin or a data pin.}
    option -domain_name -takes domain_name \
           -detail {Specifies the name of the existing domain in which to add the specified pin.}
    option -domain_type -takes value -values {clock set} -closed \
           -detail {Specifies the type of domain in which to add the specified pin, either a clock domain or a set domain.}

    form Default {smartpower_add_pin_in_domain ?-pin_name pin_name? ?-pin_type value? ?-domain_name domain_name? ?-domain_type value?}

    hover {
        summary {Add a pin into a clock or set domain.}
        synopsis {smartpower_add_pin_in_domain ?-pin_name pin_name? ?-pin_type value? ?-domain_name domain_name? ?-domain_type value?}
        description {Adds the pin named by -pin_name, of the kind named by -pin_type, into the clock or set domain named by -domain_name and -domain_type. The domain must already exist and the pin must exist in the design.}
        returns {The empty string.}
        example {smartpower_add_pin_in_domain -pin_name {XCMP3/U0/U1:Y} -pin_type {clock} \
    -domain_name {clk1} -domain_type {clock}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_battery_settings {
    arity 0..

    option -capacity -takes decimal_value \
           -detail {Specifies the battery capacity in mA*Hours as a positive decimal (required).}

    form Default {smartpower_battery_settings -capacity decimal_value}

    hover {
        summary {Set the battery capacity used by SmartPower.}
        synopsis {smartpower_battery_settings -capacity decimal_value}
        description {Sets the battery capacity, in mA*Hours, that SmartPower uses to compute the battery life of the design. The value must be a positive decimal.}
        returns {This command does not return a value.}
        example {smartpower_battery_settings -capacity {1800}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_change_clock_statistics {
    arity 0..

    option -domain_name -takes value \
           -detail {Specifies the domain name in which to initialize frequencies and probabilities.}
    option -clocks_freq -takes value \
           -detail {Specifies the user input frequency in Hz, KHz, or MHz for all clocks.}
    option -clocks_proba -takes value \
           -detail {Specifies the user input probability in percent for all clocks.}
    option -registers_freq -takes value \
           -detail {Specifies the user input frequency in Hz, KHz, or MHz for all registers, or a toggle rate in percent when no unit is given and toggle rate is active.}
    option -registers_proba -takes value \
           -detail {Specifies the user input probability in percent for all registers.}
    option -set_reset_freq -takes value \
           -detail {Specifies the user input frequency in Hz, KHz, or MHz for all set/reset nets, or a toggle rate in percent when no unit is given and toggle rate is active.}
    option -set_reset_proba -takes value \
           -detail {Specifies the user input probability in percent for all set/reset nets.}
    option -primaryinputs_freq -takes value \
           -detail {Specifies the user input frequency in Hz, KHz, or MHz for all primary inputs, or a toggle rate in percent when no unit is given and toggle rate is active.}
    option -primaryinputs_proba -takes value \
           -detail {Specifies the user input probability in percent for all primary inputs.}
    option -combinational_freq -takes value \
           -detail {Specifies the user input frequency in Hz, KHz, or MHz for all combinational outputs, or a toggle rate in percent when no unit is given and toggle rate is active.}
    option -combinational_proba -takes value \
           -detail {Specifies the user input probability in percent for all combinational outputs.}

    form Default {smartpower_change_clock_statistics ?-domain_name value? ?-clocks_freq value? ?-clocks_proba value? ?-registers_freq value? ?-registers_proba value? ?-set_reset_freq value? ?-set_reset_proba value? ?-primaryinputs_freq value? ?-primaryinputs_proba value? ?-combinational_freq value? ?-combinational_proba value?}

    hover {
        summary {Change the default frequencies and probabilities for a specific domain.}
        synopsis {smartpower_change_clock_statistics ?-domain_name value? ?-clocks_freq value? ?-clocks_proba value? ?-registers_freq value? ?-registers_proba value? ?-set_reset_freq value? ?-set_reset_proba value? ?-primaryinputs_freq value? ?-primaryinputs_proba value? ?-combinational_freq value? ?-combinational_proba value?}
        description {Sets the default frequency and probability applied to the clocks, registers, set/reset nets, primary inputs and combinational outputs of the clock domain named by -domain_name. A frequency value carries a Hz, KHz or MHz unit; without a unit it is read as a toggle rate in percent when toggle rate is active, and as a frequency otherwise. This command is associated with the functionality of the Initialize frequencies and probabilities dialog box.}
        returns {The empty string.}
        example {smartpower_change_clock_statistics -domain_name {my_domain} -clocks_freq {10 MHz} \
    -clocks_proba {20} -registers_freq {10 MHz} -registers_proba {20} \
    -set_reset_freq {10 MHz} -set_reset_proba {20} -primaryinputs_freq {10 MHz} \
    -primaryinputs_proba {20} -combinational_freq {10 MHz} -combinational_proba {20}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_change_setofpin_statistics {
    arity 0..

    option -domain_name -takes value \
           -detail {Specifies the domain name in which to initialize data frequencies and probabilities.}
    option -data_freq -takes value \
           -detail {Specifies the user input data frequency in Hz, KHz, or MHz for all sets of pins.}
    option -data_proba -takes value \
           -detail {Specifies the user input data probability in percent for all sets of pins.}

    form Default {smartpower_change_setofpin_statistics ?-domain_name value? ?-data_freq value? ?-data_proba value?}

    hover {
        summary {Change the default frequencies and probabilities for a specific set.}
        synopsis {smartpower_change_setofpin_statistics ?-domain_name value? ?-data_freq value? ?-data_proba value?}
        description {Sets the default data frequency and data probability applied to every pin of the set domain named by -domain_name. This command is associated with the functionality of the Initialize frequencies and probabilities dialog box.}
        returns {The empty string.}
        example {smartpower_change_setofpin_statistics -domain_name {my_domain} \
    -data_freq {10 MHz} -data_proba {20}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_commit {
    arity 0

    form Default {smartpower_commit}

    hover {
        summary {Save the SmartPower changes to the design file.}
        synopsis {smartpower_commit}
        description {Saves the changes made in SmartPower to the design (.adb) file. The command takes no arguments.}
        returns {The empty string.}
        example {smartpower_commit}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_compute_vectorless {
    arity 0

    form Default {smartpower_compute_vectorless}

    hover {
        summary {Run a vectorless analysis of the current operating mode.}
        synopsis {smartpower_compute_vectorless}
        description {Executes a vectorless analysis of the current operating mode, deriving frequency and probability information for the design without a simulation file. The command takes no arguments.}
        returns {The empty string.}
        example {smartpower_compute_vectorless}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_create_domain {
    arity 0..

    option -domain_type -takes value -values {clock set} -closed \
           -detail {Specifies the type of domain to create, either a clock domain or a set domain.}
    option -domain_name -takes domain_name -detail {Specifies the name of the new domain.}

    form Default {smartpower_create_domain ?-domain_type value? ?-domain_name domain_name?}

    hover {
        summary {Create a new clock or set domain.}
        synopsis {smartpower_create_domain ?-domain_type value? ?-domain_name domain_name?}
        description {Creates a new SmartPower domain of the type given by -domain_type under the name given by -domain_name. The domain name cannot be the name of an existing domain, and the domain type must be either clock or set.}
        returns {The empty string.}
        example {smartpower_create_domain -domain_type {clock} -domain_name {clk2}
smartpower_create_domain -domain_type {set} -domain_name {myset}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_edit_scenario {
    arity 0..

    option -name -takes value -detail {Specifies the name of the scenario.}
    option -description -takes value -detail {Specifies the description of the scenario.}
    option -mode -takes value \
           -detail {Specifies the operating mode and duration for the specified scenario, written as operating_mode:duration.}
    option -new_name -takes value -detail {Specifies the new name for the scenario.}

    form Default {smartpower_edit_scenario ?-name value? ?-description value? ?-mode operating_mode:duration? ?-new_name value?}

    hover {
        summary {Edit an existing SmartPower scenario.}
        synopsis {smartpower_edit_scenario ?-name value? ?-description value? ?-mode operating_mode:duration? ?-new_name value?}
        description {Edits the scenario named by -name, replacing its description, its operating mode and duration, or its name. The -new_name option renames the scenario.}
        returns {The empty string.}
        example {smartpower_edit_scenario -name myscenario -new_name finalscenario}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_import_vcd {
    arity 0..

    side_effect FileIo -reads

    option -file -takes value \
           -detail {Specifies the path to the VCD file to import (required).}
    option -opmode -takes value \
           -detail {Specifies the operating mode in which the VCD is imported, Active by default, and the mode is created if it does not exist.}
    option -with_vectorless -takes value -values {TRUE FALSE} \
           -detail {Specifies how signals not annotated by the VCD get frequency and probability information, TRUE using the vectorless analysis and FALSE using an average value computed from the VCD.}
    option -partial_parse -takes value -values {FALSE TRUE} \
           -detail {Enables partial parsing of the VCD, in which case -start_time and -end_time must also be given.}
    option -start_time -takes value \
           -detail {Specifies the starting timestamp of the VCD extraction as a positive decimal in nanoseconds, lower than -end_time and lower than the last timestamp in the VCD file.}
    option -end_time -takes value \
           -detail {Specifies the end timestamp of the VCD extraction as a positive decimal in nanoseconds, higher than -start_time.}
    option -auto_detect_top_level_name -takes value -values {TRUE FALSE} \
           -detail {Enables auto detection of the top level name in the VCD file, in which case -top_level_name need not be given.}
    option -top_level_name -takes value \
           -detail {Specifies the full hierarchical name of the instance of the design in the VCD file.}
    option -glitch_filtering -takes value -values {false auto true} \
           -detail {Controls glitch filtering, where auto uses a predefined threshold based on the family, true requires -glitch_threshold, and false disables filtering.}
    option -glitch_threshold -takes value \
           -detail {Specifies, as a positive integer, the threshold in ps below which glitches are filtered out.}
    ;# NOTE(libero): -stop_time appears only in the guide's Syntax block for this
    ;# command; the parameter table and the Usage table do not describe it, so no
    ;# value domain is asserted for it here.
    option -stop_time -takes value \
           -detail {Specifies a decimal stop time for the VCD extraction, listed in the guide's syntax only.}

    form Default {smartpower_import_vcd -file value ?-opmode value? ?-with_vectorless value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name value? ?-glitch_filtering value? ?-glitch_threshold value? ?-stop_time value?}

    hover {
        summary {Import a simulator-generated VCD file into SmartPower.}
        synopsis {smartpower_import_vcd -file value ?-opmode value? ?-with_vectorless value? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name value? ?-glitch_filtering value? ?-glitch_threshold value? ?-stop_time value?}
        description {Imports a VCD file generated by a simulation tool, from which SmartPower extracts the frequency and probability information for the annotated signals. The import can be restricted to a window of the simulation with -partial_parse together with -start_time and -end_time, targeted at one operating mode with -opmode, pointed at the design instance with -auto_detect_top_level_name or -top_level_name, and cleaned of short pulses with -glitch_filtering and -glitch_threshold.}
        returns {This command does not return a value.}
        example {smartpower_import_vcd -file "../../simulation/power.vcd"
smartpower_import_vcd -file "../../simulation/power.vcd" -partial_parse TRUE \
    -start_time 1000000 -end_time 2000000 -opmode "power_1ms_to_2ms"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_init_do {
    arity 0..

    option -with -takes value -values {vectorless fixed} -closed \
           -detail {Initializes frequencies and probabilities either with vectorless analysis or with fixed values (required).}
    option -opmode -takes value \
           -detail {Specifies the mode in which to initialize frequencies and probabilities, either Active or Flash*Freeze.}
    option -clocks -takes value -values {true false} \
           -detail {Initializes frequencies and probabilities for all clocks (required).}
    option -registers -takes value -values {true false} \
           -detail {Initializes frequencies and probabilities for all registers (required).}
    option -set_reset -takes value -values {true false} \
           -detail {Initializes frequencies and probabilities for all set/reset nets (required).}
    option -primaryinputs -takes value -values {true false} \
           -detail {Initializes frequencies and probabilities for all primary inputs (required).}
    option -combinational -takes value -values {true false} \
           -detail {Initializes frequencies and probabilities for all combinational outputs (required).}
    option -enables -takes value -values {true false} \
           -detail {Initializes frequencies and probabilities for all enable sets of pins (required).}
    option -othersets -takes value -values {true false} \
           -detail {Initializes frequencies and probabilities for all other sets of pins (required).}

    form Default {smartpower_init_do -with value ?-opmode value? -clocks value -registers value -set_reset value -primaryinputs value -combinational value -enables value -othersets value}

    hover {
        summary {Initialize the frequencies and probabilities of the design and select the mode to initialize.}
        synopsis {smartpower_init_do -with value ?-opmode value? -clocks value -registers value -set_reset value -primaryinputs value -combinational value -enables value -othersets value}
        description {Initializes the frequencies and probabilities for clocks, registers, set/reset nets, primary inputs, combinational outputs, enables and other sets of pins, and selects the mode the initialization applies to. The -with option chooses between vectorless analysis and fixed values, and each per-category option turns that category's initialization on or off. This command is associated with the functionality of the Initialize frequencies and probabilities dialog box.}
        returns {The empty string.}
        example {smartpower_init_do -with {vectorless} -opmode {my_mode} -clocks {true} \
    -registers {true} -primaryinputs {true} -combinational {true} \
    -enables {true} -othersets {true}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_init_set_clocks_options {
    arity 0..

    option -with_clock_constraints -takes value -values {true false} \
           -detail {Turns on or off initializing the clock frequencies with the frequency constraints from SmartTime.}
    option -with_default_values -takes value -values {true false} \
           -detail {Turns on or off initializing the clock frequencies with a user input default value.}
    option -freq -takes value -detail {Specifies the user input frequency in Hz, KHz, or MHz.}
    option -duty_cycle -takes value -detail {Specifies the user input duty cycle in percent.}

    form Default {smartpower_init_set_clocks_options ?-with_clock_constraints value? ?-with_default_values value? ?-freq value? ?-duty_cycle value?}

    hover {
        summary {Initialize the clock frequency options of all clock domains.}
        synopsis {smartpower_init_set_clocks_options ?-with_clock_constraints value? ?-with_default_values value? ?-freq value? ?-duty_cycle value?}
        description {Sets the options used when the clock frequencies of every clock domain are initialized, choosing between the SmartTime frequency constraints and the user default value given by -freq and -duty_cycle. It applies to a preceding smartpower_init_do run with -clocks true, and is associated with the functionality of the Initialize frequencies and probabilities dialog box.}
        returns {The empty string.}
        example {smartpower_init_set_clocks_options -with_clock_constraints {true} \
    -with_default_values {true} -freq {10 MHz} -duty_cycle {20}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_init_set_combinational_options {
    arity 0..

    option -freq -takes value \
           -detail {Specifies the user input frequency in Hz, KHz, or MHz, or a toggle rate in percent when no unit is given and toggle rate is active.}
    option -proba -takes value -detail {Specifies the user input probability in percent.}

    form Default {smartpower_init_set_combinational_options ?-freq value? ?-proba value?}

    hover {
        summary {Initialize the frequency and probability of all combinational outputs.}
        synopsis {smartpower_init_set_combinational_options ?-freq value? ?-proba value?}
        description {Sets the frequency and probability used when all combinational outputs are initialized, applying to a preceding smartpower_init_do run with -combinational true. Without a unit the -freq value is read as a toggle rate in percent when toggle rate is active, and as a frequency otherwise.}
        returns {The empty string.}
        example {smartpower_init_set_combinational_options -freq {10 MHz} -proba {20}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_init_set_enables_options {
    arity 0..

    option -freq -takes value -detail {Specifies the user input frequency in Hz, KHz, or MHz.}
    option -proba -takes value -detail {Specifies the user input probability in percent.}

    form Default {smartpower_init_set_enables_options ?-freq value? ?-proba value?}

    hover {
        summary {Initialize the clock frequency of all enable clocks.}
        synopsis {smartpower_init_set_enables_options ?-freq value? ?-proba value?}
        description {Sets the frequency and probability used when all enable clocks are initialized, applying to a preceding smartpower_init_do run with -enables true. This command is associated with the functionality of the Initialize frequencies and probabilities dialog box.}
        returns {The empty string.}
        example {smartpower_init_set_enables_options -freq {10 MHz} -proba {20}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_init_set_primaryinputs_options {
    arity 0..

    option -freq -takes value \
           -detail {Specifies the user input frequency in Hz, KHz, or MHz, or a toggle rate in percent when no unit is given and toggle rate is active.}
    option -proba -takes value -detail {Specifies the user input probability in percent.}

    form Default {smartpower_init_set_primaryinputs_options ?-freq value? ?-proba value?}

    hover {
        summary {Initialize the frequency and probability of all primary inputs.}
        synopsis {smartpower_init_set_primaryinputs_options ?-freq value? ?-proba value?}
        description {Sets the frequency and probability used when all primary inputs are initialized, applying to a preceding smartpower_init_do run with -primaryinputs true. Without a unit the -freq value is read as a toggle rate in percent when toggle rate is active, and as a frequency otherwise.}
        returns {The empty string.}
        example {smartpower_init_set_primaryinputs_options -freq {10 MHz} -proba {20}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_init_set_registers_options {
    arity 0..

    option -freq -takes value \
           -detail {Specifies the user input frequency in Hz, KHz, or MHz, or a toggle rate in percent when no unit is given and toggle rate is active.}
    option -proba -takes value -detail {Specifies the user input probability in percent.}

    form Default {smartpower_init_set_registers_options ?-freq value? ?-proba value?}

    hover {
        summary {Initialize the frequency and probability of all register outputs.}
        synopsis {smartpower_init_set_registers_options ?-freq value? ?-proba value?}
        description {Sets the frequency and probability used when all register outputs are initialized, applying to a preceding smartpower_init_do run with -registers true. Without a unit the -freq value is read as a toggle rate in percent when toggle rate is active, and as a frequency otherwise.}
        returns {The empty string.}
        example {smartpower_init_set_registers_options -freq {10 MHz} -proba {20}}
