# tcl-lsp — bundled SpecTcl loadable: Microchip (Microsemi) Libero SoC,
# the project, flow, SmartTime, SmartPower and SmartDebug Tcl surface.
#
# This pack IS the source of truth for these commands. Authored from the
# vendor's own "Libero SoC Tcl Commands Reference Guide" (v11.8 SP3),
# supplied by the requester of issue #1560's follow-on EDA coverage work.
# Family-scoped behaviour (SmartFusion2/IGLOO2/RTG4 vs the classic
# SmartFusion/IGLOO/ProASIC3/Fusion flows) is unioned into one block per
# command, with the differences recorded in the option details and
# descriptions rather than as separate specs.
#
# The SmartTime constraint commands that are portable SDC (create_clock,
# set_false_path, get_ports, ...) are deliberately NOT declared here: the
# shared `sdc_base` pack rides along with the microchip-libero-eda-tcl
# profile and owns them, exactly as it does for every other EDA shell.
# This pack carries only the Libero-proprietary surface (list_*/remove_*
# constraint editing, scenarios, st_*/timer_*, smartpower_*, SmartDebug,
# project and flow commands).
#
# Discovery: the **bundled** tier — `specs/` beside the server executable, or
# wherever $TCL_LSP_SPEC_PACK_DIR points (rust/tcl-spectcl/src/discovery.rs).
# Edit this file to change the specs; there is no generator to re-run.
# Syntax: docs/design/spec-dsl-examples/README.md.

speclib eda_microchip 2.0 {

display_name {Microchip Libero SoC}

environment microchip-libero-eda-tcl {
    display_name    {Microchip Libero EDA Tcl}
    core            tcl 8.5
    version_ceiling 8.5
    editor_identity tcl-microchip
    ambient         sdc keyed SdcVersion
    ambient         upf keyed UpfVersion
    ambient         libero keyed ToolVersion
    help_terms      {microchip microsemi actel libero smartfusion igloo proasic}
}

default available {tcl 8.4-}
default required_package libero

command add_file_to_library {
    arity 0..

    option -library -takes name \
           -detail {Name of the library where you wish to add your file (required).}
    option -file -takes name \
           -detail {New name of the file you wish to add, which must be a full pathname (required).}

    form Default {add_file_to_library -library name -file name}

    hover {
        summary {Add a file to a library in your project.}
        synopsis {add_file_to_library -library name -file name}
        description {Adds an existing file, given by its full pathname, to a named VHDL library of the current Libero SoC project.}
        returns {The guide does not document a return value.}
        example {add_file_to_library -library my_lib -file ./project/hdl/foo.vhd}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command add_library {
    arity 0..

    option -library -takes name -detail {Name of your new library (required).}

    form Default {add_library -library name}

    hover {
        summary {Add a VHDL library to your project.}
        synopsis {add_library -library name}
        description {Creates a new VHDL library with the given name in the current Libero SoC project.}
        returns {The guide does not document a return value.}
        example {add_library -library my_lib}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command add_modelsim_path {
    arity 0..

    option -lib -takes library_name -detail {Name of the library you want to add (required).}
    option -path -takes library_path -detail {Path to the library that you want to add.}
    option -remove -takes library_name -detail {Name of the library you want to remove, if any.}

    form Default {add_modelsim_path -lib library_name ?-path library_path? ?-remove library_name?}

    hover {
        summary {Add a ModelSim simulation library to your project.}
        synopsis {add_modelsim_path -lib library_name ?-path library_path? ?-remove library_name?}
        description {Registers a ModelSim simulation library with the project, optionally naming the directory the library lives in and a library to remove at the same time.}
        returns {The guide does not document a return value.}
        example {add_modelsim_path -lib msim_update2 -path c:/modelsim/libraries -remove msim_update1}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command add_probe {
    arity 0..

    option -net -takes net_name \
           -detail {Name of the net to probe; HARDWIRED, POWER and INTRINSIC nets cannot be probed (required).}
    option -pin -takes pin_name \
           -detail {Name of the package pin at which to put the probed net; if unspecified the net is routed to any free package pin.}
    option -port -takes port_name \
           -detail {Name of the port being added; if unspecified the default value is PROBE_n.}
    option -assign_to_used_pin -takes value -values {TRUE FALSE} -closed \
           -detail {Probes a net on an already used pin, disconnecting the net on the existing pin; if unspecified the net can only be routed on an unused pin.}

    form Default {add_probe -net net_name ?-pin pin_name? ?-port port_name? ?-assign_to_used_pin TRUE|FALSE?}

    hover {
        summary {Add a probe to an internal net in the design.}
        synopsis {add_probe -net net_name ?-pin pin_name? ?-port port_name? ?-assign_to_used_pin TRUE|FALSE?}
        description {Adds a probe to an internal net, using the original name from the optimized netlist in the design. Layout must be complete before this command is used, and it must be used together with generate_probes to produce a probed ADB file.}
        returns {The guide documents no return value.}
        example {add_probe -net Count8_0/INV_0_Y -assign_to_used_pin {FALSE} -pin {7} -port {PROBE_1}
generate_probes -save test1.adb}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command add_probe_insertion_point {
    arity 0..

    option -net -takes net_name \
           -detail {Name of the net used for probe insertion (required).}
    option -driver -takes driver \
           -detail {Driver of the net (required).}
    option -pin -takes package_pin_name \
           -detail {Package pin name, the I/O the net is routed to during probe insertion (required).}
    option -port -takes port_name \
           -detail {User-specified name for the probe insertion point (required).}

    form Default {add_probe_insertion_point -net net_name -driver driver -pin package_pin_name -port port_name}

    hover {
        summary {Add a probe point to be connected to a user-specified I/O for probe insertion.}
        synopsis {add_probe_insertion_point -net net_name -driver driver -pin package_pin_name -port port_name}
        description {SmartDebug command that adds a probe point for the probe insertion flow: the named net, driven by the given driver, is routed during probe insertion to the named package pin and exposed under the user-supplied port name. Run program_probe_insertion to execute the insertion flow on the selected nets. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {add_probe_insertion_point -net {count_out_c[0]} \
    -driver {Counter_8bit_0_count_out[0]:Q} -pin {H5} -port {Probe_Insert0}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command add_profile {
    arity 0..

    option -name -takes profilename -detail {Name of your new profile (required).}
    option -type -takes value -values {synthesis simulation stimulus flashpro} -closed \
           -detail {Profile type: a synthesis, simulation, stimulus, or FlashPro tool profile (required).}
    option -tool -takes profiletool -detail {Name of the tool you are adding to the profile (required).}
    option -location -takes tool_location \
           -detail {Full pathname to the location of the tool you are adding to the profile (required).}
    option -args -takes tool_parameters -detail {Profile parameters, if any.}
    option -batch -takes value -values {TRUE FALSE} -closed \
           -detail {Runs the profile in batch mode when TRUE.}

    form Default {add_profile -name profilename -type value -tool profiletool -location tool_location ?-args tool_parameters? ?-batch value?}

    hover {
        summary {Add a tool profile and make it the active profile for that tool type.}
        synopsis {add_profile -name profilename -type value -tool profiletool -location tool_location ?-args tool_parameters? ?-batch value?}
        description {Sets the same values as the Add or Edit Profile dialog box. The newly added profile becomes the active tool profile for the specified type of tool.}
        returns {The guide does not document a return value.}
        example {add_profile -name myflashpro -type flashpro -tool flashpro.exe -location c:/programs/actel/flashpro/bin/flashpro.exe -batch FALSE}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command add_to_probe_group {
    arity 0..

    option -name -takes probe_name \
           -detail {Specifies one or more probes to add, prefixed with the bus or group name when the probe is in a bus or group (required, repeatable).}
    option -group -takes group_name \
           -detail {Specifies the name of the probe group to add the probes to (required).}

    form Default {add_to_probe_group -name probe_name... -group group_name}

    hover {
        summary {Add the specified probe points to a probe group.}
        synopsis {add_to_probe_group -name probe_name... -group group_name}
        description {SmartDebug command that associates one or more existing active probe points with the probe group named by -group. Repeat -name to add several probes in one call. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {add_to_probe_group -name out[5]:out[5]:Q \
    -name grp1.out[3]:out[3]:Q \
    -group my_new_grp}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command are_all_source_files_current {
    arity 0

    form Default {are_all_source_files_current}

    hover {
        summary {Report whether every source file is current.}
        synopsis {are_all_source_files_current}
        description {Audits all source files and determines whether they are out of date or have not been imported into the workspace. This command ignores the Audit settings in the ADB file, and returns an error if any argument is passed.}
        returns {1 if all source files are current; 0 if they are not.}
        example {are_all_source_files_current}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command associate_stimulus {
    arity 0..

    option -file -takes name \
           -detail {Name of the file to which you want to associate your stimulus files (repeatable).}
    option -mode -takes value -values {new add remove} -closed \
           -detail {Whether you are creating a new stimulus association, adding to one, or removing one.}
    option -module -takes value -detail {Name of the module (required).}

    form Default {associate_stimulus ?-file name...? ?-mode value? -module value}

    hover {
        summary {Associate a stimulus file in your project.}
        synopsis {associate_stimulus ?-file name...? ?-mode value? -module value}
        description {Creates, extends, or removes the association between stimulus files and a module of the project.}
        returns {The guide does not document a return value.}
        example {associate_stimulus -file stim.vhd -mode new -module stimulus}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command backannotate {
    arity 0..

    option -name -takes file_name \
           -detail {Name of the file to write; the .sdf extension is appended when it is not given.}
    option -format -takes format_type -values {SDF} -closed \
           -detail {Format of the back-annotation file; only SDF is available.}
    option -language -takes language -values {VHDL93 VERILOG} -closed \
           -detail {Naming style used in the SDF file, VHDL-93 or Verilog.}
    option -dir -takes directory_name \
           -detail {Directory into which all the files are extracted.}
    option -netlist \
           -detail {Forces a netlist, in either Verilog or VHDL, to be written.}
    option -pin \
           -detail {Exports the pin file, named by appending the .pin extension to the design name.}
    option -use_emd \
           -detail {Enables the Export Enhanced Min Delays for Best Case option in the back-annotated file.}

    side_effect FileIo -writes

    form Default {backannotate ?-name file_name? ?-format format_type? ?-language language? ?-dir directory_name? ?-netlist? ?-pin? ?-use_emd?}

    hover {
        summary {Export an SDF file, and optionally its netlist, after layout.}
        synopsis {backannotate ?-name file_name? ?-format format_type? ?-language language? ?-dir directory_name? ?-netlist? ?-pin? ?-use_emd?}
        description {Equivalent to the Back-Annotate command on the Tools menu: exports an SDF file after layout together with the corresponding VHDL or Verilog netlist, which are used for back-annotated timing simulation. Best practice is to export both the SDF and the corresponding netlist to avoid name conflicts in the simulation tool. Layout must have completed, otherwise the command fails.}
        returns {The guide documents no return value; a failure is a catchable Tcl error.}
        example {backannotate -dir {..\design} -name "fanouttest_ba.sdf" -format "SDF" -language "VERILOG" -netlist}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command change_link_source {
    arity 0..

    option -file -takes filename -detail {Name of the linked file you want to change (required).}
    option -path -takes new_source_path -detail {Location of the file you want to link to (required).}

    form Default {change_link_source -file filename -path new_source_path}

    hover {
        summary {Change the source of a linked file in your project.}
        synopsis {change_link_source -file filename -path new_source_path}
        description {Repoints an existing link in the project so that it refers to a different file on disk.}
        returns {The guide does not document a return value.}
        example {change_link_source -file sim1.vhd -path c:/microsemi/link_source/simulation_test.vhd}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command check_constraints {
    arity 0

    form Default {check_constraints}

    hover {
        summary {Check all timing constraints in the current scenario for validity.}
        synopsis {check_constraints}
        description {Checks every timing constraint held in the current timing scenario, performing the same checks that are made when a constraint is entered through SDC or Tcl. This is the SmartFusion2, IGLOO2, and RTG4 spelling; the SmartFusion, IGLOO, ProASIC3, and Fusion families spell it check_timing_constraints.}
        returns {Not documented in the command reference.}
        example {check_constraints}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command check_fdc_constraints {
    arity 0..

    option -tool -takes tool_name -values {synthesis} -closed \
           -detail {Names the tool whose associated FDC files are checked; only synthesis is documented (required).}

    form Default {check_fdc_constraints -tool {synthesis}}

    hover {
        summary {Check the FDC constraint files associated with the Synthesis tool.}
        synopsis {check_fdc_constraints -tool {synthesis}}
        description {Checks FDC constraint files associated with the Synthesis tool. This command is for the Enhanced Constraint Flow only, and is supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {0 on success and 1 on failure.}
        example {check_fdc_constraints -tool {synthesis}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command check_flash_memory {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}
    option -block -takes integer_value \
           -detail {Specifies the location of the block for the memory check.}
    option -client -takes client_name \
           -detail {Name of the client for the memory check.}
    option -startpage -takes integer_value \
           -detail {Start page of the page range; requires -endpage and -block.}
    option -endpage -takes integer_value \
           -detail {End page of the page range; requires -startpage and -block.}
    option -access -takes access -values {all status data} -closed \
           -detail {Specifies which NVM information to check: page status, data, or both, defaulting to all.}
    option -show -takes show -values {summary pages} -closed \
           -detail {Specifies the output level, a summary for all checked pages or the results for each checked page.}
    option -file -takes filename \
           -detail {Name of the output file for the memory check.}

    form Default {check_flash_memory ?-name device_name? ?-block integer_value? ?-client client_name? ?-startpage integer_value? ?-endpage integer_value? ?-access all|status|data? ?-show summary|pages? ?-file filename?}

    hover {
        summary {Run diagnostics on flash memory page status and page data.}
        synopsis {check_flash_memory ?-name device_name? ?-block integer_value? ?-client client_name? ?-startpage integer_value? ?-endpage integer_value? ?-access all|status|data? ?-show summary|pages? ?-file filename?}
        description {SmartDebug command that checks NVM pages for ECC2 errors in the page status information and in the page data, and reports out-of-range write counts. At a minimum specify either -client or the combination of -startpage, -endpage and -block. Use recover_flash_memory to repair pages reported as corrupted. (SmartFusion and Fusion only.)}
        returns {The empty string.}
        example {check_flash_memory -startpage 0 -endpage 2 -block 0
check_flash_memory -client {DS8bit} -file {checkFlashMemory.log}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command check_hdl {
    arity 0..

    option -file -takes filename -detail {Name of the HDL file you want to check (required).}

    form Default {check_hdl -file filename}

    hover {
        summary {Check the HDL in the specified file.}
        synopsis {check_hdl -file filename}
        description {Runs the HDL checker over one source file of the project.}
        returns {The guide does not document a return value.}
        example {check_hdl -file hdl1.vhd}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command check_ndc_constraints {
    arity 0..

    option -tool -takes tool_name -values {synthesis} -closed \
           -detail {Names the tool whose associated NDC files are checked; only synthesis is documented (required).}

    form Default {check_ndc_constraints -tool {synthesis}}

    hover {
        summary {Check the NDC constraint files associated with the Synthesis tool.}
        synopsis {check_ndc_constraints -tool {synthesis}}
        description {Checks NDC constraint files associated with the Synthesis tool, for the Enhanced Constraint Flow only. NDC constraints are used to optimize the post-synthesis netlist with the Libero SoC Compile engine. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {The guide does not document a return value.}
        example {check_ndc_constraints -tool {synthesis}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command check_pdc_constraints {
    arity 0..

    option -tool -takes tool_name -values {designer} -closed \
           -detail {Names the tool whose associated PDC files are checked; only designer is documented (required).}

    form Default {check_pdc_constraints -tool {designer}}

    hover {
        summary {Check the PDC constraint files associated with the Place and Route tool.}
        synopsis {check_pdc_constraints -tool {designer}}
        description {Checks PDC constraint files associated with the Libero Place and Route tool. This command is for the Enhanced Constraint Flow only, and is supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {0 on success and 1 on failure.}
        example {check_pdc_constraints -tool {designer}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command check_schematic {
    arity 0..

    option -file -takes filename -detail {Name of the schematic file you want to check (required).}

    form Default {check_schematic -file filename}

    hover {
        summary {Check the schematic in the specified file.}
        synopsis {check_schematic -file filename}
        description {Runs the schematic checker over one schematic file of the project.}
        returns {The guide does not document a return value.}
        example {check_schematic -file schem.2vd}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command check_sdc_constraints {
    arity 0..

    option -tool -takes tool_name -values {synthesis designer timing} -closed \
           -detail {Names the Libero tool whose associated SDC files are checked (required).}

    form Default {check_sdc_constraints -tool {tool_name}}

    hover {
        summary {Check the SDC constraint files associated with a Libero tool.}
        synopsis {check_sdc_constraints -tool {tool_name}}
        description {Checks SDC constraint files associated with the Libero tools designer, synthesis, or timing. This command is for the Enhanced Constraint Flow only, and is supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {0 on success and 1 on failure.}
        example {check_sdc_constraints -tool {timing}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command check_timing_constraints {
    arity 0

    form Default {check_timing_constraints}

    hover {
        summary {Check all timing constraints in the current timing scenario for validity.}
        synopsis {check_timing_constraints}
        description {Checks every timing constraint held in the current timing scenario. This is the SmartFusion, IGLOO, ProASIC3, and Fusion spelling; SmartFusion2, IGLOO2, and RTG4 spell it check_constraints.}
        returns {Not documented in the command reference.}
        example {check_timing_constraints}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command clone_scenario {
    arity 1..

    option -source -takes origin \
           -detail {Existing timing scenario to clone, used with the single-name form (SmartFusion, IGLOO, ProASIC3, and Fusion only).}

    form Default {clone_scenario name ?new_scenario_name | -source origin?}

    hover {
        summary {Create a new timing scenario by duplicating an existing one.}
        synopsis {clone_scenario name ?new_scenario_name | -source origin?}
        description {Creates a timing scenario holding a copy of all constraints in the original scenario and adds it to the list of scenarios; the new name must not already be used by another timing scenario. SmartFusion2, IGLOO2, and RTG4 take the source scenario first and the new name second, while SmartFusion, IGLOO, ProASIC3, and Fusion take the new name first and name the source with -source.}
        returns {Not documented in the command reference.}
        example {clone_scenario primary my_new_scenario}
        example {clone_scenario scenario_A -source {Primary}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command close_design {
    arity 0

    form Default {close_design}

    hover {
        summary {Close the current design.}
        synopsis {close_design}
        description {Closes the current design and brings Designer to a fresh state to work on a new design. Equivalent to selecting the Close command from the File menu. The command takes no arguments.}
        returns {The guide does not document a return value.}
        example {if { [catch { close_design }] } {
    puts "Failed to close design"
} else {
    puts "Design closed successfully"
}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command close_project {
    arity 0

    form Default {close_project}

    hover {
        summary {Close the current Libero SoC project.}
        synopsis {close_project}
        description {Closes the current project in Libero SoC, equivalent to clicking the File menu and choosing Close Project. The command takes no arguments.}
        returns {The guide does not document a return value.}
        example {close_project}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command compare_analog_config {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}
    option -mem_file_dir -takes mem_file_directory \
           -detail {Location of the memory file directory holding the analog block configuration (required).}
    option -file -takes filename \
           -detail {Output file name for the comparison log.}

    form Default {compare_analog_config ?-name device_name? -mem_file_dir mem_file_directory ?-file filename?}

    hover {
        summary {Compare the analog block configurations in the design against the device.}
        synopsis {compare_analog_config ?-name device_name? -mem_file_dir mem_file_directory ?-file filename?}
        description {SmartDebug command that reads the analog block configuration from the memory files in -mem_file_dir and compares it against the actual values in the device. In a typical SoC project the memory file directory is the smartgen folder of the analog block core. (Fusion only.)}
        returns {The empty string.}
        example {compare_analog_config -mem_file_dir {F:/tmp/Analog_Block} \
    -file {compare_analogReport.log}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command compare_flashrom_client {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}
    option -file -takes filename \
           -detail {Optional file name for the FlashROM compare log.}

    form Default {compare_flashrom_client ?-name device_name? ?-file filename?}

    hover {
        summary {Compare the FlashROM configuration in the design against the device.}
        synopsis {compare_flashrom_client ?-name device_name? ?-file filename?}
        description {SmartDebug command that compares the content of the FlashROM configurations in the design against the actual values in the selected device, optionally writing the comparison to a log file. (SmartFusion, IGLOO, ProASIC3 and Fusion.)}
        returns {The empty string.}
        example {compare_flashrom_client -name {A3P250} -file {FlashRomCompReport.log}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command compare_memory_client {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}
    option -block -takes integer_value \
           -detail {Specifies the location of the block for the memory compare; requires -client.}
    option -client -takes client_name \
           -detail {Name of the client for the memory compare (required).}
    option -file -takes filename \
           -detail {Optional file name for the compare log.}

    form Default {compare_memory_client ?-name device_name? ?-block integer_value? -client client_name ?-file filename?}

    hover {
        summary {Compare a memory client in a specific device and block.}
        synopsis {compare_memory_client ?-name device_name? ?-block integer_value? -client client_name ?-file filename?}
        description {SmartDebug command that compares the named memory client against the device, optionally restricted to one block and optionally logged to a file. (SmartFusion and Fusion only.)}
        returns {The empty string.}
        example {compare_memory_client -block 1 -client {DS8bit} -file {F:/tmp/NVMCompReport.log}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command compile {
    arity 0..

    option -pdc_abort_on_error -takes value -values {ON OFF} -closed \
           -detail {Stops the flow when any error is reported while reading the PDC file (ON, the default) or reports such errors as warnings (OFF).}
    option -pdc_eco_display_unmatched_objects -takes value -values {ON OFF} -closed \
           -detail {Reports netlist objects named in PDC that are not found in the current netlist when reading the internal ECO PDC constraints; the default is OFF.}
    option -pdc_eco_max_warnings -takes value \
           -detail {Maximum number of error and warning messages displayed when reading ECO constraints in Compile ECO mode; the default is 10000.}
    option -demote_globals -takes value -values {OFF ON} -closed \
           -detail {Enables or disables demotion of global nets to regular nets; the default is OFF.}
    option -demote_globals_max_fanout -takes value \
           -detail {Maximum fanout a net may have after demotion for automatic demotion to take place; the default is 12.}
    option -promote_globals -takes value -values {ON OFF} -closed \
           -detail {Enables or disables promotion of nets to the global clock network; the default is OFF.}
    option -promote_globals_min_fanout -takes value \
           -detail {Minimum fanout a net must have to be promoted to a global; the default is 200.}
    option -promote_globals_max_limit -takes value \
           -detail {Maximum number of nets automatically promoted to global, not counting globals coming from the netlist or the PDC file; the default is 0.}
    option -localclock_max_shared_instances -takes value \
           -detail {Maximum number of instances that two LocalClock nets assigned to disjoint regions may share for legalization to be performed, in the range 0 to 1000 with a default of 12, where 0 disables legalization.}
    option -localclock_buffer_tree_max_fanout -takes value \
           -detail {Maximum fanout used during buffer insertion for clock legalization, in the range 0 to 1000 with a default of 12, where 0 prevents legalization.}
    option -combine_register -takes value -values {ON OFF} -closed \
           -detail {Combines registers at the I/O into I/O registers; the default is OFF.}
    option -delete_buffer_tree -takes value -values {ON OFF} -closed \
           -detail {Enables or disables deletion of the buffer and inverter tree on global signals; the default is OFF.}
    option -delete_buffer_tree_max_fanout -takes value \
           -detail {Maximum fanout a net may have after buffer tree deletion for the deletion to take place; the default is 12.}
    option -report_high_fanout_nets_limit -takes value \
           -detail {Enables the flip-flop net sections of the compile report and sets how many high fanout nets are displayed; the default is 10.}
    option -block_remove_ios -takes value -values {ON OFF} -closed \
           -detail {Removes the I/Os from the block where possible, or leaves them unchanged (Block creation mode only).}
    option -block_add_interface -takes value -values {ON OFF} -closed \
           -detail {Adds buffers on the ports of the block with no fanout limit (Block creation mode only).}
    option -block_add_interface_fanout -takes value \
           -detail {Adds buffers only on ports of the block whose fanout is greater than this value, used together with -block_add_interface (Block creation mode only).}
    option -block_placement_conflicts -takes value -values {ERROR RESOLVE KEEP LOCK} -closed \
           -detail {Selects how placement conflicts between instantiated blocks are resolved, erroring out (the default), unplacing the remaining non-conflicting elements, preserving them unlocked, or preserving and locking them (Block instantiation mode only).}
    option -block_routing_conflicts -takes value -values {ERROR RESOLVE KEEP LOCK} -closed \
           -detail {Selects how routing conflicts between instantiated blocks are resolved, erroring out, removing the routing of non-conflicting nets, preserving it unlocked, or preserving and locking it (the default) (Block instantiation mode only).}

    form Default {compile ?-pdc_abort_on_error value? ?-pdc_eco_display_unmatched_objects value? ?-pdc_eco_max_warnings value? ?-demote_globals value? ?-demote_globals_max_fanout value? ?-promote_globals value? ?-promote_globals_min_fanout value? ?-promote_globals_max_limit value? ?-localclock_max_shared_instances value? ?-localclock_buffer_tree_max_fanout value? ?-combine_register value? ?-delete_buffer_tree value? ?-delete_buffer_tree_max_fanout value? ?-report_high_fanout_nets_limit value? ?-block_remove_ios value? ?-block_add_interface value? ?-block_add_interface_fanout value? ?-block_placement_conflicts value? ?-block_routing_conflicts value?}

    hover {
        summary {Compile the design with the given compile options.}
        synopsis {compile ?-pdc_abort_on_error value? ?-pdc_eco_display_unmatched_objects value? ?-pdc_eco_max_warnings value? ?-demote_globals value? ?-demote_globals_max_fanout value? ?-promote_globals value? ?-promote_globals_min_fanout value? ?-promote_globals_max_limit value? ?-localclock_max_shared_instances value? ?-localclock_buffer_tree_max_fanout value? ?-combine_register value? ?-delete_buffer_tree value? ?-delete_buffer_tree_max_fanout value? ?-report_high_fanout_nets_limit value? ?-block_remove_ios value? ?-block_add_interface value? ?-block_add_interface_fanout value? ?-block_placement_conflicts value? ?-block_routing_conflicts value?}
        description {Runs compile with the netlist and constraint handling options shown in the Compile Options dialog box for the SmartFusion, IGLOO, ProASIC3 and Fusion families. The -block_remove_ios, -block_add_interface and -block_add_interface_fanout options apply to Block creation mode only, and -block_placement_conflicts and -block_routing_conflicts to Block instantiation mode only; an ARM design cannot be instantiated while creating a User Block.}
        returns {The guide documents no return value.}
        example {compile \
     -pdc_abort_on_error "ON" \
     -demote_globals "OFF" \
     -demote_globals_max_fanout 12 \
     -promote_globals "OFF" \
     -promote_globals_min_fanout 200 \
     -combine_register "OFF" \
     -report_high_fanout_nets_limit 10}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command configure_tool {
    arity 0..

    ;# NOTE(libero): the SmartFusion2 tool_name production writes IO_PROGRAM_STATE
    ;# while the supported-tool_names table beneath it writes IO_PROGRAMMING_STATE;
    ;# both spellings are listed here and the set is left open because the two
    ;# family chapters document different tool_names.
    option -name -takes tool_name \
           -values {COMPILE CONFIGURE_PROG_OPTIONS CONFIGURE_PROG_OPTIONS_RTG4 SYNTHESIZE PLACEROUTE \
                    GENERATEPROGRAMMINGDATA GENERATEPROGRAMMINGFILE PROGRAMDEVICE PROGRAM_OPTIONS \
                    PROGRAMMER_INFO IO_PROGRAM_STATE IO_PROGRAMMING_STATE SPM FLASH_FREEZE \
                    PROGRAM_RECOVERY USER_PROG_DATA VERIFYTIMING INIT_LOCK PUBLISHBLOCK EXPORTPIN \
                    PROGRAMMING_BITSTREAM_SETTINGS} \
           -detail {Name of the tool to configure; each tool_name has its own set of parameters (required).}
    option -params -takes parameter_value \
           -detail {One tool parameter given as parameter:value; the parameter names accepted depend on the tool_name (required, repeatable).}

    form Default {configure_tool -name tool_name -params parameter:value...}

    hover {
        summary {Set the parameters for a tool that Libero SoC runs.}
        synopsis {configure_tool -name tool_name -params parameter:value...}
        description {General-purpose command that stores the run-time settings for one Libero tool ahead of run_tool. It takes the tool name and one or more parameter:value pairs, which are split apart and passed to the tool; repeating -params accumulates settings, and repeated configure_tool calls for the same tool are equivalent to one call carrying every pair. Tool parameter vocabularies: COMPILE accepts BLOCK_MODE, ENABLE_DESIGN_SEPARATION, DISPLAY_FANOUT_LIMIT, MERGE_SDC, PDC_IMPORT_HARDERROR, BLOCK_PLACEMENT_CONFLICTS, BLOCK_ROUTING_CONFLICTS, PA4_GB_MAX_RCLKINT_INSERTION, PA4_GB_MIN_GB_FANOUT_TO_USE_RCLKINT, PA4_GB_MAX_FANOUT_DATA_MOVE, PA4_GB_COUNT and SET_MITIGATION on SmartFusion2, IGLOO2 and RTG4, and MERGEPDC and MERGESDC on SmartFusion, IGLOO, ProASIC3 and Fusion. SYNTHESIZE accepts CLOCK_ASYNC, CLOCK_GLOBAL, CLOCK_DATA, RAM_OPTIMIZED_FOR_POWER, RETIMING, SYNPLIFY_OPTIONS, SYNPLIFY_TCL_FILE, BLOCK_MODE, BLOCK_PLACEMENT_CONFLICTS, BLOCK_ROUTING_CONFLICTS, PA4_GB_COUNT, PA4_GB_MAX_RCLKINT_INSERTION, PA4_GB_MIN_GB_FANOUT_TO_USE_RCLKINT, LANGUAGE_SYSTEM_VLOG, LANGUAGE_VERILOG_2001 and LANGUAGE_VHDL_2008. PLACEROUTE accepts TDPR, PDPR, EFFORT_LEVEL, INCRPLACEANDROUTE, REPAIR_MIN_DELAY, NUM_MULTI_PASSES, START_SEED_INDEX, MULTI_PASS_LAYOUT, MULTI_PASS_CRITERIA, SPECIFIC_CLOCK, DELAY_ANALYSIS, STOP_ON_FIRST_PASS, SLACK_CRITERIA, RGB_COUNT and REPLICATION on SmartFusion2, IGLOO2 and RTG4, and TDPR and INCRPLACEANDROUTE on the older families. FLASH_FREEZE accepts FF_RAM_STATE and FF_MSS_CLOCK. PROGRAMDEVICE accepts prog_action and prog_optional_procedures. PROGRAM_OPTIONS accepts program_envm, program_fabric, program_mode and program_security. PROGRAM_RECOVERY accepts enable_auto_update, enable_prog_recovery, spi_clk_freq and spi_data_transfer_mode. PROGRAMMING_BITSTREAM_SETTINGS, for RTG4, accepts system_controller_suspend_mode, disable_digest_check, disable_jtag, disable_fabric_erase_write_verify, disable_probe_read_write, disable_spi and one_time_programmable. PROGRAMMER_INFO accepts the per-programmer settings flashpro3_clk_mode, flashpro3_force_freq, flashpro3_freq and flashpro3_vpump and their flashpro4_ and flashpro5_ equivalents, plus flashpro_drive_trst, flashpro_force_freq, flashpro_force_vddp, flashpro_freq, flashpro_vddl, flashpro_vddp, flashpro_vpn, flashpro_vpp and the flashprolite_ set. SPM accepts the security policy settings back_level_bypass, back_level_protection, back_level_update_version, debug_cortex_m3, debug_digest_request, debug_disable_jtag, debug_passkey, debug_ujtag_access, factory_access, iap_isp_services, security_key_mode, smartdebug_access, the update_ and use_ policy locks, and the user_encryption_key and user_passkey values. USER_PROG_DATA accepts design_version and silicon_signature. EXPORTPIN accepts PINRPT_BY_NAME and PINRPT_BY_NUMBER. PUBLISHBLOCK accepts LANGUAGE, PLACEMENT, ROUTING and REGION. CONFIGURE_PROG_OPTIONS, CONFIGURE_PROG_OPTIONS_RTG4, IO_PROGRAM_STATE, INIT_LOCK, GENERATEPROGRAMMINGDATA, GENERATEPROGRAMMINGFILE and VERIFYTIMING are configured through the separate SmartFusion2, IGLOO2 and RTG4 Tcl for SoC document or take no configure parameters.}
        returns {0 on success and 1 on failure.}
        example {configure_tool -name {COMPILE} \
    -params {DISPLAY_FANOUT_LIMIT:10} \
    -params {MERGE_SDC:true}
configure_tool -name {SYNTHESIZE} -params {LANGUAGE_VHDL_2008:true}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command create_links {
    arity 0..

    option -hdl_source -takes file -detail {Name of the HDL file you want to link (repeatable).}
    option -stimulus -takes file -detail {Name of the stimulus file you want to link (repeatable).}
    option -sdc -takes file -detail {Name of the SDC file you want to link (repeatable).}
    option -pin -takes file -detail {Name of the PIN file you want to link (repeatable).}
    option -dcf -takes file -detail {Name of the DCF file you want to link (repeatable).}
    option -gcf -takes file -detail {Name of the GCF file you want to link (repeatable).}
    option -pdc -takes file -detail {Name of the PDC file you want to link (repeatable).}
    option -crt -takes file -detail {Name of the CRT file you want to link (repeatable).}
    option -vcd -takes file -detail {Name of the VCD file you want to link (repeatable).}

    form Default {create_links ?-hdl_source file...? ?-stimulus file...? ?-sdc file...? ?-pin file...? ?-dcf file...? ?-gcf file...? ?-pdc file...? ?-crt file...? ?-vcd file...?}

    hover {
        summary {Create links to files in your project.}
        synopsis {create_links ?-hdl_source file...? ?-stimulus file...? ?-sdc file...? ?-pin file...? ?-dcf file...? ?-gcf file...? ?-pdc file...? ?-crt file...? ?-vcd file...?}
        description {Adds one or more linked files to the project, with the option name selecting the file type. Each option may be repeated once per file.}
        returns {The guide does not document a return value.}
        example {create_links -hdl_source hdl1.vhd}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command create_probe_group {
    arity 0..

    option -name -takes group_name \
           -detail {Specifies the name of the new probe group (required).}

    form Default {create_probe_group -name group_name}

    hover {
        summary {Create a new probe group.}
        synopsis {create_probe_group -name group_name}
        description {SmartDebug command that creates an empty probe group; probes are then placed in it with add_to_probe_group or move_to_probe_group, and the group is dissolved with ungroup. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {create_probe_group -name my_new_grp}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command create_scenario {
    arity 1

    form Default {create_scenario name}

    hover {
        summary {Create a new empty timing scenario with the specified name.}
        synopsis {create_scenario name}
        description {A timing scenario is a set of timing constraints used with a design, letting you refine the constraints used for timing-driven place-and-route to reach timing closure faster. This command creates an empty scenario with the given name and adds it to the list of scenarios; the name must not already be used by another timing scenario.}
        returns {Not documented in the command reference.}
        example {create_scenario scenario_A}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command create_set {
    arity 0..

    option -name -takes name \
           -detail {A unique name for the newly created path set (required).}
    option -parent_set -takes name -detail {Name of the set to filter from.}
    option -clock -takes clock_name \
           -detail {Make the set a subset of the given clock domain (only with -type).}
    ;# NOTE(libero): -type is left an open value set because the guide's own
    ;# example writes the literal as REG_TO_REG while its table lists lowercase.
    option -type -takes set_type \
           -values {reg_to_reg async_to_reg reg_to_async external_recovery external_removal external_setup external_hold clock_to_out} \
           -detail {Predefined set type on which to base the new path set (only with -clock).}
    option -in_to_out \
           -detail {Base the set on the Input to Output set, whose paths start at input ports and end at output ports.}
    option -source_clock -takes clock_name \
           -detail {Make the set a subset of an inter-clock domain set with the given source clock (only with -sink_clock).}
    option -sink_clock -takes clock_name \
           -detail {Make the set a subset of an inter-clock domain set with the given sink clock (only with -source_clock).}
    option -source -takes pattern \
           -detail {Filter on the source pins of the parent set, or on all pins in the design when no parent set is given.}
    option -sink -takes pattern \
           -detail {Filter on the sink pins of the parent set, or on all pins in the design when no parent set is given.}

    form Default {create_set -name name ?-parent_set name? ?-clock clock_name -type set_type? ?-in_to_out? ?-source_clock clock_name -sink_clock clock_name? ?-source pattern? ?-sink pattern?}

    hover {
        summary {Create a named set of paths to be analyzed.}
        synopsis {create_set -name name ?-parent_set name? ?-clock clock_name -type set_type? ?-in_to_out? ?-source_clock clock_name -sink_clock clock_name? ?-source pattern? ?-sink pattern?}
        description {Creates a path set whose membership is given by the arguments: -clock with -type makes the set a subset of a clock domain, -source_clock with -sink_clock makes it a subset of an inter-clock domain set, and -parent_set makes it a filtered subset of an existing named set. The -source and -sink patterns filter the start and end pins, filtering the whole design when no parent set is named.}
        returns {Not documented in the command reference.}
        example {create_set -name { my_user_set } -source { C* } -sink { D* }
create_set -name { my_other_user_set } -parent_set { my_user_set } -source { CL* }}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command create_symbol {
    arity 0..

    option -module -takes module -detail {Name of the symbol module you want to create.}

    form Default {create_symbol ?-module module?}

    hover {
        summary {Create a symbol in a module.}
        synopsis {create_symbol ?-module module?}
        description {Creates a schematic symbol for the named module of the project.}
        returns {The guide does not document a return value.}
        example {create_symbol -module mod2}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command delete_active_probe {
    arity 0..

    option -all \
           -detail {Deletes all active probe names.}
    option -name -takes probe_name \
           -detail {Deletes the selected probe names; naming a group or bus deletes it and its members (repeatable).}

    option_conflict {-all -name}

    form Default {delete_active_probe -all|-name probe_name...}

    hover {
        summary {Delete all or selected active probes.}
        synopsis {delete_active_probe -all|-name probe_name...}
        description {SmartDebug command that removes active probe points from the current selection, either all of them with -all or the ones named by repeated -name options. An individual probe cannot be deleted from a probe bus. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {delete_active_probe -all
delete_active_probe -name out[5]:out[5]:Q \
    -name my_grp1.out[1]:out[1]:Q}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command delete_files {
    arity 0..

    option -file -takes value \
           -detail {File to delete from the project, given with its full pathname; this does not delete the file from disk unless -from_disk is also given (required, repeatable).}
    option -from_disk -detail {Also deletes the file from the disk.}

    form Default {delete_files ?-from_disk? -file value...}

    hover {
        summary {Delete files from your Libero SoC project.}
        synopsis {delete_files ?-from_disk? -file value...}
        description {Removes the named files from the project. By default the files stay on disk; add -from_disk to delete them from disk as well. Deleting a component .cxf file is how an IP core is removed from both the project and the disk.}
        returns {The guide does not document a return value.}
        example {delete_files -file ./project/hdl/file1.vhd -file ./project/hdl/file2.vhd
delete_files -from_disk -file ./project/phy_synthesis/top_palace.sdc}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command delete_probe {
    arity 0..

    option -net -takes net_name -detail {Name of the net whose probe is deleted (required).}

    form Default {delete_probe -net net_name}

    hover {
        summary {Delete a probe on a net in a probed ADB file.}
        synopsis {delete_probe -net net_name}
        description {Deletes the probe placed on the named net of a probed ADB file, undoing an earlier add_probe.}
        returns {The guide documents no return value.}
        example {delete_probe -net Count8_0/INV_0_Y}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command delete_scenario {
    arity 1

    form Default {delete_scenario name}

    hover {
        summary {Delete the specified timing scenario.}
        synopsis {delete_scenario name}
        description {Deletes the named timing scenario and all the constraints it contains. At least one timing scenario must always remain, so the only existing scenario cannot be deleted, and scenarios linked to timing analysis or to layout cannot be deleted either.}
        returns {Not documented in the command reference.}
        example {delete_scenario scenario_A}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command download_core {
    arity 0..

    option -vlnv -takes vlnv \
           -detail {Vendor, library, name and version of the core you want to download (repeatable).}
    option -location -takes location \
           -detail {Location of the repository where you wish to add the core.}

    form Default {download_core ?-vlnv vlnv...? ?-location location?}

    hover {
        summary {Download a core and add it to your repository.}
        synopsis {download_core ?-vlnv vlnv...? ?-location location?}
        description {Downloads one or more cores identified by their vendor, library, name and version quadruple, and adds them to the named core repository.}
        returns {The guide does not document a return value.}
        example {download_core -vlnv {Actel:SystemBuilder:PF_DDR4:1.0.102} -location {www.actel-ip.com/repositories/SgCore}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command edit_profile {
    arity 0..

    option -name -takes profilename -detail {Name of the profile you are editing (required).}
    option -type -takes value -values {synthesis simulation stimulus flashpro} -closed \
           -detail {Profile type: a synthesis, simulation, stimulus, or FlashPro tool profile (required).}
    option -tool -takes profiletool -detail {Name of the tool you are adding to the profile (required).}
    option -location -takes profilelocation \
           -detail {Full pathname to the location of the tool you are adding to the profile (required).}
    option -args -takes parameters -detail {Profile tool parameters, if any.}
    option -batch -takes value -values {TRUE FALSE} -closed \
           -detail {Runs the profile in batch mode when TRUE.}
    option -new_name -takes name -detail {New name for the profile.}

    form Default {edit_profile -name profilename -type value -tool profiletool -location profilelocation ?-args parameters? ?-batch value? ?-new_name name?}

    hover {
        summary {Edit an existing tool profile.}
        synopsis {edit_profile -name profilename -type value -tool profiletool -location profilelocation ?-args parameters? ?-batch value? ?-new_name name?}
        description {Sets the same values as the Add or Edit Profile dialog box for a profile that already exists, optionally renaming it with -new_name.}
        returns {The guide does not document a return value.}
        example {edit_profile -name myflashpro -type flashpro -tool flashpro.exe -location c:/programs/actel/flashpro/bin/flashpro.exe -batch FALSE -new_name updated_flashpro}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command expand_path {
    arity 0..

    option -set -takes name \
           -detail {Expand paths from the named set, as an alternative to naming a set with -clock and -type.}
    option -clock -takes clock_name \
           -detail {Expand paths belonging to the specified clock domain (only with -type).}
    option -type -takes set_type \
           -values {reg_to_reg async_to_reg reg_to_async external_recovery external_removal external_setup external_hold clock_to_out} \
           -detail {Type of paths in the clock domain to expand (only with -clock).}
    option -from_clock -takes clock_name \
           -detail {Expand paths of the inter-clock domain set starting at this source clock (only with -to_clock).}
    option -to_clock -takes clock_name \
           -detail {Expand paths of the inter-clock domain set ending at this sink clock (only with -from_clock).}
    ;# NOTE(libero): the guide describes -analysis twice, once as max or min and
    ;# once as maxdelay or mindelay, so all four literals are offered but open.
    option -analysis -takes value -values {max min maxdelay mindelay} \
           -detail {Whether the analysis is max-delay (setup check) or min-delay (hold check).}
    option -index -takes list_of_indices \
           -detail {Which paths to expand; the index starts at 1, defaults to 1, and only values below the max_paths option are expanded.}
    option -format -takes value -values {text csv} \
           -detail {Output format, text by default for display or csv for parsing.}

    option_conflict {-set -clock}

    form Default {expand_path ?-set name? ?-clock clock_name -type set_type? ?-from_clock clock_name -to_clock clock_name? ?-analysis value? ?-index list_of_indices? ?-format value?}

    hover {
        summary {Display expanded path information for the selected timing paths.}
        synopsis {expand_path ?-set name? ?-clock clock_name -type set_type? ?-from_clock clock_name -to_clock clock_name? ?-analysis value? ?-index list_of_indices? ?-format value?}
        description {Expands the paths identified by the same arguments that would list them with list_paths, so expand_path -clock {MYCLOCK} -type {reg_to_reg} expands the first path that list_paths reports for that set. Path details carry the pin name, type, net name, cell name, operation, delay, total delay, and edge, together with the arrival time, required time, and slack, matching the SmartTime Expanded Path window.}
        returns {The expanded path details for the selected paths.}
        example {puts [expand_path -clock { myclock } -type {reg_to_reg }]
puts [expand_path -clock {myclock} -type {reg_to_reg} -index { 1 2 3 } -format text]}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command export {
    arity 1..

    ;# NOTE(libero): the -format value list is a union of the file types the
    ;# guide tabulates; the exported files vary from one device family to
    ;# another and several formats may be given in one value, so the set is
    ;# not closed.
    option -format -takes value \
           -values {adl afl edn v vhd crt dcf gcf sdc pdc pin afm bit bts_stp dc fus isc pdb svf fdb bsd prb mod sdf stf tcl log ibs cob loc seg cdb cxf block} \
           -detail {File format of the file to export, which decides which of the other arguments are required.}
    option -feature -takes value \
           -detail {Silicon feature to program, such as setup_security, prog_fpga, prog_from, prog_nvm or all, given per family and optionally per Embedded Flash Memory Block instance.}
    option -secured_device -takes value -values {yes no} -closed \
           -detail {Specifies whether the device being programmed is secured.}
    option -signature -takes value \
           -detail {Optional value that identifies and tracks Microsemi SoC designs and devices.}
    option -pass_key -takes value \
           -detail {Protects all the security settings for the FPGA Array, FlashROM and Embedded Flash Memory Block, given as at most 32 hexadecimal characters.}
    option -aes_key -takes value \
           -detail {Decrypts FPGA Array, FlashROM and Embedded Flash Memory Block programming file content, given as at most 32 hexadecimal characters.}
    option -from_config_file -takes value \
           -detail {Location of the FlashROM configuration file.}
    option -number_of_devices -takes value \
           -detail {Number of devices to program, applicable only when the FlashROM has serialization regions.}
    option -from_progfile_type -takes value -values {single multiple} -closed \
           -detail {Generates one programming file holding all generated incremental values or one file per value, applicable only when the FlashROM has serialization regions and STAPL file generation.}
    option -target_programmer -takes value -values {specific generic} \
           -detail {Selects a device-specific programmer such as Silicon Sculptor, BP Auto Programmer or FlashPro, or the generic STAPL player, applicable only when the FlashROM has serialization regions and STAPL file generation.}
    option -custom_security -takes value -values {yes no} -closed \
           -detail {Selects a custom security level rather than the standard one.}
    option -fpga_security_level -takes value \
           -values {write_verify_protect write_protect encrypted none} -closed \
           -detail {Security level of the FPGA Array, from medium write and verify protection, through write protection and 128-bit AES encryption, to none.}
    option -from_security_level -takes value \
           -values {write_verify_protect write_protect encrypted none} -closed \
           -detail {Security level of the FlashROM, from medium write and verify protection, through write protection and 128-bit AES encryption, to none.}
    option -security_permanent -takes value -values {yes no} -closed \
           -detail {Permanently disables future modification of the security settings for the FPGA Array and FlashROM.}
    option -from_program_pages -takes value \
           -detail {FlashROM pages to program in FlashPoint, given as a sequence of page numbers with or without delimiters.}
    option -from_content -takes value -values {adb ufc} -closed \
           -detail {Source of the FlashROM content, the ADB file (the default) or the named UFC file.}
    option -set_io_state -takes value \
           -detail {Sets the I/O state during programming by port name, pin number or for all I/Os, sets the BSR values of an I/O, or saves and loads an IOS file (repeatable).}
    option -efm_block_security -takes value \
           -detail {Security level of one Embedded Flash Memory Block instance from 0 to 3, written as location:X;security_level:value, applying only when programming the security settings or a previously secured device (Fusion only).}
    option -efm_content -takes value \
           -detail {Source file for the content of one Embedded Flash Memory Block instance, written as location:X;source:adb or location:X;source:efc (Fusion only).}
    option -efm_block -takes value \
           -detail {Location of the EFC configuration file of one Embedded Flash Memory Block instance, written as location:X;config_file:value (Fusion only).}
    option -efm_client -takes value \
           -detail {Client of one Embedded Flash Memory Block instance to program and the memory content file that overrides the ADB or EFC content, written as location:X;client:value;mem_file:value (Fusion only, repeatable).}
    option -export_directory -takes value \
           -detail {Directory for the exported .v, .vhd, .cxf and .cdb block files (-format block only).}
    option -export_name -takes blockname \
           -detail {Prefix of the exported .v, .vhd, .cxf and .cdb block files (-format block only).}
    option -placement -takes value -values {yes no} -closed \
           -detail {Exports the placement information, which requires a valid placer state (-format block only).}
    option -routing -takes value -values {yes no} -closed \
           -detail {Exports the routing information, which requires a valid routing state (-format block only).}
    option -comment -takes value \
           -detail {Comment text documenting the exported block (-format block only).}
    option -export_language -takes value -values {VERILOG VHDL} -closed \
           -detail {Language of the CXF file exported for Libero SoC (-format block only).}
    option -region -takes value -values {YES NO} -closed \
           -detail {Publishes all the user regions so they are available when the block is instantiated (-format block only).}

    side_effect FileIo -writes

    form Default {export ?-format value? ?-feature value? ?-secured_device value? ?-signature value? ?-pass_key value? ?-aes_key value? ?-from_config_file value? ?-number_of_devices value? ?-from_progfile_type value? ?-target_programmer value? ?-custom_security value? ?-fpga_security_level value? ?-from_security_level value? ?-security_permanent value? ?-from_program_pages value? ?-from_content value? ?-set_io_state value...? ?-efm_block_security value? ?-efm_content value? ?-efm_block value? ?-efm_client value...? ?-export_directory value? ?-export_name blockname? ?-placement value? ?-routing value? ?-comment value? ?-export_language value? ?-region value? filename}

    hover {
        summary {Save the design to a file in the specified file format.}
        synopsis {export ?-format value? ?-feature value? ?-secured_device value? ?-signature value? ?-pass_key value? ?-aes_key value? ?-from_config_file value? ?-number_of_devices value? ?-from_progfile_type value? ?-target_programmer value? ?-custom_security value? ?-fpga_security_level value? ?-from_security_level value? ?-security_permanent value? ?-from_program_pages value? ?-from_content value? ?-set_io_state value...? ?-efm_block_security value? ?-efm_content value? ?-efm_block value? ?-efm_client value...? ?-export_directory value? ?-export_name blockname? ?-placement value? ?-routing value? ?-comment value? ?-export_language value? ?-region value? filename}
        description {Saves the design to the named file, the trailing positional argument, in the format given by -format; which of the remaining arguments are required and which are ignored depends on that format and on the device family. With -format block the command publishes the block files to the directory named by -export_directory, together with the placement, routing, comment, CXF language and user-region options. This is a Designer command that cannot be executed in Libero Tcl scripts.}
        returns {The guide documents no return value.}
        example {export -format "block" -export_directory {.} -export_name "test_core" -placement "yes" \
-routing "yes" -comment "toto" -export_language "VERILOG"}
        example {export -format "dc" -feature "prog_fpga" {./top.dat}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command export_as_link {
