        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_set_operating_condition {
    arity 0..

    option -opcond -takes value -values {best typical worst} -closed \
           -detail {Specifies the pre-defined operating condition to use.}

    form Default {smartpower_set_operating_condition ?-opcond value?}

    hover {
        summary {Set the SmartPower operating conditions to a pre-defined type.}
        synopsis {smartpower_set_operating_condition ?-opcond value?}
        description {Sets the operating conditions used in SmartPower to one of the pre-defined types, best, typical, or worst.}
        returns {The empty string.}
        example {smartpower_set_operating_condition -opcond {best}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_set_operating_conditions {
    arity 0..

    ;# NOTE(libero): the guide's Syntax block writes the airflow value as a bare
    ;# word following the command name and its example spells the option
    ;# -airflow, while the Arguments table names the option -still_air and lists
    ;# still_air among the values; the Arguments-table spelling is used and the
    ;# value set is left open.
    option -still_air -takes value -values {still_air 1.0_mps 2.5_mps custom} \
           -detail {Specifies the airflow operating condition (required).}
    option -heatsink -takes value \
           -values {None custom 10mm_Low_Profile 15mm_Medium_Profile 20mm_High_Profile} \
           -detail {Specifies the heat sink, either none, a custom size, or a 10 mm, 15 mm, or 20 mm profile (required).}
    option -boardmodel -takes value -values {None_Conservative JEDEC_2s2p} \
           -detail {Specifies the board model, either no board model with conservative routing or the JEDEC 2s2p board model (required).}
    option -teta_ja -takes decimal_value \
           -detail {Optional; sets the teta ja value, which must be a positive decimal.}
    option -teta_sa -takes decimal_value \
           -detail {Optional; sets the teta sa value, which must be a positive decimal.}

    form Default {smartpower_set_operating_conditions -still_air value -heatsink value -boardmodel value ?-teta_ja decimal_value? ?-teta_sa decimal_value?}

    hover {
        summary {Set the thermal operating conditions used in SmartPower. (SmartFusion2, IGLOO2, RTG4 only)}
        synopsis {smartpower_set_operating_conditions -still_air value -heatsink value -boardmodel value ?-teta_ja decimal_value? ?-teta_sa decimal_value?}
        description {Sets the airflow, heat sink and board model that SmartPower uses to derive the thermal operating conditions, optionally with explicit teta ja and teta sa values. The guide documents this command only in the SmartFusion2, IGLOO2 and RTG4 chapter; the SmartFusion, IGLOO, ProASIC3 and Fusion chapter has smartpower_set_operating_condition instead.}
        returns {The empty string.}
        example {smartpower_set_operating_conditions -airflow "still_air" -heatsink "None" \
    -boardmodel "None_Conservative"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_set_pin_probability {
    arity 0..

    option -pin_name -takes pin_name \
           -detail {Specifies the name of a pin whose probability is set, which must be the direct driver of an enable pin.}
    ;# NOTE(libero): the guide's Syntax block spells the value option
    ;# -pin_enable_rate while its Arguments table and its example both spell it
    ;# -pin_proba; both spellings are carried here rather than choosing one.
    option -pin_proba -takes value \
           -detail {Specifies the pin probability as a percentage, any positive decimal between 0 and 100 inclusive.}
    option -pin_enable_rate -takes value \
           -detail {Specifies the pin probability as a percentage, spelled this way in the guide's syntax line only.}

    form Default {smartpower_set_pin_probability ?-pin_name pin_name? ?-pin_proba value? ?-pin_enable_rate value?}

    hover {
        summary {Set the probability value of a pin driving an enable pin.}
        synopsis {smartpower_set_pin_probability ?-pin_name pin_name? ?-pin_proba value? ?-pin_enable_rate value?}
        description {Sets the probability of the pin named by -pin_name, which must directly drive an enable pin, as a percentage between 0 and 100. Without this command an I/O takes the probability of the IOsEnableSet and a memory takes the probability of the MemoriesEnableSet. Both chapters of the guide list SmartFusion, IGLOO, ProASIC3 and Fusion under Supported Families for this command.}
        returns {The empty string.}
        example {smartpower_set_pin_probability -pin_name mybibuf/U0/U1:EOUT -pin_proba 50.4}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_set_process {
    arity 0..

    option -process -takes value -values {Typical Maximum} -closed \
           -detail {Specifies the pre-defined process used in SmartPower.}

    form Default {smartpower_set_process ?-process value?}

