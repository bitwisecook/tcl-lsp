command smartpower_set_temperature_opcond {
    arity 0..

    option -use -takes value -values {oprange design mode} -closed \
           -detail {Selects the temperature operating range: the Project Settings range, the SmartPower design-wide range, or the mode-specific range.}

    form Default {smartpower_set_temperature_opcond ?-use value?}

    hover {
        summary {Set the temperature in the operating conditions to a pre-defined type.}
        synopsis {smartpower_set_temperature_opcond ?-use value?}
        description {Chooses which temperature range the operating conditions use: oprange takes the range specified in the Project Settings, while design and mode take the SmartPower design-wide and mode-specific operating ranges and apply to SmartPower only.}
        returns {The empty string.}
        example {smartpower_set_temperature_opcond -use {mode}}
        source {Libero SoC v11.8 Tcl Command Reference}
