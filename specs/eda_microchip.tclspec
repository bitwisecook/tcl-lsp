        summary {Generate the SDC constraint coverage report.}
        synopsis {generate_sdc_constraint_coverage -tool value}
        description {Reports the coverage of the paths from the SDC constraints associated with Place and Route or with Timing Verification. This command is available for the Enhanced Constraint Flow only; Place-and-Route need not have run, but the design must be in the post-synthesis state. The generated reports are XML files listed in the Reports tab. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {0 on success, 1 on failure.}
        example {generate_sdc_constraint_coverage -tool {PLACEROUTE}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

