    }
}

command get_design_filename {
    arity 0

    form Default {get_design_filename}

    hover {
        summary {Retrieve the fully qualified path of the design file.}
        synopsis {get_design_filename}
        description {Returns the fully qualified path of the design file, or the empty string when the design has not been saved to disk. This command predates get_design_info and is kept for backward compatibility; it is equivalent to get_design_info DESIGN_PATH. It returns an error if no design is loaded or if any argument is passed.}
        returns {The fully qualified path of the design file, or an empty string when the design has not been saved to disk.}
        example {if { [ is_design_loaded ] } {
    set design_location [ get_design_filename ]
}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command get_design_info {
    arity 1

    ;# NOTE(libero): the guide tabulates the values in lower case but its own
    ;# example passes them in upper case (NAME, DESIGN_PATH), so the set is
    ;# recorded here in prose rather than as a closed value list.
    form Default {get_design_info value}

    hover {
        summary {Retrieve one basic detail of the design as a string.}
        synopsis {get_design_info value}
        description {Returns one basic detail of the current design as a string value, where value is one of name, family, design_path, design_folder, design_file, cwdir, die, package or speed. The design_path value is the fully qualified path of the ADB file and replaces get_design_filename, and die, package and speed are empty until they have been selected. It returns an error if no design is loaded, if more than one argument is passed, or if the argument is not one of the valid values.}
        returns {The requested design detail as a string, empty when that detail is not set.}
        example {set var [ get_design_info DESIGN_PATH ]}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command get_out_of_date_files {
