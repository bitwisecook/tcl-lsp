command save_project_as {
    arity 0..

    option -name -takes project_name -detail {Name of your new project.}
    option -location -takes project_location \
           -detail {Complete path of the new PRJ file; without the full path Libero SoC saves the project to your current working directory (required).}
    option -files -takes value -values {all project source none} -closed \
           -detail {Selects which files are copied into your new project: all files, only the Libero SoC project files, only the source files, or none.}
    option -designer_views -takes value -values {all current none} -closed \
           -detail {Selects which Designer views are copied into your new project: all views, only the current view, or none.}
    option -replace_links -takes value -values {true false} -closed \
           -detail {Replaces, that is updates, the file links in your project during the save when true.}

    form Default {save_project_as ?-name project_name? -location project_location ?-files value? ?-designer_views value? ?-replace_links value?}

    hover {
        summary {Save the current project under a different name and location.}
        synopsis {save_project_as ?-name project_name? -location project_location ?-files value? ?-designer_views value? ?-replace_links value?}
        description {Saves the current Libero SoC project with a different name in a specified directory. You must specify a location with the -location parameter.}
        returns {The guide does not document a return value.}
        example {save_project_as -location c:/netlists/testprj/mydesign -name mydesign.prj}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command select_active_probe {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration.}
    option -name -takes probe_name_pattern \
           -detail {Specifies the name of the probe, optionally a search pattern using * and ? that matches one or several probe points (repeatable).}
    option -reset -takes reset -values {true false} -closed \
           -detail {Resets all previously selected probe points, emptying the current selection when no name is given.}

    form Default {select_active_probe ?-deviceName device_name? ?-name probe_name_pattern...? ?-reset true|false?}

    hover {
        summary {Manage the current selection of active probe points.}
        synopsis {select_active_probe ?-deviceName device_name? ?-name probe_name_pattern...? ?-reset true|false?}
        description {SmartDebug command that builds the set of active probe points used by active probe read operations, extending or, with -reset, replacing the current selection with the probe points found by the search pattern. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {select_active_probe -name out.out[1]:out[1]:Q \
    -name out.out[3]:out[3]:Q \
    -name out.out[5]:out[5]:Q}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

