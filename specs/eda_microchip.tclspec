}

command rename_scenario {
    arity 1..

    option -new -takes new_name \
           -detail {New name for the timing scenario, used with the single-name form (SmartFusion, IGLOO, ProASIC3, and Fusion only).}

    form Default {rename_scenario old_name ?new_name | -new new_name?}

    hover {
        summary {Rename an existing timing scenario.}
        synopsis {rename_scenario old_name ?new_name | -new new_name?}
        description {Changes the name of an existing timing scenario in the list of scenarios; the new name must not already be used by another scenario. SmartFusion2, IGLOO2, and RTG4 take the two names positionally, while SmartFusion, IGLOO, ProASIC3, and Fusion give the new name with -new.}
        returns {Not documented in the command reference.}
        example {rename_scenario my_old_scenario my_new_scenario}
        example {rename_scenario scenario_A -new scenario_B}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command report {
    arity 1..

    ;# NOTE(libero): the value set is left open because the guide spells some
    ;# literals two ways across its report sections, e.g. violations and
    ;# timing_violations, and its examples quote them with mixed case.
    option -type -takes type \
           -values {timing violations timing_violations datasheet bottleneck constraints_coverage combinational_loops power power_history power_activity_map} \
           -detail {The kind of report to generate (required).}
    option -analysis -takes value -values {max min} \
           -detail {Whether the report considers maximum or minimum delay analysis, max by default (timing, timing violations, and bottleneck reports).}
    option -format -takes value -values {text csv} \
           -detail {Output format of the generated report, text by default (timing, timing violations, datasheet, and bottleneck reports).}
    option -style -takes value -values {Text CSV} \
           -detail {Format in which a power or activity report is exported (-type power and -type power_activity_map only).}
    option -print_summary -takes value -values {yes no} \
           -detail {Include the summary section in the timing report, yes by default.}
    option -use_slack_threshold -takes value -values {yes no} \
           -detail {Consider the slack threshold, excluded by default (timing, timing violations, and bottleneck reports).}
    option -slack_threshold -takes value \
           -detail {Slack threshold in nanoseconds to consider when reporting path slacks; by default all slacks are reported.}
    option -print_paths -takes value -values {yes no} \
           -detail {Print the path section, that is the clock domains and in-to-out paths, in the timing report, yes by default.}
    option -max_paths -takes number \
           -detail {Maximum number of paths to report for each set, a positive integer (timing, timing violations, and bottleneck reports).}
    option -max_expanded_paths -takes number \
           -detail {Number of paths to expand per set, a positive integer (timing and timing violations reports).}
    option -max_parallel_paths -takes number \
           -detail {Maximum number of parallel paths, that is paths sharing start and end points, allowed per end point pair (timing and bottleneck reports).}
    option -limit_max_paths -takes value -values {yes no} \
           -detail {Limit the number of paths reported, unlimited by default (timing and timing violations reports).}
    option -include_user_sets -takes value -values {yes no} \
           -detail {Include user defined sets in the timing report.}
    option -include_pin_to_pin -takes value -values {yes no} \
           -detail {Include pin-to-pin paths in the timing report.}
    option -include_clock_domains -takes value -values {yes no} \
           -detail {Include clock domains in the timing report.}
    option -select_clock_domains -takes value \
           -detail {Restrict the timing report to a clock domain list, given either as a yes or no switch or as the domain names themselves depending on the report section.}
    option -clock_domain -takes clock_domain_list \
           -detail {Clock domains to consider in the clock domain section, as names separated by spaces (timing report).}
    option -cost_type -takes value -values {path_count path_cost} \
           -detail {Bottleneck cost type, path_count by default, where path_cost ranks instances by combined timing violation (-type bottleneck only).}
    option -max_instances -takes number \
           -detail {Maximum number of instances to report, 10 by default (-type bottleneck only).}
    option -set_name -takes name \
           -detail {Report bottleneck information for the named set, as an alternative to -clock with -set_type (-type bottleneck only).}
    option -set_type -takes set_type \
           -values {reg_to_reg async_to_reg reg_to_async external_recovery external_removal external_setup external_hold clock_to_out} \
           -detail {Filter which type of paths count towards the bottleneck (only with -clock, -type bottleneck only).}
    option -clock -takes clock_name \
           -detail {Prune the bottleneck report to a given clock domain (-type bottleneck only).}
    option -from_clock -takes clock_name \
           -detail {Report only instances on violating inter-clock domain paths starting at this source clock (only with -to_clock).}
    option -to_clock -takes clock_name \
           -detail {Report only instances on violating inter-clock domain paths ending at this sink clock (only with -from_clock).}
    option -source_clock -takes clock_name \
           -detail {Report only bottleneck instances on violating inter-clock domain paths starting at this source clock (only with -sink_clock).}
    option -sink_clock -takes clock_name \
           -detail {Report only bottleneck instances on violating inter-clock domain paths ending at this sink clock (only with -source_clock).}
    option -from -takes pattern \
           -detail {Report only instances on violating paths that start at the matching locations (-type bottleneck only).}
    option -to -takes pattern \
           -detail {Report only instances on violating paths that end at the matching locations (-type bottleneck only).}
    option -source -takes pin_list \
           -detail {Report only instances on violating paths that start at the given pins (-type bottleneck only).}
    option -sink -takes pin_list \
           -detail {Report only instances on violating paths that end at the given pins (-type bottleneck only).}
    option -in_to_out \
           -detail {Report only instances on violating paths from input ports to output ports (-type bottleneck only).}
    option -powerunit -takes value -values {W mW uW} \
           -detail {Unit in which power is reported (-type power only).}
    option -frequnit -takes value -values {Hz kHz MHz} \
           -detail {Unit in which frequency is reported (-type power only).}
    option -opcond -takes value -values {worst typical best} \
           -detail {Operating condition used for the power report (-type power only).}
    option -opmode -takes value -values {Active Standby Flash*Freeze} \
           -detail {Operating mode whose operating conditions the report uses (-type power and -type power_activity_map only).}
    option -toggle -takes value -values {true false} \
           -detail {Set the toggle used by the power report (-type power only).}
    option -power_summary -takes value -values {true false} \
           -detail {Include the power summary of static and dynamic values (-type power only).}
    option -rail_breakdown -takes value -values {true false} \
           -detail {Include the breakdown by rail summary (-type power only).}
    option -type_breakdown -takes value -values {true false} \
           -detail {Include the breakdown by type summary (-type power only).}
    option -clock_breakdown -takes value -values {true false} \
           -detail {Include the breakdown by clock domain summary (-type power only).}
    option -thermal_summary -takes value -values {true false} \
           -detail {Include the thermal summary (-type power only).}
    option -battery_life -takes value -values {true false} \
           -detail {Include the battery life summary (-type power only).}
    option -opcond_summary -takes value -values {true false} \
           -detail {Include the operating conditions summary (-type power only).}
    option -clock_summary -takes value -values {true false} \
           -detail {Include the clock domains summary (-type power only).}
    option -sortby -takes value \
           -detail {How to sort the values in the report: power values or alphabetical for a power report, or one of total power, spurious power, functional power, spurious transitions, and functional transitions for an activity report.}
    option -sortorder -takes value -values {ascending descending} \
           -detail {Sort order of the values in the report (-type power and -type power_activity_map only).}
    option -instance_breakdown -takes value -values {true false} \
           -detail {Include the breakdown by instance (-type power only).}
    option -power_threshold -takes value -values {true false} \
           -detail {Report only instances consuming power above -min_power (-type power only).}
    option -filter_instance -takes value -values {true false} \
           -detail {Limit the number of instances included in the power report to -max_instance (-type power only).}
    option -min_power -takes number \
           -detail {Minimum power value of a block used to decide which blocks to expand (-type power only).}
    option -max_instance -takes integer \
           -detail {Maximum number of instances to include in the power report, an integer of zero or more (-type power only).}
    option -activity_sortorder -takes value -values {ascending descending} \
           -detail {Sort order for the activity summary (-type power only).}
    option -activity_sortby -takes value -values {{pin name} {net name} domain frequency source} \
           -detail {How to sort the values of the activity summary (-type power only).}
    option -activity_summary -takes value -values {true false} \
           -detail {Include the activity summary (-type power only).}
    option -frequency_threshold -takes value -values {true false} \
           -detail {Add a frequency threshold, used with -min_frequency (-type power only).}
    option -filter_pin -takes value -values {true false} \
           -detail {Filter by maximum number of pins, used with -max_pin (-type power only).}
    option -min_frequency -takes value \
           -detail {Minimum frequency, a decimal value optionally followed by Hz, KHz, or MHz (-type power only).}
    option -max_pin -takes value \
           -detail {Maximum number of pins to report (-type power only).}
    option -enablerates_sortorder -takes value -values {ascending descending} \
           -detail {Sort order for the probabilities summary (-type power only).}
    option -enablerates_sortby -takes value -values {{pin name} {net name} domain frequency source} \
           -detail {How to sort the values of the probabilities summary (-type power only).}
    option -enablerates_summary -takes value -values {true false} \
           -detail {Include the probabilities summary (-type power only).}
    option -with_annotation_coverage -takes value -values {true false} \
           -detail {Include the annotation coverage summary (-type power only).}
    option -vcd_file -takes path \
           -detail {Path to the VCD file to import (-type power_activity_map only).}
    option -partial_parse -takes value -values {true false} \
           -detail {Parse only part of the VCD file, bounded by -start_time and -end_time (-type power_activity_map only).}
    option -start_time -takes value \
           -detail {Start time in ns of the partial VCD parse (only with -partial_parse true).}
    option -end_time -takes value \
           -detail {End time in ns of the partial VCD parse (only with -partial_parse true).}
    option -auto_detect_top_level_name -takes value -values {true false} \
           -detail {Detect the top-level name automatically (-type power_activity_map only).}
    option -top_level_name -takes name \
           -detail {Top-level name to use when it is not detected automatically (-type power_activity_map only).}
    option -report_type -takes value -values {activity power {activity and power}} \
           -detail {Whether each net is reported with activity information, power information, or both (-type power_activity_map only).}
    option -report_query -takes value \
           -values {{Report by Net - summary} {Report by Net - detailed} {Report by Cycle - summary} {Report by cycle - detailed}} \
           -detail {Whether the report is summarised or detailed, and organised by net or by cycle (-type power_activity_map only).}
    option -max_net -takes value \
           -detail {Maximum number of nets to report, per report for net views and per cycle for a cycle details report (-type power_activity_map only).}
    option -max_cycle -takes value \
           -detail {Maximum number of cycles to report, per report for cycle views and per net for a net details report (-type power_activity_map only).}
    option -clock_settings -takes value \
           -detail {Clock settings written as clock name, colon, and an active edge of rising, falling, both, or not_active (-type power_activity_map only).}
    option -glitch_filtering -takes value -values {true auto false} \
           -detail {Whether glitch filtering is on, automatic, or off, where auto ignores -glitch_threshold (-type power_activity_map only).}
    option -glitch_threshold -takes value \
           -detail {Glitch filtering value in ps (only with -glitch_filtering true).}
    option -auto_construct_clock_domain -takes value -values {true false} \
           -detail {Construct the clock domain automatically (-type power_activity_map only).}
    option -clock_period -takes value \
           -detail {Virtual clock period in ps, used when -auto_construct_clock_domain is false.}
    option -clock_offset -takes value \
           -detail {Time in ps of the first active edge of the virtual clock, used when -auto_construct_clock_domain is false.}

    option_conflict {-set_name -clock}

    side_effect FileIo -writes

    form Default {report -type type ?-analysis value? ?-format value? ?options? filename}

    hover {
        summary {Generate a report of the chosen type into the named file.}
        synopsis {report -type type ?-analysis value? ?-format value? ?options? filename}
        description {One command generates every Libero SoC report kind, selected by -type and written to the trailing filename. The timing and timing violations reports take -analysis, -print_summary, -print_paths, -use_slack_threshold with -slack_threshold, -max_paths, -max_expanded_paths, -limit_max_paths, -include_user_sets, -include_pin_to_pin, -include_clock_domains, -select_clock_domains, and -clock_domain; datasheet takes only -format; bottleneck takes -cost_type, -max_instances, -max_paths, -max_parallel_paths, -analysis, and the pruning options -set_name, -clock with -set_type, -from_clock with -to_clock, -source_clock with -sink_clock, -from, -to, -source, -sink, and -in_to_out; constraints_coverage and combinational_loops take no options of their own. The power report takes -powerunit, -frequnit, -opcond, -opmode, -toggle, the summary switches such as -power_summary, -rail_breakdown, -type_breakdown, -clock_breakdown, -thermal_summary, -battery_life, -opcond_summary, -clock_summary, -instance_breakdown, -activity_summary, -enablerates_summary, and -with_annotation_coverage, plus the filters -power_threshold with -min_power, -filter_instance with -max_instance, -frequency_threshold with -min_frequency, -filter_pin with -max_pin, and the -style, -sortby, and -sortorder presentation options; power_history takes only a .txt filename; and power_activity_map reads a VCD file named by -vcd_file with -partial_parse, -start_time, -end_time, -auto_detect_top_level_name, -top_level_name, -report_type, -report_query, -max_net, -max_cycle, -clock_settings, -glitch_filtering, -glitch_threshold, -auto_construct_clock_domain, -clock_period, and -clock_offset. The timing and timing violations reports are SmartTime-specific and run in batch mode only through run_tool -name {VERIFYTIMING} -script; the guide also names status, pin, flip-flop, I/O bank, and global usage reports without giving their -type spelling, and records -annotated_pins, -stat_pow, and -dyn_pow as removed arguments that now only raise a warning.}
        returns {Not documented in the command reference.}
        example {report -type timing -print_summary no -analysis max \
     -use_slack_threshold yes -slack_threshold 0.50 \
     -print_paths yes -max_paths 3 -max_expanded_paths 0 \
     timing_report.txt}
        example {report -type bottleneck -cost_type path_count -slack_threshold 0 -set_name set1 \
     -max_paths 10 -max_parallel_paths 10 -analysis max -format text bottleneck.txt}
        example {report -type datasheet -format Text datasheet.txt}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command run_designer {
    arity 0..

    option -logfile -takes filename \
           -detail {Filename of the logfile.}
    option -script -takes filename \
           -detail {Script to append to the flow.}
    option -append_commands -takes commands \
           -detail {List of commands to append to the flow.}
    option -adb -takes value -values {new open default} -closed \
           -detail {Creates a new ADB file, opens an existing one, or uses the default ADB file of the Libero SoC project.}
    option -compile -takes value -values {TRUE FALSE} -closed \
           -detail {Runs compile on the design, or proceeds to the next command without it.}
    option -layout -takes value -values {TRUE FALSE} -closed \
           -detail {Runs layout on the design, or proceeds to the next command without it.}
    option -export_ba -takes value -values {TRUE FALSE} -closed \
           -detail {Exports the back-annotate files for the design, or proceeds to the next command without them.}

    form Default {run_designer ?-logfile filename? ?-script filename? ?-append_commands commands? ?-adb value? ?-compile value? ?-layout value? ?-export_ba value?}

    hover {
        summary {Run Designer with the selected compile and layout options.}
        synopsis {run_designer ?-logfile filename? ?-script filename? ?-append_commands commands? ?-adb value? ?-compile value? ?-layout value? ?-export_ba value?}
        description {Runs Designer on a new, existing or default ADB file, optionally running compile and layout and exporting the back-annotate files, and optionally appending a script or a list of commands to the flow.}
        returns {The guide documents no return value.}
        example {run_designer -logfile designerlog2 -adb default -compile TRUE -layout TRUE}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command run_drc {
    arity 0..

    option -netlist -takes file \
           -detail {Name of the netlist file you want the design rule check to evaluate.}
    option -gen_hdl -takes value -values {TRUE FALSE} -closed \
           -detail {Generates an HDL file for your design when TRUE.}

    form Default {run_drc ?-netlist file? ?-gen_hdl value?}

    hover {
        summary {Run the design rule check on your netlist and generate an HDL file.}
        synopsis {run_drc ?-netlist file? ?-gen_hdl value?}
        description {Runs the design rule check over the named netlist and, when -gen_hdl is TRUE, writes an HDL file for the design.}
        returns {The guide does not document a return value.}
        example {run_drc -netlist dsnr3 -gen_hdl TRUE}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command run_simulation {
    arity 0..

    option -logfile -takes name -detail {Name of your simulation logfile.}
    option -wlf -takes name \
           -detail {Name of the WLF file you wish to use; exclusive with -dofile.}
    option -dofile -takes name \
           -detail {Name of the DO file you wish to use; exclusive with -wlf.}
    option -refresh_lib -takes value -values {TRUE FALSE} -closed \
           -detail {Refreshes your simulation library when TRUE.}
    option -state -takes value \
           -values {Pre_Synthesis Post_Synthesis Post_Phy_Synthesis Post_Layout} -closed \
           -detail {Identifies which simulation you want to perform.}

    option_conflict {-wlf -dofile}

    form Default {run_simulation ?-logfile name? ?-wlf name? ?-dofile name? ?-refresh_lib value? ?-state value?}

    hover {
        summary {Run simulation on your project with your default simulation tool.}
        synopsis {run_simulation ?-logfile name? ?-wlf name? ?-dofile name? ?-refresh_lib value? ?-state value?}
        description {Runs the selected simulation stage with the default simulation tool and creates a logfile. The -wlf and -dofile options are mutually exclusive.}
        returns {The guide does not document a return value.}
        example {run_simulation -logfile "Mylog.log" -dofile "Myfile.do" -refresh_lib "TRUE" -state "Post_Layout"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command run_synthesis {
    arity 0..

    option -logfile -takes name -detail {Name of your synthesis logfile.}
    option -target -takes name -detail {Name of your synthesis target file.}

    form Default {run_synthesis ?-logfile name? ?-target name?}

    hover {
        summary {Run synthesis on your project and create a logfile.}
        synopsis {run_synthesis ?-logfile name? ?-target name?}
        description {Runs synthesis with the project's active synthesis profile, writing the named log and target files.}
        returns {The guide does not document a return value.}
        example {run_synthesis -logfile "mysynlogfile" -target "targfile"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command run_tool {
    arity 0..

    option -name -takes tool_name \
           -values {SYNTHESIZE COMPILE SIM_PRESYNTH SIM_POSTSYNTH SIM_POSTLAYOUT PLACEROUTE VERIFYTIMING \
                    VERIFYPOWER GENERATEPROGRAMMINGFILE GENERATE_MEMORY_MAP PROGRAMDEVICE CONFIGURE_CHAIN \
                    SMARTDEBUG SSNANALYZER UPDATE_ENVM UPDATE_UPROM GENERATEPROGRAMMINGDATA EXPORTPIN \
                    EXPORTSDF EXPORTIBIS EXPORTPROGRAMMINGFILE PUBLISHBLOCK SOFTWAREIDE} \
           -detail {Name of the tool to start (required).}
    option -script -takes script_file \
           -detail {Absolute or relative path to a command file passed to the tool, for the tools that support one.}

    form Default {run_tool -name tool_name ?-script script_file?}

    hover {
        summary {Start the specified Libero SoC tool.}
        synopsis {run_tool -name tool_name ?-script script_file?}
        description {Runs one Libero tool with whatever settings configure_tool stored for it; for tools that support command files an optional command file is supplied through -script. Where possible the tool_name matches the name of the tool in Libero SoC, and invoking a tool automatically runs the upstream tools it depends on, so running COMPILE runs synthesis first. Tool names: SYNTHESIZE runs synthesis on the design and accepts -script. COMPILE runs Compile with default or configured settings. SIM_PRESYNTH, SIM_POSTSYNTH and SIM_POSTLAYOUT run pre-synthesis, post-synthesis and post-layout simulation with the default simulation tool. PLACEROUTE runs Layout with default or configured settings. VERIFYTIMING runs timing analysis, with SmartTime-specific commands supplied through -script on SmartFusion2, IGLOO2 and RTG4. VERIFYPOWER runs power analysis, with SmartPower-specific commands supplied through -script. GENERATEPROGRAMMINGFILE generates the bitstream used for programming within Libero, and GENERATEPROGRAMMINGDATA generates the files needed to produce programming bitstream files. GENERATE_MEMORY_MAP exports an XML data sheet describing the root SmartDesign of the project. PROGRAMDEVICE programs the device with the configured parameters. CONFIGURE_CHAIN takes a -script of FlashPro-specific commands and passes them to FlashPro Express to configure the JTAG chain, generating the project-management commands itself. SMARTDEBUG takes a -script of SmartDebug-specific commands. SSNANALYZER takes a -script of Simultaneous Switching Noise commands and generates a noise margin report for I/Os after layout. UPDATE_ENVM, on SmartFusion2 and IGLOO2, and UPDATE_UPROM, on RTG4, take a -script update configuration file that updates the ENVM or UPROM storage clients. EXPORTPIN exports the pin report file after configure_tool -name EXPORTPIN, EXPORTSDF exports the backannotated SDF delay file and Verilog or VHDL netlist, EXPORTIBIS exports the I/O Buffer Information Specification file, and EXPORTPROGRAMMINGFILE runs FlashPro in batch mode to export a STAPL file with all features available in the design. PUBLISHBLOCK publishes block information for the bottom-up block design flow, and SOFTWAREIDE runs SoftConsole, IAR or Keil, whichever is selected in the tool profile.}
        returns {0 on success and 1 on failure.}
        example {run_tool -name {COMPILE}
run_tool \
  -name {SYNTHESIZE} -script {./control_synopsys.tcl}
run_tool \
  -name {VERIFYPOWER} \
  -script {./SmartPower.tcl}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command sample_analog_channel {
    arity 0..

    ;# NOTE(libero): the arguments table names the channel option -name while the
    ;# worked examples write -channel; the arguments spelling is used here.
    option -name -takes name \
           -detail {Specifies the analog channel to be sampled, a channel type followed by a channel index such as AV0, AT0, AC0 or, on SmartFusion, ADC0 (repeatable).}
    option -resolution -takes resolution -values {8 10 12} -closed \
           -detail {ADC conversion resolution, the bit size of the conversion results.}
    option -clock_periods -takes int_value \
           -detail {Sampling time expressed as a count of ADC clock periods.}
    option -clock_divider -takes int_value \
           -detail {Specifies the clock prescaling factor.}
    option -num_samples -takes int_value \
           -detail {Specifies the number of samples the ADC performs, defaulting to 1.}
    option -filtering_factor -takes real_value \
           -detail {Specifies the filtering factor when multiple samples are requested; the default of 1.0 disables digital filtering.}
    option -initial_value -takes int_value \
           -detail {Specifies the initial value of the digital averaging filter in ADC register counts, defaulting to 0.}
    option -show_details -takes show_details -values {yes no} -closed \
           -detail {Specifies the level of the report output, detailed output including the supplied conversion parameters.}
    option -file -takes filename \
           -detail {Specifies the name of the output file for the conversion results.}

    form Default {sample_analog_channel ?-name name...? ?-resolution 8|10|12? ?-clock_periods int_value? ?-clock_divider int_value? ?-num_samples int_value? ?-filtering_factor real_value? ?-initial_value int_value? ?-show_details yes|no? ?-file filename?}

    hover {
        summary {Perform analog-to-digital conversion of a selected analog channel.}
        synopsis {sample_analog_channel ?-name name...? ?-resolution 8|10|12? ?-clock_periods int_value? ?-clock_divider int_value? ?-num_samples int_value? ?-filtering_factor real_value? ?-initial_value int_value? ?-show_details yes|no? ?-file filename?}
        description {SmartDebug command used when debugging the analog subsystem: it samples a pre-configured analog channel with user-supplied ADC conversion parameters and can apply a single-pole low-pass digital filter. A single sample prints one result, and with -show_details yes the detailed ADC register content; multiple samples print a table that also carries the filtered results when filtering is enabled. The maximum number of channels depends on the device type. (SmartFusion and Fusion only.)}
        returns {The empty string.}
        example {sample_analog_channel -name AV0 -resolution 10 -clock_periods 4 \
    -clock_divider 4 -num_samples 10 -filtering_factor 2.5}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command save {
    arity 0

    side_effect FileIo -writes

    form Default {save}

    hover {
        summary {Save all changes made to constraints, options, and sets.}
        synopsis {save}
        description {Commits every change made before this command, including constraint edits, option changes made with set_options, and path sets, into the design project so that place-and-route tools see them.}
        returns {Not documented in the command reference.}
        example {set_options -limit_max_paths 10
read_sdc somefile.sdc
save}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

