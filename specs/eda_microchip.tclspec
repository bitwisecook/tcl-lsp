command timer_get_maxdelay {
    arity 0..

    option -from -takes source_pin -detail {Name of the source pin in the path (required).}
    option -to -takes destination_pin -detail {Name of the destination pin in the path (required).}

    form Default {timer_get_maxdelay -from source_pin -to destination_pin}

    hover {
        summary {Display the maximum delay constraint between two pins in a path.}
        synopsis {timer_get_maxdelay -from source_pin -to destination_pin}
        description {Reports in the Log window the maximum delay constraint that applies between the named source and destination pins.}
        returns {Nothing; the maximum delay constraint is displayed in the Log window.}
        example {timer_get_maxdelay -from {clk166} -to {reg_q_a_9_/U0:CLK}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command timer_get_path {
    arity 0..

    option -from -takes source_pin -detail {Name of the source pin for the path (required).}
    option -to -takes destination_pin -detail {Name of the destination pin for the path (required).}
    option -exp -takes value -values {yes no} -detail {Whether to expand the path.}
    option -sort -takes value -values {actual slack} \
           -detail {Whether to sort the path by the actual delay value or by the slack value.}
    option -order -takes value -values {long short} \
           -detail {Whether the paths are listed by maximum delay analysis, long, or minimum delay analysis, short.}
    option -case -takes value -values {worst typ best} \
           -detail {Whether the report includes worst, typical, or best case timing numbers.}
    option -maxpath -takes maximum_paths -detail {Maximum number of paths to display.}
    option -maxexpath -takes maximum_paths_to_expand -detail {Maximum number of paths to expand.}
    option -mindelay -takes minimum_delay -detail {Path delay in the minimum delay analysis mode.}
    option -maxdelay -takes maximum_delay -detail {Path delay in the maximum delay analysis mode.}
    option -breakatclk -takes value -values {yes no} \
           -detail {Whether to break the paths at the register clock pins.}
    option -breakatclr -takes value -values {yes no} \
           -detail {Whether to break the paths at the register clear pins.}

    form Default {timer_get_path -from source_pin -to destination_pin ?-exp value? ?-sort value? ?-order value? ?-case value? ?-maxpath maximum_paths? ?-maxexpath maximum_paths_to_expand? ?-mindelay minimum_delay? ?-maxdelay maximum_delay? ?-breakatclk value? ?-breakatclr value?}

    hover {
        summary {Display the paths between the specified pins in the Log window.}
        synopsis {timer_get_path -from source_pin -to destination_pin ?-exp value? ?-sort value? ?-order value? ?-case value? ?-maxpath maximum_paths? ?-maxexpath maximum_paths_to_expand? ?-mindelay minimum_delay? ?-maxdelay maximum_delay? ?-breakatclk value? ?-breakatclr value?}
        description {Reports the timing paths running from the source pin to the destination pin, optionally expanded, sorted by actual delay or slack, listed by long or short analysis, and reported under worst, typical, or best case conditions. The path count is bounded by -maxpath and -maxexpath, and -breakatclk and -breakatclr stop paths at register clock and clear pins.}
        returns {Nothing; the paths are displayed in the Log window.}
        example {timer_get_path -from "gearbox_inst/bits64_out_reg<55>/U0:CLK" \
      -to {pma_tx_data_64bit[55]} \
      -exp "yes"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

