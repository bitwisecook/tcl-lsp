command update_storage_client {
    arity 0..

    ;# NOTE(libero): the Syntax block of this section repeats the
    ;# nvm_update_storage_client spelling and writes the arguments generically
    ;# as -params {parm:value}; the section title and the guide's own example
    ;# use update_storage_client with one option per parameter.
    option -client_name -takes value \
           -detail {Name of the uPROM data storage client to update.}
    option -number_of_words -takes value \
           -detail {Number of 36-bit words, a decimal from 1 to 10400.}
    option -use_for_simulation -takes value -values {0 1} -closed \
           -detail {Specifies whether the data storage client is used for simulation.}
    option -base_address -takes value \
           -detail {Client start address, a hexadecimal value from 0 to 0x289F.}
    option -retrieve_address -takes value -values {0 1} -closed \
           -detail {Specifies whether the address is retrieved from a file.}
    option -memory_file_format -takes value \
           -detail {Format of the memory file, documented as Microsemi Binary.}
    option -memory_file -takes value \
           -detail {Absolute or relative path of the memory file.}
    option -content_type -takes value -values {MEMORY_FILE STATIC_FILL NO_CONTENT} -closed \
           -detail {Content type of the client.}

    form Default {update_storage_client ?-client_name value? ?-number_of_words value? ?-use_for_simulation value? ?-base_address value? ?-retrieve_address value? ?-memory_file_format value? ?-memory_file value? ?-content_type value?}

    hover {
        summary {Update an existing uPROM storage client.}
        synopsis {update_storage_client ?-client_name value? ?-number_of_words value? ?-use_for_simulation value? ?-base_address value? ?-retrieve_address value? ?-memory_file_format value? ?-memory_file value? ?-content_type value?}
        description {Updates an existing uPROM storage client for the RTG4 uPROM. The command is usually placed in a configuration .cfg file that is passed to the -script parameter of run_tool. Supported for RTG4.}
        returns {The guide documents no return value.}
        example {update_storage_client \
      -client_name {inc_dat} \
      -number_of_words {10400} \
      -use_for_simulation {0} \
      -content_type {MEMORY_FILE} \
      -memory_file_format {Microsemi-Binary} \
      -memory_file "E:/no-IDE/rtg4_uprom_example/uprom1.mem" \
      -base_address {0}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command use_file {
    arity 0..

    option -file -takes value \
           -detail {EDIF or ADB file you wish to use in the project, given with its full pathname (required).}
    option -module -takes value -detail {Module in which you want to use the file.}
    option -designer_view -takes value \
           -detail {Designer View in which you wish to use the file.}

    form Default {use_file -file value -module value -designer_view value}

    hover {
        summary {Specify which file in your project to use.}
        synopsis {use_file -file value -module value -designer_view value}
        description {Selects the EDIF or ADB file that a given module and Designer View should use.}
        returns {The guide does not document a return value.}
        example {use_file -file "./project/synthesis/file1.edn" -module "top" -designer_view "Impl1"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command use_source_file {
    arity 0..

    option -file -takes value \
           -detail {Verilog or VHDL file, given with its full pathname (required).}
    option -module -takes value -detail {Module in which you want to use the file.}

    form Default {use_source_file -file value -module value}

    hover {
        summary {Define a module for your project from a source file.}
        synopsis {use_source_file -file value -module value}
        description {Selects the Verilog or VHDL source file that defines the named module of the project.}
        returns {The guide does not document a return value.}
        example {use_source_file -file "./project/hdl/file1.vhd" -module "top"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command write_active_probe {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration.}
    option -name -takes probe_name \
           -detail {Specifies the name of the target probe point, which cannot be a search pattern.}
    ;# NOTE(libero): the arguments row gives true and false as the probe values but
    ;# the worked examples also pass low, so the set is left open.
    option -value -takes value -values {true false} \
           -detail {Specifies the value to be written, true for High and false for Low (only with -name).}
    option -group_name -takes group_bus_name \
           -detail {Specifies the group or bus name to write a complete group or bus.}
    option -group_value -takes group_value \
           -detail {Specifies the value for the complete group or bus, in the hex form size'hvalue or the binary form size'bvalue (only with -group_name).}

    form Default {write_active_probe ?-deviceName device_name? ?-name probe_name -value true|false? ?-group_name group_bus_name -group_value value?}

    hover {
        summary {Set a target probe point on the device to the specified value.}
        synopsis {write_active_probe ?-deviceName device_name? ?-name probe_name -value true|false? ?-group_name group_bus_name -group_value value?}
        description {SmartDebug command that drives active probe points: -name with -value writes one probe point, and -group_name with -group_value writes a whole group or bus using a sized hex or binary literal. Both pairs may appear in the same call to write several probes at once. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {write_active_probe -name out[5]:out[5]:Q -value true
write_active_probe -group_name grp1 -group_value "8'hF0"}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command write_lsram {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration or set for debug.}
    option -name -takes block_name \
           -detail {Specifies the name of the target physical block.}
    option -logicalBlockName -takes block_name \
           -detail {Specifies the name of the user-defined memory block for the logical block form.}
    option -port -takes port_name \
           -detail {Specifies the port of the selected memory block, either Port A or Port B (only with -logicalBlockName).}
    option -offset -takes offset_value \
           -detail {Offset, that is the address, of the target word within the memory block (required).}
    option -value -takes value \
           -detail {Nine-bit value to be written to the target location, at most 0x1FF (only with -name).}
    option -logicalValue -takes hexadecimal_value \
           -detail {Hexadecimal value to be written, sized to the width of the selected output port (only with -logicalBlockName).}

    option_conflict {-name -logicalBlockName}

    form Default {write_lsram ?-deviceName device_name? -name block_name|-logicalBlockName block_name ?-port port_name? -offset offset_value -value value|-logicalValue hexadecimal_value}

    hover {
        summary {Write a word into the specified large SRAM location.}
        synopsis {write_lsram ?-deviceName device_name? -name block_name|-logicalBlockName block_name ?-port port_name? -offset offset_value -value value|-logicalValue hexadecimal_value}
        description {SmartDebug command with two forms: the physical block form writes a nine-bit value at an offset within the LSRAM block named by -name, and the logical block form writes a hexadecimal value at an offset in the port of the user-defined block named by -logicalBlockName. The array must be programmed and active, the maximum physical value is 0x1FF, and security locks may disable this function. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {write_lsram -deviceName sf2 -name sram_block1 -offset 16 -value 0x1A
write_lsram -logicalBlockName {Fabric_Logic_0/U2/F_0_F0_U1} -port {Port A} \
    -offset 1 -logicalValue {00FFF}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command write_sdc {
    arity 1..

    option -scenario -takes scenario_name \
           -detail {Scenario to write; the current scenario is written by default.}
    option -pin_separator -takes sep -values {: /} \
           -detail {Pin separator used in the SDC file, either a colon or a slash.}

    side_effect FileIo -writes

    form Default {write_sdc ?-scenario scenario_name? ?-pin_separator sep? file_name}

    hover {
        summary {Write timing constraints into an SDC file.}
        synopsis {write_sdc ?-scenario scenario_name? ?-pin_separator sep? file_name}
        description {Writes the constraints of one timing scenario to the named SDC file. When several constraint scenarios are defined, -scenario selects which one is written; otherwise the current scenario is used.}
        returns {Not documented in the command reference.}
        example {read_sdc first.sdc
read_sdc -add second.sdc
write_sdc merged.sdc}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command write_usram {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration or set for debug.}
    option -name -takes block_name \
           -detail {Specifies the name of the target physical block.}
    option -logicalBlockName -takes block_name \
           -detail {Specifies the name of the user-defined memory block for the logical block form.}
    option -port -takes port_name \
           -detail {Specifies the port of the selected memory block, either Port A or Port B (only with -logicalBlockName).}
    option -offset -takes offset_value \
           -detail {Offset, that is the address, of the target word within the memory block (required).}
    option -value -takes value \
           -detail {Nine-bit value to be written to the target location, at most 0x1FF (only with -name).}
    option -logicalValue -takes hexadecimal_value \
           -detail {Hexadecimal value to be written, sized to the width of the selected output port (only with -logicalBlockName).}

    option_conflict {-name -logicalBlockName}

    form Default {write_usram ?-deviceName device_name? -name block_name|-logicalBlockName block_name ?-port port_name? -offset offset_value -value value|-logicalValue hexadecimal_value}

    hover {
        summary {Write a word into the specified uSRAM location.}
        synopsis {write_usram ?-deviceName device_name? -name block_name|-logicalBlockName block_name ?-port port_name? -offset offset_value -value value|-logicalValue hexadecimal_value}
        description {SmartDebug command with two forms: the physical block form writes a nine-bit value at an offset within the uSRAM block named by -name, and the logical block form writes a hexadecimal value at an offset in the port of the user-defined block named by -logicalBlockName. The array must be programmed and active, the maximum physical value is 0x1FF, and security locks may disable this function. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {write_usram -deviceName sf2 -name usram_block2 -offset 16 -value 0x1A
write_usram -logicalBlockName {Fabric_Logic_0/U3/F_0_F0_U1} -port {Port A} \
    -offset 1 -logicalValue {00FFF}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}
}
