command export_prog_job {
    arity 0..

    option -job_file_name -takes file \
           -detail {Name of the job file, which must start with the design name; the design name is used if omitted.}
    option -export_dir -takes dir \
           -detail {Location where the job file will be saved; the default is the Libero export folder.}
    option -force_rtg4_otp -takes value -values {0 1} -closed \
           -detail {Enforces the use of one-time programming, OTP (RTG4 only).}
    option -bitstream_file_type -takes value -values {TRUSTED_FACILITY MASTER UEK1 UEK2} -closed \
           -detail {Bitstream file included in the programming job; only one bitstream file can be included (SmartFusion2, IGLOO2 only).}
    option -bitstream_file_components -takes value -values {SECURITY FABRIC ENVM} \
           -detail {Space-delimited list of components included in the programming job; SECURITY is available only when the file type is MASTER (SmartFusion2, IGLOO2 only).}

    form Default {export_prog_job ?-job_file_name file? ?-export_dir dir? ?-force_rtg4_otp value? ?-bitstream_file_type value? ?-bitstream_file_components value?}

    hover {
        summary {Configure the parameters for the programming job to be exported.}
        synopsis {export_prog_job ?-job_file_name file? ?-export_dir dir? ?-force_rtg4_otp value? ?-bitstream_file_type value? ?-bitstream_file_components value?}
        description {Exports a programming job. RTG4 devices do not support the security options and accept only -job_file_name, -export_dir, and -force_rtg4_otp. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {The guide does not document a return value.}
        example {export_prog_job \
   -job_file_name {sd1} \
   -export_dir {D:/sd_prj/test3T/designer/sd1/export} \
   -bitstream_file_type {MASTER} \
   -bitstream_file_components {SECURITY FABRIC ENVM}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command export_script {
    arity 0..

    option -file -takes path \
           -detail {Absolute or relative path to the script file to write; there may be multiple -file arguments (required, repeatable).}
    option -relative_path -takes value -values {1 0} -closed \
           -detail {Use 1 for a relative path or 0 for an absolute path in the exported script.}

    form Default {export_script -file path... ?-relative_path value?}

    hover {
        summary {Export the Tcl command equivalents of the current Libero session.}
        synopsis {export_script -file path... ?-relative_path value?}
        description {Explicitly exports the Tcl commands equivalent to the current Libero session to the named file. The optional -relative_path parameter chooses whether an absolute or a relative path is written into the exported script.}
        returns {The guide does not document a return value.}
        example {export_script -file {./exported.tcl} -relative_path 1}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command export_sdc_file {
    arity 0..

    option -file -takes path -detail {Absolute path and name of the .sdc file to export (required).}

    form Default {export_sdc_file -file path}

    hover {
        summary {Export the SDC timing constraint file.}
        synopsis {export_sdc_file -file path}
        description {Exports the Synopsys Design Constraint file for timing constraints; the exported file has a .sdc file name extension. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {0 on success, 1 on failure.}
        example {export_sdc_file -file {E:/designs/export/sd1.sdc}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command export_smart_debug_data {
    arity 0..

    ;# NOTE(libero): the arguments list spells the I/O state component -io_states
    ;# while the worked example writes -ios_states; the arguments spelling is used.
    option -probes -takes flag_value -values {1 0} -closed \
           -detail {Include the probes device component when 1.}
    option -package_pins -takes flag_value -values {1 0} -closed \
           -detail {Include the package pins device component when 1.}
    option -memory_blocks -takes flag_value -values {1 0} -closed \
           -detail {Include the memory blocks device component when 1.}
    option -envm_data -takes flag_value -values {1 0} -closed \
           -detail {Include the eNVM data device component when 1.}
    option -security_data -takes flag_value -values {1 0} -closed \
           -detail {Include the security data device component when 1.}
    option -chain -takes flag_value -values {1 0} -closed \
           -detail {Include the JTAG chain device component when 1.}
    option -programmer_settings -takes flag_value -values {1 0} -closed \
           -detail {Include the programmer settings device component when 1.}
    option -io_states -takes flag_value -values {1 0} -closed \
           -detail {Include the I/O states device component when 1.}
    option -generate_bitstream -takes flag_value -values {1 0} -closed \
           -detail {Generate a bitstream file and include it in the exported file when 1.}
    option -bitstream_security -takes flag_value -values {1 0} -closed \
           -detail {Include the security component in the generated bitstream when 1.}
    option -bitstream_fabric -takes flag_value -values {1 0} -closed \
           -detail {Include the fabric component in the generated bitstream when 1.}
    option -bitstream_envm -takes flag_value -values {1 0} -closed \
           -detail {Include the eNVM component in the generated bitstream when 1.}
    option -file_name -takes file \
           -detail {Name of the exported file, which carries the extension ddc.}
    option -export_dir -takes dir \
           -detail {Location the DDC file is exported to; the design export folder is used when omitted.}
    option -force_rtg4_otp -takes flag_value -values {0 1} -closed \
           -detail {Enforces the use of one-time programming (OTP) when 1.}

    side_effect FileIo -writes

    form Default {export_smart_debug_data ?device_components? ?bitstream_components? ?-file_name file? ?-export_dir dir? ?-force_rtg4_otp 0|1?}

    hover {
        summary {Export debug data for the SmartDebug application.}
        synopsis {export_smart_debug_data ?device_components? ?bitstream_components? ?-file_name file? ?-export_dir dir? ?-force_rtg4_otp 0|1?}
        description {Corresponds to the Export SmartDebug Data tool in Libero: writes a ddc file holding the selected device components, which SmartDebug uses to create a new project or import into a device. When no design component is specified every component available in the design is included. -generate_bitstream is required to generate a bitstream file and include it in the exported file; the bitstream components to include must then be named, and a design with custom security must include the custom security bitstream component. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {export_smart_debug_data \
    -file_name {sd1} \
    -force_rtg4_otp 1 \
    -probes 1 \
    -memory_blocks 1 \
    -generate_bitstream 0}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

