}

command smartpower_voltage_opcond_set_mode_specific {
    arity 0..

    option -opmode -takes value -values {Active Standby Flash*Freeze} \
           -detail {Specifies the operating mode whose voltages are set.}
    option -voltage -takes value \
           -values {VDD {VDDI 2.5} VPP VCCA {VCCI 3.3} {VCCI 2.5} {VCCI 1.8} {VCCI 1.5} VCC33A VCCDA} \
           -detail {Specifies the voltage supply whose mode-specific operating conditions are set.}
    option -best -takes value -detail {Specifies the best voltage used for mode-specific operating conditions.}
    option -typical -takes value \
           -detail {Specifies the typical voltage used for mode-specific operating conditions.}
    option -worst -takes value -detail {Specifies the worst voltage used for mode-specific operating conditions.}

