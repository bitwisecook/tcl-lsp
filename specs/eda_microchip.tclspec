command smartpower_set_mode_for_pdpr {
    arity 0..

    option -opmode -takes value \
           -detail {Specifies a valid operating mode to use for power driven place and route (required).}

    form Default {smartpower_set_mode_for_pdpr -opmode value}

    hover {
        summary {Set the operating mode used by Power Driven Place and Route.}
        synopsis {smartpower_set_mode_for_pdpr -opmode value}
        description {Sets the operating mode that the Power Driven Place and Route (PDPR) tool uses during power optimization. The value must name a valid operating mode, which may be a custom mode created beforehand.}
