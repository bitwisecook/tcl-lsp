        synopsis {smartpower_set_process ?-process value?}
        description {Sets the process used in SmartPower to one of the pre-defined types, Typical or Maximum. The guide documents this command only in the SmartFusion2, IGLOO2 and RTG4 chapter.}
        returns {The empty string.}
        example {smartpower_set_process -process {Typical}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

