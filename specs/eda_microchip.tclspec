    arity 0..

    option -opmode -takes value -values {Active Standby Flash*Freeze} \
           -detail {Specifies the operating mode whose temperatures are set.}
    option -thermal_mode -takes value -values {ambient opcond} \
           -detail {Specifies how the junction temperature is computed: iteratively with total static power for ambient, or from the device selection operating condition range for opcond.}
    option -best -takes value \
           -detail {Specifies the best temperature in degrees Celsius for the selected mode.}
    option -typical -takes value \
           -detail {Specifies the typical temperature in degrees Celsius for the selected mode.}
    option -worst -takes value \
           -detail {Specifies the worst temperature in degrees Celsius for the selected mode.}

    form Default {smartpower_temperature_opcond_set_mode_specific ?-opmode value? ?-thermal_mode value? ?-best value? ?-typical value? ?-worst value?}

    hover {
        summary {Set the temperature for SmartPower mode-specific operating conditions.}
        synopsis {smartpower_temperature_opcond_set_mode_specific ?-opmode value? ?-thermal_mode value? ?-best value? ?-typical value? ?-worst value?}
        description {Sets the best, typical and worst temperatures, in degrees Celsius, for the operating mode named by -opmode, and selects with -thermal_mode whether the junction temperature is computed iteratively from the total static power or taken from the device selection operating condition range.}
        returns {The empty string.}
        example {smartpower_temperature_opcond_set_mode_specific -opmode {mode1} -best {20} \
    -typical {30} -worst {60}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_voltage_opcond_set_design_wide {
    arity 0..

    option -voltage -takes value \
           -values {VDD {VDDI 2.5} VPP VCCA {VCCI 3.3} {VCCI 2.5} {VCCI 1.8} {VCCI 1.5} VCC33A VCCDA} \
           -detail {Specifies the voltage supply whose design-wide operating conditions are set.}
    option -best -takes value -detail {Specifies the best voltage used for design-wide operating conditions.}
    option -typical -takes value \
