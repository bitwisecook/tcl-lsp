    form Default {set_as_target -type constraint_file_type -file constraint_file_path}

    hover {
        summary {Set an SDC, PDC or FDC file as the target constraint file.}
        synopsis {set_as_target -type constraint_file_type -file constraint_file_path}
        description {Marks one constraint file as the target that receives and stores new constraints of that type. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {0 on success and 1 on failure.}
        example {set_as_target -type {sdc} -file {./constraint/user.sdc}}
        source {Libero SoC v11.8 Tcl Command Reference}
