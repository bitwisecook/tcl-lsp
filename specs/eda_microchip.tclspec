    form Default {remove_input_delay ?-clock clock_name port_pin_list? ?-id constraint_ID?}

    hover {
        summary {Remove an input delay from a clock and port, or by constraint ID.}
        synopsis {remove_input_delay ?-clock clock_name port_pin_list? ?-id constraint_ID?}
        description {Removes the input delay assigned to the named ports for the named clock in the current scenario, or the constraint named by -id, never both. The command fails when the clock and port names match no input delay constraint or the ID does not refer to one, and wildcards may not be used in a clock name, alone or inside an accessor command.}
        returns {Not documented in the command reference.}
        example {remove_input_delay -clock [get_clocks CLK1] [get_ports data1]}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

