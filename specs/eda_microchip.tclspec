}

command loopback_test {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration or set for debug.}
    option -start \
           -detail {Starts the loopback test.}
    option -stop \
           -detail {Stops the loopback test.}
    option -serdes -takes num \
           -detail {SERDES block number, between 0 and 4 and varying between dies (required).}
    option -lane -takes num \
           -detail {SERDES lane number, between 0 and 4 (required).}
    ;# NOTE(libero): the arguments table names only meso as a loopback type while
    ;# the worked examples also pass plesio and parallel, so the set is left open.
    option -type -takes loopback_type -values {meso plesio parallel} \
           -detail {Specifies the loopback test type, meso being PCS Far End PMA RX to TX loopback (only with -start).}

    option_conflict {-start -stop}

    form Default {loopback_test ?-deviceName device_name? -start|-stop -serdes num -lane num ?-type LoopbackType?}

    hover {
        summary {Start or stop a SERDES loopback test.}
        synopsis {loopback_test ?-deviceName device_name? -start|-stop -serdes num -lane num ?-type LoopbackType?}
        description {SmartDebug command that runs a loopback test on one lane of one SERDES block. -start begins the test of the type named by -type and -stop ends it; both forms require the block and lane numbers. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {loopback_test -start -serdes 1 -lane 1 -type meso
loopback_test -stop -serdes 1 -lane 2}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command move_to_probe_group {
    arity 0..

    option -name -takes probe_name \
           -detail {Specifies one or more probes to move (required, repeatable).}
    option -group -takes group_name \
           -detail {Specifies the name of the destination probe group (required).}

    form Default {move_to_probe_group -name probe_name... -group group_name}

    hover {
        summary {Move the specified probe points to a probe group.}
        synopsis {move_to_probe_group -name probe_name... -group group_name}
        description {SmartDebug command that detaches the named probe points from their current group and associates them with the group named by -group. Probe points belonging to a bus cannot be moved to another group. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {move_to_probe_group -name out[5]:out[5]:Q \
    -name grp1.out[3]:out[3]:Q \
    -group my_grp2}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command new_design {
    arity 0..

    option -name -takes design_name \
           -detail {Name of the design, used as the base name for most of the files Designer generates (required).}
    option -family -takes family_name \
           -detail {Microsemi SoC device family the design is targeted at (required).}
    option -path -takes path_name \
           -detail {Physical path of the directory in which the design files are created (required).}
    option -block -takes value -values {on off} -closed \
           -detail {Enables or disables Block mode.}

    form Default {new_design -name design_name -family family_name -path path_name ?-block value?}

    hover {
        summary {Create a new design.}
        synopsis {new_design -name design_name -family family_name -path path_name ?-block value?}
        description {Creates a new design and sets up the Designer software for importing design source files; the name, family and path arguments are all required.}
        returns {The guide documents no return value; a failure is a catchable Tcl error.}
        example {new_design -name "test" -family "ACT3" -path {.}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command new_project {
    arity 0..

    option -name -takes project_name \
           -detail {Name of the project, used as the base name for most of the files generated from Libero SoC (required).}
    option -use_enhanced_constraint_flow -takes value -values {1 0} -closed \
           -detail {Set to 1 to use the Enhanced Constraint Flow or 0 to use the Classic Constraint Flow.}
    option -location -takes project_location \
           -detail {Location of the project, which must not be an existing directory.}
    option -project_description -takes project_description \
           -detail {A brief text description of the design in your project.}
    option -family -takes family_name -detail {Microsemi SoC device family for your targeted design.}
    option -die -takes device_die -detail {Die for your targeted design.}
    option -package -takes package_name -detail {Package for your targeted design.}
    option -hdl -takes HDL_type -values {VHDL VERILOG} -closed \
           -detail {Sets the HDL type for your new project.}
    option -speed -takes speed_grade \
           -detail {Speed grade for your project; the possible values depend on your device, die and package.}
    option -die_voltage -takes value \
           -detail {Die voltage for your project; the possible values depend on your device.}
    option -adv_options -takes value \
           -detail {Sets one advanced option in name:value form, such as an operating condition, an I/O default standard, a PLL supply, or a voltage or temperature range (repeatable).}
    option -standalone_peripheral_initialization -takes value -values {1 0} -closed \
           -detail {Set to 1 to build your own peripheral initialization logic in SmartDesign for MDDR, FDDR and SERDES, or 0 to let System Builder build the initialization circuitry (SmartFusion2 and IGLOO2 only).}
    option -block_mode -takes value -values {1 0} -closed \
           -detail {Enter 1 to enable or 0, the default, to disable design block creation.}
    option -instantiate_in_smartdesign -takes value -values {1 0} -closed \
           -detail {Enter 1 to auto-instantiate a System Builder or MSS component in a SmartDesign component upon creation, or 0 to disable it.}

    form Default {new_project -name project_name ?-use_enhanced_constraint_flow value? ?-location project_location? ?-project_description text? ?-family family_name? ?-die device_die? ?-package package_name? ?-hdl HDL_type? ?-speed speed_grade? ?-die_voltage value? ?-adv_options value...? ?-standalone_peripheral_initialization value? ?-block_mode value? ?-instantiate_in_smartdesign value?}

    hover {
        summary {Create a new project in Libero SoC.}
        synopsis {new_project -name project_name ?-use_enhanced_constraint_flow value? ?-location project_location? ?-project_description text? ?-family family_name? ?-die device_die? ?-package package_name? ?-hdl HDL_type? ?-speed speed_grade? ?-die_voltage value? ?-adv_options value...? ?-standalone_peripheral_initialization value? ?-block_mode value? ?-instantiate_in_smartdesign value?}
        description {Creates a new Libero SoC project with the given device targeting and HDL type. If no location is given, Libero SoC saves the new project in your current working directory. The Enhanced Constraint Flow selected by -use_enhanced_constraint_flow provides a single centralized view for importing, linking, editing, checking and creating design constraints and associating them with the Libero tools. Advanced options are passed one name:value pair per -adv_options.}
        returns {The guide does not document a return value.}
        example {new_project -location {./designs/mydesign} -name {mydesign} \
  -use_enhanced_constraint_flow 1 -hdl {VERILOG} -family {SmartFusion2} \
  -die {M2S150TS} -package {FCS536} -speed {-1} -die_voltage {1.2} \
  -adv_options {TEMPR:IND}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command nvm_update_serialization_client {
    arity 0..

    ;# NOTE(libero): the Syntax block writes the arguments generically as
    ;# -params {parm:value}; the rows below are the parameter names the guide
    ;# tabulates and its own example passes as options.
    option -client_name -takes value \
           -detail {Name of the eNVM serialization client to update.}
    option -number_of_words -takes value \
           -detail {Number of words, given as a decimal; the range is device dependent.}
    option -use_for_simulation -takes value -values {0 1} -closed \
           -detail {Specifies whether the serialization client is used for simulation.}
    option -base_address -takes value \
           -detail {Client base address, given as a hexadecimal numeral; the range is device dependent.}
    option -maximum_devices_to_program -takes value \
           -detail {Maximum number of devices to program; see the eNVM Configuration User Guide for the range.}
    option -reprogram -takes value -values {0 1} -closed \
           -detail {Specifies whether the client is re-programmed.}
    option -content_from_file -takes value -values {0 1} -closed \
           -detail {Specifies whether the content is taken from a file.}
    option -number_of_pages -takes value \
           -detail {Number of pages, given as a decimal.}
    option -content_file -takes value \
           -detail {Absolute or relative path to the content file.}
    option -content_file_format -takes value -values {Decimal Hexadecimal} -closed \
           -detail {Format of the content file.}
    option -jtag_read -takes value -values {0 1} -closed \
           -detail {Specifies whether the serialization client is used for jtag_read (not for SmartFusion2 and IGLOO2).}
    option -jtag_write -takes value -values {0 1} -closed \
           -detail {Specifies whether the serialization client is used for jtag_write (not for SmartFusion2 and IGLOO2).}
    option -start_value -takes value \
           -detail {Start value of the serialization sequence.}
    option -step_value -takes value \
           -detail {Step value of the serialization sequence.}
    option -maximum_value -takes value \
           -detail {Maximum value of the serialization sequence; see the eNVM Configuration User Guide for the range.}
    option -use_as_rom -takes value -values {0 1} -closed \
           -detail {Specifies whether the serialization client is used as ROM.}

    form Default {nvm_update_serialization_client ?-client_name value? ?-number_of_words value? ?-use_for_simulation value? ?-base_address value? ?-maximum_devices_to_program value? ?-reprogram value? ?-content_from_file value? ?-number_of_pages value? ?-content_file value? ?-content_file_format value? ?-jtag_read value? ?-jtag_write value? ?-start_value value? ?-step_value value? ?-maximum_value value? ?-use_as_rom value?}

    hover {
        summary {Update an existing serialization client in the eNVM.}
        synopsis {nvm_update_serialization_client ?-client_name value? ?-number_of_words value? ?-use_for_simulation value? ?-base_address value? ?-maximum_devices_to_program value? ?-reprogram value? ?-content_from_file value? ?-number_of_pages value? ?-content_file value? ?-content_file_format value? ?-jtag_read value? ?-jtag_write value? ?-start_value value? ?-step_value value? ?-maximum_value value? ?-use_as_rom value?}
        description {Updates an existing serialization client in the SmartFusion2 and IGLOO2 eNVM. The command is usually placed in a configuration .cfg file that is passed to the -script parameter of run_tool -name UPDATE_ENVM. Supported for SmartFusion2, IGLOO2 and SmartFusion.}
        returns {The guide documents no return value.}
        example {nvm_update_serialization_client \
-client_name {d1} \
-maximum_value {12}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command nvm_update_storage_client {
    arity 0..

    ;# NOTE(libero): the Syntax block writes the arguments generically as
    ;# -params {parm:value}; the rows below are the parameter names the guide
    ;# tabulates and its own example passes as options.
    option -client_name -takes value \
           -detail {Name of the eNVM data storage client to update.}
    option -word_size -takes value -values {8 16 32} -closed \
           -detail {Number of bits in each word.}
    option -number_of_words -takes value \
           -detail {Number of words; the range is device dependent.}
    option -use_for_simulation -takes value -values {0 1} -closed \
           -detail {Specifies whether the data storage client is used for simulation.}
    option -base_address -takes value \
           -detail {Client start address, given as a hexadecimal numeral; the range is device dependent.}
    option -retrieve_address -takes value -values {0 1} -closed \
           -detail {Specifies whether the address is retrieved from a file.}
    option -reprogram -takes value -values {0 1} -closed \
           -detail {Specifies whether the data storage client is re-programmed.}
    option -memory_file_format -takes value -values {INTELHEX MOTOROLAS SIMPLEHEX BINARY} -closed \
           -detail {Format of the memory file.}
    option -memory_file -takes value \
           -detail {Absolute or relative path of the memory file.}
    option -content_type -takes value -values {MEMORY_FILE STATIC_FILL NO_CONTENT 0 1 2} \
           -detail {Content type, given either by name or by the equivalent number.}
    option -jtag_read -takes value -values {0 1} -closed \
           -detail {Specifies whether the data storage client is used for jtag_read (not for SmartFusion2 and IGLOO2).}
    option -jtag_write -takes value -values {0 1} -closed \
           -detail {Specifies whether the data storage client is used for jtag_write (not for SmartFusion2 and IGLOO2).}
    option -lock_address -takes value -values {0 1} -closed \
           -detail {Locks the start address of the client so it cannot be changed during optimization.}
    option -is_spare_page -takes value -values {0 1} -closed \
           -detail {Specifies whether the client is a spare page (not for SmartFusion2 and IGLOO2).}
    option -static_fill_pattern -takes value \
           -detail {Static fill pattern, a string consisting of 0 and 1.}
    option -use_as_rom -takes value -values {0 1} -closed \
           -detail {Specifies whether the data storage client is used as ROM.}

    form Default {nvm_update_storage_client ?-client_name value? ?-word_size value? ?-number_of_words value? ?-use_for_simulation value? ?-base_address value? ?-retrieve_address value? ?-reprogram value? ?-memory_file_format value? ?-memory_file value? ?-content_type value? ?-jtag_read value? ?-jtag_write value? ?-lock_address value? ?-is_spare_page value? ?-static_fill_pattern value? ?-use_as_rom value?}

    hover {
        summary {Update an existing data storage client in the eNVM.}
        synopsis {nvm_update_storage_client ?-client_name value? ?-word_size value? ?-number_of_words value? ?-use_for_simulation value? ?-base_address value? ?-retrieve_address value? ?-reprogram value? ?-memory_file_format value? ?-memory_file value? ?-content_type value? ?-jtag_read value? ?-jtag_write value? ?-lock_address value? ?-is_spare_page value? ?-static_fill_pattern value? ?-use_as_rom value?}
        description {Updates an existing data storage client in the SmartFusion2 and IGLOO2 eNVM. The command is usually placed in a configuration .cfg file that is passed to the -script parameter of run_tool -name UPDATE_ENVM. Supported for SmartFusion2, IGLOO2 and SmartFusion.}
        returns {The guide documents no return value.}
        example {nvm_update_storage_client \
-client_name {c1} \
-word_size 32 \
-number_of_words 512}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command open_design {
    arity 1

    side_effect FileIo -reads

    form Default {open_design file_name}

    hover {
        summary {Open an existing design in Designer.}
        synopsis {open_design file_name}
        description {Opens the design held in the named ADB file; when the complete path is not given the directory is assumed to be the current working directory. All previously open designs must be closed before a new one is opened.}
        returns {The guide documents no return value; a failure is a catchable Tcl error.}
        example {open_design {test.adb}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command open_project {
    arity 1..

    option -do_backup_on_convert -takes value -values {TRUE FALSE} -closed \
           -detail {Creates a backup of your original project before opening when the project was created in a previous version of Libero SoC.}
    option -backup_file -takes backup_filename \
           -detail {Name of your backup file, if you choose to back up on convert.}

    form Default {open_project project_name ?-do_backup_on_convert value? ?-backup_file backup_filename?}

    hover {
        summary {Open an existing Libero SoC project.}
        synopsis {open_project project_name ?-do_backup_on_convert value? ?-backup_file backup_filename?}
        description {Opens the project named by the .prj file path. The path should be complete; without it Libero SoC infers that you want to open the project from your current working directory.}
        returns {The guide does not document a return value.}
        example {open_project c:/netlists/test/project.prj}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command organize_cdbs {
    arity 0..

    option -file -takes name -detail {Name of the CDB file you intend to organize (required).}
    option -module -takes name \
           -detail {Name of the module to which you wish to add the CDB file (required).}

    form Default {organize_cdbs -file name -module name}

    hover {
        summary {Organize the CDB files in your project.}
        synopsis {organize_cdbs -file name -module name}
        description {Associates a CDB file with a module of the current project.}
        returns {The guide does not document a return value.}
        example {organize_cdbs -file design2.cdb -module design_test}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command organize_constraints {
    arity 0..

    option -file -takes name -detail {Name of the constraint file to organize (repeatable).}
    option -mode -takes value -values {new add remove} -closed \
           -detail {Whether you are creating a new association, adding to one, or removing one.}
    option -designer_view -takes name \
           -detail {Name of the Designer View in which you wish to add the constraint file, such as impl1 (required).}
    option -module -takes value -detail {Name of the module (required).}
    option -tool -takes value -values {synthesis designer phsynth} -closed \
           -detail {Identifies the intended use for the file: synthesis, Designer, or physical synthesis (required).}

    form Default {organize_constraints ?-file name...? ?-mode value? -designer_view name -module value -tool value}

    hover {
        summary {Organize the constraint files in your project.}
        synopsis {organize_constraints ?-file name...? ?-mode value? -designer_view name -module value -tool value}
        description {Associates constraint files with a Designer View and a module, marking which Libero tool is to consume them.}
        returns {The guide does not document a return value.}
        example {organize_constraints -file delta.vhd -mode new -designer_view impl2 -module constraint -tool designer}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command organize_sources {
    arity 0..

    option -file -takes name -detail {Name of the source file to organize (repeatable).}
    option -mode -takes value -values {new add remove} -closed \
           -detail {Whether you are creating a new association, adding to one, or removing one.}
    option -module -takes value -detail {Name of the module (required).}
    option -tool -takes value -values {synthesis simulation} -closed \
           -detail {Identifies the intended use for the file, synthesis or simulation (required).}
    option -use_default -takes value -values {TRUE FALSE} -closed \
           -detail {Uses the default values for synthesis or simulation when TRUE, or user-defined values when FALSE.}

    form Default {organize_sources ?-file name...? ?-mode value? -module value -tool value ?-use_default value?}

    hover {
        summary {Organize the source files in your project.}
        synopsis {organize_sources ?-file name...? ?-mode value? -module value -tool value ?-use_default value?}
        description {Associates source files with a module and marks whether they are consumed by synthesis or by simulation, optionally using the default settings for that tool.}
        returns {The guide does not document a return value.}
        example {organize_sources -file stim.vhd -mode new -module stimulus -tool synthesis -use_default TRUE}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command organize_tool_files {
    arity 0..

    option -tool -takes tool_name \
           -values {SYNTHESIZE PLACEROUTE SIM_PRESYNTH SIM_POSTSYNTH SIM_POSTLAYOUT VERIFYTIMING} \
           -closed -detail {Names the tool whose files you want to organize (required).}
    option -params -takes tool_parameters -detail {Tool parameters.}
    option -file -takes path \
           -detail {Absolute or relative path to the constraint file; there may be multiple -file arguments (repeatable).}
    option -module -takes module \
           -detail {Module definition, whose format is design::work.}
    option -input_type -takes value \
           -values {constraint source simulation stimulus unknown} -closed \
           -detail {Type of the input file.}

    form Default {organize_tool_files -tool tool_name ?-params tool_parameters? ?-file path...? ?-module module? ?-input_type value?}

    hover {
        summary {Specify the constraint files passed to and used by a Libero tool.}
        synopsis {organize_tool_files -tool tool_name ?-params tool_parameters? ?-file path...? ?-module module? ?-input_type value?}
        description {Binds a set of files of one input type to one Libero tool for one module. Supported on SmartFusion, IGLOO, ProASIC3, Fusion, SmartFusion2, IGLOO2, and RTG4.}
        returns {The guide does not document a return value.}
        example {organize_tool_files \
   -tool {VERIFYTIMING} \
   -file {D:/Designs/my_proj/constraints/test_derived.sdc} \
   -file {D:/Designs/my_proj/constraints/user.sdc} \
   -module {sd1::work} \
   -input_type {constraint}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command pin_assign {
    arity 0..

    option -nofix \
           -detail {Unlocks the pin assignment, which is locked by default.}
    option -port -takes portname \
           -detail {Name of the port to which the pin or the attributes are assigned (required).}
    option -pin -takes pin_number \
           -detail {Alphanumeric number of the pin to assign.}
    ;# NOTE(libero): the -iostd values are family dependent, so the set is not
    ;# closed; the guide also notes that LVDS and LVPECL cannot be set through
    ;# a script.
    option -iostd -takes value \
           -values {CMOS CUSTOM GTLP25 GTLP33 GTL33 GTL25 HSTL1 HSTLII LVCMOS33 LVCMOS25 LVCMOS25_50 LVCMOS18 LVCMOS15 LVCMOS12 LVTTL TTL PCI PCIX SSTL2I SSTL2II SSTL3I SSTL3II} \
           -detail {I/O standard for this pin, which also sets other attributes such as slew rate and output loading and which unassigns the I/O when it is incompatible with the rest of its I/O bank.}
    option -iothresh -takes value -values {CMOS LVTTL PCI} \
           -detail {Compatible threshold level for inputs and outputs, defaulting to the one implied by the I/O standard and referred to as Loading in some families.}
    option -slew -takes value -values {high low} -closed \
           -detail {Output slew rate, which affects falling edges only and is available for LVTTL, PCI and PCIX outputs, where PCI and PCIX accept high only.}
    option -res_pull -takes value -values {up down none} -closed \
           -detail {Includes a weak resistor for pull-up or pull-down of the input buffer, or none.}
    ;# NOTE(libero): the Syntax block spells this -outload while the Arguments
    ;# row heads it -out_load; the Syntax spelling is used here.
    option -outload -takes value \
           -detail {Output capacitance in whole picofarads used by Timer as the loading on the output pin, defaulting to 35pF (SmartFusion, ProASIC3 and Fusion only).}

    form Default {pin_assign ?-nofix? -port portname ?-pin pin_number? ?-iostd value? ?-iothresh value? ?-slew value? ?-res_pull value? ?-outload value?}

    hover {
        summary {Assign a pin to a port, or assign I/O attributes to a port.}
        synopsis {pin_assign ?-nofix? -port portname ?-pin pin_number? ?-iostd value? ?-iothresh value? ?-slew value? ?-res_pull value? ?-outload value?}
        description {Has two shapes: with -pin it assigns the named package pin to the named port, locking the assignment unless -nofix is given; with the attribute options it assigns the I/O standard, threshold, slew, resistor pull and output load to the named port. pin_commit must follow to save the changes to the design. A port name containing square brackets must be enclosed in braces or have each bracket preceded by a backslash.}
        returns {The guide documents no return value.}
        example {pin_assign -port usw0 -pin A2
pin_commit}
        example {pin_assign -port usw0 -iostd LVTTL -slew low -res_pull down
pin_commit}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command pin_commit {
    arity 0

    form Default {pin_commit}

    hover {
        summary {Save the pin assignments to the design file.}
        synopsis {pin_commit}
        description {Writes the pending pin assignments into the design .adb file. It takes no arguments and must be added to the end of a script that changes pin assignments.}
        returns {The guide does not document a return value.}
        example {pin_commit}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command pin_fix {
    arity 0..

    option -port -takes portname \
           -detail {Name of the port whose pin must be locked at its assigned location; only one pin can be assigned to a port (required).}

    form Default {pin_fix -port portname}

    hover {
        summary {Lock the pin assignment for the specified port.}
        synopsis {pin_fix -port portname}
        description {Fixes the pin assigned to the named port so it cannot be moved during place-and-route. Use pin_commit afterwards to save the change to your design.}
        returns {The guide does not document a return value.}
        example {pin_fix -port clk
pin_commit}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command pin_fix_all {
    arity 0

    form Default {pin_fix_all}

    hover {
        summary {Lock all the assigned pins on the device.}
        synopsis {pin_fix_all}
        description {Fixes every assigned pin in the design so none can be moved during place-and-route. It takes no arguments; use pin_commit afterwards to save the change.}
        returns {The guide does not document a return value.}
        example {pin_fix_all
pin_commit}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command pin_unassign {
    arity 0..

    option -port -takes portname \
           -detail {Name of the port for which the pin must be unassigned (required).}

    form Default {pin_unassign -port portname}

    hover {
        summary {Unassign the pin from the specified port.}
        synopsis {pin_unassign -port portname}
        description {Frees the pin assigned to the named port so its location becomes available to other ports; only one pin can be assigned to a port. Use pin_commit afterwards to save the change.}
        returns {The guide does not document a return value.}
        example {pin_unassign -port "clk"
pin_commit}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command pin_unassign_all {
    arity 0

    form Default {pin_unassign_all}

    hover {
        summary {Unassign all the pins from all the ports.}
        synopsis {pin_unassign_all}
        description {Frees every pin assignment so all pin locations become available for assignment. It takes no arguments; use pin_commit afterwards to save the change.}
        returns {The guide does not document a return value.}
        example {pin_unassign_all
pin_commit}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command prbs_test {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration or set for debug.}
    option -start \
           -detail {Starts the PRBS test.}
    option -stop \
           -detail {Stops the PRBS test.}
    option -reset_counter \
           -detail {Resets the PRBS error count value to 0.}
    option -read_counter \
           -detail {Reads and prints the error count value.}
    option -serdes -takes num \
           -detail {SERDES block number, between 0 and 4 and varying between dies (required).}
    option -lane -takes num \
           -detail {SERDES lane number, between 0 and 4 (required).}
    option -near \
           -detail {Selects the near-end, on-die option for the PRBS test; omitting it implies off-die.}
    ;# NOTE(libero): the arguments table lists only the four prbs patterns while the
    ;# worked examples also pass custom and user, so the set is left open.
    option -pattern -takes pattern_type -values {prbs7 prbs11 prbs23 prbs31} \
           -detail {The pattern sequence to use for the PRBS test (only with -start).}
    ;# NOTE(libero): -value appears only in this command's worked examples, paired
    ;# with the custom and user patterns; it has no arguments-table row.
    option -value -takes pattern_value \
           -detail {Pattern payload for a custom or user pattern, shown only in the guide's examples (only with -pattern).}

    option_conflict {-start -stop -reset_counter -read_counter}

    form Default {prbs_test ?-deviceName device_name? -start|-stop|-reset_counter|-read_counter -serdes num -lane num ?-near? ?-pattern PatternType? ?-value pattern_value?}

    hover {
        summary {Start, stop, reset or read the error counter of a SERDES PRBS test.}
        synopsis {prbs_test ?-deviceName device_name? -start|-stop|-reset_counter|-read_counter -serdes num -lane num ?-near? ?-pattern PatternType? ?-value pattern_value?}
        description {SmartDebug command that drives the pseudo-random bit sequence test on one lane of one SERDES block. Exactly one action is given per call: -start runs the test with the pattern named by -pattern, optionally near-end with -near, -stop ends it, -reset_counter zeroes the error count and -read_counter reads and prints it. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string, or the error count for -read_counter.}
        example {prbs_test -start -serdes 1 -lane 0 -near -pattern prbs11
prbs_test -read_counter -serdes 1 -lane 0}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command program_probe_insertion {
    arity 0

    form Default {program_probe_insertion}

    hover {
        summary {Run the probe insertion flow on the selected nets.}
        synopsis {program_probe_insertion}
        description {SmartDebug command that takes no arguments and programs the device with the probe insertion points previously registered by add_probe_insertion_point. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command project_settings {
    arity 0..

    option -hdl -takes value -values {VHDL VERILOG} -closed -detail {Sets your project HDL type.}
    option -verilog_mode -takes value -values {VERILOG_2K SYSTEM_VERILOG} -closed \
           -detail {Sets the Verilog standard to Verilog-2001 or System Verilog.}
    option -vhdl_mode -takes value -values {VHDL_2008 VHDL_93} -closed \
           -detail {Sets the VHDL standard to VHDL-2008 or VHDL-1993.}
    option -auto_update_modelsim_ini -takes value -values {TRUE FALSE} -closed \
           -detail {Updates the modelsim.ini file automatically when TRUE.}
    option -auto_update_viewdraw_ini -takes value -values {TRUE FALSE} -closed \
           -detail {Updates the viewdraw.ini file automatically when TRUE.}
    option -block_mode -takes value -values {TRUE FALSE} -closed \
           -detail {Puts the Project Manager in Block mode so you can create blocks in your project.}
    option -vm_netlist_flow -takes value -values {TRUE FALSE 1 0} -closed \
           -detail {Set to TRUE to generate a Verilog netlist from synthesis; the default is FALSE (SmartFusion2 and IGLOO2 only).}
    option -auto_generate_synth_hdl -takes value -values {TRUE FALSE} -closed \
           -detail {Auto-generates your HDL file after synthesis when TRUE.}
    option -auto_run_drc -takes value -values {TRUE FALSE} -closed \
           -detail {Auto-runs the design rule check immediately after synthesis when TRUE.}
    option -auto_generate_viewdraw_hdl -takes value -values {TRUE FALSE} -closed \
           -detail {Auto-generates your HDL netlist after a Save and Check in ViewDraw when TRUE.}
    option -auto_file_detection -takes value -values {TRUE FALSE} -closed \
           -detail {Automatically detects new files added to the Libero SoC project folder when TRUE.}
    option -standalone_peripheral_initialization -takes value -values {1 0} -closed \
           -detail {Set to 1 to instruct System Builder not to build the initialization circuitry for your MDDR, FDDR and SERDES peripherals so you can build your own in SmartDesign.}
    option -instantiate_in_smartdesign -takes value -values {1 0} -closed \
           -detail {Enter 1 to auto-instantiate a System Builder or MSS component in a SmartDesign component upon creation, or 0 to disable it.}
    option -enable_design_separation -takes value -values {1 0} -closed \
           -detail {Set to 1 for security and safety critical designs whose blocks must be physically and programmatically separate, which makes Libero generate the MSVT.param file used by the Microsemi Separation Verification Tool.}
    option -enable_set_mitigation -takes value -values {1 0} -closed \
           -detail {Turns the Single Event Transient filters on globally to mitigate radiation-induced transients; the default is 0 and the option is available for RTG4 devices only.}
    option -display_fanout_limit -takes integer \
           -detail {Limit of high fanout nets displayed in the compile netlist log; the default value is 10.}

    form Default {project_settings ?-hdl value? ?-verilog_mode value? ?-vhdl_mode value? ?-auto_update_modelsim_ini value? ?-auto_update_viewdraw_ini value? ?-block_mode value? ?-vm_netlist_flow value? ?-auto_generate_synth_hdl value? ?-auto_run_drc value? ?-auto_generate_viewdraw_hdl value? ?-auto_file_detection value? ?-standalone_peripheral_initialization value? ?-instantiate_in_smartdesign value? ?-enable_design_separation value? ?-enable_set_mitigation value? ?-display_fanout_limit integer?}

    hover {
        summary {Modify the project flow settings for your Libero SoC project.}
        synopsis {project_settings ?-hdl value? ?-verilog_mode value? ?-vhdl_mode value? ?-auto_update_modelsim_ini value? ?-auto_update_viewdraw_ini value? ?-block_mode value? ?-vm_netlist_flow value? ?-auto_generate_synth_hdl value? ?-auto_run_drc value? ?-auto_generate_viewdraw_hdl value? ?-auto_file_detection value? ?-standalone_peripheral_initialization value? ?-instantiate_in_smartdesign value? ?-enable_design_separation value? ?-enable_set_mitigation value? ?-display_fanout_limit integer?}
        description {Sets the HDL language and standard of the project together with the automation switches that govern INI updating, block mode, netlist and HDL auto-generation, automatic DRC, file auto-detection, peripheral initialization, design separation, SET mitigation, and the high fanout display limit.}
        returns {The guide does not document a return value.}
        example {project_settings -hdl "VHDL" \
  -auto_update_modelsim_ini "FALSE" \
  -auto_update_viewdraw_ini "FALSE" \
  -block_mode "FALSE" -auto_generate_synth_hdl "TRUE" \
  -auto_file_detection "TRUE" \
  -display_fanout_limit {12} \
  -enable_set_mitigation {1} \
  -enable_design_separation {1}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command read_active_probe {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration.}
    option -name -takes probe_name \
           -detail {Read only the probes specified, the name prefixed with the bus or group name when the probe is in a bus or group.}
    option -group_name -takes bus_or_group_name \
           -detail {Read only the buses or groups specified here.}
    option -value_type -takes value_type -values {b h} -closed \
           -detail {Used when the read value is stored into a variable as a string, b for binary and h for hex.}
    option -file -takes file_path \
           -detail {Redirects the probe point values read from the device to the specified file.}

    form Default {read_active_probe ?-deviceName device_name? ?-name probe_name? ?-group_name bus_name|group_name? ?-value_type b|h? ?-file file_path?}

    hover {
        summary {Read active probe values from the device.}
        synopsis {read_active_probe ?-deviceName device_name? ?-name probe_name? ?-group_name bus_name|group_name? ?-value_type b|h? ?-file file_path?}
        description {SmartDebug command that reads the probe points selected by select_active_probe, or only those named by -name or -group_name. Reading at least one signal of a bus or group reads the whole bus or group. When the result is captured in a variable it is a binary string unless -value_type h asks for hex. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The probe values read, as a binary string by default or a hex string with -value_type h.}
        example {read_active_probe -group_name {bus1}
set a [read_active_probe -group_name {bus_name} -value_type h]}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command read_analog_block_config {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}
    option -file -takes filename \
           -detail {Identifies the name of the file the read results are saved to.}

    form Default {read_analog_block_config ?-name device_name? ?-file filename?}

    hover {
        summary {Read each channel configuration of the analog system.}
        synopsis {read_analog_block_config ?-name device_name? ?-file filename?}
        description {SmartDebug command that reads the per-channel configuration of the analog system so it can be seen whether and how each channel is configured, optionally saving the result to a file. (Fusion only.)}
        returns {The empty string.}
        example {read_analog_block_config -name {AFS600}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command read_device_status {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}
    option -file -takes filename \
           -detail {Identifies the name of the file the read results are saved to.}

    form Default {read_device_status ?-name device_name? ?-file filename?}

    hover {
        summary {Display the Device Information report.}
        synopsis {read_device_status ?-name device_name? ?-file filename?}
        description {SmartDebug command that prints a complete summary of the device state, analog block test values, user information, factory serial number and security information, optionally saving it to a file. (SmartFusion, IGLOO, ProASIC3 and Fusion.)}
        returns {The empty string.}
        example {read_device_status -name AFS600}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command read_flash_memory {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}
    option -block -takes integer_value \
           -detail {Specifies the location of the block for the memory read.}
    option -client -takes client_name \
           -detail {Name of the client for the memory read.}
    option -startpage -takes integer_value \
           -detail {Start page of the page range; requires -endpage and -block.}
    option -endpage -takes integer_value \
           -detail {End page of the page range; requires -startpage and -block.}
    option -access -takes access -values {all status data} -closed \
           -detail {Specifies which eNVM information to read: page status, data, or both, defaulting to all.}
    option -file -takes filename \
           -detail {Name of the output file for the memory read.}

    form Default {read_flash_memory ?-name device_name? ?-block integer_value? ?-client client_name? ?-startpage integer_value? ?-endpage integer_value? ?-access all|status|data? ?-file filename?}

    hover {
        summary {Read page status and page data from the NVM modules.}
        synopsis {read_flash_memory ?-name device_name? ?-block integer_value? ?-client client_name? ?-startpage integer_value? ?-endpage integer_value? ?-access all|status|data? ?-file filename?}
        description {SmartDebug command that reads flash memory information: page status, covering ECC2 status, write count and access protection, and page data. At a minimum specify either -client or the combination of -startpage, -endpage and -block. (SmartFusion and Fusion only.)}
        returns {The empty string.}
        example {read_flash_memory -client {DS8bit} -file {readFlashMemoryReport.log}
read_flash_memory -startpage 0 -endpage 2 -block 0 -access {data}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command read_flashrom {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}
    option -mapping -takes mapping -values {logical physical} -closed \
           -detail {Specifies how the data read from the UFROM is mapped, defaulting to logical.}
    option -file -takes filename \
           -detail {Identifies the name of the file the read results are saved to.}

    form Default {read_flashrom ?-name device_name? ?-mapping logical|physical? ?-file filename?}

    hover {
        summary {Read the content of the FlashROM from the selected device.}
        synopsis {read_flashrom ?-name device_name? ?-mapping logical|physical? ?-file filename?}
        description {SmartDebug command that reads the FlashROM content of the selected device under logical or physical mapping and optionally saves it to a file. (SmartFusion, IGLOO, ProASIC3 and Fusion.)}
        returns {The empty string.}
        example {read_flashrom -name {AFS600} -mapping {physical}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command read_id_code {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}

    form Default {read_id_code ?-name device_name?}

    hover {
        summary {Read the raw IDCODE from the device.}
        synopsis {read_id_code ?-name device_name?}
        description {SmartDebug command that reads the IDCODE from the device without masking any IDCODE fields, giving the raw silicon value. Being able to read the IDCODE indicates that the JTAG interface is working correctly. (SmartFusion, IGLOO, ProASIC3 and Fusion.)}
        returns {The empty string.}
        example {read_id_code -name {AFS600}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command read_lsram {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration or set for debug.}
    option -name -takes block_name \
           -detail {Specifies the name of the target physical block.}
    option -logicalBlockName -takes block_name \
           -detail {Specifies the name of the user-defined memory block for the logical block form.}
    option -port -takes port_name \
           -detail {Specifies the port of the selected memory block, either Port A or Port B (only with -logicalBlockName).}
    ;# NOTE(libero): the guide's syntax lines write -fileName while its arguments
    ;# rows and examples also write -file for the same output file; both are kept.
    option -fileName -takes file_name \
           -detail {Specifies the output file name for the data read from the device.}
    option -file -takes file_name \
           -detail {Alternative spelling of the output file name for the data read from the device.}

    option_conflict {-name -logicalBlockName}

    form Default {read_lsram ?-deviceName device_name? -name block_name|-logicalBlockName block_name ?-port port_name? ?-fileName file_name?}

    hover {
        summary {Read a block of large SRAM from the device.}
        synopsis {read_lsram ?-deviceName device_name? -name block_name|-logicalBlockName block_name ?-port port_name? ?-fileName file_name?}
        description {SmartDebug command with two forms: the physical block form names a target LSRAM block with -name, and the logical block form names a user-defined memory block with -logicalBlockName plus the -port to read. The array must be programmed and active, and security locks may disable this function. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {read_lsram -deviceName sf2 -name sram_block1 -fileName sram_block_output
read_lsram -logicalBlockName {Fabric_Logic_0/U2/F_0_F0_U1} -port {Port A}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command read_sdc {
    arity 1..

    option -add \
           -detail {Add the constraints from the SDC file on top of the existing ones, overriding them on conflict, instead of removing the existing constraints first.}
    option -scenario -takes scenario_name \
           -detail {Scenario to add the constraints to, created if no scenario of that name exists.}
    option -netlist -takes value -values {user optimized} \
           -detail {Whether the SDC file names objects of the post-synthesis netlist or of the physical netlist used for timing analysis.}
    option -pin_separator -takes sep -values {: /} \
           -detail {Pin separator used in the SDC file, either a colon or a slash.}

    side_effect FileIo -reads

    form Default {read_sdc ?-add? ?-scenario scenario_name? ?-netlist value? ?-pin_separator sep? file_name}

    hover {
        summary {Evaluate an SDC file and add its constraints to a timing scenario.}
        synopsis {read_sdc ?-add? ?-scenario scenario_name? ?-netlist value? ?-pin_separator sep? file_name}
        description {Reads the named SDC file and adds all of its constraints to the scenario given by -scenario, or to the current or default scenario when none is named. Existing constraints in that scenario are removed first unless -add is given.}
        returns {Not documented in the command reference.}
        example {read_sdc design.sdc}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command read_usram {
    arity 0..

    option -deviceName -takes device_name \
           -detail {Optional when only one device is available in the current configuration or set for debug.}
    option -name -takes block_name \
           -detail {Specifies the name of the target physical block.}
    option -logicalBlockName -takes block_name \
           -detail {Specifies the name of the user-defined memory block for the logical block form.}
    option -port -takes port_name \
           -detail {Specifies the port of the selected memory block, either Port A or Port B (only with -logicalBlockName).}
    ;# NOTE(libero): the guide's syntax lines write -fileName while its arguments
    ;# rows and examples also write -file for the same output file; both are kept.
    option -fileName -takes file_name \
           -detail {Specifies the output file name for the data read from the device.}
    option -file -takes file_name \
           -detail {Alternative spelling of the output file name for the data read from the device.}

    option_conflict {-name -logicalBlockName}

    form Default {read_usram ?-deviceName device_name? -name block_name|-logicalBlockName block_name ?-port port_name? ?-fileName file_name?}

    hover {
        summary {Read a uSRAM block from the device.}
        synopsis {read_usram ?-deviceName device_name? -name block_name|-logicalBlockName block_name ?-port port_name? ?-fileName file_name?}
        description {SmartDebug command with two forms: the physical block form names a target uSRAM block with -name, and the logical block form names a user-defined memory block with -logicalBlockName plus the -port to read. The array must be programmed and active, and security locks may disable this function. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {read_usram -deviceName sf2 -name usram_block2 -fileName sram_block_output
read_usram -logicalBlockName {Fabric_Logic_0/U3/F_0_F0_U1} -port {Port A}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command recover_flash_memory {
    arity 0..

    option -name -takes device_name \
           -detail {Optional user-defined device name; not required when only one device is in the current configuration or a device was already selected with set_debug_device.}
    option -block -takes integer_value \
           -detail {Specifies the location of the block for the memory recovery.}
    option -client -takes client_name \
           -detail {Name of the client for the memory recovery.}
    option -startpage -takes integer_value \
           -detail {Start page of the page range; requires -endpage and -block.}
    option -endpage -takes integer_value \
           -detail {End page of the page range; requires -startpage and -block.}

    form Default {recover_flash_memory ?-name device_name? ?-block integer_value? ?-client client_name? ?-startpage integer_value? ?-endpage integer_value?}

    hover {
        summary {Remove ECC2 errors by reprogramming corrupted flash memory pages.}
        synopsis {recover_flash_memory ?-name device_name? ?-block integer_value? ?-client client_name? ?-startpage integer_value? ?-endpage integer_value?}
        description {SmartDebug command that reprograms the specified NVM pages and initializes all pages to zeros, affecting data blocks and auxiliary blocks; page write counters are left unchanged and may be inaccurate after corruption. At a minimum specify either -client or the combination of -startpage, -endpage and -block, and use check_flash_memory first to detect the errors. (SmartFusion and Fusion only.)}
        returns {The empty string.}
        example {recover_flash_memory -client {DS8bit}
recover_flash_memory -block 0 -startpage 0 -endpage 3}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command refresh {
    arity 0

    form Default {refresh}

    hover {
        summary {Refresh your project.}
        synopsis {refresh}
        description {Refreshes the project, updates the view, and checks for updated links and files.}
        returns {The guide does not document a return value.}
        example {refresh}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_all_constraints {
    arity 0

    form Default {remove_all_constraints}

    hover {
        summary {Remove all timing constraints from analysis.}
        synopsis {remove_all_constraints}
        description {Clears every timing constraint held for analysis; remove_scenario drops a whole scenario instead.}
        returns {Not documented in the command reference.}
        example {remove_all_constraints}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_clock {
    arity 0..

    option -name -takes clock_name \
           -detail {Name of the clock constraint to remove from the current scenario; either a name or an ID must be given.}
    option -id -takes constraint_ID \
           -detail {ID of the clock constraint to remove from the current scenario; either an ID or an existing clock name must be given.}

    option_conflict {-name -id}

    form Default {remove_clock -name clock_name | -id constraint_ID}

    hover {
        summary {Remove the specified clock constraint from the current timing scenario.}
        synopsis {remove_clock -name clock_name | -id constraint_ID}
        description {Removes one clock constraint, named either by its clock name or by the constraint ID returned when it was created. The command fails when the name matches no clock constraint in the current scenario or the ID does not refer to a clock constraint, and wildcards may not be used in a clock name.}
        returns {Not documented in the command reference.}
        example {remove_clock -name my_user_clock}
        example {set clockId [create_clock -name my_user_clock -period 2]
remove_clock -id $clockId}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_clock_groups {
    arity 0..

    option -id -takes id \
           -detail {Identify the clock group to remove by its ID; no exclusive flag is needed in this form.}
    option -name -takes groupname \
           -detail {Identify the clock group to remove by name, always followed by the matching exclusive flag.}
    option -physically_exclusive \
           -detail {Select the physically exclusive group of that name; the exclusive flags are mutually exclusive.}
    option -logically_exclusive \
           -detail {Select the logically exclusive group of that name; the exclusive flags are mutually exclusive.}
    option -asynchronous \
           -detail {Select the asynchronous group of that name; the exclusive flags are mutually exclusive.}

    option_conflict {-id -name}
    option_conflict {-physically_exclusive -logically_exclusive -asynchronous}

    form Default {remove_clock_groups ?-id id | -name groupname? ?-physically_exclusive | -logically_exclusive | -asynchronous?}

    hover {
        summary {Remove a clock group by name or by ID.}
        synopsis {remove_clock_groups ?-id id | -name groupname? ?-physically_exclusive | -logically_exclusive | -asynchronous?}
        description {Deletes a clock group created with set_clock_groups (SmartFusion2, IGLOO2, and RTG4 only). Removal by name must repeat the exclusive flag the group was created with, because name and exclusivity together identify the group; removal by ID needs no flag.}
        returns {Not documented in the command reference.}
        example {remove_clock_groups -name mygroup3 -physically_exclusive
remove_clock_groups -id 12}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_clock_latency {
    arity 0..

    option -source -takes clock_name_or_source \
           -detail {Clock name or source name of the constraint whose clock source latency is removed; either this or the constraint ID must be given.}
    option -id -takes constraint_ID \
           -detail {ID of the clock constraint to remove the latency from; either this or the clock or source name must be given.}

    option_conflict {-source -id}

    form Default {remove_clock_latency -source clock_name_or_source | -id constraint_ID}

    hover {
        summary {Remove a clock source latency from a clock and from all edges of that clock.}
        synopsis {remove_clock_latency -source clock_name_or_source | -id constraint_ID}
        description {Removes the source latency set with set_clock_latency from the named clock in the current scenario. The command fails when the source matches no clock carrying a latency constraint or the ID does not refer to one, and wildcards may not be used in a clock name.}
        returns {Not documented in the command reference.}
        example {remove_clock_latency -source my_clock}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_clock_uncertainty {
    arity 0..

    option -from -takes from_clock_list \
           -detail {Uncertainty applies to both edges of this source clock list; only one of -from, -rise_from, or -fall_from may be given.}
    option -rise_from -takes from_clock_list \
           -detail {Uncertainty applies only to rising edges of this source clock list; only one of -from, -rise_from, or -fall_from may be given.}
    option -fall_from -takes from_clock_list \
           -detail {Uncertainty applies only to falling edges of this source clock list; only one of -from, -rise_from, or -fall_from may be given.}
    option -to -takes to_clock_list \
           -detail {Uncertainty applies to both edges of this destination clock list; only one of -to, -rise_to, or -fall_to may be given.}
    option -rise_to -takes to_clock_list \
           -detail {Uncertainty applies only to rising edges of this destination clock list; only one of -to, -rise_to, or -fall_to may be given.}
    option -fall_to -takes to_clock_list \
           -detail {Uncertainty applies only to falling edges of this destination clock list; only one of -to, -rise_to, or -fall_to may be given.}
    option -setup \
           -detail {Uncertainty applies only to setup checks; with neither or both of -setup and -hold it applies to both checks.}
    option -hold \
           -detail {Uncertainty applies only to hold checks; with neither or both of -setup and -hold it applies to both checks.}
    option -id -takes constraint_ID \
           -detail {ID of the uncertainty constraint to remove, given instead of the exact constraint arguments.}

    option_conflict {-from -rise_from -fall_from}
    option_conflict {-to -rise_to -fall_to}

    form Default {remove_clock_uncertainty ?-from | -rise_from | -fall_from from_clock_list? ?-to | -rise_to | -fall_to to_clock_list? ?-setup? ?-hold? ?-id constraint_ID?}

    hover {
        summary {Remove a clock-to-clock uncertainty from the current timing scenario.}
        synopsis {remove_clock_uncertainty ?-from | -rise_from | -fall_from from_clock_list? ?-to | -rise_to | -fall_to to_clock_list? ?-setup? ?-hold? ?-id constraint_ID?}
        description {Removes an uncertainty constraint identified either by exactly the arguments it was created with or by its constraint ID, never by both. The command fails when the arguments match no uncertainty constraint in the current scenario or the ID does not refer to a clock-to-clock uncertainty.}
        returns {Not documented in the command reference.}
        example {remove_clock_uncertainty -from Clk1 -to Clk2
remove_clock_uncertainty -from Clk1 -fall_to { Clk2 Clk3 } -setup
remove_clock_uncertainty -id $clockId}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_core {
    arity 0..

    option -name -takes core_name -detail {Name of the core you want to remove (required).}

    form Default {remove_core -name core_name}

    hover {
        summary {Remove a core from your project.}
        synopsis {remove_core -name core_name}
        description {Removes the named IP core from the current Libero SoC project.}
        returns {The guide does not document a return value.}
        example {remove_core -name ip-beta2.ccz}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_disable_timing {
    arity 0..

    option -from -takes from_port \
           -detail {Starting port of the disabled arc; -from and -to must both be present or both omitted.}
    option -to -takes to_port \
           -detail {Ending port of the disabled arc; -from and -to must both be present or both omitted.}
    option -id -takes name \
           -detail {Constraint name identifying the disable timing constraint to remove, mutually exclusive with the positional cell name.}

    form Default {remove_disable_timing ?-from from_port -to to_port? ?name? ?-id name?}

    hover {
        summary {Remove a disable timing constraint by its arguments or by its ID.}
        synopsis {remove_disable_timing ?-from from_port -to to_port? ?name? ?-id name?}
        description {Removes the disable timing constraint on the named cell, or the one identified by -id. Supplying both a cell name and a constraint ID is an error, and no wildcards are allowed in a clock name, alone or inside an accessor command. The command fails when the arguments match no disable timing constraint.}
        returns {Not documented in the command reference.}
        example {remove_disable_timing -from port1 -to port2 -id new_constraint}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_false_path {
    arity 0..

    option -from -takes from_list \
           -detail {List of timing path starting points: a clock, a primary input, an inout port, or a clock pin of a sequential cell.}
    option -through -takes through_list \
           -detail {List of pins, ports, cells, or nets the disabled paths must pass through.}
    option -to -takes to_list \
           -detail {List of timing path ending points: a clock, a primary output, an inout port, or a data pin of a sequential cell.}
    option -id -takes constraint_ID \
           -detail {ID of the false path constraint to remove, given instead of the exact false path arguments.}

    form Default {remove_false_path ?-from from_list? ?-through through_list? ?-to to_list? ?-id constraint_ID?}

    hover {
        summary {Remove a false path from the current timing scenario.}
        synopsis {remove_false_path ?-from from_list? ?-through through_list? ?-to to_list? ?-id constraint_ID?}
        description {Removes the false path constraint identified either by exactly the arguments it was created with or by its constraint ID, never by both. The command fails when the arguments match no false path constraint, and wildcards may not be used in a clock name, alone or inside an accessor command such as get_pins or get_ports.}
        returns {Not documented in the command reference.}
        example {remove_false_path -through U0/U1:Y}
        example {set fpId [set_false_path -from [get_clocks c*] -through {topx/reg/*} -to [get_ports out15] ]
remove_false_path -id $fpId}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_from_probe_group {
    arity 0..

    option -name -takes probe_name \
           -detail {Specifies one or more probe points to remove from the probe group (required, repeatable).}

    form Default {remove_from_probe_group -name probe_name...}

    hover {
        summary {Remove the specified probe points from their probe group.}
        synopsis {remove_from_probe_group -name probe_name...}
        description {SmartDebug command that detaches the named probe points from their group, after which they are associated with no probe group. Probes cannot be removed from a bus. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {remove_from_probe_group -name my_grp2.out[3]:out[3]:Q}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_generated_clock {
    arity 0..

    option -name -takes clock_name \
           -detail {Name of the generated clock constraint to remove from the current scenario; either a name or an ID must be given.}
    option -id -takes constraint_ID \
           -detail {ID of the generated clock constraint to remove; either an ID or an existing clock name must be given.}

    option_conflict {-name -id}

    form Default {remove_generated_clock -name clock_name | -id constraint_ID}

    hover {
        summary {Remove the specified generated clock constraint from the current scenario.}
        synopsis {remove_generated_clock -name clock_name | -id constraint_ID}
        description {Removes one generated clock constraint, named either by its clock name or by its constraint ID. The command fails when the name matches no generated clock constraint in the current scenario or the ID does not refer to one, and wildcards may not be used in a generated clock name.}
        returns {Not documented in the command reference.}
        example {remove_generated_clock -name my_user_clock}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command remove_input_delay {
    arity 0..

    option -clock -takes clock_name \
