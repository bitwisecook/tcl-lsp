    hover {
        summary {Export a file to another directory and link to it.}
        synopsis {export_as_link -file filename -path link_path}
        description {Copies a project file to the given directory and replaces the project entry with a link to the exported copy.}
        returns {The guide does not document a return value.}
        example {export_as_link -file hdl1.vhd -path c:/microsemi/link_source}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command export_ba_files {
    arity 0..

    option -export_dir -takes path -detail {Absolute path to the folder or directory location for the exported files.}
    option -export_file_name -takes name \
           -detail {File name to generate the files with; defaults to the design name.}
    option -vhdl -takes value -values {0 1} -closed \
           -detail {Generates a Verilog backannotated netlist plus SDF when 0 and a VHDL one plus SDF when 1; the default is 0.}
    option -min_delay -takes value -values {0 1} -closed \
           -detail {Set to 1 to export enhanced min delays so best-case timing results are included in the back-annotated file; the default is 0.}

    form Default {export_ba_files ?-export_dir path? ?-export_file_name name? ?-vhdl value? ?-min_delay value?}

    hover {
        summary {Export the backannotated netlist and SDF timing files.}
        synopsis {export_ba_files ?-export_dir path? ?-export_file_name name? ?-vhdl value? ?-min_delay value?}
        description {Exports the backannotated files design_ba.v or design_ba.vhd together with the design_ba.sdf Standard Delay Format timing file, which are passed to the default simulator for postlayout simulation. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {0 on success, 1 on failure.}
        example {export_ba_files \
  -export_dir {E:/designs/export/sd1} \
  -export_file_name {test} \
  -vhdl 0 \
  -min_delay 1}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command export_bitstream_file {
    arity 0..

    option -file_name -takes file \
           -detail {Name of the file, which must start with the design name; the design name is used if omitted.}
    option -export_dir -takes dir \
           -detail {Location where the bitstream file will be exported; the design export folder is used if omitted.}
    option -format -takes value -values {STP DAT SPI} -closed \
           -detail {Bitstream file formats to be exported, space delimited; STP is exported if omitted.}
    option -force_rtg4_otp -takes value -values {0 1} -closed \
           -detail {Enforces the use of one-time programming, OTP (RTG4 only).}
    option -master_file -takes value -values {0 1} -closed \
           -detail {Specifies that the master bitstream file is exported; if 1, SECURITY must be selected (SmartFusion2, IGLOO2 only).}
    option -master_file_components -takes value -values {SECURITY FABRIC ENVM} \
           -detail {Components of the design saved to the master bitstream file, any one or any combination of SECURITY, FABRIC, and ENVM (SmartFusion2, IGLOO2 only).}
    option -encrypted_uek1_file -takes value -values {0 1} -closed \
           -detail {Specifies that the UEK1 encrypted bitstream file is exported (SmartFusion2, IGLOO2 only).}
    option -encrypted_uek1_file_components -takes value -values {FABRIC ENVM} \
           -detail {Components of the design saved to the uek1 bitstream, either or both of FABRIC and ENVM (SmartFusion2, IGLOO2 only).}
    option -encrypted_uek2_file -takes value -values {0 1} -closed \
           -detail {Specifies that the UEK2 encrypted bitstream file is exported (SmartFusion2, IGLOO2 only).}
    option -encrypted_uek2_file_components -takes value -values {FABRIC ENVM} \
           -detail {Components of the design saved to the uek2 bitstream, either or both of FABRIC and ENVM (SmartFusion2, IGLOO2 only).}
    option -trusted_facility_file -takes value -values {0 1} -closed \
           -detail {Specifies that the trusted facility bitstream file is exported; if 1, all other file types must be 0 (SmartFusion2, IGLOO2 only).}
    option -trusted_facility_file_components -takes value -values {FABRIC ENVM} \
           -detail {Components of the design saved to the trusted facility bitstream file, either or both of FABRIC and ENVM (SmartFusion2, IGLOO2 only).}
    option -add_golden_image -takes value -values {0 1} -closed \
           -detail {Enables or disables the golden SPI image in the SPI directory.}
    option -golden_image_address -takes golden_image_address \
           -detail {Hexadecimal address for the golden image.}
    option -golden_image_design_version -takes golden_image_design_version \
           -detail {Decimal value for the golden image design version.}
    option -add_update_image -takes value -values {0 1} -closed \
           -detail {Enables or disables the update SPI image.}
    option -update_image_address -takes update_image_address \
           -detail {Hexadecimal value for the update image address.}
    option -update_image_design_version -takes update_image_design_version \
           -detail {Decimal value for the update image design version.}
    option -serialization_stapl_type -takes value -values {SINGLE MULTIPLE} -closed \
           -detail {Serialization STAPL file type, either single or multiple.}
    option -serialization_target_solution -takes value \
           -values {Flashpro_3_4_5 generic_STAPL_player} -closed \
           -detail {Target programming hardware for serialization.}

    form Default {export_bitstream_file ?-file_name file? ?-export_dir dir? ?-format value? ?-force_rtg4_otp value? ?-master_file value? ?-master_file_components value? ?-encrypted_uek1_file value? ?-encrypted_uek1_file_components value? ?-encrypted_uek2_file value? ?-encrypted_uek2_file_components value? ?-trusted_facility_file value? ?-trusted_facility_file_components value? ?-add_golden_image value? ?-golden_image_address address? ?-golden_image_design_version version? ?-add_update_image value? ?-update_image_address address? ?-update_image_design_version version? ?-serialization_stapl_type value? ?-serialization_target_solution value?}

    hover {
        summary {Configure the parameters for the bitstream to be exported from Libero.}
        synopsis {export_bitstream_file ?-file_name file? ?-export_dir dir? ?-format value? ?-force_rtg4_otp value? ?-master_file value? ?-master_file_components value? ?-encrypted_uek1_file value? ?-encrypted_uek1_file_components value? ?-encrypted_uek2_file value? ?-encrypted_uek2_file_components value? ?-trusted_facility_file value? ?-trusted_facility_file_components value? ?-add_golden_image value? ?-golden_image_address address? ?-golden_image_design_version version? ?-add_update_image value? ?-update_image_address address? ?-update_image_design_version version? ?-serialization_stapl_type value? ?-serialization_target_solution value?}
        description {Configures and exports the programming bitstream. Exactly one bitstream file type must be set to 1: with trusted_facility_file set to 1 all other file types must be 0, while with it set to 0 a combination of master_file, uek1 and uek2 files may be set, in which case master_file must be 1. RTG4 devices do not support the security, SPI directory, or serialization options and accept only -file_name, -export_dir, -format, and -force_rtg4_otp. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {The guide does not document a return value.}
        example {export_bitstream_file \
  -file_name {sd1} \
  -export_dir {D:/sd_prj/jade_rtg4/designer/sd1/export} \
  -format {STP}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

