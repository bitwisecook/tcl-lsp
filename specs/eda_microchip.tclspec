command serdes_lane_reset {
    arity 0..

    option -serdes -takes num \
           -detail {The SERDES block number, which varies between dies and must be one of the SERDES blocks used in the design (required).}
    option -lane -takes num \
           -detail {The SERDES lane number, between 0 and 3, which must be one of the lanes enabled for the block in the design (required).}

    form Default {serdes_lane_reset -serdes num -lane num}

    hover {
        summary {Reset a SERDES lane.}
        synopsis {serdes_lane_reset -serdes num -lane num}
        description {SmartDebug command that resets the named lane: in EPCS mode only that lane, and in PCI mode the lane, all other lanes in the same link and the corresponding PCIe controller. The result is shown in the log window or console, and a missing or out-of-range -serdes or -lane fails the command. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {serdes_lane_reset -serdes 0 -lane 0}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command serdes_read_register {
    arity 0..

    option -serdes -takes num \
           -detail {SERDES block number, which varies between dies (required).}
    option -lane -takes num \
           -detail {SERDES lane number between 0 and 3, required for a lane register and rejected for a SYSTEM or PCIe register.}
    option -name -takes register_name \
           -detail {Name of the SERDES register (required).}

    form Default {serdes_read_register -serdes num ?-lane num? -name REGISTER_NAME}

    hover {
        summary {Read a SERDES register value.}
        synopsis {serdes_read_register -serdes num ?-lane num? -name REGISTER_NAME}
        description {SmartDebug command that reads the named SERDES register and displays the result in the log window or console. The lane number must be given for a lane register and must be omitted for SYSTEM and PCIe registers, which are not lane-specific; the register names are listed in the SmartFusion2, IGLOO2 and RTG4 high-speed serial interfaces user guides. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {serdes_read_register -serdes 0 -name SYSTEM_SER_PLL_CONFIG_HIGH
serdes_read_register -serdes 0 -lane 0 -name CR0}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command serdes_write_register {
    arity 0..

    option -serdes -takes num \
           -detail {SERDES block number between 0 and 5, varying between dies (required).}
    option -lane -takes num \
           -detail {SERDES lane number between 0 and 3, required for a lane register and rejected for a SYSTEM or PCIe register.}
    option -name -takes register_name \
           -detail {Name of the SERDES register (required).}
    option -value -takes value \
           -detail {The value to write, specified in hexadecimal format (required).}

    form Default {serdes_write_register -serdes num ?-lane num? -name REGISTER_NAME -value value}

    hover {
        summary {Write a value to a SERDES register.}
        synopsis {serdes_write_register -serdes num ?-lane num? -name REGISTER_NAME -value value}
        description {SmartDebug command that writes a hexadecimal value to the named SERDES register and displays the result in the log window or console. The lane number must be given for a lane register and must be omitted for SYSTEM and PCIe registers, which are not lane-specific. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The empty string.}
        example {serdes_write_register -serdes 0 -name SYSTEM_SER_PLL_CONFIG_HIGH -value 0x5533}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

