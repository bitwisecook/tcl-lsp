        summary {List the IDs of all FlashPro programmers connected to the machine.}
        synopsis {get_programmer_info}
        description {SmartDebug command that takes no arguments and returns the identifiers of every FlashPro programmer attached to the machine, so a script can pick one for set_debug_programmer. (SmartFusion2, IGLOO2, RTG4 only.)}
        returns {The list of connected FlashPro programmer IDs.}
        example {set a [get_programmer_info]}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command import_aux {
    arity 1..

    option -format -takes file_type -values {pdc sdc pin dcf saif vcd crt} -closed \
           -detail {File format of the auxiliary file to import.}
    option -partial_parse -takes value -values {true false} -closed \
           -detail {Partially parses the VCD file.}
    option -start_time -takes value \
           -detail {Start time in ns at which the VCD file is partially parsed (only with -partial_parse true).}
    option -end_time -takes value \
           -detail {End time in ns at which the VCD file is partially parsed (only with -partial_parse true).}
    option -auto_detect_top_level_name -takes value -values {true false} -closed \
           -detail {Automatically detects the top-level name.}
    option -top_level_name -takes top_level_name \
           -detail {Instance name of the design in the simulation testbench, detected automatically for a VCD file but required for a SAIF file.}
    option -glitch_filtering -takes value -values {true auto false} -closed \
           -detail {Turns glitch filtering on, off, or automatic, where automatic ignores any value given to -glitch_threshold.}
    option -glitch_threshold -takes value \
           -detail {Glitch filtering value in ps (only with -glitch_filtering true).}

    side_effect FileIo -reads

    form Default {import_aux ?-format file_type? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name top_level_name? ?-glitch_filtering value? ?-glitch_threshold value? filename}

    hover {
        summary {Import an auxiliary file into the design.}
        synopsis {import_aux ?-format file_type? ?-partial_parse value? ?-start_time value? ?-end_time value? ?-auto_detect_top_level_name value? ?-top_level_name top_level_name? ?-glitch_filtering value? ?-glitch_threshold value? filename}
        description {Imports the named auxiliary file into the design, equivalent to the Import Auxiliary Files command on the File menu. Auxiliary files are not audited and are handled as one-time data-entry events, so an SDC file imported this way needs no recompile but its later changes cannot be detected by Designer. The VCD and SAIF options control how simulation activity is read for SmartPower.}
        returns {The guide documents no return value.}
        example {import_aux -format sdc file.sdc
import_aux -format saif -top_level_name "top" file.saif}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command import_component {
    arity 0..

    option -file -takes path \
           -detail {Location of the component .cxf file to import; both absolute and relative paths are supported (required).}

    form Default {import_component -file path}

    hover {
        summary {Import a component .cxf file into the Libero project.}
        synopsis {import_component -file path}
        description {Imports a component file into the project, placing it in the component work folder named after the component. Only the .cxf file format is supported for component import. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {The guide does not document a return value.}
        example {import_component -file {D:/test/my_design/my_mult.cxf}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command import_component_data {
    arity 0..

    option -module -takes root -detail {Name of the top level, or root, module.}
    option -fddr -takes file_path_and_name -detail {FDDR configuration file, which must be FDDR_init.reg or FDDR_init.mem.}
    option -mddr -takes file_path_and_name -detail {MDDR configuration file, which must be MDDR_init.reg or MDDR_init.mem.}
    option -serdes0 -takes file_path_and_name \
           -detail {SERDES 0 configuration file, which must be SERDESIF_0_init.reg or SERDESIF_0_init.mem.}
    option -serdes1 -takes file_path_and_name \
           -detail {SERDES 1 configuration file, which must be SERDESIF_1_init.reg or SERDESIF_1_init.mem.}
    option -serdes2 -takes file_path_and_name \
           -detail {SERDES 2 configuration file, which must be SERDESIF_2_init.reg or SERDESIF_2_init.mem.}
    option -serdes3 -takes file_path_and_name \
           -detail {SERDES 3 configuration file, which must be SERDESIF_3_init.reg or SERDESIF_3_init.mem.}
    option -envm_cfg -takes file_path_and_name \
           -detail {eNVM configuration file, which may have any name (SmartFusion2, IGLOO2 only).}
    option -uprom_cfg -takes file_path_and_name -detail {UPROM configuration file (RTG4 only).}

    form Default {import_component_data ?-module root? ?-fddr file? ?-mddr file? ?-serdes0 file? ?-serdes1 file? ?-serdes2 file? ?-serdes3 file? ?-envm_cfg file? ?-uprom_cfg file?}

    hover {
        summary {Import component data into an existing Libero project.}
        synopsis {import_component_data ?-module root? ?-fddr file? ?-mddr file? ?-serdes0 file? ?-serdes1 file? ?-serdes2 file? ?-serdes3 file? ?-envm_cfg file? ?-uprom_cfg file?}
        description {Imports the initialization and configuration register values of the MDDR, FDDR and SERDES peripherals into a project whose synthesized netlist or HDL carries no component information. Either the register configuration files or the memory files may be used, but the two kinds cannot be mixed in one import_component_data command. Supported on SmartFusion2, IGLOO2, and RTG4.}
        returns {0 on success and 1 on failure.}
        example {import_component_data \
  -module root \
  -fddr {./FDDR_init.reg} \
  -mddr {./MDDR_init.reg} \
  -envm_cfg {./user_cfg.cfg}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command import_files {
    arity 0..

    option -schematic -takes file -detail {Schematic to import into your project (repeatable).}
    option -symbol -takes file -detail {Symbol to import into your project (repeatable).}
    option -smartgen_core -takes file -detail {Core to import into your project (repeatable).}
    option -ccp -takes file -detail {ARM or Cortex-M1 core to import into your project (repeatable).}
    option -stimulus -takes file -detail {HDL stimulus file to import into your project (repeatable).}
    option -hdl_source -takes file -detail {HDL source file to import into your project (repeatable).}
    option -io_pdc -takes file \
           -detail {PDC file containing the I/O attribute and pin information (SmartFusion2 and IGLOO2 only).}
    option -fp_pdc -takes file \
           -detail {PDC file containing the timing and placement information (SmartFusion2 and IGLOO2 only).}
    option -edif -takes file \
           -detail {EDIF file to import into your project; mandatory if you want to convert EDIF to HDL with -can_convert_EDN_to_HDL (repeatable).}
    option -can_convert_EDN_to_HDL -takes value -values {true false 1 0} -closed \
           -detail {Converts the EDIF file to HDL and imports the converted HDL instead; -edif is mandatory and the conversion fails if -edif is absent or the option is combined with another option.}
    ;# NOTE(libero): the Syntax block spells the eight constraint options -sdc, -pin, -dcf,
    ;# -pdc, -gcf, -vcd, -saif and -crt while the Arguments table spells the same eight
    ;# -constraint_sdc ... -constraint_crt; both spellings are recorded, neither invented.
    option -sdc -takes file -detail {SDC constraint file to import, as spelled in the Syntax block (repeatable).}
    option -pin -takes file -detail {PIN constraint file to import, as spelled in the Syntax block (repeatable).}
    option -dcf -takes file -detail {DCF constraint file to import, as spelled in the Syntax block (repeatable).}
    option -pdc -takes file \
           -detail {PDC constraint file to import; retired for SmartFusion2 and IGLOO2, where it is an error and is replaced by -io_pdc and -fp_pdc (repeatable).}
    option -gcf -takes file -detail {GCF constraint file to import, as spelled in the Syntax block (repeatable).}
    option -vcd -takes file -detail {VCD file to import, as spelled in the Syntax block (repeatable).}
    option -saif -takes file -detail {SAIF file to import, as spelled in the Syntax block (repeatable).}
    option -crt -takes file -detail {CRT file to import, as spelled in the Syntax block (repeatable).}
    option -constraint_sdc -takes file -detail {SDC constraint file to import into your project (repeatable).}
    option -constraint_pin -takes file -detail {PIN constraint file to import into your project (repeatable).}
    option -constraint_dcf -takes file -detail {DCF constraint file to import into your project (repeatable).}
    option -constraint_pdc -takes file -detail {PDC constraint file to import into your project (repeatable).}
    option -constraint_gcf -takes file -detail {GCF constraint file to import into your project (repeatable).}
    option -constraint_vcd -takes file -detail {VCD constraint file to import into your project (repeatable).}
    option -constraint_saif -takes file -detail {SAIF constraint file to import into your project (repeatable).}
    option -constraint_crt -takes file -detail {CRT constraint file to import into your project (repeatable).}
    option -simulation -takes file -detail {Simulation file to import into your project (repeatable).}
    option -profiles -takes file -detail {Profile file to import into your project (repeatable).}
    option -cxf -takes file \
           -detail {CXF file, such as a SmartDesign component, to import into your project (repeatable).}
    option -templates -takes file -detail {Template file to import into your project.}
    option -ccz -takes file -detail {IP core file to import into your project.}
    option -wf_stimulus -takes file -detail {WaveFormer Pro stimulus file to import into your project.}
    option -modelsim_ini -takes file -detail {ModelSim INI file to import into your project.}
    option -library -takes file \
           -detail {Library file to import into your project; if the library file is not available it is created and added to the library.}

    form Default {import_files ?-schematic file...? ?-symbol file...? ?-smartgen_core file...? ?-ccp file...? ?-stimulus file...? ?-hdl_source file...? ?-io_pdc file? ?-fp_pdc file? ?-edif file...? ?-can_convert_EDN_to_HDL value? ?-sdc file...? ?-pin file...? ?-dcf file...? ?-pdc file...? ?-gcf file...? ?-vcd file...? ?-saif file...? ?-crt file...? ?-constraint_sdc file...? ?-constraint_pin file...? ?-constraint_dcf file...? ?-constraint_pdc file...? ?-constraint_gcf file...? ?-constraint_vcd file...? ?-constraint_saif file...? ?-constraint_crt file...? ?-simulation file...? ?-profiles file...? ?-cxf file...? ?-templates file? ?-ccz file? ?-wf_stimulus file? ?-modelsim_ini file? ?-library file?}

    hover {
        summary {Import design source files and constraint files into the project.}
        synopsis {import_files ?-schematic file...? ?-symbol file...? ?-smartgen_core file...? ?-ccp file...? ?-stimulus file...? ?-hdl_source file...? ?-io_pdc file? ?-fp_pdc file? ?-edif file...? ?-can_convert_EDN_to_HDL value? ?-sdc file...? ?-pin file...? ?-dcf file...? ?-pdc file...? ?-gcf file...? ?-vcd file...? ?-saif file...? ?-crt file...? ?-constraint_sdc file...? ?-constraint_pin file...? ?-constraint_dcf file...? ?-constraint_pdc file...? ?-constraint_gcf file...? ?-constraint_vcd file...? ?-constraint_saif file...? ?-constraint_crt file...? ?-simulation file...? ?-profiles file...? ?-cxf file...? ?-templates file? ?-ccz file? ?-wf_stimulus file? ?-modelsim_ini file? ?-library file?}
        description {Imports design source and constraint files, with each option naming one file type and being repeated once per file. For SmartFusion2, IGLOO2 and RTG4 the -pdc parameter is retired: physical design constraints must be split between I/O attribute and pin information, imported with -io_pdc, and floorplanning and timing constraints, imported with -fp_pdc, and using -pdc with those families causes an error. Paths may be absolute or relative but must be enclosed in curly braces. Use -can_convert_EDN_to_HDL to convert an EDIF file to HDL and import the converted HDL; the EDIF file itself is not imported.}
        returns {The guide does not document a return value.}
        example {import_files -hdl_source file1.vhd -hdl_source file2.vhd}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command import_source {
    arity 1..

    option -merge_timing -takes value -values {yes no} -closed \
           -detail {Merges the timing constraints of an imported SDC file with the existing ones, new constraints winning on conflict, or replaces them all.}
    option -merge_physical -takes value -values {yes no} -closed \
           -detail {Preserves the existing physical constraints when importing a PDC or GCF file, resolving conflicts, or replaces them all.}
    option -merge_all -takes value -values {yes no} -closed \
           -detail {Preserves both the existing physical and the existing timing constraints when importing SDC and PDC files, or replaces them all.}
    ;# NOTE(libero): -merge is not in the Syntax block; the Exceptions section
    ;# names it as an accepted synonym of -merge_all for the IGLOO, Fusion and
    ;# ProASIC3 families.
    option -merge -takes value -values {yes no} -closed \
           -detail {Maps to both -merge_physical and -merge_timing for the IGLOO, Fusion and ProASIC3 families.}
    option -format -takes file_type -values {adl edif verilog vhdl gcf pdc sdc crt} -closed \
           -detail {File format of the source file to import, given once per file on the command line.}
    option -abort_on_error -takes value -values {yes no} -closed \
           -detail {Aborts a PDC file when an error is encountered during import, or ignores the error and continues.}
    option -top_entity -takes value \
           -detail {Specifies the top entity of a VHDL file.}
    option -edif \
           -detail {Marks the accompanying file as an EDIF netlist.}
    option -edif_flavor -takes value \
           -detail {Type of netlist, such as edif, viewlogic or mgc.}

    side_effect FileIo -reads

    form Default {import_source ?-merge_timing value? ?-merge_physical value? ?-merge_all value? ?-format file_type? ?-abort_on_error value? ?-top_entity value? ?-edif? ?-edif_flavor value? filename}

    hover {
        summary {Import a source file into the design.}
        synopsis {import_source ?-merge_timing value? ?-merge_physical value? ?-merge_all value? ?-format file_type? ?-abort_on_error value? ?-top_entity value? ?-edif? ?-edif_flavor value? filename}
        description {Imports the named source files into the design, equivalent to the Import Source File command on the File menu; all source files must be given on one command line, each preceded by its own -format and file-specific options. The -merge_timing, -merge_physical and -merge_all arguments decide whether existing constraints are kept or replaced and are available for the IGLOO, Fusion and ProASIC3 families, where -merge_all and -merge map to both -merge_physical and -merge_timing. Supported for SmartFusion, IGLOO, ProASIC3 and Fusion.}
        returns {The guide documents no return value.}
        example {import_source \
 -merge_physical "no" \
 -merge_timing "no" \
 -format "vhdl" -top_entity "aclass" \
 {C:/mynetlist.vhd}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command ioadvisor_apply_suggestion {
    arity 0..

    option -attribute -takes value -values {outdrive slew} -closed \
           -detail {Attribute whose suggested values will be applied (required).}
    option -io -takes value \
           -detail {Selects an I/O for which the suggestion will be applied; repeat the option for each I/O (repeatable).}

    form Default {ioadvisor_apply_suggestion -attribute value -io value...}

    hover {
        summary {Apply the I/O Advisor suggestions for an attribute to the selected I/Os.}
        synopsis {ioadvisor_apply_suggestion -attribute value -io value...}
        description {Applies the suggested outdrive or slew values that the I/O Advisor computed to each of the named I/Os.}
        returns {The guide does not document a return value.}
        example {ioadvisor_apply_suggestion -attribute {outdrive} -io {nPWM_out_pad} -io {PWM_out_pad}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

