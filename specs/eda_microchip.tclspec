        returns {0 on success, 1 on failure.}
        example {export_firmware \
  -export_dir {D:/Designs/software_drivers} \
  -create_project {1} \
  -software_ide {SoftConsole}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

