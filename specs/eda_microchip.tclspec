    option -voltage -takes value -values {VDD {VDDI 2.5} VPP} \
           -detail {Specifies the voltage supply whose operating conditions are set.}
    option -use -takes value -values {oprange design mode} -closed \
           -detail {Selects the voltage operating range: the Project Settings range, the SmartPower design-wide range, or the mode-specific range.}

    form Default {smartpower_set_voltage_opcond ?-voltage value? ?-use value?}

    hover {
        summary {Set the voltage in the operating conditions.}
        synopsis {smartpower_set_voltage_opcond ?-voltage value? ?-use value?}
        description {Chooses which voltage range the operating conditions use for the supply named by -voltage: oprange takes the range specified in the Project Settings, while design and mode take the SmartPower design-wide and mode-specific operating ranges and apply to SmartPower only.}
        returns {The empty string.}
        example {smartpower_set_voltage_opcond -voltage {vcca} -use {mode}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command smartpower_temperature_opcond_set_design_wide {
    arity 0..

    option -best -takes value \
           -detail {Specifies the best temperature in degrees Celsius used for design-wide operating conditions.}
    option -typical -takes value \
           -detail {Specifies the typical temperature in degrees Celsius used for design-wide operating conditions.}
    option -worst -takes value \
           -detail {Specifies the worst temperature in degrees Celsius used for design-wide operating conditions.}
    option -thermal_mode -takes value -values {ambient opcond} \
           -detail {Specifies how the junction temperature is computed: iteratively with total static power for ambient, or from the device selection operating condition range for opcond.}

    form Default {smartpower_temperature_opcond_set_design_wide ?-best value? ?-typical value? ?-worst value? ?-thermal_mode value?}

    hover {
        summary {Set the temperature for SmartPower design-wide operating conditions.}
        synopsis {smartpower_temperature_opcond_set_design_wide ?-best value? ?-typical value? ?-worst value? ?-thermal_mode value?}
        description {Sets the best, typical and worst temperatures, in degrees Celsius, that make up the SmartPower design-wide operating conditions, and selects with -thermal_mode whether the junction temperature is computed iteratively from the total static power or taken from the device selection operating condition range.}
        returns {The empty string.}
        example {smartpower_temperature_opcond_set_design_wide -best {20} -typical {30} -worst {60}}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

