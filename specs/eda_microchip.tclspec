    }
}

command st_commit {
    arity 0

    side_effect FileIo -writes

    form Default {st_commit}

    hover {
        summary {Save the changes made in SmartTime to the design file.}
        synopsis {st_commit}
        description {Writes the SmartTime constraint and option changes into the design .adb file; st_restore reverts to the last committed state.}
        returns {Not documented in the command reference.}
        example {st_commit}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command st_create_set {
    arity 0..

    option -name -takes name \
           -detail {A unique name for the newly created path set (required).}
    option -parent_set -takes name -detail {Name of the set to filter.}
    option -clock -takes clock_id \
           -detail {Make the set a subset of the given clock domain (only with -type).}
    option -type -takes value \
           -values {reg_to_reg async_to_reg reg_to_async external_recovery external_removal external_setup external_hold clock_to_out} \
           -detail {Predefined set type on which to base the new path set (only with -clock).}
    option -in_to_out \
           -detail {Base the set on the Input to Output set, whose paths start at input ports and end at output ports.}
    option -source_clock -takes clock_id \
           -detail {Make the set a subset of an inter-clock domain set with the given source clock (only with -sink_clock).}
    option -sink_clock -takes clock_id \
           -detail {Make the set a subset of an inter-clock domain set with the given sink clock (only with -source_clock).}
    option -source -takes pin_list \
           -detail {Filter on the source pins of the parent set, or on all pins in the design when no parent set is given.}
    option -sink -takes pin_list \
           -detail {Filter on the sink pins of the parent set, or on all pins in the design when no parent set is given.}

    form Default {st_create_set -name name ?-parent_set name? ?-clock clock_id -type value? ?-in_to_out? ?-source_clock clock_id -sink_clock clock_id? ?-source pin_list? ?-sink pin_list?}

    hover {
        summary {Create a set of paths to be analyzed in SmartTime.}
        synopsis {st_create_set -name name ?-parent_set name? ?-clock clock_id -type value? ?-in_to_out? ?-source_clock clock_id -sink_clock clock_id? ?-source pin_list? ?-sink pin_list?}
        description {The SmartFusion, IGLOO, ProASIC3, and Fusion form of create_set. Use -clock with -type for a subset of a clock domain, -source_clock with -sink_clock for a subset of an inter-clock domain set, and -parent_set for a filtered subset of an existing set. A set not derived from an existing set needs both -source and -sink pin lists; otherwise they filter the parent set's pins. Each new set needs a name unique in the design.}
        returns {Not documented in the command reference.}
        example {st_create_set -name { my_user_set } -source { C* } -sink { D* }
st_create_set -name { adder } -clock { ALU_CLOCK } -type { REG_TO_REG } -sink { ADDER* }}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command st_edit_set {
    arity 0..

    option -name -takes name -detail {Name of the set to modify (required).}
    option -source -takes pin_list \
           -detail {Source pins of the set, or a filter on the parent set's source pins when the set is a subset.}
    option -sink -takes pin_list \
           -detail {Sink pins of the set, or a filter on the parent set's sink pins when the set is a subset.}
    option -rename_to -takes name -detail {New name for the set.}

    form Default {st_edit_set -name name ?-source pin_list? ?-sink pin_list? ?-rename_to name?}

    hover {
        summary {Modify the paths in a user set.}
        synopsis {st_edit_set -name name ?-source pin_list? ?-sink pin_list? ?-rename_to name?}
        description {Changes the source or sink pins of an existing user set created with st_create_set, or renames it with -rename_to.}
        returns {Not documented in the command reference.}
        example {st_edit_set -name { my_user_set} -rename_to { my_critical_pins }
st_edit_set -name { adder } -sink { ADD* }}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command st_expand_path {
    arity 0..

    option -set -takes name \
           -detail {Expand paths from the named set, which may be in_to_out or any user set name, as an alternative to -clock with -type.}
    option -clock -takes clock_id \
           -detail {Expand paths belonging to the specified clock domain (only with -type).}
    option -type -takes value \
           -values {reg_to_reg async_to_reg reg_to_async external_recovery external_removal external_setup external_hold clock_to_out} \
           -detail {Type of paths in the clock domain to expand (only with -clock).}
    option -in_to_out \
           -detail {Expand the paths of the Input to Output set, which start at input ports and end at output ports.}
    option -source_clock -takes clock_id \
           -detail {Expand the inter-clock domain paths starting at this source clock (only with -sink_clock).}
    option -sink_clock -takes clock_id \
           -detail {Expand the inter-clock domain paths ending at this sink clock (only with -source_clock).}
    option -source -takes pin_list -detail {Filter on the source pins of the paths to be listed.}
    option -sink -takes pin_list -detail {Filter on the sink pins of the paths to be listed.}
    option -analysis -takes value -values {maxdelay mindelay} \
           -detail {Analysis type for the paths to be listed.}
    option -index -takes list_of_indices \
           -detail {Which paths to display; the index starts at 1, defaults to 1, and only values below the max_paths option are expanded.}
    option -format -takes value -values {text csv} \
           -detail {File format of the output, ASCII text or comma separated values.}

    option_conflict {-set -clock}

    form Default {st_expand_path ?-set name? ?-clock clock_id -type value? ?-in_to_out? ?-source_clock clock_id -sink_clock clock_id? ?-source pin_list? ?-sink pin_list? ?-analysis value? ?-index list_of_indices? ?-format value?}

    hover {
        summary {Display expanded path information for paths in SmartTime.}
        synopsis {st_expand_path ?-set name? ?-clock clock_id -type value? ?-in_to_out? ?-source_clock clock_id -sink_clock clock_id? ?-source pin_list? ?-sink pin_list? ?-analysis value? ?-index list_of_indices? ?-format value?}
        description {The SmartFusion, IGLOO, ProASIC3, and Fusion form of expand_path: the paths to expand are named by the same arguments that would list them with st_list_paths. Path details carry the pin name, type, net name, cell name, operation, delay, total delay, and edge, together with the arrival time, required time, and slack, matching the SmartTime Expanded Path window.}
        returns {The expanded path details for the selected paths.}
        example {st_expand_path -clock { myclock } -type {reg_to_reg }
st_expand_path -clock {myclock} -type {reg_to_reg} -index { 1 2 3 } -format text}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command st_list_paths {
    arity 0..

    option -set -takes name \
           -detail {List paths from the named set, which may be in_to_out or any user set name, as an alternative to -clock with -type.}
    option -clock -takes clock_id \
           -detail {List paths belonging to the specified clock domain (only with -type).}
    option -type -takes value \
           -values {reg_to_reg async_to_reg reg_to_async external_recovery external_removal external_setup external_hold clock_to_out} \
           -detail {Type of paths in the clock domain to list (only with -clock).}
    option -in_to_out \
           -detail {List the paths of the Input to Output set, which start at input ports and end at output ports.}
    option -source_clock -takes clock_id \
           -detail {List the inter-clock domain paths starting at this source clock (only with -sink_clock).}
    option -sink_clock -takes clock_id \
           -detail {List the inter-clock domain paths ending at this sink clock (only with -source_clock).}
    option -source -takes pin_list -detail {Filter on the source pins of the paths to be listed.}
    option -sink -takes pin_list -detail {Filter on the sink pins of the paths to be listed.}
    option -analysis -takes value -values {maxdelay mindelay} \
           -detail {Analysis type for the paths to be listed.}
    option -format -takes value -values {text csv} \
           -detail {File format of the output, ASCII text or comma separated values.}

    option_conflict {-set -clock}

    form Default {st_list_paths ?-set name? ?-clock clock_id -type value? ?-in_to_out? ?-source_clock clock_id -sink_clock clock_id? ?-source pin_list? ?-sink pin_list? ?-analysis value? ?-format value?}

    hover {
        summary {Display the list of timing paths in the tabular format SmartTime shows.}
        synopsis {st_list_paths ?-set name? ?-clock clock_id -type value? ?-in_to_out? ?-source_clock clock_id -sink_clock clock_id? ?-source pin_list? ?-sink pin_list? ?-analysis value? ?-format value?}
        description {The SmartFusion, IGLOO, ProASIC3, and Fusion form of list_paths. Selecting csv with -format makes the result easy to write to a file for parsing; st_expand_path shows the details of a listed path.}
        returns {The list of paths in the selected set.}
        example {st_list_paths -set { myset }
st_list_paths -analysis mindelay -clock { myclock } -type { reg_to_reg } -format csv}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

