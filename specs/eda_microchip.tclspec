command is_design_loaded {
    arity 0

    form Default {is_design_loaded}

    hover {
        summary {Report whether a design is loaded in Designer.}
        synopsis {is_design_loaded}
        description {Returns a Boolean value telling whether a design is currently loaded in the Designer software. Because some Tcl commands are valid only when a design is loaded, this command is used to prevent runtime errors before invoking them. It returns an error if any argument is passed.}
        returns {1 when a design is loaded; otherwise 0.}
        example {set bDesignLoaded [ is_design_loaded ]}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command is_design_modified {
    arity 0

    form Default {is_design_modified}

    hover {
        summary {Report whether the design has been modified.}
        synopsis {is_design_modified}
        description {Returns a Boolean value telling whether the design has been modified in the Designer software. Because some Tcl commands are valid only when a design has been modified, this command is used to prevent runtime errors before invoking them. It returns an error if any argument is passed.}
        returns {1 when the design has been modified; otherwise 0.}
        example {set bDesignModified [ is_design_modified ]}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command is_design_state_complete {
    arity 1

    form Default {is_design_state_complete value}

    hover {
        summary {Report whether a given design state is valid.}
        synopsis {is_design_state_complete value}
        description {Returns a Boolean value telling whether the named design state is valid, where value is one of SETUP_DESIGN for a loaded design whose family is set, DEVICE_SELECTION for a completed set_device, NETLIST_IMPORT for an imported netlist, COMPILE, LAYOUT, BACKANNOTATE for an exported post-layout timing file, or PROGRAMMING_FILES for an exported programming file. Because certain commands can be used only after compile or layout, a script checks the design state with this command before calling them. It returns an error if no design is loaded, if more than one argument is passed, or if the argument is not one of the valid values.}
        returns {1 when the named design state is valid; otherwise 0.}
        example {set bLayoutDone [ is_design_state_complete LAYOUT ]}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command is_source_file_current {
    arity 1

    ;# NOTE(libero): the guide writes the Syntax as
    ;# is_source_file_current(filename); the ordinary Tcl word form is used
    ;# here.
    form Default {is_source_file_current filename}

    hover {
        summary {Report whether one source file is current.}
        synopsis {is_source_file_current filename}
        description {Audits the source file at the given path and determines whether it is out of date or has not been imported into the workspace. This command ignores the Audit settings in the ADB file.}
        returns {1 when the file is current; 0 when it is out of date or has not been imported.}
        example {is_source_file_current ./hdl/adder.vhd}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

command layout {
    arity 0..

    option -timing_driven \
           -detail {Sets layout mode to timing driven, the default or the mode used in the previous layout command.}
    option -standard \
           -detail {Sets layout mode to standard, that is non-timing driven.}
    option -power_driven -takes value -values {off on} -closed \
           -detail {Enables power-driven layout; the default is off.}
    option -run_placer -takes value -values {on off} -closed \
           -detail {Invokes placement (the default) or skips it.}
    option -place_incremental -takes value -values {off on fix} -closed \
           -detail {Discards the previous placement (the default), uses it as the initial starting point, or fixes the locations of previously placed macros and places only the remaining ones.}
    option -run_router -takes value -values {on off} -closed \
           -detail {Invokes routing if placement is successful (the default) or skips it.}
    option -route_incremental -takes value -values {off on} -closed \
           -detail {Discards the previous routing information (the default) or uses it as the initial starting point for incremental routing.}
    option -placer_high_effort -takes value -values {off on} -closed \
           -detail {Enables physical synthesis of combinational logic; the default is off.}
    option -seq_opt -takes value -values {off on} -closed \
           -detail {Enables physical synthesis of sequential logic in high-effort mode; the default is off.}
    option -mindel_repair -takes value -values {off on} -closed \
           -detail {Enables repair of minimum delay violations during route; the default is off.}
    option -placer_seed -takes value \
           -detail {Integer value that changes the initial random seed number used for the placement.}
    ;# NOTE(libero): the Syntax block spells this as the bare flag
    ;# -show_placer_seed while the Arguments row heads it -show_placer_seed
    ;# value; the Syntax spelling is used here.
    option -show_placer_seed \
           -detail {Causes layout to display the initial random seed number used for the placement.}

    option_conflict {-timing_driven -standard}

    form Default {layout ?-timing_driven|-standard? ?-power_driven value? ?-run_placer value? ?-place_incremental value? ?-run_router value? ?-route_incremental value? ?-placer_high_effort value? ?-seq_opt value? ?-mindel_repair value? ?-placer_seed value? ?-show_placer_seed?}

    hover {
        summary {Place and route the design.}
        synopsis {layout ?-timing_driven|-standard? ?-power_driven value? ?-run_placer value? ?-place_incremental value? ?-run_router value? ?-route_incremental value? ?-placer_high_effort value? ?-seq_opt value? ?-mindel_repair value? ?-placer_seed value? ?-show_placer_seed?}
        description {Runs layout exactly as the layout command in the Designer GUI does, choosing timing driven or standard mode, whether the placer and router run, and whether placement and routing are incremental. The -placer_high_effort, -seq_opt, -mindel_repair, -placer_seed and -show_placer_seed options are the Advanced Layout Options of the same dialog box. Documented for the SmartFusion, IGLOO, ProASIC3 and Fusion families.}
        returns {The guide documents no return value.}
        example {layout -place_incremental FIX -route_incremental ON
layout -run_placer OFF -route_incremental ON -mindel_repair ON
layout -timing_driven -power_driven ON}
        source {Libero SoC v11.8 Tcl Command Reference}
    }
}

