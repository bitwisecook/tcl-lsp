# Source / dev files — not needed at runtime
.vscode/**
src/**
tsconfig.json
**/*.ts
**/*.map
.vscode-test/**
.vscode-test-web/**
.venv/**
.pytest_cache/**
.ruff_cache/**
.mypy_cache/**
.coverage
.coverage.*
**/.DS_Store

# Dev tooling config
.prettierignore
eslint.config.cjs

# Test artifacts
out/test/**
testFixture/**

# Screenshot demo (dev only — dead-code-eliminated in normal builds)
out/screenshotDemo.js

# Individual tsc output — only the esbuild bundles are used: out/extension.js
# (the `main` entry) and out/extension.browser.js (the `browser` entry). Note
# out/extensionBrowser.js is tsc's per-file output for src/extensionBrowser.ts
# and is NOT the browser bundle.
out/chat/**
out/clientCore.js
out/compilerExplorer.js
out/compilerExplorerHtml.js
out/extensionBrowser.js
out/iruleSkeleton.js
out/runtimeValidation.js
out/scaffold.js
out/selectionTransforms.js
out/templateSnippets.js
out/templateSnippetsCatalog.js
out/webLspTransport.js
out/webWorkspaceSync.js

# node_modules not needed — esbuild bundles everything
node_modules/**

# Python build artifacts
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.pyd

# NOTE: the VSIX bundles the native `tcl-lsp-server` binary per platform under
# `server/<platform>-<arch>/`, so `server/**` must NOT be excluded here. The
# extension no longer ships any Python server (no .pyz, no raw Python source).

# Misc
**/.gitignore
