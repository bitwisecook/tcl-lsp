{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tcl",
  "scopeName": "source.tcl",
  "fileTypes": ["tcl", "tk", "itcl", "tm", "tclspec"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#regexp-command" },
    { "include": "#definitions" },
    { "include": "#command-substitution" },
    { "include": "#variable" },
    { "include": "#string-quoted" },
    { "include": "#braces" },
    { "include": "#keyword" },
    { "include": "#operator" },
    { "include": "#number" },
    { "include": "#escape" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "comment": "Line comment at command position. Uses begin/end (not a single-line match) so a trailing unescaped backslash continues the comment onto the next physical line, matching Tcl's line-continuation rule (issue #759). The two inner patterns consume escaped backslash pairs and backslash-newline continuations so that only an ODD run of trailing backslashes continues the comment (an even run, e.g. '\\\\', terminates it). contentName scopes only the '#...' body, leaving the leading ^/; and whitespace unscoped as the original match capture did.",
          "begin": "(?:^|;)\\s*(?=#)",
          "end": "(?=\\n)",
          "contentName": "comment.line.number-sign.tcl",
          "patterns": [{ "match": "\\\\\\\\" }, { "match": "\\\\\\n" }]
        }
      ]
    },
    "definitions": {
      "comment": "Command definitions that introduce a named entity. These rules exist so the grammar's paint agrees with the semantic-token layer's `function` / `method` / `class` / `parameter` types rather than contradicting it: the grammar is what the user sees before the server answers, and everywhere the server never runs (Linguist, a plain editor, a file too large for semantic tokens). It is allowed to be *less* specific than the server; it must never be differently coloured (issue #903).",
      "patterns": [
        {
          "comment": "proc/method definition with its parameter list — the name is an entity and each parameter is a variable.parameter, matching the semantic layer's `function`/`method` + `parameter` types. Sublime's bundled Tcl syntax scopes proc parameters the same way; the TextMate bundle scopes neither. The name class deliberately excludes string/brace/bracket delimiters so a bareword 'proc'/'method' used as an argument (e.g. `dict set frame proc \"x\"`) cannot swallow an opening quote and derail string/brace scoping (issue #637); requiring the opening brace of the parameter list keeps that guarantee here.",
          "begin": "(?<=^|\\s|;|\\[)(proc|method)\\s+([^\\s\"{}\\[\\];$]+)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "storage.type.function.tcl" },
            "2": { "name": "entity.name.function.tcl" },
            "3": { "name": "punctuation.definition.parameters.begin.tcl" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.definition.parameters.end.tcl" }
          },
          "patterns": [{ "include": "#parameter-list" }]
        },
        {
          "comment": "constructor/destructor take a parameter list but no name (TclOO).",
          "begin": "(?<=^|\\s|;|\\[)(constructor)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "storage.type.function.tcl" },
            "2": { "name": "punctuation.definition.parameters.begin.tcl" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.definition.parameters.end.tcl" }
          },
          "patterns": [{ "include": "#parameter-list" }]
        },
        {
          "comment": "TclOO / Itcl class definition — the class name matches the semantic layer's `class` type. No existing Tcl grammar scopes TclOO at all (checked: TextMate, Sublime, tree-sitter, Pygments), so this follows the LSP type names rather than a grammar convention.",
          "match": "(?<=^|\\s|;|\\[)(oo::class\\s+create|oo::define|oo::objdefine|itcl::class)\\s+([^\\s\"{}\\[\\];$]+)",
          "captures": {
            "1": { "name": "support.class.tcl" },
            "2": { "name": "entity.name.class.tcl" }
          }
        },
        {
          "comment": "A class named as a superclass or mixin is a class reference, as the semantic layer types it.",
          "match": "(?<=^|\\s|;|\\[)(superclass|mixin)\\s+([^\\s\"{}\\[\\];$]+)",
          "captures": {
            "1": { "name": "storage.modifier.tcl" },
            "2": { "name": "entity.other.inherited-class.tcl" }
          }
        },
        {
          "comment": "proc/method name with no parameter list following (e.g. a forward declaration, or `method` used with a brace on the next line). Kept after the rules above so the parameter-list form wins.",
          "match": "(?<=^|\\s|;|\\[)(proc|method)\\s+([^\\s\"{}\\[\\];$]+)",
          "captures": {
            "1": { "name": "storage.type.function.tcl" },
            "2": { "name": "entity.name.function.tcl" }
          }
        }
      ]
    },
    "parameter-list": {
      "comment": "The inside of a proc/method parameter list.",
      "patterns": [
        {
          "comment": "A parameter with a default value — `{name default}`. Matched as one unit so its closing brace is consumed here and cannot terminate the enclosing parameter list early.",
          "match": "\\{\\s*([^\\s{}]+)([^{}]*)\\}",
          "captures": {
            "1": { "name": "variable.parameter.tcl" }
          }
        },
        {
          "comment": "A plain parameter name. `args` is Tcl's variadic marker, but it is an ordinary parameter name too, so it is not special-cased.",
          "match": "[^\\s{}]+",
          "name": "variable.parameter.tcl"
        }
      ]
    },
    "regexp-command": {
      "comment": "regexp/regsub commands with embedded regex highlighting for the pattern argument",
      "patterns": [
        {
          "comment": "regexp/regsub with braced pattern: regexp {pattern} ...",
          "begin": "(?<=^|\\s|;|\\[)(regexp|regsub)\\s+((?:-[a-z]+\\s+)*(?:--\\s+)?)(\\{)",
          "end": "(\\})",
          "beginCaptures": {
            "1": { "name": "support.function.tcl" },
            "2": {
              "name": "meta.options.tcl",
              "patterns": [
                {
                  "name": "keyword.operator.option.tcl",
                  "match": "-(?:nocase|expanded|line|linestop|lineanchor|indices|all|inline|about|start)\\b"
                },
                {
                  "name": "constant.numeric.tcl",
                  "match": "\\b[0-9]+\\b"
                },
                {
                  "name": "punctuation.separator.option-end.tcl",
                  "match": "--"
                }
              ]
            },
            "3": { "name": "punctuation.definition.string.begin.regexp.tcl" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.regexp.tcl" }
          },
          "name": "string.regexp.tcl",
          "patterns": [{ "include": "#regex-internals" }]
        },
        {
          "comment": "regexp/regsub with quoted pattern: regexp \"pattern\" ...",
          "begin": "(?<=^|\\s|;|\\[)(regexp|regsub)\\s+((?:-[a-z]+\\s+)*(?:--\\s+)?)(\")",
          "end": "(\")",
          "beginCaptures": {
            "1": { "name": "support.function.tcl" },
            "2": {
              "name": "meta.options.tcl",
              "patterns": [
                {
                  "name": "keyword.operator.option.tcl",
                  "match": "-(?:nocase|expanded|line|linestop|lineanchor|indices|all|inline|about|start)\\b"
                },
                {
                  "name": "constant.numeric.tcl",
                  "match": "\\b[0-9]+\\b"
                },
                {
                  "name": "punctuation.separator.option-end.tcl",
                  "match": "--"
                }
              ]
            },
            "3": { "name": "punctuation.definition.string.begin.regexp.tcl" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.regexp.tcl" }
          },
          "name": "string.regexp.tcl",
          "patterns": [
            { "include": "#variable" },
            { "include": "#command-substitution" },
            { "include": "#regex-internals" }
          ]
        },
        {
          "comment": "regexp/regsub with bare pattern (no braces/quotes): regexp pattern ...",
          "match": "(?<=^|\\s|;|\\[)(regexp|regsub)\\s+((?:-[a-z]+\\s+)*(?:--\\s+)?)(\\S+)",
          "captures": {
            "1": { "name": "support.function.tcl" },
            "2": {
              "name": "meta.options.tcl",
              "patterns": [
                {
                  "name": "keyword.operator.option.tcl",
                  "match": "-(?:nocase|expanded|line|linestop|lineanchor|indices|all|inline|about|start)\\b"
                },
                {
                  "name": "constant.numeric.tcl",
                  "match": "\\b[0-9]+\\b"
                },
                {
                  "name": "punctuation.separator.option-end.tcl",
                  "match": "--"
                }
              ]
            },
            "3": { "name": "string.regexp.tcl" }
          }
        }
      ]
    },
    "regex-internals": {
      "comment": "Internal patterns for regex syntax highlighting",
      "patterns": [
        {
          "comment": "Character class: [abc], [^abc], [a-z]",
          "name": "constant.other.character-class.set.regexp.tcl",
          "begin": "(\\[)(\\^)?",
          "end": "(\\])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.character-class.begin.regexp.tcl" },
            "2": { "name": "keyword.operator.negation.regexp.tcl" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.character-class.end.regexp.tcl" }
          },
          "patterns": [
            {
              "comment": "Range: a-z",
              "name": "constant.other.character-class.range.regexp.tcl",
              "match": "([^\\\\\\]])-(\\S)"
            },
            {
              "comment": "POSIX character class: [:alpha:]",
              "name": "constant.other.character-class.posix.regexp.tcl",
              "match": "\\[:[a-z]+:\\]"
            },
            { "include": "#regex-escape" }
          ]
        },
        {
          "comment": "Capturing group",
          "begin": "(\\()(\\?:|\\.\\*\\?)?",
          "end": "(\\))",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.group.begin.regexp.tcl" },
            "2": { "name": "keyword.operator.group-modifier.regexp.tcl" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.group.end.regexp.tcl" }
          },
          "name": "meta.group.regexp.tcl",
          "patterns": [{ "include": "#regex-internals" }]
        },
        {
          "comment": "Non-capturing group and lookaheads: (?:), (?=), (?!), (?<=), (?<!)",
          "match": "\\(\\?(?::|=|!|<=|<!|>)",
          "name": "keyword.operator.group-modifier.regexp.tcl"
        },
        {
          "comment": "Quantifiers: *, +, ?, {n}, {n,}, {n,m}",
          "match": "[*+?]|\\{\\d+(?:,\\d*)?\\}",
          "name": "keyword.operator.quantifier.regexp.tcl"
        },
        {
          "comment": "Alternation: |",
          "match": "\\|",
          "name": "keyword.operator.alternation.regexp.tcl"
        },
        {
          "comment": "Anchors: ^, $",
          "match": "\\^|\\$",
          "name": "keyword.operator.anchor.regexp.tcl"
        },
        {
          "comment": "Dot: matches any character",
          "match": "\\.",
          "name": "keyword.operator.wildcard.regexp.tcl"
        },
        {
          "comment": "Backreference: \\1 through \\9",
          "match": "\\\\[1-9]",
          "name": "keyword.operator.backreference.regexp.tcl"
        },
        { "include": "#regex-escape" },
        {
          "comment": "Nested braces (Tcl brace nesting within regex)",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "#regex-internals" }]
        }
      ]
    },
    "regex-escape": {
      "comment": "Escape sequences within regex patterns",
      "patterns": [
        {
          "comment": "Character class shorthand: \\d, \\D, \\w, \\W, \\s, \\S, \\m, \\M, \\y, \\Y, \\A, \\Z",
          "match": "\\\\[dDwWsSmMyYAZ]",
          "name": "constant.character.escape.character-class.regexp.tcl"
        },
        {
          "comment": "Hex escape: \\xNN",
          "match": "\\\\x[0-9a-fA-F]{1,2}",
          "name": "constant.character.escape.hex.regexp.tcl"
        },
        {
          "comment": "Unicode escape: \\uNNNN",
          "match": "\\\\u[0-9a-fA-F]{1,4}",
          "name": "constant.character.escape.unicode.regexp.tcl"
        },
        {
          "comment": "Octal escape: \\0NN",
          "match": "\\\\0[0-7]{1,2}",
          "name": "constant.character.escape.octal.regexp.tcl"
        },
        {
          "comment": "General escape: backslash + special character",
          "match": "\\\\[.^$*+?()\\[\\]{}|\\\\/-]",
          "name": "constant.character.escape.regexp.tcl"
        },
        {
          "comment": "Named control escapes: \\n, \\t, \\r, \\a, \\b, \\f, \\v, \\e",
          "match": "\\\\[ntrabfve]",
          "name": "constant.character.escape.regexp.tcl"
        }
      ]
    },
    "command-substitution": {
      "patterns": [
        {
          "name": "meta.command-substitution.tcl",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.section.bracket.begin.tcl" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.bracket.end.tcl" }
          },
          "patterns": [{ "include": "source.tcl" }]
        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "comment": "Braced variable: ${name with spaces}",
          "name": "variable.other.braced.tcl",
          "match": "\\$\\{[^}]+\\}"
        },
        {
          "comment": "Namespace-qualified variable with optional array: $ns::var(idx)",
          "name": "variable.other.tcl",
          "match": "\\$(?:[:]{2,})?(?:[A-Za-z_][A-Za-z0-9_]*[:]{2,})*[A-Za-z_][A-Za-z0-9_]*(?:\\([^)]*\\))?"
        }
      ]
    },
    "string-quoted": {
      "patterns": [
        {
          "name": "string.quoted.double.tcl",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.tcl" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.tcl" }
          },
          "patterns": [
            { "include": "#variable" },
            { "include": "#command-substitution" },
            { "include": "#escape" }
          ]
        }
      ]
    },
    "braces": {
      "comment": "Braced content — recurses as Tcl source so proc/if/while bodies get highlighting",
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.braces.begin.tcl" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.tcl" }
          },
          "patterns": [{ "include": "source.tcl" }]
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "comment": "Control flow keywords (when is iRule-specific but this grammar serves all dialects). lmap lives here (not in the built-in-commands list below) because the registry carries it with the same LANGUAGE_KEYWORD trait as foreach — it binds loop variables, not just a plain library call.",
          "name": "keyword.control.tcl",
          "match": "(?<=^|\\s|;|\\[)(?:break|catch|continue|else|elseif|error|finally|for|foreach|foreachLine|if|lfilter|lmap|on|return|switch|tailcall|throw|trap|try|when|while|yield|yieldto)(?=\\s|$|;)"
        },
        {
          "comment": "Definition keywords (proc/method handled in #definitions for name capture)",
          "name": "keyword.other.tcl",
          "match": "(?<=^|\\s|;|\\[)(?:apply|classvariable|const|coroutine|eval|global|interp|itcl::class|link|namespace|oo::Helpers::callback|oo::Helpers::classvariable|oo::Helpers::link|oo::Helpers::mymethod|oo::Helpers::next|oo::Helpers::nextto|oo::Helpers::self|oo::abstract|oo::class|oo::configurable|oo::define|oo::objdefine|oo::object|oo::singleton|package|proc|rename|source|uplevel|upvar|variable)(?=\\s|$|;)"
        },
        {
          "comment": "Common built-in commands",
          "name": "support.function.tcl",
          "match": "(?<=^|\\s|;|\\[)(?:after|append|array|auto_execok|auto_import|auto_load|auto_load_index|auto_mkindex|auto_mkindex_old|auto_qualify|auto_reset|bgerror|binary|cd|chan|clock|close|concat|coroinject|coroprobe|dict|divmod|encoding|eof|eq|exec|exit|expr|fblocked|fconfigure|fcopy|file|fileevent|filename|flush|format|frexp|ge|gets|gettimes|glob|gt|history|http|in|incr|info|join|lappend|lassign|le|ledit|lgen|lindex|linsert|list|llength|load|lpop|lrange|lremove|lrepeat|lreplace|lreverse|lsearch|lseq|lset|lsort|lstring|lt|memory|modf|ne|ni|noop|oo::copy|open|parray|pid|pkg::create|pkg_mkIndex|pkg_mkindex|puts|pwd|re_quote|read|readFile|regex::quote|regex_quote|regexp|regexp::quote|registry|regsub|remquo|scan|seek|set|socket|split|string|subst|tclLog|tclPkgSetup|tclPkgUnknown|tcl_endOfWord|tcl_findLibrary|tcl_startOfNextWord|tcl_startOfPreviousWord|tcl_wordBreakAfter|tcl_wordBreakBefore|tell|time|timer|timerate|trace|unicode|unknown|unload|unset|update|vwait|writeFile|zipfs|zlib)(?=\\s|$|;)"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "comment": "Expr operators",
          "name": "keyword.operator.tcl",
          "match": "(?<=\\s)(?:eq|ne|in|ni|&&|\\|\\||!|==|!=|<=?|>=?)(?=\\s)"
        },
        {
          "comment": "Math operators inside expr",
          "name": "keyword.operator.arithmetic.tcl",
          "match": "(?<=\\s)[+\\-*/%](?=\\s)"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "comment": "Hex number",
          "name": "constant.numeric.hex.tcl",
          "match": "\\b0[xX][0-9a-fA-F](?:[0-9a-fA-F]|_+[0-9a-fA-F])*\\b"
        },
        {
          "comment": "Octal number",
          "name": "constant.numeric.octal.tcl",
          "match": "\\b0[oO][0-7](?:[0-7]|_+[0-7])*\\b"
        },
        {
          "comment": "Binary number",
          "name": "constant.numeric.binary.tcl",
          "match": "\\b0[bB][01](?:[01]|_+[01])*\\b"
        },
        {
          "comment": "Float or integer",
          "name": "constant.numeric.tcl",
          "match": "\\b(?:0[dD][0-9](?:[0-9]|_+[0-9])*|[0-9](?:[0-9]|_+[0-9])*(?:\\.[0-9](?:[0-9]|_+[0-9])*)?(?:[eE][+-]?[0-9](?:[0-9]|_+[0-9])*)?)\\b"
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "comment": "Backslash escapes",
          "name": "constant.character.escape.tcl",
          "match": "\\\\(?:[abfnrtv\\\\\"{}\\[\\]\\$]|(?:[0-3][0-7]{0,2}|[4-7][0-7]?)|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4}|U[0-9a-fA-F]{1,8}|\\n)"
        }
      ]
    }
  }
}
