  section: string;
  description: string;
  defaultEnabled: boolean;
}

export interface OptimisationDef {
  code: string;
  description: string;
  defaultEnabled: boolean;
}

export const DIAGNOSTICS: DiagnosticDef[] = [
{% for d in diagnostics %}
  {
    code: "{{ d.code }}",
    section: "{{ d.section }}",
{{ d.description_line }}
    defaultEnabled: {{ d.default | lower }},
  },
{% endfor %}
];

export const OPTIMISATIONS: OptimisationDef[] = [
{% for o in optimisations %}
