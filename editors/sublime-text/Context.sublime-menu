[
    { "caption": "-", "id": "tcl-separator" },
    {
        "caption": "Tcl: Format Document",
        "command": "lsp_format_document",
        "id": "tcl-format",
        "context": [
            {"key": "selector", "operator": "equal", "operand": "source.tcl, source.irule"}
        ]
    },
    {
        "caption": "Tcl: Minify Document",
        "command": "tcl_minify_document",
        "id": "tcl-minify",
        "context": [
            {"key": "selector", "operator": "equal", "operand": "source.tcl, source.irule"}
        ]
    },
    {
        "caption": "Tcl: Unminify Error",
        "command": "tcl_unminify_error",
        "id": "tcl-unminify-error",
        "context": [
            {"key": "selector", "operator": "equal", "operand": "source.tcl, source.irule"}
        ]
    },
    {
        "caption": "Tcl: Apply Safe Quick Fixes",
        "command": "tcl_fix_all_safe_issues",
        "id": "tcl-fix-all",
        "context": [
            {"key": "selector", "operator": "equal", "operand": "source.tcl, source.irule"}
        ]
    }
]
