{
    "contributions": {
        "settings": [
            {
                "file_patterns": ["/LSP-Tcl.sublime-settings"],
                "schema": {
                    "properties": {
                        "settings": {
                            "properties": {
                                "tclLsp": {
                                    "type": "object",
                                    "properties": {
                                        "dialect": {
                                            "type": "string",
                                            "default": "tcl8.6",
                                            "enum": [
                                                "bpf",
                                                "expect",
                                                "f5-bigip",
                                                "f5-iapps",
                                                "f5-irules",
                                                "f5-tmsh",
                                                "jim",
                                                "spectcl",
                                                "sslictcl",
                                                "tcl8.4",
                                                "tcl8.5",
                                                "tcl8.6",
                                                "tcl9.0",
                                                "tcl9.1",
                                                "cadence-eda-tcl",
                                                "intel-quartus-eda-tcl",
                                                "mentor-eda-tcl",
                                                "microchip-libero-eda-tcl",
                                                "synopsys-eda-tcl",
                                                "tk",
                                                "xilinx-eda-tcl"
                                            ],
                                            "enumDescriptions": [
                                                "BPF",
                                                "Expect",
                                                "F5 BIG-IP",
                                                "F5 iApps",
                                                "F5 iRules",
                                                "F5 tmsh Scripts",
                                                "Jim Tcl",
                                                "SpecTcl",
                                                "SslicTcl",
                                                "Tcl 8.4",
                                                "Tcl 8.5",
                                                "Tcl 8.6",
                                                "Tcl 9.0",
                                                "Tcl 9.1",
                                                "Cadence Genus / Innovus / Xcelium — Tcl 8.4 + cadence-genus, cadence-common, cadence-innovus, cadence-xcelium, sdc, upf",
                                                "Intel Quartus Prime — Tcl 8.5 + quartus-project, quartus-flow, quartus-sta, quartus-sdc-ext, quartus-report, quartus-device, quartus-misc, sdc, upf",
                                                "Siemens Questa / ModelSim — Tcl 8.6 + questa, questa-formal, calibre, sdc, upf",
                                                "Microchip Libero SoC — Tcl 8.5 + libero, sdc, upf",
                                                "Synopsys DC / PrimeTime / ICC2 / Formality — Tcl 8.6 + synopsys-dc, synopsys-pt, synopsys-icc2, synopsys-fm, synopsys, sdc, upf",
                                                "Tk — Tcl 8.6 + Tk",
                                                "Xilinx Vivado — Tcl 8.5 + vivado, sdc, upf"
                                            ],
                                            "markdownDescription": "Tcl dialect for analysis and completions."
                                        },
                                        "extraCommands": {
                                            "type": "array",
                                            "items": { "type": "string" },
                                            "markdownDescription": "Additional command names to suppress unknown-command warnings."
                                        },
                                        "libraryPaths": {
                                            "type": "array",
                                            "items": { "type": "string" },
                                            "markdownDescription": "Directories to scan for Tcl packages and library files."
                                        },
                                        "formatting": {
                                            "type": "object",
                                            "properties": {
                                                "indentSize": {
                                                    "type": "integer",
                                                    "default": 4,
                                                    "markdownDescription": "Number of spaces per indentation level."
                                                },
                                                "maxLineLength": {
                                                    "type": "integer",
                                                    "default": 120,
                                                    "markdownDescription": "Maximum line length for formatting."
                                                }
                                            }
                                        },
                                        "features": {
                                            "type": "object",
                                            "markdownDescription": "Toggle individual LSP features on or off.",
                                            "properties": {
                                                "hover": { "type": "boolean", "default": true },
                                                "completion": { "type": "boolean", "default": true },
                                                "diagnostics": { "type": "boolean", "default": true },
                                                "semanticTokens": { "type": "boolean", "default": true },
                                                "codeActions": { "type": "boolean", "default": true },
                                                "definition": { "type": "boolean", "default": true },
                                                "references": { "type": "boolean", "default": true },
                                                "documentSymbols": { "type": "boolean", "default": true },
                                                "folding": { "type": "boolean", "default": true },
                                                "rename": { "type": "boolean", "default": true },
                                                "signatureHelp": { "type": "boolean", "default": true },
                                                "workspaceSymbols": { "type": "boolean", "default": true },
                                                "inlayTypeHints": { "type": "boolean", "default": false },
                                                "inlayParameterHints": { "type": "boolean", "default": false },
                                                "callHierarchy": { "type": "boolean", "default": true },
                                                "documentLinks": { "type": "boolean", "default": true },
                                                "selectionRange": { "type": "boolean", "default": true }
                                            }
                                        },
                                        "signatureHelp": {
                                            "type": "object",
                                            "markdownDescription": "Selective built-in signature-help suppression.",
                                            "properties": {
                                                "disabledCommands": {
                                                    "type": "array",
                                                    "items": { "type": "string" },
                                                    "default": [],
                                                    "markdownDescription": "Built-in command names to silence, such as set and incr. Other commands and user-defined procs retain signature help."
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "server_path": {
                            "type": "string",
                            "default": "",
                            "markdownDescription": "Override path to the `tcl-lsp-server` binary. Leave empty to let LSP-Tcl download and verify the matching release binary."
                        }
                    }
                }
            }
        ]
    }
}
