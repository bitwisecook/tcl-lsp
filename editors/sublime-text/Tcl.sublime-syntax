%YAML 1.2
---
# Tcl syntax highlighting for Sublime Text
# Converted from editors/vscode/syntaxes/tcl.tmLanguage.json
name: Tcl
scope: source.tcl
version: 2

file_extensions:
  - tcl
  - tk
  - itcl
  - tm
  - test
  - globals
  - exp
  - expect
  - scf
  - iapp
  - iappimpl
  - impl
  - irul
  - irule
  - irules
  - tmsh
  - qsf
  - qpf
  - qip
  - do
  - tclspec
  - sdc
  - upf
  - xdc
  - apl

first_line_match: '^#!.*(?:tclsh|wish)'

contexts:
  main:
    - include: comment
    - include: regexp-command
    - include: proc-definition
    - include: command-substitution
    - include: variable
    - include: string-quoted
    - include: string-braced
    - include: keyword
    - include: operator
    - include: number
    - include: escape

  # Comments — only valid at command position (after ^, ;, or inside [...]).
  # Pushed as a body context (not a single-line match) so a trailing unescaped
  # backslash continues the comment onto the next physical line, matching Tcl's
  # line-continuation rule (issue #759).
  comment:
    - match: '(?:^|;)\s*(?=#)'
      push: comment-body

  comment-body:
    - meta_content_scope: comment.line.number-sign.tcl
    # Escaped backslash pair — consumed as content so it does NOT continue the
    # comment (an even run of trailing backslashes terminates it).
    - match: '\\\\'
    # Backslash-newline continuation — stay in the comment on the next line
    # (an odd run of trailing backslashes continues it).
    - match: '\\\n'
    # Plain end of line — no continuation, so end the comment.
    - match: '\n'
      pop: true

  # Proc definition — capture the procedure name for Goto Symbol.
  # The name class excludes string/brace/bracket delimiters so a bareword
  # ``proc`` used as an argument (e.g. ``dict set frame proc "x"``) cannot
  # swallow an opening quote and derail string/brace scoping (issue #637).
  proc-definition:
    - match: '(?<=^|\s|;|\[)(proc)\s+([^\s"{}\[\];$]+)'
      captures:
        1: keyword.other.tcl
        2: entity.name.function.tcl

  # regexp/regsub commands with embedded regex highlighting
  regexp-command:
    # regexp/regsub with braced pattern: regexp {pattern} ...
    - match: '(?<=^|\s|;|\[)(regexp|regsub)\s+((?:-[a-z]+\s+)*(?:--\s+)?)(\{)'
      captures:
        1: support.function.tcl
        2: keyword.operator.option.tcl
        3: punctuation.definition.string.begin.regexp.tcl
      push: regexp-braced-body
    # regexp/regsub with quoted pattern: regexp "pattern" ...
    - match: '(?<=^|\s|;|\[)(regexp|regsub)\s+((?:-[a-z]+\s+)*(?:--\s+)?)(")'
      captures:
        1: support.function.tcl
        2: keyword.operator.option.tcl
        3: punctuation.definition.string.begin.regexp.tcl
      push: regexp-quoted-body
    # regexp/regsub with bare pattern
    - match: '(?<=^|\s|;|\[)(regexp|regsub)\s+((?:-[a-z]+\s+)*(?:--\s+)?)(\S+)'
      captures:
        1: support.function.tcl
        2: keyword.operator.option.tcl
        3: string.regexp.tcl

  regexp-options:
    - match: '-(?:nocase|expanded|line|linestop|lineanchor|indices|all|inline|about|start)\b'
      scope: keyword.operator.option.tcl
    - match: '\b[0-9]+\b'
      scope: constant.numeric.tcl
    - match: '--'
      scope: punctuation.separator.option-end.tcl

  regexp-braced-body:
    - meta_scope: string.regexp.tcl
    - match: '\}'
      scope: punctuation.definition.string.end.regexp.tcl
      pop: true
    - include: regex-internals

  regexp-quoted-body:
    - meta_scope: string.regexp.tcl
    - match: '"'
      scope: punctuation.definition.string.end.regexp.tcl
      pop: true
    - include: variable
    - include: command-substitution
    - include: regex-internals

  # Regex internal patterns
  regex-internals:
    # Character class: [abc], [^abc], [a-z]
    - match: '(\[)(\^)?'
      captures:
        1: punctuation.definition.character-class.begin.regexp.tcl
        2: keyword.operator.negation.regexp.tcl
      push: regex-character-class
    # Capturing group
    - match: '(\()(\?:|\.\*\?)?'
      captures:
        1: punctuation.definition.group.begin.regexp.tcl
        2: keyword.operator.group-modifier.regexp.tcl
      push: regex-group
    # Non-capturing group and lookaheads
    - match: '\(\?(?::|=|!|<=|<!|>)'
      scope: keyword.operator.group-modifier.regexp.tcl
    # Quantifiers
    - match: '[*+?]|\{\d+(?:,\d*)?\}'
      scope: keyword.operator.quantifier.regexp.tcl
    # Alternation
    - match: '\|'
      scope: keyword.operator.alternation.regexp.tcl
    # Anchors
    - match: '\^|\$'
      scope: keyword.operator.anchor.regexp.tcl
    # Dot (any character)
    - match: '\.'
      scope: keyword.operator.wildcard.regexp.tcl
    # Backreference
    - match: '\\[1-9]'
      scope: keyword.operator.backreference.regexp.tcl
    - include: regex-escape
    # Nested braces (Tcl brace nesting within regex)
    - match: '\{'
      push: regex-nested-brace

  regex-character-class:
    - meta_scope: constant.other.character-class.set.regexp.tcl
    - match: '\]'
      scope: punctuation.definition.character-class.end.regexp.tcl
      pop: true
    # Range
    - match: '([^\\\]])-(\S)'
      scope: constant.other.character-class.range.regexp.tcl
    # POSIX character class
    - match: '\[:[a-z]+:\]'
      scope: constant.other.character-class.posix.regexp.tcl
    - include: regex-escape

  regex-group:
    - meta_scope: meta.group.regexp.tcl
    - match: '\)'
      scope: punctuation.definition.group.end.regexp.tcl
      pop: true
    - include: regex-internals

  regex-nested-brace:
    - match: '\}'
      pop: true
    - include: regex-internals

  regex-escape:
    # Character class shorthand
    - match: '\\[dDwWsSmMyYAZ]'
      scope: constant.character.escape.character-class.regexp.tcl
    # Hex escape
    - match: '\\x[0-9a-fA-F]{1,2}'
      scope: constant.character.escape.hex.regexp.tcl
    # Unicode escape
    - match: '\\u[0-9a-fA-F]{1,4}'
      scope: constant.character.escape.unicode.regexp.tcl
    # Octal escape
    - match: '\\0[0-7]{1,2}'
      scope: constant.character.escape.octal.regexp.tcl
    # General escape
    - match: '\\[.^$*+?()\[\]{}|\\/-]'
      scope: constant.character.escape.regexp.tcl
    # Named control escapes
    - match: '\\[ntrabfve]'
      scope: constant.character.escape.regexp.tcl

  # Command substitution: [...]
  command-substitution:
    - match: '\['
      scope: punctuation.section.bracket.begin.tcl
      push: command-substitution-body

  command-substitution-body:
    - meta_scope: meta.command-substitution.tcl
    - match: '\]'
      scope: punctuation.section.bracket.end.tcl
      pop: true
    - include: main

  # Variables: $var, ${var}, $ns::var(idx)
  variable:
    # Braced variable: ${name with spaces}
    - match: '\$\{[^}]+\}'
      scope: variable.other.braced.tcl
    # Namespace-qualified variable with optional array index
    - match: '\$(?:[:]{2,})?(?:[A-Za-z_][A-Za-z0-9_]*[:]{2,})*[A-Za-z_][A-Za-z0-9_]*(?:\([^)]*\))?'
      scope: variable.other.tcl

  # Double-quoted strings with interpolation
  string-quoted:
    - match: '"'
      scope: punctuation.definition.string.begin.tcl
      push: string-quoted-body

  string-quoted-body:
    - meta_scope: string.quoted.double.tcl
    - match: '"'
      scope: punctuation.definition.string.end.tcl
      pop: true
    - include: variable
    - include: command-substitution
    - include: escape

  # Braced strings — no interpolation inside
  string-braced:
    - match: '\{'
      scope: punctuation.definition.string.begin.tcl
      push: string-braced-body

  string-braced-body:
    - meta_scope: string.other.braced.tcl
    - match: '\}'
      scope: punctuation.definition.string.end.tcl
      pop: true
    - include: string-braced
    - include: escape

  # Keywords
  keyword:
    # Control flow. lmap lives here (not in the built-in-commands list below)
    # because the registry carries it with the same LANGUAGE_KEYWORD trait as
    # foreach — it binds loop variables, not just a plain library call (#862).
    - match: '(?<=^|\s|;|\[)(?:break|catch|continue|else|elseif|error|finally|for|foreach|foreachLine|if|lfilter|lmap|on|return|switch|tailcall|throw|trap|try|when|while|yield|yieldto)(?=\s|$|;)'
      scope: keyword.control.tcl
    # Definitions
    - match: '(?<=^|\s|;|\[)(?:apply|case|classvariable|const|coroutine|eval|global|interp|itcl::class|link|namespace|oo::Helpers::callback|oo::Helpers::classvariable|oo::Helpers::link|oo::Helpers::mymethod|oo::Helpers::next|oo::Helpers::nextto|oo::Helpers::self|oo::abstract|oo::class|oo::configurable|oo::define|oo::objdefine|oo::object|oo::singleton|package|proc|rename|source|uplevel|upvar|variable)(?=\s|$|;)'
      scope: keyword.other.tcl
    # Built-in commands
    - match: '(?<=^|\s|;|\[)(?:after|append|array|auto_execok|auto_import|auto_load|auto_load_index|auto_mkindex|auto_mkindex_old|auto_qualify|auto_reset|bgerror|binary|cd|chan|clock|close|concat|coroinject|coroprobe|dict|divmod|encoding|eof|eq|exec|exit|expr|fblocked|fconfigure|fcopy|file|fileevent|filename|flush|format|fpclassify|frexp|ge|gets|gettimes|glob|gt|history|http|in|incr|info|join|lappend|lassign|le|ledit|lgen|lindex|linsert|list|llength|load|lpop|lrange|lremove|lrepeat|lreplace|lreverse|lsearch|lseq|lset|lsort|lstring|lt|memory|modf|ne|ni|noop|oo::copy|open|parray|pid|pkg::create|pkg_mkIndex|pkg_mkindex|puts|pwd|re_quote|read|readFile|regex::quote|regex_quote|regexp|regexp::quote|registry|regsub|remquo|scan|seek|set|socket|split|string|subst|tclLog|tclPkgSetup|tclPkgUnknown|tcl_endOfWord|tcl_findLibrary|tcl_startOfNextWord|tcl_startOfPreviousWord|tcl_wordBreakAfter|tcl_wordBreakBefore|tell|time|timer|timerate|trace|unicode|unknown|unload|unset|update|vwait|writeFile|zipfs|zlib)(?=\s|$|;)'
      scope: support.function.tcl

  # Operators
  operator:
    # Expr operators
    - match: '(?<=\s)(?:eq|ne|in|ni|&&|\|\||!|==|!=|<=?|>=?)(?=\s)'
      scope: keyword.operator.tcl
    # Arithmetic operators
    - match: '(?<=\s)[+\-*/%](?=\s)'
      scope: keyword.operator.arithmetic.tcl

  # Numbers
  number:
    # Hex
    - match: '\b0[xX][0-9a-fA-F](?:[0-9a-fA-F]|_+[0-9a-fA-F])*\b'
      scope: constant.numeric.hex.tcl
    # Octal
    - match: '\b0[oO][0-7](?:[0-7]|_+[0-7])*\b'
      scope: constant.numeric.octal.tcl
    # Binary
    - match: '\b0[bB][01](?:[01]|_+[01])*\b'
      scope: constant.numeric.binary.tcl
    # Float or integer
    - match: '\b(?:0[dD][0-9](?:[0-9]|_+[0-9])*|[0-9](?:[0-9]|_+[0-9])*(?:\.[0-9](?:[0-9]|_+[0-9])*)?(?:[eE][+-]?[0-9](?:[0-9]|_+[0-9])*)?)\b'
      scope: constant.numeric.tcl

  # Backslash escapes
  escape:
    - match: '\\(?:[abfnrtv\\"{}()\[\]\$]|(?:[0-3][0-7]{0,2}|[4-7][0-7]?)|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{1,4}|U(?:(?:000[0-9a-fA-F]{4}|0010[0-9a-fA-F]{3})[0-9a-fA-F]|(?:00[0-9a-fA-F]{4}|010[0-9a-fA-F]{3})[0-9a-fA-F]|(?:0[0-9a-fA-F]{4}|10[0-9a-fA-F]{3})[0-9a-fA-F]|[0-9a-fA-F]{1,5})|\n)'
      scope: constant.character.escape.tcl
